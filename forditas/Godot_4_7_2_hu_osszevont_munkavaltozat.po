#. RDPipelineColorBlendState.description
#. RDPipelineRasterizationState.description
#. RDSamplerState.description
#. RDTextureFormat.description
#. RDTextureView.description
#. RDUniform.description
#. RDVertexAttribute.description
#: doc/classes/RDAttachmentFormat.xml doc/classes/RDPipelineColorBlendState.xml doc/classes/RDPipelineRasterizationState.xml doc/classes/RDSamplerState.xml doc/classes/RDTextureFormat.xml doc/classes/RDTextureView.xml doc/classes/RDUniform.xml doc/classes/RDVertexAttribute.xml
msgid "This object is used by [RenderingDevice]."
msgstr "Ezt az objektumot a [RenderingDevice] használja."

#. RDPipelineDepthStencilState.brief
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "Pipeline depth/stencil state (used by [RenderingDevice])."
msgstr "A renderelési folyamat mélység- és sablonállapota a [RenderingDevice] számára."

#. RDPipelineDepthStencilState.description
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "[RDPipelineDepthStencilState] controls the way depth and stencil comparisons are performed when sampling those values using [RenderingDevice]."
msgstr "Az [RDPipelineDepthStencilState] szabályozza, hogyan hasonlítja össze a [RenderingDevice] a mélység- és sablonértékeket."

#. RDPipelineDepthStencilState.back_op_compare
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The method used for comparing the previous back stencil value and [member back_op_reference]."
msgstr "A hátoldalhoz tartozó korábbi sablonérték és a [member back_op_reference] érték összehasonlításának módja."

#. RDPipelineDepthStencilState.back_op_compare_mask
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "Selects which bits from the back stencil value will be compared."
msgstr "Megadja a hátoldali sablonérték összehasonlításba bevont bitjeit."

#. RDPipelineDepthStencilState.back_op_depth_fail
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The operation to perform on the stencil buffer for back pixels that pass the stencil test but fail the depth test."
msgstr "A sablonpufferen elvégzendő művelet, ha egy hátoldali képpont átmegy a sablonvizsgálaton, de nem megy át a mélységvizsgálaton."

#. RDPipelineDepthStencilState.back_op_fail
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The operation to perform on the stencil buffer for back pixels that fail the stencil test."
msgstr "A sablonpufferen elvégzendő művelet, ha egy hátoldali képpont elbukik a sablonvizsgálaton."

#. RDPipelineDepthStencilState.back_op_pass
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The operation to perform on the stencil buffer for back pixels that pass the stencil test."
msgstr "A sablonpufferen elvégzendő művelet, ha egy hátoldali képpont átmegy a sablonvizsgálaton és az esetleges mélységvizsgálaton."

#. RDPipelineDepthStencilState.back_op_reference
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The value the previous back stencil value will be compared to."
msgstr "A hátoldalhoz tartozó korábbi sablonérték összehasonlítási alapja."

#. RDPipelineDepthStencilState.back_op_write_mask
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "Selects which bits from the back stencil value will be changed."
msgstr "Megadja a hátoldali sablonérték módosítható bitjeit."

#. RDPipelineDepthStencilState.depth_compare_operator
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The method used for comparing the previous and current depth values."
msgstr "A korábbi és az aktuális mélységérték összehasonlításának módja."

#. RDPipelineDepthStencilState.depth_range_max
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The maximum depth that returns [code]true[/code] for [member enable_depth_range]."
msgstr "A [member enable_depth_range] beállítással engedélyezett mélységtartomány-vizsgálat felső határa. A határérték még átmegy a vizsgálaton ([code]true[/code])."

#. RDPipelineDepthStencilState.depth_range_min
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The minimum depth that returns [code]true[/code] for [member enable_depth_range]."
msgstr "A [member enable_depth_range] beállítással engedélyezett mélységtartomány-vizsgálat alsó határa. A határérték még átmegy a vizsgálaton ([code]true[/code])."

#. RDPipelineDepthStencilState.enable_depth_range
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "If [code]true[/code], each depth value will be tested to see if it is between [member depth_range_min] and [member depth_range_max]. If it is outside of these values, it is discarded."
msgstr "Ha az értéke [code]true[/code], a [member depth_range_min] és a [member depth_range_max] érték határolja az elfogadott mélységtartományt. Vulkan alatt a vizsgálat a mélységcsatolmányban tárolt értéket használja. Ha az kívül esik a tartományon, a minta kimarad."

#. RDPipelineDepthStencilState.enable_depth_test
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "If [code]true[/code], enables depth testing which allows objects to be automatically occluded by other objects based on their depth. This also allows objects to be partially occluded by other objects. If [code]false[/code], objects will appear in the order they were drawn (like in Godot's 2D renderer)."
msgstr "Ha az értéke [code]true[/code], a mélységvizsgálat alapján a közelebbi objektumok részben vagy teljesen eltakarhatják a távolabbiakat. Ha az értéke [code]false[/code], a kirajzolás sorrendje határozza meg a takarást, akárcsak a Godot 2D-s renderelőjében."

#. RDPipelineDepthStencilState.enable_depth_write
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "If [code]true[/code], writes to the depth buffer whenever the depth test returns [code]true[/code]. Only works when enable_depth_test is also [code]true[/code]."
msgstr "Ha az értéke [code]true[/code], a sikeres mélységvizsgálat ([code]true[/code]) után ír a mélységpufferbe. Ehhez az enable_depth_test beállításnak is [code]true[/code] értékűnek kell lennie."

#. RDPipelineDepthStencilState.front_op_compare
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The method used for comparing the previous front stencil value and [member front_op_reference]."
msgstr "Az elülső oldalhoz tartozó korábbi sablonérték és a [member front_op_reference] érték összehasonlításának módja."

#. RDPipelineDepthStencilState.front_op_compare_mask
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "Selects which bits from the front stencil value will be compared."
msgstr "Megadja az elülső oldalhoz tartozó sablonérték összehasonlításba bevont bitjeit."

#. RDPipelineDepthStencilState.front_op_depth_fail
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The operation to perform on the stencil buffer for front pixels that pass the stencil test but fail the depth test."
msgstr "A sablonpufferen elvégzendő művelet, ha egy elülső oldali képpont átmegy a sablonvizsgálaton, de nem megy át a mélységvizsgálaton."

#. RDPipelineDepthStencilState.front_op_fail
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The operation to perform on the stencil buffer for front pixels that fail the stencil test."
msgstr "A sablonpufferen elvégzendő művelet, ha egy elülső oldali képpont elbukik a sablonvizsgálaton."

#. RDPipelineDepthStencilState.front_op_pass
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The operation to perform on the stencil buffer for front pixels that pass the stencil test."
msgstr "A sablonpufferen elvégzendő művelet, ha egy elülső oldali képpont átmegy a sablonvizsgálaton és az esetleges mélységvizsgálaton."

#. RDPipelineDepthStencilState.front_op_reference
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "The value the previous front stencil value will be compared to."
msgstr "Az elülső oldalhoz tartozó korábbi sablonérték összehasonlítási alapja."

#. RDPipelineDepthStencilState.front_op_write_mask
#: doc/classes/RDPipelineDepthStencilState.xml
msgid "Selects which bits from the front stencil value will be changed."
msgstr "Megadja az elülső oldalhoz tartozó sablonérték módosítható bitjeit."

#. RDPipelineRasterizationState.brief
#: doc/classes/RDPipelineRasterizationState.xml
msgid "Pipeline rasterization state (used by [RenderingDevice])."
msgstr "A renderelési folyamat raszterizálási állapota a [RenderingDevice] számára."

#. RDPipelineRasterizationState.cull_mode
#: doc/classes/RDPipelineRasterizationState.xml
msgid "The cull mode to use when drawing polygons, which determines whether front faces or backfaces are hidden."
msgstr "Megadja, hogy a sokszögek rajzolásakor az elülső vagy a hátsó lapok maradjanak ki."

#. RDPipelineRasterizationState.depth_bias_clamp
#: doc/classes/RDPipelineRasterizationState.xml
msgid "A limit for how much each depth value can be offset. If negative, it serves as a minimum value, but if positive, it serves as a maximum value."
msgstr "A mélységeltolás határértéke. A negatív érték alsó, a pozitív érték felső korlátot szab."

#. RDPipelineRasterizationState.depth_bias_constant_factor
#: doc/classes/RDPipelineRasterizationState.xml
msgid "A constant offset added to each depth value. Applied after [member depth_bias_slope_factor]."
msgstr "Minden mélységértékhez hozzáadott állandó eltolás. A [member depth_bias_slope_factor] alkalmazása után adódik hozzá."

#. RDPipelineRasterizationState.depth_bias_enabled
#: doc/classes/RDPipelineRasterizationState.xml
msgid "If [code]true[/code], each generated depth value will by offset by some amount. The specific amount is generated per polygon based on the values of [member depth_bias_slope_factor] and [member depth_bias_constant_factor]."
msgstr "Ha az értéke [code]true[/code], a renderelő eltolja a létrehozott mélységértékeket. Az eltolást sokszögenként a [member depth_bias_slope_factor] és a [member depth_bias_constant_factor] alapján számítja ki."

#. RDPipelineRasterizationState.depth_bias_slope_factor
#: doc/classes/RDPipelineRasterizationState.xml
msgid "A constant scale applied to the slope of each polygons' depth. Applied before [member depth_bias_constant_factor]."
msgstr "Az egyes sokszögek mélységének meredekségére alkalmazott állandó szorzó. A [member depth_bias_constant_factor] előtt érvényesül."

#. RDPipelineRasterizationState.discard_primitives
#: doc/classes/RDPipelineRasterizationState.xml
msgid "If [code]true[/code], primitives are discarded immediately before the rasterization stage."
msgstr "Ha az értéke [code]true[/code], a renderelő közvetlenül a raszterizálás előtt eldobja a primitíveket."

#. RDPipelineRasterizationState.enable_depth_clamp
#: doc/classes/RDPipelineRasterizationState.xml
msgid "If [code]true[/code], clamps depth values according to the minimum and maximum depth of the associated viewport."
msgstr "Ha az értéke [code]true[/code], a renderelő a kapcsolódó nézetablak alsó és felső mélységhatára közé szorítja a mélységértékeket."

#. RDPipelineRasterizationState.front_face
#: doc/classes/RDPipelineRasterizationState.xml
msgid "The winding order to use to determine which face of a triangle is considered its front face."
msgstr "A csúcsok körüljárási sorrendje, amely meghatározza, hogy a háromszög melyik oldala számít elülsőnek."

#. RDPipelineRasterizationState.line_width
#: doc/classes/RDPipelineRasterizationState.xml
msgid "The line width to use when drawing lines (in pixels). Thick lines may not be supported on all hardware."
msgstr "A vonalak szélessége képpontban. A vastag vonalakat csak bizonyos eszközök támogatják."

#. RDPipelineRasterizationState.patch_control_points
#: doc/classes/RDPipelineRasterizationState.xml
msgid "The number of control points to use when drawing a patch with tessellation enabled. Higher values result in higher quality at the cost of performance."
msgstr "Tesszelláció használatakor a felületelem rajzolásához megadott vezérlőpontok száma. Nagyobb értékkel jobb minőség érhető el nagyobb számítási költség mellett."

#. RDPipelineRasterizationState.wireframe
#: doc/classes/RDPipelineRasterizationState.xml
msgid "If [code]true[/code], performs wireframe rendering for triangles instead of flat or textured rendering."
msgstr "Ha az értéke [code]true[/code], a háromszögek kitöltött vagy textúrázott felület helyett drótvázként jelennek meg."

#. RDSamplerState.brief
#: doc/classes/RDSamplerState.xml
msgid "Sampler state (used by [RenderingDevice])."
msgstr "A textúramintavételező állapota a [RenderingDevice] számára."

#. RDSamplerState.border_color
#: doc/classes/RDSamplerState.xml
msgid "The border color that will be returned when sampling outside the sampler's bounds and the [member repeat_u], [member repeat_v] or [member repeat_w] modes have repeating disabled."
msgstr "A textúra tartományán kívül használt peremszín. Akkor érvényes, ha az érintett tengely [member repeat_u], [member repeat_v] vagy [member repeat_w] beállítása peremszínes korlátozásra van állítva."

#. RDSamplerState.compare_op
#: doc/classes/RDSamplerState.xml
msgid "The compare operation to use. Only effective if [member enable_compare] is [code]true[/code]."
msgstr "A mintavételnél alkalmazott összehasonlítási művelet. Csak akkor hatásos, ha a [member enable_compare] értéke [code]true[/code]."

#. RDSamplerState.enable_compare
#: doc/classes/RDSamplerState.xml
msgid "If [code]true[/code], returned values will be based on the comparison operation defined in [member compare_op]. This is a hardware-based approach and is therefore faster than performing this manually in a shader. For example, compare operations are used for shadow map rendering by comparing depth values from a shadow sampler."
msgstr "Ha az értéke [code]true[/code], a mintavételező a [member compare_op] szerinti összehasonlítás eredménye alapján ad vissza értéket. Az összehasonlítás hardveresen történik, így gyorsabb a shaderben végzett műveletnél. Árnyéktérkép rajzolásakor például mélységértékeket hasonlíthat össze."

#. RDSamplerState.lod_bias
#: doc/classes/RDSamplerState.xml
msgid "The mipmap LOD bias to use. Positive values will make the sampler blurrier at a given distance, while negative values will make the sampler sharper at a given distance (at the risk of looking grainy). Recommended values are between [code]-0.5[/code] and [code]0.0[/code]. Only effective if the sampler has mipmaps available."
msgstr "A mipmapszint kiválasztásának eltolása. Pozitív értéknél a textúra azonos távolságból elmosódottabb, negatívnál élesebb, esetenként szemcsésebb. Az ajánlott tartomány [code]-0.5[/code] és [code]0.0[/code] közé esik. A beállítás csak mipmapszintekkel rendelkező textúrán hatásos."

#. RDSamplerState.mag_filter
#: doc/classes/RDSamplerState.xml
msgid "The sampler's magnification filter. It is the filtering method used when sampling texels that appear bigger than on-screen pixels."
msgstr "Nagyítási szűrő. Akkor érvényesül, amikor egy texel a képernyő egy képpontjánál nagyobbnak látszik."

#. RDSamplerState.min_filter
#: doc/classes/RDSamplerState.xml
msgid "The sampler's minification filter. It is the filtering method used when sampling texels that appear smaller than on-screen pixels."
msgstr "Kicsinyítési szűrő. Akkor érvényesül, amikor egy texel a képernyő egy képpontjánál kisebbnek látszik."

#. RDSamplerState.mip_filter
#: doc/classes/RDSamplerState.xml
msgid "The filtering method to use for mipmaps."
msgstr "A mipmapszintek mintavételezésénél alkalmazott szűrés."

#. RDSamplerState.repeat_u
#: doc/classes/RDSamplerState.xml
msgid "The repeat mode to use along the U axis of UV coordinates. This affects the returned values if sampling outside the UV bounds."
msgstr "Az ismétlési mód az UV-koordináták U tengelyén. Meghatározza, milyen értéket ad vissza a mintavétel az UV-tartományon kívül."

#. RDSamplerState.repeat_v
#: doc/classes/RDSamplerState.xml
msgid "The repeat mode to use along the V axis of UV coordinates. This affects the returned values if sampling outside the UV bounds."
msgstr "Az ismétlési mód az UV-koordináták V tengelyén. Meghatározza, milyen értéket ad vissza a mintavétel az UV-tartományon kívül."

#. RDSamplerState.repeat_w
#: doc/classes/RDSamplerState.xml
msgid "The repeat mode to use along the W axis of UV coordinates. This affects the returned values if sampling outside the UV bounds. Only effective for 3D samplers."
msgstr "Az ismétlési mód a textúrakoordináták W tengelyén. Meghatározza, milyen értéket ad vissza a mintavétel a koordinátatartományon kívül. Csak 3D-s mintavételezőnél hatásos."

#. RDSamplerState.unnormalized_uvw
#: doc/classes/RDSamplerState.xml
msgid "If [code]true[/code], the texture will be sampled with coordinates ranging from 0 to the texture's resolution. Otherwise, the coordinates will be normalized and range from 0 to 1."
msgstr "Ha az értéke [code]true[/code], a mintavételi koordináták 0-tól a textúra felbontásáig terjednek. Egyébként normalizáltak, és 0-tól 1-ig terjednek."

#. RDSamplerState.use_anisotropy
#: doc/classes/RDSamplerState.xml
msgid "If [code]true[/code], perform anisotropic sampling. See [member anisotropy_max]."
msgstr "Ha az értéke [code]true[/code], anizotropikus mintavételt használ. Lásd a [member anisotropy_max] tulajdonságot."

#. RDShaderSPIRV.brief
#: doc/classes/RDShaderSPIRV.xml
msgid "SPIR-V intermediate representation as part of an [RDShaderFile] (used by [RenderingDevice])."
msgstr "Egy [RDShaderFile] részét képező SPIR-V köztes ábrázolás a [RenderingDevice] számára."

#. RDShaderSPIRV.get_stage_bytecode
#: doc/classes/RDShaderSPIRV.xml
msgid "Equivalent to getting one of [member bytecode_compute], [member bytecode_fragment], [member bytecode_tesselation_control], [member bytecode_tesselation_evaluation], [member bytecode_vertex]."
msgstr "Ugyanazt az értéket adja vissza, mint a megfelelő tulajdonság lekérése. A választható tulajdonságok a [member bytecode_compute], a [member bytecode_fragment], a [member bytecode_tesselation_control], a [member bytecode_tesselation_evaluation] és a [member bytecode_vertex]."

#. RDShaderSPIRV.get_stage_compile_error
#: doc/classes/RDShaderSPIRV.xml
msgid "Returns the compilation error message for the given shader [param stage]. Equivalent to getting one of [member compile_error_compute], [member compile_error_fragment], [member compile_error_tesselation_control], [member compile_error_tesselation_evaluation], [member compile_error_vertex]."
msgstr "A megadott [param stage] shaderszakasz fordítási hibaüzenetét adja vissza. Ugyanez az érték a [member compile_error_compute], a [member compile_error_fragment], a [member compile_error_tesselation_control], a [member compile_error_tesselation_evaluation] vagy a [member compile_error_vertex] tulajdonságból is lekérhető."

#. RDShaderSPIRV.set_stage_bytecode
#: doc/classes/RDShaderSPIRV.xml
msgid "Sets the SPIR-V [param bytecode] for the given shader [param stage]. Equivalent to setting one of [member bytecode_compute], [member bytecode_fragment], [member bytecode_tesselation_control], [member bytecode_tesselation_evaluation], [member bytecode_vertex]."
msgstr "A megadott [param stage] shaderszakasz SPIR-V bájtkódját a [param bytecode] értékre állítja. A megfelelő tulajdonság közvetlenül is beállítható. Ezek a [member bytecode_compute], a [member bytecode_fragment], a [member bytecode_tesselation_control], a [member bytecode_tesselation_evaluation] és a [member bytecode_vertex]."

#. RDShaderSPIRV.set_stage_compile_error
#: doc/classes/RDShaderSPIRV.xml
msgid "Sets the compilation error message for the given shader [param stage] to [param compile_error]. Equivalent to setting one of [member compile_error_compute], [member compile_error_fragment], [member compile_error_tesselation_control], [member compile_error_tesselation_evaluation], [member compile_error_vertex]."
msgstr "A megadott [param stage] shaderszakasz fordítási hibaüzenetét a [param compile_error] értékre állítja. A megfelelő tulajdonság közvetlenül is beállítható. Ezek a [member compile_error_compute], a [member compile_error_fragment], a [member compile_error_tesselation_control], a [member compile_error_tesselation_evaluation] és a [member compile_error_vertex]."

#. RDShaderSPIRV.bytecode_any_hit
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the any hit shader stage."
msgstr "Az any-hit shaderszakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_closest_hit
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the closest hit shader stage."
msgstr "A legközelebbi találatnál futó shaderszakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_compute
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the compute shader stage."
msgstr "A számítási shaderszakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_fragment
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the fragment shader stage."
msgstr "A fragmentshader-szakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_intersection
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the intersection shader stage."
msgstr "A metszésvizsgálati shaderszakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_miss
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the miss shader stage."
msgstr "A találat hiányában futó shaderszakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_raygen
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the ray generation shader stage."
msgstr "A sugárindítási shaderszakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_tesselation_control
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the tessellation control shader stage."
msgstr "A tesszellációt vezérlő shaderszakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_tesselation_evaluation
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the tessellation evaluation shader stage."
msgstr "A tesszellációt kiértékelő shaderszakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.bytecode_vertex
#: doc/classes/RDShaderSPIRV.xml
msgid "The SPIR-V bytecode for the vertex shader stage."
msgstr "A csúcsárnyalási szakasz SPIR-V bájtkódja."

#. RDShaderSPIRV.compile_error_any_hit
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the any hit shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "Az any-hit shaderszakasz fordítási hibaüzenete. A SPIR-V fordító és a Godot állítja be. Sikeres fordításkor üres."

#. RDShaderSPIRV.compile_error_closest_hit
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the closest hit shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A legközelebbi találatnál futó shaderszakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSPIRV.compile_error_compute
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the compute shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A számítási shaderszakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSPIRV.compile_error_fragment
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the fragment shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A fragmentshader-szakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSPIRV.compile_error_intersection
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the intersection shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A metszésvizsgálati shaderszakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSPIRV.compile_error_miss
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the miss shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A találat hiányában futó shaderszakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSPIRV.compile_error_raygen
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the ray generation shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A sugárindítási shaderszakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSPIRV.compile_error_tesselation_control
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the tessellation control shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A tesszellációt vezérlő shaderszakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSPIRV.compile_error_tesselation_evaluation
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the tessellation evaluation shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A tesszellációt kiértékelő shaderszakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSPIRV.compile_error_vertex
#: doc/classes/RDShaderSPIRV.xml
msgid "The compilation error message for the vertex shader stage (set by the SPIR-V compiler and Godot). If empty, shader compilation was successful."
msgstr "A csúcsárnyalási szakasz fordítási hibaüzenete, amelyet a SPIR-V fordító és a Godot állít be. Üres érték esetén a fordítás sikerült."

#. RDShaderSource.brief
#: doc/classes/RDShaderSource.xml
msgid "Shader source code (used by [RenderingDevice])."
msgstr "Shaderforráskód a [RenderingDevice] számára."

#. RDShaderSource.language
#: doc/classes/RDShaderSource.xml
msgid "The language the shader is written in."
msgstr "A shader forráskódjának nyelve."

#. Compositor.brief
#: doc/classes/Compositor.xml
msgid "Stores attributes used to customize how a Viewport is rendered."
msgstr "A nézetablak renderelését testreszabó beállításokat tárolja."

#. Compositor.description
#: doc/classes/Compositor.xml
msgid "The compositor resource stores attributes used to customize how a [Viewport] is rendered."
msgstr "A kompozitor erőforrás a [Viewport] renderelését testreszabó beállításokat tárolja."

#. Compositor.compositor_effects
#: doc/classes/Compositor.xml
msgid "The custom [CompositorEffect]s that are applied during rendering of viewports using this compositor."
msgstr "Az egyéni [CompositorEffect] effektek, amelyek a kompozitort használó nézetablakok renderelésekor futnak le."

#. CompositorEffect.brief
#: doc/classes/CompositorEffect.xml
msgid "This resource allows for creating a custom rendering effect."
msgstr "Ezzel az erőforrással egyéni renderelési effektet hozhatsz létre."

#. CompositorEffect._render_callback
#: doc/classes/CompositorEffect.xml
msgid "Implement this function with your custom rendering code. [param effect_callback_type] should always match the effect callback type you've specified in [member effect_callback_type]. [param render_data] provides access to the rendering state, it is only valid during rendering and should not be stored."
msgstr "Ebben a függvényben add meg az egyéni renderelési műveleteket. Az [param effect_callback_type] értéke mindig egyezzen az [member effect_callback_type] tulajdonságban megadott típussal. A [param render_data] hozzáférést ad a renderelés állapotához. Csak a renderelés alatt érvényes, ezért későbbi használatra ne tárold."

#. CompositorEffect.effect_callback_type
#: doc/classes/CompositorEffect.xml
msgid "The type of effect that is implemented, determines at what stage of rendering the callback is called."
msgstr "Az effekt típusa. Megadja, hogy a renderelés melyik szakaszában fusson le a visszahívás."

#. CompositorEffect.enabled
#: doc/classes/CompositorEffect.xml
msgid "If [code]true[/code] this rendering effect is applied to any viewport it is added to."
msgstr "Ha az értéke [code]true[/code], az effekt minden olyan nézetablak renderelésekor érvényesül, amelyhez hozzáadták."

#. CompositorEffect.needs_separate_specular
#: doc/classes/CompositorEffect.xml
msgid "If [code]true[/code] this triggers specular data being rendered to a separate buffer and combined after effects have been applied, only applicable for the Forward+ renderer."
msgstr "Ha az értéke [code]true[/code], a tükrös visszaverődés adatai külön pufferbe kerülnek. A renderelő az effektek alkalmazása után egyesíti őket a többi adattal. Csak a Forward+ renderelőnél használható."

#. CompositorEffect.EFFECT_CALLBACK_TYPE_PRE_OPAQUE
#. RenderingServer.COMPOSITOR_EFFECT_CALLBACK_TYPE_PRE_OPAQUE
#: doc/classes/CompositorEffect.xml doc/classes/RenderingServer.xml
msgid "The callback is called before our opaque rendering pass, but after depth prepass (if applicable)."
msgstr "A visszahívás az átlátszatlan felületek renderelése előtt, az esetleges előzetes mélységmenet után fut le."

#. CompositorEffect.EFFECT_CALLBACK_TYPE_POST_OPAQUE
#. RenderingServer.COMPOSITOR_EFFECT_CALLBACK_TYPE_POST_OPAQUE
#: doc/classes/CompositorEffect.xml doc/classes/RenderingServer.xml
msgid "The callback is called after our opaque rendering pass, but before our sky is rendered."
msgstr "A visszahívás az átlátszatlan felületek renderelése után, az égbolt kirajzolása előtt fut le."

#. CompositorEffect.EFFECT_CALLBACK_TYPE_POST_SKY
#. RenderingServer.COMPOSITOR_EFFECT_CALLBACK_TYPE_POST_SKY
#: doc/classes/CompositorEffect.xml doc/classes/RenderingServer.xml
msgid "The callback is called after our sky is rendered, but before our back buffers are created (and if enabled, before subsurface scattering and/or screen space reflections)."
msgstr "A visszahívás az égbolt renderelése és a háttérpufferek létrehozása közötti szakaszban fut le. Ha a felszín alatti szórás vagy a képernyőtérbeli tükröződés engedélyezve van, a visszahívás ezeket is megelőzi."

#. CompositorEffect.EFFECT_CALLBACK_TYPE_PRE_TRANSPARENT
#. RenderingServer.COMPOSITOR_EFFECT_CALLBACK_TYPE_PRE_TRANSPARENT
#: doc/classes/CompositorEffect.xml doc/classes/RenderingServer.xml
msgid "The callback is called before our transparent rendering pass, but after our sky is rendered and we've created our back buffers."
msgstr "A visszahívás az átlátszó felületek renderelése előtt, az égbolt kirajzolása és a háttérpufferek létrehozása után fut le."

#. CompositorEffect.EFFECT_CALLBACK_TYPE_POST_TRANSPARENT
#. RenderingServer.COMPOSITOR_EFFECT_CALLBACK_TYPE_POST_TRANSPARENT
#: doc/classes/CompositorEffect.xml doc/classes/RenderingServer.xml
msgid "The callback is called after our transparent rendering pass, but before any built-in post-processing effects and output to our render target."
msgstr "A visszahívás az átlátszó felületek renderelése után, a beépített utófeldolgozás és a renderelési célba írás előtt fut le."

#. CompositorEffect.EFFECT_CALLBACK_TYPE_MAX
#: doc/classes/CompositorEffect.xml
msgid "Represents the size of the [enum EffectCallbackType] enum."
msgstr "Az [enum EffectCallbackType] felsorolás mérete."

#. RDFramebufferPass.brief
#: doc/classes/RDFramebufferPass.xml
msgid "Framebuffer pass attachment description (used by [RenderingDevice])."
msgstr "Egy képpuffer renderelési menetéhez tartozó csatolmányok leírása a [RenderingDevice] számára."

#. RDFramebufferPass.color_attachments
#: doc/classes/RDFramebufferPass.xml
msgid "Color attachments in order starting from 0. If this attachment is not used by the shader, pass ATTACHMENT_UNUSED to skip."
msgstr "A színcsatolmányok sorrendben, 0-tól számozva. Ha a shader nem használ egy csatolmányt, az ATTACHMENT_UNUSED értékkel átugorhatod."

#. RDFramebufferPass.depth_attachment
#: doc/classes/RDFramebufferPass.xml
msgid "Depth attachment. ATTACHMENT_UNUSED should be used if no depth buffer is required for this pass."
msgstr "A mélységcsatolmány. Ha a renderelési menethez nem kell mélységpuffer, add meg az ATTACHMENT_UNUSED értéket."

#. RDFramebufferPass.input_attachments
#: doc/classes/RDFramebufferPass.xml
msgid "Used for multipass framebuffers (more than one render pass). Converts an attachment to an input. Make sure to also supply it properly in the [RDUniform] for the uniform set."
msgstr "Többmenetes képpuffernél egy csatolmányt a renderelési menet bemenetévé tesz. Az uniformkészlet [RDUniform] objektumában is add meg a megfelelő csatolmányt."

#. RDFramebufferPass.preserve_attachments
#: doc/classes/RDFramebufferPass.xml
msgid "Attachments to preserve in this pass (otherwise they are erased)."
msgstr "A menet során megőrzendő csatolmányok. A többi csatolmány tartalma törlődik."

#. RDFramebufferPass.resolve_attachments
#: doc/classes/RDFramebufferPass.xml
msgid "If the color attachments are multisampled, non-multisampled resolve attachments can be provided."
msgstr "Többmintás színcsatolmányokhoz egymintás feloldási csatolmányokat is megadhatsz."

#. RDFramebufferPass.ATTACHMENT_UNUSED
#: doc/classes/RDFramebufferPass.xml
msgid "Attachment is unused."
msgstr "A csatolmány használaton kívül van."

#. RDPipelineColorBlendState.brief
#: doc/classes/RDPipelineColorBlendState.xml
msgid "Pipeline color blend state (used by [RenderingDevice])."
msgstr "A renderelési folyamat színkeverési állapota a [RenderingDevice] számára."

#. RDPipelineColorBlendState.attachments
#: doc/classes/RDPipelineColorBlendState.xml
msgid "The attachments that are blended together."
msgstr "A színkeverésben részt vevő csatolmányok."

#. RDPipelineColorBlendState.blend_constant
#: doc/classes/RDPipelineColorBlendState.xml
msgid "The constant color to blend with. See also [method RenderingDevice.draw_list_set_blend_constants]."
msgstr "A színkeveréshez használt állandó szín. Lásd még a [method RenderingDevice.draw_list_set_blend_constants] metódust."

#. RDPipelineColorBlendState.enable_logic_op
#: doc/classes/RDPipelineColorBlendState.xml
msgid "If [code]true[/code], performs the logic operation defined in [member logic_op]."
msgstr "Ha az értéke [code]true[/code], elvégzi a [member logic_op] tulajdonságban megadott logikai műveletet."

#. RDPipelineColorBlendState.logic_op
#: doc/classes/RDPipelineColorBlendState.xml
msgid "The logic operation to perform for blending. Only effective if [member enable_logic_op] is [code]true[/code]."
msgstr "A keveréshez használt logikai művelet. Csak akkor érvényesül, ha a [member enable_logic_op] értéke [code]true[/code]."

#. RDPipelineColorBlendStateAttachment.brief
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "Pipeline color blend state attachment (used by [RenderingDevice])."
msgstr "A renderelési folyamat egyik csatolmányának színkeverési állapota a [RenderingDevice] számára."

#. RDPipelineColorBlendStateAttachment.alpha_blend_op
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "The blend mode to use for the alpha channel."
msgstr "Az alfa-csatorna keverési művelete."

#. RDPipelineColorBlendStateAttachment.color_blend_op
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "The blend mode to use for the red/green/blue color channels."
msgstr "A vörös, zöld és kék csatorna keverési művelete."

#. RDPipelineColorBlendStateAttachment.dst_alpha_blend_factor
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "Controls how the blend factor for the alpha channel is determined based on the destination's fragments."
msgstr "Megadja, hogyan számítódjon az alfa-csatorna keverési tényezője a cél fragmentumainak értékeiből."

#. RDPipelineColorBlendStateAttachment.dst_color_blend_factor
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "Controls how the blend factor for the color channels is determined based on the destination's fragments."
msgstr "Megadja, hogyan számítódjon a színcsatornák keverési tényezője a cél fragmentumainak értékeiből."

#. RDPipelineColorBlendStateAttachment.src_alpha_blend_factor
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "Controls how the blend factor for the alpha channel is determined based on the source's fragments."
msgstr "Megadja, hogyan számítódjon az alfa-csatorna keverési tényezője a forrás fragmentumainak értékeiből."

#. RDPipelineColorBlendStateAttachment.src_color_blend_factor
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "Controls how the blend factor for the color channels is determined based on the source's fragments."
msgstr "Megadja, hogyan számítódjon a színcsatornák keverési tényezője a forrás fragmentumainak értékeiből."

#. RDPipelineColorBlendStateAttachment.write_a
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "If [code]true[/code], writes the new alpha channel to the final result."
msgstr "Ha az értéke [code]true[/code], az eredménybe írja az új alfa-csatornát."

#. RDPipelineColorBlendStateAttachment.write_b
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "If [code]true[/code], writes the new blue color channel to the final result."
msgstr "Ha az értéke [code]true[/code], az eredménybe írja az új kék csatornát."

#. RDPipelineColorBlendStateAttachment.write_g
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "If [code]true[/code], writes the new green color channel to the final result."
msgstr "Ha az értéke [code]true[/code], az eredménybe írja az új zöld csatornát."

#. RDPipelineColorBlendStateAttachment.write_r
#: doc/classes/RDPipelineColorBlendStateAttachment.xml
msgid "If [code]true[/code], writes the new red color channel to the final result."
msgstr "Ha az értéke [code]true[/code], az eredménybe írja az új vörös csatornát."

#. RDPipelineMultisampleState.brief
#: doc/classes/RDPipelineMultisampleState.xml
msgid "Pipeline multisample state (used by [RenderingDevice])."
msgstr "A renderelési folyamat többmintavételi állapota a [RenderingDevice] számára."

#. RDPipelineMultisampleState.description
#: doc/classes/RDPipelineMultisampleState.xml
msgid "[RDPipelineMultisampleState] is used to control how multisample or supersample antialiasing is being performed when rendering using [RenderingDevice]."
msgstr "Az [RDPipelineMultisampleState] a többmintavételes és a túlmintavételes élsimítás működését szabályozza a [RenderingDevice] renderelési folyamatában."

#. RDPipelineMultisampleState.enable_alpha_to_coverage
#: doc/classes/RDPipelineMultisampleState.xml
msgid "If [code]true[/code], alpha to coverage is enabled. This generates a temporary coverage value based on the alpha component of the fragment's first color output. This allows alpha transparency to make use of multisample antialiasing."
msgstr "Ha az értéke [code]true[/code], a fragmentum első színkimenetének alfaértéke alapján átmeneti lefedettség keletkezik. Így a többmintavételes élsimítás az alfaátlátszóság határain is alkalmazható."

#. RDPipelineMultisampleState.enable_alpha_to_one
#: doc/classes/RDPipelineMultisampleState.xml
msgid "If [code]true[/code], alpha is forced to either [code]0.0[/code] or [code]1.0[/code]. This allows hardening the edges of antialiased alpha transparencies. Only relevant if [member enable_alpha_to_coverage] is [code]true[/code]."
msgstr "Ha az értéke [code]true[/code], az alfaérték csak [code]0.0[/code] vagy [code]1.0[/code] lehet. Ettől élesebbé tehetők az élsimított, alfaátlátszóságot használó felületek szélei. Csak akkor érvényesül, ha a [member enable_alpha_to_coverage] értéke [code]true[/code]."

#. RDPipelineMultisampleState.sample_masks
#: doc/classes/RDPipelineMultisampleState.xml
msgid "The sample mask array. See the [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/vkspec.html#fragops-samplemask]sample mask Vulkan documentation[/url] for more details."
msgstr "A mintamaszkok tömbje. Részletekért lásd a Vulkan dokumentáció [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/vkspec.html#fragops-samplemask]mintamaszkról szóló részét[/url]."

#. RDShaderSource.get_stage_source
#: doc/classes/RDShaderSource.xml
msgid "Returns source code for the specified shader [param stage]. Equivalent to getting one of [member source_compute], [member source_fragment], [member source_tesselation_control], [member source_tesselation_evaluation] or [member source_vertex]."
msgstr "A megadott [param stage] shaderszakasz forráskódját adja vissza. A kód a megfelelő tulajdonságban is elérhető. Ezek a [member source_compute], a [member source_fragment], a [member source_tesselation_control], a [member source_tesselation_evaluation] és a [member source_vertex]."

#. RDShaderSource.source_any_hit
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's any hit stage."
msgstr "Az any-hit shaderszakasz forráskódja."

#. RDShaderSource.source_closest_hit
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's closest hit stage."
msgstr "A legközelebbi találatnál futó shaderszakasz forráskódja."

#. RDShaderSource.source_compute
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's compute stage."
msgstr "A számítási shaderszakasz forráskódja."

#. RDShaderSource.source_fragment
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's fragment stage."
msgstr "A fragmentshader-szakasz forráskódja."

#. RDShaderSource.source_intersection
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's intersection stage."
msgstr "A metszésvizsgálati shaderszakasz forráskódja."

#. RDShaderSource.source_miss
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's miss stage."
msgstr "A találat hiányában futó shaderszakasz forráskódja."

#. RDShaderSource.source_raygen
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's ray generation stage."
msgstr "A sugárindítási shaderszakasz forráskódja."

#. RDShaderSource.source_tesselation_control
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's tessellation control stage."
msgstr "A tesszellációt vezérlő shaderszakasz forráskódja."

#. RDShaderSource.source_tesselation_evaluation
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's tessellation evaluation stage."
msgstr "A tesszellációt kiértékelő shaderszakasz forráskódja."

#. RDShaderSource.source_vertex
#: doc/classes/RDShaderSource.xml
msgid "Source code for the shader's vertex stage."
msgstr "A csúcsárnyalási szakasz forráskódja."

#. RDTextureFormat.samples
#: doc/classes/RDTextureFormat.xml
msgid "The number of samples used when sampling the texture."
msgstr "A textúra mintáinak száma."

#. RDTextureFormat.texture_type
#: doc/classes/RDTextureFormat.xml
msgid "The texture type."
msgstr "A textúra típusa."

#. RDVertexAttribute.brief
#: doc/classes/RDVertexAttribute.xml
msgid "Vertex attribute (used by [RenderingDevice])."
msgstr "Csúcsattribútum a [RenderingDevice] számára."

#. RDVertexAttribute.format
#: doc/classes/RDVertexAttribute.xml
msgid "The way that this attribute's data is interpreted when sent to a shader."
msgstr "Megadja, hogyan értelmezze a shader a neki átadott attribútumadatokat."

#. RDVertexAttribute.frequency
#: doc/classes/RDVertexAttribute.xml
msgid "The rate at which this attribute is pulled from its vertex buffer."
msgstr "Megadja, milyen gyakorisággal olvassa ki a renderelő az attribútumot a csúcspufferből."

#. RDVertexAttribute.location
#: doc/classes/RDVertexAttribute.xml
msgid "The location in the shader that this attribute is bound to."
msgstr "A shaderbeli hely, amelyhez az attribútum hozzá van rendelve."

#. RDVertexAttribute.offset
#: doc/classes/RDVertexAttribute.xml
msgid "The number of bytes between the start of the vertex buffer and the first instance of this attribute."
msgstr "A csúcspuffer kezdete és az attribútum első előfordulása közötti távolság bájtban."

#. RDVertexAttribute.stride
#: doc/classes/RDVertexAttribute.xml
msgid "The number of bytes between the starts of consecutive instances of this attribute."
msgstr "Az attribútum két egymást követő előfordulásának kezdete közötti távolság bájtban."

#. RenderSceneBuffersConfiguration.brief
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "Configuration object used to setup a [RenderSceneBuffers] object."
msgstr "A [RenderSceneBuffers] objektum beállításához használt konfiguráció."

#. RenderSceneBuffersConfiguration.description
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "This configuration object is created and populated by the render engine on a viewport change and used to (re)configure a [RenderSceneBuffers] object."
msgstr "A renderelőmotor a nézetablak változásakor hozza létre és tölti ki ezt a konfigurációt. Ezzel állítja be vagy konfigurálja újra a [RenderSceneBuffers] objektumot."

#. RenderSceneBuffersConfiguration.anisotropic_filtering_level
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "Level of the anisotropic filter."
msgstr "Az anizotropikus szűrés szintje."

#. RenderSceneBuffersConfiguration.fsr_sharpness
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "FSR Sharpness applicable if FSR upscaling is used."
msgstr "Az élesítés mértéke FSR-felskálázás használatakor."

#. RenderSceneBuffersConfiguration.internal_size
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "The size of the 3D render buffer used for rendering."
msgstr "A 3D-s rendereléshez használt puffer mérete."

#. RenderSceneBuffersConfiguration.msaa_3d
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "The MSAA mode we're using for 3D rendering."
msgstr "A 3D-s renderelésnél használt MSAA-mód."

#. RenderSceneBuffersConfiguration.render_target
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "The render target associated with these buffer."
msgstr "A pufferekhez tartozó renderelési cél."

#. RenderSceneBuffersConfiguration.scaling_3d_mode
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "The requested scaling mode with which we upscale/downscale if [member internal_size] and [member target_size] are not equal."
msgstr "A fel- vagy leskálázáshoz kért mód, ha az [member internal_size] és az [member target_size] eltér."

#. RenderSceneBuffersConfiguration.screen_space_aa
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "The requested screen space AA applied in post processing."
msgstr "Az utófeldolgozáskor alkalmazandó képernyőtérbeli élsimítás."

#. RenderSceneBuffersConfiguration.target_size
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "The target (upscale) size if scaling is used."
msgstr "Skálázás használatakor a kimeneti méret."

#. RenderSceneBuffersConfiguration.view_count
#: doc/classes/RenderSceneBuffersConfiguration.xml
msgid "The number of views we're rendering."
msgstr "A renderelt nézetek száma."

#. RenderSceneBuffersRD.brief
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Render scene buffer implementation for the RenderingDevice based renderers."
msgstr "Jelenetpuffereket kezel a RenderingDevice-alapú renderelők számára."

#. RenderSceneBuffersRD.clear_context
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Frees all buffers related to this context."
msgstr "Felszabadítja a környezethez tartozó összes puffert."

#. RenderSceneBuffersRD.create_texture
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Create a new texture with the given definition and cache this under the given name. Will return the existing texture if it already exists."
msgstr "Létrehoz egy textúrát a megadott beállításokkal, és a megadott néven gyorsítótárazza. Ha már létezik ilyen nevű textúra, azt adja vissza."

#. RenderSceneBuffersRD.create_texture_from_format
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Create a new texture using the given format and view and cache this under the given name. Will return the existing texture if it already exists."
msgstr "Létrehoz egy textúrát a megadott formátummal és nézettel, majd a megadott néven gyorsítótárazza. Ha már létezik ilyen nevű textúra, azt adja vissza."

#. RenderSceneBuffersRD.create_texture_view
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Create a new texture view for an existing texture and cache this under the given [param view_name]. Will return the existing texture view if it already exists. Will error if the source texture doesn't exist."
msgstr "Nézetet hoz létre egy meglévő textúrához, és a megadott [param view_name] néven gyorsítótárazza. Ha a nézet már létezik, azt adja vissza. Ha a forrástextúra hiányzik, hibát jelez."

#. RenderSceneBuffersRD.get_fsr_sharpness
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the FSR sharpness value used while rendering the 3D content (if [method get_scaling_3d_mode] is an FSR mode)."
msgstr "A 3D-s tartalom renderelésekor használt FSR-élesítés mértékét adja vissza, ha a [method get_scaling_3d_mode] FSR-módot jelez."

#. RenderSceneBuffersRD.get_internal_size
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the internal size of the render buffer (size before upscaling) with which textures are created by default."
msgstr "A renderelési puffer belső, felskálázás előtti méretét adja vissza. Alapértelmezésben ekkora textúrák készülnek."

#. RenderSceneBuffersRD.get_msaa_3d
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the applied 3D MSAA mode for this viewport."
msgstr "A nézetablakban alkalmazott 3D-s MSAA-módot adja vissza."

#. RenderSceneBuffersRD.get_render_target
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the render target associated with this buffers object."
msgstr "A pufferobjektumhoz tartozó renderelési célt adja vissza."

#. RenderSceneBuffersRD.get_scaling_3d_mode
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the scaling mode used for upscaling."
msgstr "A felskálázáshoz használt módot adja vissza."

#. RenderSceneBuffersRD.get_screen_space_aa
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the screen-space antialiasing method applied."
msgstr "Az alkalmazott képernyőtérbeli élsimítási módot adja vissza."

#. RenderSceneBuffersRD.get_target_size
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the target size of the render buffer (size after upscaling)."
msgstr "A renderelési puffer célméretét, vagyis a felskálázás utáni méretét adja vissza."

#. RenderSceneBuffersRD.get_texture
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns a cached texture with this name."
msgstr "A megadott nevű, gyorsítótárazott textúrát adja vissza."

#. RenderSceneBuffersRD.get_texture_format
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the texture format information with which a cached texture was created."
msgstr "A gyorsítótárazott textúra létrehozásához használt formátumadatokat adja vissza."

#. RenderSceneBuffersRD.get_texture_samples
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the number of MSAA samples used."
msgstr "Az MSAA-minták számát adja vissza."

#. RenderSceneBuffersRD.get_texture_slice
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns a specific slice (layer or mipmap) for a cached texture."
msgstr "Egy gyorsítótárazott textúra kiválasztott rétegét vagy mipmapszintjét adja vissza."

#. RenderSceneBuffersRD.get_texture_slice_size
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the texture size of a given slice of a cached texture."
msgstr "Egy gyorsítótárazott textúra megadott rétegének vagy mipmapszintjének méretét adja vissza."

#. RenderSceneBuffersRD.get_texture_slice_view
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns a specific view of a slice (layer or mipmap) for a cached texture."
msgstr "Nézetet ad vissza egy gyorsítótárazott textúra adott rétegéhez vagy mipmapszintjéhez."

#. RenderSceneBuffersRD.get_use_debanding
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns [code]true[/code] if debanding is enabled."
msgstr "[code]true[/code] értéket ad vissza, ha a színsávok csökkentése engedélyezve van."

#. RenderSceneBuffersRD.get_use_taa
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns [code]true[/code] if TAA is enabled."
msgstr "[code]true[/code] értéket ad vissza, ha a temporális élsimítás (TAA) engedélyezve van."

#. RenderSceneBuffersRD.get_velocity_layer
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the specified layer from the velocity texture we are rendering 3D content to."
msgstr "A 3D-s tartalomhoz használt mozgásvektor-textúra megadott rétegét adja vissza."

#. RenderSceneBuffersRD.get_view_count
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns the view count for the associated viewport."
msgstr "A kapcsolódó nézetablak nézeteinek számát adja vissza."

#. RenderSceneBuffersRD.has_texture
#: doc/classes/RenderSceneBuffersRD.xml
msgid "Returns [code]true[/code] if a cached texture exists for this name."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott néven van gyorsítótárazott textúra."

#. RDAttachmentFormat.brief
#: doc/classes/RDAttachmentFormat.xml
msgid "Attachment format (used by [RenderingDevice])."
msgstr "Csatolmányformátum a [RenderingDevice] számára."

#. RDAttachmentFormat.format
#: doc/classes/RDAttachmentFormat.xml
msgid "The attachment's data format."
msgstr "A csatolmány adatformátuma."

#. RDAttachmentFormat.samples
#: doc/classes/RDAttachmentFormat.xml
msgid "The number of samples used when sampling the attachment."
msgstr "A csatolmány mintáinak száma."

#. RDAttachmentFormat.usage_flags
#: doc/classes/RDAttachmentFormat.xml
msgid "The attachment's usage flags, which determine what can be done with it."
msgstr "A csatolmány használati jelzői. Ezek határozzák meg, milyen műveletekhez használható."

#. RDShaderFile.get_spirv
#: doc/classes/RDShaderFile.xml
msgid "Returns the SPIR-V intermediate representation for the specified shader [param version]."
msgstr "A megadott [param version] shaderváltozat SPIR-V köztes ábrázolását adja vissza."

#. RenderingDevice.BARRIER_MASK_VERTEX
#: doc/classes/RenderingDevice.xml
msgid "Vertex shader barrier mask."
msgstr "A vertexshader szinkronizációs maszkja."

#. RenderingDevice.BARRIER_MASK_FRAGMENT
#: doc/classes/RenderingDevice.xml
msgid "Fragment shader barrier mask."
msgstr "A fragmentshader szinkronizációs maszkja."

#. RenderingDevice.BARRIER_MASK_COMPUTE
#: doc/classes/RenderingDevice.xml
msgid "Compute barrier mask."
msgstr "A számítási műveletek szinkronizációs maszkja."

#. RenderingDevice.BARRIER_MASK_TRANSFER
#: doc/classes/RenderingDevice.xml
msgid "Transfer barrier mask."
msgstr "Az adatátviteli műveletek szinkronizációs maszkja."

#. RenderingDevice.BARRIER_MASK_RASTER
#: doc/classes/RenderingDevice.xml
msgid "Raster barrier mask (vertex and fragment). Equivalent to [code]BARRIER_MASK_VERTEX | BARRIER_MASK_FRAGMENT[/code]."
msgstr "A raszterizálás szinkronizációs maszkja a vertex- és fragmentshaderekhez. Egyenértékű ezzel a kifejezéssel: [code]BARRIER_MASK_VERTEX | BARRIER_MASK_FRAGMENT[/code]."

#. RenderingDevice.BARRIER_MASK_ALL_BARRIERS
#: doc/classes/RenderingDevice.xml
msgid "Barrier mask for all types (vertex, fragment, compute, transfer)."
msgstr "Szinkronizációs maszk minden szakaszhoz, beleértve a vertex- és fragmentshadereket, a számítási műveleteket és az adatátvitelt."

#. RenderingDevice.BARRIER_MASK_NO_BARRIER
#: doc/classes/RenderingDevice.xml
msgid "No barrier for any type."
msgstr "Egyik szakaszhoz sem rendel szinkronizációt."

#. RenderingDevice.TEXTURE_TYPE_1D
#: doc/classes/RenderingDevice.xml
msgid "1-dimensional texture."
msgstr "Egydimenziós textúra."

#. RenderingDevice.TEXTURE_TYPE_2D
#: doc/classes/RenderingDevice.xml
msgid "2-dimensional texture."
msgstr "Kétdimenziós textúra."

#. RenderingDevice.TEXTURE_TYPE_3D
#: doc/classes/RenderingDevice.xml
msgid "3-dimensional texture."
msgstr "Háromdimenziós textúra."

#. RenderingDevice.TEXTURE_TYPE_CUBE
#: doc/classes/RenderingDevice.xml
msgid "[Cubemap] texture."
msgstr "[Cubemap] típusú kockatérkép."

#. RenderingDevice.TEXTURE_TYPE_1D_ARRAY
#: doc/classes/RenderingDevice.xml
msgid "Array of 1-dimensional textures."
msgstr "Egydimenziós textúrák tömbje."

#. RenderingDevice.TEXTURE_TYPE_2D_ARRAY
#: doc/classes/RenderingDevice.xml
msgid "Array of 2-dimensional textures."
msgstr "Kétdimenziós textúrák tömbje."

#. RenderingDevice.TEXTURE_TYPE_CUBE_ARRAY
#: doc/classes/RenderingDevice.xml
msgid "Array of [Cubemap] textures."
msgstr "[Cubemap] típusú kockatérképek tömbje."

#. RenderingDevice.TEXTURE_SAMPLES_1
#: doc/classes/RenderingDevice.xml
msgid "Perform 1 texture sample (this is the fastest but lowest-quality for antialiasing)."
msgstr "1 mintát vesz a textúrából. Ez a leggyorsabb beállítás, és ez adja a leggyengébb élsimítást."

#. RenderingDevice.TEXTURE_SAMPLES_2
#: doc/classes/RenderingDevice.xml
msgid "Perform 2 texture samples."
msgstr "2 mintát vesz a textúrából."

#. RenderingDevice.TEXTURE_SAMPLES_4
#: doc/classes/RenderingDevice.xml
msgid "Perform 4 texture samples."
msgstr "4 mintát vesz a textúrából."

#. RenderingDevice.TEXTURE_SAMPLES_32
#: doc/classes/RenderingDevice.xml
msgid "Perform 32 texture samples. Not supported on most GPUs."
msgstr "32 mintát vesz a textúrából. A legtöbb GPU nem támogatja."

#. RenderingDevice.TEXTURE_SAMPLES_64
#: doc/classes/RenderingDevice.xml
msgid "Perform 64 texture samples (this is the slowest but highest-quality for antialiasing). Not supported on most GPUs."
msgstr "64 mintát vesz a textúrából. Ez a leglassabb beállítás, és ez adja a legjobb élsimítást. A legtöbb GPU nem támogatja."

#. RenderingDevice.TEXTURE_SAMPLES_MAX
#: doc/classes/RenderingDevice.xml
msgid "Represents the size of the [enum TextureSamples] enum."
msgstr "A [enum TextureSamples] felsorolás mérete."

#. RenderingDevice.TEXTURE_USAGE_SAMPLING_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be sampled."
msgstr "A textúrából mintát lehet venni."

#. RenderingDevice.TEXTURE_USAGE_COLOR_ATTACHMENT_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be used as a color attachment in a framebuffer."
msgstr "A textúra képpuffer színcsatolmányaként használható."

#. RenderingDevice.TEXTURE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be used as a depth/stencil attachment in a framebuffer."
msgstr "A textúra képpuffer mélység- és sabloncsatolmányaként használható."

#. RenderingDevice.TEXTURE_USAGE_DEPTH_RESOLVE_ATTACHMENT_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be used as a depth/stencil resolve attachment in a framebuffer."
msgstr "A textúra képpuffer többmintás mélység- és sablonadatainak feloldási céljaként használható."

#. RenderingDevice.TEXTURE_USAGE_STORAGE_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/vkspec.html#descriptorsets-storageimage]storage image[/url]."
msgstr "A textúra [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/vkspec.html#descriptorsets-storageimage]tárolóképként[/url] használható."

#. RenderingDevice.TEXTURE_USAGE_STORAGE_ATOMIC_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/vkspec.html#descriptorsets-storageimage]storage image[/url] with support for atomic operations."
msgstr "A textúra [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/vkspec.html#descriptorsets-storageimage]tárolóképként[/url] használható, atomi műveletek támogatásával."

#. RenderingDevice.TEXTURE_USAGE_CPU_READ_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be read back on the CPU using [method texture_get_data] faster than without this bit, since it is always kept in the system memory."
msgstr "A textúra a rendszermemóriában marad, így a CPU gyorsabban olvashatja vissza a [method texture_get_data] metódussal."

#. RenderingDevice.TEXTURE_USAGE_CAN_UPDATE_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be updated using [method texture_update]."
msgstr "A textúra a [method texture_update] metódussal frissíthető."

#. RenderingDevice.TEXTURE_USAGE_CAN_COPY_FROM_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be a source for [method texture_copy]."
msgstr "A textúra a [method texture_copy] metódus forrása lehet."

#. RenderingDevice.TEXTURE_USAGE_CAN_COPY_TO_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be a destination for [method texture_copy]."
msgstr "A textúra a [method texture_copy] metódus célja lehet."

#. RenderingDevice.TEXTURE_USAGE_INPUT_ATTACHMENT_BIT
#: doc/classes/RenderingDevice.xml
msgid "Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/vkspec.html#descriptorsets-inputattachment]input attachment[/url] in a framebuffer."
msgstr "A textúra [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/vkspec.html#descriptorsets-inputattachment]bemeneti csatolmányként[/url] használható egy képpufferben."

#. RenderingDevice.TEXTURE_SWIZZLE_IDENTITY
#: doc/classes/RenderingDevice.xml
msgid "Return the sampled value as-is."
msgstr "A mintavételezett értéket változtatás nélkül adja vissza."

#. RenderingDevice.TEXTURE_SWIZZLE_ZERO
#: doc/classes/RenderingDevice.xml
msgid "Always return [code]0.0[/code] when sampling."
msgstr "Mintavételkor mindig [code]0.0[/code] értéket ad vissza."

#. RenderingDevice.TEXTURE_SWIZZLE_ONE
#: doc/classes/RenderingDevice.xml
msgid "Always return [code]1.0[/code] when sampling."
msgstr "Mintavételkor mindig [code]1.0[/code] értéket ad vissza."

#. RenderingDevice.TEXTURE_SWIZZLE_R
#: doc/classes/RenderingDevice.xml
msgid "Sample the red color channel."
msgstr "A vörös csatornából vesz mintát."

#. RenderingDevice.TEXTURE_SWIZZLE_G
#: doc/classes/RenderingDevice.xml
msgid "Sample the green color channel."
msgstr "A zöld csatornából vesz mintát."

#. RenderingDevice.TEXTURE_SWIZZLE_B
#: doc/classes/RenderingDevice.xml
msgid "Sample the blue color channel."
msgstr "A kék csatornából vesz mintát."

#. RenderingDevice.TEXTURE_SWIZZLE_A
#: doc/classes/RenderingDevice.xml
msgid "Sample the alpha channel."
msgstr "Az alfa-csatornából vesz mintát."

#. RenderingDevice.TEXTURE_SWIZZLE_MAX
#: doc/classes/RenderingDevice.xml
msgid "Represents the size of the [enum TextureSwizzle] enum."
msgstr "A [enum TextureSwizzle] felsorolás mérete."

#. RenderingDevice.TEXTURE_SLICE_2D
#: doc/classes/RenderingDevice.xml
msgid "2-dimensional texture slice."
msgstr "Kétdimenziós textúraszelet."

#. RenderingDevice.TEXTURE_SLICE_CUBEMAP
#: doc/classes/RenderingDevice.xml
msgid "Cubemap texture slice."
msgstr "Kockatérkép-textúra szelete."

#. RenderingDevice.TEXTURE_SLICE_3D
#: doc/classes/RenderingDevice.xml
msgid "3-dimensional texture slice."
msgstr "Háromdimenziós textúraszelet."

#. RenderingDevice.SAMPLER_FILTER_NEAREST
#: doc/classes/RenderingDevice.xml
msgid "Nearest-neighbor sampler filtering. Sampling at higher resolutions than the source will result in a pixelated look."
msgstr "Legközelebbi szomszéd szerinti szűrés. A forrásfelbontás fölé nagyítva a textúra pixelesnek látszik."

#. RenderingDevice.SAMPLER_FILTER_LINEAR
#: doc/classes/RenderingDevice.xml
msgid "Bilinear sampler filtering. Sampling at higher resolutions than the source will result in a blurry look."
msgstr "Bilineáris szűrés. A forrásfelbontás fölé nagyítva a textúra elmosódottnak látszik."

#. RenderingDevice.SAMPLER_REPEAT_MODE_REPEAT
#: doc/classes/RenderingDevice.xml
msgid "Sample with repeating enabled."
msgstr "A mintavétel a textúra ismétlésével folytatódik a széleken túl."

#. RenderingDevice.SAMPLER_REPEAT_MODE_MIRRORED_REPEAT
#: doc/classes/RenderingDevice.xml
msgid "Sample with mirrored repeating enabled. When sampling outside the [code][0.0, 1.0][/code] range, return a mirrored version of the sampler. This mirrored version is mirrored again if sampling further away, with the pattern repeating indefinitely."
msgstr "A textúra tükrözve ismétlődik. A [code][0.0, 1.0][/code] tartományon kívül a szomszédos ismétlés a textúra tükörképe. A minta felváltva tükrözött és eredeti irányban folytatódik."

#. RenderingDevice.SAMPLER_REPEAT_MODE_CLAMP_TO_EDGE
#: doc/classes/RenderingDevice.xml
msgid "Sample with repeating disabled. When sampling outside the [code][0.0, 1.0][/code] range, return the color of the last pixel on the edge."
msgstr "Ismétlés nélküli mintavétel. A [code][0.0, 1.0][/code] tartományon kívül a textúra szélén lévő utolsó texel színét adja vissza."

#. RenderingDevice.SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER
#: doc/classes/RenderingDevice.xml
msgid "Sample with repeating disabled. When sampling outside the [code][0.0, 1.0][/code] range, return the specified [member RDSamplerState.border_color]."
msgstr "Ismétlés nélküli mintavétel. A [code][0.0, 1.0][/code] tartományon kívül a [member RDSamplerState.border_color] tulajdonságban megadott peremszínt adja vissza."

#. RenderingDevice.SAMPLER_REPEAT_MODE_MIRROR_CLAMP_TO_EDGE
#: doc/classes/RenderingDevice.xml
msgid "Sample with mirrored repeating enabled, but only once. When sampling in the [code][-1.0, 0.0][/code] range, return a mirrored version of the sampler. When sampling outside the [code][-1.0, 1.0][/code] range, return the color of the last pixel on the edge."
msgstr "Egyszeri tükrözéssel mintavételez. A [code][-1.0, 0.0][/code] tartományban a tükrözött textúrából olvas. A [code][-1.0, 1.0][/code] tartományon kívül a legszélső texel színét adja vissza."

#. RenderingDevice.SAMPLER_REPEAT_MODE_MAX
#: doc/classes/RenderingDevice.xml
msgid "Represents the size of the [enum SamplerRepeatMode] enum."
msgstr "A [enum SamplerRepeatMode] felsorolás mérete."

#. RenderingDevice.SAMPLER_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK
#: doc/classes/RenderingDevice.xml
msgid "Return a floating-point transparent black color when sampling outside the [code][0.0, 1.0][/code] range. Only effective if the sampler repeat mode is [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr "A [code][0.0, 1.0][/code] tartományon kívül lebegőpontos átlátszó fekete színt ad vissza. Csak [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER] ismétlési módban érvényes."

#. RenderingDevice.SAMPLER_BORDER_COLOR_INT_TRANSPARENT_BLACK
#: doc/classes/RenderingDevice.xml
msgid "Return an integer transparent black color when sampling outside the [code][0.0, 1.0][/code] range. Only effective if the sampler repeat mode is [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr "A [code][0.0, 1.0][/code] tartományon kívül egész értékekkel ábrázolt átlátszó fekete színt ad vissza. Csak [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER] ismétlési módban érvényes."

#. RenderingDevice.SAMPLER_BORDER_COLOR_FLOAT_OPAQUE_BLACK
#: doc/classes/RenderingDevice.xml
msgid "Return a floating-point opaque black color when sampling outside the [code][0.0, 1.0][/code] range. Only effective if the sampler repeat mode is [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr "A [code][0.0, 1.0][/code] tartományon kívül lebegőpontos fedő fekete színt ad vissza. Csak [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER] ismétlési módban érvényes."

#. RenderingDevice.SAMPLER_BORDER_COLOR_INT_OPAQUE_BLACK
#: doc/classes/RenderingDevice.xml
msgid "Return an integer opaque black color when sampling outside the [code][0.0, 1.0][/code] range. Only effective if the sampler repeat mode is [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr "A [code][0.0, 1.0][/code] tartományon kívül egész értékekkel ábrázolt fedő fekete színt ad vissza. Csak [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER] ismétlési módban érvényes."

#. RenderingDevice.SAMPLER_BORDER_COLOR_FLOAT_OPAQUE_WHITE
#: doc/classes/RenderingDevice.xml
msgid "Return a floating-point opaque white color when sampling outside the [code][0.0, 1.0][/code] range. Only effective if the sampler repeat mode is [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr "A [code][0.0, 1.0][/code] tartományon kívül lebegőpontos fedő fehér színt ad vissza. Csak [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER] ismétlési módban érvényes."

#. RenderingDevice.SAMPLER_BORDER_COLOR_INT_OPAQUE_WHITE
#: doc/classes/RenderingDevice.xml
msgid "Return an integer opaque white color when sampling outside the [code][0.0, 1.0][/code] range. Only effective if the sampler repeat mode is [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr "A [code][0.0, 1.0][/code] tartományon kívül egész értékekkel ábrázolt fedő fehér színt ad vissza. Csak [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER] ismétlési módban érvényes."

#. RenderingDevice.SAMPLER_BORDER_COLOR_MAX
#: doc/classes/RenderingDevice.xml
msgid "Represents the size of the [enum SamplerBorderColor] enum."
msgstr "A [enum SamplerBorderColor] felsorolás mérete."

#. RenderingDevice.VERTEX_FREQUENCY_VERTEX
#: doc/classes/RenderingDevice.xml
msgid "Vertex attribute addressing is a function of the vertex. This is used to specify the rate at which vertex attributes are pulled from buffers."
msgstr "A csúcsattribútum címét a csúcs indexe határozza meg. Ezzel az attribútumok csúcsonként olvashatók ki a pufferből."

#. RenderingDevice.VERTEX_FREQUENCY_INSTANCE
#: doc/classes/RenderingDevice.xml
msgid "Vertex attribute addressing is a function of the instance index. This is used to specify the rate at which vertex attributes are pulled from buffers."
msgstr "A csúcsattribútum címét a példány indexe határozza meg. Ezzel az attribútumok példányonként olvashatók ki a pufferből."

#. RenderingDevice.INDEX_BUFFER_FORMAT_UINT16
#: doc/classes/RenderingDevice.xml
msgid "Index buffer in 16-bit unsigned integer format. This limits the maximum index that can be specified to [code]65535[/code]."
msgstr "A puffer 16 bites előjel nélküli egész indexeket tárol. A legnagyobb megadható index [code]65535[/code]."

#. RenderingDevice.INDEX_BUFFER_FORMAT_UINT32
#: doc/classes/RenderingDevice.xml
msgid "Index buffer in 32-bit unsigned integer format. This limits the maximum index that can be specified to [code]4294967295[/code]."
msgstr "A puffer 32 bites előjel nélküli egész indexeket tárol. A legnagyobb megadható index [code]4294967295[/code]."

#. RenderingDevice.BUFFER_CREATION_AS_STORAGE_BIT
#: doc/classes/RenderingDevice.xml
msgid "Set this flag so that it is created as storage. This is useful if Compute Shaders need access (for reading or writing) to the buffer, e.g. skeletal animations are processed in Compute Shaders which need access to vertex buffers, to be later consumed by vertex shaders as part of the regular rasterization pipeline."
msgstr "Ezzel a jelzővel tárolópufferként hozhatod létre a puffert, hogy számítási shaderek olvashassák vagy írhassák. Csontvázanimációnál például a számítási shader frissítheti a csúcspuffert, amelyet később a raszterizálás során a vertexshader olvas."

#. RenderingDevice.ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT
#: doc/classes/RenderingDevice.xml
msgid "Allows the acceleration structure to be updated after it has been built."
msgstr "Lehetővé teszi a gyorsítóstruktúra frissítését a felépítése után."

#. RenderingDevice.ACCELERATION_STRUCTURE_ALLOW_COMPACTION_BIT
#: doc/classes/RenderingDevice.xml
msgid "Allows the acceleration structure to be compacted to reduce memory usage after it has been built."
msgstr "A felépítés után tömöríthetővé teszi a gyorsítóstruktúrát a memóriaigény csökkentéséhez."

#. RenderingDevice.ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT
#: doc/classes/RenderingDevice.xml
msgid "Prioritizes ray traversal performance over build performance when building the acceleration structure."
msgstr "A gyorsítóstruktúra létrehozásakor a sugarak gyors bejárását részesíti előnyben a gyors felépítéssel szemben."

#. RenderingDevice.ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT
#: doc/classes/RenderingDevice.xml
msgid "Prioritizes build performance over ray traversal performance when building the acceleration structure."
msgstr "A gyorsítóstruktúra gyors felépítését részesíti előnyben a sugarak gyors bejárásával szemben."

#. RenderingDevice.ACCELERATION_STRUCTURE_LOW_MEMORY_BIT
#: doc/classes/RenderingDevice.xml
msgid "Reduces the memory usage of the acceleration structure, potentially at the cost of reduced ray traversal performance."
msgstr "Csökkenti a gyorsítóstruktúra memóriaigényét. A sugarak bejárása ettől lassabb lehet."

#. RenderingDevice.ACCELERATION_STRUCTURE_GEOMETRY_OPAQUE_BIT
#: doc/classes/RenderingDevice.xml
msgid "An opaque geometry does not invoke the any hit shaders."
msgstr "Átlátszatlan geometria esetén az any-hit shaderek nem futnak le."

#. RenderingDevice.ACCELERATION_STRUCTURE_GEOMETRY_NO_DUPLICATE_ANY_HIT_INVOCATION_BIT
#: doc/classes/RenderingDevice.xml
msgid "This geometry only calls the any hit shader a single time for each primitive."
msgstr "A geometria primitívenként legfeljebb egyszer hívja meg az any-hit shadert."

#. RenderingDevice.ACCELERATION_STRUCTURE_INSTANCE_TRIANGLE_FACING_CULL_DISABLE_BIT
#: doc/classes/RenderingDevice.xml
msgid "Disables triangle face culling for this instance during ray traversal."
msgstr "A sugár bejárásakor kikapcsolja ennél a példánynál a háromszöglapok irány szerinti eldobását."

#. RenderingDevice.ACCELERATION_STRUCTURE_INSTANCE_TRIANGLE_FLIP_FACING_BIT
#: doc/classes/RenderingDevice.xml
msgid "Flips the triangle facing direction for this instance during ray traversal."
msgstr "A sugár bejárásakor megfordítja ennél a példánynál a háromszögek lapirányát."

#. RenderingDevice.ACCELERATION_STRUCTURE_INSTANCE_FORCE_OPAQUE_BIT
#: doc/classes/RenderingDevice.xml
msgid "Forces all geometries in this instance to be treated as opaque, preventing any hit shaders from being invoked."
msgstr "A példány minden geometriáját átlátszatlanként kezeli, így az any-hit shaderek kimaradnak."

#. RenderingDevice.ACCELERATION_STRUCTURE_INSTANCE_FORCE_NO_OPAQUE_BIT
#: doc/classes/RenderingDevice.xml
msgid "Forces all geometries in this instance to be treated as non-opaque, allowing any hit shaders to be invoked."
msgstr "A példány minden geometriáját nem átlátszatlanként kezeli, így az any-hit shaderek is lefuthatnak."

#. RenderingDevice.UNIFORM_TYPE_SAMPLER
#: doc/classes/RenderingDevice.xml
msgid "Sampler uniform."
msgstr "Textúramintavételező uniform."

#. RenderingDevice.UNIFORM_TYPE_SAMPLER_WITH_TEXTURE
#: doc/classes/RenderingDevice.xml
msgid "Sampler uniform with a texture."
msgstr "Textúrával együtt megadott mintavételező uniform."

#. RenderingDevice.UNIFORM_TYPE_TEXTURE
#: doc/classes/RenderingDevice.xml
msgid "Texture uniform."
msgstr "Textúrauniform."

#. RenderingDevice.UNIFORM_TYPE_IMAGE
#: doc/classes/RenderingDevice.xml
msgid "Image uniform."
msgstr "Képuniform."

#. RenderingDevice.UNIFORM_TYPE_TEXTURE_BUFFER
#: doc/classes/RenderingDevice.xml
msgid "Texture buffer uniform."
msgstr "Textúrapuffer-uniform."

#. RenderingDevice.UNIFORM_TYPE_SAMPLER_WITH_TEXTURE_BUFFER
#: doc/classes/RenderingDevice.xml
msgid "Sampler uniform with a texture buffer."
msgstr "Textúrapufferrel együtt megadott mintavételező uniform."

#. RenderingDevice.UNIFORM_TYPE_IMAGE_BUFFER
#: doc/classes/RenderingDevice.xml
msgid "Image buffer uniform."
msgstr "Képpuffer-uniform."

#. RenderingDevice.UNIFORM_TYPE_UNIFORM_BUFFER
#: doc/classes/RenderingDevice.xml
msgid "Uniform buffer uniform."
msgstr "Uniformpufferhez tartozó uniform."

#. RenderingDevice.UNIFORM_TYPE_STORAGE_BUFFER
#: doc/classes/RenderingDevice.xml
msgid "[url=https://vkguide.dev/docs/chapter-4/storage_buffers/]Storage buffer[/url] uniform."
msgstr "[url=https://vkguide.dev/docs/chapter-4/storage_buffers/]Tárolópufferhez[/url] tartozó uniform."

#. RenderingDevice.UNIFORM_TYPE_INPUT_ATTACHMENT
#: doc/classes/RenderingDevice.xml
msgid "Input attachment uniform."
msgstr "Bemeneti csatolmányhoz tartozó uniform."

#. RenderingDevice.UNIFORM_TYPE_ACCELERATION_STRUCTURE
#: doc/classes/RenderingDevice.xml
msgid "Acceleration structure uniform."
msgstr "Gyorsítóstruktúrához tartozó uniform."

#. RenderingDevice.UNIFORM_TYPE_MAX
#: doc/classes/RenderingDevice.xml
msgid "Represents the size of the [enum UniformType] enum."
msgstr "A [enum UniformType] felsorolás mérete."

#. RDUniform.brief
#: doc/classes/RDUniform.xml
msgid "Shader uniform (used by [RenderingDevice])."
msgstr "Shaderuniform a [RenderingDevice] számára."

#. RDUniform.add_id
#: doc/classes/RDUniform.xml
msgid "Binds the given id to the uniform. The data associated with the id is then used when the uniform is passed to a shader."
msgstr "Hozzárendeli a megadott azonosítót az uniformhoz. Az azonosítóhoz tartozó adatot a shader akkor használhatja, amikor megkapja az uniformot."

#. RDUniform.clear_ids
#: doc/classes/RDUniform.xml
msgid "Unbinds all ids currently bound to the uniform."
msgstr "Megszünteti az uniformhoz rendelt összes azonosító kötését."

#. RDUniform.get_ids
#: doc/classes/RDUniform.xml
msgid "Returns an array of all ids currently bound to the uniform."
msgstr "Tömbben adja vissza az uniformhoz rendelt összes azonosítót."

#. RDUniform.binding
#: doc/classes/RDUniform.xml
msgid "The uniform's binding."
msgstr "Az uniform kötési helye."

#. RDUniform.uniform_type
#: doc/classes/RDUniform.xml
msgid "The uniform's data type."
msgstr "Az uniform adattípusa."

#. RenderingDevice.brief
#: doc/classes/RenderingDevice.xml
msgid "Abstraction for working with modern low-level graphics APIs."
msgstr "Absztrakciós réteg a modern, alacsony szintű grafikus API-k használatához."

#. RenderingDevice.blas_build
#: doc/classes/RenderingDevice.xml
msgid "Builds the [param blas]."
msgstr "Felépíti a [param blas] alsó szintű gyorsítóstruktúrát."

#. RenderingDevice.capture_timestamp
#: doc/classes/RenderingDevice.xml
msgid "Creates a timestamp marker with the specified [param name]. This is used for performance reporting with the [method get_captured_timestamp_cpu_time], [method get_captured_timestamp_gpu_time] and [method get_captured_timestamp_name] methods."
msgstr "Időbélyegjelölőt hoz létre a megadott [param name] néven. A teljesítmény méréséhez a [method get_captured_timestamp_cpu_time], a [method get_captured_timestamp_gpu_time] és a [method get_captured_timestamp_name] metódussal kérhetők le az adatai."

#. RenderingDevice.compute_list_add_barrier
#: doc/classes/RenderingDevice.xml
msgid "Raises a Vulkan compute barrier in the specified [param compute_list]."
msgstr "Vulkan számítási szinkronizációs pontot illeszt a megadott [param compute_list] parancslistába."

#. RenderingDevice.compute_list_bind_compute_pipeline
#: doc/classes/RenderingDevice.xml
msgid "Tells the GPU what compute pipeline to use when processing the compute list. If the shader has changed since the last time this function was called, Godot will unbind all descriptor sets and will re-bind them inside [method compute_list_dispatch]."
msgstr "Megadja, melyik számítási folyamatot használja a GPU a parancslista végrehajtásához. Ha a shader megváltozott a legutóbbi hívás óta, a Godot leválasztja az összes leírókészletet, majd a [method compute_list_dispatch] hívásban újra hozzárendeli őket."

#. RenderingDevice.compute_list_bind_uniform_set
#: doc/classes/RenderingDevice.xml
msgid "Binds the [param uniform_set] to this [param compute_list]. Godot ensures that all textures in the uniform set have the correct Vulkan access masks. If Godot had to change access masks of textures, it will raise a Vulkan image memory barrier."
msgstr "A [param uniform_set] uniformkészletet a [param compute_list] parancslistához rendeli. A Godot gondoskodik a készlethez tartozó textúrák megfelelő Vulkan hozzáférési maszkjáról, és ha módosítania kell ezeket, képmemória-szinkronizációt iktat be."

#. RenderingDevice.compute_list_dispatch
#: doc/classes/RenderingDevice.xml
msgid "Submits the compute list for processing on the GPU. This is the compute equivalent to [method draw_list_draw]."
msgstr "GPU-n végrehajtandó számítási műveletet rögzít a parancslistába. A [method draw_list_draw] számítási megfelelője."

#. RenderingDevice.compute_list_dispatch_indirect
#: doc/classes/RenderingDevice.xml
msgid "Submits the compute list for processing on the GPU with the given group counts stored in the [param buffer] at [param offset]. Buffer must have been created with [constant STORAGE_BUFFER_USAGE_DISPATCH_INDIRECT] flag."
msgstr "GPU-n végrehajtandó közvetett számítási műveletet rögzít. A munkacsoportok számát a megadott [param buffer] pufferből, a [param offset] bájteltolástól olvassa ki a GPU. A puffert a [constant STORAGE_BUFFER_USAGE_DISPATCH_INDIRECT] jelzővel kell létrehozni."

#. RenderingDevice.compute_list_end
#: doc/classes/RenderingDevice.xml
msgid "Finishes a list of compute commands created with the [code]compute_*[/code] methods."
msgstr "Lezárja a [code]compute_*[/code] metódusokkal összeállított számítási parancslistát."

#. RenderingServer.camera_set_camera_attributes
#: doc/classes/RenderingServer.xml
msgid "Sets the camera_attributes created with [method camera_attributes_create] to the given camera."
msgstr "A [method camera_attributes_create] metódussal létrehozott kamerajellemzőket a megadott kamerához rendeli."

#. RenderingServer.camera_set_compositor
#: doc/classes/RenderingServer.xml
msgid "Sets the compositor used by this camera. Equivalent to [member Camera3D.compositor]."
msgstr "Beállítja a kamera kompozitorát. A [member Camera3D.compositor] tulajdonságnak felel meg."

#. RenderingServer.camera_set_cull_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the cull mask associated with this camera. The cull mask describes which 3D layers are rendered by this camera. Equivalent to [member Camera3D.cull_mask]."
msgstr "Beállítja a kamera láthatósági maszkját. Ez szabja meg, mely 3D-s rétegeket rajzolja ki a kamera. A [member Camera3D.cull_mask] tulajdonságnak felel meg."

#. RenderingServer.camera_set_environment
#: doc/classes/RenderingServer.xml
msgid "Sets the environment used by this camera. Equivalent to [member Camera3D.environment]."
msgstr "Beállítja a kamera környezetét. A [member Camera3D.environment] tulajdonságnak felel meg."

#. RenderingServer.camera_set_frustum
#: doc/classes/RenderingServer.xml
msgid "Sets camera to use frustum projection. This mode allows adjusting the [param offset] argument to create \"tilted frustum\" effects."
msgstr "Látógúla-vetítésre állítja a kamerát. Az [param offset] módosításával eltolt látógúla hozható létre."

#. RenderingServer.camera_set_orthogonal
#: doc/classes/RenderingServer.xml
msgid "Sets camera to use orthogonal projection, also known as orthographic projection. Objects remain the same size on the screen no matter how far away they are."
msgstr "Ortogonális, más néven ortografikus vetítésre állítja a kamerát. Az objektumok képernyőn látható mérete a távolságtól független."

#. RenderingServer.camera_set_perspective
#: doc/classes/RenderingServer.xml
msgid "Sets camera to use perspective projection. Objects on the screen becomes smaller when they are far away."
msgstr "Perspektivikus vetítésre állítja a kamerát. A távolabbi objektumok kisebbnek látszanak a képernyőn."

#. RenderingServer.camera_set_transform
#: doc/classes/RenderingServer.xml
msgid "Sets [Transform3D] of camera."
msgstr "Beállítja a kamera [Transform3D] transzformációját."

#. RenderingServer.camera_set_use_vertical_aspect
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], preserves the horizontal aspect ratio which is equivalent to [constant Camera3D.KEEP_WIDTH]. If [code]false[/code], preserves the vertical aspect ratio which is equivalent to [constant Camera3D.KEEP_HEIGHT]."
msgstr "A [code]true[/code] érték a kamera vízszintes látómezejét, ortografikus vetítésnél a nézet szélességét tartja meg. Ez a [constant Camera3D.KEEP_WIDTH] mód. A [code]false[/code] érték a [constant Camera3D.KEEP_HEIGHT] módnak felel meg, és a függőleges látómezőt, illetve a nézet magasságát tartja meg."

#. RenderingServer.canvas_item_set_copy_to_backbuffer
#: doc/classes/RenderingServer.xml
msgid "Sets the [CanvasItem] to copy a rect to the backbuffer."
msgstr "Beállítja, hogy a [CanvasItem] egy téglalap alakú területet a háttérpufferbe másoljon."

#. RenderingServer.canvas_item_set_default_texture_filter
#: doc/classes/RenderingServer.xml
msgid "Sets the default texture filter mode for the canvas item specified by the [param item] RID. Equivalent to [member CanvasItem.texture_filter]."
msgstr "Beállítja a [param item] RID-del megadott vászonelem alapértelmezett textúraszűrési módját. A [member CanvasItem.texture_filter] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_default_texture_repeat
#: doc/classes/RenderingServer.xml
msgid "Sets the default texture repeat mode for the canvas item specified by the [param item] RID. Equivalent to [member CanvasItem.texture_repeat]."
msgstr "Beállítja a [param item] RID-del megadott vászonelem alapértelmezett textúraismétlési módját. A [member CanvasItem.texture_repeat] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_distance_field_mode
#: doc/classes/RenderingServer.xml
msgid "If [param enabled] is [code]true[/code], enables multichannel signed distance field rendering mode for the canvas item specified by the [param item] RID. This is meant to be used for font rendering, or with specially generated images using [url=https://github.com/Chlumsky/msdfgen]msdfgen[/url]."
msgstr "Ha az [param enabled] értéke [code]true[/code], bekapcsolja a többcsatornás előjeles távolságmező renderelését a [param item] RID-del megadott vászonelemnél. Betűkészletekhez vagy az [url=https://github.com/Chlumsky/msdfgen]msdfgen[/url] eszközzel előállított képekhez használható."

#. RenderingServer.canvas_item_set_draw_behind_parent
#: doc/classes/RenderingServer.xml
msgid "If [param enabled] is [code]true[/code], draws the canvas item specified by the [param item] RID behind its parent. Equivalent to [member CanvasItem.show_behind_parent]."
msgstr "Ha az [param enabled] értéke [code]true[/code], a [param item] RID-del megadott vászonelem a szülője mögé kerül. A [member CanvasItem.show_behind_parent] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_draw_index
#: doc/classes/RenderingServer.xml
msgid "Sets the index for the [CanvasItem]."
msgstr "Beállítja a [CanvasItem] kirajzolási indexét."

#. RenderingServer.canvas_item_set_instance_shader_parameter
#: doc/classes/RenderingServer.xml
msgid "Sets the per-instance shader uniform on the specified canvas item instance. Equivalent to [method CanvasItem.set_instance_shader_parameter]."
msgstr "Beállítja a megadott vászonelem-példány egyedi shaderuniformját. A [method CanvasItem.set_instance_shader_parameter] metódusnak felel meg."

#. RenderingServer.canvas_item_set_interpolated
#: doc/classes/RenderingServer.xml
msgid "If [param interpolated] is [code]true[/code], turns on physics interpolation for the canvas item."
msgstr "Ha az [param interpolated] értéke [code]true[/code], bekapcsolja a fizikai interpolációt a vászonelemnél."

#. RenderingServer.canvas_item_set_light_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the light [param mask] for the canvas item specified by the [param item] RID. Equivalent to [member CanvasItem.light_mask]."
msgstr "Beállítja a [param item] RID-del megadott vászonelem [param mask] fénymaszkját. A [member CanvasItem.light_mask] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_material
#: doc/classes/RenderingServer.xml
msgid "Sets a new [param material] to the canvas item specified by the [param item] RID. Equivalent to [member CanvasItem.material]."
msgstr "A [param material] anyagot a [param item] RID-del megadott vászonelemhez rendeli. A [member CanvasItem.material] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_modulate
#: doc/classes/RenderingServer.xml
msgid "Multiplies the color of the canvas item specified by the [param item] RID, while affecting its children. See also [method canvas_item_set_self_modulate]. Equivalent to [member CanvasItem.modulate]."
msgstr "Megszorozza a [param item] RID-del megadott vászonelem színét, és a színmódosítást a gyerekeire is alkalmazza. Lásd még a [method canvas_item_set_self_modulate] metódust. A [member CanvasItem.modulate] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_parent
#: doc/classes/RenderingServer.xml
msgid "Sets a parent [CanvasItem] to the [CanvasItem]. The item will inherit transform, modulation and visibility from its parent, like [CanvasItem] nodes in the scene tree."
msgstr "Szülő [CanvasItem] elemet rendel a [CanvasItem] elemhez. A jelenetfa [CanvasItem] csomópontjaihoz hasonlóan az elem örökli szülője transzformációját, színmódosítását és láthatóságát."

#. RenderingServer.canvas_item_set_self_modulate
#: doc/classes/RenderingServer.xml
msgid "Multiplies the color of the canvas item specified by the [param item] RID, without affecting its children. See also [method canvas_item_set_modulate]. Equivalent to [member CanvasItem.self_modulate]."
msgstr "A [param item] RID-del megadott vászonelem saját színét szorozza meg. A gyerekeire ez a beállítás nem hat. Lásd még a [method canvas_item_set_modulate] metódust. A [member CanvasItem.self_modulate] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_sort_children_by_y
#: doc/classes/RenderingServer.xml
msgid "If [param enabled] is [code]true[/code], child nodes with the lowest Y position are drawn before those with a higher Y position. Y-sorting only affects children that inherit from the canvas item specified by the [param item] RID, not the canvas item itself. Equivalent to [member CanvasItem.y_sort_enabled]."
msgstr "Ha az [param enabled] értéke [code]true[/code], a renderelő előbb rajzolja ki a kisebb Y-koordinátájú gyerekcsomópontokat. A rendezés a [param item] RID-del megadott vászonelem gyerekeire vonatkozik. A vászonelem saját sorrendjét ez a beállítás nem módosítja. A [member CanvasItem.y_sort_enabled] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_transform
#: doc/classes/RenderingServer.xml
msgid "Sets the [param transform] of the canvas item specified by the [param item] RID. This affects where and how the item will be drawn. Child canvas items' transforms are multiplied by their parent's transform. Equivalent to [member Node2D.transform]."
msgstr "Beállítja a [param item] RID-del megadott vászonelem [param transform] transzformációját. Ettől függ, hol és hogyan jelenik meg az elem. A gyerekeinek transzformációját a szülő transzformációjával szorozza meg. A [member Node2D.transform] tulajdonságnak felel meg."

#. RenderingServer.canvas_item_set_use_parent_material
#: doc/classes/RenderingServer.xml
msgid "Sets if the [CanvasItem] uses its parent's material."
msgstr "Beállítja, hogy a [CanvasItem] a szülő anyagát használja-e."

#. RenderingServer.canvas_item_set_visibility_layer
#: doc/classes/RenderingServer.xml
msgid "Sets the rendering visibility layer associated with this [CanvasItem]. Only [Viewport] nodes with a matching rendering mask will render this [CanvasItem]."
msgstr "Beállítja a [CanvasItem] renderelési láthatósági rétegét. Csak az egyező renderelési maszkkal rendelkező [Viewport] csomópontok rajzolják ki ezt a [CanvasItem] elemet."

#. RenderingServer.canvas_item_set_visible
#: doc/classes/RenderingServer.xml
msgid "Sets the visibility of the [CanvasItem]."
msgstr "Beállítja a [CanvasItem] láthatóságát."

#. RenderingServer.canvas_item_set_z_as_relative_to_parent
#: doc/classes/RenderingServer.xml
msgid "If this is enabled, the Z index of the parent will be added to the children's Z index."
msgstr "Ha engedélyezve van, a szülő Z-indexe hozzáadódik a gyerekek Z-indexéhez."

#. RenderingServer.canvas_item_set_z_index
#: doc/classes/RenderingServer.xml
msgid "Sets the [CanvasItem]'s Z index, i.e. its draw order (lower indexes are drawn first)."
msgstr "Beállítja a [CanvasItem] Z-indexét, vagyis a kirajzolási sorrendjét. A kisebb indexű elemek kerülnek sorra először."

#. RenderingServer.environment_set_adjustment
#: doc/classes/RenderingServer.xml
msgid "Sets the values to be used with the \"adjustments\" post-process effect. See [Environment] for more details."
msgstr "Beállítja a képbeállítások utófeldolgozási effektjének értékeit. A részletekért lásd az [Environment] osztályt."

#. RenderingServer.environment_set_ambient_light
#: doc/classes/RenderingServer.xml
msgid "Sets the values to be used for ambient light rendering. See [Environment] for more details."
msgstr "Beállítja a környezeti fény rendereléséhez használt értékeket. A részletekért lásd az [Environment] osztályt."

#. RenderingServer.environment_set_background
#: doc/classes/RenderingServer.xml
msgid "Sets the environment's background mode. Equivalent to [member Environment.background_mode]."
msgstr "Beállítja a környezet hátterének módját. A [member Environment.background_mode] tulajdonságnak felel meg."

#. RenderingServer.environment_set_bg_color
#: doc/classes/RenderingServer.xml
msgid "Color displayed for clear areas of the scene. Only effective if using the [constant ENV_BG_COLOR] background mode."
msgstr "A jelenet üres területein megjelenő szín. Csak az [constant ENV_BG_COLOR] háttérmódban érvényes."

#. RenderingServer.environment_set_bg_energy
#: doc/classes/RenderingServer.xml
msgid "Sets the intensity of the background color."
msgstr "Beállítja a háttérszín intenzitását."

#. RenderingServer.environment_set_canvas_max_layer
#: doc/classes/RenderingServer.xml
msgid "Sets the maximum layer to use if using Canvas background mode."
msgstr "Vászon háttérmódban beállítja a használható legfelső vászonréteget."

#. RenderingServer.environment_set_fog
#: doc/classes/RenderingServer.xml
msgid "Configures fog for the specified environment RID. See [code]fog_*[/code] properties in [Environment] for more information."
msgstr "Beállítja a ködöt a megadott környezet-RID-hez. Részletekért lásd az [Environment] osztály [code]fog_*[/code] tulajdonságait."

#. RenderingServer.environment_set_fog_depth
#: doc/classes/RenderingServer.xml
msgid "Configures fog depth for the specified environment RID. Only has an effect when the fog mode of the environment is [constant ENV_FOG_MODE_DEPTH]. See [code]fog_depth_*[/code] properties in [Environment] for more information."
msgstr "Beállítja a távolságalapú köd értékeit a megadott környezet-RID-hez. Csak az [constant ENV_FOG_MODE_DEPTH] ködmódban hatásos. Részletekért lásd az [Environment] osztály [code]fog_depth_*[/code] tulajdonságait."

#. RenderingServer.environment_set_glow
#: doc/classes/RenderingServer.xml
msgid "Configures glow for the specified environment RID. See [code]glow_*[/code] properties in [Environment] for more information."
msgstr "Beállítja a ragyogáseffektet a megadott környezet-RID-hez. Részletekért lásd az [Environment] osztály [code]glow_*[/code] tulajdonságait."

#. RenderingServer.environment_set_sdfgi
#: doc/classes/RenderingServer.xml
msgid "Configures signed distance field global illumination for the specified environment RID. See [code]sdfgi_*[/code] properties in [Environment] for more information."
msgstr "Beállítja az előjeles távolságmezőn alapuló globális megvilágítást a megadott környezet-RID-hez. Részletekért lásd az [Environment] osztály [code]sdfgi_*[/code] tulajdonságait."

#. RenderingServer.environment_set_sdfgi_frames_to_converge
#: doc/classes/RenderingServer.xml
msgid "Sets the number of frames to use for converging signed distance field global illumination. Equivalent to [member ProjectSettings.rendering/global_illumination/sdfgi/frames_to_converge]."
msgstr "Megadja, hány képkocka alatt közelítsen végleges értékéhez az előjeles távolságmezőn alapuló globális megvilágítás. A [member ProjectSettings.rendering/global_illumination/sdfgi/frames_to_converge] beállításnak felel meg."

#. RenderingServer.environment_set_sdfgi_frames_to_update_light
#: doc/classes/RenderingServer.xml
msgid "Sets the update speed for dynamic lights' indirect lighting when computing signed distance field global illumination. Equivalent to [member ProjectSettings.rendering/global_illumination/sdfgi/frames_to_update_lights]."
msgstr "Beállítja, milyen gyorsan frissüljön a mozgó vagy változó fényforrások közvetett megvilágítása az előjeles távolságmezőn alapuló globális megvilágítás számításakor. A [member ProjectSettings.rendering/global_illumination/sdfgi/frames_to_update_lights] beállításnak felel meg."

#. RenderingServer.environment_set_sdfgi_ray_count
#: doc/classes/RenderingServer.xml
msgid "Sets the number of rays to throw per frame when computing signed distance field global illumination. Equivalent to [member ProjectSettings.rendering/global_illumination/sdfgi/probe_ray_count]."
msgstr "Beállítja, hány sugarat kövessen képkockánként az előjeles távolságmezőn alapuló globális megvilágítás. A [member ProjectSettings.rendering/global_illumination/sdfgi/probe_ray_count] beállításnak felel meg."

#. RenderingServer.environment_set_sky
#: doc/classes/RenderingServer.xml
msgid "Sets the [Sky] to be used as the environment's background when using [i]BGMode[/i] sky. Equivalent to [member Environment.sky]."
msgstr "Beállítja a környezet háttereként megjelenő [Sky] erőforrást, ha a [i]BGMode[/i] értéke az égbolt. A [member Environment.sky] tulajdonságnak felel meg."

#. RenderingServer.environment_set_sky_custom_fov
#: doc/classes/RenderingServer.xml
msgid "Sets a custom field of view for the background [Sky]. Equivalent to [member Environment.sky_custom_fov]."
msgstr "Egyéni látómezőt állít be a háttér [Sky] erőforrásához. A [member Environment.sky_custom_fov] tulajdonságnak felel meg."

#. RenderingServer.environment_set_sky_orientation
#: doc/classes/RenderingServer.xml
msgid "Sets the rotation of the background [Sky] expressed as a [Basis]. Equivalent to [member Environment.sky_rotation], where the rotation vector is used to construct the [Basis]."
msgstr "A háttérként használt [Sky] erőforrás forgatását [Basis] értékként állítja be. A [member Environment.sky_rotation] ugyanezt forgatásvektorral adja meg, amelyből a [Basis] előállítható."

#. RenderingServer.environment_set_ssao
#: doc/classes/RenderingServer.xml
msgid "Sets the variables to be used with the screen-space ambient occlusion (SSAO) post-process effect. See [Environment] for more details."
msgstr "Beállítja a képernyőtérbeli környezeti takarás (SSAO) utófeldolgozási effektjének értékeit. A részletekért lásd az [Environment] osztályt."

#. RenderingServer.environment_set_tonemap
#: doc/classes/RenderingServer.xml
msgid "Sets the variables to be used with the \"tonemap\" post-process effect. See [Environment] for more details."
msgstr "Beállítja a tónusleképezés utófeldolgozási effektjének értékeit. A részletekért lásd az [Environment] osztályt."

#. RenderingServer.environment_set_volumetric_fog
#: doc/classes/RenderingServer.xml
msgid "Sets the variables to be used with the volumetric fog post-process effect. See [Environment] for more details."
msgstr "Beállítja a térfogati köd utófeldolgozási effektjének értékeit. A részletekért lásd az [Environment] osztályt."

#. RenderingServer.environment_set_volumetric_fog_filter_active
#: doc/classes/RenderingServer.xml
msgid "Enables filtering of the volumetric fog scattering buffer. This results in much smoother volumes with very few under-sampling artifacts."
msgstr "Bekapcsolja a térfogati köd szórási pufferének szűrését. A térfogatok így sokkal simábbak lesznek, és kevesebb elégtelen mintavételből eredő képhiba látszik."

#. RenderingServer.environment_set_volumetric_fog_volume_size
#: doc/classes/RenderingServer.xml
msgid "Sets the resolution of the volumetric fog's froxel buffer. [param size] is modified by the screen's aspect ratio and then used to set the width and height of the buffer. While [param depth] is directly used to set the depth of the buffer."
msgstr "Beállítja a térfogati köd froxelpufferének felbontását. A puffer szélességét és magasságát a képernyő képarányával módosított [param size] adja meg. A [param depth] közvetlenül a puffer mélységét határozza meg."

#. RenderingServer.material_get_param
#: doc/classes/RenderingServer.xml
msgid "Returns the value of a certain material's parameter."
msgstr "A megadott anyag egyik paraméterének értékét adja vissza."

#. RenderingServer.material_set_next_pass
#: doc/classes/RenderingServer.xml
msgid "Sets an object's next material."
msgstr "Beállítja az objektum következő renderelési menetében használt anyagot."

#. RenderingServer.material_set_param
#: doc/classes/RenderingServer.xml
msgid "Sets a material's parameter."
msgstr "Beállítja egy anyag paraméterének értékét."

#. RenderingServer.material_set_render_priority
#: doc/classes/RenderingServer.xml
msgid "Sets a material's render priority."
msgstr "Beállítja az anyag renderelési prioritását."

#. RenderingServer.material_set_shader
#: doc/classes/RenderingServer.xml
msgid "Sets a shader material's shader."
msgstr "Beállítja a shaderanyag shaderét."

#. RenderingServer.mesh_clear
#: doc/classes/RenderingServer.xml
msgid "Removes all surfaces from a mesh."
msgstr "Eltávolítja a háló összes felületét."

#. RenderingServer.mesh_get_blend_shape_count
#: doc/classes/RenderingServer.xml
msgid "Returns a mesh's blend shape count."
msgstr "A háló alakváltozatainak számát adja vissza."

#. RenderingServer.mesh_get_blend_shape_mode
#: doc/classes/RenderingServer.xml
msgid "Returns a mesh's blend shape mode."
msgstr "A háló alakváltozatainak keverési módját adja vissza."

#. RenderingServer.mesh_get_custom_aabb
#: doc/classes/RenderingServer.xml
msgid "Returns a mesh's custom aabb."
msgstr "A háló egyéni, tengelyekhez igazított befoglaló dobozát adja vissza."

#. RenderingServer.mesh_get_surface
#: doc/classes/RenderingServer.xml
msgid "Returns a mesh's surface as a dictionary following the same structure as described in [method mesh_add_surface]."
msgstr "A háló felületét szótárként adja vissza. A szótár szerkezetét a [method mesh_add_surface] metódus leírása ismerteti."

#. RenderingServer.mesh_get_surface_count
#: doc/classes/RenderingServer.xml
msgid "Returns a mesh's number of surfaces."
msgstr "A háló felületeinek számát adja vissza."

#. RenderingServer.mesh_set_blend_shape_mode
#: doc/classes/RenderingServer.xml
msgid "Sets a mesh's blend shape mode."
msgstr "Beállítja a háló alakváltozatainak keverési módját."

#. RenderingServer.mesh_set_custom_aabb
#: doc/classes/RenderingServer.xml
msgid "Sets a mesh's custom aabb."
msgstr "Beállítja a háló egyéni, tengelyekhez igazított befoglaló dobozát."

#. RenderingServer.mesh_surface_get_arrays
#: doc/classes/RenderingServer.xml
msgid "Returns a mesh's surface's buffer arrays."
msgstr "A háló felületéhez tartozó puffertömböket adja vissza."

#. RenderingServer.mesh_surface_get_blend_shape_arrays
#: doc/classes/RenderingServer.xml
msgid "Returns a mesh's surface's arrays for blend shapes."
msgstr "A háló felületének alakváltozataihoz tartozó tömböket adja vissza."

#. RenderingServer.mesh_surface_get_format_attribute_stride
#: doc/classes/RenderingServer.xml
msgid "Returns the stride of the attribute buffer for a mesh with given [param format]."
msgstr "A megadott [param format] formátumú háló attribútumpufferében az egymást követő elemek kezdete közötti bájttávolságot adja vissza."

#. RenderingServer.mesh_surface_get_format_index_stride
#: doc/classes/RenderingServer.xml
msgid "Returns the stride of the index buffer for a mesh with the given [param format]."
msgstr "A megadott [param format] formátumú háló indexpufferében az egymást követő elemek kezdete közötti bájttávolságot adja vissza."

#. RenderingServer.mesh_surface_get_format_normal_tangent_stride
#: doc/classes/RenderingServer.xml
msgid "Returns the stride of the combined normals and tangents for a mesh with given [param format]. Note importantly that, while normals and tangents are in the vertex buffer with vertices, they are only interleaved with each other and so have a different stride than vertex positions."
msgstr "A megadott [param format] formátumú háló normál- és érintővektorainak bájtlépését adja vissza. Közös csúcspufferben vannak a pozíciókkal, de a normál- és érintővektorok egymással váltakozva, a pozíciók pedig külön, egymás után helyezkednek el. Ezért a bájtlépésük eltér a csúcspozíciókétól."

#. RenderingServer.mesh_surface_get_format_offset
#: doc/classes/RenderingServer.xml
msgid "Returns the offset of a given attribute by [param array_index] in the start of its respective buffer."
msgstr "A [param array_index] által kijelölt attribútum eltolását adja vissza a hozzá tartozó puffer kezdetéhez képest."

#. RenderingServer.mesh_surface_get_format_skin_stride
#: doc/classes/RenderingServer.xml
msgid "Returns the stride of the skin buffer for a mesh with given [param format]."
msgstr "A megadott [param format] formátumú háló skinpufferének bájtlépését adja vissza."

#. RenderingServer.mesh_surface_get_material
#: doc/classes/RenderingServer.xml
msgid "Returns a mesh's surface's material."
msgstr "A háló felületéhez rendelt anyagot adja vissza."

#. RenderingServer.mesh_surface_set_material
#: doc/classes/RenderingServer.xml
msgid "Sets a mesh's surface's material."
msgstr "Beállítja a háló felületéhez rendelt anyagot."

#. RenderingServer.mesh_surface_update_index_region
#: doc/classes/RenderingServer.xml
msgid "Updates the index buffer of the mesh surface with the given [param data]. The expected data are 16 or 32-bit unsigned integers, which can be determined with [method mesh_surface_get_format_index_stride]."
msgstr "A [param data] értékével frissíti a háló felületének indexpufferét. Az adatoknak 16 vagy 32 bites előjel nélküli egész értékekből kell állniuk. A szükséges méret a [method mesh_surface_get_format_index_stride] metódussal kérdezhető le."

#. RenderingServer.viewport_set_active
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], sets the viewport active, else sets it inactive."
msgstr "Ha az értéke [code]true[/code], aktiválja a nézetablakot. Egyébként inaktiválja."

#. RenderingServer.viewport_set_canvas_cull_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the rendering mask associated with this [Viewport]. Only [CanvasItem] nodes with a matching rendering visibility layer will be rendered by this [Viewport]."
msgstr "Beállítja a [Viewport] renderelési maszkját. A [Viewport] csak azokat a [CanvasItem] csomópontokat rajzolja ki, amelyek renderelési láthatósági rétege szerepel a maszkban."

#. RenderingServer.viewport_set_canvas_transform
#: doc/classes/RenderingServer.xml
msgid "Sets the transformation of a viewport's canvas."
msgstr "Beállítja a nézetablak vásznának transzformációját."

#. RenderingServer.viewport_set_clear_mode
#: doc/classes/RenderingServer.xml
msgid "Sets the clear mode of a viewport."
msgstr "Beállítja a nézetablak törlési módját."

#. RenderingServer.viewport_set_debug_draw
#: doc/classes/RenderingServer.xml
msgid "Sets the debug draw mode of a viewport."
msgstr "Beállítja a nézetablak hibakeresési rajzolási módját."

#. RenderingServer.viewport_set_default_canvas_item_texture_filter
#: doc/classes/RenderingServer.xml
msgid "Sets the default texture filtering mode for the specified [param viewport] RID."
msgstr "Beállítja a [param viewport] RID-del megadott nézetablak vászonelemeinek alapértelmezett textúraszűrését."

#. RenderingServer.viewport_set_default_canvas_item_texture_repeat
#: doc/classes/RenderingServer.xml
msgid "Sets the default texture repeat mode for the specified [param viewport] RID."
msgstr "Beállítja a [param viewport] RID-del megadott nézetablak vászonelemeinek alapértelmezett textúraismétlését."

#. RenderingServer.viewport_set_disable_2d
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], the viewport's canvas (i.e. 2D and GUI elements) is not rendered."
msgstr "Ha az értéke [code]true[/code], a renderelő kihagyja a nézetablak vásznát, így a 2D-s elemeket és a kezelőfelületet is."

#. RenderingServer.viewport_set_disable_3d
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], the viewport's 3D elements are not rendered."
msgstr "Ha az értéke [code]true[/code], a nézetablak 3D-s elemei nem jelennek meg."

#. RenderingServer.viewport_set_global_canvas_transform
#: doc/classes/RenderingServer.xml
msgid "Sets the viewport's global transformation matrix."
msgstr "Beállítja a nézetablak globális transzformációs mátrixát."

#. RenderingServer.viewport_set_measure_render_time
#: doc/classes/RenderingServer.xml
msgid "Sets the measurement for the given [param viewport] RID (obtained using [method Viewport.get_viewport_rid]). Once enabled, [method viewport_get_measured_render_time_cpu] and [method viewport_get_measured_render_time_gpu] will return values greater than [code]0.0[/code] when queried with the given [param viewport]."
msgstr "Beállítja a renderelési idő mérését a [param viewport] RID-del megadott nézetablakhoz. Az azonosító a [method Viewport.get_viewport_rid] metódussal kérhető le. A mérés bekapcsolása után a [method viewport_get_measured_render_time_cpu] és a [method viewport_get_measured_render_time_gpu] a megadott [param viewport] értékhez [code]0.0[/code]-nál nagyobb eredményt ad."

#. RenderingServer.viewport_set_msaa_2d
#: doc/classes/RenderingServer.xml
msgid "Sets the multisample antialiasing mode for 2D/Canvas on the specified [param viewport] RID. Equivalent to [member ProjectSettings.rendering/anti_aliasing/quality/msaa_2d] or [member Viewport.msaa_2d]."
msgstr "Beállítja a [param viewport] RID-del megadott nézetablak 2D-s vásznának többmintavételes élsimítását. A [member ProjectSettings.rendering/anti_aliasing/quality/msaa_2d] beállításnak vagy a [member Viewport.msaa_2d] tulajdonságnak felel meg."

#. RenderingServer.viewport_set_msaa_3d
#: doc/classes/RenderingServer.xml
msgid "Sets the multisample antialiasing mode for 3D on the specified [param viewport] RID. Equivalent to [member ProjectSettings.rendering/anti_aliasing/quality/msaa_3d] or [member Viewport.msaa_3d]."
msgstr "Beállítja a [param viewport] RID-del megadott nézetablak 3D-s többmintavételes élsimítását. A [member ProjectSettings.rendering/anti_aliasing/quality/msaa_3d] beállításnak vagy a [member Viewport.msaa_3d] tulajdonságnak felel meg."

#. RenderingServer.viewport_set_occlusion_culling_build_quality
#: doc/classes/RenderingServer.xml
msgid "Sets the [member ProjectSettings.rendering/occlusion_culling/bvh_build_quality] to use for occlusion culling. This parameter is global and cannot be set on a per-viewport basis."
msgstr "Beállítja a takarásalapú kiszűréshez használt [member ProjectSettings.rendering/occlusion_culling/bvh_build_quality] értéket. Globális beállítás, ezért nézetablakonként nem állítható."

#. RenderingServer.viewport_set_occlusion_rays_per_thread
#: doc/classes/RenderingServer.xml
msgid "Sets the [member ProjectSettings.rendering/occlusion_culling/occlusion_rays_per_thread] to use for occlusion culling. This parameter is global and cannot be set on a per-viewport basis."
msgstr "Beállítja a takarásalapú kiszűréshez használt [member ProjectSettings.rendering/occlusion_culling/occlusion_rays_per_thread] értéket. Globális beállítás, ezért nézetablakonként nem állítható."

#. RenderingServer.viewport_set_parent_viewport
#: doc/classes/RenderingServer.xml
msgid "Sets the viewport's parent to the viewport specified by the [param parent_viewport] RID."
msgstr "A [param parent_viewport] RID-del megadott nézetablakot állítja be szülőként."

#. RenderingServer.viewport_set_positional_shadow_atlas_quadrant_subdivision
#: doc/classes/RenderingServer.xml
msgid "Sets the number of subdivisions to use in the specified shadow atlas [param quadrant] for omni and spot shadows. See also [method Viewport.set_positional_shadow_atlas_quadrant_subdiv]."
msgstr "Megadja, hány részre oszoljon a pont- és spotfényárnyékok atlaszának megadott [param quadrant] negyede. Lásd még a [method Viewport.set_positional_shadow_atlas_quadrant_subdiv] metódust."

#. RenderingServer.viewport_set_scenario
#: doc/classes/RenderingServer.xml
msgid "Sets a viewport's scenario. The scenario contains information about environment information, reflection atlas, etc."
msgstr "Beállítja a nézetablak renderelési színterét. A színtér tartalmazza például a környezet és a tükröződési atlasz adatait."

#. RenderingServer.viewport_set_screen_space_aa
#: doc/classes/RenderingServer.xml
msgid "Sets the viewport's screen-space antialiasing mode. Equivalent to [member ProjectSettings.rendering/anti_aliasing/quality/screen_space_aa] or [member Viewport.screen_space_aa]."
msgstr "Beállítja a nézetablak képernyőtérbeli élsimítási módját. A [member ProjectSettings.rendering/anti_aliasing/quality/screen_space_aa] beállításnak vagy a [member Viewport.screen_space_aa] tulajdonságnak felel meg."

#. RenderingServer.viewport_set_sdf_oversize_and_scale
#: doc/classes/RenderingServer.xml
msgid "Sets the viewport's 2D signed distance field [member ProjectSettings.rendering/2d/sdf/oversize] and [member ProjectSettings.rendering/2d/sdf/scale]. This is used when sampling the signed distance field in [CanvasItem] shaders as well as [GPUParticles2D] collision. This is [i]not[/i] used by SDFGI in 3D rendering."
msgstr "Beállítja a nézetablak 2D-s előjeles távolságmezőjének túlnyúlását ([member ProjectSettings.rendering/2d/sdf/oversize]) és méretarányát ([member ProjectSettings.rendering/2d/sdf/scale]). Ez a [CanvasItem] shaderek távolságmező-mintavételére és a [GPUParticles2D] ütközéseire is hat. A 3D-s renderelés SDFGI rendszere ezt [i]nem[/i] használja."

#. RenderingServer.viewport_set_size
#: doc/classes/RenderingServer.xml
msgid "Sets the viewport's [param width] and [param height] in pixels. Optionally the [param view_count] can be set to increase the number of view layers for stereo rendering."
msgstr "Beállítja a nézetablak [param width] szélességét és [param height] magasságát képpontban. A [param view_count] megadásával több nézetréteg használható a sztereó rendereléshez."

#. RenderingServer.viewport_set_snap_2d_transforms_to_pixel
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], canvas item transforms (i.e. origin position) are snapped to the nearest pixel when rendering. This can lead to a crisper appearance at the cost of less smooth movement, especially when [Camera2D] smoothing is enabled. Equivalent to [member ProjectSettings.rendering/2d/snap/snap_2d_transforms_to_pixel]."
msgstr "Ha az értéke [code]true[/code], rendereléskor a vászonelemek transzformációjának origója a legközelebbi képponthoz igazodik. A kép élesebb lehet, de a mozgás darabosabbnak tűnhet, különösen a [Camera2D] simításával együtt. A [member ProjectSettings.rendering/2d/snap/snap_2d_transforms_to_pixel] beállításnak felel meg."

#. RenderingServer.viewport_set_snap_2d_vertices_to_pixel
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], canvas item vertices (i.e. polygon points) are snapped to the nearest pixel when rendering. This can lead to a crisper appearance at the cost of less smooth movement, especially when [Camera2D] smoothing is enabled. Equivalent to [member ProjectSettings.rendering/2d/snap/snap_2d_vertices_to_pixel]."
msgstr "Ha az értéke [code]true[/code], rendereléskor a vászonelemek sokszögcsúcsai a legközelebbi képponthoz igazodnak. A kép élesebb lehet, de a mozgás darabosabbnak tűnhet, különösen a [Camera2D] simításával együtt. A [member ProjectSettings.rendering/2d/snap/snap_2d_vertices_to_pixel] beállításnak felel meg."

#. RenderingServer.viewport_set_transparent_background
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], the viewport renders its background as transparent."
msgstr "Ha az értéke [code]true[/code], a nézetablak háttere átlátszóként jelenik meg a renderelésben."

#. RenderingServer.viewport_set_update_mode
#: doc/classes/RenderingServer.xml
msgid "Sets when the viewport should be updated."
msgstr "Beállítja, mikor frissüljön a nézetablak."

#. RenderingServer.viewport_set_use_debanding
#: doc/classes/RenderingServer.xml
msgid "Equivalent to [member Viewport.use_debanding]. See also [member ProjectSettings.rendering/anti_aliasing/quality/use_debanding]."
msgstr "A [member Viewport.use_debanding] tulajdonságnak felel meg. Lásd még a [member ProjectSettings.rendering/anti_aliasing/quality/use_debanding] beállítást."

#. RenderingServer.viewport_set_use_taa
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], use temporal antialiasing. Equivalent to [member ProjectSettings.rendering/anti_aliasing/quality/use_taa] or [member Viewport.use_taa]."
msgstr "Ha az értéke [code]true[/code], temporális élsimítást használ. A [member ProjectSettings.rendering/anti_aliasing/quality/use_taa] beállításnak vagy a [member Viewport.use_taa] tulajdonságnak felel meg."

#. RDShaderFile.brief
#: doc/classes/RDShaderFile.xml
msgid "Compiled shader file in SPIR-V form (used by [RenderingDevice]). Not to be confused with Godot's own [Shader]."
msgstr "SPIR-V formátumra fordított shaderfájl a [RenderingDevice] számára. Ez különbözik a Godot saját [Shader] erőforrásától."

#. RDShaderFile.get_version_list
#: doc/classes/RDShaderFile.xml
msgid "Returns the list of compiled versions for this shader."
msgstr "A shader lefordított változatainak listáját adja vissza."

#. RDShaderFile.base_error
#: doc/classes/RDShaderFile.xml
msgid "The base compilation error message, which indicates errors not related to a specific shader stage if non-empty. If empty, shader compilation is not necessarily successful (check [RDShaderSPIRV]'s error message members)."
msgstr "Az általános fordítási hibaüzenet. Ha van benne szöveg, az egyik shaderszakaszhoz sem köthető hibát jelez. Üres érték esetén az egyes szakaszok hibáit az [RDShaderSPIRV] tulajdonságaiban ellenőrizheted."

#. RenderingDevice.compute_list_set_push_constant
#: doc/classes/RenderingDevice.xml
msgid "Sets the push constant data to [param buffer] for the specified [param compute_list]. The shader determines how this binary data is used. The buffer's size in bytes must also be specified in [param size_bytes] (this can be obtained by calling the [method PackedByteArray.size] method on the passed [param buffer])."
msgstr "A megadott [param compute_list] parancslista push konstansainak adatait a [param buffer] puffer tartalmára állítja. A bináris adat felhasználását a shader határozza meg. A bájtban mért méretet is meg kell adni a [param size_bytes] paraméterben. Ezt a [param buffer] értékén meghívott [method PackedByteArray.size] adja meg."

#. RenderingDevice.compute_pipeline_is_valid
#: doc/classes/RenderingDevice.xml
msgid "Returns [code]true[/code] if the compute pipeline specified by the [param compute_pipeline] RID is valid, [code]false[/code] otherwise."
msgstr "[code]true[/code] értéket ad vissza, ha a [param compute_pipeline] RID-del megadott számítási folyamat érvényes. Egyébként az érték [code]false[/code]."

#. RenderingDevice.create_local_device
#: doc/classes/RenderingDevice.xml
msgid "Create a new local [RenderingDevice]. This is most useful for performing compute operations on the GPU independently from the rest of the engine."
msgstr "Új helyi [RenderingDevice] példányt hoz létre. Akkor hasznos, ha a motor többi részétől függetlenül szeretnél számításokat végezni a GPU-n."

#. RenderingDevice.draw_command_end_label
#: doc/classes/RenderingDevice.xml
msgid "Ends the command buffer debug label region started by a [method draw_command_begin_label] call."
msgstr "Lezárja a parancspuffer hibakeresési szakaszát, amelyet a [method draw_command_begin_label] hívása nyitott meg."

#. RenderingDevice.draw_list_begin_split
#. RenderingDevice.draw_list_switch_to_next_pass_split
#: doc/classes/RenderingDevice.xml
msgid "This method does nothing and always returns an empty [PackedInt64Array]."
msgstr "A metódus nem végez műveletet, és mindig üres [PackedInt64Array] tömböt ad vissza."

#. RenderingDevice.draw_list_bind_index_array
#: doc/classes/RenderingDevice.xml
msgid "Binds [param index_array] to the specified [param draw_list]."
msgstr "Az [param index_array] indextömböt a megadott [param draw_list] rajzolási listához rendeli."

#. RenderingDevice.draw_list_bind_render_pipeline
#: doc/classes/RenderingDevice.xml
msgid "Binds [param render_pipeline] to the specified [param draw_list]."
msgstr "A [param render_pipeline] renderelési folyamatot a megadott [param draw_list] rajzolási listához rendeli."

#. RenderingDevice.draw_list_bind_uniform_set
#: doc/classes/RenderingDevice.xml
msgid "Binds [param uniform_set] to the specified [param draw_list]. A [param set_index] must also be specified, which is an identifier starting from [code]0[/code] that must match the one expected by the draw list."
msgstr "A [param uniform_set] uniformkészletet a megadott [param draw_list] rajzolási listához rendeli. A [param set_index] a készlet [code]0[/code]-tól számozott helye, amelynek meg kell egyeznie a shader által várt készletindexszel."

#. RenderingDevice.draw_list_bind_vertex_array
#: doc/classes/RenderingDevice.xml
msgid "Binds [param vertex_array] to the specified [param draw_list]."
msgstr "A [param vertex_array] csúcstömböt a megadott [param draw_list] rajzolási listához rendeli."

#. RenderingDevice.draw_list_bind_vertex_buffers_format
#: doc/classes/RenderingDevice.xml
msgid "Binds a set of [param vertex_buffers] directly to the specified [param draw_list] using [param vertex_format] without creating a vertex array RID. Provide the number of vertices in [param vertex_count]; optional per-buffer byte [param offsets] may also be supplied."
msgstr "A [param vertex_buffers] csúcspuffereket közvetlenül a megadott [param draw_list] rajzolási listához rendeli a [param vertex_format] szerint, csúcstömb-RID létrehozása nélkül. A csúcsok számát a [param vertex_count] paraméterben add meg. Az opcionális [param offsets] pufferenként bájtban adja meg az eltolást."

#. RenderingDevice.draw_list_disable_scissor
#: doc/classes/RenderingDevice.xml
msgid "Removes and disables the scissor rectangle for the specified [param draw_list]. See also [method draw_list_enable_scissor]."
msgstr "Kikapcsolja és eltávolítja a megadott [param draw_list] vágási téglalapját. Lásd még a [method draw_list_enable_scissor] metódust."

#. RenderingDevice.draw_list_draw
#: doc/classes/RenderingDevice.xml
msgid "Submits [param draw_list] for rendering on the GPU. This is the raster equivalent to [method compute_list_dispatch]."
msgstr "A [param draw_list] rajzolási listába GPU-n végrehajtandó rajzolási parancsot rögzít. A [method compute_list_dispatch] raszterizálási megfelelője."

#. RenderingDevice.draw_list_end
#: doc/classes/RenderingDevice.xml
msgid "Finishes a list of raster drawing commands created with the [code]draw_*[/code] methods."
msgstr "Lezárja a [code]draw_*[/code] metódusokkal összeállított raszterizálási parancslistát."

#. RenderingDevice.draw_list_set_blend_constants
#: doc/classes/RenderingDevice.xml
msgid "Sets blend constants for the specified [param draw_list] to [param color]. Blend constants are used only if the graphics pipeline is created with [constant DYNAMIC_STATE_BLEND_CONSTANTS] flag set."
msgstr "A megadott [param draw_list] keverési konstansait a [param color] szín alapján állítja be. A konstansokat csak a [constant DYNAMIC_STATE_BLEND_CONSTANTS] jelzővel létrehozott grafikus folyamat használja."

#. RenderingDevice.draw_list_set_push_constant
#: doc/classes/RenderingDevice.xml
msgid "Sets the push constant data to [param buffer] for the specified [param draw_list]. The shader determines how this binary data is used. The buffer's size in bytes must also be specified in [param size_bytes] (this can be obtained by calling the [method PackedByteArray.size] method on the passed [param buffer])."
msgstr "A megadott [param draw_list] push konstansainak adatait a [param buffer] puffer tartalmára állítja. A bináris adat felhasználását a shader határozza meg. A bájtban mért méretet is meg kell adni a [param size_bytes] paraméterben. Ezt a [param buffer] értékén meghívott [method PackedByteArray.size] adja meg."

#. RenderingDevice.draw_list_switch_to_next_pass
#: doc/classes/RenderingDevice.xml
msgid "Switches to the next draw pass."
msgstr "Átvált a következő rajzolási menetre."

#. RenderingDevice.framebuffer_format_create_empty
#: doc/classes/RenderingDevice.xml
msgid "Creates a new empty framebuffer format with the specified number of [param samples] and returns its ID."
msgstr "Új üres képpufferformátumot hoz létre a megadott [param samples] mintaszámmal, és visszaadja az azonosítóját."

#. RenderingDevice.framebuffer_format_create_multipass
#: doc/classes/RenderingDevice.xml
msgid "Creates a multipass framebuffer format with the specified [param attachments], [param passes] and [param view_count] and returns its ID. If [param view_count] is greater than or equal to [code]2[/code], enables multiview which is used for VR rendering. This requires support for the Vulkan multiview extension."
msgstr "Többmenetes képpufferformátumot hoz létre a megadott [param attachments], [param passes] és [param view_count] értékekkel, majd visszaadja az azonosítóját. Ha a [param view_count] értéke legalább [code]2[/code], használható a VR-rendereléshez szükséges többnézetes mód. Ehhez a Vulkan többnézetes bővítményének támogatása szükséges."

#. RenderingDevice.framebuffer_format_get_texture_samples
#: doc/classes/RenderingDevice.xml
msgid "Returns the number of texture samples used for the given framebuffer [param format] ID (returned by [method framebuffer_get_format])."
msgstr "A [method framebuffer_get_format] által visszaadott [param format] képpufferformátum-azonosítóhoz tartozó textúraminták számát adja vissza."

#. RenderingDevice.framebuffer_get_format
#: doc/classes/RenderingDevice.xml
msgid "Returns the format ID of the framebuffer specified by the [param framebuffer] RID. This ID is guaranteed to be unique for the same formats and does not need to be freed."
msgstr "A [param framebuffer] RID-del megadott képpuffer formátumazonosítóját adja vissza. Azonos formátumhoz mindig ugyanaz az egyedi azonosító tartozik, amelyet nem kell felszabadítani."

#. RenderingDevice.framebuffer_is_valid
#: doc/classes/RenderingDevice.xml
msgid "Returns [code]true[/code] if the framebuffer specified by the [param framebuffer] RID is valid, [code]false[/code] otherwise."
msgstr "[code]true[/code] értéket ad vissza, ha a [param framebuffer] RID-del megadott képpuffer érvényes. Egyébként az érték [code]false[/code]."

#. RenderingDevice.free_rid
#: doc/classes/RenderingDevice.xml
msgid "Tries to free an object in the RenderingDevice. To avoid memory leaks, this should be called after using an object as memory management does not occur automatically when using RenderingDevice directly."
msgstr "Felszabadítja a RenderingDevice-ban az azonosítóhoz tartozó erőforrást, ha létezik. A közvetlenül a RenderingDevice-on létrehozott erőforrásokat ezzel a metódussal szabadítsd fel, amikor már nincs rájuk szükség."

#. RenderingDevice.get_captured_timestamp_cpu_time
#: doc/classes/RenderingDevice.xml
msgid "Returns the timestamp in CPU time for the rendering step specified by [param index] (in microseconds since the engine started). See also [method get_captured_timestamp_gpu_time] and [method capture_timestamp]."
msgstr "A [param index] által megadott renderelési lépés CPU-időbélyegét adja vissza a motor indulása óta eltelt mikroszekundumban. Lásd még a [method get_captured_timestamp_gpu_time] és a [method capture_timestamp] metódust."

#. RenderingDevice.get_captured_timestamp_gpu_time
#: doc/classes/RenderingDevice.xml
msgid "Returns the timestamp in GPU time for the rendering step specified by [param index] (in microseconds since the engine started). See also [method get_captured_timestamp_cpu_time] and [method capture_timestamp]."
msgstr "A [param index] által megadott renderelési lépés GPU-időbélyegét adja vissza a motor indulása óta eltelt mikroszekundumban. Lásd még a [method get_captured_timestamp_cpu_time] és a [method capture_timestamp] metódust."

#. RenderingDevice.get_captured_timestamp_name
#: doc/classes/RenderingDevice.xml
msgid "Returns the timestamp's name for the rendering step specified by [param index]. See also [method capture_timestamp]."
msgstr "A [param index] által megadott renderelési lépés időbélyegének nevét adja vissza. Lásd még a [method capture_timestamp] metódust."

#. RenderingDevice.get_captured_timestamps_count
#: doc/classes/RenderingDevice.xml
msgid "Returns the total number of timestamps (rendering steps) available for profiling."
msgstr "A teljesítményméréshez elérhető renderelési időbélyegek számát adja vissza."

#. RenderingDevice.get_captured_timestamps_frame
#: doc/classes/RenderingDevice.xml
msgid "Returns the index of the last frame rendered that has rendering timestamps available for querying."
msgstr "Az utolsó olyan kirajzolt képkocka indexét adja vissza, amelyhez lekérdezhető renderelési időbélyegek tartoznak."

#. RenderingDevice.get_device_name
#: doc/classes/RenderingDevice.xml
msgid "Returns the name of the video adapter (e.g. \"GeForce GTX 1080/PCIe/SSE2\"). Equivalent to [method RenderingServer.get_video_adapter_name]. See also [method get_device_vendor_name]."
msgstr "A videokártya nevét adja vissza, például „GeForce GTX 1080/PCIe/SSE2”. A [method RenderingServer.get_video_adapter_name] metódusnak felel meg. Lásd még a [method get_device_vendor_name] metódust."

#. RenderingDevice.get_device_pipeline_cache_uuid
#: doc/classes/RenderingDevice.xml
msgid "Returns the universally unique identifier for the pipeline cache. This is used to cache shader files on disk, which avoids shader recompilations on subsequent engine runs. This UUID varies depending on the graphics card model, but also the driver version. Therefore, updating graphics drivers will invalidate the shader cache."
msgstr "A grafikus folyamatok gyorsítótárának univerzálisan egyedi azonosítóját adja vissza. A lemezen gyorsítótárazott shaderfájlok révén a következő indításkor elkerülhető az újrafordítás. Az UUID a grafikus kártya típusától és az illesztőprogram verziójától függ, ezért egy illesztőprogram-frissítés érvényteleníti a shader-gyorsítótárat."

#. RenderingDevice.get_device_vendor_name
#: doc/classes/RenderingDevice.xml
msgid "Returns the vendor of the video adapter (e.g. \"NVIDIA Corporation\"). Equivalent to [method RenderingServer.get_video_adapter_vendor]. See also [method get_device_name]."
msgstr "A videokártya gyártóját adja vissza, például „NVIDIA Corporation”. A [method RenderingServer.get_video_adapter_vendor] metódusnak felel meg. Lásd még a [method get_device_name] metódust."

#. RenderingDevice.get_driver_resource
#: doc/classes/RenderingDevice.xml
msgid "Returns the unique identifier of the driver [param resource] for the specified [param rid]. Some driver resource types ignore the specified [param rid]. [param index] is always ignored but must be specified anyway."
msgstr "A megadott [param rid] azonosítóhoz tartozó illesztőprogram-erőforrás ([param resource]) egyedi azonosítóját adja vissza. Bizonyos erőforrástípusok figyelmen kívül hagyják a megadott [param rid] értéket. A [param index] értéke nem számít, de meg kell adni."

#. RenderingDevice.get_frame_delay
#: doc/classes/RenderingDevice.xml
msgid "Returns the frame count kept by the graphics API. Higher values result in higher input lag, but with more consistent throughput. For the main [RenderingDevice], frames are cycled (usually 3 with triple-buffered V-Sync enabled). However, local [RenderingDevice]s only have 1 frame."
msgstr "A grafikus API által fenntartott képkockák számát adja vissza. Nagyobb érték egyenletesebb feldolgozást, de nagyobb bemeneti késleltetést eredményez. A fő [RenderingDevice] a képkockákat felváltva használja, hárompufferes V-Sync esetén általában 3-at. A helyi [RenderingDevice] példányokhoz csak 1 képkocka tartozik."

#. RenderingDevice.get_memory_usage
#: doc/classes/RenderingDevice.xml
msgid "Returns the memory usage in bytes corresponding to the given [param type]. When using Vulkan, these statistics are calculated by [url=https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator]Vulkan Memory Allocator[/url]."
msgstr "A megadott [param type] típus memóriahasználatát adja vissza bájtban. Vulkan használatakor a statisztikát a [url=https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator]Vulkan Memory Allocator[/url] számítja ki."

#. RenderingDevice.get_perf_report
#: doc/classes/RenderingDevice.xml
msgid "Returns a string with a performance report from the past frame. Updates every frame."
msgstr "Sztringként adja vissza a legutóbbi képkocka teljesítményjelentését. A jelentés képkockánként frissül."

#. RenderingDevice.has_feature
#: doc/classes/RenderingDevice.xml
msgid "Returns [code]true[/code] if the [param feature] is supported by the GPU."
msgstr "[code]true[/code] értéket ad vissza, ha a GPU támogatja a [param feature] képességet."

#. RenderingDevice.raytracing_list_bind_raytracing_pipeline
#: doc/classes/RenderingDevice.xml
msgid "Binds [param raytracing_pipeline] to the specified [param raytracing_list]."
msgstr "A [param raytracing_pipeline] sugárkövetési folyamatot a megadott [param raytracing_list] parancslistához rendeli."

#. RenderingDevice.raytracing_list_bind_uniform_set
#: doc/classes/RenderingDevice.xml
msgid "Binds the [param uniform_set] to this [param raytracing_list]."
msgstr "A [param uniform_set] uniformkészletet a megadott [param raytracing_list] sugárkövetési parancslistához rendeli."

#. RenderingDevice.raytracing_list_end
#: doc/classes/RenderingDevice.xml
msgid "Finishes a list of raytracing commands created with the [code]raytracing_*[/code] methods."
msgstr "Lezárja a [code]raytracing_*[/code] metódusokkal összeállított sugárkövetési parancslistát."

#. RenderingDevice.raytracing_list_set_push_constant
#: doc/classes/RenderingDevice.xml
msgid "Sets the push constant data to [param buffer] for the specified [param raytracing_list]. The shader determines how this binary data is used. The buffer's size in bytes must also be specified in [param size_bytes] (this can be obtained by calling the [method PackedByteArray.size] method on the passed [param buffer])."
msgstr "A megadott [param raytracing_list] push konstansainak adatait a [param buffer] puffer tartalmára állítja. A bináris adat felhasználását a shader határozza meg. A bájtban mért méretet is meg kell adni a [param size_bytes] paraméterben. Ezt a [param buffer] értékén meghívott [method PackedByteArray.size] adja meg."

#. RenderingDevice.raytracing_pipeline_is_valid
#: doc/classes/RenderingDevice.xml
msgid "Returns [code]true[/code] if the raytracing pipeline specified by the [param raytracing_pipeline] RID is valid, [code]false[/code] otherwise."
msgstr "[code]true[/code] értéket ad vissza, ha a [param raytracing_pipeline] RID-del megadott sugárkövetési folyamat érvényes. Egyébként az érték [code]false[/code]."

#. RenderingDevice.render_pipeline_is_valid
#: doc/classes/RenderingDevice.xml
msgid "Returns [code]true[/code] if the render pipeline specified by the [param render_pipeline] RID is valid, [code]false[/code] otherwise."
msgstr "[code]true[/code] értéket ad vissza, ha a [param render_pipeline] RID-del megadott renderelési folyamat érvényes. Egyébként az érték [code]false[/code]."

#. RenderingDevice.sampler_is_format_supported_for_filter
#: doc/classes/RenderingDevice.xml
msgid "Returns [code]true[/code] if implementation supports using a texture of [param format] with the given [param sampler_filter]."
msgstr "[code]true[/code] értéket ad vissza, ha az adott megvalósítás támogatja a [param format] formátumú textúrát a megadott [param sampler_filter] szűrővel."

#. RenderingDevice.shader_create_placeholder
#: doc/classes/RenderingDevice.xml
msgid "Create a placeholder RID by allocating an RID without initializing it for use in [method shader_create_from_bytecode]. This allows you to create an RID for a shader and pass it around, but defer compiling the shader to a later time."
msgstr "Inicializálás nélkül lefoglal egy helyőrző RID-t a [method shader_create_from_bytecode] számára. Így már a fordítás előtt létrehozhatod és továbbadhatod a shader azonosítóját."

#. RenderingDevice.shader_get_vertex_input_attribute_mask
#: doc/classes/RenderingDevice.xml
msgid "Returns the internal vertex input mask. Internally, the vertex input mask is an unsigned integer consisting of the locations (specified in GLSL via. [code]layout(location = ...)[/code]) of the input variables (specified in GLSL by the [code]in[/code] keyword)."
msgstr "A belső csúcsbemeneti maszkot adja vissza. A maszk előjel nélküli egész szám, amelynek bitjei a GLSL-ben az [code]in[/code] kulcsszóval megadott bemeneti változók [code]layout(location = ...)[/code] helyeinek felelnek meg."

#. RenderingDevice.texture_get_format
#: doc/classes/RenderingDevice.xml
msgid "Returns the data format used to create this texture."
msgstr "A textúra létrehozásához használt adatformátumot adja vissza."

#. RenderingDevice.texture_is_valid
#: doc/classes/RenderingDevice.xml
msgid "Returns [code]true[/code] if the [param texture] is valid, [code]false[/code] otherwise."
msgstr "[code]true[/code] értéket ad vissza, ha a [param texture] textúra érvényes. Egyébként az érték [code]false[/code]."

#. RenderingDevice.vertex_format_create
#: doc/classes/RenderingDevice.xml
msgid "Creates a new vertex format with the specified [param vertex_descriptions]. Returns a unique vertex format ID corresponding to the newly created vertex format."
msgstr "A megadott [param vertex_descriptions] csúcsleírásokból új csúcsformátumot hoz létre, és visszaadja annak egyedi azonosítóját."

#. RenderingServer.instance_geometry_set_cast_shadows_setting
#: doc/classes/RenderingServer.xml
msgid "Sets the shadow casting setting. Equivalent to [member GeometryInstance3D.cast_shadow]."
msgstr "Beállítja az árnyékvetési módot. A [member GeometryInstance3D.cast_shadow] tulajdonságnak felel meg."

#. RenderingServer.instance_geometry_set_flag
#: doc/classes/RenderingServer.xml
msgid "Sets the [param flag] for a given [param instance] to [param enabled]."
msgstr "A megadott [param instance] példány [param flag] jelzőjét a [param enabled] értékre állítja."

#. RenderingServer.instance_geometry_set_lightmap
#: doc/classes/RenderingServer.xml
msgid "Sets the lightmap GI instance to use for the specified 3D geometry instance. The lightmap UV scale for the specified instance (equivalent to [member GeometryInstance3D.gi_lightmap_scale]) and lightmap atlas slice must also be specified."
msgstr "Beállítja a megadott 3D-s geometriapéldányhoz használt fénytérképes globális megvilágítási példányt. A példány fénytérképének UV-méretarányát, amely a [member GeometryInstance3D.gi_lightmap_scale] tulajdonságnak felel meg, valamint a fénytérképatlasz szeletét is meg kell adni."

#. RenderingServer.instance_geometry_set_lod_bias
#: doc/classes/RenderingServer.xml
msgid "Sets the level of detail bias to use when rendering the specified 3D geometry instance. Higher values result in higher detail from further away. Equivalent to [member GeometryInstance3D.lod_bias]."
msgstr "Beállítja a megadott 3D-s geometriapéldány renderelési részletességének eltolását. Nagyobb értékkel távolabbról is részletesebb marad. A [member GeometryInstance3D.lod_bias] tulajdonságnak felel meg."

#. RenderingServer.instance_geometry_set_material_overlay
#: doc/classes/RenderingServer.xml
msgid "Sets a material that will be rendered for all surfaces on top of active materials for the mesh associated with this instance. Equivalent to [member GeometryInstance3D.material_overlay]."
msgstr "Beállít egy anyagot, amelyet a renderelő a példányhoz tartozó háló összes felületén az aktív anyagok fölé rajzol. A [member GeometryInstance3D.material_overlay] tulajdonságnak felel meg."

#. RenderingServer.instance_geometry_set_material_override
#: doc/classes/RenderingServer.xml
msgid "Sets a material that will override the material for all surfaces on the mesh associated with this instance. Equivalent to [member GeometryInstance3D.material_override]."
msgstr "Beállít egy anyagot, amely a példányhoz tartozó háló összes felületének anyagát felülírja. A [member GeometryInstance3D.material_override] tulajdonságnak felel meg."

#. RenderingServer.instance_geometry_set_shader_parameter
#: doc/classes/RenderingServer.xml
msgid "Sets the per-instance shader uniform on the specified 3D geometry instance. Equivalent to [method GeometryInstance3D.set_instance_shader_parameter]."
msgstr "Beállítja a megadott 3D-s geometriapéldány egyedi shaderuniformját. A [method GeometryInstance3D.set_instance_shader_parameter] metódusnak felel meg."

#. RenderingServer.instance_geometry_set_visibility_range
#: doc/classes/RenderingServer.xml
msgid "Sets the visibility range values for the given geometry instance. Equivalent to [member GeometryInstance3D.visibility_range_begin] and related properties."
msgstr "Beállítja a geometriapéldány láthatósági tartományát. A [member GeometryInstance3D.visibility_range_begin] és a kapcsolódó tulajdonságok megfelelője."

#. RenderingServer.instance_set_blend_shape_weight
#: doc/classes/RenderingServer.xml
msgid "Sets the weight for a given blend shape associated with this instance."
msgstr "Beállítja a példányhoz tartozó megadott alakváltozat súlyát."

#. RenderingServer.instance_set_custom_aabb
#: doc/classes/RenderingServer.xml
msgid "Sets a custom AABB to use when culling objects from the view frustum. Equivalent to setting [member GeometryInstance3D.custom_aabb]."
msgstr "Egyéni, tengelyekhez igazított befoglaló dobozt ad meg a látógúla szerinti kiszűréshez. A [member GeometryInstance3D.custom_aabb] beállításának felel meg."

#. RenderingServer.instance_set_extra_visibility_margin
#: doc/classes/RenderingServer.xml
msgid "Sets a margin to increase the size of the AABB when culling objects from the view frustum. This allows you to avoid culling objects that fall outside the view frustum. Equivalent to [member GeometryInstance3D.extra_cull_margin]."
msgstr "Megadja, mennyivel nőjön a tengelyekhez igazított befoglaló doboz a látógúla szerinti kiszűréshez. Így egy objektum akkor is megmaradhat, ha egyébként a látógúlán kívülre esne. A [member GeometryInstance3D.extra_cull_margin] tulajdonságnak felel meg."

#. RenderingServer.instance_set_ignore_culling
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], ignores all culling on the specified 3D geometry instance, including frustum culling, occlusion culling, and layer culling. This is not the same as [member GeometryInstance3D.ignore_occlusion_culling], which only ignores occlusion culling but leaves frustum and layer culling intact."
msgstr "Ha az értéke [code]true[/code], a megadott 3D-s geometriapéldány esetében kimarad minden kiszűrés, beleértve a látógúla, a takarás és a rétegek szerinti szűrést. A [member GeometryInstance3D.ignore_occlusion_culling] csak a takarás alapján végzett kiszűrést kapcsolja ki."

#. RenderingServer.instance_set_layer_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the render layers that this instance will be drawn to. Equivalent to [member VisualInstance3D.layers]."
msgstr "Beállítja, mely renderelési rétegekbe rajzolódjon a példány. A [member VisualInstance3D.layers] tulajdonságnak felel meg."

#. RenderingServer.instance_set_pivot_data
#: doc/classes/RenderingServer.xml
msgid "Sets the sorting offset and switches between using the bounding box or instance origin for depth sorting."
msgstr "Beállítja a rendezési eltolást, és kiválasztja, hogy a mélység szerinti rendezés a befoglaló dobozt vagy a példány origóját használja."

#. RenderingServer.instance_set_scenario
#: doc/classes/RenderingServer.xml
msgid "Sets the scenario that the instance is in. The scenario is the 3D world that the objects will be displayed in."
msgstr "Beállítja, melyik renderelési színtérhez tartozzon a példány. A színtér az a 3D-s világ, amelyben az objektumok megjelennek."

#. RenderingServer.instance_set_surface_override_material
#: doc/classes/RenderingServer.xml
msgid "Sets the override material of a specific surface. Equivalent to [method MeshInstance3D.set_surface_override_material]."
msgstr "Beállítja egy adott felület felülbíráló anyagát. A [method MeshInstance3D.set_surface_override_material] metódusnak felel meg."

#. RenderingServer.instance_set_transform
#: doc/classes/RenderingServer.xml
msgid "Sets the world space transform of the instance. Equivalent to [member Node3D.global_transform]."
msgstr "Beállítja a példány világkoordinátákban értelmezett transzformációját. A [member Node3D.global_transform] tulajdonságnak felel meg."

#. RenderingServer.instance_set_visibility_parent
#: doc/classes/RenderingServer.xml
msgid "Sets the visibility parent for the given instance. Equivalent to [member Node3D.visibility_parent]."
msgstr "Beállítja a példány láthatósági szülőjét. A [member Node3D.visibility_parent] tulajdonságnak felel meg."

#. RenderingServer.instance_set_visible
#: doc/classes/RenderingServer.xml
msgid "Sets whether an instance is drawn or not. Equivalent to [member Node3D.visible]."
msgstr "Beállítja, hogy a renderelő kirajzolja-e a példányt. A [member Node3D.visible] tulajdonságnak felel meg."

#. RenderingServer.instance_teleport
#: doc/classes/RenderingServer.xml
msgid "Resets motion vectors and other interpolated values. Use this [i]after[/i] teleporting a mesh from one position to another to avoid ghosting artifacts."
msgstr "Alaphelyzetbe állítja a mozgásvektorokat és a többi interpolált értéket. A háló azonnali áthelyezése [i]után[/i] hívd meg, hogy a kép ne legyen szellemképes."

#. RenderingServer.is_on_render_thread
#: doc/classes/RenderingServer.xml
msgid "Returns [code]true[/code] if our code is currently executing on the rendering thread."
msgstr "[code]true[/code] értéket ad vissza, ha a hívó kód a renderelési szálon fut."

#. RenderingServer.light_area_set_normalize_energy
#: doc/classes/RenderingServer.xml
msgid "Defines whether the energy of an [AreaLight3D] is normalized (divided) by its area. If set to [code]true[/code], changing the size does not affect the total energy output. Equivalent to [member AreaLight3D.area_normalize_energy]."
msgstr "Megadja, hogy az [AreaLight3D] energiája a felületével legyen-e elosztva. Ha az értéke [code]true[/code], a méret megváltoztatása nem befolyásolja a teljes kibocsátott energiát. A [member AreaLight3D.area_normalize_energy] tulajdonságnak felel meg."

#. RenderingServer.light_area_set_size
#: doc/classes/RenderingServer.xml
msgid "Sets the extents (width and height) in meters for this area light. Equivalent to [member AreaLight3D.area_size]."
msgstr "Beállítja a területi fény szélességét és magasságát méterben. A [member AreaLight3D.area_size] tulajdonságnak felel meg."

#. RenderingServer.light_directional_set_blend_splits
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], this directional light will blend between shadow map splits resulting in a smoother transition between them. Equivalent to [member DirectionalLight3D.directional_shadow_blend_splits]."
msgstr "Ha az értéke [code]true[/code], az irányfény sima átmenetet képez a szomszédos árnyéktérkép-kaszkádok között. A [member DirectionalLight3D.directional_shadow_blend_splits] tulajdonságnak felel meg."

#. RenderingServer.light_directional_set_shadow_mode
#: doc/classes/RenderingServer.xml
msgid "Sets the shadow mode for this directional light. Equivalent to [member DirectionalLight3D.directional_shadow_mode]."
msgstr "Beállítja az irányfény árnyékmódját. A [member DirectionalLight3D.directional_shadow_mode] tulajdonságnak felel meg."

#. RenderingServer.light_omni_set_shadow_mode
#: doc/classes/RenderingServer.xml
msgid "Sets whether to use a dual paraboloid or a cubemap for the shadow map. Dual paraboloid is faster but may suffer from artifacts. Equivalent to [member OmniLight3D.omni_shadow_mode]."
msgstr "Kiválasztja, hogy az árnyéktérkép kettős paraboloidot vagy kockatérképet használjon. A kettős paraboloid gyorsabb, de képhibákat okozhat. A [member OmniLight3D.omni_shadow_mode] tulajdonságnak felel meg."

#. RenderingServer.light_projectors_set_filter
#: doc/classes/RenderingServer.xml
msgid "Sets the texture filter mode to use when rendering light projectors. This parameter is global and cannot be set on a per-light basis."
msgstr "Beállítja a vetített fények textúraszűrési módját. Globális beállítás, ezért fényenként nem módosítható."

#. RenderingServer.light_set_bake_mode
#: doc/classes/RenderingServer.xml
msgid "Sets the bake mode to use for the specified 3D light. Equivalent to [member Light3D.light_bake_mode]."
msgstr "Beállítja a megadott 3D-s fény beégetési módját. A [member Light3D.light_bake_mode] tulajdonságnak felel meg."

#. RenderingServer.light_set_color
#: doc/classes/RenderingServer.xml
msgid "Sets the color of the light. Equivalent to [member Light3D.light_color]."
msgstr "Beállítja a fény színét. A [member Light3D.light_color] tulajdonságnak felel meg."

#. RenderingServer.light_set_cull_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the cull mask for this 3D light. Lights only affect objects in the selected layers. Equivalent to [member Light3D.light_cull_mask]."
msgstr "Beállítja a 3D-s fény rétegmaszkját. A fény csak a kijelölt rétegek objektumaira hat. A [member Light3D.light_cull_mask] tulajdonságnak felel meg."

#. RenderingServer.light_set_distance_fade
#: doc/classes/RenderingServer.xml
msgid "Sets the distance fade for this 3D light. This acts as a form of level of detail (LOD) and can be used to improve performance. Equivalent to [member Light3D.distance_fade_enabled], [member Light3D.distance_fade_begin], [member Light3D.distance_fade_shadow], and [member Light3D.distance_fade_length]."
msgstr "Beállítja, hogyan halványuljon a 3D-s fény a távolsággal. Ez a részletességi szint (LOD) egyik formája, amellyel javítható a teljesítmény. A [member Light3D.distance_fade_enabled], [member Light3D.distance_fade_begin], [member Light3D.distance_fade_shadow] és [member Light3D.distance_fade_length] tulajdonságoknak felel meg."

#. RenderingServer.light_set_max_sdfgi_cascade
#: doc/classes/RenderingServer.xml
msgid "Sets the maximum SDFGI cascade in which the 3D light's indirect lighting is rendered. Higher values allow the light to be rendered in SDFGI further away from the camera."
msgstr "Beállítja a legnagyobb SDFGI-kaszkádot, amelybe a 3D-s fény közvetett megvilágítása bekerül. Nagyobb értéknél a fény közvetett hatása a kamerától távolabb is megjelenhet."

#. RenderingServer.light_set_negative
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], the 3D light will subtract light instead of adding light. Equivalent to [member Light3D.light_negative]."
msgstr "Ha az értéke [code]true[/code], a 3D-s fény csökkenti a megvilágítást. A [member Light3D.light_negative] tulajdonságnak felel meg."

#. RenderingServer.light_set_param
#: doc/classes/RenderingServer.xml
msgid "Sets the specified 3D light parameter. Equivalent to [method Light3D.set_param]."
msgstr "Beállítja a 3D-s fény megadott paraméterét. A [method Light3D.set_param] metódusnak felel meg."

#. RenderingServer.light_set_projector
#: doc/classes/RenderingServer.xml
msgid "Sets the projector texture to use for the specified 3D light. Equivalent to [member Light3D.light_projector]."
msgstr "Beállítja a megadott 3D-s fény vetítőtextúráját. A [member Light3D.light_projector] tulajdonságnak felel meg."

#. RenderingServer.light_set_reverse_cull_face_mode
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], reverses the backface culling of the mesh. This can be useful when you have a flat mesh that has a light behind it. If you need to cast a shadow on both sides of the mesh, set the mesh to use double-sided shadows with [method instance_geometry_set_cast_shadows_setting]. Equivalent to [member Light3D.shadow_reverse_cull_face]."
msgstr "Ha az értéke [code]true[/code], megfordítja a háló lapjainak kiszűrési irányát. Ez hasznos lehet, ha a fény egy sík háló mögött van. Ha a hálónak mindkét oldalról árnyékot kell vetnie, a [method instance_geometry_set_cast_shadows_setting] metódussal állíts be kétoldalas árnyékvetést. A [member Light3D.shadow_reverse_cull_face] tulajdonságnak felel meg."

#. RenderingServer.light_set_shadow
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], light will cast shadows. Equivalent to [member Light3D.shadow_enabled]."
msgstr "Ha az értéke [code]true[/code], a fény árnyékot vet. A [member Light3D.shadow_enabled] tulajdonságnak felel meg."

#. RenderingServer.light_set_shadow_caster_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the shadow caster mask for this 3D light. Shadows will only be cast using objects in the selected layers. Equivalent to [member Light3D.shadow_caster_mask]."
msgstr "Beállítja a 3D-s fény árnyékvetési rétegmaszkját. Csak a kijelölt rétegek objektumai vethetnek árnyékot. A [member Light3D.shadow_caster_mask] tulajdonságnak felel meg."

#. RenderingServer.directional_shadow_atlas_set_size
#: doc/classes/RenderingServer.xml
msgid "Sets the [param size] of the directional light shadows in 3D. See also [member ProjectSettings.rendering/lights_and_shadows/directional_shadow/size]. This parameter is global and cannot be set on a per-viewport basis."
msgstr "Beállítja a 3D-s irányfények árnyékatlaszának [param size] méretét. Lásd még a [member ProjectSettings.rendering/lights_and_shadows/directional_shadow/size] beállítást. Ez globális érték, ezért nézetablakonként nem állítható."

#. RenderingServer.scenario_set_camera_attributes
#: doc/classes/RenderingServer.xml
msgid "Sets the camera attributes ([param effects]) that will be used with this scenario. See also [CameraAttributes]."
msgstr "Beállítja a renderelési színtérhez használt [param effects] kamerajellemzőket. Lásd még a [CameraAttributes] osztályt."

#. RenderingServer.scenario_set_compositor
#: doc/classes/RenderingServer.xml
msgid "Sets the compositor ([param compositor]) that will be used with this scenario. See also [Compositor]."
msgstr "Beállítja a renderelési színtérhez használt [param compositor] kompozitort. Lásd még a [Compositor] osztályt."

#. RenderingServer.scenario_set_environment
#: doc/classes/RenderingServer.xml
msgid "Sets the environment that will be used with this scenario. See also [Environment]."
msgstr "Beállítja a renderelési színtér környezetét. Lásd még az [Environment] osztályt."

#. RenderingServer.scenario_set_fallback_environment
#: doc/classes/RenderingServer.xml
msgid "Sets the fallback environment to be used by this scenario. The fallback environment is used if no environment is set. Internally, this is used by the editor to provide a default environment."
msgstr "Beállítja a renderelési színtér tartalék környezetét. Ez akkor használatos, ha nincs megadva elsődleges környezet. A szerkesztő ezzel biztosít alapértelmezett környezetet."

#. RenderingServer.shader_get_code
#: doc/classes/RenderingServer.xml
msgid "Returns a shader's source code as a string."
msgstr "Sztringként adja vissza a shader forráskódját."

#. RenderingServer.shader_get_parameter_default
#: doc/classes/RenderingServer.xml
msgid "Returns the default value for the specified shader uniform. This is usually the value written in the shader source code."
msgstr "A megadott shaderuniform alapértelmezett értékét adja vissza. Ez rendszerint a shader forráskódjában megadott érték."

#. RenderingServer.shader_set_code
#: doc/classes/RenderingServer.xml
msgid "Sets the shader's source code (which triggers recompilation after being changed)."
msgstr "Beállítja a shader forráskódját. A kód módosítása újrafordítást indít."

#. RenderingServer.shader_set_path_hint
#: doc/classes/RenderingServer.xml
msgid "Sets the path hint for the specified shader. This should generally match the [Shader] resource's [member Resource.resource_path]."
msgstr "Beállítja a shaderhez tartozó tájékoztató útvonalat. Ennek általában egyeznie kell a [Shader] erőforrás [member Resource.resource_path] értékével."

#. RenderingServer.sky_set_material
#: doc/classes/RenderingServer.xml
msgid "Sets the material that the sky uses to render the background, ambient and reflection maps."
msgstr "Beállítja az égbolt anyagát, amelyből a renderelő a hátteret, a környezeti fényt és a tükröződési térképeket állítja elő."

#. RenderingServer.sky_set_mode
#: doc/classes/RenderingServer.xml
msgid "Sets the process [param mode] of the sky specified by the [param sky] RID. Equivalent to [member Sky.process_mode]."
msgstr "Beállítja a [param sky] RID-del megadott égbolt [param mode] feldolgozási módját. A [member Sky.process_mode] tulajdonságnak felel meg."

#. RenderingServer.sky_set_radiance_size
#: doc/classes/RenderingServer.xml
msgid "Sets the [param radiance_size] of the sky specified by the [param sky] RID (in pixels). Equivalent to [member Sky.radiance_size]."
msgstr "Beállítja a [param sky] RID-del megadott égbolt sugárzási térképének képpontban mért [param radiance_size] méretét. A [member Sky.radiance_size] tulajdonságnak felel meg."

#. RenderingServer.decal_set_albedo_mix
#: doc/classes/RenderingServer.xml
msgid "Sets the [param albedo_mix] in the decal specified by the [param decal] RID. Equivalent to [member Decal.albedo_mix]."
msgstr "Beállítja a [param decal] RID-del megadott vetített textúra [param albedo_mix] albedókeverési értékét. A [member Decal.albedo_mix] tulajdonságnak felel meg."

#. RenderingServer.decal_set_cull_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the cull [param mask] in the decal specified by the [param decal] RID. Equivalent to [member Decal.cull_mask]."
msgstr "Beállítja a [param decal] RID-del megadott vetített textúra [param mask] rétegmaszkját. A [member Decal.cull_mask] tulajdonságnak felel meg."

#. RenderingServer.decal_set_distance_fade
#: doc/classes/RenderingServer.xml
msgid "Sets the distance fade parameters in the decal specified by the [param decal] RID. Equivalent to [member Decal.distance_fade_enabled], [member Decal.distance_fade_begin] and [member Decal.distance_fade_length]."
msgstr "Beállítja a [param decal] RID-del megadott vetített textúra távolság szerinti halványulását. A [member Decal.distance_fade_enabled], a [member Decal.distance_fade_begin] és a [member Decal.distance_fade_length] tulajdonságnak felel meg."

#. RenderingServer.decal_set_emission_energy
#: doc/classes/RenderingServer.xml
msgid "Sets the emission [param energy] in the decal specified by the [param decal] RID. Equivalent to [member Decal.emission_energy]."
msgstr "Beállítja a [param decal] RID-del megadott vetített textúra fénykibocsátási [param energy] értékét. A [member Decal.emission_energy] tulajdonságnak felel meg."

#. RenderingServer.decal_set_fade
#: doc/classes/RenderingServer.xml
msgid "Sets the upper fade ([param above]) and lower fade ([param below]) in the decal specified by the [param decal] RID. Equivalent to [member Decal.upper_fade] and [member Decal.lower_fade]."
msgstr "Beállítja a [param decal] RID-del megadott vetített textúra felső ([param above]) és alsó ([param below]) halványulását. A [member Decal.upper_fade] és a [member Decal.lower_fade] tulajdonságnak felel meg."

#. RenderingServer.decal_set_modulate
#: doc/classes/RenderingServer.xml
msgid "Sets the color multiplier in the decal specified by the [param decal] RID to [param color]. Equivalent to [member Decal.modulate]."
msgstr "A [param color] értékre állítja a [param decal] RID-del megadott vetített textúra színszorzóját. A [member Decal.modulate] tulajdonságnak felel meg."

#. RenderingServer.decal_set_normal_fade
#: doc/classes/RenderingServer.xml
msgid "Sets the normal [param fade] in the decal specified by the [param decal] RID. Equivalent to [member Decal.normal_fade]."
msgstr "Beállítja a [param decal] RID-del megadott vetített textúra felületi normálistól függő [param fade] halványulását. A [member Decal.normal_fade] tulajdonságnak felel meg."

#. RenderingServer.decal_set_size
#: doc/classes/RenderingServer.xml
msgid "Sets the [param size] of the decal specified by the [param decal] RID. Equivalent to [member Decal.size]."
msgstr "Beállítja a [param decal] RID-del megadott vetített textúra [param size] méretét. A [member Decal.size] tulajdonságnak felel meg."

#. RenderingServer.decal_set_texture
#: doc/classes/RenderingServer.xml
msgid "Sets the [param texture] in the given texture [param type] slot for the specified decal. Equivalent to [method Decal.set_texture]."
msgstr "A [param texture] textúrát a vetített textúra megadott [param type] típusú helyéhez rendeli. A [method Decal.set_texture] metódusnak felel meg."

#. RenderingServer.decals_set_filter
#: doc/classes/RenderingServer.xml
msgid "Sets the texture [param filter] mode to use when rendering decals. This parameter is global and cannot be set on a per-decal basis."
msgstr "Beállítja a vetített textúrák renderelésekor használt [param filter] szűrési módot. Ez globális érték, ezért vetítésenként nem állítható."

#. RenderingServer.environment_set_camera_id
#: doc/classes/RenderingServer.xml
msgid "Sets the camera ID to be used as environment background."
msgstr "A környezet hátteréhez használt élő kamerakép azonosítóját állítja be."

#. RenderingServer.environment_set_ssao_quality
#: doc/classes/RenderingServer.xml
msgid "Sets the quality level of the screen-space ambient occlusion (SSAO) post-process effect. See [Environment] for more details."
msgstr "Beállítja a képernyőtérbeli környezeti takarás (SSAO) utófeldolgozási effektjének minőségét. A részletekért lásd az [Environment] osztályt."

#. RenderingServer.environment_set_ssil_quality
#: doc/classes/RenderingServer.xml
msgid "Sets the quality level of the screen-space indirect lighting (SSIL) post-process effect. See [Environment] for more details."
msgstr "Beállítja a képernyőtérbeli közvetett megvilágítás (SSIL) utófeldolgozási effektjének minőségét. A részletekért lásd az [Environment] osztályt."

#. RenderingServer.environment_set_ssr
#: doc/classes/RenderingServer.xml
msgid "Sets the variables to be used with the screen-space reflections (SSR) post-process effect. See [Environment] for more details."
msgstr "Beállítja a képernyőtérbeli tükröződés (SSR) utófeldolgozási effektjének értékeit. A részletekért lásd az [Environment] osztályt."

#. RenderingServer.environment_set_ssr_half_size
#: doc/classes/RenderingServer.xml
msgid "Sets whether screen-space reflections will be rendered at full or half size. Half size is faster, but may look pixelated or cause flickering."
msgstr "Megadja, hogy a képernyőtérbeli tükröződéseket teljes vagy felezett felbontással számítsa ki a renderelő. A felezett felbontás gyorsabb, de a tükröződés pixeles lehet vagy villódzhat."

#. RenderingServer.environment_set_tonemap_agx_contrast
#: doc/classes/RenderingServer.xml
msgid "See [member Environment.tonemap_agx_contrast] for more details."
msgstr "A részletekért lásd az [member Environment.tonemap_agx_contrast] tulajdonságot."

#. RenderingServer.lightmap_get_probe_capture_points
#: doc/classes/RenderingServer.xml
msgid "Returns the [i]local space[/i] positions of each lightmap probe capture point. Keep in mind the lightmap instance may have a non-zero transform, which will affect the position of the probe capture points. See also [method lightmap_set_probe_capture_data]."
msgstr "A fénytérképszondák mintavételi pontjainak [i]helyi koordinátáit[/i] adja vissza. A fénytérképpéldány transzformációja befolyásolhatja e pontok helyét a jelenetben. Lásd még a [method lightmap_set_probe_capture_data] metódust."

#. RenderingServer.lightmap_get_probe_capture_sh
#: doc/classes/RenderingServer.xml
msgid "Returns the L0, L1, and L2 [url=https://en.wikipedia.org/wiki/Spherical_harmonics]spherical harmonics[/url] data for each lightmap probe capture point. This is specified as 9 [Color] values per probe, which means the size of the returned data is always 9 times the number of probe points. See also [method lightmap_set_probe_capture_data]."
msgstr "A fénytérképszondák mintavételi pontjaihoz tartozó L0, L1 és L2 rendű [url=https://en.wikipedia.org/wiki/Spherical_harmonics]gömbharmonikus[/url] együtthatókat adja vissza. Szondánként 9 [Color] érték tartozik hozzájuk, ezért az eredmény mérete mindig a pontok számának 9-szerese. Lásd még a [method lightmap_set_probe_capture_data] metódust."

#. RenderingServer.lightmap_get_probe_capture_tetrahedra
#: doc/classes/RenderingServer.xml
msgid "Returns the tetrahedralization data used for interpolating between lightmap probe capture points. Each tetrahedron is specified as a series of 4 numbers, each being an index into the probe capture points array returned by [method lightmap_get_probe_capture_points]. See also [method lightmap_set_probe_capture_data]."
msgstr "A fénytérképszondák mintavételi pontjai közötti interpolációhoz használt tetraéderfelosztást adja vissza. Minden tetraédert 4 index ír le, amelyek a [method lightmap_get_probe_capture_points] által visszaadott ponttömbre hivatkoznak. Lásd még a [method lightmap_set_probe_capture_data] metódust."

#. RenderingServer.lightmap_set_probe_bounds
#: doc/classes/RenderingServer.xml
msgid "Sets the bounds that this lightmap instance should visually affect, both in terms of static lightmap baking and probe-based global illumination."
msgstr "Beállítja azt a térrészt, amelyre a fénytérképpéldány hat. Ez a statikus fénytérképek beégetésére és a szondákon alapuló globális megvilágításra is vonatkozik."

#. RenderingServer.lightmap_set_probe_capture_data
#: doc/classes/RenderingServer.xml
msgid "Sets the probe capture data for the given lightmap instance. See [method lightmap_get_probe_capture_points], [method lightmap_get_probe_capture_sh], [method lightmap_get_probe_capture_tetrahedra], and [method lightmap_get_probe_capture_bsp_tree] for the expected data formats."
msgstr "Beállítja a megadott fénytérképpéldány szondáinak mintavételi adatait. A várt adatformátumokat a [method lightmap_get_probe_capture_points], a [method lightmap_get_probe_capture_sh], a [method lightmap_get_probe_capture_tetrahedra] és a [method lightmap_get_probe_capture_bsp_tree] metódus leírása ismerteti."

#. RenderingServer.lightmap_set_probe_interior
#: doc/classes/RenderingServer.xml
msgid "Sets whether the lightmap instance should be considered as interior (when [param interior] is [code]true[/code]). If the lightmap is marked as interior, environment lighting is ignored when baking lightmaps."
msgstr "Ha az [param interior] értéke [code]true[/code], a fénytérképpéldány belső térhez tartozik. A belső fénytérképszondák elsőbbséget kapnak a külső szondákkal szemben a dinamikus objektumok megvilágításakor."

#. RenderingServer.lightmap_set_textures
#: doc/classes/RenderingServer.xml
msgid "Set the textures on the given [param lightmap] GI instance to the texture array pointed to by the [param light] RID. If the lightmap texture was baked with [member LightmapGI.directional] set to [code]true[/code], then [param uses_sh] must also be [code]true[/code]."
msgstr "A megadott [param lightmap] globális megvilágítási példány textúráit a [param light] RID által jelölt textúratömbre állítja. Ha a fénytérképet [code]true[/code] értékű [member LightmapGI.directional] beállítással égették be, a [param uses_sh] értékének is [code]true[/code]-nak kell lennie."

#. RenderingServer.lightmaps_set_bicubic_filter
#: doc/classes/RenderingServer.xml
msgid "Toggles whether a bicubic filter should be used when lightmaps are sampled. This smoothens their appearance at a performance cost."
msgstr "Beállítja, hogy a renderelő bikubikus szűréssel mintavételezze-e a fénytérképeket. A szűrés simább eredményt ad, de növeli a renderelési költséget."

#. RenderingServer.reflection_probe_set_ambient_color
#: doc/classes/RenderingServer.xml
msgid "Sets the reflection probe's custom ambient light color. Equivalent to [member ReflectionProbe.ambient_color]."
msgstr "Beállítja a tükröződési szonda egyéni környezeti fényének színét. A [member ReflectionProbe.ambient_color] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_ambient_energy
#: doc/classes/RenderingServer.xml
msgid "Sets the reflection probe's custom ambient light energy. Equivalent to [member ReflectionProbe.ambient_color_energy]."
msgstr "Beállítja a tükröződési szonda egyéni környezeti fényének erősségét. A [member ReflectionProbe.ambient_color_energy] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_ambient_mode
#: doc/classes/RenderingServer.xml
msgid "Sets the reflection probe's ambient light mode. Equivalent to [member ReflectionProbe.ambient_mode]."
msgstr "Beállítja a tükröződési szonda környezeti megvilágítási módját. A [member ReflectionProbe.ambient_mode] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_as_interior
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], reflections will ignore sky contribution. Equivalent to [member ReflectionProbe.interior]."
msgstr "Ha az értéke [code]true[/code], az égbolt nem járul hozzá a tükröződésekhez. A [member ReflectionProbe.interior] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_blend_distance
#: doc/classes/RenderingServer.xml
msgid "Sets the distance in meters over which a probe blends into the scene."
msgstr "Méterben adja meg, mekkora távolságon olvadjon bele a szonda hatása a jelenet megvilágításába."

#. RenderingServer.reflection_probe_set_cull_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the render cull mask for this reflection probe. Only instances with a matching layer will be reflected by this probe. Equivalent to [member ReflectionProbe.cull_mask]."
msgstr "Beállítja a tükröződési szonda láthatósági maszkját. A szonda csak a megfelelő rétegen lévő példányokat jeleníti meg a tükröződésekben. A [member ReflectionProbe.cull_mask] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_enable_box_projection
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], uses box projection. This can make reflections look more correct in certain situations. Equivalent to [member ReflectionProbe.box_projection]."
msgstr "Ha az értéke [code]true[/code], dobozvetítést használ. Ettől bizonyos helyzetekben pontosabbnak látszik a tükröződés. A [member ReflectionProbe.box_projection] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_enable_shadows
#: doc/classes/RenderingServer.xml
msgid "If [code]true[/code], computes shadows in the reflection probe. This makes the reflection much slower to compute. Equivalent to [member ReflectionProbe.enable_shadows]."
msgstr "Ha az értéke [code]true[/code], a tükröződési szonda árnyékokat is számít. Ez jelentősen lassítja a tükröződés előállítását. A [member ReflectionProbe.enable_shadows] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_intensity
#: doc/classes/RenderingServer.xml
msgid "Sets the intensity of the reflection probe. Intensity modulates the strength of the reflection. Equivalent to [member ReflectionProbe.intensity]."
msgstr "Beállítja a tükröződési szonda intenzitását, amely a tükröződés erősségét szabályozza. A [member ReflectionProbe.intensity] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_max_distance
#: doc/classes/RenderingServer.xml
msgid "Sets the max distance away from the probe an object can be before it is culled. Equivalent to [member ReflectionProbe.max_distance]."
msgstr "Beállítja, milyen távolságon túl hagyja ki a szonda az objektumokat a tükröződésből. A [member ReflectionProbe.max_distance] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_mesh_lod_threshold
#: doc/classes/RenderingServer.xml
msgid "Sets the mesh level of detail to use in the reflection probe rendering. Higher values will use less detailed versions of meshes that have LOD variations generated, which can improve performance. Equivalent to [member ReflectionProbe.mesh_lod_threshold]."
msgstr "Beállítja a tükröződési szonda által renderelt hálók részletességi küszöbét. Nagyobb értéknél a renderelő kevésbé részletes változatokat használ az előállított LOD-változatokkal rendelkező hálókból, ami javíthatja a teljesítményt. A [member ReflectionProbe.mesh_lod_threshold] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_reflection_mask
#: doc/classes/RenderingServer.xml
msgid "Sets the render reflection mask for this reflection probe. Only instances with a matching layer will have reflections applied from this probe. Equivalent to [member ReflectionProbe.reflection_mask]."
msgstr "Beállítja a tükröződési maszkot. A szonda tükröződései csak a maszkban szereplő rétegek példányain jelennek meg. A [member ReflectionProbe.reflection_mask] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_resolution
#: doc/classes/RenderingServer.xml
msgid "Deprecated. This method does nothing."
msgstr "Elavult. A metódus nem végez műveletet."

#. RenderingServer.reflection_probe_set_size
#: doc/classes/RenderingServer.xml
msgid "Sets the size of the area that the reflection probe will capture. Equivalent to [member ReflectionProbe.size]."
msgstr "Beállítja a tükröződési szonda által lefedett terület méretét. A [member ReflectionProbe.size] tulajdonságnak felel meg."

#. RenderingServer.reflection_probe_set_update_mode
#: doc/classes/RenderingServer.xml
msgid "Sets how often the reflection probe updates. Can either be once or every frame."
msgstr "Beállítja, hogy a tükröződési szonda egyszer vagy képkockánként frissüljön."

#. RenderingServer.voxel_gi_get_data_cells
#: doc/classes/RenderingServer.xml
msgid "Returns the data cells for the specified voxel GI data instance. See also [method voxel_gi_allocate_data]."
msgstr "A megadott voxeles globális megvilágítási példány cellaadatait adja vissza. Lásd még a [method voxel_gi_allocate_data] metódust."

#. RenderingServer.voxel_gi_get_distance_field
#: doc/classes/RenderingServer.xml
msgid "Returns the distance field data for the specified voxel GI data instance. See also [method voxel_gi_allocate_data]."
msgstr "A megadott voxeles globális megvilágítási példány távolságmezőjének adatait adja vissza. Lásd még a [method voxel_gi_allocate_data] metódust."

#. RenderingServer.voxel_gi_get_level_counts
#: doc/classes/RenderingServer.xml
msgid "Returns the level counts for the specified voxel GI data instance. See also [method voxel_gi_allocate_data]."
msgstr "A megadott voxeles globális megvilágítási példány szintenkénti cellaszámait adja vissza. Lásd még a [method voxel_gi_allocate_data] metódust."

#. RenderingServer.voxel_gi_get_octree_cells
#: doc/classes/RenderingServer.xml
msgid "Returns the octree cell data for the specified voxel GI data instance. See also [method voxel_gi_allocate_data]."
msgstr "A megadott voxeles globális megvilágítási példány octree-celláinak adatait adja vissza. Lásd még a [method voxel_gi_allocate_data] metódust."

#. RenderingServer.voxel_gi_get_octree_size
#: doc/classes/RenderingServer.xml
msgid "Returns the octree size for the specified voxel GI data instance, which corresponds to the number of subdivisions per axis. This can be viewed in the editor by hovering the [b]Bake VoxelGI[/b] button at the top of the 3D editor viewport when a [VoxelGI] node is selected and looking at the [b]Subdivisions[/b] field in the tooltip."
msgstr "A megadott voxeles globális megvilágítási példány octree méretét, vagyis a tengelyenkénti felosztások számát adja vissza. A szerkesztőben jelölj ki egy [VoxelGI] csomópontot, majd a 3D nézet tetején tartsd a mutatót a [b]VoxelGI Beégetése[/b] gomb fölött. A súgóbuborék [b]Felosztások[/b] mezője mutatja az értéket."

#. RenderingServer.voxel_gi_get_to_cell_xform
#: doc/classes/RenderingServer.xml
msgid "Returns the transform to cell space for the specified voxel GI data instance. See also [method voxel_gi_allocate_data]."
msgstr "A megadott voxeles globális megvilágítási példány cellakoordinátáiba átalakító transzformációt adja vissza. Lásd még a [method voxel_gi_allocate_data] metódust."

#. RenderingServer.voxel_gi_set_bias
#: doc/classes/RenderingServer.xml
msgid "Sets the [member VoxelGIData.bias] value to use on the specified [param voxel_gi]'s [RID]."
msgstr "A megadott [param voxel_gi] [RID] azonosítójú példány [member VoxelGIData.bias] értékét állítja be."

#. RenderingServer.voxel_gi_set_dynamic_range
#: doc/classes/RenderingServer.xml
msgid "Sets the [member VoxelGIData.dynamic_range] value to use on the specified [param voxel_gi]'s [RID]."
msgstr "A megadott [param voxel_gi] [RID] azonosítójú példány [member VoxelGIData.dynamic_range] értékét állítja be."

#. RenderingServer.voxel_gi_set_energy
#: doc/classes/RenderingServer.xml
msgid "Sets the [member VoxelGIData.energy] value to use on the specified [param voxel_gi]'s [RID]."
msgstr "A megadott [param voxel_gi] [RID] azonosítójú példány [member VoxelGIData.energy] értékét állítja be."

#. RenderingServer.voxel_gi_set_interior
#: doc/classes/RenderingServer.xml
msgid "Sets the [member VoxelGIData.interior] value to use on the specified [param voxel_gi]'s [RID]."
msgstr "A megadott [param voxel_gi] [RID] azonosítójú példány [member VoxelGIData.interior] értékét állítja be."

#. RenderingServer.voxel_gi_set_normal_bias
#: doc/classes/RenderingServer.xml
msgid "Sets the [member VoxelGIData.normal_bias] value to use on the specified [param voxel_gi]'s [RID]."
msgstr "A megadott [param voxel_gi] [RID] azonosítójú példány [member VoxelGIData.normal_bias] értékét állítja be."

#. LightmapGI.brief
#: doc/classes/LightmapGI.xml
msgid "Computes and stores baked lightmaps for fast global illumination."
msgstr "Fénytérképeket számít ki és tárol a gyors globális megvilágításhoz."

#. LightmapGI.bias
#: doc/classes/LightmapGI.xml
msgid "The bias to use when computing shadows. Increasing [member bias] can fix shadow acne on the resulting baked lightmap, but can introduce peter-panning (shadows not connecting to their casters). Real-time [Light3D] shadows are not affected by this [member bias] property."
msgstr "Az árnyékszámításnál használt eltolás. A [member bias] növelése megszüntetheti a beégetett fénytérkép önárnyékolási foltjait, de elválaszthatja az árnyékokat az őket vető tárgyaktól. A [Light3D] valós idejű árnyékaira ez a [member bias] beállítás nincs hatással."

#. LightmapGI.bounces
#: doc/classes/LightmapGI.xml
msgid "Number of light bounces that are taken into account during baking. Higher values result in brighter, more realistic lighting, at the cost of longer bake times. If set to [code]0[/code], only environment lighting, direct light and emissive lighting is baked."
msgstr "A beégetéskor figyelembe vett fényvisszaverődések száma. Nagyobb értékkel világosabb és élethűbb a megvilágítás, de tovább tart a számítás. [code]0[/code] esetén csak a környezeti fény, a közvetlen fény és a fénykibocsátó felületek megvilágítása kerül a fénytérképbe."

#. LightmapGI.camera_attributes
#: doc/classes/LightmapGI.xml
msgid "The [CameraAttributes] resource that specifies exposure levels to bake at. Auto-exposure and non exposure properties will be ignored. Exposure settings should be used to reduce the dynamic range present when baking. If exposure is too high, the [LightmapGI] will have banding artifacts or may have over-exposure artifacts."
msgstr "A beégetés expozícióját meghatározó [CameraAttributes] erőforrás. Az automatikus expozíció és az expozíciótól független tulajdonságok nem számítanak. Az expozíció megfelelő beállításával csökkenthető a beégetésnél feldolgozott dinamikatartomány. Túl magas expozíciónál a [LightmapGI] eredménye sávozott vagy túlexponált lehet."

#. LightmapGI.denoiser_range
#: doc/classes/LightmapGI.xml
msgid "The distance in pixels from which the denoiser samples. Lower values preserve more details, but may give blotchy results if the lightmap quality is not high enough. Only effective if [member use_denoiser] is [code]true[/code] and [member ProjectSettings.rendering/lightmapping/denoising/denoiser] is set to JNLM."
msgstr "A zajszűrés mintavételi távolsága képpontban. Kisebb érték több részletet őriz meg, de gyengébb minőségű fénytérképnél foltos eredményt adhat. Csak akkor hatásos, ha a [member use_denoiser] értéke [code]true[/code], és a [member ProjectSettings.rendering/lightmapping/denoising/denoiser] beállítás értéke JNLM."

#. LightmapGI.denoiser_strength
#: doc/classes/LightmapGI.xml
msgid "The strength of denoising step applied to the generated lightmaps. Only effective if [member use_denoiser] is [code]true[/code] and [member ProjectSettings.rendering/lightmapping/denoising/denoiser] is set to JNLM."
msgstr "Az előállított fénytérképek zajszűrésének erőssége. Csak akkor hatásos, ha a [member use_denoiser] értéke [code]true[/code], és a [member ProjectSettings.rendering/lightmapping/denoising/denoiser] beállítás értéke JNLM."

#. LightmapGI.environment_custom_color
#: doc/classes/LightmapGI.xml
msgid "The color to use for environment lighting. Only effective if [member environment_mode] is [constant ENVIRONMENT_MODE_CUSTOM_COLOR]."
msgstr "A környezeti megvilágítás színe. Csak akkor érvényes, ha az [member environment_mode] értéke [constant ENVIRONMENT_MODE_CUSTOM_COLOR]."

#. LightmapGI.environment_custom_energy
#: doc/classes/LightmapGI.xml
msgid "The color multiplier to use for environment lighting. Only effective if [member environment_mode] is [constant ENVIRONMENT_MODE_CUSTOM_COLOR]."
msgstr "A környezeti megvilágítás színszorzója. Csak akkor érvényes, ha az [member environment_mode] értéke [constant ENVIRONMENT_MODE_CUSTOM_COLOR]."

#. LightmapGI.environment_custom_sky
#: doc/classes/LightmapGI.xml
msgid "The sky to use as a source of environment lighting. Only effective if [member environment_mode] is [constant ENVIRONMENT_MODE_CUSTOM_SKY]."
msgstr "A környezeti megvilágítás forrásaként használt égbolt. Csak akkor érvényes, ha az [member environment_mode] értéke [constant ENVIRONMENT_MODE_CUSTOM_SKY]."

#. LightmapGI.environment_mode
#: doc/classes/LightmapGI.xml
msgid "The environment mode to use when baking lightmaps."
msgstr "A fénytérképek beégetésekor használt környezeti megvilágítási mód."

#. LightmapGI.interior
#: doc/classes/LightmapGI.xml
msgid "If [code]true[/code], ignore environment lighting when baking lightmaps."
msgstr "Ha az értéke [code]true[/code], a fénytérképszondák belső térhez tartoznak. A dinamikus objektumok megvilágításakor a belső szondák elsőbbséget kapnak a külsőkkel szemben."

#. LightmapGI.light_data
#: doc/classes/LightmapGI.xml
msgid "The [LightmapGIData] associated to this [LightmapGI] node. This resource is automatically created after baking, and is not meant to be created manually."
msgstr "A [LightmapGI] csomóponthoz tartozó [LightmapGIData] erőforrás. A beégetés után automatikusan létrejön, ezért nem kell kézzel elkészíteni."

#. LightmapGI.max_texture_size
#: doc/classes/LightmapGI.xml
msgid "The maximum texture size for the generated texture atlas. Higher values will result in fewer slices being generated, but may not work on all hardware as a result of hardware limitations on texture sizes. Leave [member max_texture_size] at its default value of [code]16384[/code] if unsure."
msgstr "Az előállított textúraatlasz maximális textúramérete. Nagyobb értékkel kevesebb szelet készül, de egyes eszközök korlátozzák a használható textúrák méretét. Ha bizonytalan vagy, hagyd a [member max_texture_size] értékét az alapértelmezett [code]16384[/code] beállításon."

#. LightmapGI.use_denoiser
#: doc/classes/LightmapGI.xml
msgid "If [code]true[/code], uses a GPU-based denoising algorithm on the generated lightmap. This eliminates most noise within the generated lightmap at the cost of longer bake times. File sizes are generally not impacted significantly by the use of a denoiser, although lossless compression may do a better job at compressing a denoised image."
msgstr "Ha az értéke [code]true[/code], a motor GPU-s zajszűrést alkalmaz az előállított fénytérképen. A zaj nagy része eltűnik, de a beégetés tovább tart. A fájlméret általában alig változik, bár a veszteségmentes tömörítés hatékonyabb lehet a zajszűrt képen."

#. LightmapGI.BAKE_QUALITY_LOW
#: doc/classes/LightmapGI.xml
msgid "Low bake quality (fastest bake times). The quality of this preset can be adjusted by changing [member ProjectSettings.rendering/lightmapping/bake_quality/low_quality_ray_count] and [member ProjectSettings.rendering/lightmapping/bake_quality/low_quality_probe_ray_count]."
msgstr "Alacsony beégetési minőség, a legrövidebb számítási idővel. Az előbeállítás minőségét a [member ProjectSettings.rendering/lightmapping/bake_quality/low_quality_ray_count] és a [member ProjectSettings.rendering/lightmapping/bake_quality/low_quality_probe_ray_count] módosításával finomíthatod."

#. LightmapGI.BAKE_QUALITY_MEDIUM
#: doc/classes/LightmapGI.xml
msgid "Medium bake quality (fast bake times). The quality of this preset can be adjusted by changing [member ProjectSettings.rendering/lightmapping/bake_quality/medium_quality_ray_count] and [member ProjectSettings.rendering/lightmapping/bake_quality/medium_quality_probe_ray_count]."
msgstr "Közepes beégetési minőség, rövid számítási idővel. Az előbeállítás minőségét a [member ProjectSettings.rendering/lightmapping/bake_quality/medium_quality_ray_count] és a [member ProjectSettings.rendering/lightmapping/bake_quality/medium_quality_probe_ray_count] módosításával finomíthatod."

#. LightmapGI.BAKE_QUALITY_HIGH
#: doc/classes/LightmapGI.xml
msgid "High bake quality (slow bake times). The quality of this preset can be adjusted by changing [member ProjectSettings.rendering/lightmapping/bake_quality/high_quality_ray_count] and [member ProjectSettings.rendering/lightmapping/bake_quality/high_quality_probe_ray_count]."
msgstr "Magas beégetési minőség, hosszabb számítási idővel. Az előbeállítás minőségét a [member ProjectSettings.rendering/lightmapping/bake_quality/high_quality_ray_count] és a [member ProjectSettings.rendering/lightmapping/bake_quality/high_quality_probe_ray_count] módosításával finomíthatod."

#. LightmapGI.BAKE_QUALITY_ULTRA
#: doc/classes/LightmapGI.xml
msgid "Highest bake quality (slowest bake times). The quality of this preset can be adjusted by changing [member ProjectSettings.rendering/lightmapping/bake_quality/ultra_quality_ray_count] and [member ProjectSettings.rendering/lightmapping/bake_quality/ultra_quality_probe_ray_count]."
msgstr "A legjobb beégetési minőség, a leghosszabb számítási idővel. Az előbeállítás minőségét a [member ProjectSettings.rendering/lightmapping/bake_quality/ultra_quality_ray_count] és a [member ProjectSettings.rendering/lightmapping/bake_quality/ultra_quality_probe_ray_count] módosításával finomíthatod."

#. LightmapGI.GENERATE_PROBES_DISABLED
#: doc/classes/LightmapGI.xml
msgid "Don't generate lightmap probes for lighting dynamic objects."
msgstr "A dinamikus objektumok megvilágításához nem készülnek fénytérképszondák."

#. LightmapGI.GENERATE_PROBES_SUBDIV_4
#: doc/classes/LightmapGI.xml
msgid "Lowest level of subdivision (fastest bake times, smallest file sizes)."
msgstr "A legritkább felosztás, a legrövidebb számítási idővel és a legkisebb fájlmérettel."

#. LightmapGI.GENERATE_PROBES_SUBDIV_8
#: doc/classes/LightmapGI.xml
msgid "Low level of subdivision (fast bake times, small file sizes)."
msgstr "Ritka felosztás, rövid számítási idővel és kis fájlmérettel."

#. LightmapGI.GENERATE_PROBES_SUBDIV_16
#: doc/classes/LightmapGI.xml
msgid "High level of subdivision (slow bake times, large file sizes)."
msgstr "Sűrű felosztás, hosszabb számítási idővel és nagyobb fájlmérettel."

#. LightmapGI.GENERATE_PROBES_SUBDIV_32
#: doc/classes/LightmapGI.xml
msgid "Highest level of subdivision (slowest bake times, largest file sizes)."
msgstr "A legsűrűbb felosztás, a leghosszabb számítási idővel és a legnagyobb fájlmérettel."

#. LightmapGI.BAKE_ERROR_OK
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking was successful."
msgstr "A fénytérkép beégetése sikerült."

#. LightmapGI.BAKE_ERROR_NO_SCENE_ROOT
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed because the root node for the edited scene could not be accessed."
msgstr "A fénytérkép beégetése sikertelen, mert a szerkesztett jelenet gyökércsomópontja nem érhető el."

#. LightmapGI.BAKE_ERROR_FOREIGN_DATA
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as the lightmap data resource is embedded in a foreign resource."
msgstr "A fénytérkép beégetése sikertelen, mert a fénytérképadatok másik erőforrásba vannak beágyazva."

#. LightmapGI.BAKE_ERROR_NO_LIGHTMAPPER
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as there is no lightmapper available in this Godot build."
msgstr "A fénytérkép beégetése sikertelen, mert ebben a Godot-buildben nem érhető el fénytérkép-számító modul."

#. LightmapGI.BAKE_ERROR_NO_SAVE_PATH
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as the [LightmapGIData] save path isn't configured in the resource."
msgstr "A fénytérkép beégetése sikertelen, mert a [LightmapGIData] erőforrás mentési útvonala nincs beállítva."

#. LightmapGI.BAKE_ERROR_NO_MESHES
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as there are no meshes whose [member GeometryInstance3D.gi_mode] is [constant GeometryInstance3D.GI_MODE_STATIC] and with valid UV2 mapping in the current scene. You may need to select 3D scenes in the Import dock and change their global illumination mode accordingly."
msgstr "A fénytérkép beégetése sikertelen, mert az aktuális jelenetben nincs érvényes UV2-leképezéssel rendelkező háló, amelynek [member GeometryInstance3D.gi_mode] értéke [constant GeometryInstance3D.GI_MODE_STATIC]. Szükség esetén válaszd ki a 3D-s jeleneteket az Import panelen, és állítsd be a megfelelő globális megvilágítási módot."

#. LightmapGI.BAKE_ERROR_MESHES_INVALID
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as the lightmapper failed to analyze some of the meshes marked as static for baking."
msgstr "A fénytérkép beégetése sikertelen, mert egyes, beégetésre kijelölt statikus hálók elemzése nem sikerült."

#. LightmapGI.BAKE_ERROR_CANT_CREATE_IMAGE
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as the resulting image couldn't be saved or imported by Godot after it was saved."
msgstr "A fénytérkép beégetése sikertelen, mert a Godot nem tudta elmenteni a kapott képet, vagy a mentés után nem tudta importálni."

#. LightmapGI.BAKE_ERROR_USER_ABORTED
#: doc/classes/LightmapGI.xml
msgid "The user aborted the lightmap baking operation (typically by clicking the [b]Cancel[/b] button in the progress dialog)."
msgstr "A felhasználó megszakította a fénytérkép beégetését, általában a folyamatjelző ablak [b]Mégse[/b] gombjával."

#. LightmapGI.BAKE_ERROR_TEXTURE_SIZE_TOO_SMALL
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as the maximum texture size is too small to fit some of the meshes marked for baking."
msgstr "A fénytérkép beégetése sikertelen, mert egyes beégetésre kijelölt hálók túllépik a maximális textúraméretet."

#. LightmapGI.BAKE_ERROR_LIGHTMAP_TOO_SMALL
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as the lightmap is too small."
msgstr "A fénytérkép beégetése sikertelen, mert a fénytérkép túl kicsi."

#. LightmapGI.BAKE_ERROR_ATLAS_TOO_SMALL
#: doc/classes/LightmapGI.xml
msgid "Lightmap baking failed as the lightmap was unable to fit into an atlas."
msgstr "A fénytérkép beégetése sikertelen, mert a fénytérkép nem fért bele az atlaszba."

#. LightmapGI.ENVIRONMENT_MODE_DISABLED
#: doc/classes/LightmapGI.xml
msgid "Ignore environment lighting when baking lightmaps."
msgstr "A környezeti megvilágítás kimarad a fénytérképek beégetéséből."

#. LightmapGI.ENVIRONMENT_MODE_CUSTOM_SKY
#: doc/classes/LightmapGI.xml
msgid "Use [member environment_custom_sky] as a source of environment lighting when baking lightmaps."
msgstr "A fénytérképek beégetésekor az [member environment_custom_sky] szolgáltatja a környezeti fényt."

#. LightmapGI.ENVIRONMENT_MODE_CUSTOM_COLOR
#: doc/classes/LightmapGI.xml
msgid "Use [member environment_custom_color] multiplied by [member environment_custom_energy] as a constant source of environment lighting when baking lightmaps."
msgstr "A fénytérképek beégetésekor az [member environment_custom_color] és az [member environment_custom_energy] szorzata állandó környezeti fényforrásként szolgál."

#. LightmapGIData.brief
#: doc/classes/LightmapGIData.xml
msgid "Contains baked lightmap and dynamic object probe data for [LightmapGI]."
msgstr "A [LightmapGI] beégetett fénytérképeit és a dinamikus objektumok megvilágításához tartozó szondaadatokat tárolja."

#. LightmapGIData.description
#: doc/classes/LightmapGIData.xml
msgid "[LightmapGIData] contains baked lightmap and dynamic object probe data for [LightmapGI]. It is replaced every time lightmaps are baked in [LightmapGI]."
msgstr "A [LightmapGIData] a [LightmapGI] beégetett fénytérképeit és a dinamikus objektumok megvilágításához tartozó szondaadatokat tárolja. A [LightmapGI] minden beégetéskor lecseréli ezt az erőforrást."

#. LightmapGIData.add_user
#: doc/classes/LightmapGIData.xml
msgid "Adds an object that is considered baked within this [LightmapGIData]."
msgstr "Hozzáad egy objektumot azokhoz, amelyeket ez a [LightmapGIData] beégetettként tart nyilván."

#. LightmapGIData.clear_users
#: doc/classes/LightmapGIData.xml
msgid "Clear all objects that are considered baked within this [LightmapGIData]."
msgstr "Törli az összes objektumot azok közül, amelyeket ez a [LightmapGIData] beégetettként tart nyilván."

#. LightmapGIData.get_user_count
#: doc/classes/LightmapGIData.xml
msgid "Returns the number of objects that are considered baked within this [LightmapGIData]."
msgstr "Megadja, hány objektumot tart nyilván beégetettként ez a [LightmapGIData]."

#. LightmapGIData.get_user_path
#: doc/classes/LightmapGIData.xml
msgid "Returns the [NodePath] of the baked object at index [param user_idx]."
msgstr "A [param user_idx] indexű beégetett objektum [NodePath] útvonalát adja vissza."

#. LightmapGIData.is_using_spherical_harmonics
#: doc/classes/LightmapGIData.xml
msgid "If [code]true[/code], lightmaps were baked with directional information. See also [member LightmapGI.directional]."
msgstr "A [code]true[/code] érték azt jelzi, hogy a fénytérképek beégetésekor a fény irányát is eltárolták. Lásd még a [member LightmapGI.directional] tulajdonságot."

#. LightmapGIData.light_texture
#: doc/classes/LightmapGIData.xml
msgid "The lightmap atlas texture generated by the lightmapper."
msgstr "A fénytérkép számításakor előállított atlasztextúra."

#. LightmapGIData.lightmap_textures
#: doc/classes/LightmapGIData.xml
msgid "The lightmap atlas textures generated by the lightmapper."
msgstr "A fénytérkép számításakor előállított atlasztextúrák."

#. LightmapGIData.shadowmask_textures
#: doc/classes/LightmapGIData.xml
msgid "The shadowmask atlas textures generated by the lightmapper."
msgstr "A fénytérkép számításakor előállított árnyékmaszk-atlaszok textúrái."

#. LightmapGIData.SHADOWMASK_MODE_NONE
#: doc/classes/LightmapGIData.xml
msgid "Shadowmasking is disabled. No shadowmask texture will be created when baking lightmaps. Existing shadowmask textures will be removed during baking."
msgstr "Az árnyékmaszkolás ki van kapcsolva. A beégetés nem hoz létre árnyékmaszk-textúrát, a meglévő árnyékmaszk-textúrákat pedig eltávolítja."

#. ReflectionProbe.brief
#: doc/classes/ReflectionProbe.xml
msgid "Captures its surroundings to create fast, accurate reflections from a given point."
msgstr "Rögzíti a környezetét, hogy a renderelő gyorsan és pontosan jeleníthesse meg egy adott pontból mintavételezett tükröződéseket."

#. RenderingServer.canvas_item_add_circle
#: doc/classes/RenderingServer.xml
msgid "Draws a circle on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_circle]."
msgstr "Kört rajzol a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_circle] metódust."

#. RenderingServer.canvas_item_add_clip_ignore
#: doc/classes/RenderingServer.xml
msgid "If [param ignore] is [code]true[/code], ignore clipping on items drawn with this canvas item until this is called again with [param ignore] set to [code]false[/code]."
msgstr "Ha az [param ignore] értéke [code]true[/code], a vászonelem következő rajzolási műveletei figyelmen kívül hagyják a vágást. A vágást úgy kapcsolhatod vissza, hogy újra meghívod a metódust [code]false[/code] értékű [param ignore] paraméterrel."

#. RenderingServer.canvas_item_add_ellipse
#: doc/classes/RenderingServer.xml
msgid "Draws an ellipse with semi-major axis [param major] and semi-minor axis [param minor] on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_ellipse]."
msgstr "A [param major] nagy és a [param minor] kis féltengelyű ellipszist rajzol a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_ellipse] metódust."

#. RenderingServer.canvas_item_add_lcd_texture_rect_region
#: doc/classes/RenderingServer.xml
msgid "See also [method CanvasItem.draw_lcd_texture_rect_region]."
msgstr "Lásd még a [method CanvasItem.draw_lcd_texture_rect_region] metódust."

#. RenderingServer.canvas_item_add_line
#: doc/classes/RenderingServer.xml
msgid "Draws a line on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_line]."
msgstr "Vonalszakaszt rajzol a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_line] metódust."

#. RenderingServer.canvas_item_add_mesh
#: doc/classes/RenderingServer.xml
msgid "Draws a mesh created with [method mesh_create] with given [param transform], [param modulate] color, and [param texture]. This is used internally by [MeshInstance2D]."
msgstr "A [method mesh_create] metódussal létrehozott hálót rajzolja ki a megadott [param transform] transzformációval, [param modulate] színszorzóval és [param texture] textúrával. A [MeshInstance2D] ezt a metódust használja belsőleg."

#. RenderingServer.canvas_item_add_msdf_texture_rect_region
#: doc/classes/RenderingServer.xml
msgid "See also [method CanvasItem.draw_msdf_texture_rect_region]."
msgstr "Lásd még a [method CanvasItem.draw_msdf_texture_rect_region] metódust."

#. RenderingServer.canvas_item_add_multiline
#: doc/classes/RenderingServer.xml
msgid "Draws a 2D multiline on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_multiline] and [method CanvasItem.draw_multiline_colors]."
msgstr "Különálló 2D-s vonalszakaszokat rajzol a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_multiline] és a [method CanvasItem.draw_multiline_colors] metódust."

#. RenderingServer.canvas_item_add_multimesh
#: doc/classes/RenderingServer.xml
msgid "Draws a 2D [MultiMesh] on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_multimesh]."
msgstr "Kirajzol egy 2D-s [MultiMesh] erőforrást a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_multimesh] metódust."

#. RenderingServer.canvas_item_add_nine_patch
#: doc/classes/RenderingServer.xml
msgid "Draws a nine-patch rectangle on the [CanvasItem] pointed to by the [param item] [RID]."
msgstr "Kilenc részre osztott téglalapot rajzol a [param item] [RID] által azonosított [CanvasItem] elemre."

#. RenderingServer.canvas_item_add_particles
#: doc/classes/RenderingServer.xml
msgid "Draws particles on the [CanvasItem] pointed to by the [param item] [RID]."
msgstr "Részecskéket rajzol a [param item] [RID] által azonosított [CanvasItem] elemre."

#. RenderingServer.canvas_item_add_polyline
#: doc/classes/RenderingServer.xml
msgid "Draws a 2D polyline on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_polyline] and [method CanvasItem.draw_polyline_colors]."
msgstr "Összefüggő 2D-s vonalszakaszokat rajzol a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_polyline] és a [method CanvasItem.draw_polyline_colors] metódust."

#. RenderingServer.canvas_item_add_primitive
#: doc/classes/RenderingServer.xml
msgid "Draws a 2D primitive on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_primitive]."
msgstr "2D-s primitívet rajzol a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_primitive] metódust."

#. RenderingServer.canvas_item_add_rect
#: doc/classes/RenderingServer.xml
msgid "Draws a rectangle on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_rect]."
msgstr "Téglalapot rajzol a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_rect] metódust."

#. RenderingServer.canvas_item_add_set_transform
#: doc/classes/RenderingServer.xml
msgid "Sets a [Transform2D] that will be used to transform subsequent canvas item commands."
msgstr "Beállítja a vászonelem további rajzolási parancsaira alkalmazott [Transform2D] transzformációt."

#. RenderingServer.canvas_item_add_texture_rect
#: doc/classes/RenderingServer.xml
msgid "Draws a 2D textured rectangle on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_texture_rect] and [method Texture2D.draw_rect]."
msgstr "Textúrázott 2D-s téglalapot rajzol a [param item] [RID] által azonosított [CanvasItem] elemre. Lásd még a [method CanvasItem.draw_texture_rect] és a [method Texture2D.draw_rect] metódust."

#. RenderingServer.canvas_item_add_texture_rect_region
#: doc/classes/RenderingServer.xml
msgid "Draws the specified region of a 2D textured rectangle on the [CanvasItem] pointed to by the [param item] [RID]. See also [method CanvasItem.draw_texture_rect_region] and [method Texture2D.draw_rect_region]."
msgstr "A textúra megadott részét egy 2D-s téglalapba rajzolja a [param item] [RID] által azonosított [CanvasItem] elemen. Lásd még a [method CanvasItem.draw_texture_rect_region] és a [method Texture2D.draw_rect_region] metódust."

#. RenderingServer.canvas_light_attach_to_canvas
#: doc/classes/RenderingServer.xml
msgid "Attaches the canvas light to the canvas. Removes it from its previous canvas."
msgstr "A fényt a megadott vászonhoz rendeli, és leválasztja az előző vásznáról."

#. RenderingServer.canvas_light_occluder_attach_to_canvas
#: doc/classes/RenderingServer.xml
msgid "Attaches a light occluder to the canvas. Removes it from its previous canvas."
msgstr "A fénykitakarót a megadott vászonhoz rendeli, és leválasztja az előző vásznáról."

#. RenderingServer.canvas_light_occluder_set_as_sdf_collision
#: doc/classes/RenderingServer.xml
msgid "Enables or disables using the light occluder as a signed distance field for 2D particle collision."
msgstr "Beállítja, hogy a fénykitakaró bekerüljön-e a 2D-s részecskeütközésekhez használt előjeles távolságmezőbe."

#. RenderingServer.canvas_light_occluder_set_enabled
#: doc/classes/RenderingServer.xml
msgid "Enables or disables light occluder."
msgstr "Engedélyezi vagy letiltja a fénykitakarót."

#. RenderingServer.canvas_light_occluder_set_interpolated
#: doc/classes/RenderingServer.xml
msgid "If [param interpolated] is [code]true[/code], turns on physics interpolation for the light occluder."
msgstr "Ha az [param interpolated] értéke [code]true[/code], a fénykitakaró fizikai interpolációt használ."

#. RenderingServer.canvas_light_occluder_set_light_mask
#. RenderingServer.canvas_light_set_item_cull_mask
#: doc/classes/RenderingServer.xml
msgid "The light mask. See [LightOccluder2D] for more information on light masks."
msgstr "A fénymaszk. A fénymaszk működéséről a [LightOccluder2D] osztály leírásában olvashatsz."

#. RenderingServer.canvas_light_occluder_set_polygon
#: doc/classes/RenderingServer.xml
msgid "Sets a light occluder's polygon."
msgstr "Beállítja a fénykitakaró sokszögét."

#. RenderingServer.canvas_light_occluder_set_transform
#: doc/classes/RenderingServer.xml
msgid "Sets a light occluder's [Transform2D]."
msgstr "Beállítja a fénykitakaró [Transform2D] transzformációját."

#. RenderingServer.canvas_light_set_blend_mode
#: doc/classes/RenderingServer.xml
msgid "Sets the blend mode for the given canvas light to [param mode]. Equivalent to [member Light2D.blend_mode]."
msgstr "A [param mode] értékre állítja a vászonfény keverési módját. A [member Light2D.blend_mode] tulajdonságnak felel meg."

#. RenderingServer.canvas_light_set_color
#: doc/classes/RenderingServer.xml
msgid "Sets the color for a light."
msgstr "Beállítja a fény színét."

#. RenderingServer.canvas_light_set_enabled
#: doc/classes/RenderingServer.xml
msgid "Enables or disables a canvas light."
msgstr "Engedélyezi vagy letiltja a vászonfényt."

#. RenderingServer.canvas_light_set_energy
#: doc/classes/RenderingServer.xml
msgid "Sets a canvas light's energy."
msgstr "Beállítja a vászonfény energiáját."

#. RenderingServer.canvas_light_set_height
#: doc/classes/RenderingServer.xml
msgid "Sets a canvas light's height."
msgstr "Beállítja a vászonfény magasságát."

#. RenderingServer.canvas_light_set_interpolated
#: doc/classes/RenderingServer.xml
msgid "If [param interpolated] is [code]true[/code], turns on physics interpolation for the canvas light."
msgstr "Ha az [param interpolated] értéke [code]true[/code], a vászonfény fizikai interpolációt használ."

#. RenderingServer.canvas_light_set_item_shadow_cull_mask
#: doc/classes/RenderingServer.xml
msgid "The binary mask used to determine which layers this canvas light's shadows affects. See [LightOccluder2D] for more information on light masks."
msgstr "A bitmaszk megadja, mely rétegekre hat a vászonfény árnyéka. A maszkokról a [LightOccluder2D] osztály leírásában olvashatsz."

#. RenderingServer.canvas_light_set_layer_range
#: doc/classes/RenderingServer.xml
msgid "The layer range that gets rendered with this light."
msgstr "A megvilágított vászonrétegek tartománya."

#. RenderingServer.canvas_light_set_mode
#: doc/classes/RenderingServer.xml
msgid "Sets the mode of the canvas light."
msgstr "Beállítja a vászonfény módját."

#. RenderingServer.canvas_light_set_shadow_color
#: doc/classes/RenderingServer.xml
msgid "Sets the color of the canvas light's shadow."
msgstr "Beállítja a vászonfény árnyékának színét."

#. RenderingServer.canvas_light_set_shadow_enabled
#: doc/classes/RenderingServer.xml
msgid "Enables or disables the canvas light's shadow."
msgstr "Engedélyezi vagy letiltja a vászonfény árnyékvetését."

#. RenderingServer.canvas_light_set_shadow_filter
#: doc/classes/RenderingServer.xml
msgid "Sets the canvas light's shadow's filter."
msgstr "Beállítja a vászonfény árnyékszűrését."

#. RenderingServer.canvas_light_set_shadow_smooth
#: doc/classes/RenderingServer.xml
msgid "Smoothens the shadow. The lower, the smoother."
msgstr "Módosítja az árnyékszűrő mintái közötti távolságot. Nagyobb értéknél a szűrő szélesebb tartományból vesz mintát."

#. RenderingServer.canvas_light_set_texture
#: doc/classes/RenderingServer.xml
msgid "Sets the texture to be used by a [PointLight2D]. Equivalent to [member PointLight2D.texture]."
msgstr "Beállítja a [PointLight2D] fényhez használt textúrát. A [member PointLight2D.texture] tulajdonságnak felel meg."

#. RenderingServer.canvas_light_set_texture_offset
#: doc/classes/RenderingServer.xml
msgid "Sets the offset of a [PointLight2D]'s texture. Equivalent to [member PointLight2D.offset]."
msgstr "Beállítja a [PointLight2D] fény textúrájának eltolását. A [member PointLight2D.offset] tulajdonságnak felel meg."

#. RenderingServer.canvas_light_set_texture_scale
#: doc/classes/RenderingServer.xml
msgid "Sets the scale factor of a [PointLight2D]'s texture. Equivalent to [member PointLight2D.texture_scale]."
msgstr "Beállítja a [PointLight2D] fény textúrájának méretezési tényezőjét. A [member PointLight2D.texture_scale] tulajdonságnak felel meg."

#. RenderingServer.canvas_light_set_transform
#: doc/classes/RenderingServer.xml
msgid "Sets the canvas light's [Transform2D]."
msgstr "Beállítja a vászonfény [Transform2D] transzformációját."

#. RenderingServer.canvas_light_set_z_range
#: doc/classes/RenderingServer.xml
msgid "Sets the Z range of objects that will be affected by this light. Equivalent to [member Light2D.range_z_min] and [member Light2D.range_z_max]."
msgstr "Beállítja, mely Z-indexek tartományában világítson meg objektumokat a fény. A [member Light2D.range_z_min] és a [member Light2D.range_z_max] tulajdonságnak felel meg."

#. RenderingServer.canvas_occluder_polygon_set_cull_mode
#: doc/classes/RenderingServer.xml
msgid "Sets an occluder polygon's cull mode."
msgstr "Beállítja a fénykitakaró sokszög oldal szerinti kiszűrési módját."

#. RenderingServer.canvas_occluder_polygon_set_shape
#: doc/classes/RenderingServer.xml
msgid "Sets the shape of the occluder polygon."
msgstr "Beállítja a fénykitakaró sokszög alakját."

#. RenderingServer.CANVAS_LIGHT_MODE_POINT
#: doc/classes/RenderingServer.xml
msgid "2D point light (see [PointLight2D])."
msgstr "2D-s pontfény. Lásd a [PointLight2D] osztályt."

#. RenderingServer.CANVAS_LIGHT_MODE_DIRECTIONAL
#: doc/classes/RenderingServer.xml
msgid "2D directional (sun/moon) light (see [DirectionalLight2D])."
msgstr "2D-s irányfény, például napfény vagy holdfény. Lásd a [DirectionalLight2D] osztályt."

#. RenderingServer.CANVAS_LIGHT_BLEND_MODE_ADD
#: doc/classes/RenderingServer.xml
msgid "Adds light color additive to the canvas."
msgstr "Hozzáadja a fény színét a vászon színéhez."

#. RenderingServer.CANVAS_LIGHT_BLEND_MODE_SUB
#: doc/classes/RenderingServer.xml
msgid "Adds light color subtractive to the canvas."
msgstr "Kivonja a fény színét a vászon színéből."

#. RenderingServer.CANVAS_LIGHT_BLEND_MODE_MIX
#: doc/classes/RenderingServer.xml
msgid "The light adds color depending on transparency."
msgstr "Az átlátszóság alapján keveri a fény színét a vászon színével."

#. RenderingServer.multimesh_get_aabb
#: doc/classes/RenderingServer.xml
msgid "Calculates and returns the axis-aligned bounding box that encloses all instances within the multimesh."
msgstr "Kiszámítja és visszaadja a MultiMesh összes példányát befoglaló, tengelyekhez igazított dobozt."

#. RenderingServer.multimesh_get_buffer_rd_rid
#: doc/classes/RenderingServer.xml
msgid "Returns the [RenderingDevice] [RID] handle of the [MultiMesh], which can be used as any other buffer on the Rendering Device."
msgstr "A [MultiMesh] pufferéhez tartozó [RenderingDevice] [RID] azonosítót adja vissza. A puffer a RenderingDevice más puffereihez hasonlóan használható."

#. RenderingServer.multimesh_get_custom_aabb
#: doc/classes/RenderingServer.xml
msgid "Returns the custom AABB defined for this MultiMesh resource."
msgstr "A MultiMesh erőforrás egyéni, tengelyekhez igazított befoglaló dobozát adja vissza."

#. RenderingServer.multimesh_get_instance_count
#: doc/classes/RenderingServer.xml
msgid "Returns the number of instances allocated for this multimesh."
msgstr "A MultiMesh számára lefoglalt példányok számát adja vissza."

#. RenderingServer.multimesh_get_mesh
#: doc/classes/RenderingServer.xml
msgid "Returns the RID of the mesh that will be used in drawing this multimesh."
msgstr "A MultiMesh kirajzolásához használt háló RID azonosítóját adja vissza."

#. RenderingServer.multimesh_get_visible_instances
#: doc/classes/RenderingServer.xml
msgid "Returns the number of visible instances for this multimesh."
msgstr "A MultiMesh látható példányainak számát megadó beállítást adja vissza."

#. RenderingServer.multimesh_instance_get_color
#: doc/classes/RenderingServer.xml
msgid "Returns the color by which the specified instance will be modulated."
msgstr "A megadott példány színmodulációjához használt színt adja vissza."

#. RenderingServer.multimesh_instance_get_custom_data
#: doc/classes/RenderingServer.xml
msgid "Returns the custom data associated with the specified instance."
msgstr "A megadott példányhoz tartozó egyéni adatokat adja vissza."

#. RenderingServer.multimesh_instance_get_transform
#: doc/classes/RenderingServer.xml
msgid "Returns the [Transform3D] of the specified instance."
msgstr "A megadott példány [Transform3D] transzformációját adja vissza."

#. RenderingServer.multimesh_instance_get_transform_2d
#: doc/classes/RenderingServer.xml
msgid "Returns the [Transform2D] of the specified instance. For use when the multimesh is set to use 2D transforms."
msgstr "A megadott példány [Transform2D] transzformációját adja vissza. Akkor használd, ha a MultiMesh 2D-s transzformációkat tárol."

#. RenderingServer.multimesh_instance_set_color
#: doc/classes/RenderingServer.xml
msgid "Sets the color by which this instance will be modulated. Equivalent to [method MultiMesh.set_instance_color]."
msgstr "Beállítja a példány színmodulációjához használt színt. A [method MultiMesh.set_instance_color] metódusnak felel meg."

#. RenderingServer.multimesh_instance_set_custom_data
#: doc/classes/RenderingServer.xml
msgid "Sets the custom data for this instance. Custom data is passed as a [Color], but is interpreted as a [code]vec4[/code] in the shader. Equivalent to [method MultiMesh.set_instance_custom_data]."
msgstr "Beállítja a példány egyéni adatait. Az adatokat [Color] értékként kell megadni, a shader azonban [code]vec4[/code] értékként értelmezi őket. A [method MultiMesh.set_instance_custom_data] metódusnak felel meg."

#. RenderingServer.multimesh_instance_set_transform
#: doc/classes/RenderingServer.xml
msgid "Sets the [Transform3D] for this instance. Equivalent to [method MultiMesh.set_instance_transform]."
msgstr "Beállítja a példány [Transform3D] transzformációját. A [method MultiMesh.set_instance_transform] metódusnak felel meg."

#. RenderingServer.multimesh_instance_set_transform_2d
#: doc/classes/RenderingServer.xml
msgid "Sets the [Transform2D] for this instance. For use when multimesh is used in 2D. Equivalent to [method MultiMesh.set_instance_transform_2d]."
msgstr "Beállítja a példány [Transform2D] transzformációját. 2D-s MultiMesh esetén használható. A [method MultiMesh.set_instance_transform_2d] metódusnak felel meg."

#. RenderingServer.multimesh_set_custom_aabb
#: doc/classes/RenderingServer.xml
msgid "Sets the custom AABB for this MultiMesh resource."
msgstr "Beállítja a MultiMesh erőforrás egyéni, tengelyekhez igazított befoglaló dobozát."

#. RenderingServer.multimesh_set_mesh
#: doc/classes/RenderingServer.xml
msgid "Sets the mesh to be drawn by the multimesh. Equivalent to [member MultiMesh.mesh]."
msgstr "Beállítja, melyik hálót rajzolja ki a MultiMesh. A [member MultiMesh.mesh] tulajdonságnak felel meg."

#. RenderingServer.multimesh_set_physics_interpolated
#: doc/classes/RenderingServer.xml
msgid "Turns on and off physics interpolation for this MultiMesh resource."
msgstr "Ki- vagy bekapcsolja a MultiMesh erőforrás fizikai interpolációját."

#. RenderingServer.multimesh_set_visible_instances
#: doc/classes/RenderingServer.xml
msgid "Sets the number of instances visible at a given time. If -1, all instances that have been allocated are drawn. Equivalent to [member MultiMesh.visible_instance_count]."
msgstr "Beállítja, egyszerre hány példány legyen látható. A -1 érték az összes lefoglalt példányt kirajzolja. A [member MultiMesh.visible_instance_count] tulajdonságnak felel meg."

#. RenderingServer.occluder_set_mesh
#: doc/classes/RenderingServer.xml
msgid "Sets the mesh data for the given occluder RID, which controls the shape of the occlusion culling that will be performed."
msgstr "Beállítja a megadott RID azonosítójú kitakaró hálóadatait. A háló alakja meghatározza a takarás alapú kiszűréshez használt felületet."

#. RenderingServer.particles_collision_set_attractor_attenuation
#: doc/classes/RenderingServer.xml
msgid "Sets the attenuation [param curve] for the 3D GPU particles attractor specified by the [param particles_collision] RID. Only used for attractors, not colliders. Equivalent to [member GPUParticlesAttractor3D.attenuation]."
msgstr "Beállítja a [param particles_collision] RID-del megadott 3D-s GPU-részecskevonzó csillapítási görbéjét meghatározó [param curve] értéket. Csak a vonzókra hat, az ütközőkre nem. A [member GPUParticlesAttractor3D.attenuation] tulajdonságnak felel meg."

#. RenderingServer.skeleton_allocate_data
#: doc/classes/RenderingServer.xml
msgid "Allocates data for this skeleton using the number of bones specified in [param bones]. If [param is_2d_skeleton] is [code]true[/code], the skeleton will be treated as a 2D skeleton instead of a 3D skeleton. See also [method skeleton_get_bone_count]."
msgstr "Helyet foglal a csontváz adatainak a [param bones] paraméterben megadott csontszám alapján. Ha az [param is_2d_skeleton] értéke [code]true[/code], a motor 2D-s csontvázként kezeli, egyébként 3D-sként. Lásd még a [method skeleton_get_bone_count] metódust."

#. RenderingServer.skeleton_bone_get_transform
#: doc/classes/RenderingServer.xml
msgid "Returns the [Transform3D] set for a specific bone of this skeleton."
msgstr "A csontváz megadott csontjához beállított [Transform3D] transzformációt adja vissza."

#. RenderingServer.skeleton_bone_get_transform_2d
#: doc/classes/RenderingServer.xml
msgid "Returns the [Transform2D] set for a specific bone of this skeleton."
msgstr "A csontváz megadott csontjához beállított [Transform2D] transzformációt adja vissza."

#. RenderingServer.skeleton_bone_set_transform
#: doc/classes/RenderingServer.xml
msgid "Sets the [Transform3D] for a specific bone of this skeleton."
msgstr "Beállítja a csontváz megadott csontjának [Transform3D] transzformációját."

#. RenderingServer.skeleton_bone_set_transform_2d
#: doc/classes/RenderingServer.xml
msgid "Sets the [Transform2D] for a specific bone of this skeleton."
msgstr "Beállítja a csontváz megadott csontjának [Transform2D] transzformációját."

#. RenderingServer.skeleton_get_bone_count
#: doc/classes/RenderingServer.xml
msgid "Returns the number of bones allocated for this skeleton. See also [method skeleton_allocate_data]."
msgstr "A csontváz számára lefoglalt csontok számát adja vissza. Lásd még a [method skeleton_allocate_data] metódust."

#. RenderingServer.skeleton_set_base_transform_2d
#: doc/classes/RenderingServer.xml
msgid "Sets the base [Transform2D] to use for the specified skeleton."
msgstr "Beállítja a megadott csontváz [Transform2D] alaptranszformációját."

#. RenderingServer.MULTIMESH_TRANSFORM_2D
#: doc/classes/RenderingServer.xml
msgid "Use [Transform2D] to store MultiMesh transform."
msgstr "A MultiMesh transzformációit [Transform2D] értékként tárolja."

#. RenderingServer.MULTIMESH_TRANSFORM_3D
#: doc/classes/RenderingServer.xml
msgid "Use [Transform3D] to store MultiMesh transform."
msgstr "A MultiMesh transzformációit [Transform3D] értékként tárolja."

#. RenderingServer.MULTIMESH_INTERP_QUALITY_FAST
#: doc/classes/RenderingServer.xml
msgid "MultiMesh physics interpolation favors speed over quality."
msgstr "A MultiMesh fizikai interpolációja a gyorsabb számítást részesíti előnyben."

#. RenderingServer.MULTIMESH_INTERP_QUALITY_HIGH
#: doc/classes/RenderingServer.xml
msgid "MultiMesh physics interpolation favors quality over speed."
msgstr "A MultiMesh fizikai interpolációja a minőséget részesíti előnyben a sebességgel szemben."

#. RenderingServer.PARTICLES_MODE_2D
#: doc/classes/RenderingServer.xml
msgid "2D particles."
msgstr "2D-s részecskék."

#. RenderingServer.PARTICLES_MODE_3D
#: doc/classes/RenderingServer.xml
msgid "3D particles."
msgstr "3D-s részecskék."

#. RenderingServer.PARTICLES_TRANSFORM_ALIGN_LOCAL_BILLBOARD
#: doc/classes/RenderingServer.xml
msgid "Billboard each particles around a local axis."
msgstr "A részecskéket egy helyi tengely körül a kamera felé fordítja."

#. RenderingServer.PARTICLES_ALIGN_CHANNEL_FILTER_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Do not read from CUSTOM when performing billboarding."
msgstr "A kamerához igazítás nem olvas szögértéket a CUSTOM változóból."

#. RenderingServer.PARTICLES_ALIGN_CHANNEL_FILTER_X
#: doc/classes/RenderingServer.xml
msgid "Read from [code]CUSTOM.x[/code] when performing billboarding and use it as an angle, in radians."
msgstr "A kamerához igazításhoz radiánban értelmezett szögként olvassa ki a [code]CUSTOM.x[/code] értékét."

#. RenderingServer.PARTICLES_ALIGN_CHANNEL_FILTER_Y
#: doc/classes/RenderingServer.xml
msgid "Read from [code]CUSTOM.y[/code] when performing billboarding and use it as an angle, in radians."
msgstr "A kamerához igazításhoz radiánban értelmezett szögként olvassa ki a [code]CUSTOM.y[/code] értékét."

#. RenderingServer.PARTICLES_ALIGN_CHANNEL_FILTER_Z
#: doc/classes/RenderingServer.xml
msgid "Read from [code]CUSTOM.z[/code] when performing billboarding and use it as an angle, in radians."
msgstr "A kamerához igazításhoz radiánban értelmezett szögként olvassa ki a [code]CUSTOM.z[/code] értékét."

#. RenderingServer.PARTICLES_ALIGN_CHANNEL_FILTER_W
#: doc/classes/RenderingServer.xml
msgid "Read from [code]CUSTOM.w[/code] when performing billboarding and use it as an angle, in radians."
msgstr "A kamerához igazításhoz radiánban értelmezett szögként olvassa ki a [code]CUSTOM.w[/code] értékét."

#. RenderingServer.PARTICLES_ALIGN_AXIS_X
#: doc/classes/RenderingServer.xml
msgid "Use the X axis for local billboarding."
msgstr "A helyi X tengely körül fordítja a részecskét a kamera felé."

#. RenderingServer.PARTICLES_ALIGN_AXIS_Y
#: doc/classes/RenderingServer.xml
msgid "Use the Y axis for local billboarding."
msgstr "A helyi Y tengely körül fordítja a részecskét a kamera felé."

#. RenderingServer.PARTICLES_DRAW_ORDER_INDEX
#: doc/classes/RenderingServer.xml
msgid "Draw particles in the order that they appear in the particles array."
msgstr "A részecskéket a tömbben elfoglalt helyük sorrendjében rajzolja ki."

#. RenderingServer.PARTICLES_DRAW_ORDER_LIFETIME
#: doc/classes/RenderingServer.xml
msgid "Sort particles based on their lifetime. In other words, the particle with the highest lifetime is drawn at the front."
msgstr "A részecskéket a hátralévő élettartamuk szerint rendezi. A legtöbb hátralévő idővel rendelkező részecske jelenik meg elöl."

#. RenderingServer.PARTICLES_DRAW_ORDER_REVERSE_LIFETIME
#: doc/classes/RenderingServer.xml
msgid "Sort particles based on the inverse of their lifetime. In other words, the particle with the lowest lifetime is drawn at the front."
msgstr "A részecskéket a hátralévő élettartamuk szerint fordított sorrendbe rendezi. A legkevesebb hátralévő idővel rendelkező részecske jelenik meg elöl."

#. RenderingServer.PARTICLES_DRAW_ORDER_VIEW_DEPTH
#: doc/classes/RenderingServer.xml
msgid "Sort particles based on their distance to the camera."
msgstr "A részecskéket a kamerához viszonyított nézettérbeli mélység szerint rendezi."

#. RenderingServer.PARTICLES_COLLISION_TYPE_SPHERE_ATTRACT
#: doc/classes/RenderingServer.xml
msgid "Sphere attractor type for [GPUParticles3D] (see [GPUParticlesAttractorSphere3D])."
msgstr "Gömb alakú vonzó a [GPUParticles3D] részecskéihez. Lásd a [GPUParticlesAttractorSphere3D] osztályt."

#. RenderingServer.PARTICLES_COLLISION_TYPE_BOX_ATTRACT
#: doc/classes/RenderingServer.xml
msgid "Box attractor type for [GPUParticles3D] (see [GPUParticlesAttractorBox3D])."
msgstr "Doboz alakú vonzó a [GPUParticles3D] részecskéihez. Lásd a [GPUParticlesAttractorBox3D] osztályt."

#. RenderingServer.PARTICLES_COLLISION_TYPE_VECTOR_FIELD_ATTRACT
#: doc/classes/RenderingServer.xml
msgid "Vector field attractor type for [GPUParticles3D] (see [GPUParticlesAttractorVectorField3D])."
msgstr "Vektormezővel megadott vonzó a [GPUParticles3D] részecskéihez. Lásd a [GPUParticlesAttractorVectorField3D] osztályt."

#. RenderingServer.PARTICLES_COLLISION_TYPE_SPHERE_COLLIDE
#: doc/classes/RenderingServer.xml
msgid "Sphere collision type for [GPUParticles3D] (see [GPUParticlesCollisionSphere3D])."
msgstr "Gömb alakú ütköző a [GPUParticles3D] részecskéihez. Lásd a [GPUParticlesCollisionSphere3D] osztályt."

#. RenderingServer.PARTICLES_COLLISION_TYPE_BOX_COLLIDE
#: doc/classes/RenderingServer.xml
msgid "Box collision type for [GPUParticles3D] (see [GPUParticlesCollisionBox3D])."
msgstr "Doboz alakú ütköző a [GPUParticles3D] részecskéihez. Lásd a [GPUParticlesCollisionBox3D] osztályt."

#. RenderingServer.CANVAS_ITEM_Z_MIN
#: doc/classes/RenderingServer.xml
msgid "The minimum Z-layer for canvas items."
msgstr "A vászonelemek legkisebb megengedett Z-indexe."

#. RenderingServer.CANVAS_ITEM_Z_MAX
#: doc/classes/RenderingServer.xml
msgid "The maximum Z-layer for canvas items."
msgstr "A vászonelemek legnagyobb megengedett Z-indexe."

#. RenderingServer.CANVAS_LAYER_MIN
#: doc/classes/RenderingServer.xml
msgid "The minimum canvas layer."
msgstr "A legkisebb megengedett vászonréteg-index."

#. RenderingServer.CANVAS_LAYER_MAX
#: doc/classes/RenderingServer.xml
msgid "The maximum canvas layer."
msgstr "A legnagyobb megengedett vászonréteg-index."

#. RenderingServer.VIEWPORT_SCALING_3D_MODE_BILINEAR
#: doc/classes/RenderingServer.xml
msgid "Use bilinear scaling for the viewport's 3D buffer. The amount of scaling can be set using [member Viewport.scaling_3d_scale]. Values less than [code]1.0[/code] will result in undersampling while values greater than [code]1.0[/code] will result in supersampling. A value of [code]1.0[/code] disables scaling."
msgstr "Bilineáris skálázást használ a nézetablak 3D-s pufferén. A méretarányt a [member Viewport.scaling_3d_scale] tulajdonság adja meg. [code]1.0[/code] alatti értéknél alulmintavételezést, [code]1.0[/code] fölött túlmintavételezést használ. A [code]1.0[/code] érték kikapcsolja a skálázást."

#. RenderingServer.VIEWPORT_SCALING_3D_MODE_FSR
#: doc/classes/RenderingServer.xml
msgid "Use AMD FidelityFX Super Resolution 1.0 upscaling for the viewport's 3D buffer. The amount of scaling can be set using [member Viewport.scaling_3d_scale]. Values less than [code]1.0[/code] will result in the viewport being upscaled using FSR. Values greater than [code]1.0[/code] are not supported and bilinear downsampling will be used instead. A value of [code]1.0[/code] disables scaling."
msgstr "Az AMD FidelityFX Super Resolution 1.0 eljárást használja a nézetablak 3D-s pufferének felskálázásához. A méretarányt a [member Viewport.scaling_3d_scale] tulajdonság adja meg. [code]1.0[/code] alatti értéknél az FSR skálázza fel a képet. [code]1.0[/code] fölött a renderelő bilineáris leskálázást használ. A [code]1.0[/code] érték kikapcsolja a skálázást."

#. RenderingServer.VIEWPORT_SCALING_3D_MODE_FSR2
#: doc/classes/RenderingServer.xml
msgid "Use AMD FidelityFX Super Resolution 2.2 upscaling for the viewport's 3D buffer. The amount of scaling can be set using [member Viewport.scaling_3d_scale]. Values less than [code]1.0[/code] will result in the viewport being upscaled using FSR2. Values greater than [code]1.0[/code] are not supported and bilinear downsampling will be used instead. A value of [code]1.0[/code] will use FSR2 at native resolution as a TAA solution."
msgstr "Az AMD FidelityFX Super Resolution 2.2 eljárást használja a nézetablak 3D-s pufferének felskálázásához. A méretarányt a [member Viewport.scaling_3d_scale] tulajdonság adja meg. [code]1.0[/code] alatti értéknél az FSR2 skálázza fel a képet. [code]1.0[/code] fölött a renderelő bilineáris leskálázást használ. A [code]1.0[/code] értéknél az FSR2 natív felbontáson, időbeli élsimításként működik."

#. RenderingServer.VIEWPORT_SCALING_3D_MODE_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum ViewportScaling3DMode] enum."
msgstr "A [enum ViewportScaling3DMode] felsorolás mérete."

#. RenderingServer.VIEWPORT_UPDATE_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Do not update the viewport's render target."
msgstr "A nézetablak renderelési célja nem frissül."

#. RenderingServer.VIEWPORT_UPDATE_ONCE
#: doc/classes/RenderingServer.xml
msgid "Update the viewport's render target once, then switch to [constant VIEWPORT_UPDATE_DISABLED]."
msgstr "Egyszer frissíti a nézetablak renderelési célját, majd [constant VIEWPORT_UPDATE_DISABLED] módra vált."

#. RenderingServer.VIEWPORT_UPDATE_WHEN_VISIBLE
#: doc/classes/RenderingServer.xml
msgid "Update the viewport's render target only when it is visible. This is the default value."
msgstr "A nézetablak renderelési célja csak akkor frissül, amikor látható. Ez az alapértelmezett beállítás."

#. RenderingServer.VIEWPORT_UPDATE_WHEN_PARENT_VISIBLE
#: doc/classes/RenderingServer.xml
msgid "Update the viewport's render target only when its parent is visible."
msgstr "A nézetablak renderelési célja csak akkor frissül, amikor a szülője látható."

#. RenderingServer.VIEWPORT_UPDATE_ALWAYS
#: doc/classes/RenderingServer.xml
msgid "Always update the viewport's render target."
msgstr "Mindig frissíti a nézetablak renderelési célját."

#. RenderingServer.VIEWPORT_CLEAR_ALWAYS
#: doc/classes/RenderingServer.xml
msgid "Always clear the viewport's render target before drawing."
msgstr "Minden rajzolás előtt törli a nézetablak renderelési célját."

#. RenderingServer.VIEWPORT_CLEAR_NEVER
#: doc/classes/RenderingServer.xml
msgid "Never clear the viewport's render target."
msgstr "A nézetablak renderelési célját nem törli."

#. RenderingServer.VIEWPORT_CLEAR_ONLY_NEXT_FRAME
#: doc/classes/RenderingServer.xml
msgid "Clear the viewport's render target on the next frame, then switch to [constant VIEWPORT_CLEAR_NEVER]."
msgstr "A következő képkockán törli a nézetablak renderelési célját, majd [constant VIEWPORT_CLEAR_NEVER] módra vált."

#. RenderingServer.VIEWPORT_ENVIRONMENT_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Disable rendering of 3D environment over 2D canvas."
msgstr "Kikapcsolja a 3D-s környezet renderelését a 2D-s vászon fölött."

#. RenderingServer.VIEWPORT_ENVIRONMENT_ENABLED
#: doc/classes/RenderingServer.xml
msgid "Enable rendering of 3D environment over 2D canvas."
msgstr "Bekapcsolja a 3D-s környezet renderelését a 2D-s vászon fölött."

#. RenderingServer.VIEWPORT_ENVIRONMENT_INHERIT
#: doc/classes/RenderingServer.xml
msgid "Inherit enable/disable value from parent. If the topmost parent is also set to [constant VIEWPORT_ENVIRONMENT_INHERIT], then this has the same behavior as [constant VIEWPORT_ENVIRONMENT_ENABLED]."
msgstr "A környezet megjelenítését a szülő beállításából örökli. Ha a legfelső szülő beállítása szintén [constant VIEWPORT_ENVIRONMENT_INHERIT], az eredmény megegyezik a [constant VIEWPORT_ENVIRONMENT_ENABLED] viselkedésével."

#. RenderingServer.VIEWPORT_ENVIRONMENT_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum ViewportEnvironmentMode] enum."
msgstr "A [enum ViewportEnvironmentMode] felsorolás mérete."

#. RenderingServer.VIEWPORT_MSAA_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Multisample antialiasing for 3D is disabled. This is the default value, and also the fastest setting."
msgstr "A többmintavételes élsimítás ki van kapcsolva 3D-ben. Ez az alapértelmezett és a leggyorsabb beállítás."

#. RenderingServer.VIEWPORT_MSAA_2X
#: doc/classes/RenderingServer.xml
msgid "Multisample antialiasing uses 2 samples per pixel for 3D. This has a moderate impact on performance."
msgstr "A többmintavételes élsimítás 3D-ben képpontonként 2 mintát használ. Ez mérsékelt teljesítményköltséggel jár."

#. RenderingServer.VIEWPORT_MSAA_4X
#: doc/classes/RenderingServer.xml
msgid "Multisample antialiasing uses 4 samples per pixel for 3D. This has a high impact on performance."
msgstr "A többmintavételes élsimítás 3D-ben képpontonként 4 mintát használ. Ez jelentős teljesítményköltséggel jár."

#. RenderingServer.VIEWPORT_MSAA_8X
#: doc/classes/RenderingServer.xml
msgid "Multisample antialiasing uses 8 samples per pixel for 3D. This has a very high impact on performance. Likely unsupported on low-end and older hardware."
msgstr "A többmintavételes élsimítás 3D-ben képpontonként 8 mintát használ. Ez nagyon jelentős teljesítményköltséggel jár. A régebbi vagy alacsonyabb teljesítményű eszközök valószínűleg nem támogatják."

#. RenderingServer.VIEWPORT_MSAA_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum ViewportMSAA] enum."
msgstr "A [enum ViewportMSAA] felsorolás mérete."

#. RenderingServer.VIEWPORT_SCREEN_SPACE_AA_FXAA
#: doc/classes/RenderingServer.xml
msgid "Use fast approximate antialiasing. FXAA is a popular screen-space antialiasing method, which is fast but will make the image look blurry, especially at lower resolutions. It can still work relatively well at large resolutions such as 1440p and 4K."
msgstr "Gyors közelítő élsimítást (FXAA) használ. Ez a képernyőtérbeli eljárás gyors, de elmoshatja a képet, különösen kisebb felbontáson. Nagyobb felbontáson, például 1440p vagy 4K mellett, viszonylag jó eredményt adhat."

#. RenderingServer.VIEWPORT_SCREEN_SPACE_AA_SMAA
#: doc/classes/RenderingServer.xml
msgid "Use subpixel morphological antialiasing. SMAA may produce clearer results than FXAA, but at a slightly higher performance cost."
msgstr "Szubpixeles morfológiai élsimítást (SMAA) használ. Valamivel nagyobb teljesítményköltség mellett élesebb képet adhat az FXAA-nál."

#. RenderingServer.VIEWPORT_SCREEN_SPACE_AA_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum ViewportScreenSpaceAA] enum."
msgstr "A [enum ViewportScreenSpaceAA] felsorolás mérete."

#. RenderingServer.VIEWPORT_RENDER_INFO_OBJECTS_IN_FRAME
#: doc/classes/RenderingServer.xml
msgid "Number of objects drawn in a single frame."
msgstr "Az egy képkockában kirajzolt objektumok száma."

#. RenderingServer.VIEWPORT_RENDER_INFO_PRIMITIVES_IN_FRAME
#: doc/classes/RenderingServer.xml
msgid "Number of points, lines, or triangles drawn in a single frame."
msgstr "Az egy képkockában kirajzolt pontok, vonalak vagy háromszögek száma."

#. RenderingServer.VIEWPORT_RENDER_INFO_DRAW_CALLS_IN_FRAME
#: doc/classes/RenderingServer.xml
msgid "Number of draw calls during this frame."
msgstr "Az adott képkockában végrehajtott rajzolási hívások száma."

#. RenderingServer.VIEWPORT_RENDER_INFO_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum ViewportRenderInfo] enum."
msgstr "A [enum ViewportRenderInfo] felsorolás mérete."

#. RenderingServer.CANVAS_TEXTURE_CHANNEL_DIFFUSE
#: doc/classes/RenderingServer.xml
msgid "Diffuse canvas texture ([member CanvasTexture.diffuse_texture])."
msgstr "A vászon alapszínét adó diffúz textúra ([member CanvasTexture.diffuse_texture])."

#. RenderingServer.CANVAS_TEXTURE_CHANNEL_NORMAL
#: doc/classes/RenderingServer.xml
msgid "Normal map canvas texture ([member CanvasTexture.normal_texture])."
msgstr "A vászon normáltérkép-textúrája ([member CanvasTexture.normal_texture])."

#. RenderingServer.CANVAS_TEXTURE_CHANNEL_SPECULAR
#: doc/classes/RenderingServer.xml
msgid "Specular map canvas texture ([member CanvasTexture.specular_texture])."
msgstr "A vászon tükrös visszaverődését szabályozó textúra ([member CanvasTexture.specular_texture])."

#. RenderingServer.CANVAS_ITEM_TEXTURE_FILTER_DEFAULT
#: doc/classes/RenderingServer.xml
msgid "Uses the default filter mode for this [Viewport]."
msgstr "Az adott [Viewport] alapértelmezett textúraszűrési módját használja."

#. RenderingServer.CANVAS_ITEM_TEXTURE_FILTER_MAX
#: doc/classes/RenderingServer.xml
msgid "Max value for [enum CanvasItemTextureFilter] enum."
msgstr "A [enum CanvasItemTextureFilter] felsorolás felső határát jelöli."

#. RenderingServer.CANVAS_ITEM_TEXTURE_REPEAT_DEFAULT
#: doc/classes/RenderingServer.xml
msgid "Uses the default repeat mode for this [Viewport]."
msgstr "Az adott [Viewport] alapértelmezett textúraismétlési módját használja."

#. RenderingServer.CANVAS_ITEM_TEXTURE_REPEAT_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Disables textures repeating. Instead, when reading UVs outside the 0-1 range, the value will be clamped to the edge of the texture, resulting in a stretched out look at the borders of the texture."
msgstr "Kikapcsolja a textúraismétlést. A 0 és 1 közötti UV-tartományon kívül a renderelő a textúra széléről vesz mintát, így a szélső képpontok elnyújtva jelenhetnek meg."

#. RenderingServer.CANVAS_ITEM_TEXTURE_REPEAT_MAX
#: doc/classes/RenderingServer.xml
msgid "Max value for [enum CanvasItemTextureRepeat] enum."
msgstr "A [enum CanvasItemTextureRepeat] felsorolás felső határát jelöli."

#. RenderingServer.CANVAS_GROUP_MODE_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Child draws over parent and is not clipped."
msgstr "A gyerekelem vágás nélkül, a szülőelem fölött jelenik meg."

#. RenderingServer.CANVAS_GROUP_MODE_CLIP_ONLY
#: doc/classes/RenderingServer.xml
msgid "Parent is used for the purposes of clipping only. Child is clipped to the parent's visible area, parent is not drawn."
msgstr "A szülőelem csak a vágás határát adja meg. A gyerekelem a szülő látható területén belül jelenik meg, a szülőt a renderelő kihagyja."

#. RenderingServer.CANVAS_GROUP_MODE_CLIP_AND_DRAW
#: doc/classes/RenderingServer.xml
msgid "Parent is used for clipping child, but parent is also drawn underneath child as normal before clipping child to its visible area."
msgstr "A renderelő kirajzolja a szülőelemet, majd fölé rajzolja a gyerekelemet, a szülő látható területére vágva."

#. RenderingServer.CANVAS_LIGHT_FILTER_NONE
#: doc/classes/RenderingServer.xml
msgid "Do not apply a filter to canvas light shadows."
msgstr "A vászonfény árnyékát szűrés nélkül jeleníti meg."

#. RenderingServer.CANVAS_LIGHT_FILTER_PCF5
#: doc/classes/RenderingServer.xml
msgid "Use PCF5 filtering to filter canvas light shadows."
msgstr "PCF5 szűrést alkalmaz a vászonfény árnyékára."

#. RenderingServer.CANVAS_LIGHT_FILTER_PCF13
#: doc/classes/RenderingServer.xml
msgid "Use PCF13 filtering to filter canvas light shadows."
msgstr "PCF13 szűrést alkalmaz a vászonfény árnyékára."

#. RenderingServer.CANVAS_LIGHT_FILTER_MAX
#: doc/classes/RenderingServer.xml
msgid "Max value of the [enum CanvasLightShadowFilter] enum."
msgstr "A [enum CanvasLightShadowFilter] felsorolás felső határát jelöli."

#. RenderingServer.CANVAS_OCCLUDER_POLYGON_CULL_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Culling of the canvas occluder is disabled."
msgstr "A vászon fénykitakarójánál ki van kapcsolva az oldal szerinti kiszűrés."

#. RenderingServer.CANVAS_OCCLUDER_POLYGON_CULL_CLOCKWISE
#: doc/classes/RenderingServer.xml
msgid "Culling of the canvas occluder is clockwise."
msgstr "Az óramutató járásával megegyező körüljárás szerint szűri ki a vászon fénykitakaróját."

#. RenderingServer.CANVAS_OCCLUDER_POLYGON_CULL_COUNTER_CLOCKWISE
#: doc/classes/RenderingServer.xml
msgid "Culling of the canvas occluder is counterclockwise."
msgstr "Az óramutató járásával ellentétes körüljárás szerint szűri ki a vászon fénykitakaróját."

#. RenderingServer.LIGHT_DIRECTIONAL
#: doc/classes/RenderingServer.xml
msgid "Directional (sun/moon) light (see [DirectionalLight3D])."
msgstr "Irányfény, például napfény vagy holdfény. Lásd a [DirectionalLight3D] osztályt."

#. RenderingServer.LIGHT_OMNI
#: doc/classes/RenderingServer.xml
msgid "Omni light (see [OmniLight3D])."
msgstr "Minden irányba sugárzó pontfény. Lásd az [OmniLight3D] osztályt."

#. RenderingServer.LIGHT_SPOT
#: doc/classes/RenderingServer.xml
msgid "Spot light (see [SpotLight3D])."
msgstr "Spotfény. Lásd a [SpotLight3D] osztályt."

#. RenderingServer.LIGHT_AREA
#: doc/classes/RenderingServer.xml
msgid "Area light (see [AreaLight3D])."
msgstr "Területi fény. Lásd az [AreaLight3D] osztályt."

#. RenderingServer.LIGHT_PARAM_ENERGY
#: doc/classes/RenderingServer.xml
msgid "The light's energy multiplier."
msgstr "A fény energiájának szorzója."

#. RenderingServer.LIGHT_PARAM_INDIRECT_ENERGY
#: doc/classes/RenderingServer.xml
msgid "The light's indirect energy multiplier (final indirect energy is [constant LIGHT_PARAM_ENERGY] * [constant LIGHT_PARAM_INDIRECT_ENERGY])."
msgstr "A közvetett megvilágítás energiaszorzója. A közvetett fény végső energiája a [constant LIGHT_PARAM_ENERGY] és a [constant LIGHT_PARAM_INDIRECT_ENERGY] szorzata."

#. RenderingServer.LIGHT_PARAM_VOLUMETRIC_FOG_ENERGY
#: doc/classes/RenderingServer.xml
msgid "The light's volumetric fog energy multiplier (final volumetric fog energy is [constant LIGHT_PARAM_ENERGY] * [constant LIGHT_PARAM_VOLUMETRIC_FOG_ENERGY])."
msgstr "A térfogati ködre ható fény energiaszorzója. A ködre ható végső energia a [constant LIGHT_PARAM_ENERGY] és a [constant LIGHT_PARAM_VOLUMETRIC_FOG_ENERGY] szorzata."

#. RenderingServer.LIGHT_PARAM_SPECULAR
#: doc/classes/RenderingServer.xml
msgid "The light's influence on specularity."
msgstr "A fény hatása a tükrös visszaverődés erősségére."

#. RenderingServer.LIGHT_PARAM_RANGE
#: doc/classes/RenderingServer.xml
msgid "The light's range."
msgstr "A fény hatótávolsága."

#. RenderingServer.LIGHT_PARAM_SIZE
#: doc/classes/RenderingServer.xml
msgid "The size of the light when using spot light or omni light. The angular size of the light when using directional light."
msgstr "Spotfénynél és minden irányba sugárzó pontfénynél a fényforrás mérete. Irányfénynél a fényforrás szögmérete."

#. RenderingServer.LIGHT_PARAM_ATTENUATION
#: doc/classes/RenderingServer.xml
msgid "The light's attenuation."
msgstr "A fény csillapítása."

#. RenderingServer.LIGHT_PARAM_SPOT_ANGLE
#: doc/classes/RenderingServer.xml
msgid "The spotlight's angle."
msgstr "A spotfény szöge."

#. RenderingServer.LIGHT_PARAM_SPOT_ATTENUATION
#: doc/classes/RenderingServer.xml
msgid "The spotlight's attenuation."
msgstr "A spotfény szög szerinti csillapítása."

#. RenderingServer.LIGHT_PARAM_SHADOW_FADE_START
#: doc/classes/RenderingServer.xml
msgid "Proportion of shadow max distance where the shadow will start to fade out."
msgstr "A maximális árnyéktávolság azon hányada, ahol az árnyék halványulni kezd."

#. RenderingServer.LIGHT_PARAM_SHADOW_NORMAL_BIAS
#: doc/classes/RenderingServer.xml
msgid "Normal bias used to offset shadow lookup by object normal. Can be used to fix self-shadowing artifacts."
msgstr "A felület normálvektora mentén eltolja az árnyékmintavétel helyét. Ezzel csökkenthetők az önárnyékolási hibák."

#. RenderingServer.LIGHT_PARAM_SHADOW_BIAS
#: doc/classes/RenderingServer.xml
msgid "Bias for the shadow lookup to fix self-shadowing artifacts."
msgstr "Az árnyékmintavétel eltolása, amely csökkentheti az önárnyékolási hibákat."

#. RenderingServer.LIGHT_PARAM_SHADOW_OPACITY
#: doc/classes/RenderingServer.xml
msgid "The light's shadow opacity. Values lower than [code]1.0[/code] make the light appear through shadows. This can be used to fake global illumination at a low performance cost."
msgstr "A fény által vetett árnyék fedettsége. [code]1.0[/code] alatti értéknél az árnyékon át is érvényesül a fény. Ezzel kis teljesítményköltséggel utánozható a globális megvilágítás hatása."

#. RenderingServer.LIGHT_PARAM_SHADOW_BLUR
#: doc/classes/RenderingServer.xml
msgid "Blurs the edges of the shadow. Can be used to hide pixel artifacts in low resolution shadow maps. A high value can make shadows appear grainy and can cause other unwanted artifacts. Try to keep as near default as possible."
msgstr "Elmosódottabbá teszi az árnyék széleit, így elfedheti a kis felbontású árnyéktérképek képponthibáit. A túl nagy érték szemcsés árnyékot és más képhibákat okozhat. Érdemes az alapérték közelében maradni."

#. RenderingServer.LIGHT_PARAM_INTENSITY
#: doc/classes/RenderingServer.xml
msgid "Constant representing the intensity of the light, measured in Lumens when dealing with a [SpotLight3D] or [OmniLight3D], or measured in Lux with a [DirectionalLight3D]. Only used when [member ProjectSettings.rendering/lights_and_shadows/use_physical_light_units] is [code]true[/code]."
msgstr "A fény intenzitása. A [SpotLight3D] és az [OmniLight3D] esetén lumenben, a [DirectionalLight3D] esetén luxban értendő. Csak akkor használatos, ha a [member ProjectSettings.rendering/lights_and_shadows/use_physical_light_units] értéke [code]true[/code]."

#. RenderingServer.LIGHT_PARAM_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum LightParam] enum."
msgstr "A [enum LightParam] felsorolás mérete."

#. RenderingServer.LIGHT_OMNI_SHADOW_DUAL_PARABOLOID
#: doc/classes/RenderingServer.xml
msgid "Use a dual paraboloid shadow map for omni lights."
msgstr "Kettős paraboloid árnyéktérképet használ a minden irányba sugárzó pontfényekhez."

#. RenderingServer.LIGHT_OMNI_SHADOW_CUBE
#: doc/classes/RenderingServer.xml
msgid "Use a cubemap shadow map for omni lights. Slower but better quality than dual paraboloid."
msgstr "Kockatérképes árnyéktérképet használ a minden irányba sugárzó pontfényekhez. Lassabb a kettős paraboloidnál, de jobb minőségű árnyékot ad."

#. RenderingServer.LIGHT_DIRECTIONAL_SHADOW_ORTHOGONAL
#: doc/classes/RenderingServer.xml
msgid "Use orthogonal shadow projection for directional light."
msgstr "Az irányfény árnyékait ortografikus vetítéssel számítja ki."

#. RenderingServer.LIGHT_DIRECTIONAL_SHADOW_PARALLEL_2_SPLITS
#: doc/classes/RenderingServer.xml
msgid "Use 2 splits for shadow projection when using directional light."
msgstr "Az irányfény árnyékait 2 kaszkádra osztva vetíti."

#. RenderingServer.LIGHT_DIRECTIONAL_SHADOW_PARALLEL_4_SPLITS
#: doc/classes/RenderingServer.xml
msgid "Use 4 splits for shadow projection when using directional light."
msgstr "Az irányfény árnyékait 4 kaszkádra osztva vetíti."

#. RenderingServer.LIGHT_DIRECTIONAL_SKY_MODE_LIGHT_AND_SKY
#: doc/classes/RenderingServer.xml
msgid "Use DirectionalLight3D in both sky rendering and scene lighting."
msgstr "A DirectionalLight3D az égbolt renderelésére és a jelenet megvilágítására is hat."

#. RenderingServer.LIGHT_DIRECTIONAL_SKY_MODE_LIGHT_ONLY
#: doc/classes/RenderingServer.xml
msgid "Only use DirectionalLight3D in scene lighting."
msgstr "A DirectionalLight3D csak a jelenet megvilágítására hat."

#. RenderingServer.LIGHT_DIRECTIONAL_SKY_MODE_SKY_ONLY
#: doc/classes/RenderingServer.xml
msgid "Only use DirectionalLight3D in sky rendering."
msgstr "A DirectionalLight3D csak az égbolt renderelésére hat."

#. RenderingServer.ENV_BG_CLEAR_COLOR
#: doc/classes/RenderingServer.xml
msgid "Use the clear color as background."
msgstr "A törlési színt használja háttérként."

#. RenderingServer.ENV_BG_COLOR
#: doc/classes/RenderingServer.xml
msgid "Use a specified color as the background."
msgstr "A megadott színt használja háttérként."

#. RenderingServer.ENV_BG_SKY
#: doc/classes/RenderingServer.xml
msgid "Use a sky resource for the background."
msgstr "Égbolt-erőforrást használ háttérként."

#. RenderingServer.ENV_BG_CANVAS
#: doc/classes/RenderingServer.xml
msgid "Use a specified canvas layer as the background. This can be useful for instantiating a 2D scene in a 3D world."
msgstr "A megadott vászonréteget használja háttérként. Így például 2D-s jelenetet helyezhetsz egy 3D-s világba."

#. RenderingServer.ENV_BG_KEEP
#: doc/classes/RenderingServer.xml
msgid "Do not clear the background, use whatever was rendered last frame as the background."
msgstr "A háttér törlését kihagyja, és az előző képkocka kirajzolt képét használja háttérként."

#. RenderingServer.ENV_BG_CAMERA_FEED
#: doc/classes/RenderingServer.xml
msgid "Displays a camera feed in the background."
msgstr "Élő kameraképet jelenít meg a háttérben."

#. RenderingServer.ENV_BG_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum EnvironmentBG] enum."
msgstr "A [enum EnvironmentBG] felsorolás mérete."

#. RenderingServer.ENV_AMBIENT_SOURCE_BG
#: doc/classes/RenderingServer.xml
msgid "Gather ambient light from whichever source is specified as the background."
msgstr "A környezeti fényt a háttérként kiválasztott forrásból veszi."

#. RenderingServer.ENV_AMBIENT_SOURCE_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Disable ambient light."
msgstr "Kikapcsolja a környezeti megvilágítást."

#. RenderingServer.ENV_AMBIENT_SOURCE_COLOR
#: doc/classes/RenderingServer.xml
msgid "Specify a specific [Color] for ambient light."
msgstr "A megadott [Color] értéket használja a környezeti megvilágításhoz."

#. RenderingServer.ENV_AMBIENT_SOURCE_SKY
#: doc/classes/RenderingServer.xml
msgid "Gather ambient light from the [Sky] regardless of what the background is."
msgstr "A háttér beállításától függetlenül a [Sky] erőforrásból veszi a környezeti fényt."

#. RenderingServer.ENV_REFLECTION_SOURCE_BG
#: doc/classes/RenderingServer.xml
msgid "Use the background for reflections."
msgstr "A hátteret használja a tükröződések forrásaként."

#. RenderingServer.ENV_REFLECTION_SOURCE_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Disable reflections."
msgstr "Kikapcsolja a tükröződéseket."

#. RenderingServer.ENV_REFLECTION_SOURCE_SKY
#: doc/classes/RenderingServer.xml
msgid "Use the [Sky] for reflections regardless of what the background is."
msgstr "A háttér beállításától függetlenül a [Sky] erőforrást használja a tükröződésekhez."

#. RenderingServer.ENV_FOG_MODE_EXPONENTIAL
#: doc/classes/RenderingServer.xml
msgid "Use a physically-based fog model defined primarily by fog density."
msgstr "Fizikai alapú ködmodellt használ, amelyet elsősorban a ködsűrűség határoz meg."

#. RenderingServer.ENV_FOG_MODE_DEPTH
#: doc/classes/RenderingServer.xml
msgid "Use a simple fog model defined by start and end positions and a custom curve. While not physically accurate, this model can be useful when you need more artistic control."
msgstr "Egyszerű ködmodellt használ, két határponttal és egyéni görbével. Akkor hasznos, ha a fizikai pontosság helyett a köd megjelenését szeretnéd közvetlenül szabályozni."

#. RenderingServer.SHADOW_CASTING_SETTING_OFF
#: doc/classes/RenderingServer.xml
msgid "Disable shadows from this instance."
msgstr "Kikapcsolja a példány árnyékvetését."

#. RenderingServer.SHADOW_CASTING_SETTING_ON
#: doc/classes/RenderingServer.xml
msgid "Cast shadows from this instance."
msgstr "A példány árnyékot vet."

#. RenderingServer.SHADOW_CASTING_SETTING_DOUBLE_SIDED
#: doc/classes/RenderingServer.xml
msgid "Disable backface culling when rendering the shadow of the object. This is slightly slower but may result in more correct shadows."
msgstr "A példány árnyékának renderelésekor a hátsó lapokat is figyelembe veszi. Ez valamivel lassabb, de pontosabb árnyékot eredményezhet."

#. RenderingServer.SHADOW_CASTING_SETTING_SHADOWS_ONLY
#: doc/classes/RenderingServer.xml
msgid "Only render the shadows from the object. The object itself will not be drawn."
msgstr "Csak az objektum árnyékát rajzolja ki. Maga az objektum nem látható."

#. RenderingServer.ENV_TONE_MAPPER_LINEAR
#: doc/classes/RenderingServer.xml
msgid "Does not modify color data, resulting in a linear tonemapping curve which unnaturally clips bright values, causing bright lighting to look blown out. The simplest and fastest tonemapper."
msgstr "Lineáris tónusleképezést használ, ezért a színadatok nem változnak. A világos értékek levágása miatt az erős megvilágítás túlexponáltnak látszhat. Ez a legegyszerűbb és leggyorsabb tónusleképezési mód."

#. RenderingServer.ENV_TONE_MAPPER_AGX
#: doc/classes/RenderingServer.xml
msgid "Uses an adjustable film-like tonemapping curve and desaturates bright values for a more realistic appearance. Better than other tonemappers at maintaining the hue of colors as they become brighter. The slowest tonemapping option."
msgstr "Állítható, filmszerű tónusgörbét használ, és csökkenti a világos színek telítettségét. A színek világosodásakor a többi módnál jobban megőrzi az árnyalatukat. Ez a leglassabb tónusleképezési mód."

#. RenderingServer.VIEWPORT_SDF_OVERSIZE_120_PERCENT
#: doc/classes/RenderingServer.xml
msgid "2D signed distance field covers 20% of the viewport's size outside the viewport on each side (top, right, bottom, left)."
msgstr "A 2D-s előjeles távolságmező mind a négy oldalon a nézetablak méretének 20%-ával nyúlik túl a nézetablakon."

#. RenderingServer.VIEWPORT_SDF_OVERSIZE_150_PERCENT
#: doc/classes/RenderingServer.xml
msgid "2D signed distance field covers 50% of the viewport's size outside the viewport on each side (top, right, bottom, left)."
msgstr "A 2D-s előjeles távolságmező mind a négy oldalon a nézetablak méretének 50%-ával nyúlik túl a nézetablakon."

#. RenderingServer.VIEWPORT_SDF_OVERSIZE_200_PERCENT
#: doc/classes/RenderingServer.xml
msgid "2D signed distance field covers 100% of the viewport's size outside the viewport on each side (top, right, bottom, left). This has the highest GPU requirements."
msgstr "A 2D-s előjeles távolságmező mind a négy oldalon a nézetablak méretének 100%-ával nyúlik túl a nézetablakon. Ez igényli a legtöbb GPU-erőforrást."

#. RenderingServer.VIEWPORT_SDF_SCALE_100_PERCENT
#: doc/classes/RenderingServer.xml
msgid "Full resolution 2D signed distance field scale. This has the highest GPU requirements."
msgstr "A 2D-s előjeles távolságmező teljes felbontású. Ez igényli a legtöbb GPU-erőforrást."

#. RenderingServer.VIEWPORT_SDF_SCALE_50_PERCENT
#: doc/classes/RenderingServer.xml
msgid "Half resolution 2D signed distance field scale on each axis (25% of the viewport pixel count)."
msgstr "A 2D-s előjeles távolságmező felbontása tengelyenként feleződik, így a mező képpontjainak száma a nézetablak képpontszámának 25%-a."

#. RenderingServer.VIEWPORT_SDF_SCALE_25_PERCENT
#: doc/classes/RenderingServer.xml
msgid "Quarter resolution 2D signed distance field scale on each axis (6.25% of the viewport pixel count). This has the lowest GPU requirements."
msgstr "A 2D-s előjeles távolságmező felbontása tengelyenként negyedére csökken, így a mező képpontjainak száma a nézetablak képpontszámának 6,25%-a. Ez igényli a legkevesebb GPU-erőforrást."

#. RenderingServer.VIEWPORT_OCCLUSION_BUILD_QUALITY_LOW
#: doc/classes/RenderingServer.xml
msgid "Low occlusion culling BVH build quality (as defined by Embree). Results in the lowest CPU usage, but least effective culling."
msgstr "Alacsony minőségben építi fel a takarásalapú láthatósági szűréshez használt BVH-t az Embree beállítása szerint. A CPU terhelése így a legkisebb, de a szűrés kevésbé hatékony."

#. RenderingServer.VIEWPORT_OCCLUSION_BUILD_QUALITY_MEDIUM
#: doc/classes/RenderingServer.xml
msgid "Medium occlusion culling BVH build quality (as defined by Embree)."
msgstr "Közepes minőségben építi fel a takarásalapú láthatósági szűréshez használt BVH-t az Embree beállítása szerint."

#. RenderingServer.VIEWPORT_OCCLUSION_BUILD_QUALITY_HIGH
#: doc/classes/RenderingServer.xml
msgid "High occlusion culling BVH build quality (as defined by Embree). Results in the highest CPU usage, but most effective culling."
msgstr "Magas minőségben építi fel a takarásalapú láthatósági szűréshez használt BVH-t az Embree beállítása szerint. A CPU terhelése így a legnagyobb, a szűrés pedig a leghatékonyabb."

#. RenderingServer.VIEWPORT_VRS_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Variable rate shading is disabled."
msgstr "A változó árnyalási ráta ki van kapcsolva."

#. RenderingServer.VIEWPORT_VRS_TEXTURE
#: doc/classes/RenderingServer.xml
msgid "Variable rate shading uses a texture. Note, for stereoscopic use a texture atlas with a texture for each view."
msgstr "A változó árnyalási rátát egy textúra határozza meg. Sztereó rendereléshez olyan textúraatlaszt használj, amely minden nézethez tartalmaz egy textúrát."

#. RenderingServer.VIEWPORT_VRS_XR
#: doc/classes/RenderingServer.xml
msgid "Variable rate shading texture is supplied by the primary [XRInterface]. Note that this may override the update mode."
msgstr "A változó árnyalási rátához használt textúrát az elsődleges [XRInterface] adja. Ez felülírhatja a frissítési módot."

#. RenderingServer.VIEWPORT_VRS_UPDATE_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum ViewportVRSUpdateMode] enum."
msgstr "A [enum ViewportVRSUpdateMode] felsorolás mérete."

#. RenderingServer.ENV_SSR_ROUGHNESS_QUALITY_DISABLED
#: doc/classes/RenderingServer.xml
msgid "Lowest quality of roughness filter for screen-space reflections. Rough materials will not have blurrier screen-space reflections compared to smooth (non-rough) materials. This is the fastest option."
msgstr "A képernyőtérbeli tükröződések érdesség szerinti szűrésének legalacsonyabb minősége. Az érdes felületek tükröződése ugyanolyan éles marad, mint a sima felületeké. Ez a leggyorsabb beállítás."

#. RenderingServer.ENV_SSR_ROUGHNESS_QUALITY_LOW
#: doc/classes/RenderingServer.xml
msgid "Low quality of roughness filter for screen-space reflections."
msgstr "A képernyőtérbeli tükröződések érdesség szerinti szűrésének alacsony minősége."

#. RenderingServer.ENV_SSR_ROUGHNESS_QUALITY_MEDIUM
#: doc/classes/RenderingServer.xml
msgid "Medium quality of roughness filter for screen-space reflections."
msgstr "A képernyőtérbeli tükröződések érdesség szerinti szűrésének közepes minősége."

#. RenderingServer.ENV_SSR_ROUGHNESS_QUALITY_HIGH
#: doc/classes/RenderingServer.xml
msgid "High quality of roughness filter for screen-space reflections. This is the slowest option."
msgstr "A képernyőtérbeli tükröződések érdesség szerinti szűrésének magas minősége. Ez a leglassabb beállítás."

#. RenderingServer.ENV_SSAO_QUALITY_VERY_LOW
#: doc/classes/RenderingServer.xml
msgid "Lowest quality of screen-space ambient occlusion."
msgstr "A képernyőtérbeli környezeti takarás legalacsonyabb minősége."

#. RenderingServer.ENV_SSAO_QUALITY_LOW
#: doc/classes/RenderingServer.xml
msgid "Low quality screen-space ambient occlusion."
msgstr "A képernyőtérbeli környezeti takarás alacsony minősége."

#. RenderingServer.ENV_SSAO_QUALITY_MEDIUM
#: doc/classes/RenderingServer.xml
msgid "Medium quality screen-space ambient occlusion."
msgstr "A képernyőtérbeli környezeti takarás közepes minősége."

#. RenderingServer.ENV_SSAO_QUALITY_HIGH
#: doc/classes/RenderingServer.xml
msgid "High quality screen-space ambient occlusion."
msgstr "A képernyőtérbeli környezeti takarás magas minősége."

#. RenderingServer.ENV_SSAO_QUALITY_ULTRA
#: doc/classes/RenderingServer.xml
msgid "Highest quality screen-space ambient occlusion. Uses the adaptive target setting which can be dynamically adjusted to smoothly balance performance and visual quality."
msgstr "A képernyőtérbeli környezeti takarás legmagasabb minősége. Az adaptív célérték futás közben is módosítható, így fokozatosan hangolható a teljesítmény és a képminőség egyensúlya."

#. RenderingServer.ENV_SSIL_QUALITY_VERY_LOW
#: doc/classes/RenderingServer.xml
msgid "Lowest quality of screen-space indirect lighting."
msgstr "A képernyőtérbeli közvetett megvilágítás legalacsonyabb minősége."

#. RenderingServer.ENV_SSIL_QUALITY_LOW
#: doc/classes/RenderingServer.xml
msgid "Low quality screen-space indirect lighting."
msgstr "A képernyőtérbeli közvetett megvilágítás alacsony minősége."

#. RenderingServer.ENV_SSIL_QUALITY_HIGH
#: doc/classes/RenderingServer.xml
msgid "High quality screen-space indirect lighting."
msgstr "A képernyőtérbeli közvetett megvilágítás magas minősége."

#. RenderingServer.ENV_SSIL_QUALITY_ULTRA
#: doc/classes/RenderingServer.xml
msgid "Highest quality screen-space indirect lighting. Uses the adaptive target setting which can be dynamically adjusted to smoothly balance performance and visual quality."
msgstr "A képernyőtérbeli közvetett megvilágítás legmagasabb minősége. Az adaptív célérték futás közben is módosítható, így fokozatosan hangolható a teljesítmény és a képminőség egyensúlya."

#. RenderingServer.ENV_SDFGI_Y_SCALE_50_PERCENT
#: doc/classes/RenderingServer.xml
msgid "Use 50% scale for SDFGI on the Y (vertical) axis. SDFGI cells will be twice as short as they are wide. This allows providing increased GI detail and reduced light leaking with thin floors and ceilings. This is usually the best choice for scenes that don't feature much verticality."
msgstr "Az SDFGI függőleges méretaránya az Y tengelyen 50%. A cellák fele olyan magasak, mint amilyen szélesek. Így részletesebb lehet a globális megvilágítás, és vékony padlókon vagy mennyezeteken kevesebb fény szivároghat át. Általában kis magasságkülönbségű jelenetekhez érdemes választani."

#. RenderingServer.ENV_SDFGI_Y_SCALE_75_PERCENT
#: doc/classes/RenderingServer.xml
msgid "Use 75% scale for SDFGI on the Y (vertical) axis. This is a balance between the 50% and 100% SDFGI Y scales."
msgstr "Az SDFGI függőleges méretaránya az Y tengelyen 75%. Ez köztes érték az 50%-os és a 100%-os függőleges méretarány között."

#. RenderingServer.ENV_SDFGI_Y_SCALE_100_PERCENT
#: doc/classes/RenderingServer.xml
msgid "Use 100% scale for SDFGI on the Y (vertical) axis. SDFGI cells will be as tall as they are wide. This is usually the best choice for highly vertical scenes. The downside is that light leaking may become more noticeable with thin floors and ceilings."
msgstr "Az SDFGI függőleges méretaránya az Y tengelyen 100%. A cellák ugyanolyan magasak, mint amilyen szélesek. Ez általában nagy magasságkülönbségű jelenetekhez illik. Vékony padlókon vagy mennyezeteken azonban feltűnőbb lehet az átszivárgó fény."

#. RenderingServer.ENV_SDFGI_RAY_COUNT_4
#: doc/classes/RenderingServer.xml
msgid "Throw 4 rays per frame when converging SDFGI. This has the lowest GPU requirements, but creates the most noisy result."
msgstr "Az SDFGI képkockánként 4 sugarat használ a megvilágítás finomításához. Ez terheli a legkevésbé a GPU-t, de a kép ennél a beállításnál a legzajosabb."

#. RenderingServer.ENV_SDFGI_RAY_COUNT_8
#: doc/classes/RenderingServer.xml
msgid "Throw 8 rays per frame when converging SDFGI."
msgstr "Az SDFGI képkockánként 8 sugarat használ a megvilágítás finomításához."

#. RenderingServer.ENV_SDFGI_RAY_COUNT_16
#: doc/classes/RenderingServer.xml
msgid "Throw 16 rays per frame when converging SDFGI."
msgstr "Az SDFGI képkockánként 16 sugarat használ a megvilágítás finomításához."

#. RenderingServer.ENV_SDFGI_RAY_COUNT_32
#: doc/classes/RenderingServer.xml
msgid "Throw 32 rays per frame when converging SDFGI."
msgstr "Az SDFGI képkockánként 32 sugarat használ a megvilágítás finomításához."

#. RenderingServer.ENV_SDFGI_RAY_COUNT_64
#: doc/classes/RenderingServer.xml
msgid "Throw 64 rays per frame when converging SDFGI."
msgstr "Az SDFGI képkockánként 64 sugarat használ a megvilágítás finomításához."

#. RenderingServer.ENV_SDFGI_RAY_COUNT_96
#: doc/classes/RenderingServer.xml
msgid "Throw 96 rays per frame when converging SDFGI. This has high GPU requirements."
msgstr "Az SDFGI képkockánként 96 sugarat használ a megvilágítás finomításához. Ez jelentősen terheli a GPU-t."

#. RenderingServer.ENV_SDFGI_RAY_COUNT_128
#: doc/classes/RenderingServer.xml
msgid "Throw 128 rays per frame when converging SDFGI. This has very high GPU requirements, but creates the least noisy result."
msgstr "Az SDFGI képkockánként 128 sugarat használ a megvilágítás finomításához. Ez nagyon megterheli a GPU-t, de így a legkevésbé zajos a kép."

#. RenderingServer.ENV_SDFGI_RAY_COUNT_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum EnvironmentSDFGIRayCount] enum."
msgstr "A [enum EnvironmentSDFGIRayCount] felsorolás mérete."

#. RenderingServer.ENV_SDFGI_CONVERGE_IN_5_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Converge SDFGI over 5 frames. This is the most responsive, but creates the most noisy result with a given ray count."
msgstr "Az SDFGI 5 képkocka alatt áll be. Adott sugárszám mellett ez reagál a leggyorsabban a változásokra, de a kép ennél a beállításnál a legzajosabb."

#. RenderingServer.ENV_SDFGI_CONVERGE_IN_10_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Configure SDFGI to fully converge over 10 frames."
msgstr "Az SDFGI 10 képkocka alatt áll be."

#. RenderingServer.ENV_SDFGI_CONVERGE_IN_15_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Configure SDFGI to fully converge over 15 frames."
msgstr "Az SDFGI 15 képkocka alatt áll be."

#. RenderingServer.ENV_SDFGI_CONVERGE_IN_20_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Configure SDFGI to fully converge over 20 frames."
msgstr "Az SDFGI 20 képkocka alatt áll be."

#. RenderingServer.ENV_SDFGI_CONVERGE_IN_25_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Configure SDFGI to fully converge over 25 frames."
msgstr "Az SDFGI 25 képkocka alatt áll be."

#. RenderingServer.ENV_SDFGI_CONVERGE_IN_30_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Configure SDFGI to fully converge over 30 frames. This is the least responsive, but creates the least noisy result with a given ray count."
msgstr "Az SDFGI 30 képkocka alatt áll be. Adott sugárszám mellett ez reagál a leglassabban a változásokra, de így a legkevésbé zajos a kép."

#. RenderingServer.ENV_SDFGI_CONVERGE_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum EnvironmentSDFGIFramesToConverge] enum."
msgstr "A [enum EnvironmentSDFGIFramesToConverge] felsorolás mérete."

#. RenderingServer.ENV_SDFGI_UPDATE_LIGHT_IN_1_FRAME
#: doc/classes/RenderingServer.xml
msgid "Update indirect light from dynamic lights in SDFGI over 1 frame. This is the most responsive, but has the highest GPU requirements."
msgstr "Az SDFGI 1 képkocka alatt frissíti a dinamikus fényforrások közvetett megvilágítását. Ez a leggyorsabban reagáló beállítás, de a GPU-t is ez terheli a legjobban."

#. RenderingServer.ENV_SDFGI_UPDATE_LIGHT_IN_2_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Update indirect light from dynamic lights in SDFGI over 2 frames."
msgstr "Az SDFGI 2 képkocka alatt frissíti a dinamikus fényforrások közvetett megvilágítását."

#. RenderingServer.ENV_SDFGI_UPDATE_LIGHT_IN_4_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Update indirect light from dynamic lights in SDFGI over 4 frames."
msgstr "Az SDFGI 4 képkocka alatt frissíti a dinamikus fényforrások közvetett megvilágítását."

#. RenderingServer.ENV_SDFGI_UPDATE_LIGHT_IN_8_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Update indirect light from dynamic lights in SDFGI over 8 frames."
msgstr "Az SDFGI 8 képkocka alatt frissíti a dinamikus fényforrások közvetett megvilágítását."

#. RenderingServer.ENV_SDFGI_UPDATE_LIGHT_IN_16_FRAMES
#: doc/classes/RenderingServer.xml
msgid "Update indirect light from dynamic lights in SDFGI over 16 frames. This is the least responsive, but has the lowest GPU requirements."
msgstr "Az SDFGI 16 képkocka alatt frissíti a dinamikus fényforrások közvetett megvilágítását. Ez a leglassabban reagáló beállítás, de a GPU-t is ez terheli a legkevésbé."

#. RenderingServer.ENV_SDFGI_UPDATE_LIGHT_MAX
#: doc/classes/RenderingServer.xml
msgid "Represents the size of the [enum EnvironmentSDFGIFramesToUpdateLight] enum."
msgstr "A [enum EnvironmentSDFGIFramesToUpdateLight] felsorolás mérete."

#. RenderingServer.TEXTURE_TYPE_2D
#: doc/classes/RenderingServer.xml
msgid "2D texture."
