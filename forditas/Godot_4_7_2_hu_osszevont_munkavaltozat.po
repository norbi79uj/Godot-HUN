#. @GlobalScope.KEY_CODE_MASK
#: doc/classes/@GlobalScope.xml
msgid "Bit mask with all bits enabled except for modifier keys. Apply it to remove modifiers.\n[codeblock]\nvar keycode = KEY_A | KEY_MASK_SHIFT\nkeycode = keycode & KEY_CODE_MASK\nprint(keycode) # KEY_A\n[/codeblock]"
msgstr "Bitmaszk, amelyben a módosítóbillentyűk bitjei kivételével minden bit be van állítva. A módosítók eltávolításához használd.\n[codeblock]\nvar keycode = KEY_A | KEY_MASK_SHIFT\nkeycode = keycode & KEY_CODE_MASK\nprint(keycode) # KEY_A\n[/codeblock]"

#. @GlobalScope.KEY_MODIFIER_MASK
#: doc/classes/@GlobalScope.xml
msgid "Bit mask with all modifier bits enabled. Apply it to isolate modifiers.\n[codeblock]\nvar keycode = KEY_A | KEY_MASK_SHIFT\nkeycode = keycode & KEY_MODIFIER_MASK\nprint(keycode) # KEY_MASK_SHIFT\n[/codeblock]"
msgstr "Bitmaszk, amelyben minden módosítóbit be van állítva. A módosítók elkülönítéséhez használd.\n[codeblock]\nvar keycode = KEY_A | KEY_MASK_SHIFT\nkeycode = keycode & KEY_MODIFIER_MASK\nprint(keycode) # KEY_MASK_SHIFT\n[/codeblock]"

#. @GlobalScope.KEY_MASK_CMD_OR_CTRL
#: doc/classes/@GlobalScope.xml
msgid "Automatically remapped to [constant KEY_META] on macOS and [constant KEY_CTRL] on other platforms, this mask is never set in the actual events, and should be used for key mapping only."
