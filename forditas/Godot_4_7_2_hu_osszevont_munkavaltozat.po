msgstr "Elsődleges egérgomb, általában a bal gomb."

#. @GlobalScope.MOUSE_BUTTON_RIGHT
#: doc/classes/@GlobalScope.xml
msgid "Secondary mouse button, usually assigned to the right button."
msgstr "Másodlagos egérgomb, általában a jobb gomb."

#. @GlobalScope.MOUSE_BUTTON_MIDDLE
#: doc/classes/@GlobalScope.xml
msgid "Middle mouse button."
msgstr "Középső egérgomb."

#. @GlobalScope.MOUSE_BUTTON_WHEEL_UP
#: doc/classes/@GlobalScope.xml
msgid "Mouse wheel scrolling up."
msgstr "Görgetés felfelé az egérgörgővel."

#. @GlobalScope.MOUSE_BUTTON_WHEEL_DOWN
#: doc/classes/@GlobalScope.xml
msgid "Mouse wheel scrolling down."
msgstr "Görgetés lefelé az egérgörgővel."

#. @GlobalScope.MOUSE_BUTTON_WHEEL_LEFT
#: doc/classes/@GlobalScope.xml
msgid "Mouse wheel left button (only present on some mice)."
msgstr "Vízszintes görgetés balra az egérgörgővel. Csak egyes egereken érhető el."

#. @GlobalScope.MOUSE_BUTTON_WHEEL_RIGHT
#: doc/classes/@GlobalScope.xml
msgid "Mouse wheel right button (only present on some mice)."
msgstr "Vízszintes görgetés jobbra az egérgörgővel. Csak egyes egereken érhető el."

#. @GlobalScope.MOUSE_BUTTON_XBUTTON1
#: doc/classes/@GlobalScope.xml
msgid "Extra mouse button 1. This is sometimes present, usually to the sides of the mouse."
msgstr "Az 1. kiegészítő egérgomb. Egyes egereken megtalálható, jellemzően az egér oldalán."

#. @GlobalScope.MOUSE_BUTTON_XBUTTON2
#: doc/classes/@GlobalScope.xml
msgid "Extra mouse button 2. This is sometimes present, usually to the sides of the mouse."
msgstr "A 2. kiegészítő egérgomb. Egyes egereken megtalálható, jellemzően az egér oldalán."

#. @GlobalScope.MOUSE_BUTTON_MASK_LEFT
#: doc/classes/@GlobalScope.xml
msgid "Primary mouse button mask, usually for the left button."
msgstr "Az elsődleges egérgomb maszkja. Általában a bal gombhoz tartozik."

#. @GlobalScope.MOUSE_BUTTON_MASK_RIGHT
#: doc/classes/@GlobalScope.xml
msgid "Secondary mouse button mask, usually for the right button."
msgstr "A másodlagos egérgomb maszkja. Általában a jobb gombhoz tartozik."

#. @GlobalScope.MOUSE_BUTTON_MASK_MIDDLE
#: doc/classes/@GlobalScope.xml
msgid "Middle mouse button mask."
msgstr "A középső egérgomb maszkja."

#. @GlobalScope.MOUSE_BUTTON_MASK_MB_XBUTTON1
#: doc/classes/@GlobalScope.xml
msgid "Extra mouse button 1 mask."
msgstr "Az 1. kiegészítő egérgomb maszkja."

#. @GlobalScope.MOUSE_BUTTON_MASK_MB_XBUTTON2
#: doc/classes/@GlobalScope.xml
msgid "Extra mouse button 2 mask."
msgstr "A 2. kiegészítő egérgomb maszkja."

#. @GlobalScope.JOY_BUTTON_INVALID
#: doc/classes/@GlobalScope.xml
msgid "An invalid game controller button."
msgstr "Érvénytelen játékvezérlő-gomb."

#. @GlobalScope.JOY_BUTTON_A
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL button A. Corresponds to the bottom action button: Sony Cross, Xbox A, Nintendo B."
msgstr "A játékvezérlő SDL szerinti A gombja. Az alsó műveletgombnak felel meg (Sony: kereszt, Xbox: A, Nintendo: B)."

#. @GlobalScope.JOY_BUTTON_B
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL button B. Corresponds to the right action button: Sony Circle, Xbox B, Nintendo A."
msgstr "A játékvezérlő SDL szerinti B gombja. A jobb oldali műveletgombnak felel meg (Sony: kör, Xbox: B, Nintendo: A)."

#. @GlobalScope.JOY_BUTTON_X
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL button X. Corresponds to the left action button: Sony Square, Xbox X, Nintendo Y."
msgstr "A játékvezérlő SDL szerinti X gombja. A bal oldali műveletgombnak felel meg (Sony: négyzet, Xbox: X, Nintendo: Y)."

#. @GlobalScope.JOY_BUTTON_Y
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL button Y. Corresponds to the top action button: Sony Triangle, Xbox Y, Nintendo X."
msgstr "A játékvezérlő SDL szerinti Y gombja. A felső műveletgombnak felel meg (Sony: háromszög, Xbox: Y, Nintendo: X)."

#. @GlobalScope.JOY_BUTTON_BACK
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL back button. Corresponds to the Sony Select, Xbox Back, Nintendo - button."
msgstr "A játékvezérlő SDL szerinti Back gombja. A Sony Select, az Xbox Back és a Nintendo - gombnak felel meg."

#. @GlobalScope.JOY_BUTTON_GUIDE
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL guide button. Corresponds to the Sony PS, Xbox Home button."
msgstr "A játékvezérlő SDL szerinti Guide gombja. A Sony PS és az Xbox Home gombnak felel meg."

#. @GlobalScope.JOY_BUTTON_START
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL start button. Corresponds to the Sony Options, Xbox Menu, Nintendo + button."
msgstr "A játékvezérlő SDL szerinti Start gombja. A Sony Options, az Xbox Menu és a Nintendo + gombnak felel meg."

#. @GlobalScope.JOY_BUTTON_LEFT_STICK
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL left stick button. Corresponds to the Sony L3, Xbox L/LS button."
msgstr "A játékvezérlő bal karjának SDL szerinti gombja. A Sony L3 és az Xbox L/LS gombnak felel meg."

#. @GlobalScope.JOY_BUTTON_RIGHT_STICK
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL right stick button. Corresponds to the Sony R3, Xbox R/RS button."
msgstr "A játékvezérlő jobb karjának SDL szerinti gombja. A Sony R3 és az Xbox R/RS gombnak felel meg."

#. @GlobalScope.JOY_BUTTON_LEFT_SHOULDER
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL left shoulder button. Corresponds to the Sony L1, Xbox LB button."
msgstr "A játékvezérlő SDL szerinti bal vállgombja. A Sony L1 és az Xbox LB gombnak felel meg."

#. @GlobalScope.JOY_BUTTON_RIGHT_SHOULDER
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL right shoulder button. Corresponds to the Sony R1, Xbox RB button."
msgstr "A játékvezérlő SDL szerinti jobb vállgombja. A Sony R1 és az Xbox RB gombnak felel meg."

#. @GlobalScope.JOY_BUTTON_DPAD_UP
#: doc/classes/@GlobalScope.xml
msgid "Game controller D-pad up button."
msgstr "A játékvezérlő iránygombja felfelé."

#. @GlobalScope.JOY_BUTTON_DPAD_DOWN
#: doc/classes/@GlobalScope.xml
msgid "Game controller D-pad down button."
msgstr "A játékvezérlő iránygombja lefelé."

#. @GlobalScope.JOY_BUTTON_DPAD_LEFT
#: doc/classes/@GlobalScope.xml
msgid "Game controller D-pad left button."
msgstr "A játékvezérlő iránygombja balra."

#. @GlobalScope.JOY_BUTTON_DPAD_RIGHT
#: doc/classes/@GlobalScope.xml
msgid "Game controller D-pad right button."
msgstr "A játékvezérlő iránygombja jobbra."

#. @GlobalScope.JOY_BUTTON_MISC1
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL miscellaneous button. Corresponds to Xbox share button, PS5 microphone button, Nintendo Switch capture button."
msgstr "A játékvezérlő SDL szerinti kiegészítő gombja. Az Xbox megosztási gombjának, a PS5 mikrofon gombjának és a Nintendo Switch képernyőfelvétel-gombjának felel meg."

#. @GlobalScope.JOY_BUTTON_PADDLE1
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL paddle 1 button."
msgstr "A játékvezérlő SDL szerinti 1. hátlapi gombja."

#. @GlobalScope.JOY_BUTTON_PADDLE2
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL paddle 2 button."
msgstr "A játékvezérlő SDL szerinti 2. hátlapi gombja."

#. @GlobalScope.JOY_BUTTON_PADDLE3
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL paddle 3 button."
msgstr "A játékvezérlő SDL szerinti 3. hátlapi gombja."

#. @GlobalScope.JOY_BUTTON_PADDLE4
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL paddle 4 button."
msgstr "A játékvezérlő SDL szerinti 4. hátlapi gombja."

#. @GlobalScope.JOY_BUTTON_TOUCHPAD
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL touchpad button."
msgstr "A játékvezérlő SDL szerinti érintőpadgombja."

#. @GlobalScope.JOY_BUTTON_MISC2
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL miscellaneous button. Used by Nintendo Switch 2 Pro Controller and Horipad Steam controllers."
msgstr "A játékvezérlő SDL szerinti kiegészítő gombja. A Nintendo Switch 2 Pro Controller és a Horipad Steam vezérlők használják."

#. @GlobalScope.JOY_BUTTON_MISC3
#. @GlobalScope.JOY_BUTTON_MISC4
#. @GlobalScope.JOY_BUTTON_MISC5
#. @GlobalScope.JOY_BUTTON_MISC6
#: doc/classes/@GlobalScope.xml
msgid "Game controller SDL miscellaneous button."
msgstr "A játékvezérlő SDL szerinti kiegészítő gombja."

#. @GlobalScope.JOY_BUTTON_SDL_MAX
#: doc/classes/@GlobalScope.xml
msgid "The number of SDL game controller buttons."
msgstr "Az SDL játékvezérlő-gombok száma."

#. @GlobalScope.JOY_BUTTON_MAX
#: doc/classes/@GlobalScope.xml
msgid "The maximum number of game controller buttons supported by the engine. The actual limit may be lower on specific platforms:\n- [b]Android:[/b] Up to 36 buttons.\n- [b]Linux:[/b] Up to 80 buttons.\n- [b]Windows[/b] and [b]macOS:[/b] Up to 128 buttons."
msgstr "A motor által támogatott játékvezérlő-gombok legnagyobb száma. A tényleges határ platformonként kisebb lehet:\n- [b]Android:[/b] Legfeljebb 36 gomb.\n- [b]Linux:[/b] Legfeljebb 80 gomb.\n- [b]Windows[/b] és [b]macOS:[/b] Legfeljebb 128 gomb."

#. @GlobalScope.JOY_AXIS_INVALID
#: doc/classes/@GlobalScope.xml
msgid "An invalid game controller axis."
msgstr "Érvénytelen játékvezérlő-tengely."

#. @GlobalScope.JOY_AXIS_LEFT_X
#: doc/classes/@GlobalScope.xml
msgid "Game controller left joystick x-axis."
msgstr "A játékvezérlő bal analóg karjának X tengelye."

#. @GlobalScope.JOY_AXIS_LEFT_Y
#: doc/classes/@GlobalScope.xml
msgid "Game controller left joystick y-axis."
msgstr "A játékvezérlő bal analóg karjának Y tengelye."

#. @GlobalScope.JOY_AXIS_RIGHT_X
#: doc/classes/@GlobalScope.xml
msgid "Game controller right joystick x-axis."
msgstr "A játékvezérlő jobb analóg karjának X tengelye."

#. @GlobalScope.JOY_AXIS_RIGHT_Y
#: doc/classes/@GlobalScope.xml
msgid "Game controller right joystick y-axis."
msgstr "A játékvezérlő jobb analóg karjának Y tengelye."

#. @GlobalScope.JOY_AXIS_TRIGGER_LEFT
#: doc/classes/@GlobalScope.xml
msgid "Game controller left trigger axis."
msgstr "A játékvezérlő bal ravaszának tengelye."

#. @GlobalScope.JOY_AXIS_TRIGGER_RIGHT
#: doc/classes/@GlobalScope.xml
msgid "Game controller right trigger axis."
msgstr "A játékvezérlő jobb ravaszának tengelye."

#. @GlobalScope.JOY_AXIS_SDL_MAX
#: doc/classes/@GlobalScope.xml
msgid "The number of SDL game controller axes."
msgstr "Az SDL játékvezérlő-tengelyek száma."

#. @GlobalScope.JOY_AXIS_MAX
#: doc/classes/@GlobalScope.xml
msgid "The maximum number of game controller axes: OpenVR supports up to 5 Joysticks making a total of 10 axes."
msgstr "A játékvezérlő-tengelyek legnagyobb száma. Az OpenVR legfeljebb 5 botkormányt támogat, ami összesen 10 tengelyt jelent."

#. DisplayServer.MOUSE_MODE_VISIBLE
#. Input.MOUSE_MODE_VISIBLE
#: doc/classes/DisplayServer.xml doc/classes/Input.xml
msgid "Makes the mouse cursor visible if it is hidden."
msgstr "Megjeleníti az egérmutatót, ha rejtve van."

#. DisplayServer.MOUSE_MODE_HIDDEN
#. Input.MOUSE_MODE_HIDDEN
#: doc/classes/DisplayServer.xml doc/classes/Input.xml
msgid "Makes the mouse cursor hidden if it is visible."
msgstr "Elrejti az egérmutatót, ha látható."

#. DisplayServer.MOUSE_MODE_CAPTURED
#. Input.MOUSE_MODE_CAPTURED
#: doc/classes/DisplayServer.xml doc/classes/Input.xml
msgid "Captures the mouse. The mouse will be hidden and its position locked at the center of the window manager's window.\n[b]Note:[/b] If you want to process the mouse's movement in this mode, you need to use [member InputEventMouseMotion.relative]."
msgstr "Rögzíti az egérmutatót. A mutató eltűnik, és az ablakkezelő által kezelt ablak közepén marad.\n[b]Megjegyzés:[/b] Az egér mozgásának feldolgozásához ebben a módban a [member InputEventMouseMotion.relative] tulajdonságot használd."

#. DisplayServer.MOUSE_MODE_CONFINED
#. Input.MOUSE_MODE_CONFINED
#: doc/classes/DisplayServer.xml doc/classes/Input.xml
msgid "Confines the mouse cursor to the game window, and make it visible."
msgstr "A játékablak területére korlátozza az egérmutatót, és láthatóvá teszi."

#. DisplayServer.MOUSE_MODE_CONFINED_HIDDEN
#. Input.MOUSE_MODE_CONFINED_HIDDEN
#: doc/classes/DisplayServer.xml doc/classes/Input.xml
msgid "Confines the mouse cursor to the game window, and make it hidden."
msgstr "A játékablak területére korlátozza az egérmutatót, és elrejti."

#. DisplayServer.MOUSE_MODE_MAX
#. Input.MOUSE_MODE_MAX
#: doc/classes/DisplayServer.xml doc/classes/Input.xml
msgid "Max value of the [enum MouseMode]."
msgstr "A [enum MouseMode] felsorolás legnagyobb értéke."

#. Input.joy_connection_changed
#: doc/classes/Input.xml
msgid "Emitted when a joypad device has been connected or disconnected."
msgstr "Akkor küldi el, amikor egy játékvezérlőt csatlakoztatnak vagy leválasztanak."

#. Input.emulate_mouse_from_touch
#: doc/classes/Input.xml
msgid "If [code]true[/code], sends mouse input events when tapping or swiping on the touchscreen. See also [member ProjectSettings.input_devices/pointing/emulate_mouse_from_touch]."
msgstr "Ha az értéke [code]true[/code], a képernyő megérintése vagy az ujjal végzett húzás egéreseményeket küld. Lásd még a [member ProjectSettings.input_devices/pointing/emulate_mouse_from_touch] beállítást."

#. Input.emulate_touch_from_mouse
#: doc/classes/Input.xml
msgid "If [code]true[/code], sends touch input events when clicking or dragging the mouse. See also [member ProjectSettings.input_devices/pointing/emulate_touch_from_mouse]."
msgstr "Ha az értéke [code]true[/code], az egérrel végzett kattintás vagy húzás érintési eseményeket küld. Lásd még a [member ProjectSettings.input_devices/pointing/emulate_touch_from_mouse] beállítást."

#. Input.ignore_joypad_on_unfocused_application
#. ProjectSettings.input_devices/joypads/ignore_joypad_on_unfocused_application
#: doc/classes/Input.xml doc/classes/ProjectSettings.xml
msgid "If [code]true[/code], joypad input (including motion sensors) and LED light changes will be ignored and joypad vibration will be stopped when the application is not focused."
msgstr "Ha az értéke [code]true[/code], az alkalmazás a fókusz elvesztésekor figyelmen kívül hagyja a játékvezérlő bemenetét (a mozgásérzékelőkkel együtt) és a LED módosításait, valamint leállítja a játékvezérlő rezgését."

#. Input.mouse_mode
#: doc/classes/Input.xml
msgid "Controls the mouse mode."
msgstr "Az egér üzemmódját szabályozza."

#. Input.use_accumulated_input
#: doc/classes/Input.xml
msgid "If [code]true[/code], similar input events sent by the operating system are accumulated. When input accumulation is enabled, all input events generated during a frame will be merged and emitted when the frame is done rendering. Therefore, this limits the number of input method calls per second to the rendering FPS.\nInput accumulation can be disabled to get slightly more precise/reactive input at the cost of increased CPU usage. In applications where drawing freehand lines is required, input accumulation should generally be disabled while the user is drawing the line to get results that closely follow the actual input.\n[b]Note:[/b] Input accumulation is [i]enabled[/i] by default."
msgstr "Ha az értéke [code]true[/code], a motor összevonja az operációs rendszer hasonló bemeneti eseményeit. Ha az összevonás be van kapcsolva, a motor az egy képkockán belül keletkezett bemeneti eseményeket összevonja, és a képkocka kirajzolásának végén küldi el. Így a másodpercenkénti bemenetkezelő metódushívások számát a renderelési képkockasebesség korlátozza.\nAz összevonás kikapcsolásával a bemenet valamivel pontosabb és gyorsabban reagál, nagyobb processzorterhelés árán. Szabadkézi vonalrajzoláskor általában érdemes a rajzolás idejére kikapcsolni, hogy a vonal pontosabban kövesse a felhasználó mozdulatait.\n[b]Megjegyzés:[/b] A bemenet összevonása alapértelmezés szerint [i]be van kapcsolva[/i]."

#. Input.CURSOR_ARROW
#: doc/classes/Input.xml
msgid "Arrow cursor. Standard, default pointing cursor."
msgstr "Nyíl alakú egérmutató. Ez a szokásos alapértelmezett mutató."

#. Input.CURSOR_IBEAM
#: doc/classes/Input.xml
msgid "I-beam cursor. Usually used to show where the text cursor will appear when the mouse is clicked."
msgstr "I alakú egérmutató. Általában azt jelzi, hogy kattintáskor hol jelenik meg a szövegkurzor."

#. Input.CURSOR_POINTING_HAND
#: doc/classes/Input.xml
msgid "Pointing hand cursor. Usually used to indicate the pointer is over a link or other interactable item."
msgstr "Mutató kéz alakú egérmutató. Általában hivatkozás vagy más kezelhető elem fölött jelenik meg."

#. Input.CURSOR_CROSS
#: doc/classes/Input.xml
msgid "Cross cursor. Typically appears over regions in which a drawing operation can be performed or for selections."
msgstr "Kereszt alakú egérmutató. Általában rajzolásra vagy kijelölésre használható területek fölött jelenik meg."

#. Input.CURSOR_WAIT
#: doc/classes/Input.xml
msgid "Wait cursor. Indicates that the application is busy performing an operation, and that it cannot be used during the operation (e.g. something is blocking its main thread)."
msgstr "Várakozást jelző egérmutató. Azt jelzi, hogy az alkalmazás műveletet végez, és közben nem használható, például mert valami blokkolja a főszálát."

#. Input.CURSOR_BUSY
#: doc/classes/Input.xml
msgid "Busy cursor. Indicates that the application is busy performing an operation, and that it is still usable during the operation."
msgstr "Foglaltságot jelző egérmutató. Azt jelzi, hogy az alkalmazás műveletet végez, de közben továbbra is használható."

#. Input.CURSOR_DRAG
#: doc/classes/Input.xml
msgid "Drag cursor. Usually displayed when dragging something.\n[b]Note:[/b] Windows lacks a dragging cursor, so [constant CURSOR_DRAG] is the same as [constant CURSOR_MOVE] for this platform."
msgstr "Húzást jelző egérmutató. Általában egy elem húzásakor jelenik meg.\n[b]Megjegyzés:[/b] A Windowsnak nincs külön húzásmutatója, ezért ezen a platformon a [constant CURSOR_DRAG] megegyezik a [constant CURSOR_MOVE] értékével."

#. Input.CURSOR_CAN_DROP
#: doc/classes/Input.xml
msgid "Can drop cursor. Usually displayed when dragging something to indicate that it can be dropped at the current position."
msgstr "Ejtést engedélyező egérmutató. Húzás közben általában azt jelzi, hogy az elem az aktuális helyre ejthető."

#. Input.CURSOR_FORBIDDEN
#: doc/classes/Input.xml
msgid "Forbidden cursor. Indicates that the current action is forbidden (for example, when dragging something) or that the control at a position is disabled."
msgstr "Tiltást jelző egérmutató. Azt jelzi, hogy az aktuális művelet nem engedélyezett (például húzáskor), vagy hogy az adott helyen lévő vezérlőelem le van tiltva."

#. Input.CURSOR_VSIZE
#: doc/classes/Input.xml
msgid "Vertical resize mouse cursor. A double-headed vertical arrow. It tells the user they can resize the window or the panel vertically."
msgstr "Függőleges átméretezést jelző egérmutató. Kétirányú függőleges nyíl, amely az ablak vagy a panel magasságának módosítását jelzi."

#. Input.CURSOR_HSIZE
#: doc/classes/Input.xml
msgid "Horizontal resize mouse cursor. A double-headed horizontal arrow. It tells the user they can resize the window or the panel horizontally."
msgstr "Vízszintes átméretezést jelző egérmutató. Kétirányú vízszintes nyíl, amely az ablak vagy a panel szélességének módosítását jelzi."

#. Input.CURSOR_BDIAGSIZE
#: doc/classes/Input.xml
msgid "Window resize mouse cursor. The cursor is a double-headed arrow that goes from the bottom left to the top right. It tells the user they can resize the window or the panel both horizontally and vertically."
msgstr "Átlós átméretezést jelző egérmutató. A bal alsó és a jobb felső sarok közé mutató kétirányú nyíl azt jelzi, hogy az ablak vagy panel szélessége és magassága egyszerre módosítható."

#. Input.CURSOR_FDIAGSIZE
#: doc/classes/Input.xml
msgid "Window resize mouse cursor. The cursor is a double-headed arrow that goes from the top left to the bottom right, the opposite of [constant CURSOR_BDIAGSIZE]. It tells the user they can resize the window or the panel both horizontally and vertically."
msgstr "Átlós átméretezést jelző egérmutató. A bal felső és a jobb alsó sarok közé mutató kétirányú nyíl a [constant CURSOR_BDIAGSIZE] ellentétes irányú párja. Azt jelzi, hogy az ablak vagy panel szélessége és magassága egyszerre módosítható."

#. Input.CURSOR_MOVE
#: doc/classes/Input.xml
msgid "Move cursor. Indicates that something can be moved."
msgstr "Mozgatást jelző egérmutató. Azt jelzi, hogy egy elem mozgatható."

#. Input.CURSOR_VSPLIT
#: doc/classes/Input.xml
msgid "Vertical split mouse cursor. On Windows, it's the same as [constant CURSOR_VSIZE]."
msgstr "Az elválasztó függőleges mozgatását jelző egérmutató. Windowson megegyezik a [constant CURSOR_VSIZE] mutatóval."

#. Input.CURSOR_HSPLIT
#: doc/classes/Input.xml
msgid "Horizontal split mouse cursor. On Windows, it's the same as [constant CURSOR_HSIZE]."
msgstr "Az elválasztó vízszintes mozgatását jelző egérmutató. Windowson megegyezik a [constant CURSOR_HSIZE] mutatóval."

#. Input.CURSOR_HELP
#: doc/classes/Input.xml
msgid "Help cursor. Usually a question mark."
msgstr "Súgót jelző egérmutató. Általában kérdőjel alakú."

#. InputMap.brief
#: doc/classes/InputMap.xml
msgid "A singleton that manages all [InputEventAction]s."
msgstr "Az összes [InputEventAction] eseményt kezelő globális példány."

#. InputMap.description
#: doc/classes/InputMap.xml
msgid "Manages all [InputEventAction] which can be created/modified from the project settings menu [b]Project > Project Settings > Input Map[/b] or in code with [method add_action] and [method action_add_event]. See [method Node._input]."
msgstr "Kezeli az összes [InputEventAction] eseményt. Ezek a [b]Projekt > Projektbeállítások > Bemeneti leképezés[/b] fülön vagy kódból az [method add_action] és az [method action_add_event] metódussal hozhatók létre és módosíthatók. Lásd: [method Node._input]."

#. InputMap.action_add_event
#: doc/classes/InputMap.xml
msgid "Adds an [InputEvent] to an action. This [InputEvent] will trigger the action."
msgstr "Egy [InputEvent] eseményt rendel egy művelethez. Az [InputEvent] kiváltja a műveletet."

#. InputMap.action_erase_event
#: doc/classes/InputMap.xml
msgid "Removes an [InputEvent] from an action."
msgstr "Eltávolítja az [InputEvent] eseményt a műveletből."

#. InputMap.action_erase_events
#: doc/classes/InputMap.xml
msgid "Removes all events from an action."
msgstr "Eltávolítja a művelethez rendelt összes eseményt."

#. InputMap.action_get_deadzone
#: doc/classes/InputMap.xml
msgid "Returns a deadzone value for the action."
msgstr "Visszaadja a művelet holtzónájának értékét."

#. InputMap.action_get_events
#: doc/classes/InputMap.xml
msgid "Returns an array of [InputEvent]s associated with a given action.\n[b]Note:[/b] When used in the editor (e.g. a tool script or [EditorPlugin]), this method will return events for the editor action. If you want to access your project's input binds from the editor, read the [code]input/*[/code] settings from [ProjectSettings]."
msgstr "Tömbben adja vissza a megadott művelethez tartozó [InputEvent] eseményeket.\n[b]Megjegyzés:[/b] A szerkesztőben használva (például eszközszkriptben vagy [EditorPlugin] bővítményben) a szerkesztő műveletének eseményeit adja vissza. A projekt bemeneti hozzárendeléseihez a [ProjectSettings] [code]input/*[/code] beállításait olvasd ki."

#. InputMap.action_has_event
#: doc/classes/InputMap.xml
msgid "Returns [code]true[/code] if the action has the given [InputEvent] associated with it."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [InputEvent] hozzá van rendelve a művelethez."

#. InputMap.action_set_deadzone
#: doc/classes/InputMap.xml
msgid "Sets a deadzone value for the action."
msgstr "Beállítja a művelet holtzónájának értékét."

#. InputMap.add_action
#: doc/classes/InputMap.xml
msgid "Adds an empty action to the [InputMap] with a configurable [param deadzone].\nAn [InputEvent] can then be added to this action with [method action_add_event]."
msgstr "Üres műveletet ad az [InputMap] objektumhoz, beállítható [param deadzone] holtzónával.\nEzután egy [InputEvent] eseményt rendelhetsz hozzá a [method action_add_event] metódussal."

#. InputMap.erase_action
#: doc/classes/InputMap.xml
msgid "Removes an action from the [InputMap]."
msgstr "Eltávolít egy műveletet az [InputMap] objektumból."

#. InputMap.event_is_action
#: doc/classes/InputMap.xml
msgid "Returns [code]true[/code] if the given event is part of an existing action. This method ignores keyboard modifiers if the given [InputEvent] is not pressed (for proper release detection). See [method action_has_event] if you don't want this behavior.\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott esemény egy meglévő művelet része. A felengedés helyes felismeréséhez a metódus figyelmen kívül hagyja a billentyűzet módosítóit, ha az adott [InputEvent] nem lenyomást jelez. Ha erre nincs szükséged, lásd a [method action_has_event] metódust.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát."

#. InputMap.get_action_description
#: doc/classes/InputMap.xml
msgid "Returns the human-readable description of the given action."
msgstr "Visszaadja a megadott művelet olvasható leírását."

#. InputMap.get_actions
#: doc/classes/InputMap.xml
msgid "Returns an array of all actions in the [InputMap]."
msgstr "Tömbként adja vissza az [InputMap] összes műveletét."

#. InputMap.has_action
#: doc/classes/InputMap.xml
msgid "Returns [code]true[/code] if the [InputMap] has a registered action with the given name."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott névvel már szerepel művelet az [InputMap] objektumban."

#. InputMap.load_from_project_settings
#: doc/classes/InputMap.xml
msgid "Clears all [InputEventAction] in the [InputMap] and load it anew from [ProjectSettings]."
msgstr "Törli az [InputMap] összes [InputEventAction] eseményét, majd újra betölti őket a [ProjectSettings] beállításaiból."

#. InputMap.project_settings_loaded
#: doc/classes/InputMap.xml
msgid "Emitted when the [ProjectSettings] [InputMap] has been loaded."
msgstr "Akkor küldi el, amikor a [ProjectSettings] beállításaiból betöltődött az [InputMap]."

#. InputEvent.brief
#: doc/classes/InputEvent.xml
msgid "Abstract base class for input events."
msgstr "A bemeneti események absztrakt alaposztálya."

#. InputEvent.description
#: doc/classes/InputEvent.xml
msgid "Abstract base class of all types of input events. See [method Node._input]."
msgstr "Az összes bemeneti eseménytípus absztrakt alaposztálya. Lásd: [method Node._input]."

#. InputEvent.accumulate
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if the given input event and this input event can be added together (only for events of type [InputEventMouseMotion]).\nThe given input event's position, global position and speed will be copied. The resulting [code]relative[/code] is a sum of both events. Both events' modifiers have to be identical."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott bemeneti esemény és ez az esemény összevonható. Csak [InputEventMouseMotion] típusú eseményeknél működik.\nÁtmásolja a megadott bemeneti esemény pozícióját, globális pozícióját és sebességét. Az eredmény [code]relative[/code] értéke a két esemény relatív elmozdulásának összege. A két esemény módosítóinak meg kell egyezniük."

#. InputEvent.as_text
#: doc/classes/InputEvent.xml
msgid "Returns a [String] representation of the event."
msgstr "Az esemény szöveges alakját adja vissza [String] értékként."

#. InputEvent.get_action_strength
#: doc/classes/InputEvent.xml
msgid "Returns a value between 0.0 and 1.0 depending on the given actions' state. Useful for getting the value of events of type [InputEventJoypadMotion].\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events."
msgstr "A megadott művelet állapotától függően 0.0 és 1.0 közötti értéket ad vissza. Hasznos az [InputEventJoypadMotion] esemény értékének lekéréséhez.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát."

#. InputEvent.is_action
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if this input event matches a pre-defined action of any type.\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events."
msgstr "[code]true[/code] értéket ad vissza, ha ez a bemeneti esemény megfelel egy tetszőleges típusú, előre beállított műveletnek.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát."

#. InputEvent.is_action_pressed
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if the given action matches this event and is being pressed (and is not an echo event for [InputEventKey] events, unless [param allow_echo] is [code]true[/code]). Not relevant for events of type [InputEventMouseMotion] or [InputEventScreenDrag].\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events.\n[b]Note:[/b] Due to keyboard ghosting, [method is_action_pressed] may return [code]false[/code] even if one of the action's keys is pressed. See [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]Input examples[/url] in the documentation for more information."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott művelet megfelel ennek az eseménynek, és le van nyomva. [InputEventKey] esetén az ismétlődő esemény csak akkor számít, ha a [param allow_echo] értéke [code]true[/code]. Az [InputEventMouseMotion] és az [InputEventScreenDrag] típusú eseményekre nem alkalmazható.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát.\n[b]Megjegyzés:[/b] A billentyűzet együttes lenyomást érintő hardverkorlátai miatt az [method is_action_pressed] akkor is visszaadhat [code]false[/code] értéket, ha a művelet valamelyik billentyűje le van nyomva. A részleteket lásd a dokumentáció [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]bemenetkezelési példáiban[/url]."

#. InputEvent.is_action_released
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if the given action matches this event and is released (i.e. not pressed). Not relevant for events of type [InputEventMouseMotion] or [InputEventScreenDrag].\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott művelet megfelel ennek az eseménynek, és a művelethez tartozó billentyűt vagy gombot felengedték. Az [InputEventMouseMotion] és az [InputEventScreenDrag] típusú eseményekre nem alkalmazható.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát."

#. InputEvent.is_action_type
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if this input event's type is one that can be assigned to an input action: [InputEventKey], [InputEventMouseButton], [InputEventJoypadButton], [InputEventJoypadMotion], [InputEventAction]. Returns [code]false[/code] for all other input event types."
msgstr "[code]true[/code] értéket ad vissza, ha a bemeneti esemény típusa művelethez rendelhető. Ilyen az [InputEventKey], az [InputEventMouseButton], az [InputEventJoypadButton], az [InputEventJoypadMotion] és az [InputEventAction]. Minden más bemeneti eseménytípusnál [code]false[/code] értéket ad vissza."

#. InputEvent.is_canceled
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if this input event has been canceled."
msgstr "[code]true[/code] értéket ad vissza, ha ezt a bemeneti eseményt megszakították."

#. InputEvent.is_match
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if the specified [param event] matches this event. Only valid for action events, which include key ([InputEventKey]), button ([InputEventMouseButton] or [InputEventJoypadButton]), axis [InputEventJoypadMotion], and action ([InputEventAction]) events.\nIf [param exact_match] is [code]false[/code], the check ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events.\n[b]Note:[/b] This method only considers the event configuration (such as the keyboard key or the joypad axis), not state information like [method is_pressed], [method is_released], [method is_echo], or [method is_canceled]."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param event] egyezik ezzel az eseménnyel. Csak műveleti eseményeknél használható: ide tartoznak a billentyűesemények ([InputEventKey]), a gombesemények ([InputEventMouseButton] vagy [InputEventJoypadButton]), a tengelyesemények ([InputEventJoypadMotion]) és a műveletesemények ([InputEventAction]).\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát.\n[b]Megjegyzés:[/b] A metódus csak az esemény beállításait hasonlítja össze, például a billentyűt vagy a játékvezérlő tengelyét. Az olyan állapotadatokat, mint a [method is_pressed], a [method is_released], az [method is_echo] vagy az [method is_canceled], figyelmen kívül hagyja."

#. InputEvent.is_pressed
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if this input event is pressed. Not relevant for events of type [InputEventMouseMotion] or [InputEventScreenDrag].\n[b]Note:[/b] Due to keyboard ghosting, [method is_pressed] may return [code]false[/code] even if one of the action's keys is pressed. See [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]Input examples[/url] in the documentation for more information."
msgstr "[code]true[/code] értéket ad vissza, ha ez a bemeneti esemény lenyomást jelez. Az [InputEventMouseMotion] és az [InputEventScreenDrag] típusú eseményekre nem alkalmazható.\n[b]Megjegyzés:[/b] A billentyűzet együttes lenyomást érintő hardverkorlátai miatt az [method is_pressed] akkor is visszaadhat [code]false[/code] értéket, ha a művelet valamelyik billentyűje le van nyomva. A részleteket lásd a dokumentáció [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]bemenetkezelési példáiban[/url]."

#. InputEvent.is_released
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if this input event is released. Not relevant for events of type [InputEventMouseMotion] or [InputEventScreenDrag]."
msgstr "[code]true[/code] értéket ad vissza, ha ez a bemeneti esemény felengedést jelez. Az [InputEventMouseMotion] és az [InputEventScreenDrag] típusú eseményekre nem alkalmazható."

#. InputEvent.xformed_by
#: doc/classes/InputEvent.xml
msgid "Returns a copy of the given input event which has been offset by [param local_ofs] and transformed by [param xform]. Relevant for events of type [InputEventMouseButton], [InputEventMouseMotion], [InputEventScreenTouch], [InputEventScreenDrag], [InputEventMagnifyGesture] and [InputEventPanGesture]."
msgstr "A megadott bemeneti esemény másolatát adja vissza a [param local_ofs] eltolással és a [param xform] transzformációval. Az [InputEventMouseButton], az [InputEventMouseMotion], az [InputEventScreenTouch], az [InputEventScreenDrag], az [InputEventMagnifyGesture] és az [InputEventPanGesture] típusú eseményeknél használható."

#. InputEvent.device
#: doc/classes/InputEvent.xml
msgid "The event's device ID.\n[b]Note:[/b] [member device] can be negative for special use cases that don't refer to devices physically present on the system. See [constant DEVICE_ID_EMULATION]."
msgstr "Az esemény eszközazonosítója.\n[b]Megjegyzés:[/b] A [member device] negatív lehet olyan különleges esetekben, amikor az esemény nem a rendszerhez fizikailag csatlakoztatott eszköztől származik. Lásd: [constant DEVICE_ID_EMULATION]."

#. InputEvent.DEVICE_ID_EMULATION
#: doc/classes/InputEvent.xml
msgid "Device ID used for emulated mouse input from a touchscreen, or for emulated touch input from a mouse. This can be used to distinguish emulated mouse input from physical mouse input, or emulated touch input from physical touch input."
msgstr "Az azonosító az érintőképernyőről emulált egérbemenethez vagy az egérrel emulált érintési bemenethez tartozik. Segítségével megkülönböztethető az emulált egérbemenet a fizikai egértől, illetve az emulált érintés a tényleges érintéstől."

#. InputEvent.DEVICE_ID_KEYBOARD
#: doc/classes/InputEvent.xml
msgid "Device ID used for input from a keyboard. This can be used to distinguish keyboard input events from joypad input events."
msgstr "A billentyűzetről érkező bemenet eszközazonosítója. A billentyűzet- és játékvezérlő-események megkülönböztetésére használható."

#. InputEvent.DEVICE_ID_MOUSE
#: doc/classes/InputEvent.xml
msgid "Device ID used for input from a mouse. This can be used to distinguish mouse input events from joypad input events."
msgstr "Az egérből érkező bemenet eszközazonosítója. Az egér- és játékvezérlő-események megkülönböztetésére használható."

#. InputEventAction.brief
#: doc/classes/InputEventAction.xml
msgid "An input event type for actions."
msgstr "Műveletet jelölő bemeneti eseménytípus."

#. InputEventAction.description
#: doc/classes/InputEventAction.xml
msgid "Contains a generic action which can be targeted from several types of inputs. Actions and their events can be set in the [b]Input Map[/b] tab in [b]Project > Project Settings[/b], or with the [InputMap] class.\n[b]Note:[/b] Unlike the other [InputEvent] subclasses which map to unique physical events, this virtual one is not emitted by the engine. This class is useful to emit actions manually with [method Input.parse_input_event], which are then received in [method Node._input]. To check if a physical event matches an action from the Input Map, use [method InputEvent.is_action] and [method InputEvent.is_action_pressed]."
msgstr "Olyan általános műveletet tárol, amelyet többféle bemenettel is kiválthatsz. A műveleteket és eseményeiket a [b]Projekt > Projektbeállítások[/b] menü [b]Bemeneti leképezés[/b] lapján vagy az [InputMap] osztállyal állíthatod be.\n[b]Megjegyzés:[/b] A fizikai eseményekhez rendelt többi [InputEvent] leszármazottal ellentétben ezt a virtuális eseményt a motor nem küldi el magától. A [method Input.parse_input_event] metódussal kézzel küldhetsz műveleteket, amelyeket a [method Node._input] fogad. Annak ellenőrzésére, hogy egy fizikai esemény megfelel-e egy bemeneti műveletnek, használd a [method InputEvent.is_action] és a [method InputEvent.is_action_pressed] metódust."

#. InputEventAction.action
#: doc/classes/InputEventAction.xml
msgid "The action's name. This is usually the name of an existing action in the [InputMap] which you want this custom event to match."
msgstr "A művelet neve. Általában egy meglévő [InputMap] művelet neve, amelyet az egyéni eseménnyel ki szeretnél váltani."

#. InputEventAction.event_index
#: doc/classes/InputEventAction.xml
msgid "The real event index in action this event corresponds to (from events defined for this action in the [InputMap]). If [code]-1[/code], a unique ID will be used and actions pressed with this ID will need to be released with another [InputEventAction]."
msgstr "Annak a tényleges eseménynek az indexe, amelynek ez az esemény megfelel az [InputMap] adott művelethez rendelt eseményei között. [code]-1[/code] értéknél a motor egyedi azonosítót használ. Az ilyen azonosítóval lenyomott művelet felengedéséhez külön [InputEventAction] esemény szükséges."

#. InputEventAction.pressed
#: doc/classes/InputEventAction.xml
msgid "If [code]true[/code], the action's state is pressed. If [code]false[/code], the action's state is released."
msgstr "[code]true[/code] értéknél a művelet lenyomott, [code]false[/code] értéknél felengedett állapotban van."

#. InputEventAction.strength
#: doc/classes/InputEventAction.xml
msgid "The action's strength between 0 and 1. This value is considered as equal to 0 if pressed is [code]false[/code]. The event strength allows faking analog joypad motion events, by specifying how strongly the joypad axis is bent or pressed."
msgstr "A művelet erőssége 0 és 1 között. Felengedett, azaz [code]false[/code] állapotban az érték 0-nak számít. Az esemény erősségével analóg játékvezérlő-mozgást utánozhatsz, megadva, mennyire van kitérítve vagy lenyomva a tengelyhez tartozó kar vagy ravasz."

#. InputEventJoypadButton.brief
#: doc/classes/InputEventJoypadButton.xml
msgid "Represents a gamepad button being pressed or released."
msgstr "A játékvezérlő gombjának lenyomását vagy felengedését jelöli."

#. InputEventJoypadButton.description
#: doc/classes/InputEventJoypadButton.xml
msgid "Input event type for gamepad buttons. For gamepad analog sticks and joysticks, see [InputEventJoypadMotion]."
msgstr "A játékvezérlő gombjainak bemeneti eseménytípusa. Az analóg karok és botkormányok mozgását lásd az [InputEventJoypadMotion] osztálynál."

#. InputEventJoypadButton.button_index
#: doc/classes/InputEventJoypadButton.xml
msgid "Button identifier. One of the [enum JoyButton] button constants."
msgstr "A gomb azonosítója. Az [enum JoyButton] gombállandók egyike."

#. InputEventJoypadButton.pressed
#: doc/classes/InputEventJoypadButton.xml
msgid "If [code]true[/code], the button's state is pressed. If [code]false[/code], the button's state is released."
msgstr "[code]true[/code] értéknél a gomb lenyomott, [code]false[/code] értéknél felengedett állapotban van."

#. InputEventJoypadMotion.brief
#: doc/classes/InputEventJoypadMotion.xml
msgid "Represents axis motions (such as joystick or analog triggers) from a gamepad."
msgstr "A játékvezérlő tengelyeinek mozgását jelöli, például az analóg kar vagy az analóg ravasz elmozdulását."

#. InputEventJoypadMotion.description
#: doc/classes/InputEventJoypadMotion.xml
msgid "Stores information about joystick motions. One [InputEventJoypadMotion] represents one axis at a time. For gamepad buttons, see [InputEventJoypadButton]."
msgstr "A botkormány mozgásadatait tárolja. Egy [InputEventJoypadMotion] esemény mindig egyetlen tengelyre vonatkozik. A játékvezérlő gombjait lásd az [InputEventJoypadButton] osztálynál."

#. InputEventJoypadMotion.axis
#: doc/classes/InputEventJoypadMotion.xml
msgid "Axis identifier."
msgstr "A tengely azonosítója."

#. InputEventJoypadMotion.axis_value
#: doc/classes/InputEventJoypadMotion.xml
msgid "Current position of the joystick on the given axis. The value ranges from [code]-1.0[/code] to [code]1.0[/code]. A value of [code]0[/code] means the axis is in its resting position."
msgstr "Az analóg kar aktuális helyzete az adott tengelyen. Az érték [code]-1.0[/code] és [code]1.0[/code] közötti. A [code]0[/code] érték a tengely nyugalmi helyzetét jelenti."

#. InputEventKey.brief
#: doc/classes/InputEventKey.xml
msgid "Represents a key on a keyboard being pressed or released."
msgstr "Billentyű lenyomását vagy felengedését jelöli."

#. InputEventKey.as_text_key_label
#: doc/classes/InputEventKey.xml
msgid "Returns a [String] representation of the event's [member key_label] and modifiers."
msgstr "[String] értékként adja vissza az esemény [member key_label] billentyűfeliratát és módosítóit."

#. InputEventKey.as_text_keycode
#: doc/classes/InputEventKey.xml
msgid "Returns a [String] representation of the event's [member keycode] and modifiers."
msgstr "[String] értékként adja vissza az esemény [member keycode] billentyűkódját és módosítóit."

#. InputEventKey.as_text_location
#: doc/classes/InputEventKey.xml
msgid "Returns a [String] representation of the event's [member location]. This will be a blank string if the event is not specific to a location."
msgstr "[String] értékként adja vissza az esemény [member location] billentyűhelyét. Ha az esemény nem kötődik egy adott helyhez, üres karakterláncot ad vissza."

#. InputEventKey.as_text_physical_keycode
#: doc/classes/InputEventKey.xml
msgid "Returns a [String] representation of the event's [member physical_keycode] and modifiers."
msgstr "[String] értékként adja vissza az esemény [member physical_keycode] fizikai billentyűkódját és módosítóit."

#. InputEventKey.get_key_label_with_modifiers
#: doc/classes/InputEventKey.xml
msgid "Returns the localized key label combined with modifier keys such as [kbd]Shift[/kbd] or [kbd]Alt[/kbd]. See also [InputEventWithModifiers].\nTo get a human-readable representation of the [InputEventKey] with modifiers, use [code]OS.get_keycode_string(event.get_key_label_with_modifiers())[/code] where [code]event[/code] is the [InputEventKey]."
msgstr "A helyi billentyűfeliratot adja vissza az olyan módosítóbillentyűkkel együtt, mint a [kbd]Shift[/kbd] vagy az [kbd]Alt[/kbd]. Lásd még az [InputEventWithModifiers] osztályt.\nAz [InputEventKey] és módosítói olvasható alakjához használd az [code]OS.get_keycode_string(event.get_key_label_with_modifiers())[/code] hívást, ahol az [code]event[/code] az [InputEventKey] esemény."

#. InputEventKey.get_keycode_with_modifiers
#: doc/classes/InputEventKey.xml
msgid "Returns the Latin keycode combined with modifier keys such as [kbd]Shift[/kbd] or [kbd]Alt[/kbd]. See also [InputEventWithModifiers].\nTo get a human-readable representation of the [InputEventKey] with modifiers, use [code]OS.get_keycode_string(event.get_keycode_with_modifiers())[/code] where [code]event[/code] is the [InputEventKey]."
msgstr "A latin billentyűkódot adja vissza az olyan módosítóbillentyűkkel együtt, mint a [kbd]Shift[/kbd] vagy az [kbd]Alt[/kbd]. Lásd még az [InputEventWithModifiers] osztályt.\nAz [InputEventKey] és módosítói olvasható alakjához használd az [code]OS.get_keycode_string(event.get_keycode_with_modifiers())[/code] hívást, ahol az [code]event[/code] az [InputEventKey] esemény."

#. InputEventKey.get_physical_keycode_with_modifiers
#: doc/classes/InputEventKey.xml
msgid "Returns the physical keycode combined with modifier keys such as [kbd]Shift[/kbd] or [kbd]Alt[/kbd]. See also [InputEventWithModifiers].\nTo get a human-readable representation of the [InputEventKey] with modifiers, use [code]OS.get_keycode_string(event.get_physical_keycode_with_modifiers())[/code] where [code]event[/code] is the [InputEventKey]."
msgstr "A fizikai billentyűkódot adja vissza az olyan módosítóbillentyűkkel együtt, mint a [kbd]Shift[/kbd] vagy az [kbd]Alt[/kbd]. Lásd még az [InputEventWithModifiers] osztályt.\nAz [InputEventKey] és módosítói olvasható alakjához használd az [code]OS.get_keycode_string(event.get_physical_keycode_with_modifiers())[/code] hívást, ahol az [code]event[/code] az [InputEventKey] esemény."

#. InputEventKey.echo
#: doc/classes/InputEventKey.xml
msgid "If [code]true[/code], the key was already pressed before this event. An echo event is a repeated key event sent when the user is holding down the key.\n[b]Note:[/b] The rate at which echo events are sent is typically around 20 events per second (after holding down the key for roughly half a second). However, the key repeat delay/speed can be changed by the user or disabled entirely in the operating system settings. To ensure your project works correctly on all configurations, do not assume the user has a specific key repeat configuration in your project's behavior."
msgstr "Ha az értéke [code]true[/code], a billentyű már az esemény előtt is le volt nyomva. A lenyomva tartott billentyű ismétlődő eseményeket küld.\n[b]Megjegyzés:[/b] Az ismétlődő események általában másodpercenként körülbelül 20-szor érkeznek, nagyjából fél másodpercnyi lenyomva tartás után. A felhasználó azonban az operációs rendszerben módosíthatja az ismétlés késleltetését és sebességét, vagy teljesen ki is kapcsolhatja azt. A projekt helyes működéséhez ne hagyatkozz egy adott ismétlési beállításra."

#. InputEventKey.key_label
#: doc/classes/InputEventKey.xml
msgid "Represents the localized label printed on the key in the current keyboard layout, which corresponds to one of the [enum Key] constants or any valid Unicode character. Key labels are meant for key prompts.\nFor keyboard layouts with a single label on the key, it is equivalent to [member keycode].\nTo get a human-readable representation of the [InputEventKey], use [code]OS.get_keycode_string(event.key_label)[/code] where [code]event[/code] is the [InputEventKey].\n[codeblock lang=text]\n+-----+ +-----+\n| Q   | | Q   | - \"Q\" - keycode\n|   Й | |  ض | - \"Й\" and \"ض\" - key_label\n+-----+ +-----+\n[/codeblock]"
msgstr "A billentyű aktuális kiosztás szerinti helyi feliratát jelöli. Ez a [enum Key] állandók egyike vagy bármely érvényes Unicode-karakter lehet. A felirat arra használható, hogy megmutasd a felhasználónak, melyik billentyűt nyomja meg.\nHa a billentyűkön csak egy felirat szerepel, az érték megegyezik a [member keycode] értékével.\nAz [InputEventKey] olvasható alakjához használd az [code]OS.get_keycode_string(event.key_label)[/code] hívást, ahol az [code]event[/code] az [InputEventKey] esemény.\n[codeblock lang=text]\n+-----+ +-----+\n| Q   | | Q   | - \"Q\" - keycode\n|   Й | |  ض | - \"Й\" and \"ض\" - key_label\n+-----+ +-----+\n[/codeblock]"

#. InputEventKey.keycode
#: doc/classes/InputEventKey.xml
msgid "Latin label printed on the key in the current keyboard layout, which corresponds to one of the [enum Key] constants. Key codes are meant for shortcuts expressed with a standard Latin keyboard, such as [kbd]Ctrl + S[/kbd] for a \"Save\" shortcut.\nTo get a human-readable representation of the [InputEventKey], use [code]OS.get_keycode_string(event.keycode)[/code] where [code]event[/code] is the [InputEventKey].\n[codeblock lang=text]\n+-----+ +-----+\n| Q   | | Q   | - \"Q\" - keycode\n|   Й | |  ض | - \"Й\" and \"ض\" - key_label\n+-----+ +-----+\n[/codeblock]"
msgstr "Az aktuális kiosztás szerinti latin billentyűfelirat, amely a [enum Key] állandók egyikének felel meg. A billentyűkódok szabványos latin billentyűzethez megadott gyorsbillentyűkhöz használhatók, például a Mentés művelethez tartozó [kbd]Ctrl + S[/kbd] kombinációhoz.\nAz [InputEventKey] olvasható alakjához használd az [code]OS.get_keycode_string(event.keycode)[/code] hívást, ahol az [code]event[/code] az [InputEventKey] esemény.\n[codeblock lang=text]\n+-----+ +-----+\n| Q   | | Q   | - \"Q\" - keycode\n|   Й | |  ض | - \"Й\" and \"ض\" - key_label\n+-----+ +-----+\n[/codeblock]"

#. InputEventKey.location
#: doc/classes/InputEventKey.xml
msgid "Represents the location of a key which has both left and right versions, such as [kbd]Shift[/kbd] or [kbd]Alt[/kbd]."
msgstr "Az olyan billentyűk helyét jelöli, amelyeknek bal és jobb oldali változatuk is van, például a [kbd]Shift[/kbd] vagy az [kbd]Alt[/kbd]."

#. InputEventKey.physical_keycode
#: doc/classes/InputEventKey.xml
msgid "Represents the physical location of a key on the 101/102-key US QWERTY keyboard, which corresponds to one of the [enum Key] constants. Physical key codes meant for game input, such as WASD movement, where only the location of the keys is important.\nTo get a human-readable representation of the [InputEventKey], use [method OS.get_keycode_string] in combination with [method DisplayServer.keyboard_get_keycode_from_physical] or [method DisplayServer.keyboard_get_label_from_physical]:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventKey:\n\t\tvar keycode = DisplayServer.keyboard_get_keycode_from_physical(event.physical_keycode)\n\t\tvar label = DisplayServer.keyboard_get_label_from_physical(event.physical_keycode)\n\t\tprint(OS.get_keycode_string(keycode))\n\t\tprint(OS.get_keycode_string(label))\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventKey inputEventKey)\n\t{\n\t\tvar keycode = DisplayServer.KeyboardGetKeycodeFromPhysical(inputEventKey.PhysicalKeycode);\n\t\tvar label = DisplayServer.KeyboardGetLabelFromPhysical(inputEventKey.PhysicalKeycode);\n\t\tGD.Print(OS.GetKeycodeString(keycode));\n\t\tGD.Print(OS.GetKeycodeString(label));\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "A billentyű fizikai helyét jelöli a 101/102 billentyűs amerikai QWERTY billentyűzeten, amely a [enum Key] állandók egyikének felel meg. A fizikai billentyűkódok játékbemenethez valók, például WASD mozgáshoz, amikor csak a billentyűk elhelyezkedése számít.\nAz [InputEventKey] olvasható alakjához használd az [method OS.get_keycode_string] metódust a [method DisplayServer.keyboard_get_keycode_from_physical] vagy a [method DisplayServer.keyboard_get_label_from_physical] metódussal együtt:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventKey:\n\t\tvar keycode = DisplayServer.keyboard_get_keycode_from_physical(event.physical_keycode)\n\t\tvar label = DisplayServer.keyboard_get_label_from_physical(event.physical_keycode)\n\t\tprint(OS.get_keycode_string(keycode))\n\t\tprint(OS.get_keycode_string(label))\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventKey inputEventKey)\n\t{\n\t\tvar keycode = DisplayServer.KeyboardGetKeycodeFromPhysical(inputEventKey.PhysicalKeycode);\n\t\tvar label = DisplayServer.KeyboardGetLabelFromPhysical(inputEventKey.PhysicalKeycode);\n\t\tGD.Print(OS.GetKeycodeString(keycode));\n\t\tGD.Print(OS.GetKeycodeString(label));\n\t}\n}\n[/csharp]\n[/codeblocks]"

#. InputEventKey.pressed
#: doc/classes/InputEventKey.xml
msgid "If [code]true[/code], the key's state is pressed. If [code]false[/code], the key's state is released."
msgstr "[code]true[/code] értéknél a billentyű lenyomott, [code]false[/code] értéknél felengedett állapotban van."

#. InputEventKey.unicode
#: doc/classes/InputEventKey.xml
msgid "The key Unicode character code (when relevant), shifted by modifier keys. Unicode character codes for composite characters and complex scripts may not be available unless IME input mode is active. See [method Window.set_ime_active] for more information. Unicode character codes are meant for text input.\n[b]Note:[/b] This property is set by the engine only for a pressed event. If the event is sent by an IME or a virtual keyboard, no corresponding key released event is sent."
msgstr "A billentyű Unicode-karakterkódja, amennyiben van ilyen, a módosítóbillentyűk figyelembevételével. Az összetett karakterek és írásrendszerek Unicode-kódja előfordulhat, hogy csak aktív IME beviteli módban érhető el. További részletekért lásd a [method Window.set_ime_active] metódust. A Unicode-karakterkódok szövegbevitelhez használhatók.\n[b]Megjegyzés:[/b] A motor csak lenyomási eseménynél állítja be ezt a tulajdonságot. Ha az eseményt IME vagy virtuális billentyűzet küldi, nem érkezik hozzá felengedési esemény."

#. InputEventMagnifyGesture.brief
#: doc/classes/InputEventMagnifyGesture.xml
msgid "Represents a magnifying touch gesture."
msgstr "Nagyító érintési gesztust jelöl."

#. InputEventMagnifyGesture.description
#: doc/classes/InputEventMagnifyGesture.xml
msgid "Stores the factor of a magnifying touch gesture. This is usually performed when the user pinches the touch screen and used for zooming in/out.\n[b]Note:[/b] On Android, this requires the [member ProjectSettings.input_devices/pointing/android/enable_pan_and_scale_gestures] project setting to be enabled."
msgstr "A nagyító érintési gesztus méretezési tényezőjét tárolja. A gesztust rendszerint az érintőképernyőn két ujj közelítésével vagy távolításával végzik, nagyításhoz vagy kicsinyítéshez.\n[b]Megjegyzés:[/b] Androidon ehhez be kell kapcsolni a [member ProjectSettings.input_devices/pointing/android/enable_pan_and_scale_gestures] projektbeállítást."

#. InputEventMagnifyGesture.factor
#: doc/classes/InputEventMagnifyGesture.xml
msgid "The amount (or delta) of the event. This value is closer to [code]1.0[/code] the slower the gesture is performed."
msgstr "Az esemény változásának mértéke. Minél lassabban végzik a gesztust, az érték annál közelebb van [code]1.0[/code]-hoz."

#. InputEventMouse.brief
#: doc/classes/InputEventMouse.xml
msgid "Base input event type for mouse events."
msgstr "Az egéresemények alapvető bemeneti eseménytípusa."

#. InputEventMouse.description
#: doc/classes/InputEventMouse.xml
msgid "Stores general information about mouse events."
msgstr "Az egéresemények általános adatait tárolja."

#. InputEventMouse.button_mask
#: doc/classes/InputEventMouse.xml
msgid "The mouse button mask identifier, one of or a bitwise combination of the [enum MouseButton] button masks."
msgstr "Az egérgombmaszk azonosítója. Az [enum MouseButton] gombmaszkjainak egyike vagy azok bitenkénti kombinációja."

#. InputEventMouse.global_position
#: doc/classes/InputEventMouse.xml
msgid "When received in [method Node._input] or [method Node._unhandled_input], returns the mouse's position in the root [Viewport] using the coordinate system of the root [Viewport].\nWhen received in [method Control._gui_input], returns the mouse's position in the [CanvasLayer] that the [Control] is in using the coordinate system of the [CanvasLayer]."
msgstr "A [method Node._input] vagy a [method Node._unhandled_input] metódusban fogadva az egér gyökérszintű [Viewport] nézetablakon belüli helyét adja vissza a gyökérszintű [Viewport] koordinátáiban.\nA [method Control._gui_input] metódusban fogadva az egér helyét annak a [CanvasLayer] rétegnek a koordináta-rendszerében adja vissza, amelyhez a [Control] tartozik. Ilyenkor a [CanvasLayer] koordinátái érvényesek."

#. InputEventMouse.position
#: doc/classes/InputEventMouse.xml
msgid "When received in [method Node._input] or [method Node._unhandled_input], returns the mouse's position in the [Viewport] this [Node] is in using the coordinate system of this [Viewport].\nWhen received in [method Control._gui_input], returns the mouse's position in the [Control] using the local coordinate system of the [Control]."
msgstr "A [method Node._input] vagy a [method Node._unhandled_input] metódusban fogadva az egér helyét annak a [Viewport] nézetablaknak a koordináta-rendszerében adja vissza, amelyhez a [Node] tartozik. A hely az adott [Viewport] koordinátáiban értendő.\nA [method Control._gui_input] metódusban fogadva az egér helyét a [Control] vezérlőelemen belül, az adott [Control] helyi koordináta-rendszerében adja vissza."

#. InputEventMouseButton.brief
#: doc/classes/InputEventMouseButton.xml
msgid "Represents a mouse button being pressed or released."
msgstr "Egérgomb lenyomását vagy felengedését jelöli."

#. InputEventMouseButton.description
#: doc/classes/InputEventMouseButton.xml
msgid "Stores information about mouse click events. See [method Node._input].\n[b]Note:[/b] On Wear OS devices, rotary input is mapped to [constant MOUSE_BUTTON_WHEEL_UP] and [constant MOUSE_BUTTON_WHEEL_DOWN]. This can be changed to [constant MOUSE_BUTTON_WHEEL_LEFT] and [constant MOUSE_BUTTON_WHEEL_RIGHT] with the [member ProjectSettings.input_devices/pointing/android/rotary_input_scroll_axis] setting."
msgstr "Az egérkattintás eseményadatait tárolja. Lásd: [method Node._input].\n[b]Megjegyzés:[/b] Wear OS eszközökön a forgatható vezérlő bemenetét a motor a [constant MOUSE_BUTTON_WHEEL_UP] és [constant MOUSE_BUTTON_WHEEL_DOWN] állandóhoz rendeli. A [member ProjectSettings.input_devices/pointing/android/rotary_input_scroll_axis] beállítással ez átváltható a [constant MOUSE_BUTTON_WHEEL_LEFT] és a [constant MOUSE_BUTTON_WHEEL_RIGHT] állandóra."

#. InputEventMouseButton.button_index
#: doc/classes/InputEventMouseButton.xml
msgid "The mouse button identifier, one of the [enum MouseButton] button or button wheel constants."
msgstr "Az egérgomb azonosítója. Az [enum MouseButton] felsorolás egyik gomb- vagy görgőállandója."

#. InputEventMouseButton.canceled
#: doc/classes/InputEventMouseButton.xml
msgid "If [code]true[/code], the mouse button event has been canceled."
msgstr "Ha az értéke [code]true[/code], az egérgombeseményt megszakították."

#. InputEventMouseButton.double_click
#: doc/classes/InputEventMouseButton.xml
msgid "If [code]true[/code], the mouse button's state is a double-click."
msgstr "Ha az értéke [code]true[/code], az egérgomb eseménye dupla kattintás."

#. InputEventMouseButton.factor
#: doc/classes/InputEventMouseButton.xml
msgid "The amount (or delta) of the event. When used for high-precision scroll events, this indicates the scroll amount (vertical or horizontal). This is only supported on some platforms; the reported sensitivity varies depending on the platform. May be [code]0[/code] if not supported."
msgstr "Az esemény változásának mértéke. Nagy pontosságú görgetési eseménynél a függőleges vagy vízszintes görgetés mértékét jelzi. Csak bizonyos platformokon támogatott, és a jelentett érzékenység platformonként eltér. Ha nem támogatott, az érték [code]0[/code] lehet."

#. InputEventMouseButton.pressed
#: doc/classes/InputEventMouseButton.xml
msgid "If [code]true[/code], the mouse button's state is pressed. If [code]false[/code], the mouse button's state is released."
msgstr "[code]true[/code] értéknél az egérgomb lenyomott, [code]false[/code] értéknél felengedett állapotban van."

#. InputEventMouseMotion.brief
#: doc/classes/InputEventMouseMotion.xml
msgid "Represents a mouse or a pen movement."
msgstr "Egér vagy digitális toll mozgását jelöli."

#. InputEventMouseMotion.description
#: doc/classes/InputEventMouseMotion.xml
msgid "Stores information about a mouse or a pen motion. This includes relative position, absolute position, and velocity. See [method Node._input].\n[b]Note:[/b] By default, this event is only emitted once per frame rendered at most. If you need more precise input reporting, set [member Input.use_accumulated_input] to [code]false[/code] to make events emitted as often as possible. If you use InputEventMouseMotion to draw lines, consider using [method Geometry2D.bresenham_line] as well to avoid visible gaps in lines if the user is moving the mouse quickly.\n[b]Note:[/b] This event may be emitted even when the mouse hasn't moved, either by the operating system or by Godot itself. If you really need to know if the mouse has moved (e.g. to suppress displaying a tooltip), you should check that [code]relative.is_zero_approx()[/code] is [code]false[/code]."
msgstr "Az egér vagy digitális toll mozgásadatait tárolja. Ide tartozik a relatív és az abszolút pozíció, valamint a sebesség. Lásd: [method Node._input].\n[b]Megjegyzés:[/b] A motor alapértelmezés szerint kirajzolt képkockánként legfeljebb egyszer küld ilyen eseményt. Ha pontosabb bemeneti adatokra van szükséged, állítsd a [member Input.use_accumulated_input] értékét [code]false[/code] értékre, hogy az események a lehető leggyakrabban érkezzenek. Ha InputEventMouseMotion alapján rajzolsz vonalakat, a [method Geometry2D.bresenham_line] metódussal elkerülheted a vonalak szakadozását az egér gyors mozgatásakor.\n[b]Megjegyzés:[/b] Ezt az eseményt az operációs rendszer vagy maga a Godot akkor is elküldheti, ha az egér nem mozdult meg. Ha biztosan tudnod kell, történt-e mozgás, például egy eszköztipp elrejtéséhez, ellenőrizd, hogy a [code]relative.is_zero_approx()[/code] értéke [code]false[/code]-e."

#. InputEventMouseMotion.pen_inverted
#: doc/classes/InputEventMouseMotion.xml
msgid "Returns [code]true[/code] when using the eraser end of a stylus pen.\n[b]Note:[/b] This property is implemented on Linux, macOS and Windows."
msgstr "[code]true[/code] értéket ad vissza a digitális toll radírvégének használatakor.\n[b]Megjegyzés:[/b] Ez a tulajdonság Linuxon, macOS-en és Windowson érhető el."

#. InputEventMouseMotion.pressure
#. InputEventScreenDrag.pressure
#: doc/classes/InputEventMouseMotion.xml doc/classes/InputEventScreenDrag.xml
msgid "Represents the pressure the user puts on the pen. Ranges from [code]0.0[/code] to [code]1.0[/code]."
msgstr "A digitális tollra kifejtett nyomást jelöli. Az érték [code]0.0[/code] és [code]1.0[/code] közötti."

#. InputEventMouseMotion.relative
#: doc/classes/InputEventMouseMotion.xml
msgid "The mouse position relative to the previous position (position at the last frame).\n[b]Note:[/b] Since [InputEventMouseMotion] may only be emitted when the mouse moves, it is not possible to reliably detect when the mouse has stopped moving by checking this property. A separate, short timer may be necessary.\n[b]Note:[/b] [member relative] is automatically scaled according to the content scale factor, which is defined by the project's stretch mode settings. This means mouse sensitivity will appear different depending on resolution when using [member relative] in a script that handles mouse aiming with the [constant Input.MOUSE_MODE_CAPTURED] mouse mode. To avoid this, use [member screen_relative] instead."
msgstr "Az egér pozíciója az előző pozícióhoz, vagyis az utolsó képkockán mért helyhez viszonyítva.\n[b]Megjegyzés:[/b] Mivel az [InputEventMouseMotion] csak mozgáskor érkezhet, ebből a tulajdonságból nem állapítható meg megbízhatóan, hogy az egér mikor állt meg. Ehhez külön, rövid időzítőre lehet szükség.\n[b]Megjegyzés:[/b] A motor a [member relative] értékét automatikusan átméretezi a projekt nyújtási beállításai által megadott tartalomméretezési tényezővel. Emiatt ha a [member relative] alapján célzol egérrel a [constant Input.MOUSE_MODE_CAPTURED] módban, az egér érzékenysége felbontásonként eltérőnek tűnhet. Ennek elkerüléséhez használd a [member screen_relative] tulajdonságot."

#. InputEventMouseMotion.screen_relative
#: doc/classes/InputEventMouseMotion.xml
msgid "The unscaled mouse position relative to the previous position in the coordinate system of the screen (position at the last frame).\n[b]Note:[/b] Since [InputEventMouseMotion] may only be emitted when the mouse moves, it is not possible to reliably detect when the mouse has stopped moving by checking this property. A separate, short timer may be necessary.\n[b]Note:[/b] This coordinate is [i]not[/i] scaled according to the content scale factor or calls to [method InputEvent.xformed_by]. This should be preferred over [member relative] for mouse aiming when using the [constant Input.MOUSE_MODE_CAPTURED] mouse mode, regardless of the project's stretch mode."
msgstr "Az egér méretezetlen elmozdulása a képernyő koordináta-rendszerében, az előző képkockán mért helyhez viszonyítva.\n[b]Megjegyzés:[/b] Mivel az [InputEventMouseMotion] csak mozgáskor érkezhet, ebből a tulajdonságból nem állapítható meg megbízhatóan, hogy az egér mikor állt meg. Ehhez külön, rövid időzítőre lehet szükség.\n[b]Megjegyzés:[/b] Ezt a koordinátát [i]nem[/i] módosítja a tartalom méretezési tényezője vagy a [method InputEvent.xformed_by] hívása. A [constant Input.MOUSE_MODE_CAPTURED] módban egérrel történő célzáshoz ezt használd a [member relative] helyett, függetlenül a projekt nyújtási módjától."

#. InputEventMouseMotion.screen_velocity
#: doc/classes/InputEventMouseMotion.xml
msgid "The unscaled mouse velocity in pixels per second in screen coordinates. This velocity is [i]not[/i] scaled according to the content scale factor or calls to [method InputEvent.xformed_by].\n[b]Note:[/b] In [constant Input.MOUSE_MODE_CAPTURED] mode, [member screen_velocity] returns [code](0, 0)[/code] because the mouse cursor is hidden and locked. Use [member screen_relative] for mouse aiming using the [constant Input.MOUSE_MODE_CAPTURED] mouse mode."
msgstr "Az egér méretezetlen sebessége képpont/másodpercben, képernyő-koordinátákban. Ezt a sebességet [i]nem[/i] módosítja a tartalom méretezési tényezője vagy a [method InputEvent.xformed_by] hívása.\n[b]Megjegyzés:[/b] A [constant Input.MOUSE_MODE_CAPTURED] módban a [member screen_velocity] értéke [code](0, 0)[/code], mert az egérmutató rejtve és rögzítve van. A [constant Input.MOUSE_MODE_CAPTURED] egérmódban a célzáshoz a [member screen_relative] tulajdonságot használd."

#. InputEventMouseMotion.tilt
#. InputEventScreenDrag.tilt
#: doc/classes/InputEventMouseMotion.xml doc/classes/InputEventScreenDrag.xml
msgid "Represents the angles of tilt of the pen. Positive X-coordinate value indicates a tilt to the right. Positive Y-coordinate value indicates a tilt toward the user. Ranges from [code]-1.0[/code] to [code]1.0[/code] for both axes."
msgstr "A digitális toll dőlésszögeit jelöli. A pozitív X érték jobbra dőlést, a pozitív Y érték a felhasználó felé dőlést jelent. Mindkét tengely értéke [code]-1.0[/code] és [code]1.0[/code] közötti."

#. InputEventMouseMotion.velocity
#: doc/classes/InputEventMouseMotion.xml
msgid "The mouse velocity in pixels per second.\n[b]Note:[/b] [member velocity] is automatically scaled according to the content scale factor, which is defined by the project's stretch mode settings. That means mouse sensitivity may appear different depending on resolution.\n[b]Note:[/b] In [constant Input.MOUSE_MODE_CAPTURED] mode, [member velocity] returns [code](0, 0)[/code] because the mouse cursor is hidden and locked. Use [member screen_relative] for mouse aiming using the [constant Input.MOUSE_MODE_CAPTURED] mouse mode."
msgstr "Az egér sebessége képpont/másodpercben.\n[b]Megjegyzés:[/b] A motor a [member velocity] értékét automatikusan átméretezi a projekt nyújtási beállításai által megadott tartalomméretezési tényezővel. Emiatt az egér érzékenysége felbontásonként eltérőnek tűnhet.\n[b]Megjegyzés:[/b] A [constant Input.MOUSE_MODE_CAPTURED] módban a [member velocity] értéke [code](0, 0)[/code], mert az egérmutató rejtve és rögzítve van. A [constant Input.MOUSE_MODE_CAPTURED] egérmódban a célzáshoz a [member screen_relative] tulajdonságot használd."

#. InputEventPanGesture.brief
#: doc/classes/InputEventPanGesture.xml
msgid "Represents a panning touch gesture."
msgstr "Pásztázó érintési gesztust jelöl."

#. InputEventPanGesture.description
#: doc/classes/InputEventPanGesture.xml
msgid "Stores information about pan gestures. A pan gesture is performed when the user swipes the touch screen with two fingers. It's typically used for panning/scrolling.\n[b]Note:[/b] On Android, this requires the [member ProjectSettings.input_devices/pointing/android/enable_pan_and_scale_gestures] project setting to be enabled."
msgstr "A pásztázó gesztus adatait tárolja. Ez a gesztus akkor jön létre, amikor a felhasználó két ujját végighúzza az érintőképernyőn. Általában pásztázásra vagy görgetésre szolgál.\n[b]Megjegyzés:[/b] Androidon ehhez be kell kapcsolni a [member ProjectSettings.input_devices/pointing/android/enable_pan_and_scale_gestures] projektbeállítást."

#. InputEventPanGesture.delta
#: doc/classes/InputEventPanGesture.xml
msgid "Panning amount since last pan event."
msgstr "A pásztázás mértéke a legutóbbi pásztázási esemény óta."

#. InputEventScreenDrag.brief
#: doc/classes/InputEventScreenDrag.xml
msgid "Represents a screen drag event."
msgstr "Érintőképernyőn végzett húzást jelöl."

#. InputEventScreenDrag.description
#: doc/classes/InputEventScreenDrag.xml
msgid "Stores information about screen drag events. See [method Node._input]."
msgstr "Az érintőképernyőn végzett húzás eseményadatait tárolja. Lásd: [method Node._input]."

#. InputEventScreenDrag.index
#: doc/classes/InputEventScreenDrag.xml
msgid "The drag event index in the case of a multi-drag event."
msgstr "A húzási esemény indexe több egyidejű húzás esetén."

#. InputEventScreenDrag.pen_inverted
#: doc/classes/InputEventScreenDrag.xml
msgid "Returns [code]true[/code] when using the eraser end of a stylus pen."
msgstr "[code]true[/code] értéket ad vissza a digitális toll radírvégének használatakor."

#. InputEventScreenDrag.position
#: doc/classes/InputEventScreenDrag.xml
msgid "The drag position in the viewport the node is in, using the coordinate system of this viewport."
msgstr "A húzás helye a csomópontot tartalmazó nézetablak koordináta-rendszerében."

#. InputEventScreenDrag.relative
#: doc/classes/InputEventScreenDrag.xml
msgid "The drag position relative to the previous position (position at the last frame).\n[b]Note:[/b] [member relative] is automatically scaled according to the content scale factor, which is defined by the project's stretch mode settings. This means touch sensitivity will appear different depending on resolution when using [member relative] in a script that handles touch aiming. To avoid this, use [member screen_relative] instead."
msgstr "A húzás pozíciója az előző pozícióhoz, vagyis az utolsó képkockán mért helyhez viszonyítva.\n[b]Megjegyzés:[/b] A motor a [member relative] értékét automatikusan átméretezi a projekt nyújtási beállításai által megadott tartalomméretezési tényezővel. Emiatt ha a [member relative] alapján célzol érintéssel, az érintés érzékenysége felbontásonként eltérőnek tűnhet. Ennek elkerüléséhez használd a [member screen_relative] tulajdonságot."

#. InputEventScreenDrag.screen_relative
#: doc/classes/InputEventScreenDrag.xml
msgid "The unscaled drag position relative to the previous position in screen coordinates (position at the last frame). This position is [i]not[/i] scaled according to the content scale factor or calls to [method InputEvent.xformed_by]. This should be preferred over [member relative] for touch aiming regardless of the project's stretch mode."
msgstr "A húzás méretezetlen elmozdulása képernyő-koordinátákban, az előző képkockán mért helyhez viszonyítva. Ezt a pozíciót [i]nem[/i] módosítja a tartalom méretezési tényezője vagy a [method InputEvent.xformed_by] hívása. Érintéses célzáshoz ezt használd a [member relative] helyett, függetlenül a projekt nyújtási módjától."

#. InputEventScreenDrag.screen_velocity
#: doc/classes/InputEventScreenDrag.xml
msgid "The unscaled drag velocity in pixels per second in screen coordinates. This velocity is [i]not[/i] scaled according to the content scale factor or calls to [method InputEvent.xformed_by]. This should be preferred over [member velocity] for touch aiming regardless of the project's stretch mode."
msgstr "A húzás méretezetlen sebessége képpont/másodpercben, képernyő-koordinátákban. Ezt a sebességet [i]nem[/i] módosítja a tartalom méretezési tényezője vagy a [method InputEvent.xformed_by] hívása. Érintéses célzáshoz ezt használd a [member velocity] helyett, függetlenül a projekt nyújtási módjától."

#. InputEventScreenDrag.velocity
#: doc/classes/InputEventScreenDrag.xml
msgid "The drag velocity.\n[b]Note:[/b] [member velocity] is automatically scaled according to the content scale factor, which is defined by the project's stretch mode settings. This means touch sensitivity will appear different depending on resolution when using [member velocity] in a script that handles touch aiming. To avoid this, use [member screen_velocity] instead."
msgstr "A húzás sebessége.\n[b]Megjegyzés:[/b] A motor a [member velocity] értékét automatikusan átméretezi a projekt nyújtási beállításai által megadott tartalomméretezési tényezővel. Emiatt ha a [member velocity] alapján célzol érintéssel, az érintés érzékenysége felbontásonként eltérőnek tűnhet. Ennek elkerüléséhez használd a [member screen_velocity] tulajdonságot."

#. InputEventScreenTouch.brief
#: doc/classes/InputEventScreenTouch.xml
msgid "Represents a screen touch event."
msgstr "Képernyőérintési eseményt jelöl."

#. InputEventScreenTouch.description
#: doc/classes/InputEventScreenTouch.xml
msgid "Stores information about multi-touch press/release input events. Supports touch press, touch release and [member index] for multi-touch count and order."
msgstr "A többérintéses bemenet le- és felengedési eseményeinek adatait tárolja. Támogatja az érintés kezdetét és végét, valamint a több érintési pont számának és sorrendjének követésére szolgáló [member index] értéket."

#. InputEventScreenTouch.canceled
#: doc/classes/InputEventScreenTouch.xml
msgid "If [code]true[/code], the touch event has been canceled."
msgstr "Ha az értéke [code]true[/code], az érintési eseményt megszakították."

#. InputEventScreenTouch.double_tap
#: doc/classes/InputEventScreenTouch.xml
msgid "If [code]true[/code], the touch's state is a double tap."
msgstr "Ha az értéke [code]true[/code], az esemény dupla érintés."

#. InputEventScreenTouch.index
#: doc/classes/InputEventScreenTouch.xml
msgid "The touch index in the case of a multi-touch event. One index = one finger."
msgstr "Az érintés indexe több egyidejű érintésnél. Minden index egy ujjhoz tartozik."

#. InputEventScreenTouch.position
#: doc/classes/InputEventScreenTouch.xml
msgid "The touch position in the viewport the node is in, using the coordinate system of this viewport."
msgstr "Az érintés helye a csomópontot tartalmazó nézetablak koordináta-rendszerében."

#. InputEventScreenTouch.pressed
#: doc/classes/InputEventScreenTouch.xml
msgid "If [code]true[/code], the touch's state is pressed. If [code]false[/code], the touch's state is released."
msgstr "[code]true[/code] értéknél az ujj érinti a képernyőt, [code]false[/code] értéknél az érintés véget ért."

#. InputEventWithModifiers.brief
#: doc/classes/InputEventWithModifiers.xml
msgid "Abstract base class for input events affected by modifier keys like [kbd]Shift[/kbd] and [kbd]Alt[/kbd]."
msgstr "Az olyan módosítóbillentyűk által befolyásolt bemeneti események absztrakt alaposztálya, mint a [kbd]Shift[/kbd] és az [kbd]Alt[/kbd]."

#. InputEventWithModifiers.description
#: doc/classes/InputEventWithModifiers.xml
msgid "Stores information about mouse, keyboard, and touch gesture input events. This includes information about which modifier keys are pressed, such as [kbd]Shift[/kbd] or [kbd]Alt[/kbd]. See [method Node._input].\n[b]Note:[/b] Modifier keys are considered modifiers only when used in combination with another key. As a result, their corresponding member variables, such as [member ctrl_pressed], will return [code]false[/code] if the key is pressed on its own."
msgstr "Az egér, a billentyűzet és az érintési gesztusok bemeneti eseményeiről tárol adatokat. Ezek közé tartozik, hogy mely módosítóbillentyűk vannak lenyomva, például a [kbd]Shift[/kbd] vagy az [kbd]Alt[/kbd]. Lásd: [method Node._input].\n[b]Megjegyzés:[/b] A módosítóbillentyűk csak egy másik billentyűvel együtt számítanak módosítónak. Ezért a hozzájuk tartozó tagváltozók, például a [member ctrl_pressed], [code]false[/code] értéket adnak vissza, ha a módosítóbillentyűt önmagában nyomják meg."

#. InputEventWithModifiers.get_modifiers_mask
#: doc/classes/InputEventWithModifiers.xml
msgid "Returns the keycode combination of modifier keys."
msgstr "Visszaadja a módosítóbillentyűk kódjainak kombinációját."

#. InputEventWithModifiers.is_command_or_control_pressed
#: doc/classes/InputEventWithModifiers.xml
msgid "On macOS, returns [code]true[/code] if [kbd]Meta[/kbd] ([kbd]Cmd[/kbd]) is pressed.\nOn other platforms, returns [code]true[/code] if [kbd]Ctrl[/kbd] is pressed."
msgstr "macOS-en [code]true[/code] értéket ad vissza, ha a [kbd]Meta[/kbd] ([kbd]Cmd[/kbd]) le van nyomva.\nMás platformokon [code]true[/code] értéket ad vissza, ha a [kbd]Ctrl[/kbd] le van nyomva."

#. InputEventWithModifiers.alt_pressed
#: doc/classes/InputEventWithModifiers.xml
msgid "State of the [kbd]Alt[/kbd] modifier."
msgstr "Az [kbd]Alt[/kbd] módosítóbillentyű állapota."

#. InputEventWithModifiers.command_or_control_autoremap
#: doc/classes/InputEventWithModifiers.xml
msgid "Automatically use [kbd]Meta[/kbd] ([kbd]Cmd[/kbd]) on macOS and [kbd]Ctrl[/kbd] on other platforms. If [code]true[/code], [member ctrl_pressed] and [member meta_pressed] cannot be set."
msgstr "macOS-en automatikusan a [kbd]Meta[/kbd] ([kbd]Cmd[/kbd]), más platformokon a [kbd]Ctrl[/kbd] billentyűt használja. [code]true[/code] értéknél a [member ctrl_pressed] és a [member meta_pressed] nem állítható be."

#. InputEventWithModifiers.ctrl_pressed
#: doc/classes/InputEventWithModifiers.xml
msgid "State of the [kbd]Ctrl[/kbd] modifier."
msgstr "A [kbd]Ctrl[/kbd] módosítóbillentyű állapota."

#. InputEventWithModifiers.meta_pressed
#: doc/classes/InputEventWithModifiers.xml
msgid "State of the [kbd]Meta[/kbd] modifier. On Windows and Linux, this represents the Windows key (sometimes called \"meta\" or \"super\" on Linux). On macOS, this represents the Command key."
msgstr "A [kbd]Meta[/kbd] módosítóbillentyű állapota. Windowson és Linuxon ez a Windows billentyű, amelyet Linuxon néha Meta vagy Super néven említenek. macOS-en ez a Command billentyű."

#. InputEventWithModifiers.shift_pressed
#: doc/classes/InputEventWithModifiers.xml
msgid "State of the [kbd]Shift[/kbd] modifier."
msgstr "A [kbd]Shift[/kbd] módosítóbillentyű állapota."

#. ProjectSettings.input_devices/pointing/android/enable_pan_and_scale_gestures
#: doc/classes/ProjectSettings.xml
msgid "If [code]true[/code], multi-touch pan and scale gestures are enabled on Android devices."
msgstr "Ha az értéke [code]true[/code], az androidos eszközökön engedélyezi a többujjas pásztázó és méretező gesztusokat."

#. Input.brief
#: doc/classes/Input.xml
msgid "A singleton for handling inputs."
msgstr "A bemenetet kezelő globális példány."

#. Input.description
#: doc/classes/Input.xml
msgid "The [Input] singleton handles key presses, mouse buttons and movement, gamepads, and input actions. Actions and their events can be set in the [b]Input Map[/b] tab in [b]Project > Project Settings[/b], or with the [InputMap] class.\n[b]Note:[/b] [Input]'s methods reflect the global input state and are not affected by [method Control.accept_event] or [method Viewport.set_input_as_handled], as those methods only deal with the way input is propagated in the [SceneTree]."
msgstr "Az [Input] globális példány kezeli a billentyűlenyomásokat, az egérgombokat és az egér mozgását, a játékvezérlőket, valamint a bemeneti műveleteket. A műveleteket és eseményeiket a [b]Projekt > Projektbeállítások[/b] menü [b]Bemeneti leképezés[/b] lapján vagy az [InputMap] osztállyal állíthatod be.\n[b]Megjegyzés:[/b] Az [Input] metódusai a globális bemenet állapotát tükrözik. A [method Control.accept_event] és a [method Viewport.set_input_as_handled] ezt nem módosítja, mivel csak a bemenet továbbítását szabályozzák a [SceneTree] fán belül."

#. Input.action_press
#: doc/classes/Input.xml
msgid "This will simulate pressing the specified action.\nThe strength can be used for non-boolean actions, it's ranged between 0 and 1 representing the intensity of the given action.\n[b]Note:[/b] This method will not cause any [method Node._input] calls. It is intended to be used with [method is_action_pressed] and [method is_action_just_pressed]. If you want to simulate [code]_input[/code], use [method parse_input_event] instead."
msgstr "A megadott művelet lenyomását szimulálja.\nAz erősség nem logikai értékű műveleteknél használható. A 0 és 1 közötti érték a művelet intenzitását adja meg.\n[b]Megjegyzés:[/b] A metódus nem hívja meg a [method Node._input] metódust. Az [method is_action_pressed] és az [method is_action_just_pressed] metódussal együtt használható. Ha az [code]_input[/code] hívását is szeretnéd szimulálni, használd a [method parse_input_event] metódust."

#. Input.action_release
#: doc/classes/Input.xml
msgid "If the specified action is already pressed, this will release it."
msgstr "Felengedi a megadott műveletet, ha az éppen le van nyomva."

#. Input.add_joy_mapping
#: doc/classes/Input.xml
msgid "Adds a new mapping entry (in SDL2 format) to the mapping database. Optionally update already connected devices."
msgstr "Új leképezést ad a leképezési adatbázishoz SDL2 formátumban. Igény szerint a már csatlakoztatott eszközök leképezését is frissítheti."

#. Input.clear_joy_motion_sensors_calibration
#: doc/classes/Input.xml
msgid "Clears the calibration information for the specified joypad's motion sensors, if it has any and if they were calibrated.\nSee [method start_joy_motion_sensors_calibration] for an example on how to use joypad motion sensors and calibration in your games.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "Törli a megadott játékvezérlő mozgásérzékelőinek kalibrációs adatait, ha a vezérlő rendelkezik kalibrált érzékelőkkel.\nA [method start_joy_motion_sensors_calibration] metódusnál példát találsz a mozgásérzékelők játékbeli használatára és kalibrálására.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.flush_buffered_events
#: doc/classes/Input.xml
msgid "Sends all input events which are in the current buffer to the game loop. These events may have been buffered as a result of accumulated input ([member use_accumulated_input]) or agile input flushing ([member ProjectSettings.input_devices/buffering/agile_event_flushing]).\nThe engine will already do this itself at key execution points (at least once per frame). However, this can be useful in advanced cases where you want precise control over the timing of event handling."
msgstr "Az aktuális puffer összes bemeneti eseményét továbbítja a játékciklusnak. Ezek az események a bemenet összevonása ([member use_accumulated_input]) vagy a puffer gyakoribb ürítése ([member ProjectSettings.input_devices/buffering/agile_event_flushing]) miatt kerülhettek a pufferbe.\nA motor ezt alapvető végrehajtási pontokon, képkockánként legalább egyszer magától is elvégzi. Ez a metódus akkor hasznos, ha pontosan szeretnéd szabályozni az eseménykezelés időzítését."

#. Input.get_accelerometer
#: doc/classes/Input.xml
msgid "Returns the acceleration in m/s² of the device's accelerometer sensor, if the device has one. Otherwise, the method returns [constant Vector3.ZERO].\nNote this method returns an empty [Vector3] when running from the editor even when your device has an accelerometer. You must export your project to a supported device to read values from the accelerometer.\n[b]Note:[/b] This method only works on Android and iOS. On other platforms, it always returns [constant Vector3.ZERO].\n[b]Note:[/b] For Android, [member ProjectSettings.input_devices/sensors/enable_accelerometer] must be enabled."
msgstr "Ha az eszköz rendelkezik gyorsulásmérővel, visszaadja az érzékelt gyorsulást m/s²-ben. Egyébként a [constant Vector3.ZERO] értéket adja vissza.\nA metódus a szerkesztőből futtatva akkor is nulla értékű [Vector3] vektort ad vissza, ha az eszköz rendelkezik gyorsulásmérővel. Az értékek kiolvasásához exportáld a projektet támogatott eszközre.\n[b]Megjegyzés:[/b] A metódus csak Androidon és iOS-en működik. Más platformokon mindig a [constant Vector3.ZERO] értéket adja vissza.\n[b]Megjegyzés:[/b] Androidon engedélyezni kell a [member ProjectSettings.input_devices/sensors/enable_accelerometer] beállítást."

#. Input.get_action_raw_strength
#: doc/classes/Input.xml
msgid "Returns a value between 0 and 1 representing the raw intensity of the given action, ignoring the action's deadzone. In most cases, you should use [method get_action_strength] instead.\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events."
msgstr "A megadott művelet nyers erősségét adja vissza 0 és 1 között, a holtzóna figyelembevétele nélkül. A legtöbb esetben a [method get_action_strength] metódust célszerű használni.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát."

#. Input.get_action_strength
#: doc/classes/Input.xml
msgid "Returns a value between 0 and 1 representing the intensity of the given action. In a joypad, for example, the further away the axis (analog sticks or L2, R2 triggers) is from the dead zone, the closer the value will be to 1. If the action is mapped to a control that has no axis such as the keyboard, the value returned will be 0 or 1.\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events."
msgstr "A megadott művelet erősségét adja vissza 0 és 1 között. Játékvezérlőn például minél távolabb van az analóg kar vagy az L2, R2 ravasz tengelyértéke a holtzónától, annál közelebb esik az érték az 1-hez. Tengely nélküli vezérlőhöz, például billentyűhöz rendelt művelet esetén az eredmény 0 vagy 1.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát."

#. Input.get_axis
#: doc/classes/Input.xml
msgid "Get axis input by specifying two actions, one negative and one positive.\nThis is a shorthand for writing [code]Input.get_action_strength(\"positive_action\") - Input.get_action_strength(\"negative_action\")[/code]."
msgstr "Egy tengely bemeneti értékét adja vissza két művelet megadásával. Az egyik a negatív, a másik a pozitív irányhoz tartozik.\nEz a [code]Input.get_action_strength(\"positive_action\") - Input.get_action_strength(\"negative_action\")[/code] kifejezés rövid alakja."

#. Input.get_connected_joypads
#: doc/classes/Input.xml
msgid "Returns an [Array] containing the device IDs of all currently connected joypads.\n[b]Note:[/b] The order of connected joypads can not be guaranteed to be the same after a project and/or the editor is restarted, because Godot doesn't save the order of joypad connections. Joypads are registered in the order they are discovered by Godot."
msgstr "Az összes jelenleg csatlakoztatott játékvezérlő eszközazonosítóját tartalmazó [Array] értéket ad vissza.\n[b]Megjegyzés:[/b] A Godot nem tárolja a játékvezérlők csatlakozási sorrendjét, így a projekt vagy a szerkesztő újraindítása után a sorrend eltérhet. A motor abban a sorrendben veszi nyilvántartásba a vezérlőket, amelyben észleli őket."

#. Input.get_current_cursor_shape
#: doc/classes/Input.xml
msgid "Returns the currently assigned cursor shape."
msgstr "Visszaadja az egérmutató aktuálisan beállított alakját."

#. Input.get_gravity
#: doc/classes/Input.xml
msgid "Returns the gravity in m/s² of the device's accelerometer sensor, if the device has one. Otherwise, the method returns [constant Vector3.ZERO].\n[b]Note:[/b] This method only works on Android and iOS. On other platforms, it always returns [constant Vector3.ZERO].\n[b]Note:[/b] For Android, [member ProjectSettings.input_devices/sensors/enable_gravity] must be enabled."
msgstr "Ha az eszköz rendelkezik gyorsulásmérővel, visszaadja az érzékelt gravitációs gyorsulást m/s²-ben. Egyébként a [constant Vector3.ZERO] értéket adja vissza.\n[b]Megjegyzés:[/b] A metódus csak Androidon és iOS-en működik. Más platformokon mindig a [constant Vector3.ZERO] értéket adja vissza.\n[b]Megjegyzés:[/b] Androidon engedélyezni kell a [member ProjectSettings.input_devices/sensors/enable_gravity] beállítást."

#. Input.get_gyroscope
#: doc/classes/Input.xml
msgid "Returns the rotation rate in rad/s around a device's X, Y, and Z axes of the gyroscope sensor, if the device has one. Otherwise, the method returns [constant Vector3.ZERO].\n[b]Note:[/b] This method only works on Android and iOS. On other platforms, it always returns [constant Vector3.ZERO].\n[b]Note:[/b] For Android, [member ProjectSettings.input_devices/sensors/enable_gyroscope] must be enabled."
msgstr "Ha az eszköz rendelkezik giroszkóppal, visszaadja az eszköz X, Y és Z tengely körüli szögsebességét rad/s-ban. Egyébként a [constant Vector3.ZERO] értéket adja vissza.\n[b]Megjegyzés:[/b] A metódus csak Androidon és iOS-en működik. Más platformokon mindig a [constant Vector3.ZERO] értéket adja vissza.\n[b]Megjegyzés:[/b] Androidon engedélyezni kell a [member ProjectSettings.input_devices/sensors/enable_gyroscope] beállítást."

#. Input.get_joy_accelerometer
#: doc/classes/Input.xml
msgid "Returns the acceleration, including the force of gravity, in m/s² of the joypad's accelerometer sensor, if the joypad has one and it's currently enabled. Otherwise, the method returns [constant Vector3.ZERO]. See also [method get_joy_gravity] and [method set_joy_motion_sensors_enabled].\nFor a joypad held in front of you, the returned axes are defined as follows:\n+X ... -X: left ... right;\n+Y ... -Y: bottom ... top;\n+Z ... -Z: farther ... closer.\nThe gravity part value is measured as a vector with length of [code]9.8[/code] away from the center of the Earth, which is a negative Y value.\n[b]Note:[/b] This feature is only supported on Windows, Linux, and macOS. On iOS, joypad accelerometer sensor reading is not supported due to OS limitations."
msgstr "A játékvezérlő gyorsulásmérője által mért gyorsulást adja vissza m/s²-ben, a gravitációs gyorsulással együtt, ha az érzékelő elérhető és be van kapcsolva. Egyébként a [constant Vector3.ZERO] értéket adja vissza. Lásd még a [method get_joy_gravity] és a [method set_joy_motion_sensors_enabled] metódust.\nHa magad elé tartod a játékvezérlőt, a tengelyek iránya a következő:\n+X és -X rendre balra és jobbra mutat.\n+Y és -Y rendre lefelé és felfelé mutat.\n+Z és -Z rendre tőled elfelé és feléd mutat.\nA gravitációs összetevő egy, a Föld középpontjától kifelé mutató, [code]9.8[/code] hosszúságú vektor, amelynek Y értéke negatív.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon és macOS-en támogatott. iOS-en az operációs rendszer korlátozásai miatt a játékvezérlő gyorsulásmérője nem olvasható ki."

#. Input.get_joy_axis
#: doc/classes/Input.xml
msgid "Returns the current value of the joypad axis at index [param axis]."
msgstr "Visszaadja a játékvezérlő [param axis] indexű tengelyének aktuális értékét."

#. Input.get_joy_gravity
#: doc/classes/Input.xml
msgid "Returns the gravity in m/s² of the joypad's accelerometer sensor, if the joypad has one and it's currently enabled. Otherwise, the method returns [constant Vector3.ZERO]. See also [method get_joy_accelerometer] and [method set_joy_motion_sensors_enabled].\nFor a joypad held in front of you, the returned axes are defined as follows:\n+X ... -X: left ... right;\n+Y ... -Y: bottom ... top;\n+Z ... -Z: farther ... closer.\nThe gravity part value is measured as a vector with length of [code]9.8[/code] away from the center of the Earth, which is a negative Y value.\n[b]Note:[/b] This feature is only supported on Windows, Linux, and macOS. On iOS, joypad accelerometer sensor reading is not supported due to OS limitations."
msgstr "A játékvezérlő gyorsulásmérője által mért gravitációs gyorsulást adja vissza m/s²-ben, ha az érzékelő elérhető és be van kapcsolva. Egyébként a [constant Vector3.ZERO] értéket adja vissza. Lásd még a [method get_joy_accelerometer] és a [method set_joy_motion_sensors_enabled] metódust.\nHa magad elé tartod a játékvezérlőt, a tengelyek iránya a következő:\n+X és -X rendre balra és jobbra mutat.\n+Y és -Y rendre lefelé és felfelé mutat.\n+Z és -Z rendre tőled elfelé és feléd mutat.\nA gravitációs összetevő egy, a Föld középpontjától kifelé mutató, [code]9.8[/code] hosszúságú vektor, amelynek Y értéke negatív.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon és macOS-en támogatott. iOS-en az operációs rendszer korlátozásai miatt a játékvezérlő gyorsulásmérője nem olvasható ki."

#. Input.get_joy_guid
#: doc/classes/Input.xml
msgid "Returns an SDL-compatible device GUID on platforms that use gamepad remapping, e.g. [code]030000004c050000c405000000010000[/code]. Returns an empty string if it cannot be found. Godot uses SDL's internal mappings, supplemented by community-contributed mappings, to determine gamepad names and mappings based on this GUID.\nOn Windows, all XInput joypad GUIDs will be overridden by Godot to [code]__XINPUT_DEVICE__[/code], because their mappings are the same."
msgstr "Az újraleképezést használó platformokon SDL-kompatibilis eszköz-GUID-ot ad vissza, például [code]030000004c050000c405000000010000[/code]. Ha nem talál azonosítót, üres karakterláncot ad vissza. A Godot az SDL belső és a közösség által beküldött leképezései alapján határozza meg a vezérlő nevét és leképezését ebből az azonosítóból.\nWindowson a Godot az összes XInput-játékvezérlő GUID-ját [code]__XINPUT_DEVICE__[/code] értékre cseréli, mert ezek a vezérlők ugyanazt a leképezést használják."

#. Input.get_joy_gyroscope
#: doc/classes/Input.xml
msgid "Returns the rotation rate in rad/s around a joypad's X, Y, and Z axes of the gyroscope sensor, if the joypad has one and it's currently enabled. Otherwise, the method returns [constant Vector3.ZERO]. See also [method set_joy_motion_sensors_enabled].\nThe rotation is positive in the counter-clockwise direction.\nFor a joypad held in front of you, the returned axes are defined as follows:\nX: Angular speed around the X axis (pitch);\nY: Angular speed around the Y axis (yaw);\nZ: Angular speed around the Z axis (roll).\nSee [method start_joy_motion_sensors_calibration] for an example on how to use joypad gyroscope and gyroscope calibration in your games.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "Ha a játékvezérlő rendelkezik bekapcsolt giroszkóppal, visszaadja az X, Y és Z tengely körüli szögsebességet rad/s-ban. Egyébként a [constant Vector3.ZERO] értéket adja vissza. Lásd még a [method set_joy_motion_sensors_enabled] metódust.\nAz óramutató járásával ellentétes forgás értéke pozitív.\nHa magad elé tartod a játékvezérlőt, a tengelyekhez tartozó értékek a következők:\nX: Az X tengely körüli szögsebesség (bólintás).\nY: Az Y tengely körüli szögsebesség (elfordulás).\nZ: A Z tengely körüli szögsebesség (bedőlés).\nA [method start_joy_motion_sensors_calibration] metódusnál példát találsz a giroszkóp játékbeli használatára és kalibrálására.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.get_joy_info
#: doc/classes/Input.xml
msgid "Returns a dictionary with extra platform-specific information about the device, e.g. the raw gamepad name from the OS or the Steam Input index.\nOn Windows, Linux, macOS, and iOS, the dictionary contains the following fields:\n[code]raw_name[/code]: The name of the controller as it came from the OS, before getting renamed by the controller database.\n[code]vendor_id[/code]: The USB vendor ID of the device.\n[code]product_id[/code]: The USB product ID of the device.\n[code]serial_number[/code]: The serial number of the device. This key won't be present if the serial number is unavailable.\nThe dictionary can also include the following fields under selected platforms:\n[code]steam_input_index[/code]: The Steam Input gamepad index (Windows, Linux, and macOS only). If the device is not a Steam Input device this key won't be present.\n[code]xinput_index[/code]: The index of the controller in the XInput system (Windows only). This key won't be present for devices not handled by XInput.\n[b]Note:[/b] The returned dictionary is always empty on Android and Web."
msgstr "Szótárban adja vissza az eszköz további, platformfüggő adatait, például a játékvezérlő operációs rendszer szerinti nyers nevét vagy Steam Input-indexét.\nWindowson, Linuxon, macOS-en és iOS-en a szótár a következő mezőket tartalmazza:\n[code]raw_name[/code]: A vezérlő operációs rendszertől kapott neve, mielőtt az adatbázis alapján átnevezné a motor.\n[code]vendor_id[/code]: Az eszköz gyártójának USB-azonosítója.\n[code]product_id[/code]: Az eszköz USB-termékazonosítója.\n[code]serial_number[/code]: Az eszköz sorozatszáma. Ha a sorozatszám nem érhető el, a kulcs hiányzik.\nBizonyos platformokon a szótár a következő mezőket is tartalmazhatja:\n[code]steam_input_index[/code]: A játékvezérlő Steam Input-indexe (csak Windows, Linux és macOS). Ha az eszköz nem Steam Input-eszköz, a kulcs hiányzik.\n[code]xinput_index[/code]: A játékvezérlő XInput-indexe (csak Windows). Az XInput által nem kezelt eszközöknél a kulcs hiányzik.\n[b]Megjegyzés:[/b] Androidon és weben a visszaadott szótár mindig üres."

#. Input.get_joy_motion_sensors_rate
#: doc/classes/Input.xml
msgid "Returns the joypad's motion sensor rate in Hz, if the joypad has motion sensors and they're currently enabled. See also [method set_joy_motion_sensors_enabled].\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "Hz-ben adja vissza a játékvezérlő mozgásérzékelőinek mintavételi frekvenciáját, ha az érzékelők elérhetők és be vannak kapcsolva. Lásd még a [method set_joy_motion_sensors_enabled] metódust.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.get_joy_name
#: doc/classes/Input.xml
msgid "Returns the name of the joypad at the specified device index, e.g. [code]PS4 Controller[/code]. Godot uses the [url=https://github.com/gabomdq/SDL_GameControllerDB]SDL2 game controller database[/url] to determine gamepad names."
msgstr "Visszaadja a megadott eszközindexhez tartozó játékvezérlő nevét, például [code]PS4 Controller[/code]. A Godot a [url=https://github.com/gabomdq/SDL_GameControllerDB]játékvezérlők SDL2-adatbázisából[/url] állapítja meg a neveket."

#. Input.get_joy_vibration_duration
#: doc/classes/Input.xml
msgid "Returns the duration of the current vibration effect in seconds.\n[b]Note:[/b] This method returns the same value that was passed to [method start_joy_vibration], and this value does [b]not[/b] change when the joypad's vibration runs out, it only gets reset after a call to [method stop_joy_vibration].\nIf you want to check if a joypad is still vibrating, use [method is_joy_vibrating] instead."
msgstr "Visszaadja az aktuális rezgés beállított időtartamát másodpercben.\n[b]Megjegyzés:[/b] Ugyanazt az értéket adja vissza, amelyet a [method start_joy_vibration] metódusnak adtak át. Az érték a rezgés végén [b]nem[/b] változik. Csak a [method stop_joy_vibration] hívása állítja vissza.\nA [method is_joy_vibrating] metódussal ellenőrizheted, hogy a játékvezérlő még rezeg-e."

#. Input.get_joy_vibration_remaining_duration
#: doc/classes/Input.xml
msgid "Returns the remaining duration of the current vibration effect in seconds."
msgstr "Visszaadja az aktuális rezgésből hátralévő időt másodpercben."

#. Input.get_joy_vibration_strength
#: doc/classes/Input.xml
msgid "Returns the strength of the joypad vibration: x is the strength of the weak motor, and y is the strength of the strong motor.\n[b]Note:[/b] This method returns the same values that were passed to [method start_joy_vibration], and these values do [b]not[/b] change when the joypad's vibration runs out, they only get reset after a call to [method stop_joy_vibration].\nIf you want to check if a joypad is still vibrating, use [method is_joy_vibrating] instead."
msgstr "Visszaadja a játékvezérlő rezgésének erősségét. Az x a gyenge, az y az erős motor erőssége.\n[b]Megjegyzés:[/b] Ugyanazokat az értékeket adja vissza, amelyeket a [method start_joy_vibration] metódusnak adtak át. Az értékek a rezgés végén [b]nem[/b] változnak. Csak a [method stop_joy_vibration] hívása állítja vissza őket.\nA [method is_joy_vibrating] metódussal ellenőrizheted, hogy a játékvezérlő még rezeg-e."

#. Input.get_last_mouse_screen_velocity
#: doc/classes/Input.xml
msgid "Returns the last mouse velocity in screen coordinates. To provide a precise and jitter-free velocity, mouse velocity is only calculated every 0.1s. Therefore, mouse velocity will lag mouse movements."
msgstr "Képernyő-koordinátákban adja vissza az egér legutóbb számított sebességét. A pontos, egyenletes értékhez a motor csak 0.1 másodpercenként számolja ki a sebességet. Ezért a sebességérték késve követi az egér mozgását."

#. Input.get_last_mouse_velocity
#: doc/classes/Input.xml
msgid "Returns the last mouse velocity. To provide a precise and jitter-free velocity, mouse velocity is only calculated every 0.1s. Therefore, mouse velocity will lag mouse movements."
msgstr "Visszaadja az egér legutóbb számított sebességét. A pontos, egyenletes értékhez a motor csak 0.1 másodpercenként számolja ki a sebességet. Ezért a sebességérték késve követi az egér mozgását."

#. Input.get_magnetometer
#: doc/classes/Input.xml
msgid "Returns the magnetic field strength in micro-Tesla for all axes of the device's magnetometer sensor, if the device has one. Otherwise, the method returns [constant Vector3.ZERO].\n[b]Note:[/b] This method only works on Android and iOS. On other platforms, it always returns [constant Vector3.ZERO].\n[b]Note:[/b] For Android, [member ProjectSettings.input_devices/sensors/enable_magnetometer] must be enabled."
msgstr "Ha az eszköz rendelkezik magnetométerrel, az érzékelt mágneses térerősséget adja vissza mikroteslában, az összes tengelyre. Egyébként a [constant Vector3.ZERO] értéket adja vissza.\n[b]Megjegyzés:[/b] A metódus csak Androidon és iOS-en működik. Más platformokon mindig a [constant Vector3.ZERO] értéket adja vissza.\n[b]Megjegyzés:[/b] Androidon engedélyezni kell a [member ProjectSettings.input_devices/sensors/enable_magnetometer] beállítást."

#. Input.get_mouse_button_mask
#: doc/classes/Input.xml
msgid "Returns mouse buttons as a bitmask. If multiple mouse buttons are pressed at the same time, the bits are added together. Equivalent to [method DisplayServer.mouse_get_button_state]."
msgstr "Bitmaszkként adja vissza az egérgombok állapotát. Ha egyszerre több egérgomb van lenyomva, a hozzájuk tartozó bitek összeadódnak. A [method DisplayServer.mouse_get_button_state] metódussal egyenértékű."

#. Input.get_vector
#: doc/classes/Input.xml
msgid "Gets an input vector by specifying four actions for the positive and negative X and Y axes.\nThis method is useful when getting vector input, such as from a joystick, directional pad, arrows, or WASD. The vector has its length limited to 1 and has a circular deadzone, which is useful for using vector input as movement.\nBy default, the deadzone is automatically calculated from the average of the action deadzones. However, you can override the deadzone to be whatever you want (on the range of 0 to 1)."
msgstr "Bemeneti vektort ad vissza az X és Y tengely pozitív és negatív irányához megadott négy műveletből.\nA metódus hasznos, ha a bemenet vektor, például botkormány, iránygombok, nyílbillentyűk vagy WASD használatakor. A vektor hossza legfeljebb 1, a holtzónája pedig kör alakú. Ez jól használható mozgásvezérléshez.\nA motor alapértelmezés szerint a műveletek holtzónáinak átlagából számítja ki a holtzónát, de 0 és 1 között más értéket is megadhatsz."

#. Input.has_joy_light
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if the joypad has an LED light that can change colors and/or brightness. See also [method set_joy_light].\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "[code]true[/code] értéket ad vissza, ha a játékvezérlő LED-jének színe vagy fényereje módosítható. Lásd még a [method set_joy_light] metódust.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.has_joy_motion_sensors
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if the joypad has motion sensors (accelerometer and gyroscope).\n[b]Note:[/b] On iOS, joypad accelerometer sensor reading is not supported due to OS limitations.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "[code]true[/code] értéket ad vissza, ha a játékvezérlő rendelkezik mozgásérzékelőkkel (gyorsulásmérővel és giroszkóppal).\n[b]Megjegyzés:[/b] iOS-en az operációs rendszer korlátozásai miatt a játékvezérlő gyorsulásmérője nem olvasható ki.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.has_joy_vibration
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if the joypad supports vibration. See also [method start_joy_vibration].\n[b]Note:[/b] For macOS, vibration is only supported in macOS 11 and later. When connected via USB, vibration is only supported for major brand controllers (except Xbox One and Xbox Series X/S controllers) due to macOS limitations."
msgstr "[code]true[/code] értéket ad vissza, ha a játékvezérlő támogatja a rezgést. Lásd még a [method start_joy_vibration] metódust.\n[b]Megjegyzés:[/b] A rezgés a macOS 11 és újabb verzióin támogatott. USB-csatlakozás esetén a macOS korlátozásai miatt a funkció csak a nagyobb gyártók vezérlőin működik, az Xbox One és az Xbox Series X/S vezérlők kivételével."

#. Input.is_action_just_pressed
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] when the user has [i]started[/i] pressing the action event in the current frame or physics tick. It will only return [code]true[/code] on the frame or tick that the user pressed down the button.\nThis is useful for code that needs to run only once when an action is pressed, instead of every frame while it's pressed.\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events.\n[b]Note:[/b] Returning [code]true[/code] does not imply that the action is [i]still[/i] pressed. An action can be pressed and released again rapidly, and [code]true[/code] will still be returned so as not to miss input.\n[b]Note:[/b] Due to keyboard ghosting, [method is_action_just_pressed] may return [code]false[/code] even if one of the action's keys is pressed. See [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]Input examples[/url] in the documentation for more information.\n[b]Note:[/b] During input handling (e.g. [method Node._input]), use [method InputEvent.is_action_pressed] instead to query the action state of the current event. See also [method is_action_just_pressed_by_event]."
msgstr "[code]true[/code] értéket ad vissza, ha a felhasználó az aktuális képkockán vagy fizikai lépésben [i]kezdte[/i] lenyomni a művelethez tartozó vezérlőt. Csak abban a képkockában vagy lépésben ad [code]true[/code] értéket, amikor megnyomták a gombot.\nEz olyan kódnál hasznos, amelynek a művelet lenyomásakor egyszer kell futnia, függetlenül attól, meddig tartják lenyomva.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát.\n[b]Megjegyzés:[/b] A [code]true[/code] eredményből nem következik, hogy a művelet [i]még mindig[/i] le van nyomva. Gyors lenyomás és felengedés esetén is [code]true[/code] az eredmény, így az esemény nem vész el.\n[b]Megjegyzés:[/b] A billentyűzet együttes lenyomást érintő hardverkorlátai miatt az [method is_action_just_pressed] akkor is visszaadhat [code]false[/code] értéket, ha a művelet valamelyik billentyűje le van nyomva. Lásd a dokumentáció [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]bemenetkezelési példáit[/url].\n[b]Megjegyzés:[/b] Bemenetkezeléskor, például a [method Node._input] metódusban, a [method InputEvent.is_action_pressed] metódussal kérdezd le az aktuális esemény műveletállapotát. Lásd még az [method is_action_just_pressed_by_event] metódust."

#. Input.is_action_just_pressed_by_event
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] when the user has [i]started[/i] pressing the action event in the current frame or physics tick, and the first event that triggered action press in the current frame/physics tick was [param event]. It will only return [code]true[/code] on the frame or tick that the user pressed down the button.\nThis is useful for code that needs to run only once when an action is pressed, and the action is processed during input handling (e.g. [method Node._input]).\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events.\n[b]Note:[/b] Returning [code]true[/code] does not imply that the action is [i]still[/i] pressed. An action can be pressed and released again rapidly, and [code]true[/code] will still be returned so as not to miss input.\n[b]Note:[/b] Due to keyboard ghosting, [method is_action_just_pressed] may return [code]false[/code] even if one of the action's keys is pressed. See [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]Input examples[/url] in the documentation for more information."
msgstr "[code]true[/code] értéket ad vissza, ha a felhasználó az aktuális képkockán vagy fizikai lépésben [i]kezdte[/i] lenyomni a művelethez tartozó vezérlőt, és a lenyomást először a [param event] váltotta ki. Csak abban a képkockában vagy lépésben ad [code]true[/code] értéket, amikor megnyomták a gombot.\nAkkor hasznos, ha a lenyomáskor egyszer kell kódot futtatni, és a művelet feldolgozása a bemenetkezeléskor történik, például a [method Node._input] metódusban.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát.\n[b]Megjegyzés:[/b] A [code]true[/code] eredményből nem következik, hogy a művelet [i]még mindig[/i] le van nyomva. Gyors lenyomás és felengedés esetén is [code]true[/code] az eredmény, így az esemény nem vész el.\n[b]Megjegyzés:[/b] A billentyűzet együttes lenyomást érintő hardverkorlátai miatt az [method is_action_just_pressed] akkor is visszaadhat [code]false[/code] értéket, ha a művelet valamelyik billentyűje le van nyomva. Lásd a dokumentáció [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]bemenetkezelési példáit[/url]."

#. Input.is_action_just_released
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] when the user [i]stops[/i] pressing the action event in the current frame or physics tick. It will only return [code]true[/code] on the frame or tick that the user releases the button.\n[b]Note:[/b] Returning [code]true[/code] does not imply that the action is [i]still[/i] not pressed. An action can be released and pressed again rapidly, and [code]true[/code] will still be returned so as not to miss input.\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events.\n[b]Note:[/b] During input handling (e.g. [method Node._input]), use [method InputEvent.is_action_released] instead to query the action state of the current event. See also [method is_action_just_released_by_event]."
msgstr "[code]true[/code] értéket ad vissza, ha a felhasználó az aktuális képkockán vagy fizikai lépésben [i]felengedi[/i] a művelethez tartozó vezérlőt. Csak abban a képkockában vagy lépésben ad [code]true[/code] értéket, amelyikben felengedték a gombot.\n[b]Megjegyzés:[/b] A [code]true[/code] eredményből nem következik, hogy a művelet [i]továbbra is[/i] felengedett állapotban van. Gyors felengedés és újabb lenyomás esetén is [code]true[/code] az eredmény, így az esemény nem vész el.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát.\n[b]Megjegyzés:[/b] Bemenetkezeléskor, például a [method Node._input] metódusban, a [method InputEvent.is_action_released] metódussal kérdezd le az aktuális esemény műveletállapotát. Lásd még az [method is_action_just_released_by_event] metódust."

#. Input.is_action_just_released_by_event
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] when the user [i]stops[/i] pressing the action event in the current frame or physics tick, and the first event that triggered action release in the current frame/physics tick was [param event]. It will only return [code]true[/code] on the frame or tick that the user releases the button.\nThis is useful when an action is processed during input handling (e.g. [method Node._input]).\n[b]Note:[/b] Returning [code]true[/code] does not imply that the action is [i]still[/i] not pressed. An action can be released and pressed again rapidly, and [code]true[/code] will still be returned so as not to miss input.\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events."
msgstr "[code]true[/code] értéket ad vissza, ha a felhasználó az aktuális képkockán vagy fizikai lépésben [i]felengedi[/i] a művelethez tartozó vezérlőt, és a felengedést először a [param event] váltotta ki. Csak abban a képkockában vagy lépésben ad [code]true[/code] értéket, amelyikben felengedték a gombot.\nEz akkor hasznos, ha a művelet feldolgozása a bemenetkezeléskor történik, például a [method Node._input] metódusban.\n[b]Megjegyzés:[/b] A [code]true[/code] eredményből nem következik, hogy a művelet [i]továbbra is[/i] felengedett állapotban van. Gyors felengedés és újabb lenyomás esetén is [code]true[/code] az eredmény, így az esemény nem vész el.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát."

#. Input.is_action_pressed
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if you are pressing the action event.\nIf [param exact_match] is [code]false[/code], it ignores additional input modifiers for [InputEventKey] and [InputEventMouseButton] events, and the direction for [InputEventJoypadMotion] events.\n[b]Note:[/b] Due to keyboard ghosting, [method is_action_pressed] may return [code]false[/code] even if one of the action's keys is pressed. See [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]Input examples[/url] in the documentation for more information."
msgstr "[code]true[/code] értéket ad vissza, ha a művelethez tartozó vezérlő le van nyomva.\nHa a [param exact_match] értéke [code]false[/code], figyelmen kívül hagyja az [InputEventKey] és az [InputEventMouseButton] események további módosítóit, valamint az [InputEventJoypadMotion] események irányát.\n[b]Megjegyzés:[/b] A billentyűzet együttes lenyomást érintő hardverkorlátai miatt az [method is_action_pressed] akkor is visszaadhat [code]false[/code] értéket, ha a művelet valamelyik billentyűje le van nyomva. Lásd a dokumentáció [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]bemenetkezelési példáit[/url]."

#. Input.is_anything_pressed
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if any action, key, joypad button, or mouse button is being pressed. This will also return [code]true[/code] if any action is simulated via code by calling [method action_press]."
msgstr "[code]true[/code] értéket ad vissza, ha bármelyik művelet, billentyű, játékvezérlő-gomb vagy egérgomb le van nyomva. Akkor is [code]true[/code] az eredmény, ha a műveletet kódból, a [method action_press] metódussal szimulálják."

#. Input.is_joy_button_pressed
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if you are pressing the joypad button at index [param button].\n[b]Note:[/b] If you want to check if a joypad button was just pressed, use Godot's input action system with [method is_action_just_pressed] or use the [method Node._input] method like this instead:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventJoypadButton and event.is_pressed() and event.button_index == JOY_BUTTON_A:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventJoypadButton eventButton && eventButton.Pressed && eventButton.ButtonIndex == JoyButton.A)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "[code]true[/code] értéket ad vissza, ha a játékvezérlő [param button] indexű gombja le van nyomva.\n[b]Megjegyzés:[/b] Annak ellenőrzésére, hogy éppen most nyomták-e meg a gombot, használd a Godot bemeneti műveleteit az [method is_action_just_pressed] metódussal, vagy a [method Node._input] metódust az alábbi módon:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventJoypadButton and event.is_pressed() and event.button_index == JOY_BUTTON_A:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventJoypadButton eventButton && eventButton.Pressed && eventButton.ButtonIndex == JoyButton.A)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"

#. Input.is_joy_known
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if the system knows the specified device. This means that it sets all button and axis indices. Unknown joypads are not expected to match these constants, but you can still retrieve events from them."
msgstr "[code]true[/code] értéket ad vissza, ha a rendszer ismeri a megadott eszközt, és be tudja állítani az összes gomb és tengely indexét. Ismeretlen vezérlőknél az indexek eltérhetnek az állandóktól, de az eszköztől így is fogadhatsz eseményeket."

#. Input.is_joy_motion_sensors_calibrated
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if the joypad's motion sensors have been calibrated.\nSee [method start_joy_motion_sensors_calibration] for an example on how to use joypad motion sensors and calibration in your games.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "[code]true[/code] értéket ad vissza, ha a játékvezérlő mozgásérzékelői kalibrálva vannak.\nA [method start_joy_motion_sensors_calibration] metódusnál példát találsz a mozgásérzékelők játékbeli használatára és kalibrálására.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.is_joy_motion_sensors_calibrating
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if the joypad's motion sensors are currently being calibrated.\nSee [method start_joy_motion_sensors_calibration] for an example on how to use joypad motion sensors and calibration in your games.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "[code]true[/code] értéket ad vissza, ha a játékvezérlő mozgásérzékelőinek kalibrálása jelenleg folyamatban van.\nA [method start_joy_motion_sensors_calibration] metódusnál példát találsz a mozgásérzékelők játékbeli használatára és kalibrálására.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.is_joy_motion_sensors_enabled
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if the requested joypad has motion sensors (accelerometer and gyroscope) and they are currently enabled. See also [method set_joy_motion_sensors_enabled] and [method has_joy_motion_sensors].\nSee [method start_joy_motion_sensors_calibration] for an example on how to use joypad motion sensors and calibration in your games.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott játékvezérlő rendelkezik mozgásérzékelőkkel (gyorsulásmérővel és giroszkóppal), és ezek jelenleg be vannak kapcsolva. Lásd még a [method set_joy_motion_sensors_enabled] és a [method has_joy_motion_sensors] metódust.\nA [method start_joy_motion_sensors_calibration] metódusnál példát találsz a mozgásérzékelők játékbeli használatára és kalibrálására.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.is_joy_vibrating
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if the joypad is still vibrating after a call to [method start_joy_vibration].\nUnlike [method get_joy_vibration_strength] and [method get_joy_vibration_duration], this method returns [code]false[/code] after the joypad's vibration runs out."
msgstr "[code]true[/code] értéket ad vissza, ha a játékvezérlő a [method start_joy_vibration] hívása után még rezeg.\nA [method get_joy_vibration_strength] és a [method get_joy_vibration_duration] metódustól eltérően a rezgés végén [code]false[/code] értéket ad vissza."

#. Input.is_key_label_pressed
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if you are pressing the key with the [param keycode] printed on it. You can pass a [enum Key] constant or any Unicode character code.\n[b]Note:[/b] If you want to check if a key was just pressed by using its label, use Godot's input action system with [method is_action_just_pressed] or use the [method Node._input] method like this instead:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventKey and not event.is_echo() and event.is_pressed() and event.key_label == KEY_SPACE:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventKey eventKey && !eventKey.IsEcho() && eventKey.Pressed && eventKey.KeyLabel == Key.Space)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "[code]true[/code] értéket ad vissza, ha a [param keycode] feliratú billentyű le van nyomva. A paraméter lehet egy [enum Key] állandó vagy bármely Unicode-karakterkód.\n[b]Megjegyzés:[/b] Annak ellenőrzésére, hogy egy felirata alapján azonosított billentyűt éppen most nyomtak-e le, használd a Godot bemeneti műveleteit az [method is_action_just_pressed] metódussal, vagy a [method Node._input] metódust az alábbi módon:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventKey and not event.is_echo() and event.is_pressed() and event.key_label == KEY_SPACE:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventKey eventKey && !eventKey.IsEcho() && eventKey.Pressed && eventKey.KeyLabel == Key.Space)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"

#. Input.is_key_pressed
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if you are pressing the Latin key in the current keyboard layout. You can pass a [enum Key] constant.\n[method is_key_pressed] is only recommended over [method is_physical_key_pressed] in non-game applications. This ensures that shortcut keys behave as expected depending on the user's keyboard layout, as keyboard shortcuts are generally dependent on the keyboard layout in non-game applications. If in doubt, use [method is_physical_key_pressed].\n[b]Note:[/b] Due to keyboard ghosting, [method is_key_pressed] may return [code]false[/code] even if one of the action's keys is pressed. See [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]Input examples[/url] in the documentation for more information.\n[b]Note:[/b] If you want to check if a key was just pressed by using its keycode, use Godot's input action system with [method is_action_just_pressed] or use the [method Node._input] method like this instead:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventKey and not event.is_echo() and event.is_pressed() and event.keycode == KEY_SPACE:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventKey eventKey && !eventKey.IsEcho() && eventKey.Pressed && eventKey.Keycode == Key.Space)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "[code]true[/code] értéket ad vissza, ha az aktuális billentyűzetkiosztás szerinti latin feliratú billentyű le van nyomva. Megadhatsz egy [enum Key] állandót.\nAz [method is_key_pressed] csak játékon kívüli alkalmazásokban javasolt az [method is_physical_key_pressed] helyett. Így a gyorsbillentyűk az alkalmazásban megszokott módon követik a felhasználó billentyűzetkiosztását. Kétség esetén használd az [method is_physical_key_pressed] metódust.\n[b]Megjegyzés:[/b] A billentyűzet együttes lenyomást érintő hardverkorlátai miatt az [method is_key_pressed] akkor is visszaadhat [code]false[/code] értéket, ha a művelet valamelyik billentyűje le van nyomva. Lásd a dokumentáció [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]bemenetkezelési példáit[/url].\n[b]Megjegyzés:[/b] Annak ellenőrzésére, hogy egy kódja alapján azonosított billentyűt éppen most nyomtak-e le, használd a Godot bemeneti műveleteit az [method is_action_just_pressed] metódussal, vagy a [method Node._input] metódust az alábbi módon:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventKey and not event.is_echo() and event.is_pressed() and event.keycode == KEY_SPACE:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventKey eventKey && !eventKey.IsEcho() && eventKey.Pressed && eventKey.Keycode == Key.Space)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"

#. Input.is_mouse_button_pressed
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if you are pressing the mouse button specified with [enum MouseButton].\n[b]Note:[/b] If you want to check if a mouse button was just pressed, use Godot's input action system with [method is_action_just_pressed] or use the [method Node._input] method like this instead:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventMouseButton and event.is_pressed() and event.button_index == MOUSE_BUTTON_LEFT:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventMouseButton eventMouseButton && eventMouseButton.Pressed && eventMouseButton.ButtonIndex == MouseButton.Left)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [enum MouseButton] egérgomb le van nyomva.\n[b]Megjegyzés:[/b] Annak ellenőrzésére, hogy éppen most nyomták-e le az egérgombot, használd a Godot bemeneti műveleteit az [method is_action_just_pressed] metódussal, vagy a [method Node._input] metódust az alábbi módon:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventMouseButton and event.is_pressed() and event.button_index == MOUSE_BUTTON_LEFT:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventMouseButton eventMouseButton && eventMouseButton.Pressed && eventMouseButton.ButtonIndex == MouseButton.Left)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"

#. Input.is_physical_key_pressed
#: doc/classes/Input.xml
msgid "Returns [code]true[/code] if you are pressing the key in the physical location on the 101/102-key US QWERTY keyboard. You can pass a [enum Key] constant.\n[method is_physical_key_pressed] is recommended over [method is_key_pressed] for in-game actions, as it will make [kbd]W[/kbd]/[kbd]A[/kbd]/[kbd]S[/kbd]/[kbd]D[/kbd] layouts work regardless of the user's keyboard layout. [method is_physical_key_pressed] will also ensure that the top row number keys work on any keyboard layout. If in doubt, use [method is_physical_key_pressed].\n[b]Note:[/b] Due to keyboard ghosting, [method is_physical_key_pressed] may return [code]false[/code] even if one of the action's keys is pressed. See [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]Input examples[/url] in the documentation for more information.\n[b]Note:[/b] If you want to check if a key was just pressed by using its physical keycode, use Godot's input action system with [method is_action_just_pressed] or use the [method Node._input] method like this instead:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventKey and not event.is_echo() and event.is_pressed() and event.physical_keycode == KEY_SPACE:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventKey eventKey && !eventKey.IsEcho() && eventKey.Pressed && eventKey.PhysicalKeycode == Key.Space)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "[code]true[/code] értéket ad vissza, ha a 101/102 billentyűs amerikai QWERTY billentyűzet adott fizikai pozícióján lévő billentyű le van nyomva. Megadhatsz egy [enum Key] állandót.\nJátékbeli műveletekhez az [method is_physical_key_pressed] javasolt az [method is_key_pressed] helyett. Így a [kbd]W[/kbd]/[kbd]A[/kbd]/[kbd]S[/kbd]/[kbd]D[/kbd] elrendezés a felhasználó kiosztásától függetlenül működik. Az [method is_physical_key_pressed] azt is biztosítja, hogy a felső sor számbillentyűi bármely kiosztáson működjenek. Kétség esetén használd az [method is_physical_key_pressed] metódust.\n[b]Megjegyzés:[/b] A billentyűzet együttes lenyomást érintő hardverkorlátai miatt az [method is_physical_key_pressed] akkor is visszaadhat [code]false[/code] értéket, ha a művelet valamelyik billentyűje le van nyomva. Lásd a dokumentáció [url=$DOCS_URL/tutorials/inputs/input_examples.html#keyboard-events]bemenetkezelési példáit[/url].\n[b]Megjegyzés:[/b] Annak ellenőrzésére, hogy egy fizikai kódja alapján azonosított billentyűt éppen most nyomtak-e le, használd a Godot bemeneti műveleteit az [method is_action_just_pressed] metódussal, vagy a [method Node._input] metódust az alábbi módon:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventKey and not event.is_echo() and event.is_pressed() and event.physical_keycode == KEY_SPACE:\n\t\tpass # Your code here.\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventKey eventKey && !eventKey.IsEcho() && eventKey.Pressed && eventKey.PhysicalKeycode == Key.Space)\n\t{\n\t\t// Your code here.\n\t}\n}\n[/csharp]\n[/codeblocks]"

#. Input.parse_input_event
#: doc/classes/Input.xml
msgid "Feeds an [InputEvent] to the game. Can be used to artificially trigger input events from code. Also generates [method Node._input] calls.\n[codeblocks]\n[gdscript]\nvar cancel_event = InputEventAction.new()\ncancel_event.action = \"ui_cancel\"\ncancel_event.pressed = true\nInput.parse_input_event(cancel_event)\n[/gdscript]\n[csharp]\nvar cancelEvent = new InputEventAction();\ncancelEvent.Action = \"ui_cancel\";\ncancelEvent.Pressed = true;\nInput.ParseInputEvent(cancelEvent);\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] Calling this function has no influence on the operating system. So for example sending an [InputEventMouseMotion] will not move the OS mouse cursor to the specified position (use [method warp_mouse] instead) and sending [kbd]Alt/Cmd + Tab[/kbd] as [InputEventKey] won't toggle between active windows."
msgstr "[InputEvent] eseményt küld a játéknak. Bemeneti események kódból történő kiváltására szolgál, és [method Node._input] hívásokat is előidéz.\n[codeblocks]\n[gdscript]\nvar cancel_event = InputEventAction.new()\ncancel_event.action = \"ui_cancel\"\ncancel_event.pressed = true\nInput.parse_input_event(cancel_event)\n[/gdscript]\n[csharp]\nvar cancelEvent = new InputEventAction();\ncancelEvent.Action = \"ui_cancel\";\ncancelEvent.Pressed = true;\nInput.ParseInputEvent(cancelEvent);\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] A metódus nem módosítja az operációs rendszer állapotát. Az [InputEventMouseMotion] elküldése például nem mozgatja a rendszer egérmutatóját a megadott helyre (ehhez a [method warp_mouse] metódust használd), és a [kbd]Alt/Cmd + Tab[/kbd] kombináció [InputEventKey] eseményként történő elküldése sem vált az aktív ablakok között."

#. Input.remove_joy_mapping
#: doc/classes/Input.xml
msgid "Removes all mappings from the internal database that match the given GUID. All currently connected joypads that use this GUID will become unmapped.\nOn Android, Godot will map to an internal fallback mapping."
msgstr "Eltávolítja a belső adatbázisból a megadott GUID-hoz tartozó összes leképezést. Az ezt a GUID-ot használó, már csatlakoztatott vezérlők leképezése megszűnik.\nAndroidon a Godot belső tartalék leképezést rendel hozzájuk."

#. Input.set_accelerometer
#: doc/classes/Input.xml
msgid "Sets the acceleration value of the accelerometer sensor. Can be used for debugging on devices without a hardware sensor, for example in an editor on a PC.\n[b]Note:[/b] This value can be immediately overwritten by the hardware sensor value on Android and iOS."
msgstr "Beállítja a gyorsulásmérő gyorsulási értékét. Hardveres érzékelő nélküli eszközön is használható hibakeresésre, például személyi számítógépen futó szerkesztőben.\n[b]Megjegyzés:[/b] Androidon és iOS-en a hardveres érzékelő értéke azonnal felülírhatja ezt az értéket."

#. Input.set_custom_mouse_cursor
#: doc/classes/Input.xml
msgid "Sets a custom mouse cursor image, which is only visible inside the game window, for the given mouse [param shape]. The hotspot can also be specified. Passing [code]null[/code] to the image parameter resets to the system cursor.\n[param image] can be either [Texture2D] or [Image] and its size must be lower than or equal to 256×256. To avoid rendering issues, sizes lower than or equal to 128×128 are recommended.\n[param hotspot] must be within [param image]'s size.\n[b]Note:[/b] [AnimatedTexture]s aren't supported as custom mouse cursors. If using an [AnimatedTexture], only the first frame will be displayed.\n[b]Note:[/b] The [b]Lossless[/b], [b]Lossy[/b] or [b]Uncompressed[/b] compression modes are recommended. The [b]Video RAM[/b] compression mode can be used, but it will be decompressed on the CPU, which means loading times are slowed down and no memory is saved compared to lossless modes.\n[b]Note:[/b] On the web platform, the maximum allowed cursor image size is 128×128. Cursor images larger than 32×32 will also only be displayed if the mouse cursor image is entirely located within the page for [url=https://chromestatus.com/feature/5825971391299584]security reasons[/url]."
msgstr "Egyéni egérmutatóképet állít be a megadott [param shape] alakhoz. A kép csak a játékablakon belül látható. Az aktív pont is megadható. Ha a kép paramétere [code]null[/code], visszaáll a rendszer egérmutatója.\nA [param image] lehet [Texture2D] vagy [Image]. A mérete legfeljebb 256×256 lehet. A megjelenítési problémák elkerüléséhez legfeljebb 128×128 méret ajánlott.\nA [param hotspot] pontnak a [param image] határain belül kell lennie.\n[b]Megjegyzés:[/b] Az [AnimatedTexture] nem támogatott egyéni egérmutatóként. Ha [AnimatedTexture] textúrát adsz meg, csak az első képkocka jelenik meg.\n[b]Megjegyzés:[/b] A [b]Lossless[/b] (veszteségmentes), a [b]Lossy[/b] (veszteséges) vagy az [b]Uncompressed[/b] (tömörítetlen) mód ajánlott. A [b]Video RAM[/b] mód is használható, de a kitömörítést a processzor végzi, ezért a betöltés lassabb, és a veszteségmentes módhoz képest nincs memória-megtakarítás.\n[b]Megjegyzés:[/b] Weben az egérmutató képének megengedett legnagyobb mérete 128×128. A 32×32 méretnél nagyobb képek [url=https://chromestatus.com/feature/5825971391299584]biztonsági okokból[/url] csak akkor jelennek meg, ha a teljes kép elfér az oldalon belül."

#. Input.set_default_cursor_shape
#: doc/classes/Input.xml
msgid "Sets the default cursor shape to be used in the viewport instead of [constant CURSOR_ARROW].\n[b]Note:[/b] If you want to change the default cursor shape for [Control]'s nodes, use [member Control.mouse_default_cursor_shape] instead.\n[b]Note:[/b] This method generates an [InputEventMouseMotion] to update cursor immediately."
msgstr "Megadja, melyik egérmutató legyen a nézetablakban az alapértelmezett a [constant CURSOR_ARROW] helyett.\n[b]Megjegyzés:[/b] Ha a [Control] csomópontok alapértelmezett egérmutatóját szeretnéd módosítani, használd a [member Control.mouse_default_cursor_shape] tulajdonságot.\n[b]Megjegyzés:[/b] Az egérmutató azonnali frissítéséhez a metódus [InputEventMouseMotion] eseményt hoz létre."

#. Input.set_gravity
#: doc/classes/Input.xml
msgid "Sets the gravity value of the accelerometer sensor. Can be used for debugging on devices without a hardware sensor, for example in an editor on a PC.\n[b]Note:[/b] This value can be immediately overwritten by the hardware sensor value on Android and iOS."
msgstr "Beállítja a gyorsulásmérő gravitációs értékét. Hardveres érzékelő nélküli eszközön is használható hibakeresésre, például személyi számítógépen futó szerkesztőben.\n[b]Megjegyzés:[/b] Androidon és iOS-en a hardveres érzékelő értéke azonnal felülírhatja ezt az értéket."

#. Input.set_gyroscope
#: doc/classes/Input.xml
msgid "Sets the value of the rotation rate of the gyroscope sensor. Can be used for debugging on devices without a hardware sensor, for example in an editor on a PC.\n[b]Note:[/b] This value can be immediately overwritten by the hardware sensor value on Android and iOS."
msgstr "Beállítja a giroszkóp szögsebességének értékét. Hardveres érzékelő nélküli eszközön is használható hibakeresésre, például személyi számítógépen futó szerkesztőben.\n[b]Megjegyzés:[/b] Androidon és iOS-en a hardveres érzékelő értéke azonnal felülírhatja ezt az értéket."

#. Input.set_joy_light
#: doc/classes/Input.xml
msgid "Sets the joypad's LED light, if available, to the specified color. See also [method has_joy_light].\n[b]Note:[/b] There is no way to get the color of the light from a joypad. If you need to know the assigned color, store it separately.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "A megadott színre állítja a játékvezérlő LED-jét, ha rendelkezik ilyennel. Lásd még a [method has_joy_light] metódust.\n[b]Megjegyzés:[/b] A LED színe nem olvasható ki a játékvezérlőből. Ha később is szükség van a beállított színre, tárold külön.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.set_joy_motion_sensors_calibration
#: doc/classes/Input.xml
msgid "Sets the specified joypad's calibration information. See also [method get_joy_motion_sensors_calibration].\nSee [method start_joy_motion_sensors_calibration] for an example on how to use joypad motion sensors and calibration in your games.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "Beállítja a megadott játékvezérlő kalibrációs adatait. Lásd még a [method get_joy_motion_sensors_calibration] metódust.\nA [method start_joy_motion_sensors_calibration] metódusnál példát találsz a mozgásérzékelők játékbeli használatára és kalibrálására.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.set_joy_motion_sensors_enabled
#: doc/classes/Input.xml
msgid "Enables or disables the motion sensors (accelerometer and gyroscope), if available, on the specified joypad.\nSee [method start_joy_motion_sensors_calibration] for an example on how to use joypad motion sensors and calibration in your games.\nIt's recommended to disable the motion sensors when they're no longer being used, because otherwise it might drain the controller battery faster.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "Be- vagy kikapcsolja a megadott játékvezérlő mozgásérzékelőit (a gyorsulásmérőt és a giroszkópot), ha rendelkezik ilyenekkel.\nA [method start_joy_motion_sensors_calibration] metódusnál példát találsz a mozgásérzékelők játékbeli használatára és kalibrálására.\nHa már nem használod a mozgásérzékelőket, érdemes kikapcsolni őket, különben a vezérlő akkumulátora gyorsabban merülhet.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.set_magnetometer
#: doc/classes/Input.xml
msgid "Sets the value of the magnetic field of the magnetometer sensor. Can be used for debugging on devices without a hardware sensor, for example in an editor on a PC.\n[b]Note:[/b] This value can be immediately overwritten by the hardware sensor value on Android and iOS."
msgstr "Beállítja a magnetométer által jelzett mágneses mező értékét. Hardveres érzékelő nélküli eszközön is használható hibakeresésre, például személyi számítógépen futó szerkesztőben.\n[b]Megjegyzés:[/b] Androidon és iOS-en a hardveres érzékelő értéke azonnal felülírhatja ezt az értéket."

#. Input.should_ignore_device
#: doc/classes/Input.xml
msgid "Queries whether an input device should be ignored or not. Devices can be ignored by setting the environment variable [code]SDL_GAMECONTROLLER_IGNORE_DEVICES[/code]. Read the [url=https://wiki.libsdl.org/SDL2]SDL documentation[/url] for more information.\n[b]Note:[/b] Some 3rd party tools can contribute to the list of ignored devices. For example, [i]SteamInput[/i] creates virtual devices from physical devices for remapping purposes. To avoid handling the same input device twice, the original device is added to the ignore list."
msgstr "Megadja, hogy figyelmen kívül kell-e hagyni egy bemeneti eszközt. A mellőzendő eszközök a [code]SDL_GAMECONTROLLER_IGNORE_DEVICES[/code] környezeti változóval adhatók meg. További részletek az [url=https://wiki.libsdl.org/SDL2]SDL dokumentációjában[/url] találhatók.\n[b]Megjegyzés:[/b] Külső eszközök is bővíthetik a figyelmen kívül hagyott eszközök listáját. A [i]SteamInput[/i] például a fizikai eszközökből virtuális eszközöket hoz létre az újraleképezéshez. Az eredeti eszközt felveszi a listára, hogy ugyanazt a bemenetet ne dolgozzák fel kétszer."

#. Input.start_joy_motion_sensors_calibration
#: doc/classes/Input.xml
msgid "Starts the process of calibrating the specified joypad's gyroscope, if it has one.\nOnce a joypad's gyroscope has been calibrated correctly (e.g. laying still on a table without being rotated), [method get_joy_gyroscope] will return values close or equal to [constant Vector3.ZERO] when the joypad is not being rotated.\nHere's an example of how to use joypad gyroscope and gyroscope calibration in your games:\n[codeblocks]\n[gdscript]\nconst GYRO_SENSITIVITY = 10.0\n\nfunc _ready():\n\t# In this example we only use the first connected joypad (id 0).\n\tif 0 not in Input.get_connected_joypads():\n\t\treturn\n\n\tif not Input.has_joy_motion_sensors(0):\n\t\treturn\n\n\t# We must enable the motion sensors before using them.\n\tInput.set_joy_motion_sensors_enabled(0, true)\n\n\t# (Tell the users here that they need to put their joypads on a flat surface and wait for confirmation.)\n\n\t# Start the calibration process.\n\tcalibrate_motion()\n\nfunc _process(delta):\n\t# Only move the object if the joypad motion sensors are calibrated.\n\tif Input.is_joy_motion_sensors_calibrated(0):\n\t\tmove_object(delta)\n\nfunc calibrate_motion():\n\tInput.start_joy_motion_sensors_calibration(0)\n\n\t# Wait for some time.\n\tawait get_tree().create_timer(1.0).timeout\n\n\tInput.stop_joy_motion_sensors_calibration(0)\n\t# The joypad is now calibrated.\n\nfunc move_object(delta):\n\tvar node: Node3D = ... # Put your node here.\n\n\tvar gyro := Input.get_joy_gyroscope(0)\n\tnode.rotation.x -= -gyro.y * GYRO_SENSITIVITY * delta # Use rotation around the Y axis (yaw) here.\n\tnode.rotation.y += -gyro.x * GYRO_SENSITIVITY * delta # Use rotation around the X axis (pitch) here.\n[/gdscript]\n[csharp]\nprivate const float GyroSensitivity = 10.0;\n\npublic override void _Ready()\n{\n\t// In this example we only use the first connected joypad (id 0).\n\tif (!Input.GetConnectedJoypads().Contains(0))\n\t{\n\t\treturn;\n\t}\n\n\tif (!Input.HasJoyMotionSensors(0))\n\t{\n\t\treturn;\n\t}\n\n\t// We must enable the accelerometer and the gyroscope before using them.\n\tInput.SetJoyMotionSensorsEnabled(0, true);\n\n\t// (Tell the users here that they need to put their joypads on a flat surface and wait for confirmation.)\n\n\t// Start the calibration process.\n\tCalibrateMotion();\n}\n\npublic override void _Process(double delta)\n{\n\t// Only move the object if the joypad motion sensors are calibrated.\n\tif (Input.IsJoyMotionSensorsCalibrated(0))\n\t{\n\t\tMoveObject(delta);\n\t}\n}\n\nprivate async Task CalibrateMotion()\n{\n\tInput.StartJoyMotionSensorsCalibration(0);\n\n\t// Wait for some time.\n\tawait ToSignal(GetTree().CreateTimer(1.0), SceneTreeTimer.SignalName.Timeout);\n\n\tInput.StopJoyMotionSensorsCalibration(0);\n\t// The joypad is now calibrated.\n}\n\nprivate void MoveObject(double delta)\n{\n\tNode3D node = ... ; // Put your object here.\n\tVector3 gyro = Input.GetJoyGyroscope(0);\n\tVector3 rotation = node.Rotation;\n\trotation.X -= -gyro.Y * GyroSensitivity * (float)delta; // Use rotation around the Y axis (yaw) here.\n\trotation.Y += -gyro.X * GyroSensitivity * (float)delta; // Use rotation around the X axis (pitch) here.\n\tnode.Rotation = rotation;\n}\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] Accelerometer sensor doesn't usually require calibration.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "Elindítja a megadott játékvezérlő giroszkópjának kalibrálását, ha rendelkezik ilyen érzékelővel.\nHa a játékvezérlő giroszkópját helyesen kalibrálták, például a vezérlő mozdulatlanul feküdt egy asztalon, a [method get_joy_gyroscope] a [constant Vector3.ZERO] értékéhez közeli vagy azzal egyező értékeket ad vissza, amikor a vezérlő nem forog.\nAz alábbi példa a giroszkóp játékbeli használatát és kalibrálását mutatja be:\n[codeblocks]\n[gdscript]\nconst GYRO_SENSITIVITY = 10.0\n\nfunc _ready():\n\t# In this example we only use the first connected joypad (id 0).\n\tif 0 not in Input.get_connected_joypads():\n\t\treturn\n\n\tif not Input.has_joy_motion_sensors(0):\n\t\treturn\n\n\t# We must enable the motion sensors before using them.\n\tInput.set_joy_motion_sensors_enabled(0, true)\n\n\t# (Tell the users here that they need to put their joypads on a flat surface and wait for confirmation.)\n\n\t# Start the calibration process.\n\tcalibrate_motion()\n\nfunc _process(delta):\n\t# Only move the object if the joypad motion sensors are calibrated.\n\tif Input.is_joy_motion_sensors_calibrated(0):\n\t\tmove_object(delta)\n\nfunc calibrate_motion():\n\tInput.start_joy_motion_sensors_calibration(0)\n\n\t# Wait for some time.\n\tawait get_tree().create_timer(1.0).timeout\n\n\tInput.stop_joy_motion_sensors_calibration(0)\n\t# The joypad is now calibrated.\n\nfunc move_object(delta):\n\tvar node: Node3D = ... # Put your node here.\n\n\tvar gyro := Input.get_joy_gyroscope(0)\n\tnode.rotation.x -= -gyro.y * GYRO_SENSITIVITY * delta # Use rotation around the Y axis (yaw) here.\n\tnode.rotation.y += -gyro.x * GYRO_SENSITIVITY * delta # Use rotation around the X axis (pitch) here.\n[/gdscript]\n[csharp]\nprivate const float GyroSensitivity = 10.0;\n\npublic override void _Ready()\n{\n\t// In this example we only use the first connected joypad (id 0).\n\tif (!Input.GetConnectedJoypads().Contains(0))\n\t{\n\t\treturn;\n\t}\n\n\tif (!Input.HasJoyMotionSensors(0))\n\t{\n\t\treturn;\n\t}\n\n\t// We must enable the accelerometer and the gyroscope before using them.\n\tInput.SetJoyMotionSensorsEnabled(0, true);\n\n\t// (Tell the users here that they need to put their joypads on a flat surface and wait for confirmation.)\n\n\t// Start the calibration process.\n\tCalibrateMotion();\n}\n\npublic override void _Process(double delta)\n{\n\t// Only move the object if the joypad motion sensors are calibrated.\n\tif (Input.IsJoyMotionSensorsCalibrated(0))\n\t{\n\t\tMoveObject(delta);\n\t}\n}\n\nprivate async Task CalibrateMotion()\n{\n\tInput.StartJoyMotionSensorsCalibration(0);\n\n\t// Wait for some time.\n\tawait ToSignal(GetTree().CreateTimer(1.0), SceneTreeTimer.SignalName.Timeout);\n\n\tInput.StopJoyMotionSensorsCalibration(0);\n\t// The joypad is now calibrated.\n}\n\nprivate void MoveObject(double delta)\n{\n\tNode3D node = ... ; // Put your object here.\n\tVector3 gyro = Input.GetJoyGyroscope(0);\n\tVector3 rotation = node.Rotation;\n\trotation.X -= -gyro.Y * GyroSensitivity * (float)delta; // Use rotation around the Y axis (yaw) here.\n\trotation.Y += -gyro.X * GyroSensitivity * (float)delta; // Use rotation around the X axis (pitch) here.\n\tnode.Rotation = rotation;\n}\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] A gyorsulásmérőt rendszerint nem kell kalibrálni.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.start_joy_vibration
#: doc/classes/Input.xml
msgid "Starts to vibrate the joypad. See also [method has_joy_vibration] and [method is_joy_vibrating].\nJoypads usually come with two rumble motors, a strong and a weak one.\n[param weak_magnitude] is the strength of the weak motor (between [code]0.0[/code] and [code]1.0[/code]).\n[param strong_magnitude] is the strength of the strong motor (between [code]0.0[/code] and [code]1.0[/code]).\n[param duration] is the duration of the effect in seconds (a duration of [code]0.0[/code] will try to play the vibration as long as possible, which is about 65 seconds).\nThe vibration can be stopped early by calling [method stop_joy_vibration].\nSee also [method get_joy_vibration_strength] and [method get_joy_vibration_duration].\n[b]Note:[/b] For macOS, vibration is only supported in macOS 11 and later. When connected via USB, vibration is only supported for major brand controllers (except Xbox One and Xbox Series X/S controllers) due to macOS limitations."
msgstr "Elindítja a játékvezérlő rezgését. Lásd még a [method has_joy_vibration] és az [method is_joy_vibrating] metódust.\nA játékvezérlőkben általában két rezgőmotor található, egy erős és egy gyenge.\nA [param weak_magnitude] a gyenge motor erőssége [code]0.0[/code] és [code]1.0[/code] között.\nA [param strong_magnitude] az erős motor erőssége [code]0.0[/code] és [code]1.0[/code] között.\nA [param duration] a rezgés időtartama másodpercben. [code]0.0[/code] időtartamnál a motor a lehető leghosszabb ideig próbálja fenntartani a rezgést, ami körülbelül 65 másodperc.\nA rezgést a [method stop_joy_vibration] metódussal idő előtt leállíthatod.\nLásd még a [method get_joy_vibration_strength] és a [method get_joy_vibration_duration] metódust.\n[b]Megjegyzés:[/b] A rezgés a macOS 11 és újabb verzióin támogatott. USB-csatlakozás esetén a macOS korlátozásai miatt a funkció csak a nagyobb gyártók vezérlőin működik, az Xbox One és az Xbox Series X/S vezérlők kivételével."

#. Input.stop_joy_motion_sensors_calibration
#: doc/classes/Input.xml
msgid "Stops the calibration process of the specified joypad's motion sensors.\nSee [method start_joy_motion_sensors_calibration] for an example on how to use joypad motion sensors and calibration in your games.\n[b]Note:[/b] This feature is only supported on Windows, Linux, macOS, and iOS."
msgstr "Leállítja a megadott játékvezérlő mozgásérzékelőinek kalibrálását.\nA [method start_joy_motion_sensors_calibration] metódusnál példát találsz a mozgásérzékelők játékbeli használatára és kalibrálására.\n[b]Megjegyzés:[/b] Ez a funkció csak Windowson, Linuxon, macOS-en és iOS-en támogatott."

#. Input.stop_joy_vibration
#: doc/classes/Input.xml
msgid "Stops the vibration of the joypad started with [method start_joy_vibration]."
msgstr "Leállítja a játékvezérlő [method start_joy_vibration] metódussal elindított rezgését."

#. Input.vibrate_handheld
#: doc/classes/Input.xml
msgid "Vibrate the handheld device for the specified duration in milliseconds.\n[param amplitude] is the strength of the vibration, as a value between [code]0.0[/code] and [code]1.0[/code]. If set to [code]-1.0[/code], the default vibration strength of the device is used.\n[b]Note:[/b] This method is implemented on Android, iOS, and Web. It has no effect on other platforms.\n[b]Note:[/b] For Android, [method vibrate_handheld] requires enabling the [code]VIBRATE[/code] permission in the export preset. Otherwise, [method vibrate_handheld] will have no effect.\n[b]Note:[/b] For iOS, specifying the duration is only supported in iOS 13 and later.\n[b]Note:[/b] For Web, the amplitude cannot be changed.\n[b]Note:[/b] Some web browsers such as Safari and Firefox for Android do not support [method vibrate_handheld].\n[b]Note:[/b] Device settings such as vibration on/off, \"do not disturb\" mode or specific haptic feedback on/off may prevent [method vibrate_handheld] effects."
msgstr "A megadott ideig rezegteti a hordozható eszközt. Az időtartam ezredmásodpercben értendő.\nA [param amplitude] a rezgés erőssége [code]0.0[/code] és [code]1.0[/code] között. [code]-1.0[/code] értéknél az eszköz alapértelmezett rezgéserősségét használja.\n[b]Megjegyzés:[/b] A metódus Androidon, iOS-en és weben érhető el. Más platformokon nincs hatása.\n[b]Megjegyzés:[/b] Androidon a [method vibrate_handheld] működéséhez engedélyezni kell a [code]VIBRATE[/code] jogosultságot az exportálási beállításkészletben. Egyébként a [method vibrate_handheld] hatástalan.\n[b]Megjegyzés:[/b] iOS-en az időtartam csak az iOS 13 és újabb verzióin adható meg.\n[b]Megjegyzés:[/b] Weben az erősség nem módosítható.\n[b]Megjegyzés:[/b] Egyes böngészők, például a Safari vagy az Androidra készült Firefox nem támogatják a [method vibrate_handheld] metódust.\n[b]Megjegyzés:[/b] Az eszköz beállításai, például a rezgés, a Ne zavarjanak mód vagy egyes tapintási visszajelzések ki- vagy bekapcsolása megakadályozhatják a [method vibrate_handheld] működését."

#. Input.warp_mouse
#: doc/classes/Input.xml
msgid "Sets the mouse position to the specified vector, provided in pixels and relative to an origin at the upper left corner of the currently focused Window Manager game window.\nMouse position is clipped to the limits of the screen resolution, or to the limits of the game window if [enum MouseMode] is set to [constant MOUSE_MODE_CONFINED] or [constant MOUSE_MODE_CONFINED_HIDDEN].\n[b]Note:[/b] [method warp_mouse] is only supported on Windows, macOS and Linux. It has no effect on Android, iOS and Web."
msgstr "Az egérmutatót a megadott vektor helyére mozgatja. A vektort képpontban, az ablakkezelő éppen fókuszban lévő játékablakának bal felső sarkához viszonyítva kell megadni.\nA mutató helye a képernyő felbontásának határain belül marad. Ha az [enum MouseMode] beállítása [constant MOUSE_MODE_CONFINED] vagy [constant MOUSE_MODE_CONFINED_HIDDEN], akkor a játékablak határain belül marad.\n[b]Megjegyzés:[/b] A [method warp_mouse] csak Windowson, macOS-en és Linuxon támogatott. Androidon, iOS-en és weben hatástalan."

#. InputEvent.is_echo
#: doc/classes/InputEvent.xml
msgid "Returns [code]true[/code] if this input event is an echo event (only for events of type [InputEventKey]). An echo event is a repeated key event sent when the user is holding down the key. Any other event type returns [code]false[/code].\n[b]Note:[/b] The rate at which echo events are sent is typically around 20 events per second (after holding down the key for roughly half a second). However, the key repeat delay/speed can be changed by the user or disabled entirely in the operating system settings. To ensure your project works correctly on all configurations, do not assume the user has a specific key repeat configuration in your project's behavior."
msgstr "[code]true[/code] értéket ad vissza, ha ez ismétlődő bemeneti esemény. Ez csak [InputEventKey] típusú eseményeknél fordulhat elő. Az esemény akkor ismétlődik, amikor a felhasználó lenyomva tart egy billentyűt. Minden más eseménytípusnál [code]false[/code] az eredmény.\n[b]Megjegyzés:[/b] Az ismétlődő események általában másodpercenként körülbelül 20-szor érkeznek, nagyjából fél másodpercnyi lenyomva tartás után. A felhasználó azonban az operációs rendszerben módosíthatja az ismétlés késleltetését és sebességét, vagy teljesen ki is kapcsolhatja azt. A projekt helyes működéséhez ne hagyatkozz egy adott ismétlési beállításra."

#. InputEventFromWindow.brief
#: doc/classes/InputEventFromWindow.xml
msgid "Abstract base class for [Viewport]-based input events."
msgstr "A [Viewport] nézetablakhoz tartozó bemeneti események absztrakt alaposztálya."

#. InputEventFromWindow.description
#: doc/classes/InputEventFromWindow.xml
msgid "InputEventFromWindow represents events specifically received by windows. This includes mouse events, keyboard events in focused windows or touch screen actions."
msgstr "Az InputEventFromWindow kifejezetten az ablakok által fogadott eseményeket jelöli. Ide tartoznak az egéresemények, a fókuszban lévő ablakok billentyűeseményei és az érintőképernyős műveletek."

#. InputEventFromWindow.window_id
#: doc/classes/InputEventFromWindow.xml
msgid "The ID of a [Window] that received this event."
msgstr "Az eseményt fogadó [Window] azonosítója."

#. InputEventGesture.brief
#: doc/classes/InputEventGesture.xml
msgid "Abstract base class for touch gestures."
msgstr "Az érintési gesztusok absztrakt alaposztálya."

#. InputEventGesture.description
#: doc/classes/InputEventGesture.xml
msgid "InputEventGestures are sent when a user performs a supported gesture on a touch screen. Gestures can't be emulated using mouse, because they typically require multi-touch."
msgstr "Az InputEventGesture esemény akkor érkezik, amikor a felhasználó támogatott gesztust végez az érintőképernyőn. A gesztusok egérrel nem emulálhatók, mert rendszerint több érintési pontot igényelnek."

#. InputEventGesture.position
#: doc/classes/InputEventGesture.xml
msgid "The local gesture position relative to the [Viewport]. If used in [method Control._gui_input], the position is relative to the current [Control] that received this gesture."
msgstr "A gesztus helye a [Viewport] nézetablakhoz viszonyítva. A [method Control._gui_input] metódusban a gesztust fogadó [Control] helyi koordinátái érvényesek."

#. InputEventMIDI.brief
#: doc/classes/InputEventMIDI.xml
msgid "Represents a MIDI message from a MIDI device, such as a musical keyboard."
msgstr "MIDI-eszközről, például zenei billentyűzetről érkező MIDI-üzenetet jelöl."

#. InputEventMIDI.description
#: doc/classes/InputEventMIDI.xml
msgid "InputEventMIDI stores information about messages from [url=https://en.wikipedia.org/wiki/MIDI]MIDI[/url] (Musical Instrument Digital Interface) devices. These may include musical keyboards, synthesizers, and drum machines.\nMIDI messages can be received over a 5-pin MIDI connector or over USB. If your device supports both be sure to check the settings in the device to see which output it is using.\nBy default, Godot does not detect MIDI devices. You need to call [method OS.open_midi_inputs], first. You can check which devices are detected with [method OS.get_connected_midi_inputs], and close the connection with [method OS.close_midi_inputs].\n[codeblocks]\n[gdscript]\nfunc _ready():\n\tOS.open_midi_inputs()\n\tprint(OS.get_connected_midi_inputs())\n\nfunc _input(input_event):\n\tif input_event is InputEventMIDI:\n\t\t_print_midi_info(input_event)\n\nfunc _print_midi_info(midi_event):\n\tprint(midi_event)\n\tprint(\"Channel \", midi_event.channel)\n\tprint(\"Message \", midi_event.message)\n\tprint(\"Pitch \", midi_event.pitch)\n\tprint(\"Velocity \", midi_event.velocity)\n\tprint(\"Instrument \", midi_event.instrument)\n\tprint(\"Pressure \", midi_event.pressure)\n\tprint(\"Controller number: \", midi_event.controller_number)\n\tprint(\"Controller value: \", midi_event.controller_value)\n[/gdscript]\n[csharp]\npublic override void _Ready()\n{\n\tOS.OpenMidiInputs();\n\tGD.Print(OS.GetConnectedMidiInputs());\n}\n\npublic override void _Input(InputEvent inputEvent)\n{\n\tif (inputEvent is InputEventMidi midiEvent)\n\t{\n\t\tPrintMIDIInfo(midiEvent);\n\t}\n}\n\nprivate void PrintMIDIInfo(InputEventMidi midiEvent)\n{\n\tGD.Print(midiEvent);\n\tGD.Print($\"Channel {midiEvent.Channel}\");\n\tGD.Print($\"Message {midiEvent.Message}\");\n\tGD.Print($\"Pitch {midiEvent.Pitch}\");\n\tGD.Print($\"Velocity {midiEvent.Velocity}\");\n\tGD.Print($\"Instrument {midiEvent.Instrument}\");\n\tGD.Print($\"Pressure {midiEvent.Pressure}\");\n\tGD.Print($\"Controller number: {midiEvent.ControllerNumber}\");\n\tGD.Print($\"Controller value: {midiEvent.ControllerValue}\");\n}\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] Godot does not support MIDI output, so there is no way to emit MIDI messages from Godot. Only MIDI input is supported.\n[b]Note:[/b] On the Web platform, using MIDI input requires a browser permission to be granted first. This permission request is performed when calling [method OS.open_midi_inputs]. MIDI input will not work until the user accepts the permission request."
msgstr "Az InputEventMIDI a [url=https://en.wikipedia.org/wiki/MIDI]MIDI[/url] (Musical Instrument Digital Interface) eszközök üzeneteit tárolja. Ilyen eszköz lehet például a zenei billentyűzet, a szintetizátor vagy a dobgép.\nA MIDI-üzenetek 5 érintkezős MIDI-csatlakozón vagy USB-n keresztül érkezhetnek. Ha az eszköz mindkettőt támogatja, az eszköz beállításaiban ellenőrizd, hogy melyik kimenetet használja.\nA Godot alapértelmezésben nem észleli a MIDI-eszközöket, ezért először hívd meg az [method OS.open_midi_inputs] metódust. Az észlelt eszközöket az [method OS.get_connected_midi_inputs] metódussal kérdezheted le, a kapcsolatot pedig az [method OS.close_midi_inputs] metódussal zárhatod be.\n[codeblocks]\n[gdscript]\nfunc _ready():\n\tOS.open_midi_inputs()\n\tprint(OS.get_connected_midi_inputs())\n\nfunc _input(input_event):\n\tif input_event is InputEventMIDI:\n\t\t_print_midi_info(input_event)\n\nfunc _print_midi_info(midi_event):\n\tprint(midi_event)\n\tprint(\"Channel \", midi_event.channel)\n\tprint(\"Message \", midi_event.message)\n\tprint(\"Pitch \", midi_event.pitch)\n\tprint(\"Velocity \", midi_event.velocity)\n\tprint(\"Instrument \", midi_event.instrument)\n\tprint(\"Pressure \", midi_event.pressure)\n\tprint(\"Controller number: \", midi_event.controller_number)\n\tprint(\"Controller value: \", midi_event.controller_value)\n[/gdscript]\n[csharp]\npublic override void _Ready()\n{\n\tOS.OpenMidiInputs();\n\tGD.Print(OS.GetConnectedMidiInputs());\n}\n\npublic override void _Input(InputEvent inputEvent)\n{\n\tif (inputEvent is InputEventMidi midiEvent)\n\t{\n\t\tPrintMIDIInfo(midiEvent);\n\t}\n}\n\nprivate void PrintMIDIInfo(InputEventMidi midiEvent)\n{\n\tGD.Print(midiEvent);\n\tGD.Print($\"Channel {midiEvent.Channel}\");\n\tGD.Print($\"Message {midiEvent.Message}\");\n\tGD.Print($\"Pitch {midiEvent.Pitch}\");\n\tGD.Print($\"Velocity {midiEvent.Velocity}\");\n\tGD.Print($\"Instrument {midiEvent.Instrument}\");\n\tGD.Print($\"Pressure {midiEvent.Pressure}\");\n\tGD.Print($\"Controller number: {midiEvent.ControllerNumber}\");\n\tGD.Print($\"Controller value: {midiEvent.ControllerValue}\");\n}\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] A Godot csak MIDI-bemenetet támogat, MIDI-üzenetek küldésére nincs lehetőség.\n[b]Megjegyzés:[/b] Weben a MIDI-bemenethez a böngésző engedélye szükséges. A böngésző az [method OS.open_midi_inputs] hívásakor kér engedélyt. A MIDI-bemenet az engedély megadásáig nem működik."

#. InputEventMIDI.channel
#: doc/classes/InputEventMIDI.xml
msgid "The MIDI channel of this message, ranging from [code]0[/code] to [code]15[/code]. MIDI channel [code]9[/code] is reserved for percussion instruments."
msgstr "Az üzenet MIDI-csatornája [code]0[/code] és [code]15[/code] között. A [code]9[/code] MIDI-csatorna az ütőhangszerek számára van fenntartva."

#. InputEventMIDI.controller_number
#: doc/classes/InputEventMIDI.xml
msgid "The unique number of the controller, if [member message] is [constant MIDI_MESSAGE_CONTROL_CHANGE], otherwise this is [code]0[/code]. This value can be used to identify sliders for volume, balance, and panning, as well as switches and pedals on the MIDI device. See the [url=https://en.wikipedia.org/wiki/General_MIDI#Controller_events]General MIDI specification[/url] for a small list."
msgstr "A vezérlő egyedi száma, ha a [member message] értéke [constant MIDI_MESSAGE_CONTROL_CHANGE]. Egyébként az érték [code]0[/code]. Ezzel az értékkel azonosíthatók a MIDI-eszköz hangerő-, balansz- és panorámacsúszkái, valamint kapcsolói és pedáljai. Rövid felsorolás a [url=https://en.wikipedia.org/wiki/General_MIDI#Controller_events]General MIDI specifikációban[/url] található."

#. InputEventMIDI.instrument
#: doc/classes/InputEventMIDI.xml
msgid "The instrument (also called [i]program[/i] or [i]preset[/i]) used on this MIDI message. This value ranges from [code]0[/code] to [code]127[/code].\nTo see what each value means, refer to the [url=https://en.wikipedia.org/wiki/General_MIDI#Program_change_events]General MIDI's instrument list[/url]. Keep in mind that the list is off by 1 because it does not begin from 0. A value of [code]0[/code] corresponds to the acoustic grand piano."
msgstr "Az üzenethez tartozó hangszer, más néven [i]program[/i] vagy [i]előbeállítás[/i]. Értéke [code]0[/code] és [code]127[/code] közötti.\nAz értékek jelentését a [url=https://en.wikipedia.org/wiki/General_MIDI#Program_change_events]General MIDI hangszerlistája[/url] ismerteti. A lista számozása 1-gyel el van tolva, mert nem 0-val kezdődik. A [code]0[/code] érték az akusztikus hangversenyzongorának felel meg."

#. InputEventMIDI.message
#: doc/classes/InputEventMIDI.xml
msgid "Represents the type of MIDI message (see the [enum MIDIMessage] enum).\nFor more information, see the [url=https://www.midi.org/specifications-old/item/table-2-expanded-messages-list-status-bytes]MIDI message status byte list chart[/url]."
msgstr "A MIDI-üzenet típusát jelöli (lásd az [enum MIDIMessage] felsorolást).\nTovábbi részletek a [url=https://www.midi.org/specifications-old/item/table-2-expanded-messages-list-status-bytes]MIDI-üzenetek állapotbájtjainak táblázatában[/url] találhatók."

#. InputEventMIDI.pitch
#: doc/classes/InputEventMIDI.xml
msgid "The pitch index number of this MIDI message. This value ranges from [code]0[/code] to [code]127[/code].\nOn a piano, the [b]middle C[/b] is [code]60[/code], followed by a [b]C-sharp[/b] ([code]61[/code]), then a [b]D[/b] ([code]62[/code]), and so on. Each octave is split in offsets of 12. See the \"MIDI note number\" column of the [url=https://en.wikipedia.org/wiki/Piano_key_frequencies]piano key frequency chart[/url] a full list."
msgstr "A MIDI-üzenet hangmagasságának indexe. Értéke [code]0[/code] és [code]127[/code] közötti.\nZongorán az [b]egyvonalas C[/b] értéke [code]60[/code], ezt követi a [b]Cisz[/b] ([code]61[/code]), majd a [b]D[/b] ([code]62[/code]) és így tovább. Oktávonként 12 félhang van. A teljes listát lásd a [url=https://en.wikipedia.org/wiki/Piano_key_frequencies]zongorabillentyűk frekvenciatáblázatának[/url] MIDI note number oszlopában."

#. InputEventMIDI.pressure
#: doc/classes/InputEventMIDI.xml
msgid "The strength of the key being pressed. This value ranges from [code]0[/code] to [code]127[/code].\n[b]Note:[/b] For many devices, this value is always [code]0[/code]. Other devices such as musical keyboards may simulate pressure by changing the [member velocity], instead."
msgstr "A lenyomott billentyűre kifejtett nyomás erőssége. Értéke [code]0[/code] és [code]127[/code] közötti.\n[b]Megjegyzés:[/b] Sok eszköznél ez az érték mindig [code]0[/code]. Más eszközök, például zenei billentyűzetek a [member velocity] értékének módosításával utánozhatják a nyomást."

#. InputEventMIDI.velocity
#: doc/classes/InputEventMIDI.xml
msgid "The velocity of the MIDI message. This value ranges from [code]0[/code] to [code]127[/code]. For a musical keyboard, this corresponds to how quickly the key was pressed, and is rarely above [code]110[/code] in practice.\n[b]Note:[/b] Some MIDI devices may send a [constant MIDI_MESSAGE_NOTE_ON] message with [code]0[/code] velocity and expect it to be treated the same as a [constant MIDI_MESSAGE_NOTE_OFF] message. If necessary, this can be handled with a few lines of code:\n[codeblock]\nfunc _input(event):\n\tif event is InputEventMIDI:\n\t\tif event.message == MIDI_MESSAGE_NOTE_ON and event.velocity > 0:\n\t\t\tprint(\"Note pressed!\")\n[/codeblock]"
msgstr "A MIDI-üzenet leütési sebessége. Értéke [code]0[/code] és [code]127[/code] közötti. Zenei billentyűzetnél azt jelzi, milyen gyorsan nyomták le a billentyűt, és a gyakorlatban ritkán haladja meg a [code]110[/code] értéket.\n[b]Megjegyzés:[/b] Egyes MIDI-eszközök [constant MIDI_MESSAGE_NOTE_ON] üzenetet küldhetnek [code]0[/code] leütési sebességgel, és elvárják, hogy a fogadó ezt [constant MIDI_MESSAGE_NOTE_OFF] üzenetként kezelje. Ez szükség esetén néhány sornyi kóddal megoldható:\n[codeblock]\nfunc _input(event):\n\tif event is InputEventMIDI:\n\t\tif event.message == MIDI_MESSAGE_NOTE_ON and event.velocity > 0:\n\t\t\tprint(\"Note pressed!\")\n[/codeblock]"

#. InputEventShortcut.brief
#: doc/classes/InputEventShortcut.xml
msgid "Represents a triggered keyboard [Shortcut]."
msgstr "Aktivált billentyűparancsot ([Shortcut]) jelöl."

#. InputEventShortcut.description
#: doc/classes/InputEventShortcut.xml
msgid "InputEventShortcut is a special event that can be received in [method Node._input], [method Node._shortcut_input], and [method Node._unhandled_input]. It is typically sent by the editor's Command Palette to trigger actions, but can also be sent manually using [method Viewport.push_input]."
msgstr "Az InputEventShortcut speciális esemény, amely a [method Node._input], a [method Node._shortcut_input] és a [method Node._unhandled_input] metódusban fogadható. Általában a szerkesztő parancspalettája küldi műveletek indításához, de a [method Viewport.push_input] metódussal kézzel is elküldhető."

#. InputEventShortcut.shortcut
#: doc/classes/InputEventShortcut.xml
msgid "The [Shortcut] represented by this event. Its [method Shortcut.matches_event] method will always return [code]true[/code] for this event."
msgstr "Az eseményben szereplő [Shortcut]. A [method Shortcut.matches_event] metódusa erre az eseményre mindig [code]true[/code] értéket ad vissza."

#. Shortcut.brief
#: doc/classes/Shortcut.xml
msgid "A shortcut for binding input."
msgstr "Bemenet hozzárendelésére szolgáló gyorsbillentyű."

#. Shortcut.description
#: doc/classes/Shortcut.xml
msgid "Shortcuts (also known as hotkeys) are containers of [InputEvent] resources. They are commonly used to interact with a [Control] element from an [InputEvent].\nOne shortcut can contain multiple [InputEvent] resources, making it possible to trigger one action with multiple different inputs.\n[b]Example:[/b] Capture the [kbd]Ctrl + S[/kbd] shortcut using a [Shortcut] resource:\n[codeblocks]\n[gdscript]\nextends Node\n\nvar save_shortcut = Shortcut.new()\nfunc _ready():\n\tvar key_event = InputEventKey.new()\n\tkey_event.keycode = KEY_S\n\tkey_event.ctrl_pressed = true\n\tkey_event.command_or_control_autoremap = true # Swaps Ctrl for Command on Mac.\n\tsave_shortcut.events = [key_event]\n\nfunc _input(event):\n\tif save_shortcut.matches_event(event) and event.is_pressed() and not event.is_echo():\n\t\tprint(\"Save shortcut pressed!\")\n\t\tget_viewport().set_input_as_handled()\n[/gdscript]\n[csharp]\nusing Godot;\n\npublic partial class MyNode : Node\n{\n\tprivate readonly Shortcut _saveShortcut = new Shortcut();\n\n\tpublic override void _Ready()\n\t{\n\t\tInputEventKey keyEvent = new InputEventKey\n\t\t{\n\t\t\tKeycode = Key.S,\n\t\t\tCtrlPressed = true,\n\t\t\tCommandOrControlAutoremap = true, // Swaps Ctrl for Command on Mac.\n\t\t};\n\n\t\t_saveShortcut.Events = [keyEvent];\n\t}\n\n\tpublic override void _Input(InputEvent @event)\n\t{\n\t\tif (@event is InputEventKey keyEvent &&\n\t\t\t_saveShortcut.MatchesEvent(@event) &&\n\t\t\tkeyEvent.Pressed && !keyEvent.Echo)\n\t\t{\n\t\t\tGD.Print(\"Save shortcut pressed!\");\n\t\t\tGetViewport().SetInputAsHandled();\n\t\t}\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "A gyorsbillentyűk [InputEvent] erőforrásokat tartalmaznak. Általában egy [Control] elem [InputEvent] eseménnyel történő vezérlésére szolgálnak.\nEgy gyorsbillentyű több [InputEvent] erőforrást is tartalmazhat, így ugyanaz a művelet többféle bemenettel is kiváltható.\n[b]Példa:[/b] A [kbd]Ctrl + S[/kbd] gyorsbillentyű kezelése egy [Shortcut] erőforrással:\n[codeblocks]\n[gdscript]\nextends Node\n\nvar save_shortcut = Shortcut.new()\nfunc _ready():\n\tvar key_event = InputEventKey.new()\n\tkey_event.keycode = KEY_S\n\tkey_event.ctrl_pressed = true\n\tkey_event.command_or_control_autoremap = true # Swaps Ctrl for Command on Mac.\n\tsave_shortcut.events = [key_event]\n\nfunc _input(event):\n\tif save_shortcut.matches_event(event) and event.is_pressed() and not event.is_echo():\n\t\tprint(\"Save shortcut pressed!\")\n\t\tget_viewport().set_input_as_handled()\n[/gdscript]\n[csharp]\nusing Godot;\n\npublic partial class MyNode : Node\n{\n\tprivate readonly Shortcut _saveShortcut = new Shortcut();\n\n\tpublic override void _Ready()\n\t{\n\t\tInputEventKey keyEvent = new InputEventKey\n\t\t{\n\t\t\tKeycode = Key.S,\n\t\t\tCtrlPressed = true,\n\t\t\tCommandOrControlAutoremap = true, // Swaps Ctrl for Command on Mac.\n\t\t};\n\n\t\t_saveShortcut.Events = [keyEvent];\n\t}\n\n\tpublic override void _Input(InputEvent @event)\n\t{\n\t\tif (@event is InputEventKey keyEvent &&\n\t\t\t_saveShortcut.MatchesEvent(@event) &&\n\t\t\tkeyEvent.Pressed && !keyEvent.Echo)\n\t\t{\n\t\t\tGD.Print(\"Save shortcut pressed!\");\n\t\t\tGetViewport().SetInputAsHandled();\n\t\t}\n\t}\n}\n[/csharp]\n[/codeblocks]"

#. Shortcut.get_as_text
#: doc/classes/Shortcut.xml
msgid "Returns the shortcut's first valid [InputEvent] as a [String]."
msgstr "A gyorsbillentyű első érvényes [InputEvent] eseményét [String] értékként adja vissza."

#. Shortcut.has_valid_event
#: doc/classes/Shortcut.xml
msgid "Returns whether [member events] contains an [InputEvent] which is valid."
msgstr "Megadja, hogy a [member events] tartalmaz-e érvényes [InputEvent] eseményt."

#. Shortcut.matches_event
#: doc/classes/Shortcut.xml
msgid "Returns whether any [InputEvent] in [member events] equals [param event]. This uses [method InputEvent.is_match] to compare events."
msgstr "Megadja, hogy a [member events] bármely [InputEvent] eseménye egyezik-e a [param event] eseménnyel. Az összehasonlításhoz az [method InputEvent.is_match] metódust használja."

#. Shortcut.events
#: doc/classes/Shortcut.xml
msgid "The shortcut's [InputEvent] array.\nGenerally the [InputEvent] used is an [InputEventKey], though it can be any [InputEvent], including an [InputEventAction]."
msgstr "A gyorsbillentyűhöz tartozó [InputEvent] események tömbje.\nA használt [InputEvent] általában [InputEventKey], de bármilyen [InputEvent] lehet, beleértve az [InputEventAction] eseményt is."

#. DisplayServer.keyboard_get_current_layout
#: doc/classes/DisplayServer.xml
msgid "Returns active keyboard layout index.\n[b]Note:[/b] This method is implemented on Linux (X11/Wayland), macOS, and Windows."
msgstr "Visszaadja az aktív billentyűzetkiosztás indexét.\n[b]Megjegyzés:[/b] Ez a metódus Linuxon (X11/Wayland), macOS-en és Windowson érhető el."

#. DisplayServer.keyboard_get_keycode_from_physical
#: doc/classes/DisplayServer.xml
msgid "Converts a physical (US QWERTY) [param keycode] to one in the active keyboard layout.\n[b]Note:[/b] This method is implemented on Linux (X11/Wayland), macOS and Windows."
msgstr "A fizikai (amerikai QWERTY) [param keycode] értéket az aktív kiosztás megfelelő billentyűkódjára alakítja.\n[b]Megjegyzés:[/b] Ez a metódus Linuxon (X11/Wayland), macOS-en és Windowson érhető el."

#. DisplayServer.keyboard_get_label_from_physical
#: doc/classes/DisplayServer.xml
msgid "Converts a physical (US QWERTY) [param keycode] to localized label printed on the key in the active keyboard layout.\n[b]Note:[/b] This method is implemented on Linux (X11/Wayland), macOS and Windows."
msgstr "A fizikai (amerikai QWERTY) [param keycode] értéket az aktív kiosztás billentyűjén szereplő helyi feliratra alakítja.\n[b]Megjegyzés:[/b] Ez a metódus Linuxon (X11/Wayland), macOS-en és Windowson érhető el."

#. DisplayServer.keyboard_get_layout_count
#: doc/classes/DisplayServer.xml
msgid "Returns the number of keyboard layouts.\n[b]Note:[/b] This method is implemented on Linux (X11/Wayland), macOS and Windows."
msgstr "Visszaadja a billentyűzetkiosztások számát.\n[b]Megjegyzés:[/b] Ez a metódus Linuxon (X11/Wayland), macOS-en és Windowson érhető el."

#. DisplayServer.keyboard_get_layout_language
#: doc/classes/DisplayServer.xml
msgid "Returns the ISO-639/BCP-47 language code of the keyboard layout at position [param index].\n[b]Note:[/b] This method is implemented on Linux (X11/Wayland), macOS and Windows."
msgstr "Visszaadja a [param index] indexű billentyűzetkiosztás ISO-639/BCP-47 nyelvkódját.\n[b]Megjegyzés:[/b] Ez a metódus Linuxon (X11/Wayland), macOS-en és Windowson érhető el."

#. DisplayServer.keyboard_get_layout_name
#: doc/classes/DisplayServer.xml
msgid "Returns the localized name of the keyboard layout at position [param index].\n[b]Note:[/b] This method is implemented on Linux (X11/Wayland), macOS and Windows."
msgstr "Visszaadja a [param index] indexű billentyűzetkiosztás helyi nevét.\n[b]Megjegyzés:[/b] Ez a metódus Linuxon (X11/Wayland), macOS-en és Windowson érhető el."

#. DisplayServer.keyboard_set_current_layout
#: doc/classes/DisplayServer.xml
msgid "Sets the active keyboard layout.\n[b]Note:[/b] This method is implemented on Linux (X11/Wayland), macOS and Windows."
msgstr "Beállítja az aktív billentyűzetkiosztást.\n[b]Megjegyzés:[/b] Ez a metódus Linuxon (X11/Wayland), macOS-en és Windowson érhető el."

#. PackedScene.brief
#: doc/classes/PackedScene.xml
msgid "An abstraction of a serialized scene."
msgstr "Szerializált jelenetet képviselő erőforrás."

#. PackedScene.can_instantiate
#: doc/classes/PackedScene.xml
msgid "Returns [code]true[/code] if the scene file has nodes."
msgstr "[code]true[/code] értéket ad vissza, ha a jelenetfájl csomópontokat tartalmaz."

#. PackedScene.get_state
#: doc/classes/PackedScene.xml
msgid "Returns the [SceneState] representing the scene file contents."
msgstr "Visszaadja a jelenetfájl tartalmát képviselő [SceneState] objektumot."

#. PackedScene.instantiate
#: doc/classes/PackedScene.xml
msgid "Instantiates the scene's node hierarchy. Triggers child scene instantiation(s). Triggers a [constant Node.NOTIFICATION_SCENE_INSTANTIATED] notification on the root node."
msgstr "Példányosítja a jelenet csomópont-hierarchiáját. Ezzel a gyermekjelenetek is példányosulnak. A gyökércsomópont [constant Node.NOTIFICATION_SCENE_INSTANTIATED] értesítést kap."

#. PackedScene.pack
#: doc/classes/PackedScene.xml
msgid "Packs the [param path] node, and all owned sub-nodes, into this [PackedScene]. Any existing data will be cleared. See [member Node.owner]."
msgstr "A [param path] csomópontot és az összes tulajdonában lévő alcsomópontot ebbe a [PackedScene] erőforrásba csomagolja. A korábbi adatokat törli. Lásd a [member Node.owner] tulajdonságot."

#. PackedScene.GEN_EDIT_STATE_DISABLED
#: doc/classes/PackedScene.xml
msgid "If passed to [method instantiate], blocks edits to the scene state."
msgstr "A [method instantiate] metódusnak átadva letiltja a jelenetállapot szerkesztését."

#. PackedScene.GEN_EDIT_STATE_INSTANCE
#: doc/classes/PackedScene.xml
msgid "If passed to [method instantiate], provides local scene resources to the local scene.\n[b]Note:[/b] Only available in editor builds."
msgstr "A [method instantiate] metódusnak átadva a helyi jelenet számára elérhetővé teszi a helyi jeleneterőforrásokat.\n[b]Megjegyzés:[/b] Csak a szerkesztőt tartalmazó buildekben érhető el."

#. PackedScene.GEN_EDIT_STATE_MAIN
#: doc/classes/PackedScene.xml
msgid "If passed to [method instantiate], provides local scene resources to the local scene. Only the main scene should receive the main edit state.\n[b]Note:[/b] Only available in editor builds."
msgstr "A [method instantiate] metódusnak átadva a helyi jelenet számára elérhetővé teszi a helyi jeleneterőforrásokat. A fő szerkesztési állapotot csak a fő jelenet kaphatja meg.\n[b]Megjegyzés:[/b] Csak a szerkesztőt tartalmazó buildekben érhető el."

#. PackedScene.GEN_EDIT_STATE_MAIN_INHERITED
#: doc/classes/PackedScene.xml
msgid "It's similar to [constant GEN_EDIT_STATE_MAIN], but for the case where the scene is being instantiated to be the base of another one.\n[b]Note:[/b] Only available in editor builds."
msgstr "A [constant GEN_EDIT_STATE_MAIN] állapothoz hasonló, de akkor használható, ha a példányosított jelenet egy másik jelenet alapja lesz.\n[b]Megjegyzés:[/b] Csak a szerkesztőt tartalmazó buildekben érhető el."

#. SceneState.brief
#: doc/classes/SceneState.xml
msgid "Provides access to a scene file's information."
msgstr "Hozzáférést biztosít a jelenetfájl adataihoz."

#. SceneState.description
#: doc/classes/SceneState.xml
msgid "Maintains a list of resources, nodes, exported and overridden properties, and built-in scripts associated with a scene. They cannot be modified from a [SceneState], only accessed. Useful for peeking into what a [PackedScene] contains without instantiating it.\nThis class cannot be instantiated directly, it is retrieved for a given scene as the result of [method PackedScene.get_state]."
msgstr "A jelenethez tartozó erőforrások, csomópontok, exportált és felülírt tulajdonságok, valamint beépített szkriptek listáját tárolja. A [SceneState] objektumon keresztül ezek az adatok csak lekérhetők. Így a [PackedScene] tartalmát példányosítás nélkül is megvizsgálhatod.\nAz osztály közvetlenül nem példányosítható. Egy adott jelenethez a [method PackedScene.get_state] metódussal kérhető le."

#. SceneState.get_base_scene_state
#: doc/classes/SceneState.xml
msgid "Returns the [SceneState] of the scene that this scene inherits from, or [code]null[/code] if it doesn't inherit from any scene."
msgstr "Visszaadja az öröklés alapjául szolgáló jelenet [SceneState] objektumát. Ha a jelenet nem örököl másik jelenetből, az eredmény [code]null[/code]."

#. SceneState.get_connection_binds
#: doc/classes/SceneState.xml
msgid "Returns the list of bound parameters for the signal at [param idx]."
msgstr "Visszaadja a [param idx] indexű jelzéshez kötött paraméterek listáját."

#. SceneState.get_connection_count
#: doc/classes/SceneState.xml
msgid "Returns the number of signal connections in the scene.\nThe [code]idx[/code] argument used to query connection metadata in other [code]get_connection_*[/code] methods in the interval [code][0, get_connection_count() - 1][/code]."
msgstr "Visszaadja a jelenet jelzéskapcsolatainak számát.\nA többi [code]get_connection_*[/code] metódus [code]idx[/code] argumentuma a [code][0, get_connection_count() - 1][/code] tartományban adható meg a kapcsolatok adatainak lekéréséhez."

#. SceneState.get_connection_flags
#: doc/classes/SceneState.xml
msgid "Returns the connection flags for the signal at [param idx]. See [enum Object.ConnectFlags] constants."
msgstr "Visszaadja a [param idx] indexű jelzéskapcsolat jelzőit. Lásd az [enum Object.ConnectFlags] állandókat."

#. SceneState.get_connection_method
#: doc/classes/SceneState.xml
msgid "Returns the method connected to the signal at [param idx]."
msgstr "Visszaadja a [param idx] indexű jelzéshez kapcsolt metódust."

#. SceneState.get_connection_signal
#: doc/classes/SceneState.xml
msgid "Returns the name of the signal at [param idx]."
msgstr "Visszaadja a [param idx] indexű jelzés nevét."

#. SceneState.get_connection_source
#: doc/classes/SceneState.xml
msgid "Returns the path to the node that owns the signal at [param idx], relative to the root node."
msgstr "Visszaadja a [param idx] indexű jelzést kibocsátó csomópont útvonalát a gyökércsomóponthoz viszonyítva."

#. SceneState.get_connection_target
#: doc/classes/SceneState.xml
msgid "Returns the path to the node that owns the method connected to the signal at [param idx], relative to the root node."
msgstr "Visszaadja annak a csomópontnak az útvonalát, amelyhez a [param idx] indexű jelzéshez kapcsolt metódus tartozik. Az útvonal a gyökércsomóponthoz viszonyított."

#. SceneState.get_connection_unbinds
#: doc/classes/SceneState.xml
msgid "Returns the number of unbound parameters for the signal at [param idx]."
msgstr "Visszaadja a [param idx] indexű jelzés azon paramétereinek számát, amelyeket a kapcsolat nem ad át."

#. SceneState.get_node_count
#: doc/classes/SceneState.xml
msgid "Returns the number of nodes in the scene.\nThe [code]idx[/code] argument used to query node data in other [code]get_node_*[/code] methods in the interval [code][0, get_node_count() - 1][/code]."
msgstr "Visszaadja a jelenet csomópontjainak számát.\nA többi [code]get_node_*[/code] metódus [code]idx[/code] argumentuma a [code][0, get_node_count() - 1][/code] tartományban adható meg a csomópontok adatainak lekéréséhez."

#. SceneState.get_node_groups
#: doc/classes/SceneState.xml
msgid "Returns the list of group names associated with the node at [param idx]."
msgstr "Visszaadja azoknak a csoportoknak a nevét, amelyekhez a [param idx] indexű csomópont tartozik."

#. SceneState.get_node_index
#: doc/classes/SceneState.xml
msgid "Returns the node's index, which is its position relative to its siblings. This is only relevant and saved in scenes for cases where new nodes are added to an instantiated or inherited scene among siblings from the base scene. Despite the name, this index is not related to the [param idx] argument used here and in other methods."
msgstr "Visszaadja a csomópont indexét, vagyis a testvércsomópontjaihoz viszonyított helyét. Ez az érték akkor számít, és akkor tárolódik a jelenetben, ha egy példányosított vagy örökölt jelenethez az alapjelenet testvércsomópontjai közé új csomópontot adnak. Az index neve ellenére független az itt és más metódusokban használt [param idx] argumentumtól."

#. SceneState.get_node_instance
#: doc/classes/SceneState.xml
msgid "Returns a [PackedScene] for the node at [param idx] (i.e. the whole branch starting at this node, with its child nodes and resources), or [code]null[/code] if the node is not an instance."
msgstr "A [param idx] indexű csomóponthoz tartozó [PackedScene] erőforrást adja vissza, vagyis a csomóponttal kezdődő teljes ágat az alcsomópontokkal és az erőforrásokkal együtt. Ha a csomópont nem jelenetpéldány, az eredmény [code]null[/code]."

#. SceneState.get_node_instance_placeholder
#: doc/classes/SceneState.xml
msgid "Returns the path to the represented scene file if the node at [param idx] is an [InstancePlaceholder]."
msgstr "Visszaadja a képviselt jelenetfájl útvonalát, ha a [param idx] indexű csomópont [InstancePlaceholder] típusú."

#. SceneState.get_node_name
#: doc/classes/SceneState.xml
msgid "Returns the name of the node at [param idx]."
msgstr "Visszaadja a [param idx] indexű csomópont nevét."

#. SceneState.get_node_owner_path
#: doc/classes/SceneState.xml
msgid "Returns the path to the owner of the node at [param idx], relative to the root node."
msgstr "Visszaadja a [param idx] indexű csomópont tulajdonosának útvonalát a gyökércsomóponthoz viszonyítva."

#. SceneState.get_node_path
#: doc/classes/SceneState.xml
msgid "Returns the path to the node at [param idx].\nIf [param for_parent] is [code]true[/code], returns the path of the [param idx] node's parent instead."
msgstr "Visszaadja a [param idx] indexű csomópont útvonalát.\nHa a [param for_parent] értéke [code]true[/code], a [param idx] indexű csomópont szülőjének útvonalát adja vissza."

#. SceneState.get_node_property_count
#: doc/classes/SceneState.xml
msgid "Returns the number of exported or overridden properties for the node at [param idx].\nThe [code]prop_idx[/code] argument used to query node property data in other [code]get_node_property_*[/code] methods in the interval [code][0, get_node_property_count() - 1][/code]."
msgstr "Visszaadja a [param idx] indexű csomópont exportált vagy felülírt tulajdonságainak számát.\nA többi [code]get_node_property_*[/code] metódus [code]prop_idx[/code] argumentuma a [code][0, get_node_property_count() - 1][/code] tartományban adható meg a tulajdonságok lekéréséhez."

#. SceneState.get_node_property_name
#: doc/classes/SceneState.xml
msgid "Returns the name of the property at [param prop_idx] for the node at [param idx]."
msgstr "Visszaadja a [param idx] indexű csomópont [param prop_idx] indexű tulajdonságának nevét."

#. SceneState.get_node_property_value
#: doc/classes/SceneState.xml
msgid "Returns the value of the property at [param prop_idx] for the node at [param idx]."
msgstr "Visszaadja a [param idx] indexű csomópont [param prop_idx] indexű tulajdonságának értékét."

#. SceneState.get_node_type
#: doc/classes/SceneState.xml
msgid "Returns the type of the node at [param idx]."
msgstr "Visszaadja a [param idx] indexű csomópont típusát."

#. SceneState.get_path
#: doc/classes/SceneState.xml
msgid "Returns the resource path to the represented [PackedScene]."
msgstr "Visszaadja a képviselt [PackedScene] erőforrás-útvonalát."

#. SceneState.is_node_instance_placeholder
#: doc/classes/SceneState.xml
msgid "Returns [code]true[/code] if the node at [param idx] is an [InstancePlaceholder]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param idx] indexű csomópont [InstancePlaceholder] típusú."

#. SceneState.GEN_EDIT_STATE_DISABLED
#: doc/classes/SceneState.xml
msgid "If passed to [method PackedScene.instantiate], blocks edits to the scene state."
msgstr "A [method PackedScene.instantiate] metódusnak átadva letiltja a jelenetállapot szerkesztését."

#. SceneState.GEN_EDIT_STATE_MAIN
#: doc/classes/SceneState.xml
msgid "If passed to [method PackedScene.instantiate], provides local scene resources to the local scene. Only the main scene should receive the main edit state.\n[b]Note:[/b] Only available in editor builds."
msgstr "A [method PackedScene.instantiate] metódusnak átadva a helyi jelenet számára elérhetővé teszi a helyi jeleneterőforrásokat. A fő szerkesztési állapotot csak a fő jelenet kaphatja meg.\n[b]Megjegyzés:[/b] Csak a szerkesztőt tartalmazó buildekben érhető el."

#. SceneState.GEN_EDIT_STATE_MAIN_INHERITED
#: doc/classes/SceneState.xml
msgid "If passed to [method PackedScene.instantiate], it's similar to [constant GEN_EDIT_STATE_MAIN], but for the case where the scene is being instantiated to be the base of another one.\n[b]Note:[/b] Only available in editor builds."
msgstr "A [method PackedScene.instantiate] metódusnak átadva a [constant GEN_EDIT_STATE_MAIN] állapothoz hasonlóan működik, de akkor használható, ha a példányosított jelenet egy másik jelenet alapja lesz.\n[b]Megjegyzés:[/b] Csak a szerkesztőt tartalmazó buildekben érhető el."

#. SceneTree.brief
#: doc/classes/SceneTree.xml
msgid "Manages the game loop via a hierarchy of nodes."
msgstr "Csomópontok hierarchiáján keresztül kezeli a játékciklust."

#. SceneTree.description
#: doc/classes/SceneTree.xml
msgid "As one of the most important classes, the [SceneTree] manages the hierarchy of nodes in a scene, as well as scenes themselves. Nodes can be added, fetched and removed. The whole scene tree (and thus the current scene) can be paused. Scenes can be loaded, switched and reloaded.\nYou can also use the [SceneTree] to organize your nodes into [b]groups[/b]: every node can be added to as many groups as you want to create, e.g. an \"enemy\" group. You can then iterate these groups or even call methods and set properties on all the nodes belonging to any given group.\n[SceneTree] is the default [MainLoop] implementation used by the engine, and is thus in charge of the game loop."
msgstr "A [SceneTree] a motor egyik legfontosabb osztálya. A jelenet csomópont-hierarchiáját és magukat a jeleneteket is kezeli. A csomópontok hozzáadhatók, lekérhetők és eltávolíthatók. A teljes jelenetfa, így az aktuális jelenet működése is szüneteltethető. Jeleneteket betölthetsz, újratölthetsz, illetve válthatsz közöttük.\nA [SceneTree] a csomópontok [b]csoportosítására[/b] is használható. Egy csomópont tetszőleges számú csoporthoz tartozhat, például egy „enemy” nevű csoporthoz. Bejárhatod a csoportokat, illetve metódusokat hívhatsz meg és tulajdonságokat állíthatsz be egy csoport összes csomópontján.\nA [SceneTree] a motor alapértelmezett [MainLoop] megvalósítása, így ez futtatja a játékciklust."

#. SceneTree.call_group
#: doc/classes/SceneTree.xml
msgid "Calls [param method] on each node inside this tree added to the given [param group]. You can pass arguments to [param method] by specifying them at the end of this method call. Nodes that cannot call [param method] (either because the method doesn't exist or the arguments do not match) are ignored. See also [method set_group] and [method notify_group].\n[b]Note:[/b] This method acts immediately on all selected nodes at once, which may cause stuttering in some performance-intensive situations.\n[b]Note:[/b] In C#, [param method] must be in snake_case when referring to built-in Godot methods. Prefer using the names exposed in the [code]MethodName[/code] class to avoid allocating a new [StringName] on each call."
msgstr "Meghívja a [param method] metódust a fa minden olyan csomópontján, amely a megadott [param group] csoporthoz tartozik. A [param method] argumentumait a hívás végén adhatod meg. Kihagyja azokat a csomópontokat, amelyeken a [param method] nem hívható meg, mert a metódus nem létezik vagy az argumentumok nem egyeznek. Lásd még a [method set_group] és a [method notify_group] metódust.\n[b]Megjegyzés:[/b] A metódus azonnal lefut minden érintett csomóponton, ami nagy terhelésnél akadozást okozhat.\n[b]Megjegyzés:[/b] C#-ban a beépített Godot-metódusok nevét snake_case formában kell átadni a [param method] paraméternek. A [code]MethodName[/code] osztályban elérhető nevekkel elkerülhető az új [StringName] érték létrehozása minden hívásnál."

#. SceneTree.call_group_flags
#: doc/classes/SceneTree.xml
msgid "Calls the given [param method] on each node inside this tree added to the given [param group]. Use [param flags] to customize this method's behavior (see [enum GroupCallFlags]). Additional arguments for [param method] can be passed at the end of this method. Nodes that cannot call [param method] (either because the method doesn't exist or the arguments do not match) are ignored.\n[codeblock]\n# Calls \"hide\" to all nodes of the \"enemies\" group, at the end of the frame and in reverse tree order.\nget_tree().call_group_flags(\n\t\tSceneTree.GROUP_CALL_DEFERRED | SceneTree.GROUP_CALL_REVERSE,\n\t\t\"enemies\", \"hide\")\n[/codeblock]\n[b]Note:[/b] In C#, [param method] must be in snake_case when referring to built-in Godot methods. Prefer using the names exposed in the [code]MethodName[/code] class to avoid allocating a new [StringName] on each call."
msgstr "Meghívja a megadott [param method] metódust a fa minden olyan csomópontján, amely a [param group] csoporthoz tartozik. A viselkedést a [param flags] paraméterrel szabályozhatod (lásd: [enum GroupCallFlags]). A [param method] további argumentumait a hívás végén adhatod meg. Kihagyja azokat a csomópontokat, amelyeken a [param method] nem hívható meg, mert a metódus nem létezik vagy az argumentumok nem egyeznek.\n[codeblock]\n# Calls \"hide\" to all nodes of the \"enemies\" group, at the end of the frame and in reverse tree order.\nget_tree().call_group_flags(\n\t\tSceneTree.GROUP_CALL_DEFERRED | SceneTree.GROUP_CALL_REVERSE,\n\t\t\"enemies\", \"hide\")\n[/codeblock]\n[b]Megjegyzés:[/b] C#-ban a beépített Godot-metódusok nevét snake_case formában kell átadni a [param method] paraméternek. A [code]MethodName[/code] osztályban elérhető nevekkel elkerülhető az új [StringName] érték létrehozása minden hívásnál."

#. SceneTree.change_scene_to_file
#: doc/classes/SceneTree.xml
msgid "Changes the running scene to the one at the given [param path], after loading it into a [PackedScene] and creating a new instance.\nReturns [constant OK] on success, [constant ERR_CANT_OPEN] if the [param path] cannot be loaded into a [PackedScene], or [constant ERR_CANT_CREATE] if that scene cannot be instantiated.\n[b]Note:[/b] See [method change_scene_to_node] for details on the order of operations."
msgstr "A futó jelenetet a megadott [param path] útvonalon található jelenetre cseréli. Előbb betölti [PackedScene] erőforrásként, majd létrehoz egy új példányt.\nSiker esetén [constant OK] értéket ad vissza. Ha a [param path] nem tölthető be [PackedScene] erőforrásként, az eredmény [constant ERR_CANT_OPEN]. Ha a jelenet nem példányosítható, az eredmény [constant ERR_CANT_CREATE].\n[b]Megjegyzés:[/b] A műveletek sorrendjét a [method change_scene_to_node] leírása ismerteti."

#. SceneTree.change_scene_to_node
#: doc/classes/SceneTree.xml
msgid "Changes the running scene to the provided [Node]. Useful when you want to set up the new scene before changing.\nReturns [constant OK] on success, [constant ERR_INVALID_PARAMETER] if the [param node] is [code]null[/code], or [constant ERR_UNCONFIGURED] if the [param node] is already inside the scene tree.\n[b]Note:[/b] Operations happen in the following order when [method change_scene_to_node] is called:\n1. The current scene node is immediately removed from the tree. From that point, [method Node.get_tree] called on the current (outgoing) scene will return [code]null[/code]. [member current_scene] will be [code]null[/code] too, because the new scene is not available yet.\n2. At the end of the frame, the formerly current scene, already removed from the tree, will be deleted (freed from memory) and then the new scene node will be added to the tree. [method Node.get_tree] and [member current_scene] will be back to working as usual.\nThis ensures that both scenes aren't running at the same time, while still freeing the previous scene in a safe way similar to [method Node.queue_free].\nIf you want to reliably access the new scene, await the [signal scene_changed] signal.\n[b]Warning:[/b] After using this method, the [SceneTree] will take ownership of the node and will free it automatically when changing scene again. Any references you had to that node will become invalid."
msgstr "A futó jelenetet a megadott [Node] csomópontra cseréli. Akkor hasznos, ha a váltás előtt be szeretnéd állítani az új jelenetet.\nSiker esetén [constant OK] értéket ad vissza. Ha a [param node] értéke [code]null[/code], az eredmény [constant ERR_INVALID_PARAMETER]. Ha a [param node] már a jelenetfában van, az eredmény [constant ERR_UNCONFIGURED].\n[b]Megjegyzés:[/b] A [method change_scene_to_node] hívásakor a műveletek sorrendje a következő:\n1. Az aktuális jelenet csomópontja azonnal kikerül a fából. Ettől kezdve a lecserélendő jeleneten meghívott [method Node.get_tree] [code]null[/code] értéket ad vissza. A [member current_scene] is [code]null[/code], mert az új jelenet még nem érhető el.\n2. A képkocka végén a motor törli a fából már eltávolított régi jelenetet, vagyis felszabadítja a memóriáját, majd hozzáadja az új jelenet csomópontját a fához. A [method Node.get_tree] és a [member current_scene] ezután a szokásos módon működik.\nÍgy a két jelenet nem fut egyszerre, és a motor a [method Node.queue_free] használatához hasonlóan biztonságosan szabadítja fel az előző jelenetet.\nAz új jelenet biztos eléréséhez várd meg a [signal scene_changed] jelzést.\n[b]Figyelmeztetés:[/b] A hívás után a [SceneTree] átveszi a csomópont tulajdonjogát, és a következő jelenetváltáskor automatikusan felszabadítja. A csomópontra mutató korábbi hivatkozások akkor érvénytelenné válnak."

#. SceneTree.change_scene_to_packed
#: doc/classes/SceneTree.xml
msgid "Changes the running scene to a new instance of the given [PackedScene] (which must be valid).\nReturns [constant OK] on success, [constant ERR_CANT_CREATE] if the scene cannot be instantiated, or [constant ERR_INVALID_PARAMETER] if the scene is invalid.\n[b]Note:[/b] See [method change_scene_to_node] for details on the order of operations."
msgstr "A futó jelenetet a megadott, érvényes [PackedScene] új példányára cseréli.\nSiker esetén [constant OK] értéket ad vissza. Ha a jelenet nem példányosítható, az eredmény [constant ERR_CANT_CREATE]. Ha a jelenet érvénytelen, az eredmény [constant ERR_INVALID_PARAMETER].\n[b]Megjegyzés:[/b] A műveletek sorrendjét a [method change_scene_to_node] leírása ismerteti."

#. SceneTree.create_timer
#: doc/classes/SceneTree.xml
msgid "Returns a new [SceneTreeTimer]. After [param time_sec] in seconds have passed, the timer will emit [signal SceneTreeTimer.timeout] and will be automatically freed.\nIf [param process_always] is [code]false[/code], the timer will be paused when setting [member SceneTree.paused] to [code]true[/code].\nIf [param process_in_physics] is [code]true[/code], the timer will update at the end of the physics frame, instead of the process frame.\nIf [param ignore_time_scale] is [code]true[/code], the timer will ignore [member Engine.time_scale] and update with the real, elapsed time.\nThis method is commonly used to create a one-shot delay timer, as in the following example:\n[codeblocks]\n[gdscript]\nfunc some_function():\n\tprint(\"start\")\n\tawait get_tree().create_timer(1.0).timeout\n\tprint(\"end\")\n[/gdscript]\n[csharp]\npublic async Task SomeFunction()\n{\n\tGD.Print(\"start\");\n\tawait ToSignal(GetTree().CreateTimer(1.0f), SceneTreeTimer.SignalName.Timeout);\n\tGD.Print(\"end\");\n}\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] The timer is always updated [i]after[/i] all of the nodes in the tree. A node's [method Node._process] method would be called before the timer updates (or [method Node._physics_process] if [param process_in_physics] is set to [code]true[/code])."
msgstr "Új [SceneTreeTimer] időzítőt ad vissza. A [param time_sec] másodperc elteltével az időzítő elküldi a [signal SceneTreeTimer.timeout] jelzést, majd automatikusan felszabadul.\nHa a [param process_always] értéke [code]false[/code], az időzítő szünetel, amikor a [member SceneTree.paused] értéke [code]true[/code].\nHa a [param process_in_physics] értéke [code]true[/code], az időzítő a feldolgozási képkocka helyett a fizikai képkocka végén frissül.\nHa a [param ignore_time_scale] értéke [code]true[/code], az időzítő figyelmen kívül hagyja a [member Engine.time_scale] értékét, és a ténylegesen eltelt idő alapján frissül.\nEzzel a metódussal gyakran egyszer lefutó késleltetést hoznak létre, például így:\n[codeblocks]\n[gdscript]\nfunc some_function():\n\tprint(\"start\")\n\tawait get_tree().create_timer(1.0).timeout\n\tprint(\"end\")\n[/gdscript]\n[csharp]\npublic async Task SomeFunction()\n{\n\tGD.Print(\"start\");\n\tawait ToSignal(GetTree().CreateTimer(1.0f), SceneTreeTimer.SignalName.Timeout);\n\tGD.Print(\"end\");\n}\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] Az időzítő mindig a fa összes csomópontja [i]után[/i] frissül. A csomópont [method Node._process] metódusa előbb fut le, mint az időzítő (illetve a [method Node._physics_process] fut előbb, ha a [param process_in_physics] értéke [code]true[/code])."

#. SceneTree.create_tween
#: doc/classes/SceneTree.xml
msgid "Creates and returns a new [Tween] processed in this tree. The Tween will start automatically on the next process frame or physics frame (depending on its [enum Tween.TweenProcessMode]).\n[b]Note:[/b] A [Tween] created using this method is not bound to any [Node]. It may keep working until there is nothing left to animate. If you want the [Tween] to be automatically killed when the [Node] is freed, use [method Node.create_tween] or [method Tween.bind_node]."
msgstr "Új, ebben a fában feldolgozott [Tween] objektumot hoz létre és ad vissza. A Tween automatikusan elindul a következő feldolgozási vagy fizikai képkockán, a [enum Tween.TweenProcessMode] értékétől függően.\n[b]Megjegyzés:[/b] Az így létrehozott [Tween] egyetlen [Node] csomóponthoz sem kötődik. Addig futhat, amíg van mit animálnia. Ha azt szeretnéd, hogy a [Tween] a [Node] felszabadításakor automatikusan leálljon, használd a [method Node.create_tween] vagy a [method Tween.bind_node] metódust."

#. SceneTree.get_first_node_in_group
#: doc/classes/SceneTree.xml
msgid "Returns the first [Node] found inside the tree, that has been added to the given [param group], in scene hierarchy order. Returns [code]null[/code] if no match is found. See also [method get_nodes_in_group]."
msgstr "A jelenet hierarchiájának sorrendjében visszaadja a [param group] csoporthoz tartozó első [Node] csomópontot a fában. Ha nincs találat, az eredmény [code]null[/code]. Lásd még a [method get_nodes_in_group] metódust."

#. SceneTree.get_frame
#: doc/classes/SceneTree.xml
msgid "Returns how many physics process steps have been processed, since the application started. This is [i]not[/i] a measurement of elapsed time. See also [signal physics_frame]. For the number of frames rendered, see [method Engine.get_process_frames]."
msgstr "Megadja, hogy az alkalmazás indulása óta hány fizikai feldolgozási lépés futott le. Ez [i]nem[/i] az eltelt idő mérőszáma. Lásd még a [signal physics_frame] jelzést. A kirajzolt képkockák számát a [method Engine.get_process_frames] metódussal kérheted le."

#. SceneTree.get_multiplayer
#: doc/classes/SceneTree.xml
msgid "Searches for the [MultiplayerAPI] configured for the given path, if one does not exist it searches the parent paths until one is found. If the path is empty, or none is found, the default one is returned. See [method set_multiplayer]."
msgstr "A megadott útvonalhoz beállított [MultiplayerAPI] példányt keresi. Ha ott nincs beállított példány, a szülőútvonalakon keres tovább. Üres útvonal vagy sikertelen keresés esetén az alapértelmezett példányt adja vissza. Lásd a [method set_multiplayer] metódust."

#. SceneTree.get_node_count
#: doc/classes/SceneTree.xml
msgid "Returns the number of nodes inside this tree."
msgstr "Visszaadja a fában található csomópontok számát."

#. SceneTree.get_node_count_in_group
#: doc/classes/SceneTree.xml
msgid "Returns the number of nodes assigned to the given group."
msgstr "Visszaadja az adott csoporthoz tartozó csomópontok számát."

#. SceneTree.get_nodes_in_group
#: doc/classes/SceneTree.xml
msgid "Returns an [Array] containing all nodes inside this tree, that have been added to the given [param group], in scene hierarchy order."
msgstr "[Array] értékben adja vissza a fa [param group] csoporthoz tartozó összes csomópontját a jelenethierarchia sorrendjében."

#. SceneTree.get_processed_tweens
#: doc/classes/SceneTree.xml
msgid "Returns an [Array] of currently existing [Tween]s in the tree, including paused tweens."
msgstr "[Array] értékben adja vissza a fa összes jelenleg létező [Tween] objektumát, beleértve a szünetelőket is."

#. SceneTree.has_group
#: doc/classes/SceneTree.xml
msgid "Returns [code]true[/code] if a node added to the given group [param name] exists in the tree."
msgstr "[code]true[/code] értéket ad vissza, ha a fában van a [param name] nevű csoporthoz tartozó csomópont."

#. SceneTree.is_accessibility_enabled
#: doc/classes/SceneTree.xml
msgid "Returns [code]true[/code] if accessibility features are enabled, and accessibility information updates are actively processed."
msgstr "[code]true[/code] értéket ad vissza, ha az akadálymentesítési funkciók be vannak kapcsolva, és a motor feldolgozza az akadálymentességi adatok frissítéseit."

#. SceneTree.is_accessibility_supported
#: doc/classes/SceneTree.xml
msgid "Returns [code]true[/code] if accessibility features are supported by the OS and enabled in project settings."
msgstr "[code]true[/code] értéket ad vissza, ha az operációs rendszer támogatja az akadálymentesítési funkciókat, és azok a projektbeállításokban engedélyezve vannak."

#. SceneTree.notify_group
#: doc/classes/SceneTree.xml
msgid "Calls [method Object.notification] with the given [param notification] to all nodes inside this tree added to the [param group]. See also [url=$DOCS_URL/tutorials/best_practices/godot_notifications.html]Godot notifications[/url] and [method call_group] and [method set_group].\n[b]Note:[/b] This method acts immediately on all selected nodes at once, which may cause stuttering in some performance-intensive situations."
msgstr "Meghívja a [method Object.notification] metódust a megadott [param notification] értesítéssel a fa [param group] csoporthoz tartozó összes csomópontján. Lásd még a [url=$DOCS_URL/tutorials/best_practices/godot_notifications.html]Godot-értesítések[/url] leírását, valamint a [method call_group] és a [method set_group] metódust.\n[b]Megjegyzés:[/b] A metódus azonnal lefut minden érintett csomóponton, ami nagy terhelésnél akadozást okozhat."

#. SceneTree.notify_group_flags
#: doc/classes/SceneTree.xml
msgid "Calls [method Object.notification] with the given [param notification] to all nodes inside this tree added to the [param group]. Use [param call_flags] to customize this method's behavior (see [enum GroupCallFlags])."
msgstr "Meghívja a [method Object.notification] metódust a megadott [param notification] értesítéssel a fa [param group] csoporthoz tartozó összes csomópontján. A viselkedést a [param call_flags] paraméterrel szabályozhatod (lásd: [enum GroupCallFlags])."

#. SceneTree.queue_delete
#: doc/classes/SceneTree.xml
msgid "Queues the given [param obj] to be deleted, calling its [method Object.free] at the end of the current frame. This method is similar to [method Node.queue_free]."
msgstr "Törlésre jelöli a megadott [param obj] objektumot, és az aktuális képkocka végén meghívja az objektum [method Object.free] metódusát. A [method Node.queue_free] metódushoz hasonló."

#. SceneTree.quit
#: doc/classes/SceneTree.xml
msgid "Quits the application at the end of the current iteration, with the given [param exit_code].\nBy convention, an exit code of [code]0[/code] indicates success, whereas any other exit code indicates an error. For portability reasons, it should be between [code]0[/code] and [code]125[/code] (inclusive).\n[b]Note:[/b] On iOS this method doesn't work. Instead, as recommended by the [url=https://developer.apple.com/library/archive/qa/qa1561/_index.html]iOS Human Interface Guidelines[/url], the user is expected to close apps via the Home button."
msgstr "Az aktuális ciklus végén kilép az alkalmazásból a megadott [param exit_code] kilépési kóddal.\nMegállapodás szerint a [code]0[/code] sikeres kilépést, minden más érték hibát jelez. A hordozhatóság érdekében a kód [code]0[/code] és [code]125[/code] közötti legyen, a határértékeket is beleértve.\n[b]Megjegyzés:[/b] A metódus iOS-en nem működik. Az [url=https://developer.apple.com/library/archive/qa/qa1561/_index.html]iOS felületi irányelvei[/url] szerint a felhasználó a Kezdőlap gombbal lép ki az alkalmazásokból."

#. SceneTree.reload_current_scene
#: doc/classes/SceneTree.xml
msgid "Reloads the currently active scene, replacing [member current_scene] with a new instance of its original [PackedScene].\nReturns [constant OK] on success, [constant ERR_UNCONFIGURED] if no [member current_scene] is defined, [constant ERR_CANT_OPEN] if [member current_scene] cannot be loaded into a [PackedScene], or [constant ERR_CANT_CREATE] if the scene cannot be instantiated."
msgstr "Újratölti az aktuális jelenetet. A [member current_scene] értékét az eredeti [PackedScene] új példányára cseréli.\nSiker esetén [constant OK] értéket ad vissza. Ha nincs megadva [member current_scene], az eredmény [constant ERR_UNCONFIGURED]. Ha a [member current_scene] nem tölthető be [PackedScene] erőforrásként, az eredmény [constant ERR_CANT_OPEN]. Ha nem példányosítható, az eredmény [constant ERR_CANT_CREATE]."

#. SceneTree.set_group
#: doc/classes/SceneTree.xml
msgid "Sets the given [param property] to [param value] on all nodes inside this tree added to the given [param group]. Nodes that do not have the [param property] are ignored. See also [method call_group] and [method notify_group].\n[b]Note:[/b] This method acts immediately on all selected nodes at once, which may cause stuttering in some performance-intensive situations.\n[b]Note:[/b] In C#, [param property] must be in snake_case when referring to built-in Godot properties. Prefer using the names exposed in the [code]PropertyName[/code] class to avoid allocating a new [StringName] on each call."
msgstr "A megadott [param property] tulajdonságot a [param value] értékre állítja a fa [param group] csoporthoz tartozó összes csomópontján. Kihagyja azokat a csomópontokat, amelyeknek nincs [param property] tulajdonságuk. Lásd még a [method call_group] és a [method notify_group] metódust.\n[b]Megjegyzés:[/b] A metódus azonnal módosítja az összes érintett csomópontot, ami nagy terhelésnél akadozást okozhat.\n[b]Megjegyzés:[/b] C#-ban a beépített Godot-tulajdonságok nevét snake_case formában kell átadni a [param property] paraméternek. A [code]PropertyName[/code] osztályban elérhető nevekkel elkerülhető az új [StringName] érték létrehozása minden hívásnál."

#. SceneTree.set_group_flags
#: doc/classes/SceneTree.xml
msgid "Sets the given [param property] to [param value] on all nodes inside this tree added to the given [param group]. Nodes that do not have the [param property] are ignored. Use [param call_flags] to customize this method's behavior (see [enum GroupCallFlags]).\n[b]Note:[/b] In C#, [param property] must be in snake_case when referring to built-in Godot properties. Prefer using the names exposed in the [code]PropertyName[/code] class to avoid allocating a new [StringName] on each call."
msgstr "A megadott [param property] tulajdonságot a [param value] értékre állítja a fa [param group] csoporthoz tartozó összes csomópontján. Kihagyja azokat a csomópontokat, amelyeknek nincs [param property] tulajdonságuk. A viselkedést a [param call_flags] paraméterrel szabályozhatod (lásd: [enum GroupCallFlags]).\n[b]Megjegyzés:[/b] C#-ban a beépített Godot-tulajdonságok nevét snake_case formában kell átadni a [param property] paraméternek. A [code]PropertyName[/code] osztályban elérhető nevekkel elkerülhető az új [StringName] érték létrehozása minden hívásnál."

#. SceneTree.set_multiplayer
#: doc/classes/SceneTree.xml
msgid "Sets a custom [MultiplayerAPI] with the given [param root_path] (controlling also the relative subpaths), or override the default one if [param root_path] is empty.\n[b]Note:[/b] No [MultiplayerAPI] must be configured for the subpath containing [param root_path], nested custom multiplayers are not allowed. I.e. if one is configured for [code]\"/root/Foo\"[/code] setting one for [code]\"/root/Foo/Bar\"[/code] will cause an error.\n[b]Note:[/b] [method set_multiplayer] should be called [i]before[/i] the child nodes are ready at the given [param root_path]. If multiplayer nodes like [MultiplayerSpawner] or [MultiplayerSynchronizer] are added to the tree before the custom multiplayer API is set, they will not work."
msgstr "Egyéni [MultiplayerAPI] példányt állít be a megadott [param root_path] útvonalhoz és az alatta lévő útvonalakhoz. Üres [param root_path] esetén az alapértelmezett példányt írja felül.\n[b]Megjegyzés:[/b] A [param root_path] fölötti útvonalon nem lehet másik [MultiplayerAPI] beállítva, mert az egyéni többjátékos példányok nem ágyazhatók egymásba. Például ha a [code]\"/root/Foo\"[/code] útvonalhoz már beállítottál egyet, a [code]\"/root/Foo/Bar\"[/code] útvonalhoz rendelt új példány hibát okoz.\n[b]Megjegyzés:[/b] A [method set_multiplayer] metódust [i]azelőtt[/i] hívd meg, hogy a megadott [param root_path] gyermekcsomópontjai készen állnak. A többjátékos csomópontok, például a [MultiplayerSpawner] vagy a [MultiplayerSynchronizer], nem működnek, ha az egyéni többjátékos API beállítása előtt kerülnek a fába."

#. SceneTree.unload_current_scene
#: doc/classes/SceneTree.xml
msgid "If a current scene is loaded, calling this method will unload it."
msgstr "Ha van betöltött aktuális jelenet, eltávolítja azt."

#. SceneTree.node_added
#: doc/classes/SceneTree.xml
msgid "Emitted when the [param node] enters this tree."
msgstr "Akkor küldi el, amikor a [param node] bekerül ebbe a fába."

#. SceneTree.node_configuration_warning_changed
#: doc/classes/SceneTree.xml
msgid "Emitted when the [param node]'s [method Node.update_configuration_warnings] is called. Only emitted in the editor."
msgstr "Akkor küldi el, amikor meghívják a [param node] [method Node.update_configuration_warnings] metódusát. Csak a szerkesztőben küldi el."

#. SceneTree.node_removed
#: doc/classes/SceneTree.xml
msgid "Emitted when the [param node] exits this tree."
msgstr "Akkor küldi el, amikor a [param node] kilép ebből a fából."

#. SceneTree.node_renamed
#: doc/classes/SceneTree.xml
msgid "Emitted when the [param node]'s [member Node.name] is changed."
msgstr "Akkor küldi el, amikor megváltozik a [param node] [member Node.name] tulajdonsága."

#. SceneTree.physics_frame
#: doc/classes/SceneTree.xml
msgid "Emitted immediately before [method Node._physics_process] is called on every node in this tree."
msgstr "Közvetlenül azelőtt küldi el, hogy a fa minden csomópontján meghívná a [method Node._physics_process] metódust."

#. SceneTree.process_frame
#: doc/classes/SceneTree.xml
msgid "Emitted immediately before [method Node._process] is called on every node in this tree."
msgstr "Közvetlenül azelőtt küldi el, hogy a fa minden csomópontján meghívná a [method Node._process] metódust."

#. SceneTree.scene_changed
#: doc/classes/SceneTree.xml
msgid "Emitted after the new scene is added to scene tree and initialized. Can be used to reliably access [member current_scene] when changing scenes.\n[codeblock]\n# This code should be inside an autoload.\nget_tree().change_scene_to_file(other_scene_path)\nawait get_tree().scene_changed\nprint(get_tree().current_scene) # Prints the new scene.\n[/codeblock]"
msgstr "Akkor küldi el, amikor az új jelenet már bekerült a jelenetfába és inicializálódott. A [member current_scene] így jelenetváltáskor is megbízhatóan elérhető.\n[codeblock]\n# This code should be inside an autoload.\nget_tree().change_scene_to_file(other_scene_path)\nawait get_tree().scene_changed\nprint(get_tree().current_scene) # Prints the new scene.\n[/codeblock]"

#. SceneTree.tree_changed
#: doc/classes/SceneTree.xml
msgid "Emitted any time the tree's hierarchy changes (nodes being moved, renamed, etc.)."
msgstr "Akkor küldi el, amikor módosul a fa hierarchiája, például egy csomópont áthelyezésekor vagy átnevezésekor."

#. SceneTree.tree_process_mode_changed
#: doc/classes/SceneTree.xml
msgid "Emitted when the [member Node.process_mode] of any node inside the tree is changed. Only emitted in the editor, to update the visibility of disabled nodes."
msgstr "Akkor küldi el, amikor megváltozik a fa bármely csomópontjának [member Node.process_mode] tulajdonsága. Csak a szerkesztőben küldi el, ahol a letiltott csomópontok megjelenését frissíti."

#. SceneTree.auto_accept_quit
#: doc/classes/SceneTree.xml
msgid "If [code]true[/code], the application automatically accepts quitting requests.\nFor mobile platforms, see [member quit_on_go_back]."
msgstr "Ha az értéke [code]true[/code], az alkalmazás automatikusan elfogadja a kilépési kérelmeket.\nMobilplatformokon lásd a [member quit_on_go_back] tulajdonságot."

#. SceneTree.current_scene
#: doc/classes/SceneTree.xml
msgid "The root node of the currently loaded main scene, usually as a direct child of [member root]. See also [method change_scene_to_file], [method change_scene_to_packed], and [method reload_current_scene].\n[b]Warning:[/b] Setting this property directly may not work as expected, as it does [i]not[/i] add or remove any nodes from this tree."
msgstr "Az aktuálisan betöltött fő jelenet gyökércsomópontja, amely általában a [member root] közvetlen gyermeke. Lásd még a [method change_scene_to_file], a [method change_scene_to_packed] és a [method reload_current_scene] metódust.\n[b]Figyelmeztetés:[/b] A tulajdonság közvetlen beállítása eltérhet a várt működéstől, mert [i]nem[/i] ad hozzá és nem távolít el csomópontokat ebből a fából."

#. SceneTree.debug_collisions_hint
#: doc/classes/SceneTree.xml
msgid "If [code]true[/code], collision shapes will be visible when running the game from the editor for debugging purposes.\n[b]Note:[/b] This property is not designed to be changed at run-time. Changing the value of [member debug_collisions_hint] while the project is running will not have the desired effect."
msgstr "Ha az értéke [code]true[/code], a szerkesztőből indított játékban hibakeresési céllal láthatók az ütközési alakzatok.\n[b]Megjegyzés:[/b] A tulajdonság nem futás közbeni módosításra készült. A [member debug_collisions_hint] átállítása futó projektben nem a várt hatást eredményezi."

#. SceneTree.debug_navigation_hint
#: doc/classes/SceneTree.xml
msgid "If [code]true[/code], navigation polygons will be visible when running the game from the editor for debugging purposes.\n[b]Note:[/b] This property is not designed to be changed at run-time. Changing the value of [member debug_navigation_hint] while the project is running will not have the desired effect."
msgstr "Ha az értéke [code]true[/code], a szerkesztőből indított játékban hibakeresési céllal láthatók a navigációs sokszögek.\n[b]Megjegyzés:[/b] A tulajdonság nem futás közbeni módosításra készült. A [member debug_navigation_hint] átállítása futó projektben nem a várt hatást eredményezi."

#. SceneTree.debug_paths_hint
#: doc/classes/SceneTree.xml
msgid "If [code]true[/code], curves from [Path2D] and [Path3D] nodes will be visible when running the game from the editor for debugging purposes.\n[b]Note:[/b] This property is not designed to be changed at run-time. Changing the value of [member debug_paths_hint] while the project is running will not have the desired effect."
msgstr "Ha az értéke [code]true[/code], a szerkesztőből indított játékban hibakeresési céllal láthatóak a [Path2D] és a [Path3D] csomópontok görbéi.\n[b]Megjegyzés:[/b] A tulajdonság nem futás közbeni módosításra készült. A [member debug_paths_hint] átállítása futó projektben nem a várt hatást eredményezi."

#. SceneTree.edited_scene_root
#: doc/classes/SceneTree.xml
msgid "The root of the scene currently being edited in the editor. This is usually a direct child of [member root].\n[b]Note:[/b] This property does nothing in release builds."
msgstr "A szerkesztőben éppen szerkesztett jelenet gyökere. Általában a [member root] közvetlen gyermeke.\n[b]Megjegyzés:[/b] A kiadásra szánt buildekben a tulajdonságnak nincs hatása."

#. SceneTree.multiplayer_poll
#: doc/classes/SceneTree.xml
msgid "If [code]true[/code] (default value), enables automatic polling of the [MultiplayerAPI] for this SceneTree during [signal process_frame].\nIf [code]false[/code], you need to manually call [method MultiplayerAPI.poll] to process network packets and deliver RPCs. This allows running RPCs in a different loop (e.g. physics, thread, specific time step) and for manual [Mutex] protection when accessing the [MultiplayerAPI] from threads."
msgstr "[code]true[/code] értéknél (alapértelmezés) a motor a [signal process_frame] jelzéskor automatikusan lekérdezi a SceneTree [MultiplayerAPI] példányát.\n[code]false[/code] értéknél neked kell meghívnod a [method MultiplayerAPI.poll] metódust a hálózati csomagok feldolgozásához és az RPC-hívások továbbításához. Így az RPC-k más ütemezésben is futhatnak, például a fizikai ciklusban, külön szálon vagy adott időlépéssel. A [MultiplayerAPI] több szálról történő elérése kézzel védhető [Mutex] használatával."

#. SceneTree.paused
#: doc/classes/SceneTree.xml
msgid "If [code]true[/code], the scene tree is considered paused. This causes the following behavior:\n- 2D and 3D physics will be stopped, as well as collision detection and related signals.\n- Depending on each node's [member Node.process_mode], their [method Node._process], [method Node._physics_process] and [method Node._input] callback methods may not called anymore."
msgstr "[code]true[/code] értéknél a jelenetfa szünetel. Ennek a következő hatásai vannak:\n- A 2D és 3D fizika leáll, az ütközésérzékeléssel és a hozzá tartozó jelzésekkel együtt.\n- A csomópontok [member Node.process_mode] értékétől függően a [method Node._process], a [method Node._physics_process] és a [method Node._input] visszahívások futása is leállhat."

#. SceneTree.physics_interpolation
#: doc/classes/SceneTree.xml
msgid "If [code]true[/code], the renderer will interpolate the transforms of objects (both physics and non-physics) between the last two transforms, so that smooth motion is seen even when physics ticks do not coincide with rendered frames.\nThe default value of this property is controlled by [member ProjectSettings.physics/common/physics_interpolation].\n[b]Note:[/b] Although this is a global setting, finer control of individual branches of the [SceneTree] is possible using [member Node.physics_interpolation_mode]."
msgstr "[code]true[/code] értéknél a renderelő a fizikai és a fizika nélküli objektumok utolsó két transzformációja között interpolál. A mozgás így akkor is folyamatosnak látszik, ha a fizikai lépések és a kirajzolt képkockák nem esnek egybe.\nAz alapértelmezett értéket a [member ProjectSettings.physics/common/physics_interpolation] beállítás határozza meg.\n[b]Megjegyzés:[/b] A globális beállítás mellett a [SceneTree] egyes ágain a [member Node.physics_interpolation_mode] értékével pontosabban szabályozható a viselkedés."

#. SceneTree.quit_on_go_back
#: doc/classes/SceneTree.xml
msgid "If [code]true[/code], the application quits automatically when navigating back (e.g. using the system \"Back\" button on Android).\nTo handle 'Go Back' button when this option is disabled, use [constant DisplayServer.WINDOW_EVENT_GO_BACK_REQUEST]."
msgstr "[code]true[/code] értéknél az alkalmazás automatikusan kilép visszalépéskor, például az Android rendszer Vissza gombjával.\nHa ez a beállítás ki van kapcsolva, a visszalépés kezeléséhez a [constant DisplayServer.WINDOW_EVENT_GO_BACK_REQUEST] állandót használd."

#. SceneTree.root
#: doc/classes/SceneTree.xml
msgid "The tree's root [Window]. This is top-most [Node] of the scene tree, and is always present. An absolute [NodePath] always starts from this node. Children of the root node may include the loaded [member current_scene], as well as any [url=$DOCS_URL/tutorials/scripting/singletons_autoload.html]AutoLoad[/url] configured in the Project Settings.\n[b]Warning:[/b] Do not delete this node. This will result in unstable behavior, followed by a crash."
msgstr "A fa gyökérablaka ([Window]). Ez a jelenetfa legfelső [Node] csomópontja, és mindig jelen van. Az abszolút [NodePath] mindig ebből a csomópontból indul. Közvetlen gyermekei közé tartozhat a betöltött [member current_scene], illetve a Projektbeállításokban megadott bármely [url=$DOCS_URL/tutorials/scripting/singletons_autoload.html]AutoLoad[/url] csomópont.\n[b]Figyelmeztetés:[/b] Ne töröld ezt a csomópontot. Ez instabil működéshez, majd összeomláshoz vezet."

#. SceneTree.GROUP_CALL_DEFAULT
#: doc/classes/SceneTree.xml
msgid "Call nodes within a group with no special behavior (default)."
msgstr "A csoport csomópontjain a szokásos módon hajtja végre a hívást. Ez az alapértelmezés."

#. SceneTree.GROUP_CALL_REVERSE
#: doc/classes/SceneTree.xml
msgid "Call nodes within a group in reverse tree hierarchy order (all nested children are called before their respective parent nodes)."
msgstr "A csoport csomópontjain fordított hierarchiasorrendben hajtja végre a hívást. Az összes leszármazotton lefut a saját szülője előtt."

#. SceneTree.GROUP_CALL_DEFERRED
#: doc/classes/SceneTree.xml
msgid "Call nodes within a group at the end of the current frame (can be either process or physics frame), similar to [method Object.call_deferred]."
msgstr "A csoport csomópontjain az aktuális feldolgozási vagy fizikai képkocka végén hajtja végre a hívást, a [method Object.call_deferred] metódushoz hasonlóan."

#. SceneTree.GROUP_CALL_UNIQUE
#: doc/classes/SceneTree.xml
msgid "Call nodes within a group only once, even if the call is executed many times in the same frame. Must be combined with [constant GROUP_CALL_DEFERRED] to work.\n[b]Note:[/b] Different arguments are not taken into account. Therefore, when the same call is executed with different arguments, only the first call will be performed."
msgstr "A csoport csomópontjain csak egyszer hajtja végre a hívást, akkor is, ha az ugyanabban a képkockában többször megtörténik. A működéshez a [constant GROUP_CALL_DEFERRED] jelzővel együtt kell használni.\n[b]Megjegyzés:[/b] Az argumentumok eltérése nem számít. Ha ugyanazt a metódust különböző argumentumokkal hívják meg, csak az első hívás fut le."

#. SceneTreeTimer.brief
#: doc/classes/SceneTreeTimer.xml
msgid "One-shot timer."
msgstr "Egyszer lefutó időzítő."

#. SceneTreeTimer.description
#: doc/classes/SceneTreeTimer.xml
msgid "A one-shot timer managed by the scene tree, which emits [signal timeout] on completion. See also [method SceneTree.create_timer].\nAs opposed to [Timer], it does not require the instantiation of a node. Commonly used to create a one-shot delay timer as in the following example:\n[codeblocks]\n[gdscript]\nfunc some_function():\n\tprint(\"Timer started.\")\n\tawait get_tree().create_timer(1.0).timeout\n\tprint(\"Timer ended.\")\n[/gdscript]\n[csharp]\npublic async Task SomeFunction()\n{\n\tGD.Print(\"Timer started.\");\n\tawait ToSignal(GetTree().CreateTimer(1.0f), SceneTreeTimer.SignalName.Timeout);\n\tGD.Print(\"Timer ended.\");\n}\n[/csharp]\n[/codeblocks]\nThe timer will be dereferenced after its time elapses. To preserve the timer, you can keep a reference to it. See [RefCounted].\n[b]Note:[/b] The timer is processed after all of the nodes in the current frame, i.e. node's [method Node._process] method would be called before the timer (or [method Node._physics_process] if [code]process_in_physics[/code] in [method SceneTree.create_timer] has been set to [code]true[/code])."
msgstr "A jelenetfa által kezelt, egyszer lefutó időzítő, amely lejáratkor elküldi a [signal timeout] jelzést. Lásd még a [method SceneTree.create_timer] metódust.\nA [Timer] időzítőhöz képest ehhez nem kell csomópontot példányosítani. Gyakran használják egyszeri késleltetéshez, például így:\n[codeblocks]\n[gdscript]\nfunc some_function():\n\tprint(\"Timer started.\")\n\tawait get_tree().create_timer(1.0).timeout\n\tprint(\"Timer ended.\")\n[/gdscript]\n[csharp]\npublic async Task SomeFunction()\n{\n\tGD.Print(\"Timer started.\");\n\tawait ToSignal(GetTree().CreateTimer(1.0f), SceneTreeTimer.SignalName.Timeout);\n\tGD.Print(\"Timer ended.\");\n}\n[/csharp]\n[/codeblocks]\nLejáratkor a jelenetfa elengedi az időzítőre mutató hivatkozást. Ha meg szeretnéd tartani az időzítőt, őrizz meg rá egy hivatkozást. Lásd a [RefCounted] osztályt.\n[b]Megjegyzés:[/b] Az időzítő az aktuális képkocka összes csomópontja után fut. A csomópont [method Node._process] metódusa előbb hívódik meg, vagy a [method Node._physics_process], ha a [method SceneTree.create_timer] [code]process_in_physics[/code] paramétere [code]true[/code]."

#. SceneTreeTimer.timeout
#: doc/classes/SceneTreeTimer.xml
msgid "Emitted when the timer reaches 0."
msgstr "Akkor küldi el, amikor az időzítő eléri a 0-t."

#. SceneTreeTimer.time_left
#: doc/classes/SceneTreeTimer.xml
msgid "The time remaining (in seconds)."
msgstr "A hátralévő idő másodpercben."

#. Timer.brief
#: doc/classes/Timer.xml
msgid "A countdown timer."
msgstr "Visszaszámláló időzítő."

#. Timer.description
#: doc/classes/Timer.xml
msgid "The [Timer] node is a countdown timer and is the simplest way to handle time-based logic in the engine. When a timer reaches the end of its [member wait_time], it will emit the [signal timeout] signal.\nAfter a timer enters the scene tree, it can be manually started with [method start]. A timer node is also started automatically if [member autostart] is [code]true[/code].\nWithout requiring much code, a timer node can be added and configured in the editor. The [signal timeout] signal it emits can also be connected through the Signals dock in the editor:\n[codeblock]\nfunc _on_timer_timeout():\n\tprint(\"Time to attack!\")\n[/codeblock]\n[b]Note:[/b] To create a one-shot timer without instantiating a node, use [method SceneTree.create_timer].\n[b]Note:[/b] Timers are affected by [member Engine.time_scale] unless [member ignore_time_scale] is [code]true[/code]. The higher the time scale, the sooner timers will end. How often a timer processes may depend on the framerate or [member Engine.physics_ticks_per_second]."
msgstr "A [Timer] csomópont visszaszámláló időzítő. Ez a motor legegyszerűbb eszköze az időzített működéshez. A [member wait_time] elteltével elküldi a [signal timeout] jelzést.\nMiután az időzítő bekerült a jelenetfába, kézzel elindítható a [method start] metódussal. Az időzítő automatikusan elindul, ha a [member autostart] értéke [code]true[/code].\nA szerkesztőben kevés kóddal adhatsz hozzá és állíthatsz be időzítőt. A [signal timeout] jelzés is csatlakoztatható a szerkesztő Jelzések paneljén:\n[codeblock]\nfunc _on_timer_timeout():\n\tprint(\"Time to attack!\")\n[/codeblock]\n[b]Megjegyzés:[/b] Csomópont példányosítása nélküli, egyszeri időzítéshez használd a [method SceneTree.create_timer] metódust.\n[b]Megjegyzés:[/b] A [member Engine.time_scale] az időzítőkre is hatással van, kivéve, ha a [member ignore_time_scale] értéke [code]true[/code]. Nagyobb időskálán az időzítők hamarabb járnak le. A feldolgozás gyakorisága a képkockasebességtől vagy a [member Engine.physics_ticks_per_second] értékétől függhet."

#. Timer.stop
#: doc/classes/Timer.xml
msgid "Stops the timer. See also [member paused]. Unlike [method start], this can safely be called if the timer is not inside the scene tree.\n[b]Note:[/b] Calling [method stop] does not emit the [signal timeout] signal, as the timer is not considered to have timed out. If this is desired, use [code]$Timer.timeout.emit()[/code] after calling [method stop] to manually emit the signal."
msgstr "Leállítja az időzítőt. Lásd még a [member paused] tulajdonságot. A [method start] metódustól eltérően ez akkor is biztonságosan meghívható, ha az időzítő nincs a jelenetfában.\n[b]Megjegyzés:[/b] A [method stop] hívásakor a [signal timeout] jelzés nem érkezik meg, mert az időzítő leállt, de nem járt le. Ha szükség van a jelzésre, a [method stop] után kézzel küldd el a [code]$Timer.timeout.emit()[/code] kóddal."

#. Timer.wait_time
#: doc/classes/Timer.xml
msgid "The time required for the timer to end, in seconds. This property can also be set every time [method start] is called.\n[b]Note:[/b] Timers can only process once per physics or process frame (depending on the [member process_callback]). An unstable framerate may cause the timer to end inconsistently, which is especially noticeable if the wait time is lower than roughly [code]0.05[/code] seconds. For very short timers, it is recommended to write your own code instead of using a [Timer] node. Timers are also affected by [member Engine.time_scale]."
msgstr "Az időzítő lejártáig szükséges idő másodpercben. A tulajdonság a [method start] minden hívásakor megadható.\n[b]Megjegyzés:[/b] Az időzítők fizikai vagy feldolgozási képkockánként egyszer frissülhetnek a [member process_callback] beállításától függően. Ingadozó képkockasebességnél eltérhet a tényleges lejárati idő. Ez nagyjából [code]0.05[/code] másodpercnél rövidebb időzítésnél különösen észrevehető. Nagyon rövid időzítéshez érdemes saját kódot használni a [Timer] csomópont helyett. A [member Engine.time_scale] az időzítőkre is hatással van."

#. Timer.TIMER_PROCESS_PHYSICS
#: doc/classes/Timer.xml
msgid "Update the timer every physics process frame (see [constant Node.NOTIFICATION_INTERNAL_PHYSICS_PROCESS])."
msgstr "Minden fizikai képkockában frissíti az időzítőt (lásd: [constant Node.NOTIFICATION_INTERNAL_PHYSICS_PROCESS])."

#. Timer.TIMER_PROCESS_IDLE
#: doc/classes/Timer.xml
msgid "Update the timer every process (rendered) frame (see [constant Node.NOTIFICATION_INTERNAL_PROCESS])."
msgstr "Minden feldolgozási (kirajzolt) képkockában frissíti az időzítőt (lásd: [constant Node.NOTIFICATION_INTERNAL_PROCESS])."

#. MainLoop.NOTIFICATION_APPLICATION_PIP_MODE_ENTERED
#. Node.NOTIFICATION_APPLICATION_PIP_MODE_ENTERED
#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid "Notification received when the application enters picture-in-picture mode."
msgstr "Akkor kapja meg ezt az értesítést, amikor az alkalmazás kép a képben módba lép."

#. MainLoop.NOTIFICATION_OS_IME_UPDATE
#. Node.NOTIFICATION_OS_IME_UPDATE
#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid "Notification received from the OS when an update of the Input Method Engine occurs (e.g. change of IME cursor position or composition string).\nImplemented on desktop and web platforms."
msgstr "Az operációs rendszer akkor küldi ezt az értesítést, amikor a beviteli mód szerkesztője (IME) frissül, például megváltozik a kurzor helye vagy az összeállítás alatt álló szöveg.\nAsztali és webes platformokon érhető el."

#. MainLoop.NOTIFICATION_APPLICATION_RESUMED
#. Node.NOTIFICATION_APPLICATION_RESUMED
#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid "Notification received from the OS when the application is resumed.\nSpecific to the Android and iOS platforms."
msgstr "Az operációs rendszer akkor küldi ezt az értesítést, amikor az alkalmazás folytatja a működését.\nAndroidra és iOS-re jellemző."

#. MainLoop.NOTIFICATION_APPLICATION_PAUSED
#. Node.NOTIFICATION_APPLICATION_PAUSED
#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid "Notification received from the OS when the application is paused.\nSpecific to the Android and iOS platforms.\n[b]Note:[/b] On iOS, you only have approximately 5 seconds to finish a task started by this signal. If you go over this allotment, iOS will kill the app instead of pausing it."
msgstr "Az operációs rendszer akkor küldi ezt az értesítést, amikor az alkalmazást szüneteltetik.\nAndroidra és iOS-re jellemző.\n[b]Megjegyzés:[/b] iOS-en nagyjából 5 másodperc áll rendelkezésre az értesítés hatására elindított feladat befejezésére. Ha túlléped ezt az időt, az iOS szüneteltetés helyett leállítja az alkalmazást."

#. MainLoop.NOTIFICATION_APPLICATION_FOCUS_IN
#. Node.NOTIFICATION_APPLICATION_FOCUS_IN
#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid "Notification received from the OS when the application is focused, i.e. when changing the focus from the OS desktop or a thirdparty application to any open window of the Godot instance.\nImplemented on desktop and mobile platforms."
msgstr "Az operációs rendszer akkor küldi ezt az értesítést, amikor az alkalmazás fókuszt kap, vagyis a fókusz az asztalról vagy egy másik alkalmazásról a Godot-példány valamelyik nyitott ablakára kerül.\nAsztali és mobilplatformokon érhető el."

#. MainLoop.NOTIFICATION_APPLICATION_FOCUS_OUT
#. Node.NOTIFICATION_APPLICATION_FOCUS_OUT
#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid "Notification received from the OS when the application is defocused, i.e. when changing the focus from any open window of the Godot instance to the OS desktop or a thirdparty application.\nImplemented on desktop and mobile platforms."
msgstr "Az operációs rendszer akkor küldi ezt az értesítést, amikor az alkalmazás elveszíti a fókuszt, vagyis a fókusz a Godot-példány valamelyik nyitott ablakáról az asztalra vagy egy másik alkalmazásra kerül.\nAsztali és mobilplatformokon érhető el."

#. MainLoop.NOTIFICATION_APPLICATION_PIP_MODE_EXITED
#. Node.NOTIFICATION_APPLICATION_PIP_MODE_EXITED
#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid "Notification received when the application exits picture-in-picture mode."
msgstr "Akkor kapja meg ezt az értesítést, amikor az alkalmazás kilép a kép a képben módból."

#. Node.set_translation_domain_inherited
#: doc/classes/Node.xml
msgid "Makes this node inherit the translation domain from its parent node. If this node has no parent, the main translation domain will be used.\nThis is the default behavior for all nodes. Calling [method Object.set_translation_domain] disables this behavior."
msgstr "Ezzel a csomópont a szülőjétől örökli a fordítási tartományát. Ha nincs szülője, a fő fordítási tartományt használja.\nEz minden csomópont alapértelmezett viselkedése. A [method Object.set_translation_domain] hívása kikapcsolja az öröklést."

#. Node.update_configuration_warnings
#: doc/classes/Node.xml
msgid "Refreshes the warnings displayed for this node in the Scene dock. Use [method _get_configuration_warnings] to customize the warning messages to display."
msgstr "Frissíti a csomóponthoz a Jelenet panelen megjelenő figyelmeztetéseket. Az üzenetek testreszabásához használd a [method _get_configuration_warnings] metódust."

#. Node.child_entered_tree
#: doc/classes/Node.xml
msgid "Emitted when the child [param node] enters the [SceneTree], usually because this node entered the tree (see [signal tree_entered]), or [method add_child] has been called.\nThis signal is emitted [i]after[/i] the child node's own [constant NOTIFICATION_ENTER_TREE] and [signal tree_entered]."
msgstr "Akkor küldi el, amikor a [param node] gyermek belép a [SceneTree] jelenetfába. Ez általában akkor történik, amikor ez a csomópont belép a fába (lásd: [signal tree_entered]), vagy meghívják a [method add_child] metódust.\nA jelzést a gyermek saját [constant NOTIFICATION_ENTER_TREE] értesítése és [signal tree_entered] jelzése [i]után[/i] küldi el."

#. Node.child_exiting_tree
#: doc/classes/Node.xml
msgid "Emitted when the child [param node] is about to exit the [SceneTree], usually because this node is exiting the tree (see [signal tree_exiting]), or because the child [param node] is being removed or freed.\nWhen this signal is received, the child [param node] is still accessible inside the tree. This signal is emitted [i]after[/i] the child node's own [signal tree_exiting] and [constant NOTIFICATION_EXIT_TREE]."
msgstr "Akkor küldi el, amikor a [param node] gyermek éppen kilépni készül a [SceneTree] jelenetfából. Ez általában akkor történik, amikor ez a csomópont kilép a fából (lásd: [signal tree_exiting]), vagy eltávolítják, illetve felszabadítják a [param node] gyermeket.\nA jelzés fogadásakor a [param node] gyermek még elérhető a fában. A jelzést a gyermek saját [signal tree_exiting] jelzése és [constant NOTIFICATION_EXIT_TREE] értesítése [i]után[/i] küldi el."

#. Node.child_order_changed
#: doc/classes/Node.xml
msgid "Emitted when the list of children is changed. This happens when child nodes are added, moved or removed."
msgstr "Akkor küldi el, amikor megváltozik a gyermekcsomópontok listája, például egy gyermek hozzáadásakor, áthelyezésekor vagy eltávolításakor."

#. Node.editor_description_changed
#: doc/classes/Node.xml
msgid "Emitted when the node's editor description field changed."
msgstr "Akkor küldi el, amikor megváltozik a csomópont szerkesztőbeli leírása."

#. Node.editor_state_changed
#: doc/classes/Node.xml
msgid "Emitted when an attribute of the node that is relevant to the editor is changed. Only emitted in the editor."
msgstr "Akkor küldi el, amikor megváltozik a csomópont valamely, a szerkesztő számára fontos jellemzője. Csak a szerkesztőben küldi el."

#. Node.ready
#: doc/classes/Node.xml
msgid "Emitted when the node is considered ready, after [method _ready] is called."
msgstr "Akkor küldi el, amikor a csomópont készen áll, a [method _ready] hívása után."

#. Node.renamed
#: doc/classes/Node.xml
msgid "Emitted when the node's [member name] is changed, if the node is inside the tree."
msgstr "Akkor küldi el, amikor a fában lévő csomópont [member name] tulajdonsága megváltozik."

#. Node.replacing_by
#: doc/classes/Node.xml
msgid "Emitted when this node is being replaced by the [param node], see [method replace_by].\nThis signal is emitted [i]after[/i] [param node] has been added as a child of the original parent node, but [i]before[/i] all original child nodes have been reparented to [param node]."
msgstr "Akkor küldi el, amikor ezt a csomópontot lecseréli a [param node] csomópontra. Lásd a [method replace_by] metódust.\nA jelzést azután küldi el, [i]hogy[/i] a [param node] már az eredeti szülő gyermeke lett, de [i]még azelőtt[/i], hogy az összes eredeti gyermekcsomópont szülője a [param node] lenne."

#. Node.tree_entered
#: doc/classes/Node.xml
msgid "Emitted when the node enters the tree.\nThis signal is emitted [i]after[/i] the related [constant NOTIFICATION_ENTER_TREE] notification."
msgstr "Akkor küldi el, amikor a csomópont belép a fába.\nA jelzést a kapcsolódó [constant NOTIFICATION_ENTER_TREE] értesítés [i]után[/i] küldi el."

#. Node.tree_exited
#: doc/classes/Node.xml
msgid "Emitted after the node exits the tree and is no longer active.\nThis signal is emitted [i]after[/i] the related [constant NOTIFICATION_EXIT_TREE] notification."
msgstr "Akkor küldi el, amikor a csomópont már kilépett a fából, és már nem aktív.\nA jelzést a kapcsolódó [constant NOTIFICATION_EXIT_TREE] értesítés [i]után[/i] küldi el."

#. Node.tree_exiting
#: doc/classes/Node.xml
msgid "Emitted when the node is just about to exit the tree. The node is still valid. As such, this is the right place for de-initialization (or a \"destructor\", if you will).\nThis signal is emitted [i]after[/i] the node's [method _exit_tree], and [i]before[/i] the related [constant NOTIFICATION_EXIT_TREE]."
msgstr "Akkor küldi el, amikor a csomópont éppen kilépni készül a fából. Ilyenkor még érvényes, ezért itt érdemes lebontani az állapotát, például felszabadítani a hozzá tartozó erőforrásokat.\nA jelzést a csomópont [method _exit_tree] hívása [i]után[/i], de a kapcsolódó [constant NOTIFICATION_EXIT_TREE] értesítés [i]előtt[/i] küldi el."

#. Node.auto_translate_mode
#: doc/classes/Node.xml
msgid "Defines if any text should automatically change to its translated version depending on the current locale (for nodes such as [Label], [RichTextLabel], [Window], etc.). Also decides if the node's strings should be parsed for translation template generation.\n[b]Note:[/b] For the root node, auto translate mode can also be set via [member ProjectSettings.internationalization/rendering/root_node_auto_translate]."
msgstr "Meghatározza, hogy az aktuális nyelvi beállítás szerint automatikusan a fordításra váltson-e a megjelenített szöveg, például [Label], [RichTextLabel] és [Window] csomópontoknál. Azt is meghatározza, hogy a fordítási sablon előállításakor a motor feldolgozza-e a csomópont szövegeit.\n[b]Megjegyzés:[/b] A gyökércsomópont automatikus fordítási módja a [member ProjectSettings.internationalization/rendering/root_node_auto_translate] beállítással is megadható."

#. Node.editor_description
#: doc/classes/Node.xml
msgid "An optional description to the node. It will be displayed as a tooltip when hovering over the node in the editor's Scene dock."
msgstr "A csomópont választható leírása. Eszköztippként jelenik meg, amikor a mutató a csomópont fölött van a szerkesztő Jelenet paneljén."

#. Node.multiplayer
#: doc/classes/Node.xml
msgid "The [MultiplayerAPI] instance associated with this node. See [method SceneTree.get_multiplayer].\n[b]Note:[/b] Renaming the node, or moving it in the tree, will not move the [MultiplayerAPI] to the new path, you will have to update this manually."
msgstr "A csomóponthoz rendelt [MultiplayerAPI] példány. Lásd a [method SceneTree.get_multiplayer] metódust.\n[b]Megjegyzés:[/b] A csomópont átnevezése vagy áthelyezése a fában nem helyezi át a [MultiplayerAPI] példányt az új útvonalra. Ezt kézzel kell frissítened."

#. Node.name
#: doc/classes/Node.xml
msgid "The name of the node. This name must be unique among the siblings (other child nodes from the same parent). When set to an existing sibling's name, the node is automatically renamed.\n[b]Note:[/b] When changing the name, the following characters will be replaced with an underscore: ([code].[/code] [code]:[/code] [code]@[/code] [code]/[/code] [code]\"[/code] [code]%[/code]). In particular, the [code]@[/code] character is reserved for auto-generated names. See also [method String.validate_node_name]."
msgstr "A csomópont neve. Egyedinek kell lennie az azonos szülőhöz tartozó többi gyermek között. Ha egy már létező testvércsomópont nevét állítod be, a motor automatikusan átnevezi a csomópontot.\n[b]Megjegyzés:[/b] A név módosításakor a motor a következő karaktereket aláhúzásjelre cseréli: ([code].[/code] [code]:[/code] [code]@[/code] [code]/[/code] [code]\"[/code] [code]%[/code]). A [code]@[/code] karaktert az automatikusan előállított nevek számára tartja fenn. Lásd még a [method String.validate_node_name] metódust."

#. Node.owner
#: doc/classes/Node.xml
msgid "The owner of this node. The owner must be an ancestor of this node. When packing the owner node in a [PackedScene], all the nodes it owns are also saved with it. See also [member unique_name_in_owner].\n[b]Note:[/b] In the editor, nodes not owned by the scene root are usually not displayed in the Scene dock, and will [b]not[/b] be saved. To prevent this, remember to set the owner after calling [method add_child].\n[b]Note:[/b] The owner needs to be the current scene root. See [url=$DOCS_URL/tutorials/plugins/running_code_in_the_editor.html#instancing-scenes]Instancing scenes[/url] in the documentation for more information."
msgstr "A csomópont tulajdonosa. A tulajdonosnak a csomópont egyik felmenőjének kell lennie. Ha a tulajdonos csomópontot [PackedScene] erőforrásba csomagolod, a vele elmentett csomópontok közé kerül az összes, amelynek ő a tulajdonosa. Lásd még a [member unique_name_in_owner] tulajdonságot.\n[b]Megjegyzés:[/b] A szerkesztő Jelenet paneljén általában nem láthatók azok a csomópontok, amelyeknek nem a jelenet gyökere a tulajdonosa, és a szerkesztő [b]nem[/b] menti őket. Ennek elkerüléséhez a [method add_child] után állítsd be a tulajdonost.\n[b]Megjegyzés:[/b] A tulajdonosnak az aktuális jelenet gyökerének kell lennie. További részletekért lásd a dokumentáció [url=$DOCS_URL/tutorials/plugins/running_code_in_the_editor.html#instancing-scenes]jelenetpéldányosításról szóló részét[/url]."

#. Node.physics_interpolation_mode
#: doc/classes/Node.xml
msgid "The physics interpolation mode to use for this node. Only effective if [member ProjectSettings.physics/common/physics_interpolation] or [member SceneTree.physics_interpolation] is [code]true[/code].\nBy default, nodes inherit the physics interpolation mode from their parent. This property can enable or disable physics interpolation individually for each node, regardless of their parents' physics interpolation mode.\n[b]Note:[/b] Some node types like [VehicleWheel3D] have physics interpolation disabled by default, as they rely on their own custom solution.\n[b]Note:[/b] When teleporting a node to a distant position, it's recommended to temporarily disable interpolation with [method Node.reset_physics_interpolation] [i]after[/i] moving the node. This avoids creating a visual streak between the old and new positions."
msgstr "A csomópont fizikai interpolációs módja. Csak akkor hatásos, ha a [member ProjectSettings.physics/common/physics_interpolation] vagy a [member SceneTree.physics_interpolation] értéke [code]true[/code].\nA csomópont alapértelmezésben a szülőjétől örökli a fizikai interpolációs módot. Ezzel a tulajdonsággal a fizikai interpoláció csomópontonként be- vagy kikapcsolható a szülők beállításától függetlenül.\n[b]Megjegyzés:[/b] Egyes típusokon, például a [VehicleWheel3D] csomóponton az interpoláció alapértelmezésben ki van kapcsolva, mert saját megoldást használnak.\n[b]Megjegyzés:[/b] Ha távoli helyre teleportálod a csomópontot, az áthelyezés [i]után[/i] érdemes ideiglenesen kikapcsolni az interpolációt a [method Node.reset_physics_interpolation] metódussal. Így nem jelenik meg csík a régi és az új hely között."

#. Node.process_mode
#: doc/classes/Node.xml
msgid "The node's processing behavior. To check if the node can process in its current mode, use [method can_process]."
msgstr "A csomópont feldolgozási módja. A [method can_process] metódussal ellenőrizheted, hogy a csomópont feldolgozható-e az aktuális módban."

#. Node.process_physics_priority
#: doc/classes/Node.xml
msgid "Similar to [member process_priority] but for [constant NOTIFICATION_PHYSICS_PROCESS], [method _physics_process], or [constant NOTIFICATION_INTERNAL_PHYSICS_PROCESS]."
msgstr "Olyan, mint a [member process_priority], de a [constant NOTIFICATION_PHYSICS_PROCESS], a [method _physics_process] vagy a [constant NOTIFICATION_INTERNAL_PHYSICS_PROCESS] feldolgozási sorrendjét szabályozza."

#. Node.process_priority
#: doc/classes/Node.xml
msgid "The node's execution order of the process callbacks ([method _process], [constant NOTIFICATION_PROCESS], and [constant NOTIFICATION_INTERNAL_PROCESS]). Nodes whose priority value is [i]lower[/i] call their process callbacks first, regardless of tree order."
msgstr "A csomópont feldolgozási visszahívásainak ([method _process], [constant NOTIFICATION_PROCESS] és [constant NOTIFICATION_INTERNAL_PROCESS]) futási sorrendjét szabályozza. A [i]kisebb[/i] prioritásértékű csomópontok visszahívásai futnak le előbb, a fa sorrendjétől függetlenül."

#. Node.process_thread_group
#: doc/classes/Node.xml
msgid "Set the process thread group for this node (basically, whether it receives [constant NOTIFICATION_PROCESS], [constant NOTIFICATION_PHYSICS_PROCESS], [method _process] or [method _physics_process] (and the internal versions) on the main thread or in a sub-thread.\nBy default, the thread group is [constant PROCESS_THREAD_GROUP_INHERIT], which means that this node belongs to the same thread group as the parent node. The thread groups means that nodes in a specific thread group will process together, separate to other thread groups (depending on [member process_thread_group_order]). If the value is set is [constant PROCESS_THREAD_GROUP_SUB_THREAD], this thread group will occur on a sub thread (not the main thread), otherwise if set to [constant PROCESS_THREAD_GROUP_MAIN_THREAD] it will process on the main thread. If there is not a parent or grandparent node set to something other than inherit, the node will belong to the [i]default thread group[/i]. This default group will process on the main thread and its group order is 0.\nDuring processing in a sub-thread, accessing most functions in nodes outside the thread group is forbidden (and it will result in an error in debug mode). Use [method Object.call_deferred], [method call_thread_safe], [method call_deferred_thread_group] and the likes in order to communicate from the thread groups to the main thread (or to other thread groups).\nTo better understand process thread groups, the idea is that any node set to any other value than [constant PROCESS_THREAD_GROUP_INHERIT] will include any child (and grandchild) nodes set to inherit into its process thread group. This means that the processing of all the nodes in the group will happen together, at the same time as the node including them."
msgstr "Megadja a csomópont feldolgozási szálcsoportját, vagyis azt, hogy a [constant NOTIFICATION_PROCESS] és a [constant NOTIFICATION_PHYSICS_PROCESS] értesítéseket, illetve a [method _process] és a [method _physics_process] hívásokat (a belső változatokkal együtt) a főszálon vagy mellékszálon kapja-e.\nAz alapértelmezett szálcsoport a [constant PROCESS_THREAD_GROUP_INHERIT]. Ilyenkor a csomópont a szülőjével azonos szálcsoportba tartozik. Egy szálcsoport csomópontjai együtt, a többi csoporttól elkülönítve futnak a [member process_thread_group_order] szerint. A [constant PROCESS_THREAD_GROUP_SUB_THREAD] beállításnál a csoport mellékszálon fut, míg [constant PROCESS_THREAD_GROUP_MAIN_THREAD] beállításnál a főszálon. Ha nincs olyan felmenő csomópont, amelynek értéke eltér az örökléstől, a csomópont az [i]alapértelmezett szálcsoportba[/i] kerül. Ez a főszálon fut, a sorrendi értéke 0.\nMellékszálon történő feldolgozáskor tilos hozzáférni a csoporton kívüli csomópontok legtöbb függvényéhez. Ez hibakeresési módban hibát okoz. A főszállal vagy más szálcsoportokkal a [method Object.call_deferred], a [method call_thread_safe], a [method call_deferred_thread_group] vagy hasonló metódusok segítségével kommunikálhatsz.\nHa egy csomópont értéke eltér a [constant PROCESS_THREAD_GROUP_INHERIT] értéktől, a saját szálcsoportjába gyűjti az öröklésre állított leszármazottait. Így a csoport összes csomópontja a csoportot meghatározó csomóponttal együtt fut."

#. Node.process_thread_group_order
#: doc/classes/Node.xml
msgid "Change the process thread group order. Groups with a lesser order will process before groups with a greater order. This is useful when a large amount of nodes process in sub thread and, afterwards, another group wants to collect their result in the main thread, as an example."
msgstr "Megadja a szálcsoport feldolgozási sorrendjét. Az alacsonyabb sorrendi értékű csoportok futnak előbb. Hasznos például akkor, ha sok csomópont mellékszálon fut, majd egy másik csoport a főszálon gyűjti össze az eredményüket."

#. Node.process_thread_messages
#: doc/classes/Node.xml
msgid "Set whether the current thread group will process messages (calls to [method call_deferred_thread_group] on threads), and whether it wants to receive them during regular process or physics process callbacks."
msgstr "Beállítja, hogy az aktuális szálcsoport feldolgozza-e a szálak között küldött üzeneteket (a [method call_deferred_thread_group] hívásait), valamint hogy a szokásos feldolgozási vagy a fizikai visszahívások során fogadja-e őket."

#. Node.scene_file_path
#: doc/classes/Node.xml
msgid "The original scene's file path, if the node has been instantiated from a [PackedScene] file. Only scene root nodes contains this."
msgstr "Az eredeti jelenet fájlútvonala, ha a csomópont [PackedScene] fájlból lett példányosítva. Csak a jelenetek gyökércsomópontján érhető el."

#. Node.unique_name_in_owner
#: doc/classes/Node.xml
msgid "If [code]true[/code], the node can be accessed from any node sharing the same [member owner] or from the [member owner] itself, with special [code]%Name[/code] syntax in [method get_node].\n[b]Note:[/b] If another node with the same [member owner] shares the same [member name] as this node, the other node will no longer be accessible as unique."
msgstr "[code]true[/code] értéknél a csomópont az azonos [member owner] értékű csomópontokból és magából a [member owner] csomópontból is elérhető a [method get_node] különleges [code]%Name[/code] szintaxisával.\n[b]Megjegyzés:[/b] Ha egy azonos [member owner] értékű másik csomópont ugyanezt a [member name] értéket kapja, a másik csomópont többé nem érhető el egyedi névvel."

#. Node.NOTIFICATION_ENTER_TREE
#: doc/classes/Node.xml
msgid "Notification received when the node enters a [SceneTree]. See [method _enter_tree].\nThis notification is received [i]before[/i] the related [signal tree_entered] signal."
msgstr "Akkor kapja a csomópont, amikor belép a [SceneTree] jelenetfába. Lásd a [method _enter_tree] metódust.\nA kapcsolódó [signal tree_entered] jelzés [i]előtt[/i] érkezik."

#. Node.NOTIFICATION_EXIT_TREE
#: doc/classes/Node.xml
msgid "Notification received when the node is about to exit a [SceneTree]. See [method _exit_tree].\nThis notification is received [i]after[/i] the related [signal tree_exiting] signal.\nThis notification is sent in reversed order."
msgstr "Akkor kapja a csomópont, amikor éppen kilépni készül a [SceneTree] jelenetfából. Lásd a [method _exit_tree] metódust.\nA kapcsolódó [signal tree_exiting] jelzés [i]után[/i] érkezik.\nEzt az értesítést fordított sorrendben küldi a motor."

#. Node.NOTIFICATION_READY
#: doc/classes/Node.xml
msgid "Notification received when the node is ready. See [method _ready]."
msgstr "Akkor kapja a csomópont, amikor készen áll. Lásd a [method _ready] metódust."

#. Node.NOTIFICATION_PAUSED
#: doc/classes/Node.xml
msgid "Notification received when the node is paused. See [member process_mode]."
msgstr "Akkor kapja a csomópont, amikor szünetelni kezd. Lásd a [member process_mode] tulajdonságot."

#. Node.NOTIFICATION_UNPAUSED
#: doc/classes/Node.xml
msgid "Notification received when the node is unpaused. See [member process_mode]."
msgstr "Akkor kapja a csomópont, amikor folytatja a működését. Lásd a [member process_mode] tulajdonságot."

#. Node.NOTIFICATION_PHYSICS_PROCESS
#: doc/classes/Node.xml
msgid "Notification received from the tree every physics frame when [method is_physics_processing] returns [code]true[/code]. See [method _physics_process]."
msgstr "A fa minden fizikai képkockában elküldi, ha a [method is_physics_processing] [code]true[/code] értéket ad vissza. Lásd a [method _physics_process] metódust."

#. Node.NOTIFICATION_PROCESS
#: doc/classes/Node.xml
msgid "Notification received from the tree every rendered frame when [method is_processing] returns [code]true[/code]. See [method _process]."
msgstr "A fa minden kirajzolt képkockában elküldi, ha a [method is_processing] [code]true[/code] értéket ad vissza. Lásd a [method _process] metódust."

#. Node.NOTIFICATION_PARENTED
#: doc/classes/Node.xml
msgid "Notification received when the node is set as a child of another node (see [method add_child] and [method add_sibling]).\n[b]Note:[/b] This does [i]not[/i] mean that the node entered the [SceneTree]."
msgstr "Akkor kapja a csomópont, amikor egy másik csomópont gyermekévé válik (lásd a [method add_child] és a [method add_sibling] metódust).\n[b]Megjegyzés:[/b] Ez [i]nem[/i] jelenti azt, hogy a csomópont belépett a [SceneTree] jelenetfába."

#. Node.NOTIFICATION_UNPARENTED
#: doc/classes/Node.xml
msgid "Notification received when the parent node calls [method remove_child] on this node.\n[b]Note:[/b] This does [i]not[/i] mean that the node exited the [SceneTree]."
msgstr "Akkor kapja a csomópont, amikor a szülője meghívja rajta a [method remove_child] metódust.\n[b]Megjegyzés:[/b] Ez [i]nem[/i] jelenti azt, hogy a csomópont kilépett a [SceneTree] jelenetfából."

#. Node.NOTIFICATION_SCENE_INSTANTIATED
#: doc/classes/Node.xml
msgid "Notification received [i]only[/i] by the newly instantiated scene root node, when [method PackedScene.instantiate] is completed."
msgstr "Az értesítést [i]csak[/i] az újonnan létrehozott jelenetpéldány gyökércsomópontja kapja meg a [method PackedScene.instantiate] befejezésekor."

#. Node.NOTIFICATION_DRAG_BEGIN
#: doc/classes/Node.xml
msgid "Notification received when a drag operation begins. All nodes receive this notification, not only the dragged one.\nCan be triggered either by dragging a [Control] that provides drag data (see [method Control._get_drag_data]) or using [method Control.force_drag].\nUse [method Viewport.gui_get_drag_data] to get the dragged data."
msgstr "A húzási művelet kezdetekor érkezik. Minden csomópont megkapja, a húzott elem is.\nKiváltható olyan [Control] húzásával, amely húzási adatokat ad át (lásd: [method Control._get_drag_data]), illetve a [method Control.force_drag] hívásával.\nA húzott adatok lekéréséhez használd a [method Viewport.gui_get_drag_data] metódust."

#. Node.NOTIFICATION_DRAG_END
#: doc/classes/Node.xml
msgid "Notification received when a drag operation ends.\nUse [method Viewport.gui_is_drag_successful] to check if the drag succeeded."
msgstr "A húzási művelet végén érkezik.\nA művelet sikerét a [method Viewport.gui_is_drag_successful] metódussal ellenőrizheted."

#. Node.NOTIFICATION_PATH_RENAMED
#: doc/classes/Node.xml
msgid "Notification received when the node's [member name] or one of its ancestors' [member name] is changed. This notification is [i]not[/i] received when the node is removed from the [SceneTree]."
msgstr "Akkor érkezik, amikor megváltozik a csomópont [member name] tulajdonsága vagy valamely felmenőjének [member name] tulajdonsága. Ezt az értesítést [i]nem[/i] küldi el a motor, amikor a csomópont kikerül a [SceneTree] jelenetfából."

#. Node.NOTIFICATION_CHILD_ORDER_CHANGED
#: doc/classes/Node.xml
msgid "Notification received when the list of children is changed. This happens when child nodes are added, moved or removed."
msgstr "Akkor érkezik, amikor megváltozik a gyermekcsomópontok listája, például egy gyermek hozzáadásakor, áthelyezésekor vagy eltávolításakor."

#. Node.NOTIFICATION_INTERNAL_PROCESS
#: doc/classes/Node.xml
msgid "Notification received from the tree every rendered frame when [method is_processing_internal] returns [code]true[/code]."
msgstr "A fa minden kirajzolt képkockában elküldi, ha a [method is_processing_internal] [code]true[/code] értéket ad vissza."

#. Node.NOTIFICATION_INTERNAL_PHYSICS_PROCESS
#: doc/classes/Node.xml
msgid "Notification received from the tree every physics frame when [method is_physics_processing_internal] returns [code]true[/code]."
msgstr "A fa minden fizikai képkockában elküldi, ha a [method is_physics_processing_internal] [code]true[/code] értéket ad vissza."

#. Node.NOTIFICATION_POST_ENTER_TREE
#: doc/classes/Node.xml
msgid "Notification received when the node enters the tree, just before [constant NOTIFICATION_READY] may be received. Unlike the latter, it is sent every time the node enters tree, not just once."
msgstr "Amikor a csomópont belép a fába, közvetlenül azelőtt érkezik, hogy a csomópont megkaphatná a [constant NOTIFICATION_READY] értesítést. Ezt az értesítést a motor minden belépéskor elküldi."

#. Node.NOTIFICATION_DISABLED
#: doc/classes/Node.xml
msgid "Notification received when the node is disabled. See [constant PROCESS_MODE_DISABLED]."
msgstr "Akkor kapja a csomópont, amikor letiltják. Lásd a [constant PROCESS_MODE_DISABLED] állandót."

#. Node.NOTIFICATION_ENABLED
#: doc/classes/Node.xml
msgid "Notification received when the node is enabled again after being disabled. See [constant PROCESS_MODE_DISABLED]."
msgstr "Akkor kapja a csomópont, amikor a letiltás után ismét engedélyezik. Lásd a [constant PROCESS_MODE_DISABLED] állandót."

#. Node.NOTIFICATION_RESET_PHYSICS_INTERPOLATION
#: doc/classes/Node.xml
msgid "Notification received when [method reset_physics_interpolation] is called on the node or its ancestors."
msgstr "Akkor érkezik, amikor meghívják a [method reset_physics_interpolation] metódust a csomóponton vagy valamelyik felmenőjén."

#. Node.NOTIFICATION_EDITOR_PRE_SAVE
#: doc/classes/Node.xml
msgid "Notification received right before the scene with the node is saved in the editor. This notification is only sent in the Godot editor and will not occur in exported projects."
msgstr "Közvetlenül a csomópontot tartalmazó jelenet mentése előtt érkezik. Csak a Godot szerkesztőben érkezik, exportált projektben nem."

#. Node.NOTIFICATION_EDITOR_POST_SAVE
#: doc/classes/Node.xml
msgid "Notification received right after the scene with the node is saved in the editor. This notification is only sent in the Godot editor and will not occur in exported projects."
msgstr "Közvetlenül a csomópontot tartalmazó jelenet mentése után érkezik. Csak a Godot szerkesztőben érkezik, exportált projektben nem."

#. Node.NOTIFICATION_WM_MOUSE_ENTER
#: doc/classes/Node.xml
msgid "Notification received when the mouse enters the window.\nImplemented for embedded windows and on desktop and web platforms."
msgstr "Akkor érkezik, amikor az egérmutató belép az ablakba.\nBeágyazott ablakoknál, valamint asztali és webes platformokon érhető el."

#. Node.NOTIFICATION_WM_MOUSE_EXIT
#: doc/classes/Node.xml
msgid "Notification received when the mouse leaves the window.\nImplemented for embedded windows and on desktop and web platforms."
msgstr "Akkor érkezik, amikor az egérmutató elhagyja az ablakot.\nBeágyazott ablakoknál, valamint asztali és webes platformokon érhető el."

#. Node.NOTIFICATION_WM_WINDOW_FOCUS_IN
#: doc/classes/Node.xml
msgid "Notification received from the OS when the node's [Window] ancestor is focused. This may be a change of focus between two windows of the same engine instance, or from the OS desktop or a third-party application to a window of the game (in which case [constant NOTIFICATION_APPLICATION_FOCUS_IN] is also received).\nA [Window] node receives this notification when it is focused."
msgstr "Az operációs rendszer akkor küldi, amikor a csomópont [Window] felmenője fókuszt kap. A fókusz átválthat a motor azonos példányának két ablaka között, illetve az asztalról vagy egy másik alkalmazásból a játék egyik ablakára. Az utóbbi esetben a [constant NOTIFICATION_APPLICATION_FOCUS_IN] értesítés is megérkezik.\nA [Window] csomópont akkor kapja meg, amikor fókuszt kap."

#. Node.NOTIFICATION_WM_WINDOW_FOCUS_OUT
#: doc/classes/Node.xml
msgid "Notification received from the OS when the node's [Window] ancestor is defocused. This may be a change of focus between two windows of the same engine instance, or from a window of the game to the OS desktop or a third-party application (in which case [constant NOTIFICATION_APPLICATION_FOCUS_OUT] is also received).\nA [Window] node receives this notification when it is defocused."
msgstr "Az operációs rendszer akkor küldi, amikor a csomópont [Window] felmenője elveszíti a fókuszt. A fókusz átválthat a motor azonos példányának két ablaka között, illetve a játék egyik ablakáról az asztalra vagy egy másik alkalmazásra. Az utóbbi esetben a [constant NOTIFICATION_APPLICATION_FOCUS_OUT] értesítés is megérkezik.\nA [Window] csomópont akkor kapja meg, amikor elveszíti a fókuszt."

#. Node.NOTIFICATION_WM_CLOSE_REQUEST
#: doc/classes/Node.xml
msgid "Notification received from the OS when a close request is sent (e.g. closing the window with a \"Close\" button or [kbd]Alt + F4[/kbd]).\nImplemented on desktop platforms."
msgstr "Az operációs rendszer bezárási kérelemkor küldi, például az ablak bezárógombjának vagy az [kbd]Alt + F4[/kbd] kombinációnak a megnyomásakor.\nAsztali platformokon érhető el."

#. Node.NOTIFICATION_WM_GO_BACK_REQUEST
#: doc/classes/Node.xml
msgid "Notification received from the OS when a go back request is sent (e.g. pressing the \"Back\" button on Android).\nImplemented only on Android."
msgstr "Az operációs rendszer visszalépési kérelemkor küldi, például az Android Vissza gombjának megnyomásakor.\nCsak Androidon érhető el."

#. Node.NOTIFICATION_WM_SIZE_CHANGED
#: doc/classes/Node.xml
msgid "Notification received when the window is resized.\n[b]Note:[/b] Only the resized [Window] node receives this notification, and it's not propagated to the child nodes."
msgstr "Az ablak átméretezésekor érkezik.\n[b]Megjegyzés:[/b] Csak az átméretezett [Window] csomópont kapja meg. A gyermekcsomópontokra nem terjed tovább."

#. Node.NOTIFICATION_WM_DPI_CHANGE
#: doc/classes/Node.xml
msgid "Notification received from the OS when the screen's dots per inch (DPI) scale is changed. Only implemented on macOS."
msgstr "Az operációs rendszer akkor küldi, amikor megváltozik a képernyő képpontsűrűsége (DPI). Csak macOS-en érhető el."

#. Node.NOTIFICATION_VP_MOUSE_ENTER
#: doc/classes/Node.xml
msgid "Notification received when the mouse cursor enters the [Viewport]'s visible area, that is not occluded behind other [Control]s or [Window]s, provided its [member Viewport.gui_disable_input] is [code]false[/code] and regardless if it's currently focused or not."
msgstr "Akkor érkezik, amikor a mutató belép a [Viewport] olyan látható részére, amelyet más [Control] vagy [Window] elemek nem takarnak. Ehhez a [member Viewport.gui_disable_input] értékének [code]false[/code] értéken kell állnia. A fókusz állapota nem számít."

#. Node.NOTIFICATION_VP_MOUSE_EXIT
#: doc/classes/Node.xml
msgid "Notification received when the mouse cursor leaves the [Viewport]'s visible area, that is not occluded behind other [Control]s or [Window]s, provided its [member Viewport.gui_disable_input] is [code]false[/code] and regardless if it's currently focused or not."
msgstr "Akkor érkezik, amikor a mutató elhagyja a [Viewport] olyan látható részét, amelyet más [Control] vagy [Window] elemek nem takarnak. Ehhez a [member Viewport.gui_disable_input] értékének [code]false[/code] értéken kell állnia. A fókusz állapota nem számít."

#. Node.NOTIFICATION_WM_POSITION_CHANGED
#: doc/classes/Node.xml
msgid "Notification received when the window is moved."
msgstr "Az ablak elmozdításakor érkezik."

#. Node.NOTIFICATION_WM_OUTPUT_MAX_LINEAR_VALUE_CHANGED
#: doc/classes/Node.xml
msgid "Notification received when the output max linear value returned by [method Window.get_output_max_linear_value] has changed.\nThis occurs when HDR output is enabled or disabled and when any HDR output luminance values of the window have changed, such as when the player adjusts their screen brightness setting or moves the window to a different screen."
msgstr "Akkor érkezik, amikor megváltozik a [method Window.get_output_max_linear_value] által visszaadott legnagyobb lineáris kimeneti érték.\nEz a HDR kimenet be- vagy kikapcsolásakor, illetve az ablak HDR kimeneti fénysűrűségének változásakor történik, például amikor a játékos módosítja a képernyő fényerejét vagy másik képernyőre húzza az ablakot."

#. Node.NOTIFICATION_OS_MEMORY_WARNING
#: doc/classes/Node.xml
msgid "Notification received from the OS when the application is exceeding its allocated memory.\nImplemented only on iOS."
msgstr "Az operációs rendszer akkor küldi, amikor az alkalmazás túllépi a számára biztosított memóriát.\nCsak iOS-en érhető el."

#. Node.NOTIFICATION_TRANSLATION_CHANGED
#: doc/classes/Node.xml
msgid "Notification received when translations may have changed. Can be triggered by the user changing the locale, changing [member auto_translate_mode] or when the node enters the scene tree. Can be used to respond to language changes, for example to change the UI strings on the fly. Useful when working with the built-in translation support, like [method Object.tr].\n[b]Note:[/b] This notification is received alongside [constant NOTIFICATION_ENTER_TREE], so if you are instantiating a scene, the child nodes will not be initialized yet. You can use it to setup translations for this node, child nodes created from script, or if you want to access child nodes added in the editor, make sure the node is ready using [method is_node_ready].\n[codeblock]\nfunc _notification(what):\n\tif what == NOTIFICATION_TRANSLATION_CHANGED:\n\t\tif not is_node_ready():\n\t\t\tawait ready # Wait until ready signal.\n\t\t$Label.text = atr(\"%d Bananas\") % banana_counter\n[/codeblock]"
msgstr "Akkor érkezik, amikor a fordítások megváltozhattak. A nyelvi beállítás vagy a [member auto_translate_mode] módosítása, illetve a csomópont jelenetfába lépése válthatja ki. Használható nyelvváltás kezelésére, például a felület szövegeinek azonnali cseréjére. Hasznos a beépített fordítási támogatás, például a [method Object.tr] használatakor.\n[b]Megjegyzés:[/b] Ez az értesítés a [constant NOTIFICATION_ENTER_TREE] értesítéssel együtt érkezik, ezért jelenet példányosításakor a gyermekcsomópontok még nincsenek inicializálva. Beállíthatod vele ennek a csomópontnak vagy a szkriptből létrehozott gyermekeinek a fordítását. A szerkesztőben hozzáadott gyermekek elérése előtt a [method is_node_ready] metódussal ellenőrizd, hogy a csomópont készen áll-e.\n[codeblock]\nfunc _notification(what):\n\tif what == NOTIFICATION_TRANSLATION_CHANGED:\n\t\tif not is_node_ready():\n\t\t\tawait ready # Wait until ready signal.\n\t\t$Label.text = atr(\"%d Bananas\") % banana_counter\n[/codeblock]"

#. Node.NOTIFICATION_WM_ABOUT
#: doc/classes/Node.xml
msgid "Notification received from the OS when a request for \"About\" information is sent.\nImplemented only on macOS."
msgstr "Az operációs rendszer akkor küldi, amikor az alkalmazás névjegyét kérik.\nCsak macOS-en érhető el."

#. Node.NOTIFICATION_CRASH
#: doc/classes/Node.xml
msgid "Notification received from Godot's crash handler when the engine is about to crash.\nImplemented on desktop platforms, if the crash handler is enabled."
msgstr "A Godot összeomláskezelője küldi közvetlenül a motor összeomlása előtt.\nAsztali platformokon érhető el, ha az összeomláskezelő engedélyezve van."

#. Node.NOTIFICATION_TEXT_SERVER_CHANGED
#: doc/classes/Node.xml
msgid "Notification received when the [TextServer] is changed."
msgstr "Akkor érkezik, amikor megváltozik a [TextServer]."

#. Node.NOTIFICATION_ACCESSIBILITY_UPDATE
#: doc/classes/Node.xml
msgid "Notification received when an accessibility information update is required."
msgstr "Akkor érkezik, amikor frissíteni kell az akadálymentességi adatokat."

#. Node.NOTIFICATION_ACCESSIBILITY_INVALIDATE
#: doc/classes/Node.xml
msgid "Notification received when accessibility elements are invalidated. All node accessibility elements are automatically deleted after receiving this message, therefore all existing references to such elements should be discarded."
msgstr "Akkor érkezik, amikor az akadálymentességi elemek érvénytelenné válnak. Az értesítés után a motor automatikusan törli a csomópont összes ilyen elemét, ezért az elemekre mutató meglévő hivatkozásokat el kell dobni."

#. Node.PROCESS_MODE_INHERIT
#: doc/classes/Node.xml
msgid "Inherits [member process_mode] from the node's parent. This is the default for any newly created node."
msgstr "A szülőcsomópont [member process_mode] értékét örökli. Ez az újonnan létrehozott csomópontok alapértelmezése."

#. Node.PROCESS_MODE_PAUSABLE
#: doc/classes/Node.xml
msgid "Processes when [member SceneTree.paused] is [code]false[/code]. This is the inverse of [constant PROCESS_MODE_WHEN_PAUSED], and the default for the root node."
msgstr "Akkor fut a feldolgozás, ha a [member SceneTree.paused] értéke [code]false[/code]. A [constant PROCESS_MODE_WHEN_PAUSED] ellentéte, és a gyökércsomópont alapértelmezése."

#. Node.PROCESS_MODE_WHEN_PAUSED
#: doc/classes/Node.xml
msgid "Processes [b]only[/b] when [member SceneTree.paused] is [code]true[/code]. This is the inverse of [constant PROCESS_MODE_PAUSABLE]."
msgstr "A feldolgozás [b]csak[/b] akkor fut, ha a [member SceneTree.paused] értéke [code]true[/code]. A [constant PROCESS_MODE_PAUSABLE] ellentéte."

#. Node.PROCESS_MODE_ALWAYS
#: doc/classes/Node.xml
msgid "Always processes. Keeps processing, ignoring [member SceneTree.paused]. This is the inverse of [constant PROCESS_MODE_DISABLED]."
msgstr "A feldolgozás mindig fut, a [member SceneTree.paused] értékétől függetlenül. A [constant PROCESS_MODE_DISABLED] ellentéte."

#. Node.PROCESS_MODE_DISABLED
#: doc/classes/Node.xml
msgid "Never processes. Completely disables processing, ignoring [member SceneTree.paused]. This is the inverse of [constant PROCESS_MODE_ALWAYS]."
msgstr "A feldolgozás soha nem fut, a [member SceneTree.paused] értékétől függetlenül. A [constant PROCESS_MODE_ALWAYS] ellentéte."

#. Node.PROCESS_THREAD_GROUP_INHERIT
#: doc/classes/Node.xml
msgid "Process this node based on the thread group mode of the first parent (or grandparent) node that has a thread group mode that is not inherit. See [member process_thread_group] for more information."
msgstr "A csomópont feldolgozásához annak a legközelebbi felmenőnek a szálcsoportmódját használja, amely nincs öröklésre állítva. További részletekért lásd a [member process_thread_group] tulajdonságot."

#. Node.PROCESS_THREAD_GROUP_MAIN_THREAD
#: doc/classes/Node.xml
msgid "Process this node (and child nodes set to inherit) on the main thread. See [member process_thread_group] for more information."
msgstr "A főszálon dolgozza fel ezt a csomópontot és az öröklésre állított gyermekcsomópontokat. További részletekért lásd a [member process_thread_group] tulajdonságot."

#. Node.PROCESS_THREAD_GROUP_SUB_THREAD
#: doc/classes/Node.xml
msgid "Process this node (and child nodes set to inherit) on a sub-thread. See [member process_thread_group] for more information."
msgstr "Mellékszálon dolgozza fel ezt a csomópontot és az öröklésre állított gyermekcsomópontokat. További részletekért lásd a [member process_thread_group] tulajdonságot."

#. Node.FLAG_PROCESS_THREAD_MESSAGES
#: doc/classes/Node.xml
msgid "Allows this node to process threaded messages created with [method call_deferred_thread_group] right before [method _process] is called."
msgstr "Engedélyezi a [method call_deferred_thread_group] metódussal küldött szálközi üzenetek feldolgozását közvetlenül a [method _process] hívása előtt."

#. Node.FLAG_PROCESS_THREAD_MESSAGES_PHYSICS
#: doc/classes/Node.xml
msgid "Allows this node to process threaded messages created with [method call_deferred_thread_group] right before [method _physics_process] is called."
msgstr "Engedélyezi a [method call_deferred_thread_group] metódussal küldött szálközi üzenetek feldolgozását közvetlenül a [method _physics_process] hívása előtt."

#. Node.FLAG_PROCESS_THREAD_MESSAGES_ALL
#: doc/classes/Node.xml
msgid "Allows this node to process threaded messages created with [method call_deferred_thread_group] right before either [method _process] or [method _physics_process] are called."
msgstr "Engedélyezi a [method call_deferred_thread_group] metódussal küldött szálközi üzenetek feldolgozását közvetlenül a [method _process] vagy a [method _physics_process] hívása előtt."

#. Node.PHYSICS_INTERPOLATION_MODE_INHERIT
#: doc/classes/Node.xml
msgid "Inherits [member physics_interpolation_mode] from the node's parent. This is the default for any newly created node."
msgstr "A szülőcsomópont [member physics_interpolation_mode] értékét örökli. Ez az újonnan létrehozott csomópontok alapértelmezése."

#. Node.PHYSICS_INTERPOLATION_MODE_ON
#: doc/classes/Node.xml
msgid "Enables physics interpolation for this node and for children set to [constant PHYSICS_INTERPOLATION_MODE_INHERIT]. This is the default for the root node."
msgstr "Bekapcsolja a fizikai interpolációt ezen a csomóponton és a [constant PHYSICS_INTERPOLATION_MODE_INHERIT] értékű gyermekeken. Ez a gyökércsomópont alapértelmezése."

#. Node.PHYSICS_INTERPOLATION_MODE_OFF
#: doc/classes/Node.xml
msgid "Disables physics interpolation for this node and for children set to [constant PHYSICS_INTERPOLATION_MODE_INHERIT]."
msgstr "Kikapcsolja a fizikai interpolációt ezen a csomóponton és a [constant PHYSICS_INTERPOLATION_MODE_INHERIT] értékű gyermekeken."

#. Node.DUPLICATE_SIGNALS
#: doc/classes/Node.xml
msgid "Duplicate the node's signal connections that are connected with the [constant Object.CONNECT_PERSIST] flag."
msgstr "Másolja a csomópont [constant Object.CONNECT_PERSIST] jelzővel létrehozott jelzéskapcsolatait."

#. Node.DUPLICATE_GROUPS
#: doc/classes/Node.xml
msgid "Duplicate the node's groups."
msgstr "Másolja a csomópont csoporttagságait."

#. Node.DUPLICATE_SCRIPTS
#: doc/classes/Node.xml
msgid "Duplicate the node's script (also overriding the duplicated children's scripts, if combined with [constant DUPLICATE_USE_INSTANTIATION])."
msgstr "Másolja a csomópont szkriptjét. A [constant DUPLICATE_USE_INSTANTIATION] jelzővel együtt a másolt gyermekcsomópontok szkriptjeit is felülírja."

#. Node.DUPLICATE_USE_INSTANTIATION
#: doc/classes/Node.xml
msgid "Duplicate using [method PackedScene.instantiate]. If the node comes from a scene saved on disk, reuses [method PackedScene.instantiate] as the base for the duplicated node and its children."
msgstr "A [method PackedScene.instantiate] metódussal másol. Ha a csomópont lemezre mentett jelenetből származik, a másolt csomópont és gyermekei alapját a [method PackedScene.instantiate] hívása adja."

#. Node.DUPLICATE_INTERNAL_STATE
#: doc/classes/Node.xml
msgid "Duplicate also non-serializable variables (i.e. without [constant @GlobalScope.PROPERTY_USAGE_STORAGE])."
msgstr "A nem szerializálható, vagyis [constant @GlobalScope.PROPERTY_USAGE_STORAGE] jelző nélküli változókat is másolja."

#. Node.DUPLICATE_DEFAULT
#: doc/classes/Node.xml
msgid "Duplicate using default flags. This constant is useful to add or remove a single flag.\n[codeblock]\n# Duplicate non-exported variables.\nvar dupe = duplicate(DUPLICATE_DEFAULT | DUPLICATE_INTERNAL_STATE)\n[/codeblock]"
msgstr "Az alapértelmezett jelzőkkel másol. Ezzel az állandóval egyszerűen hozzáadható vagy eltávolítható egy jelző.\n[codeblock]\n# Duplicate non-exported variables.\nvar dupe = duplicate(DUPLICATE_DEFAULT | DUPLICATE_INTERNAL_STATE)\n[/codeblock]"

#. Node.INTERNAL_MODE_DISABLED
#: doc/classes/Node.xml
msgid "The node will not be internal."
msgstr "A csomópont nem lesz belső csomópont."

#. Node.INTERNAL_MODE_FRONT
#: doc/classes/Node.xml
msgid "The node will be placed at the beginning of the parent's children, before any non-internal sibling."
msgstr "A csomópont a szülő gyermeklistájának elejére, minden nem belső testvér elé kerül."

#. Node.INTERNAL_MODE_BACK
#: doc/classes/Node.xml
msgid "The node will be placed at the end of the parent's children, after any non-internal sibling."
msgstr "A csomópont a szülő gyermeklistájának végére, minden nem belső testvér mögé kerül."

#. Node.AUTO_TRANSLATE_MODE_INHERIT
#: doc/classes/Node.xml
msgid "Inherits [member auto_translate_mode] from the node's parent. This is the default for any newly created node."
msgstr "A szülőcsomópont [member auto_translate_mode] értékét örökli. Ez az újonnan létrehozott csomópontok alapértelmezése."

#. Node.AUTO_TRANSLATE_MODE_ALWAYS
#: doc/classes/Node.xml
msgid "Always automatically translate. This is the inverse of [constant AUTO_TRANSLATE_MODE_DISABLED], and the default for the root node."
msgstr "Mindig automatikusan lefordítja a szöveget. A [constant AUTO_TRANSLATE_MODE_DISABLED] ellentéte, és a gyökércsomópont alapértelmezése."

#. Node.AUTO_TRANSLATE_MODE_DISABLED
#: doc/classes/Node.xml
msgid "Never automatically translate. This is the inverse of [constant AUTO_TRANSLATE_MODE_ALWAYS].\nString parsing for translation template generation will be skipped for this node and children that are set to [constant AUTO_TRANSLATE_MODE_INHERIT]."
msgstr "Az automatikus fordítás soha nem fut. A [constant AUTO_TRANSLATE_MODE_ALWAYS] ellentéte.\nFordítási sablon készítésekor a motor kihagyja a csomópont és az [constant AUTO_TRANSLATE_MODE_INHERIT] értékű gyermekek szövegeinek feldolgozását."

#. Marker3D.brief
#: doc/classes/Marker3D.xml
msgid "Generic 3D position hint for editing."
msgstr "Általános 3D helyjelölő a szerkesztéshez."

#. Marker3D.description
#: doc/classes/Marker3D.xml
msgid "Generic 3D position hint for editing. It's just like a plain [Node3D], but it displays as a cross in the 3D editor at all times."
msgstr "Általános 3D helyjelölő a szerkesztéshez. Egy egyszerű [Node3D] csomóponthoz hasonló, de a 3D szerkesztőben mindig keresztként jelenik meg."

#. Node3D.brief
#: doc/classes/Node3D.xml
msgid "Base object in 3D space, inherited by all 3D nodes."
msgstr "A 3D tér alapobjektuma, amelyből minden 3D csomópont származik."

#. Node3D.description
#: doc/classes/Node3D.xml
msgid "The [Node3D] node is the base representation of a node in 3D space. All other 3D nodes inherit from this class.\nAffine operations (translation, rotation, scale) are calculated in the coordinate system relative to the parent, unless the [Node3D]'s [member top_level] is [code]true[/code]. In this coordinate system, affine operations correspond to direct affine operations on the [Node3D]'s [member transform]. The term [i]parent space[/i] refers to this coordinate system. The coordinate system that is attached to the [Node3D] itself is referred to as object-local coordinate system, or [i]local space[/i].\n[b]Note:[/b] Unless otherwise specified, all methods that need angle parameters must receive angles in [i]radians[/i]. To convert degrees to radians, use [method @GlobalScope.deg_to_rad].\n[b]Note:[/b] In Godot 3 and older, [Node3D] was named [i]Spatial[/i]."
msgstr "A [Node3D] a 3D térben elhelyezhető csomópontok alaposztálya. Minden más 3D csomópont ebből az osztályból származik.\nA motor az affin műveleteket (eltolás, forgatás, méretezés) a szülőhöz viszonyított koordináta-rendszerben számítja ki, kivéve, ha a [Node3D] [member top_level] értéke [code]true[/code]. Ebben a koordináta-rendszerben az affin műveletek közvetlenül a [Node3D] [member transform] tulajdonságára hatnak. Ezt a koordináta-rendszert nevezzük [i]szülői térnek[/i]. A magához a [Node3D] csomóponthoz tartozó objektumközpontú koordináta-rendszer a [i]helyi tér[/i].\n[b]Megjegyzés:[/b] Eltérő jelzés hiányában a szöget váró metódusoknak [i]radiánban[/i] kell megadni a szög értékét. Fokból radiánba a [method @GlobalScope.deg_to_rad] metódussal válthatsz át.\n[b]Megjegyzés:[/b] A Godot 3-as és korábbi verzióiban a [Node3D] neve [i]Spatial[/i] volt."

#. Node3D.add_gizmo
#: doc/classes/Node3D.xml
msgid "Attaches the given [param gizmo] to this node. Only works in the editor.\n[b]Note:[/b] [param gizmo] should be an [EditorNode3DGizmo]. The argument type is [Node3DGizmo] to avoid depending on editor classes in [Node3D]."
msgstr "A csomóponthoz csatolja a megadott [param gizmo] szerkesztőfogantyút. Csak a szerkesztőben működik.\n[b]Megjegyzés:[/b] A [param gizmo] egy [EditorNode3DGizmo] példány legyen. Az argumentum típusa [Node3DGizmo], hogy a [Node3D] működése ne függjön a szerkesztő osztályaitól."

#. Node3D.clear_gizmos
#: doc/classes/Node3D.xml
msgid "Clears all [EditorNode3DGizmo] objects attached to this node. Only works in the editor."
msgstr "Törli a csomóponthoz csatolt összes [EditorNode3DGizmo] objektumot. Csak a szerkesztőben működik."

#. Node3D.clear_subgizmo_selection
#: doc/classes/Node3D.xml
msgid "Deselects all subgizmos for this node. Useful to call when the selected subgizmo may no longer exist after a property change. Only works in the editor."
msgstr "Megszünteti a csomópont összes részfogantyújának kijelölését. Akkor hasznos, ha a kijelölt részfogantyú egy tulajdonság módosítása után már nem létezik. Csak a szerkesztőben működik."

#. Node3D.force_update_transform
#: doc/classes/Node3D.xml
msgid "Forces the node's [member global_transform] to update, by sending [constant NOTIFICATION_TRANSFORM_CHANGED]. Fails if the node is not inside the tree.\n[b]Note:[/b] For performance reasons, transform changes are usually accumulated and applied [i]once[/i] at the end of the frame. The update propagates through [Node3D] children, as well. Therefore, use this method only when you need an up-to-date transform (such as during physics operations)."
msgstr "A [constant NOTIFICATION_TRANSFORM_CHANGED] értesítés elküldésével azonnal frissíti a csomópont [member global_transform] tulajdonságát. Ha a csomópont nincs a fában, a művelet meghiúsul.\n[b]Megjegyzés:[/b] Teljesítménybeli okokból a motor rendszerint összegyűjti a transzformáció módosításait, és a képkocka végén [i]egyszer[/i] alkalmazza őket. A frissítés a [Node3D] gyermekeken is végigterjed. Ezt a metódust ezért csak akkor használd, ha azonnal szükséged van a friss transzformációra, például fizikai művelet közben."

#. Node3D.get_gizmos
#: doc/classes/Node3D.xml
msgid "Returns all the [EditorNode3DGizmo] objects attached to this node. Only works in the editor."
msgstr "Visszaadja a csomóponthoz csatolt összes [EditorNode3DGizmo] objektumot. Csak a szerkesztőben működik."

#. Node3D.get_global_transform_interpolated
#: doc/classes/Node3D.xml
msgid "When using physics interpolation, there will be circumstances in which you want to know the interpolated (displayed) transform of a node rather than the standard transform (which may only be accurate to the most recent physics tick).\nThis is particularly important for frame-based operations that take place in [method Node._process], rather than [method Node._physics_process]. Examples include [Camera3D]s focusing on a node, or finding where to fire lasers from on a frame rather than physics tick.\n[b]Note:[/b] This function creates an interpolation pump on the [Node3D] the first time it is called, which can respond to physics interpolation resets. If you get problems with \"streaking\" when initially following a [Node3D], be sure to call [method get_global_transform_interpolated] at least once [i]before[/i] resetting the [Node3D] physics interpolation."
msgstr "Fizikai interpoláció használatakor előfordulhat, hogy a csomópont megjelenített, interpolált transzformációjára van szükséged. A szokásos transzformáció csak a legutóbbi fizikai lépésben mért állapotot tükrözheti.\nEz főleg a [method Node._process] metódusban végzett, képkockánkénti műveleteknél fontos, amelyek nem a [method Node._physics_process] metódusban futnak le. Ilyen például, ha egy [Camera3D] csomópont követ egy másikat, vagy a lézersugár kezdőpontját a képkockában kell kiszámítani a fizikai lépés helyett.\n[b]Megjegyzés:[/b] Az első hívás létrehozza a [Node3D] interpolációs frissítését kezelő belső egységet, amely az interpoláció alaphelyzetbe állítására is reagál. Ha egy [Node3D] követésének kezdetekor csíkozás látható, hívd meg legalább egyszer a [method get_global_transform_interpolated] metódust a [Node3D] fizikai interpolációjának alaphelyzetbe állítása [i]előtt[/i]."

#. Node3D.get_parent_node_3d
#: doc/classes/Node3D.xml
msgid "Returns the parent [Node3D] that directly affects this node's [member global_transform]. Returns [code]null[/code] if no parent exists, the parent is not a [Node3D], or [member top_level] is [code]true[/code].\n[b]Note:[/b] This method is not always equivalent to [method Node.get_parent], which does not take [member top_level] into account."
msgstr "Visszaadja azt a szülő [Node3D] csomópontot, amely közvetlenül hat a [member global_transform] értékére. [code]null[/code] értéket ad vissza, ha nincs szülő, a szülő nem [Node3D], vagy a [member top_level] értéke [code]true[/code].\n[b]Megjegyzés:[/b] Az eredmény eltérhet a [method Node.get_parent] eredményétől, mert az a [member top_level] értékét figyelmen kívül hagyja."

#. Node3D.get_world_3d
#: doc/classes/Node3D.xml
msgid "Returns the [World3D] this node is registered to.\nUsually, this is the same as the world used by this node's viewport (see [method Node.get_viewport] and [method Viewport.find_world_3d])."
msgstr "Visszaadja azt a [World3D] világot, amelyhez a csomópont regisztrálva van.\nEz általában azonos a csomópont nézetablakában használt világgal (lásd: [method Node.get_viewport] és [method Viewport.find_world_3d])."

#. Node3D.global_rotate
#: doc/classes/Node3D.xml
msgid "Rotates this node's [member global_basis] around the global [param axis] by the given [param angle], in radians. This operation is calculated in global space (relative to the world) and preserves the [member global_position]."
msgstr "Elforgatja a csomópont [member global_basis] bázisát a globális [param axis] tengely körül a radiánban megadott [param angle] szöggel. A művelet a világhoz viszonyított globális térben történik, és a [member global_position] változatlan marad."

#. Node3D.global_scale
#: doc/classes/Node3D.xml
msgid "Scales this node's [member global_basis] by the given [param scale] factor. This operation is calculated in global space (relative to the world) and preserves the [member global_position].\n[b]Note:[/b] This method is not to be confused with the [member scale] property."
msgstr "A megadott [param scale] tényezővel méretezi a csomópont [member global_basis] bázisát. A művelet a világhoz viszonyított globális térben történik, és a [member global_position] változatlan marad.\n[b]Megjegyzés:[/b] A metódus különbözik a [member scale] tulajdonságtól."

#. Node3D.global_translate
#: doc/classes/Node3D.xml
msgid "Adds the given translation [param offset] to the node's [member global_position] in global space (relative to the world)."
msgstr "Hozzáadja a megadott [param offset] eltolást a csomópont [member global_position] helyéhez a világhoz viszonyított globális térben."

#. Node3D.hide
#: doc/classes/Node3D.xml
msgid "Prevents this node from being rendered. Equivalent to setting [member visible] to [code]false[/code]. This is the opposite of [method show]."
msgstr "Elrejti a csomópontot a megjelenítésből. Egyenértékű azzal, hogy a [member visible] értéke [code]false[/code]. A [method show] ellentéte."

#. Node3D.is_local_transform_notification_enabled
#: doc/classes/Node3D.xml
msgid "Returns [code]true[/code] if the node receives [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] whenever [member transform] changes. This is enabled with [method set_notify_local_transform]."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont minden [member transform] változáskor megkapja a [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] értesítést. Ez a [method set_notify_local_transform] metódussal engedélyezhető."

#. Node3D.is_scale_disabled
#: doc/classes/Node3D.xml
msgid "Returns [code]true[/code] if this node's [member global_transform] is automatically orthonormalized. This results in this node not appearing distorted, as if its global scale were set to [constant Vector3.ONE] (or its negative counterpart). See also [method set_disable_scale] and [method orthonormalize].\n[b]Note:[/b] [member transform] is not affected by this setting."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont [member global_transform] értékét a motor automatikusan ortonormalizálja. Ilyenkor a csomópont alakját nem torzítja a méretezés, mintha a globális méretezése [constant Vector3.ONE] vagy annak negatívja lenne. Lásd még a [method set_disable_scale] és az [method orthonormalize] metódust.\n[b]Megjegyzés:[/b] A [member transform] értékét ez a beállítás nem befolyásolja."

#. Node3D.is_transform_notification_enabled
#: doc/classes/Node3D.xml
msgid "Returns [code]true[/code] if the node receives [constant NOTIFICATION_TRANSFORM_CHANGED] whenever [member global_transform] changes. This is enabled with [method set_notify_transform]."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont minden [member global_transform] változáskor megkapja a [constant NOTIFICATION_TRANSFORM_CHANGED] értesítést. Ez a [method set_notify_transform] metódussal engedélyezhető."

#. Node3D.is_visible_in_tree
#: doc/classes/Node3D.xml
msgid "Returns [code]true[/code] if this node is inside the scene tree and the [member visible] property is [code]true[/code] for this node and all of its [Node3D] ancestors [i]in sequence[/i]. An ancestor of any other type (such as [Node] or [Node2D]) breaks the sequence. See also [method Node.get_parent].\n[b]Note:[/b] This method cannot take [member VisualInstance3D.layers] into account, so even if this method returns [code]true[/code], the node may not be rendered."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont a jelenetfában van, és mind rajta, mind a [i]megszakítás nélküli láncot[/i] alkotó [Node3D] felmenőin a [member visible] értéke [code]true[/code]. Egy másik típusú felmenő, például [Node] vagy [Node2D], megszakítja a láncot. Lásd még a [method Node.get_parent] metódust.\n[b]Megjegyzés:[/b] A metódus nem veszi figyelembe a [member VisualInstance3D.layers] tulajdonságot. A csomópont akkor is kimaradhat a megjelenítésből, ha az eredmény [code]true[/code]."

#. Node3D.look_at
#: doc/classes/Node3D.xml
msgid "Rotates the node so that the local forward axis (-Z, [constant Vector3.FORWARD]) points toward the [param target] position. This operation is calculated in global space (relative to the world).\nThe local up axis (+Y) points as close to the [param up] vector as possible while staying perpendicular to the local forward axis. The resulting transform is orthogonal, and the scale is preserved. Non-uniform scaling may not work correctly.\nThe [param target] position cannot be the same as the node's position, the [param up] vector cannot be [constant Vector3.ZERO]. Furthermore, the direction from the node's position to the [param target] position cannot be parallel to the [param up] vector, to avoid an unintended rotation around the local Z axis.\nIf [param use_model_front] is [code]true[/code], the +Z axis (asset front) is treated as forward (implies +X is left) and points toward the [param target] position. By default, the -Z axis (camera forward) is treated as forward (implies +X is right).\n[b]Note:[/b] This method fails if the node is not in the scene tree. If necessary, use [method look_at_from_position] instead."
msgstr "Elforgatja a csomópontot úgy, hogy a helyi előre mutató tengely (-Z, [constant Vector3.FORWARD]) a [param target] helyre mutasson. A művelet a világhoz viszonyított globális térben történik.\nA helyi felfelé mutató tengely (+Y) a lehető legközelebb kerül a [param up] vektor irányához, miközben merőleges marad a helyi előre mutató tengelyre. Az eredmény ortogonális transzformáció, változatlan méretezéssel. A tengelyenként eltérő méretezés hibás működést okozhat.\nA [param target] nem egyezhet a csomópont helyével, és a [param up] vektor nem lehet [constant Vector3.ZERO]. A csomópont és a [param target] közötti irány nem lehet párhuzamos a [param up] vektorral, mert az a helyi Z tengely körüli nem kívánt forgást okozhat.\nHa a [param use_model_front] értéke [code]true[/code], a +Z tengely (a modell eleje) mutat előre, így a +X balra mutat. Ebben a módban a +Z irányul a [param target] helyre. Alapértelmezésben a -Z tengely (a kamera előre mutató iránya) mutat előre, így a +X jobbra mutat.\n[b]Megjegyzés:[/b] A metódus meghiúsul, ha a csomópont nincs a jelenetfában. Szükség esetén használd a [method look_at_from_position] metódust."

#. Node3D.look_at_from_position
#: doc/classes/Node3D.xml
msgid "Moves the node to the specified [param position], then rotates the node to point toward the [param target] position, similar to [method look_at]. This operation is calculated in global space (relative to the world)."
msgstr "A megadott [param position] helyre mozgatja a csomópontot, majd a [method look_at] metódushoz hasonlóan a [param target] hely felé fordítja. A művelet a világhoz viszonyított globális térben történik."

#. Node3D.orthonormalize
#: doc/classes/Node3D.xml
msgid "Orthonormalizes this node's [member basis]. This method sets this node's [member scale] to [constant Vector3.ONE] (or its negative counterpart), but preserves the [member position] and [member rotation]. See also [method Transform3D.orthonormalized]."
msgstr "Ortonormalizálja a csomópont [member basis] bázisát. A [member scale] értékét [constant Vector3.ONE] értékre vagy annak negatívjára állítja, miközben a [member position] és a [member rotation] változatlan marad. Lásd még a [method Transform3D.orthonormalized] metódust."

#. Node3D.rotate
#: doc/classes/Node3D.xml
msgid "Rotates this node's [member basis] around the [param axis] by the given [param angle], in radians. This operation is calculated in parent space (relative to the parent) and preserves the [member position]."
msgstr "A megadott [param axis] tengely körül elforgatja a csomópont [member basis] bázisát a radiánban megadott [param angle] szöggel. A művelet a szülői térben történik, és a [member position] változatlan marad."

#. Node3D.rotate_object_local
#: doc/classes/Node3D.xml
msgid "Rotates this node's [member basis] around the [param axis] by the given [param angle], in radians. This operation is calculated in local space (relative to this node) and preserves the [member position]."
msgstr "A megadott [param axis] tengely körül elforgatja a csomópont [member basis] bázisát a radiánban megadott [param angle] szöggel. A művelet a csomópont saját helyi terében történik, és a [member position] változatlan marad."

#. Node3D.rotate_x
#: doc/classes/Node3D.xml
msgid "Rotates this node's [member basis] around the X axis by the given [param angle], in radians. This operation is calculated in parent space (relative to the parent) and preserves the [member position]."
msgstr "Az X tengely körül elforgatja a csomópont [member basis] bázisát a radiánban megadott [param angle] szöggel. A művelet a szülői térben történik, és a [member position] változatlan marad."

#. Node3D.rotate_y
#: doc/classes/Node3D.xml
msgid "Rotates this node's [member basis] around the Y axis by the given [param angle], in radians. This operation is calculated in parent space (relative to the parent) and preserves the [member position]."
msgstr "Az Y tengely körül elforgatja a csomópont [member basis] bázisát a radiánban megadott [param angle] szöggel. A művelet a szülői térben történik, és a [member position] változatlan marad."

#. Node3D.rotate_z
#: doc/classes/Node3D.xml
msgid "Rotates this node's [member basis] around the Z axis by the given [param angle], in radians. This operation is calculated in parent space (relative to the parent) and preserves the [member position]."
msgstr "A Z tengely körül elforgatja a csomópont [member basis] bázisát a radiánban megadott [param angle] szöggel. A művelet a szülői térben történik, és a [member position] változatlan marad."

#. Node3D.scale_object_local
#: doc/classes/Node3D.xml
msgid "Scales this node's [member basis] by the given [param scale] factor. This operation is calculated in local space (relative to this node) and preserves the [member position]."
msgstr "A megadott [param scale] tényezővel méretezi a csomópont [member basis] bázisát. A művelet a csomópont saját helyi terében történik, és a [member position] változatlan marad."

#. Node3D.set_disable_scale
#: doc/classes/Node3D.xml
msgid "If [code]true[/code], this node's [member global_transform] is automatically orthonormalized. This results in this node not appearing distorted, as if its global scale were set to [constant Vector3.ONE] (or its negative counterpart). See also [method is_scale_disabled] and [method orthonormalize].\n[b]Note:[/b] [member transform] is not affected by this setting."
msgstr "[code]true[/code] értéknél a motor automatikusan ortonormalizálja a csomópont [member global_transform] értékét. Így a csomópont alakját nem torzítja a méretezés, mintha a globális méretezése [constant Vector3.ONE] vagy annak negatívja lenne. Lásd még a [method is_scale_disabled] és az [method orthonormalize] metódust.\n[b]Megjegyzés:[/b] A [member transform] értékét ez a beállítás nem befolyásolja."

#. Node3D.set_identity
#: doc/classes/Node3D.xml
msgid "Sets this node's [member transform] to [constant Transform3D.IDENTITY], which resets all transformations in parent space ([member position], [member rotation], and [member scale])."
msgstr "A csomópont [member transform] értékét [constant Transform3D.IDENTITY] értékre állítja, visszaállítva a szülői térben végzett összes transzformációt ([member position], [member rotation] és [member scale])."

#. Node3D.set_ignore_transform_notification
#: doc/classes/Node3D.xml
msgid "If [code]true[/code], the node will not receive [constant NOTIFICATION_TRANSFORM_CHANGED] or [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED].\nIt may useful to call this method when handling these notifications to prevent infinite recursion."
msgstr "[code]true[/code] értéknél a csomópont nem kapja meg a [constant NOTIFICATION_TRANSFORM_CHANGED] és a [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] értesítést.\nHasznos lehet az értesítések kezelése közben meghívni a metódust, hogy elkerüld a végtelen rekurziót."

#. Node3D.set_notify_local_transform
#: doc/classes/Node3D.xml
msgid "If [code]true[/code], the node will receive [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] whenever [member transform] changes.\n[b]Note:[/b] Some 3D nodes such as [CSGShape3D] or [CollisionShape3D] automatically enable this to function correctly."
msgstr "[code]true[/code] értéknél a csomópont minden [member transform] változáskor megkapja a [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] értesítést.\n[b]Megjegyzés:[/b] Egyes 3D csomópontok, például a [CSGShape3D] és a [CollisionShape3D], a helyes működéshez automatikusan engedélyezik ezt."

#. Node3D.set_notify_transform
#: doc/classes/Node3D.xml
msgid "If [code]true[/code], the node will receive [constant NOTIFICATION_TRANSFORM_CHANGED] whenever [member global_transform] changes.\n[b]Note:[/b] Most 3D nodes such as [VisualInstance3D] or [CollisionObject3D] automatically enable this to function correctly.\n[b]Note:[/b] In the editor, nodes will propagate this notification to their children if a gizmo is attached (see [method add_gizmo])."
msgstr "[code]true[/code] értéknél a csomópont minden [member global_transform] változáskor megkapja a [constant NOTIFICATION_TRANSFORM_CHANGED] értesítést.\n[b]Megjegyzés:[/b] A legtöbb 3D csomópont, például a [VisualInstance3D] és a [CollisionObject3D], a helyes működéshez automatikusan engedélyezi ezt.\n[b]Megjegyzés:[/b] A szerkesztőben a csomópontok továbbítják az értesítést a gyermekeiknek, ha szerkesztőfogantyú van hozzájuk csatolva (lásd: [method add_gizmo])."

#. Node3D.set_subgizmo_selection
#: doc/classes/Node3D.xml
msgid "Selects the [param gizmo]'s subgizmo with the given [param id] and sets its transform. Only works in the editor.\n[b]Note:[/b] The gizmo object would typically be an instance of [EditorNode3DGizmo], but the argument type is kept generic to avoid creating a dependency on editor classes in [Node3D]."
msgstr "Kijelöli a [param gizmo] megadott [param id] azonosítójú részfogantyúját, és beállítja a transzformációját. Csak a szerkesztőben működik.\n[b]Megjegyzés:[/b] A fogantyú rendszerint [EditorNode3DGizmo] példány, de az argumentum típusa általános, hogy a [Node3D] ne függjön a szerkesztő osztályaitól."

#. Node3D.show
#: doc/classes/Node3D.xml
msgid "Allows this node to be rendered. Equivalent to setting [member visible] to [code]true[/code]. This is the opposite of [method hide]."
msgstr "Megjeleníthetővé teszi a csomópontot. Egyenértékű azzal, hogy a [member visible] értéke [code]true[/code]. A [method hide] ellentéte."

#. Node3D.to_global
#: doc/classes/Node3D.xml
msgid "Returns the [param local_point] converted from this node's local space to global space. This is the opposite of [method to_local]."
msgstr "A [param local_point] pontot a csomópont helyi teréből a globális térbe alakítja. A [method to_local] ellentéte."

#. Node3D.to_local
#: doc/classes/Node3D.xml
msgid "Returns the [param global_point] converted from global space to this node's local space. This is the opposite of [method to_global]."
msgstr "A [param global_point] pontot a globális térből a csomópont helyi terébe alakítja. A [method to_global] ellentéte."

#. Node3D.translate
#: doc/classes/Node3D.xml
msgid "Adds the given translation [param offset] to the node's position, in local space (relative to this node).\n[b]Note:[/b] Prefer using [method translate_object_local], instead, as this method may be changed in a future release.\n[b]Note:[/b] Despite the naming convention, this operation is [b]not[/b] calculated in parent space for compatibility reasons. To translate in parent space, add [param offset] to the [member position] ([code]node_3d.position += offset[/code])."
msgstr "Hozzáadja a megadott [param offset] eltolást a csomópont helyéhez a csomópont saját helyi terében.\n[b]Megjegyzés:[/b] Érdemes a [method translate_object_local] metódust használni, mert ennek a metódusnak a működése későbbi kiadásban megváltozhat.\n[b]Megjegyzés:[/b] A név ellenére kompatibilitási okokból a motor [b]nem[/b] a szülői térben számítja ki a műveletet. Szülői térben történő eltoláshoz add a [param offset] értékét a [member position] értékéhez ([code]node_3d.position += offset[/code])."

#. Node3D.translate_object_local
#: doc/classes/Node3D.xml
msgid "Adds the given translation [param offset] to the node's position, in local space (relative to this node)."
msgstr "Hozzáadja a megadott [param offset] eltolást a csomópont helyéhez a csomópont saját helyi terében."

#. Node3D.update_gizmos
#: doc/classes/Node3D.xml
msgid "Updates all the [EditorNode3DGizmo] objects attached to this node. Only works in the editor."
msgstr "Frissíti a csomóponthoz csatolt összes [EditorNode3DGizmo] objektumot. Csak a szerkesztőben működik."

#. Node3D.visibility_changed
#: doc/classes/Node3D.xml
msgid "Emitted when this node's visibility changes (see [member visible] and [method is_visible_in_tree]).\nThis signal is emitted [i]after[/i] the related [constant NOTIFICATION_VISIBILITY_CHANGED] notification."
msgstr "Akkor küldi el, amikor megváltozik a csomópont láthatósága (lásd: [member visible] és [method is_visible_in_tree]).\nA jelzést a kapcsolódó [constant NOTIFICATION_VISIBILITY_CHANGED] értesítés [i]után[/i] küldi el."

#. Node3D.basis
#: doc/classes/Node3D.xml
msgid "Basis of the [member transform] property. Represents the rotation, scale, and shear of this node in parent space (relative to the parent node)."
msgstr "A [member transform] tulajdonság bázisa. A csomópont szülőhöz viszonyított forgatását, méretezését és nyírását adja meg."

#. Node3D.global_basis
#: doc/classes/Node3D.xml
msgid "Basis of the [member global_transform] property. Represents the rotation, scale, and shear of this node in global space (relative to the world).\n[b]Note:[/b] If the node is not inside the tree, getting this property fails and returns [constant Basis.IDENTITY]."
msgstr "A [member global_transform] tulajdonság bázisa. A csomópont világhoz viszonyított forgatását, méretezését és nyírását adja meg.\n[b]Megjegyzés:[/b] Ha a csomópont nincs a fában, a lekérés meghiúsul, és [constant Basis.IDENTITY] értéket ad vissza."

#. Node3D.global_position
#: doc/classes/Node3D.xml
msgid "Global position (translation) of this node in global space (relative to the world). This is equivalent to the [member global_transform]'s [member Transform3D.origin].\n[b]Note:[/b] If the node is not inside the tree, getting this property fails and returns [constant Vector3.ZERO]."
msgstr "A csomópont globális helye (eltolása) a világhoz viszonyítva. Egyenértékű a [member global_transform] [member Transform3D.origin] értékével.\n[b]Megjegyzés:[/b] Ha a csomópont nincs a fában, a lekérés meghiúsul, és [constant Vector3.ZERO] értéket ad vissza."

#. Node3D.global_rotation
#: doc/classes/Node3D.xml
msgid "Global rotation of this node as [url=https://en.wikipedia.org/wiki/Euler_angles]Euler angles[/url], in radians and in global space (relative to the world). This value is obtained from [member global_basis]'s rotation.\n- The [member Vector3.x] is the angle around the global X axis (pitch);\n- The [member Vector3.y] is the angle around the global Y axis (yaw);\n- The [member Vector3.z] is the angle around the global Z axis (roll).\n[b]Note:[/b] Unlike [member rotation], this property always follows the YXZ convention ([constant EULER_ORDER_YXZ]).\n[b]Note:[/b] If the node is not inside the tree, getting this property fails and returns [constant Vector3.ZERO]."
msgstr "A csomópont világhoz viszonyított globális forgatása radiánban megadott [url=https://en.wikipedia.org/wiki/Euler_angles]Euler-szögekként[/url]. Az érték a [member global_basis] forgatásából származik.\n- A [member Vector3.x] a globális X tengely körüli szög (bólintás).\n- A [member Vector3.y] a globális Y tengely körüli szög (elfordulás).\n- A [member Vector3.z] a globális Z tengely körüli szög (bedőlés).\n[b]Megjegyzés:[/b] A [member rotation] tulajdonságtól eltérően ez mindig az YXZ sorrendet használja ([constant EULER_ORDER_YXZ]).\n[b]Megjegyzés:[/b] Ha a csomópont nincs a fában, a lekérés meghiúsul, és [constant Vector3.ZERO] értéket ad vissza."

#. Node3D.global_rotation_degrees
#: doc/classes/Node3D.xml
msgid "The [member global_rotation] of this node, in degrees instead of radians.\n[b]Note:[/b] If the node is not inside the tree, getting this property fails and returns [constant Vector3.ZERO]."
msgstr "A csomópont [member global_rotation] értéke fokban, radián helyett.\n[b]Megjegyzés:[/b] Ha a csomópont nincs a fában, a lekérés meghiúsul, és [constant Vector3.ZERO] értéket ad vissza."

#. Node3D.global_transform
#: doc/classes/Node3D.xml
msgid "The transformation of this node, in global space (relative to the world). Contains and represents this node's [member global_position], [member global_rotation], and global scale.\n[b]Note:[/b] If the node is not inside the tree, getting this property fails and returns [constant Transform3D.IDENTITY]."
msgstr "A csomópont világhoz viszonyított globális transzformációja. Magában foglalja a csomópont [member global_position] és [member global_rotation] értékét, valamint a globális méretezését.\n[b]Megjegyzés:[/b] Ha a csomópont nincs a fában, a lekérés meghiúsul, és [constant Transform3D.IDENTITY] értéket ad vissza."

#. Node3D.position
#: doc/classes/Node3D.xml
msgid "Position (translation) of this node in parent space (relative to the parent node). This is equivalent to the [member transform]'s [member Transform3D.origin]."
msgstr "A csomópont helye (eltolása) a szülőcsomóponthoz viszonyítva. Egyenértékű a [member transform] [member Transform3D.origin] értékével."

#. Node3D.quaternion
#: doc/classes/Node3D.xml
msgid "Rotation of this node represented as a [Quaternion] in parent space (relative to the parent node). This value is obtained from [member basis]'s rotation.\n[b]Note:[/b] Quaternions are much more suitable for 3D math but are less intuitive. Setting this property can be useful for interpolation (see [method Quaternion.slerp])."
msgstr "A csomópont szülőhöz viszonyított forgatása [Quaternion] értékként. Az érték a [member basis] forgatásából származik.\n[b]Megjegyzés:[/b] A kvaterniók alkalmasabbak a 3D számításokhoz, de kevésbé szemléletesek. A tulajdonság beállítása interpolációhoz lehet hasznos (lásd: [method Quaternion.slerp])."

#. Node3D.rotation
#: doc/classes/Node3D.xml
msgid "Rotation of this node as [url=https://en.wikipedia.org/wiki/Euler_angles]Euler angles[/url], in radians and in parent space (relative to the parent node). This value is obtained from [member basis]'s rotation.\n- The [member Vector3.x] is the angle around the local X axis (pitch);\n- The [member Vector3.y] is the angle around the local Y axis (yaw);\n- The [member Vector3.z] is the angle around the local Z axis (roll).\nThe order of each consecutive rotation can be changed with [member rotation_order] (see [enum EulerOrder] constants). In Godot, Euler angles always use intrinsic order. By default, the intrinsic YXZ convention is used ([constant EULER_ORDER_YXZ]).\n[b]Note:[/b] This property is edited in degrees in the inspector. If you want to use degrees in a script, use [member rotation_degrees]."
msgstr "A csomópont szülőhöz viszonyított forgatása radiánban megadott [url=https://en.wikipedia.org/wiki/Euler_angles]Euler-szögekként[/url]. Az érték a [member basis] forgatásából származik.\n- A [member Vector3.x] a helyi X tengely körüli szög (bólintás).\n- A [member Vector3.y] a helyi Y tengely körüli szög (elfordulás).\n- A [member Vector3.z] a helyi Z tengely körüli szög (bedőlés).\nA forgatások sorrendjét a [member rotation_order] tulajdonsággal módosíthatod (lásd az [enum EulerOrder] állandóit). A Godot az Euler-szögeket mindig a mozgó helyi tengelyek körül alkalmazza. Az alapértelmezett belső sorrend YXZ ([constant EULER_ORDER_YXZ]).\n[b]Megjegyzés:[/b] A Tulajdonságvizsgáló ezt a tulajdonságot fokban szerkeszti. Ha szkriptben is fokot szeretnél használni, használd a [member rotation_degrees] tulajdonságot."

#. Node3D.rotation_degrees
#: doc/classes/Node3D.xml
msgid "The [member rotation] of this node, in degrees instead of radians.\n[b]Note:[/b] This is [b]not[/b] the property available in the Inspector dock."
msgstr "A csomópont [member rotation] értéke fokban, radián helyett.\n[b]Megjegyzés:[/b] A Tulajdonságvizsgálóban [b]nem[/b] ez a tulajdonság jelenik meg."

#. Node3D.rotation_edit_mode
#: doc/classes/Node3D.xml
msgid "How this node's rotation and scale are displayed in the Inspector dock."
msgstr "Megadja, hogyan jelenik meg a csomópont forgatása és méretezése a Tulajdonságvizsgálóban."

#. Node3D.rotation_order
#: doc/classes/Node3D.xml
msgid "The axis rotation order of the [member rotation] property. In Godot, Euler angles always use intrinsic order, meaning that the final orientation is calculated by rotating around the local axes in this order."
msgstr "A [member rotation] tengelyek körüli forgatásainak sorrendje. A Godot az Euler-szögekhez mindig belső sorrendet használ, vagyis a végső tájolást ebben a sorrendben, a mozgó helyi tengelyek körüli forgatásokkal számítja ki."

#. Node3D.scale
#: doc/classes/Node3D.xml
msgid "Scale of this node in local space (relative to this node). This value is obtained from [member basis]'s scale.\n[b]Note:[/b] The behavior of some 3D node types is not affected by this property. These include [Light3D], [Camera3D], [AudioStreamPlayer3D], and more.\n[b]Warning:[/b] The scale's components must either be all positive or all negative, and [b]not[/b] exactly [code]0.0[/code]. Otherwise, it won't be possible to obtain the scale from the [member basis]. This may cause the intended scale to be lost when reloaded from disk, and potentially other unstable behavior."
msgstr "A csomópont méretezése a saját helyi terében. Az érték a [member basis] méretezéséből származik.\n[b]Megjegyzés:[/b] A tulajdonság egyes 3D csomópontok működését nem befolyásolja. Ilyen például a [Light3D], a [Camera3D] és az [AudioStreamPlayer3D].\n[b]Figyelmeztetés:[/b] A méretezés összetevői legyenek mind pozitívak vagy mind negatívak, és egyik sem lehet pontosan [b]nulla[/b] ([code]0.0[/code]). Ellenkező esetben a motor nem tudja visszanyerni a méretezést a [member basis] értékéből. Emiatt lemezről való újratöltéskor elveszhet a beállított méretezés, és más instabil működés is előfordulhat."

#. Node3D.top_level
#: doc/classes/Node3D.xml
msgid "If [code]true[/code], the node does not inherit its transformations from its parent. As such, node transformations will only be in global space, which also means that [member global_transform] and [member transform] will be identical."
msgstr "[code]true[/code] értéknél a csomópont nem örökli a szülő transzformációit. Ilyenkor a csomópont transzformációi a globális térben értendők, ezért a [member global_transform] és a [member transform] azonos."

#. Node3D.transform
#: doc/classes/Node3D.xml
msgid "The local transformation of this node, in parent space (relative to the parent node). Contains and represents this node's [member position], [member rotation], and [member scale]."
msgstr "A csomópont helyi transzformációja a szülőcsomóponthoz viszonyítva. Magában foglalja a csomópont [member position], [member rotation] és [member scale] értékét."

#. Node3D.visibility_parent
#: doc/classes/Node3D.xml
msgid "Path to the visibility range parent for this node and its descendants. The visibility parent must be a [GeometryInstance3D].\nAny visual instance will only be visible if the visibility parent (and all of its visibility ancestors) is hidden by being closer to the camera than its own [member GeometryInstance3D.visibility_range_begin]. Nodes hidden via the [member Node3D.visible] property are essentially removed from the visibility dependency tree, so dependent instances will not take the hidden node or its descendants into account."
msgstr "A csomópont és leszármazottai láthatósági tartományát meghatározó szülő útvonala. A láthatósági szülőnek [GeometryInstance3D] típusúnak kell lennie.\nEgy vizuális példány csak akkor látható, ha a láthatósági szülője és annak minden láthatósági felmenője rejtett amiatt, hogy a kamerához közelebb van a saját [member GeometryInstance3D.visibility_range_begin] határánál. A [member Node3D.visible] tulajdonsággal elrejtett csomópontokat a motor gyakorlatilag kiveszi a láthatósági függőségek fájából. A függő példányok így sem a rejtett csomópontot, sem leszármazottait nem veszik figyelembe."

#. Node3D.visible
#: doc/classes/Node3D.xml
msgid "If [code]true[/code], this node can be visible. The node is only rendered when all of its ancestors are visible, as well. That means [method is_visible_in_tree] must return [code]true[/code]."
msgstr "[code]true[/code] értéknél a csomópont látható lehet. A motor csak akkor jeleníti meg, ha az összes felmenője is látható, vagyis a [method is_visible_in_tree] [code]true[/code] értéket ad vissza."

#. Node3D.NOTIFICATION_TRANSFORM_CHANGED
#: doc/classes/Node3D.xml
msgid "Notification received when this node's [member global_transform] changes, if [method is_transform_notification_enabled] is [code]true[/code]. See also [method set_notify_transform].\n[b]Note:[/b] Most 3D nodes such as [VisualInstance3D] or [CollisionObject3D] automatically enable this to function correctly.\n[b]Note:[/b] In the editor, nodes will propagate this notification to their children if a gizmo is attached (see [method add_gizmo])."
msgstr "A csomópont a [member global_transform] megváltozásakor kapja meg, ha a [method is_transform_notification_enabled] értéke [code]true[/code]. Lásd még a [method set_notify_transform] metódust.\n[b]Megjegyzés:[/b] A legtöbb 3D csomópont, például a [VisualInstance3D] és a [CollisionObject3D], a helyes működéshez automatikusan engedélyezi ezt.\n[b]Megjegyzés:[/b] A szerkesztőben a csomópontok továbbítják az értesítést a gyermekeiknek, ha szerkesztőfogantyú van hozzájuk csatolva (lásd: [method add_gizmo])."

#. Node3D.NOTIFICATION_ENTER_WORLD
#: doc/classes/Node3D.xml
msgid "Notification received when this node is registered to a new [World3D] (see [method get_world_3d])."
msgstr "Akkor kapja meg, amikor a csomópontot új [World3D] világhoz regisztrálják (lásd: [method get_world_3d])."

#. Node3D.NOTIFICATION_EXIT_WORLD
#: doc/classes/Node3D.xml
msgid "Notification received when this node is unregistered from the current [World3D] (see [method get_world_3d]).\nThis notification is sent in reversed order."
msgstr "Akkor kapja meg, amikor a csomópontot eltávolítják az aktuális [World3D] világ nyilvántartásából (lásd: [method get_world_3d]).\nEzt az értesítést fordított sorrendben küldi a motor."

#. Node3D.NOTIFICATION_LOCAL_TRANSFORM_CHANGED
#: doc/classes/Node3D.xml
msgid "Notification received when this node's [member transform] changes, if [method is_local_transform_notification_enabled] is [code]true[/code]. This is not received when a parent [Node3D]'s [member transform] changes. See also [method set_notify_local_transform].\n[b]Note:[/b] Some 3D nodes such as [CSGShape3D] or [CollisionShape3D] automatically enable this to function correctly."
msgstr "A csomópont a [member transform] megváltozásakor kapja meg, ha a [method is_local_transform_notification_enabled] értéke [code]true[/code]. A szülő [Node3D] [member transform] értékének módosulása nem váltja ki az értesítést. Lásd még a [method set_notify_local_transform] metódust.\n[b]Megjegyzés:[/b] Egyes 3D csomópontok, például a [CSGShape3D] és a [CollisionShape3D], a helyes működéshez automatikusan engedélyezik ezt."

#. Node3D.ROTATION_EDIT_MODE_EULER
#: doc/classes/Node3D.xml
msgid "The rotation is edited using a [Vector3] in [url=https://en.wikipedia.org/wiki/Euler_angles]Euler angles[/url]. In Godot, Euler angles always use intrinsic order, meaning that rotation happens around the local axes of the object."
msgstr "A forgatás [Vector3] értékként, [url=https://en.wikipedia.org/wiki/Euler_angles]Euler-szögekkel[/url] szerkeszthető. A Godot mindig belső sorrendet használ, vagyis a forgatás a tárgy helyi tengelyei körül történik."

#. Node3D.ROTATION_EDIT_MODE_QUATERNION
#: doc/classes/Node3D.xml
msgid "The rotation is edited using a [Quaternion]. Quaternions avoid [url=$DOCS_URL/tutorials/3d/using_transforms.html]gimbal lock[/url] and having to choose an order of rotation, but are less intuitive. Quaternion rotation is mostly the same as rotors in 3D geometric algebra, except that the numbers are labeled differently."
msgstr "A forgatás [Quaternion] értékként szerkeszthető. A kvaterniókkal elkerülhető a [url=$DOCS_URL/tutorials/3d/using_transforms.html]tengelyzár[/url], és nem kell forgatási sorrendet választani, viszont kevésbé szemléletesek. A kvaternióval végzett forgatás lényegében a 3D geometriai algebra rotoraihoz hasonló, csak a számértékek jelölése eltér."

#. Node3D.ROTATION_EDIT_MODE_BASIS
#: doc/classes/Node3D.xml
msgid "The rotation is edited using a [Basis]. In this mode, the raw [member basis]'s axes can be freely modified, but the [member scale] property is not available."
msgstr "A forgatás [Basis] értékként szerkeszthető. Ebben a módban a nyers [member basis] tengelyei szabadon módosíthatók, de a [member scale] tulajdonság nem érhető el."

#. NodePath.brief
#: doc/classes/NodePath.xml
msgid "A pre-parsed scene tree path."
msgstr "Előre feldolgozott jelenetfa-útvonal."

#. NodePath.description
#: doc/classes/NodePath.xml
msgid "The [NodePath] built-in [Variant] type represents a path to a node or property in a hierarchy of nodes. It is designed to be efficiently passed into many built-in methods (such as [method Node.get_node], [method Object.set_indexed], [method Tween.tween_property], etc.) without a hard dependence on the node or property they point to.\nA node path is represented as a [String] composed of slash-separated ([code]/[/code]) node names and colon-separated ([code]:[/code]) property names (also called \"subnames\"). Similar to a filesystem path, [code]\"..\"[/code] and [code]\".\"[/code] are special node names. They refer to the parent node and the current node, respectively.\nThe following examples are paths relative to the current node:\n[codeblock]\n^\"A\"     # Points to the direct child A.\n^\"A/B\"   # Points to A's child B.\n^\".\"     # Points to the current node.\n^\"..\"    # Points to the parent node.\n^\"../C\"  # Points to the sibling node C.\n^\"../..\" # Points to the grandparent node.\n[/codeblock]\nA leading slash means the path is absolute, and begins from the [SceneTree]:\n[codeblock]\n^\"/root\"            # Points to the SceneTree's root Window.\n^\"/root/Title\"      # May point to the main scene's root node named \"Title\".\n^\"/root/Global\"     # May point to an autoloaded node or scene named \"Global\".\n[/codeblock]\nDespite their name, node paths may also point to a property:\n[codeblock]\n^\":position\"           # Points to this object's position.\n^\":position:x\"         # Points to this object's position in the x axis.\n^\"Camera3D:rotation:y\" # Points to the child Camera3D and its y rotation.\n^\"/root:size:x\"        # Points to the root Window and its width.\n[/codeblock]\nIn some situations, it's possible to omit the leading [code]:[/code] when pointing to an object's property. As an example, this is the case with [method Object.set_indexed] and [method Tween.tween_property], as those methods call [method NodePath.get_as_property_path] under the hood. However, it's generally recommended to keep the [code]:[/code] prefix.\nNode paths cannot check whether they are valid and may point to nodes or properties that do not exist. Their meaning depends entirely on the context in which they're used.\nYou usually do not have to worry about the [NodePath] type, as strings are automatically converted to the type when necessary. There are still times when defining node paths is useful. For example, exported [NodePath] properties allow you to easily select any node within the currently edited scene. They are also automatically updated when moving, renaming or deleting nodes in the scene tree editor. See also [annotation @GDScript.@export_node_path].\nSee also [StringName], which is a similar type designed for optimized strings.\n[b]Note:[/b] In a boolean context, a [NodePath] will evaluate to [code]false[/code] if it is empty ([code]NodePath(\"\")[/code]). Otherwise, a [NodePath] will always evaluate to [code]true[/code]."
msgstr "A [NodePath] beépített [Variant] típus egy csomópont vagy tulajdonság útvonalát adja meg a csomópontok hierarchiájában. Számos beépített metódusnak hatékonyan átadható, például a [method Node.get_node], a [method Object.set_indexed] és a [method Tween.tween_property] metódusnak, a célcsomópontra vagy tulajdonságra való közvetlen függőség nélkül.\nSzövegként az útvonal egy [String], amelyben a csomópontneveket perjel ([code]/[/code]), a tulajdonságneveket, vagyis az alneveket kettőspont ([code]:[/code]) választja el. A fájlrendszer útvonalaihoz hasonlóan a [code]\"..\"[/code] és a [code]\".\"[/code] különleges nevek. Rendre a szülőcsomópontot és az aktuális csomópontot jelölik.\nAz alábbi példák az aktuális csomóponthoz viszonyított útvonalak:\n[codeblock]\n^\"A\"     # Points to the direct child A.\n^\"A/B\"   # Points to A's child B.\n^\".\"     # Points to the current node.\n^\"..\"    # Points to the parent node.\n^\"../C\"  # Points to the sibling node C.\n^\"../..\" # Points to the grandparent node.\n[/codeblock]\nA kezdő perjel abszolút útvonalat jelöl, amely a [SceneTree] gyökeréből indul:\n[codeblock]\n^\"/root\"            # Points to the SceneTree's root Window.\n^\"/root/Title\"      # May point to the main scene's root node named \"Title\".\n^\"/root/Global\"     # May point to an autoloaded node or scene named \"Global\".\n[/codeblock]\nA csomópontútvonalak tulajdonságokra is mutathatnak:\n[codeblock]\n^\":position\"           # Points to this object's position.\n^\":position:x\"         # Points to this object's position in the x axis.\n^\"Camera3D:rotation:y\" # Points to the child Camera3D and its y rotation.\n^\"/root:size:x\"        # Points to the root Window and its width.\n[/codeblock]\nObjektumtulajdonság megadásakor bizonyos esetekben elhagyható a kezdő [code]:[/code]. Ez például a [method Object.set_indexed] és a [method Tween.tween_property] esetén működik, mert ezek a háttérben meghívják a [method NodePath.get_as_property_path] metódust. Általában mégis érdemes megtartani a kezdő [code]:[/code] karaktert.\nAz útvonal önmagában nem tudja ellenőrizni, hogy érvényes-e, ezért nem létező csomópontra vagy tulajdonságra is mutathat. Jelentése teljes mértékben a használati környezetétől függ.\nA [NodePath] típusra rendszerint nem kell külön figyelned, mert a motor szükség esetén automatikusan átalakítja a karakterláncokat. Néha mégis érdemes útvonalat megadni. Exportált [NodePath] tulajdonságnál például egyszerűen kiválaszthatod az éppen szerkesztett jelenet bármely csomópontját. Ezek az értékek automatikusan frissülnek, ha a jelenetfa-szerkesztőben egy csomópontot áthelyezel, átnevezel vagy törölsz. Lásd még az [annotation @GDScript.@export_node_path] annotációt.\nLásd még a hasonló, optimalizált karakterláncokhoz készült [StringName] típust.\n[b]Megjegyzés:[/b] Logikai kifejezésben a [NodePath] üresen [code]false[/code] értékű ([code]NodePath(\"\")[/code]). Egyébként a [NodePath] mindig [code]true[/code] értékű."

#. NodePath.NodePath
#: doc/classes/NodePath.xml
msgid "Constructs an empty [NodePath]."
msgstr "Üres [NodePath] értéket hoz létre."

#. NodePath.NodePath
#: doc/classes/NodePath.xml
msgid "Constructs a [NodePath] as a copy of the given [NodePath]."
msgstr "A megadott [NodePath] másolataként új [NodePath] értéket hoz létre."

#. NodePath.NodePath
#: doc/classes/NodePath.xml
msgid "Constructs a [NodePath] from a [String]. The created path is absolute if prefixed with a slash (see [method is_absolute]).\nThe \"subnames\" optionally included after the path to the target node can point to properties, and can also be nested.\nThe following strings can be valid node paths:\n[codeblock]\n# Points to the Sprite2D node.\n\"Level/RigidBody2D/Sprite2D\"\n\n# Points to the Sprite2D node and its \"texture\" resource.\n# get_node() would retrieve the Sprite2D, while get_node_and_resource()\n# would retrieve both the Sprite2D node and the \"texture\" resource.\n\"Level/RigidBody2D/Sprite2D:texture\"\n\n# Points to the Sprite2D node and its \"position\" property.\n\"Level/RigidBody2D/Sprite2D:position\"\n\n# Points to the Sprite2D node and the \"x\" component of its \"position\" property.\n\"Level/RigidBody2D/Sprite2D:position:x\"\n\n# Points to the RigidBody2D node as an absolute path beginning from the SceneTree.\n\"/root/Level/RigidBody2D\"\n[/codeblock]\n[b]Note:[/b] In GDScript, it's also possible to convert a constant string into a node path by prefixing it with [code]^[/code]. [code]^\"path/to/node\"[/code] is equivalent to [code]NodePath(\"path/to/node\")[/code]."
msgstr "[String] értékből [NodePath] értéket hoz létre. Ha a szöveg perjellel kezdődik, az útvonal abszolút (lásd: [method is_absolute]).\nA célcsomópont útvonala után megadható alnevek tulajdonságokra mutathatnak, és egymásba is ágyazhatók.\nAz alábbi karakterláncok érvényes csomópontútvonalak lehetnek:\n[codeblock]\n# Points to the Sprite2D node.\n\"Level/RigidBody2D/Sprite2D\"\n\n# Points to the Sprite2D node and its \"texture\" resource.\n# get_node() would retrieve the Sprite2D, while get_node_and_resource()\n# would retrieve both the Sprite2D node and the \"texture\" resource.\n\"Level/RigidBody2D/Sprite2D:texture\"\n\n# Points to the Sprite2D node and its \"position\" property.\n\"Level/RigidBody2D/Sprite2D:position\"\n\n# Points to the Sprite2D node and the \"x\" component of its \"position\" property.\n\"Level/RigidBody2D/Sprite2D:position:x\"\n\n# Points to the RigidBody2D node as an absolute path beginning from the SceneTree.\n\"/root/Level/RigidBody2D\"\n[/codeblock]\n[b]Megjegyzés:[/b] GDScriptben a [code]^[/code] előtaggal egy állandó karakterlánc csomópontútvonallá alakítható. A [code]^\"path/to/node\"[/code] egyenértékű a [code]NodePath(\"path/to/node\")[/code] kifejezéssel."

#. NodePath.get_as_property_path
#: doc/classes/NodePath.xml
msgid "Returns a copy of this node path with a colon character ([code]:[/code]) prefixed, transforming it to a pure property path with no node names (relative to the current node).\n[codeblocks]\n[gdscript]\n# node_path points to the \"x\" property of the child node named \"position\".\nvar node_path = ^\"position:x\"\n\n# property_path points to the \"position\" in the \"x\" axis of this node.\nvar property_path = node_path.get_as_property_path()\nprint(property_path) # Prints \":position:x\"\n[/gdscript]\n[csharp]\n// nodePath points to the \"x\" property of the child node named \"position\".\nvar nodePath = new NodePath(\"position:x\");\n\n// propertyPath points to the \"position\" in the \"x\" axis of this node.\nNodePath propertyPath = nodePath.GetAsPropertyPath();\nGD.Print(propertyPath); // Prints \":position:x\"\n[/csharp]\n[/codeblocks]"
msgstr "A csomópontútvonal másolatát adja vissza kezdő kettősponttal ([code]:[/code]). Így az aktuális csomóponthoz viszonyított, csomópontnevek nélküli tulajdonságútvonallá alakítja.\n[codeblocks]\n[gdscript]\n# node_path points to the \"x\" property of the child node named \"position\".\nvar node_path = ^\"position:x\"\n\n# property_path points to the \"position\" in the \"x\" axis of this node.\nvar property_path = node_path.get_as_property_path()\nprint(property_path) # Prints \":position:x\"\n[/gdscript]\n[csharp]\n// nodePath points to the \"x\" property of the child node named \"position\".\nvar nodePath = new NodePath(\"position:x\");\n\n// propertyPath points to the \"position\" in the \"x\" axis of this node.\nNodePath propertyPath = nodePath.GetAsPropertyPath();\nGD.Print(propertyPath); // Prints \":position:x\"\n[/csharp]\n[/codeblocks]"

#. NodePath.get_concatenated_names
#: doc/classes/NodePath.xml
msgid "Returns all node names concatenated with a slash character ([code]/[/code]) as a single [StringName]."
msgstr "Egyetlen [StringName] értékként adja vissza az összes csomópontnevet, perjellel ([code]/[/code]) összefűzve."

#. NodePath.get_concatenated_subnames
#: doc/classes/NodePath.xml
msgid "Returns all property subnames concatenated with a colon character ([code]:[/code]) as a single [StringName].\n[codeblocks]\n[gdscript]\nvar node_path = ^\"Sprite2D:texture:resource_name\"\nprint(node_path.get_concatenated_subnames()) # Prints \"texture:resource_name\"\n[/gdscript]\n[csharp]\nvar nodePath = new NodePath(\"Sprite2D:texture:resource_name\");\nGD.Print(nodePath.GetConcatenatedSubnames()); // Prints \"texture:resource_name\"\n[/csharp]\n[/codeblocks]"
msgstr "Egyetlen [StringName] értékként adja vissza az összes tulajdonságalnevet, kettősponttal ([code]:[/code]) összefűzve.\n[codeblocks]\n[gdscript]\nvar node_path = ^\"Sprite2D:texture:resource_name\"\nprint(node_path.get_concatenated_subnames()) # Prints \"texture:resource_name\"\n[/gdscript]\n[csharp]\nvar nodePath = new NodePath(\"Sprite2D:texture:resource_name\");\nGD.Print(nodePath.GetConcatenatedSubnames()); // Prints \"texture:resource_name\"\n[/csharp]\n[/codeblocks]"

#. NodePath.get_name
#: doc/classes/NodePath.xml
msgid "Returns the node name indicated by [param idx], starting from 0. If [param idx] is out of bounds, an error is generated. See also [method get_subname_count] and [method get_name_count].\n[codeblocks]\n[gdscript]\nvar sprite_path = NodePath(\"../RigidBody2D/Sprite2D\")\nprint(sprite_path.get_name(0)) # Prints \"..\"\nprint(sprite_path.get_name(1)) # Prints \"RigidBody2D\"\nprint(sprite_path.get_name(2)) # Prints \"Sprite\"\n[/gdscript]\n[csharp]\nvar spritePath = new NodePath(\"../RigidBody2D/Sprite2D\");\nGD.Print(spritePath.GetName(0)); // Prints \"..\"\nGD.Print(spritePath.GetName(1)); // Prints \"PathFollow2D\"\nGD.Print(spritePath.GetName(2)); // Prints \"Sprite\"\n[/csharp]\n[/codeblocks]"
msgstr "Visszaadja a [param idx] indexű csomópontnevet. A számozás 0-tól indul. Ha a [param idx] kívül esik a tartományon, hibát jelez. Lásd még a [method get_subname_count] és a [method get_name_count] metódust.\n[codeblocks]\n[gdscript]\nvar sprite_path = NodePath(\"../RigidBody2D/Sprite2D\")\nprint(sprite_path.get_name(0)) # Prints \"..\"\nprint(sprite_path.get_name(1)) # Prints \"RigidBody2D\"\nprint(sprite_path.get_name(2)) # Prints \"Sprite\"\n[/gdscript]\n[csharp]\nvar spritePath = new NodePath(\"../RigidBody2D/Sprite2D\");\nGD.Print(spritePath.GetName(0)); // Prints \"..\"\nGD.Print(spritePath.GetName(1)); // Prints \"PathFollow2D\"\nGD.Print(spritePath.GetName(2)); // Prints \"Sprite\"\n[/csharp]\n[/codeblocks]"

#. NodePath.get_name_count
#: doc/classes/NodePath.xml
msgid "Returns the number of node names in the path. Property subnames are not included.\nFor example, [code]\"../RigidBody2D/Sprite2D:texture\"[/code] contains 3 node names."
msgstr "Visszaadja az útvonalban található csomópontnevek számát. A tulajdonságalneveket nem számolja bele.\nPéldául a [code]\"../RigidBody2D/Sprite2D:texture\"[/code] útvonal 3 csomópontnevet tartalmaz."

#. NodePath.get_subname
#: doc/classes/NodePath.xml
msgid "Returns the property name indicated by [param idx], starting from 0. If [param idx] is out of bounds, an error is generated. See also [method get_subname_count].\n[codeblocks]\n[gdscript]\nvar path_to_name = NodePath(\"Sprite2D:texture:resource_name\")\nprint(path_to_name.get_subname(0)) # Prints \"texture\"\nprint(path_to_name.get_subname(1)) # Prints \"resource_name\"\n[/gdscript]\n[csharp]\nvar pathToName = new NodePath(\"Sprite2D:texture:resource_name\");\nGD.Print(pathToName.GetSubname(0)); // Prints \"texture\"\nGD.Print(pathToName.GetSubname(1)); // Prints \"resource_name\"\n[/csharp]\n[/codeblocks]"
msgstr "Visszaadja a [param idx] indexű tulajdonság nevét. A számozás 0-tól indul. Ha a [param idx] kívül esik a tartományon, hibát jelez. Lásd még a [method get_subname_count] metódust.\n[codeblocks]\n[gdscript]\nvar path_to_name = NodePath(\"Sprite2D:texture:resource_name\")\nprint(path_to_name.get_subname(0)) # Prints \"texture\"\nprint(path_to_name.get_subname(1)) # Prints \"resource_name\"\n[/gdscript]\n[csharp]\nvar pathToName = new NodePath(\"Sprite2D:texture:resource_name\");\nGD.Print(pathToName.GetSubname(0)); // Prints \"texture\"\nGD.Print(pathToName.GetSubname(1)); // Prints \"resource_name\"\n[/csharp]\n[/codeblocks]"

#. NodePath.get_subname_count
#: doc/classes/NodePath.xml
msgid "Returns the number of property names (\"subnames\") in the path. Each subname in the node path is listed after a colon character ([code]:[/code]).\nFor example, [code]\"Level/RigidBody2D/Sprite2D:texture:resource_name\"[/code] contains 2 subnames."
msgstr "Visszaadja az útvonal tulajdonságneveinek, más néven alneveinek számát. Az összes alnév egy kettőspont ([code]:[/code]) után következik.\nPéldául a [code]\"Level/RigidBody2D/Sprite2D:texture:resource_name\"[/code] útvonal 2 alnevet tartalmaz."

#. NodePath.hash
#: doc/classes/NodePath.xml
msgid "Returns the 32-bit hash value representing the node path's contents.\n[b]Note:[/b] Node paths with equal hash values are [i]not[/i] guaranteed to be the same, as a result of hash collisions. Node paths with different hash values are guaranteed to be different."
msgstr "Visszaadja a csomópontútvonal tartalmát képviselő 32 bites hash-értéket.\n[b]Megjegyzés:[/b] Az azonos hash-értékű útvonalak [i]nem[/i] feltétlenül egyeznek, mert előfordulhat hashütközés. Eltérő hash-értékű útvonalak biztosan különböznek."

#. NodePath.is_absolute
#: doc/classes/NodePath.xml
msgid "Returns [code]true[/code] if the node path is absolute. Unlike a relative path, an absolute path is represented by a leading slash character ([code]/[/code]) and always begins from the [SceneTree]. It can be used to reliably access nodes from the root node (e.g. [code]\"/root/Global\"[/code] if an autoload named \"Global\" exists)."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópontútvonal abszolút. Az abszolút útvonal perjellel ([code]/[/code]) kezdődik, és mindig a [SceneTree] gyökeréből indul. Így a csomópontok a gyökércsomóponttól megbízhatóan elérhetők, például a [code]\"/root/Global\"[/code] útvonalon, ha létezik Global nevű automatikusan betöltött csomópont."

#. NodePath.is_empty
#: doc/classes/NodePath.xml
msgid "Returns [code]true[/code] if the node path has been constructed from an empty [String] ([code]\"\"[/code])."
msgstr "[code]true[/code] értéket ad vissza, ha az útvonal üres [String] értékből ([code]\"\"[/code]) jött létre."

#. NodePath.slice
#: doc/classes/NodePath.xml
msgid "Returns the slice of the [NodePath], from [param begin] (inclusive) to [param end] (exclusive), as a new [NodePath].\nThe absolute value of [param begin] and [param end] will be clamped to the sum of [method get_name_count] and [method get_subname_count], so the default value for [param end] makes it slice to the end of the [NodePath] by default (i.e. [code]path.slice(1)[/code] is a shorthand for [code]path.slice(1, path.get_name_count() + path.get_subname_count())[/code]).\nIf either [param begin] or [param end] are negative, they will be relative to the end of the [NodePath] (i.e. [code]path.slice(0, -2)[/code] is a shorthand for [code]path.slice(0, path.get_name_count() + path.get_subname_count() - 2)[/code])."
msgstr "A [NodePath] egy részét adja vissza új [NodePath] értékként, a [param begin] indextől a [param end] indexig, az elsőt beleértve, az utolsót kihagyva.\nA [param begin] és a [param end] abszolút értéke nem lépheti túl a [method get_name_count] és a [method get_subname_count] összegét. A [param end] alapértelmezésben a [NodePath] végéig tartó részletet ad, vagyis a [code]path.slice(1)[/code] a [code]path.slice(1, path.get_name_count() + path.get_subname_count())[/code] rövid alakja.\nNegatív [param begin] vagy [param end] a [NodePath] végétől számítandó. A [code]path.slice(0, -2)[/code] például a [code]path.slice(0, path.get_name_count() + path.get_subname_count() - 2)[/code] rövid alakja."

#. NodePath.operator !=
#: doc/classes/NodePath.xml
msgid "Returns [code]true[/code] if two node paths are not equal."
msgstr "[code]true[/code] értéket ad vissza, ha két csomópontútvonal eltér."

#. NodePath.operator ==
#: doc/classes/NodePath.xml
msgid "Returns [code]true[/code] if two node paths are equal, that is, they are composed of the same node names and subnames in the same order."
msgstr "[code]true[/code] értéket ad vissza, ha a két csomópontútvonal egyenlő, vagyis ugyanazokat a csomópontneveket és alneveket tartalmazzák azonos sorrendben."

#. Node.has_node_and_resource
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if [param path] points to a valid node and its subnames point to a valid [Resource], e.g. [code]Area2D/CollisionShape2D:shape[/code]. Properties that are not [Resource] types (such as nodes or other [Variant] types) are not considered. See also [method get_node_and_resource]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param path] érvényes csomópontra mutat, és az alnevei egy érvényes [Resource] erőforrásra mutatnak, például [code]Area2D/CollisionShape2D:shape[/code]. A metódus figyelmen kívül hagyja a nem [Resource] típusú tulajdonságokat, például a csomópontokat és más [Variant] típusokat. Lásd még a [method get_node_and_resource] metódust."

#. Node.is_displayed_folded
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the node is folded (collapsed) in the Scene dock. This method is intended to be used in editor plugins and tools. See also [method set_display_folded]."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont össze van csukva a Jelenet panelen. A metódus szerkesztőbővítményekhez és eszközökhöz készült. Lásd még a [method set_display_folded] metódust."

#. Node.is_editable_instance
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if [param node] has editable children enabled relative to this node. This method is intended to be used in editor plugins and tools. See also [method set_editable_instance]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param node] gyermekei ebből a csomópontból szerkeszthetők. A metódus szerkesztőbővítményekhez és eszközökhöz készült. Lásd még a [method set_editable_instance] metódust."

#. Node.is_greater_than
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the given [param node] occurs later in the scene hierarchy than this node. A node occurring later is usually processed last."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param node] később szerepel a jelenethierarchiában, mint ez a csomópont. A később szereplő csomópont általában később kerül feldolgozásra."

#. Node.is_in_group
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if this node has been added to the given [param group]. See [method add_to_group] and [method remove_from_group]. See also notes in the description, and the [SceneTree]'s group methods."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont a megadott [param group] csoport tagja. Lásd a [method add_to_group] és a [method remove_from_group] metódust. Lásd még az osztályleírás megjegyzéseit és a [SceneTree] csoportkezelő metódusait."

#. Node.is_multiplayer_authority
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the local system is the multiplayer authority of this node."
msgstr "[code]true[/code] értéket ad vissza, ha a helyi rendszer rendelkezik a csomópont feletti hálózati jogosultsággal."

#. Node.is_part_of_edited_scene
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the node is part of the scene currently opened in the editor."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont a szerkesztőben éppen megnyitott jelenet része."

#. Node.is_physics_interpolated
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if physics interpolation is enabled for this node (see [member physics_interpolation_mode]).\n[b]Note:[/b] Interpolation will only be active if both the flag is set [b]and[/b] physics interpolation is enabled within the [SceneTree]. This can be tested using [method is_physics_interpolated_and_enabled]."
msgstr "[code]true[/code] értéket ad vissza, ha a csomóponton engedélyezve van a fizikai interpoláció (lásd: [member physics_interpolation_mode]).\n[b]Megjegyzés:[/b] Az interpoláció csak akkor aktív, ha a csomóponton be van állítva a jelző, [b]és[/b] a [SceneTree] jelenetfában is engedélyezve van a fizikai interpoláció. Ez a [method is_physics_interpolated_and_enabled] metódussal ellenőrizhető."

#. Node.is_physics_interpolated_and_enabled
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if physics interpolation is enabled (see [member physics_interpolation_mode]) [b]and[/b] enabled in the [SceneTree].\nThis is a convenience version of [method is_physics_interpolated] that also checks whether physics interpolation is enabled globally.\nSee [member SceneTree.physics_interpolation] and [member ProjectSettings.physics/common/physics_interpolation]."
msgstr "[code]true[/code] értéket ad vissza, ha a fizikai interpoláció engedélyezve van a csomóponton (lásd: [member physics_interpolation_mode]) [b]és[/b] a [SceneTree] jelenetfában is.\nA [method is_physics_interpolated] olyan változata, amely a globális beállítást is ellenőrzi.\nLásd a [member SceneTree.physics_interpolation] és a [member ProjectSettings.physics/common/physics_interpolation] tulajdonságot."

#. Node.is_physics_processing
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if physics processing is enabled (see [method set_physics_process])."
msgstr "[code]true[/code] értéket ad vissza, ha a fizikai feldolgozás engedélyezve van (lásd: [method set_physics_process])."

#. Node.is_physics_processing_internal
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if internal physics processing is enabled (see [method set_physics_process_internal])."
msgstr "[code]true[/code] értéket ad vissza, ha a belső fizikai feldolgozás engedélyezve van (lásd: [method set_physics_process_internal])."

#. Node.is_processing
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if processing is enabled (see [method set_process])."
msgstr "[code]true[/code] értéket ad vissza, ha a feldolgozás engedélyezve van (lásd: [method set_process])."

#. Node.is_processing_input
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the node is processing input (see [method set_process_input])."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont feldolgozza a bemenetet (lásd: [method set_process_input])."

#. Node.is_processing_internal
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if internal processing is enabled (see [method set_process_internal])."
msgstr "[code]true[/code] értéket ad vissza, ha a belső feldolgozás engedélyezve van (lásd: [method set_process_internal])."

#. Node.is_processing_shortcut_input
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the node is processing shortcuts (see [method set_process_shortcut_input])."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont feldolgozza a gyorsbillentyűket (lásd: [method set_process_shortcut_input])."

#. Node.is_processing_unhandled_input
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the node is processing unhandled input (see [method set_process_unhandled_input])."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont feldolgozza a még nem kezelt bemenetet (lásd: [method set_process_unhandled_input])."

#. BaseMaterial3D.TEXTURE_FILTER_MAX
#. CanvasItem.TEXTURE_FILTER_MAX
#. VisualShaderNodeTextureParameter.FILTER_MAX
#: doc/classes/BaseMaterial3D.xml doc/classes/CanvasItem.xml modules/visual_shader/doc_classes/VisualShaderNodeTextureParameter.xml
msgid "Represents the size of the [enum TextureFilter] enum."
msgstr "A [enum TextureFilter] felsorolás méretét jelöli."

#. CanvasItem.brief
#: doc/classes/CanvasItem.xml
msgid "Abstract base class for everything in 2D space."
msgstr "A 2D térben megjelenő elemek absztrakt alaposztálya."

#. CanvasItem.description
#: doc/classes/CanvasItem.xml
msgid "Abstract base class for everything in 2D space. Canvas items are laid out in a tree; children inherit and extend their parent's transform. [CanvasItem] is extended by [Control] for GUI-related nodes, and by [Node2D] for 2D game objects.\nAny [CanvasItem] can draw. For this, [method queue_redraw] is called by the engine, then [constant NOTIFICATION_DRAW] will be received on idle time to request a redraw. Because of this, canvas items don't need to be redrawn on every frame, improving the performance significantly. Several functions for drawing on the [CanvasItem] are provided (see [code]draw_*[/code] functions). However, they can only be used inside [method _draw], its corresponding [method Object._notification] or methods connected to the [signal draw] signal.\nCanvas items are drawn in tree order on their canvas layer. By default, children are on top of their parents, so a root [CanvasItem] will be drawn behind everything. This behavior can be changed on a per-item basis.\nA [CanvasItem] can be hidden, which will also hide its children. By adjusting various other properties of a [CanvasItem], you can also modulate its color (via [member modulate] or [member self_modulate]), change its Z-index, blend mode, and more.\nNote that properties like transform, modulation, and visibility are only propagated to [i]direct[/i] [CanvasItem] child nodes. If there is a non-[CanvasItem] node in between, like [Node] or [AnimationPlayer], the [CanvasItem] nodes below will have an independent position and [member modulate] chain. See also [member top_level]."
msgstr "A 2D térben megjelenő elemek absztrakt alaposztálya. A vászonelemek fát alkotnak, amelyben a gyermekek öröklik a szülőjük transzformációját, és a sajátjukat is alkalmazzák. A felület csomópontjai a [Control], a 2D játékobjektumok pedig a [Node2D] osztályon keresztül származnak a [CanvasItem] osztályból.\nMinden [CanvasItem] tud rajzolni. Ehhez a motor meghívja a [method queue_redraw] metódust, majd üresjáratban elküldi a [constant NOTIFICATION_DRAW] értesítést az újrarajzolás kérésére. Így a vászonelemeket nem kell minden képkockán újrarajzolni, ami jelentősen javítja a teljesítményt. A [CanvasItem] több rajzolómetódust is biztosít (lásd a [code]draw_*[/code] metódusokat). Ezek csak a [method _draw], a hozzá tartozó [method Object._notification] vagy a [signal draw] jelzéshez kapcsolt metódusok belsejében hívhatók meg.\nA vászonelemek a fa sorrendjében rajzolódnak ki a saját vászonrétegükre. Alapértelmezésben a gyermekek a szülőik elé kerülnek, így a gyökér [CanvasItem] minden mögé rajzolódik. Ez elemenként módosítható.\nEgy [CanvasItem] elrejtése a gyermekeit is elrejti. A [CanvasItem] tulajdonságain keresztül a színe ([member modulate] vagy [member self_modulate]), a Z-indexe, a keverési módja és más beállításai is módosíthatók.\nAz olyan tulajdonságok, mint a transzformáció, a színezés és a láthatóság csak a [i]közvetlen[/i] [CanvasItem] gyermekekre terjednek tovább. Ha egy másik típusú, nem [CanvasItem] csomópont, például [Node] vagy [AnimationPlayer] van közöttük, az alatta lévő [CanvasItem] csomópontok helyzete és [member modulate] lánca független lesz. Lásd még a [member top_level] tulajdonságot."

#. CanvasItem._draw
#: doc/classes/CanvasItem.xml
msgid "Called when [CanvasItem] has been requested to redraw (after [method queue_redraw] is called, either manually or by the engine).\nCorresponds to the [constant NOTIFICATION_DRAW] notification in [method Object._notification]."
msgstr "Akkor hívódik meg, amikor a [CanvasItem] újrarajzolását kérik, miután a [method queue_redraw] metódust kézzel vagy a motor meghívta.\nA [method Object._notification] metódusban a [constant NOTIFICATION_DRAW] értesítésnek felel meg."

#. CanvasItem.draw_animation_slice
#. RenderingServer.canvas_item_add_animation_slice
#: doc/classes/CanvasItem.xml doc/classes/RenderingServer.xml
msgid "Subsequent drawing commands will be ignored unless they fall within the specified animation slice. This is a faster way to implement animations that loop on background rather than redrawing constantly."
msgstr "A motor figyelmen kívül hagyja a későbbi rajzolási parancsokat, ha azok kívül esnek a megadott animációs szakaszon. Így a háttérben ismétlődő animációk folyamatos újrarajzolás nélkül, gyorsabban valósíthatók meg."

#. CanvasItem.draw_arc
#: doc/classes/CanvasItem.xml
msgid "Draws an unfilled arc between the given angles with a uniform [param color] and [param width] and optional antialiasing (supported only for positive [param width]). The larger the value of [param point_count], the smoother the curve. [param center] is defined in local space. For elliptical arcs, see [method draw_ellipse_arc]. See also [method draw_circle].\nIf [param width] is negative, it will be ignored and the arc will be drawn using [constant RenderingServer.PRIMITIVE_LINE_STRIP]. This means that when the CanvasItem is scaled, the arc will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code].\nThe arc is drawn from [param start_angle] towards the value of [param end_angle] so in clockwise direction if [code]start_angle < end_angle[/code] and counter-clockwise otherwise. Passing the same angles but in reversed order will produce the same arc. If absolute difference of [param start_angle] and [param end_angle] is greater than [constant @GDScript.TAU] radians, then a full circle arc is drawn (i.e. arc will not overlap itself)."
msgstr "Kitöltetlen körívet rajzol a megadott szögek között, egységes [param color] színnel és [param width] vonalvastagsággal. Az élsimítás csak pozitív [param width] esetén választható. Nagyobb [param point_count] értéknél simább a görbe. A [param center] a helyi térben értendő. Ellipszisívhez lásd a [method draw_ellipse_arc] metódust. Lásd még a [method draw_circle] metódust.\nNegatív [param width] esetén a motor figyelmen kívül hagyja az értéket, és a [constant RenderingServer.PRIMITIVE_LINE_STRIP] primitívvel rajzol. Így az ív a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code].\nAz ív a [param start_angle] értéktől a [param end_angle] felé halad. Ha [code]start_angle < end_angle[/code], az óramutató járását követi, egyébként ellenkező irányban halad. A szögek felcserélése ugyanazt az ívet adja. Ha a [param start_angle] és a [param end_angle] különbségének abszolút értéke meghaladja a [constant @GDScript.TAU] radiánt, a motor teljes kört rajzol, átfedés nélkül."

#. CanvasItem.draw_char
#: doc/classes/CanvasItem.xml
msgid "Draws a string first character using a custom font. If [param oversampling] is greater than zero, it is used as font oversampling factor, otherwise viewport oversampling settings are used. [param pos] is defined in local space."
msgstr "Egy karakterlánc első karakterét rajzolja ki egyéni betűtípussal. Pozitív [param oversampling] esetén a megadott érték a betűtípus túlmintavételezési tényezője. Egyébként a nézetablak túlmintavételezési beállítása érvényes. A [param pos] a helyi térben értendő."

#. CanvasItem.draw_char_outline
#: doc/classes/CanvasItem.xml
msgid "Draws a string first character outline using a custom font. If [param oversampling] is greater than zero, it is used as font oversampling factor, otherwise viewport oversampling settings are used. [param pos] is defined in local space."
msgstr "Egy karakterlánc első karakterének körvonalát rajzolja ki egyéni betűtípussal. Pozitív [param oversampling] esetén a megadott érték a betűtípus túlmintavételezési tényezője. Egyébként a nézetablak túlmintavételezési beállítása érvényes. A [param pos] a helyi térben értendő."

#. CanvasItem.draw_circle
#: doc/classes/CanvasItem.xml
msgid "Draws a circle, with [param position] defined in local space. See also [method draw_ellipse], [method draw_arc], [method draw_polyline], and [method draw_polygon].\nIf [param filled] is [code]true[/code], the circle will be filled with the [param color] specified. If [param filled] is [code]false[/code], the circle will be drawn as a stroke with the [param color] and [param width] specified.\nIf [param width] is negative, then two-point primitives will be drawn instead of a four-point ones. This means that when the CanvasItem is scaled, the lines will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code].\nIf [param antialiased] is [code]true[/code], half transparent \"feathers\" will be attached to the boundary, making outlines smooth.\n[b]Note:[/b] [param width] is only effective if [param filled] is [code]false[/code]."
msgstr "Kört rajzol a helyi térben megadott [param position] középponttal. Lásd még a [method draw_ellipse], a [method draw_arc], a [method draw_polyline] és a [method draw_polygon] metódust.\nHa a [param filled] értéke [code]true[/code], a kör kitöltése a megadott [param color] színnel történik. Ha a [param filled] értéke [code]false[/code], a motor a megadott [param color] színnel és [param width] vastagsággal rajzol körvonalat.\nNegatív [param width] esetén a motor négypontos helyett kétpontos primitíveket rajzol. Így a vonal a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code].\nHa a [param antialiased] értéke [code]true[/code], a körvonal éleire félig átlátszó képpontok kerülnek, így a körvonal simábbnak látszik.\n[b]Megjegyzés:[/b] A [param width] csak akkor hatásos, ha a [param filled] értéke [code]false[/code]."

#. CanvasItem.draw_colored_polygon
#: doc/classes/CanvasItem.xml
msgid "Draws a colored polygon of any number of points, convex or concave. The points in the [param points] array are defined in local space. Unlike [method draw_polygon], a single color must be specified for the whole polygon.\n[b]Note:[/b] If you frequently redraw the same polygon with a large number of vertices, consider pre-calculating the triangulation with [method Geometry2D.triangulate_polygon] and using [method draw_mesh], [method draw_multimesh], or [method RenderingServer.canvas_item_add_triangle_array].\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "Tetszőleges számú pontból álló domború vagy homorú színes sokszöget rajzol. A [param points] tömb pontjai a helyi térben értendők. A [method draw_polygon] metódustól eltérően a teljes sokszöghöz egy színt kell megadni.\n[b]Megjegyzés:[/b] Ha ugyanazt a sok csúcspontból álló sokszöget gyakran rajzolod újra, érdemes a [method Geometry2D.triangulate_polygon] metódussal előre kiszámítani a háromszögekre bontását, majd a [method draw_mesh], a [method draw_multimesh] vagy a [method RenderingServer.canvas_item_add_triangle_array] metódussal kirajzolni.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_dashed_line
#: doc/classes/CanvasItem.xml
msgid "Draws a dashed line from a 2D point to another, with a given color and width. The [param from] and [param to] positions are defined in local space. See also [method draw_line], [method draw_multiline], and [method draw_polyline].\nIf [param width] is negative, then a two-point primitives will be drawn instead of a four-point ones. This means that when the CanvasItem is scaled, the line parts will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code].\n[param dash] is the length of each dash in pixels, with the gap between each dash being the same length. If [param aligned] is [code]true[/code], the length of the first and last dashes may be shortened or lengthened to allow the line to begin and end at the precise points defined by [param from] and [param to]. Both ends are always symmetrical when [param aligned] is [code]true[/code]. If [param aligned] is [code]false[/code], all dashes will have the same length, but the line may appear incomplete at the end due to the dash length not dividing evenly into the line length. Only full dashes are drawn when [param aligned] is [code]false[/code].\nIf [param antialiased] is [code]true[/code], half transparent \"feathers\" will be attached to the boundary, making outlines smooth.\n[b]Note:[/b] [param antialiased] is only effective if [param width] is greater than [code]0.0[/code]."
msgstr "Szaggatott vonalat rajzol két 2D pont közé megadott színnel és vastagsággal. A [param from] és a [param to] a helyi térben értendő. Lásd még a [method draw_line], a [method draw_multiline] és a [method draw_polyline] metódust.\nNegatív [param width] esetén a motor négypontos helyett kétpontos primitíveket rajzol. Így a vonás a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code].\nA [param dash] egy vonás hossza képpontban. A vonások közötti hézag ugyanilyen hosszú. Ha a [param aligned] értéke [code]true[/code], az első és utolsó vonás rövidülhet vagy hosszabbodhat, hogy a vonal pontosan a [param from] és a [param to] pontokon kezdődjön és végződjön. A két vég mindig szimmetrikus, ha a [param aligned] értéke [code]true[/code]. Ha a [param aligned] értéke [code]false[/code], a vonások egyforma hosszúak, de a vonal vége hiányosnak tűnhet, ha a vonáshossz nem osztja egész számmal a teljes vonal hosszát. [param aligned] = [code]false[/code] esetén csak teljes vonások rajzolódnak ki.\nHa a [param antialiased] értéke [code]true[/code], a körvonal éleire félig átlátszó képpontok kerülnek, így a körvonal simábbnak látszik.\n[b]Megjegyzés:[/b] A [param antialiased] csak akkor hatásos, ha a [param width] nagyobb [code]0.0[/code] értéknél."

#. CanvasItem.draw_ellipse
#: doc/classes/CanvasItem.xml
msgid "Draws an ellipse with semi-major axis [param major] and semi-minor axis [param minor]. See also [method draw_circle], [method draw_ellipse_arc], [method draw_polyline], and [method draw_polygon].\nIf [param filled] is [code]true[/code], the ellipse will be filled with the [param color] specified. If [param filled] is [code]false[/code], the ellipse will be drawn as a stroke with the [param color] and [param width] specified.\nIf [param width] is negative, then two-point primitives will be drawn instead of four-point ones. This means that when the CanvasItem is scaled, the lines will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code].\nIf [param antialiased] is [code]true[/code], half transparent \"feathers\" will be attached to the boundary, making outlines smooth.\n[b]Note:[/b] [param width] is only effective if [param filled] is [code]false[/code]."
msgstr "Ellipszist rajzol a [param major] nagy féltengellyel és a [param minor] kis féltengellyel. Lásd még a [method draw_circle], a [method draw_ellipse_arc], a [method draw_polyline] és a [method draw_polygon] metódust.\nHa a [param filled] értéke [code]true[/code], a ellipszis kitöltése a megadott [param color] színnel történik. Ha a [param filled] értéke [code]false[/code], a motor a megadott [param color] színnel és [param width] vastagsággal rajzol körvonalat.\nNegatív [param width] esetén a motor négypontos helyett kétpontos primitíveket rajzol. Így a vonal a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code].\nHa a [param antialiased] értéke [code]true[/code], a körvonal éleire félig átlátszó képpontok kerülnek, így a körvonal simábbnak látszik.\n[b]Megjegyzés:[/b] A [param width] csak akkor hatásos, ha a [param filled] értéke [code]false[/code]."

#. CanvasItem.draw_ellipse_arc
#: doc/classes/CanvasItem.xml
msgid "Draws an unfilled elliptical arc between the given angles with a uniform [param color] and [param width] and optional antialiasing (supported only for positive [param width]). The larger the value of [param point_count], the smoother the curve. For circular arcs, see [method draw_arc]. See also [method draw_ellipse].\nIf [param width] is negative, it will be ignored and the arc will be drawn using [constant RenderingServer.PRIMITIVE_LINE_STRIP]. This means that when the CanvasItem is scaled, the arc will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code].\nThe arc is drawn from [param start_angle] towards the value of [param end_angle] so in clockwise direction if [code]start_angle < end_angle[/code] and counter-clockwise otherwise. Passing the same angles but in reversed order will produce the same arc. If absolute difference of [param start_angle] and [param end_angle] is greater than [constant @GDScript.TAU] radians, then a full ellipse is drawn (i.e. arc will not overlap itself)."
msgstr "Kitöltetlen ellipszisívet rajzol a megadott szögek között, egységes [param color] színnel és [param width] vonalvastagsággal. Az élsimítás csak pozitív [param width] esetén választható. Nagyobb [param point_count] értéknél simább a görbe. Körívhez lásd a [method draw_arc] metódust. Lásd még a [method draw_ellipse] metódust.\nNegatív [param width] esetén a motor figyelmen kívül hagyja az értéket, és a [constant RenderingServer.PRIMITIVE_LINE_STRIP] primitívvel rajzol. Így az ív a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code].\nAz ív a [param start_angle] értéktől a [param end_angle] felé halad. Ha [code]start_angle < end_angle[/code], az óramutató járását követi, egyébként ellenkező irányban halad. A szögek felcserélése ugyanazt az ívet adja. Ha a [param start_angle] és a [param end_angle] különbségének abszolút értéke meghaladja a [constant @GDScript.TAU] radiánt, a motor teljes ellipszist rajzol, átfedés nélkül."

#. CanvasItem.draw_end_animation
#: doc/classes/CanvasItem.xml
msgid "After submitting all animations slices via [method draw_animation_slice], this function can be used to revert drawing to its default state (all subsequent drawing commands will be visible). If you don't care about this particular use case, usage of this function after submitting the slices is not required."
msgstr "Miután a [method draw_animation_slice] metódussal megadtad az összes animációs szakaszt, ezzel a metódussal visszaállíthatod a rajzolás alapértelmezett állapotát, így minden további rajzolási parancs látható eredményt ad. Ha erre nincs szükséged, a szakaszok megadása után nem kell meghívnod."

#. CanvasItem.draw_lcd_texture_rect_region
#: doc/classes/CanvasItem.xml
msgid "Draws a textured rectangle region of the font texture with LCD subpixel anti-aliasing at a given position, optionally modulated by a color. The [param rect] is defined in local space.\nTexture is drawn using the following blend operation, blend mode of the [CanvasItemMaterial] is ignored:\n[codeblock]\ndst.r = texture.r * modulate.r * modulate.a + dst.r * (1.0 - texture.r * modulate.a);\ndst.g = texture.g * modulate.g * modulate.a + dst.g * (1.0 - texture.g * modulate.a);\ndst.b = texture.b * modulate.b * modulate.a + dst.b * (1.0 - texture.b * modulate.a);\ndst.a = modulate.a + dst.a * (1.0 - modulate.a);\n[/codeblock]\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "A betűtextúra téglalap alakú részét rajzolja ki a megadott helyen LCD-szubpixel-élsimítással. A részlet egy színnel árnyalható. A [param rect] a helyi térben értendő.\nA textúra az alábbi keverési művelettel rajzolódik ki. A motor figyelmen kívül hagyja a [CanvasItemMaterial] keverési módját:\n[codeblock]\ndst.r = texture.r * modulate.r * modulate.a + dst.r * (1.0 - texture.r * modulate.a);\ndst.g = texture.g * modulate.g * modulate.a + dst.g * (1.0 - texture.g * modulate.a);\ndst.b = texture.b * modulate.b * modulate.a + dst.b * (1.0 - texture.b * modulate.a);\ndst.a = modulate.a + dst.a * (1.0 - modulate.a);\n[/codeblock]\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_line
#: doc/classes/CanvasItem.xml
msgid "Draws a line from a 2D point to another, with a given color and width. It can be optionally antialiased. The [param from] and [param to] positions are defined in local space. See also [method draw_dashed_line], [method draw_multiline], and [method draw_polyline].\nIf [param width] is negative, then a two-point primitive will be drawn instead of a four-point one. This means that when the CanvasItem is scaled, the line will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code]."
msgstr "Vonalat rajzol két 2D pont közé megadott színnel és vastagsággal. Élsimítás is választható. A [param from] és a [param to] a helyi térben értendő. Lásd még a [method draw_dashed_line], a [method draw_multiline] és a [method draw_polyline] metódust.\nNegatív [param width] esetén a motor négypontos helyett kétpontos primitíveket rajzol. Így a vonal a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code]."

#. CanvasItem.draw_mesh
#: doc/classes/CanvasItem.xml
msgid "Draws a [Mesh] in 2D, using the provided texture. See [MeshInstance2D] for related documentation. The [param transform] is defined in local space.\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "[Mesh] hálót rajzol 2D-ben a megadott textúrával. Kapcsolódó részletekért lásd a [MeshInstance2D] osztályt. A [param transform] a helyi térben értendő.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_msdf_texture_rect_region
#: doc/classes/CanvasItem.xml
msgid "Draws a textured rectangle region of the multichannel signed distance field texture at a given position, optionally modulated by a color. The [param rect] is defined in local space. See [member FontFile.multichannel_signed_distance_field] for more information and caveats about MSDF font rendering.\nIf [param outline] is positive, each alpha channel value of pixel in region is set to maximum value of true distance in the [param outline] radius.\nValue of the [param pixel_range] should the same that was used during distance field texture generation.\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "A többcsatornás előjeles távolságmező-textúra téglalap alakú részét rajzolja ki a megadott helyen, opcionális színezéssel. A [param rect] a helyi térben értendő. Az MSDF betűtípusok megjelenítéséről és korlátairól a [member FontFile.multichannel_signed_distance_field] leírásában olvashatsz.\nHa a [param outline] pozitív, a régió minden képpontjának alfaértéke a [param outline] sugarú környezetben előforduló tényleges távolság legnagyobb értéke lesz.\nA [param pixel_range] értéke egyezzen a távolságmező-textúra előállításakor használt értékkel.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_multiline
#: doc/classes/CanvasItem.xml
msgid "Draws multiple disconnected lines with a uniform [param width] and [param color]. Each line is defined by two consecutive points from [param points] array in local space, i.e. i-th segment consists of [code]points[2 * i][/code], [code]points[2 * i + 1][/code] endpoints. When drawing large amounts of lines, this is faster than using individual [method draw_line] calls. To draw interconnected lines, use [method draw_polyline] instead.\nIf [param width] is negative, then two-point primitives will be drawn instead of a four-point ones. This means that when the CanvasItem is scaled, the lines will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code].\n[b]Note:[/b] [param antialiased] is only effective if [param width] is greater than [code]0.0[/code]."
msgstr "Egymáshoz nem kapcsolódó vonalszakaszokat rajzol egységes [param width] vastagsággal és [param color] színnel. Minden szakaszt a helyi térben megadott [param points] tömb két egymást követő pontja határoz meg. Az i-edik szakasz végpontjai [code]points[2 * i][/code] és [code]points[2 * i + 1][/code]. Sok vonal rajzolásakor gyorsabb, mint az egyedi [method draw_line] hívások. Összefüggő szakaszokhoz használd a [method draw_polyline] metódust.\nNegatív [param width] esetén a motor négypontos helyett kétpontos primitíveket rajzol. Így a vonal a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code].\n[b]Megjegyzés:[/b] A [param antialiased] csak akkor hatásos, ha a [param width] nagyobb [code]0.0[/code] értéknél."

#. CanvasItem.draw_multiline_colors
#: doc/classes/CanvasItem.xml
msgid "Draws multiple disconnected lines with a uniform [param width] and segment-by-segment coloring. Each segment is defined by two consecutive points from [param points] array in local space and a corresponding color from [param colors] array, i.e. i-th segment consists of [code]points[2 * i][/code], [code]points[2 * i + 1][/code] endpoints and has [code]colors[i][/code] color. When drawing large amounts of lines, this is faster than using individual [method draw_line] calls. To draw interconnected lines, use [method draw_polyline_colors] instead.\nIf [param width] is negative, then two-point primitives will be drawn instead of a four-point ones. This means that when the CanvasItem is scaled, the lines will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code].\n[b]Note:[/b] [param antialiased] is only effective if [param width] is greater than [code]0.0[/code]."
msgstr "Egymáshoz nem kapcsolódó vonalszakaszokat rajzol egységes [param width] vastagsággal és szakaszonként megadható színnel. A szakaszokat a helyi térben megadott [param points] tömb két egymást követő pontja és a [param colors] tömb megfelelő színe adja meg. Az i-edik szakasz végpontjai [code]points[2 * i][/code] és [code]points[2 * i + 1][/code], a színe [code]colors[i][/code]. Sok vonal rajzolásakor gyorsabb, mint az egyedi [method draw_line] hívások. Összefüggő szakaszokhoz használd a [method draw_polyline_colors] metódust.\nNegatív [param width] esetén a motor négypontos helyett kétpontos primitíveket rajzol. Így a vonal a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code].\n[b]Megjegyzés:[/b] A [param antialiased] csak akkor hatásos, ha a [param width] nagyobb [code]0.0[/code] értéknél."

#. CanvasItem.draw_multiline_string
#: doc/classes/CanvasItem.xml
msgid "Breaks [param text] into lines and draws it using the specified [param font] at the [param pos] in local space (top-left corner). The text will have its color multiplied by [param modulate]. If [param width] is greater than or equal to 0, the text will be clipped if it exceeds the specified width. If [param oversampling] is greater than zero, it is used as font oversampling factor, otherwise viewport oversampling settings are used."
msgstr "Sorokra tördeli a [param text] szöveget, és a megadott [param font] betűtípussal kirajzolja a helyi tér [param pos] pontján (bal felső sarok). A szöveg színét megszorozza a [param modulate] értékkel. Ha a [param width] legalább 0, a megadott szélességen túlnyúló szöveget levágja. Pozitív [param oversampling] esetén a megadott érték a betűtípus túlmintavételezési tényezője. Egyébként a nézetablak túlmintavételezési beállítása érvényes."

#. CanvasItem.draw_multiline_string_outline
#: doc/classes/CanvasItem.xml
msgid "Breaks [param text] to the lines and draws text outline using the specified [param font] at the [param pos] in local space (top-left corner). The text will have its color multiplied by [param modulate]. If [param width] is greater than or equal to 0, the text will be clipped if it exceeds the specified width. If [param oversampling] is greater than zero, it is used as font oversampling factor, otherwise viewport oversampling settings are used."
msgstr "Sorokra tördeli a [param text] szöveget, és kirajzolja a szöveg körvonalát a megadott [param font] betűtípussal a helyi tér [param pos] pontján (bal felső sarok). A szöveg színét megszorozza a [param modulate] értékkel. Ha a [param width] legalább 0, a megadott szélességen túlnyúló szöveget levágja. Pozitív [param oversampling] esetén a megadott érték a betűtípus túlmintavételezési tényezője. Egyébként a nézetablak túlmintavételezési beállítása érvényes."

#. CanvasItem.draw_multimesh
#: doc/classes/CanvasItem.xml
msgid "Draws a [MultiMesh] in 2D with the provided texture. See [MultiMeshInstance2D] for related documentation.\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "[MultiMesh] erőforrást rajzol ki 2D-ben a megadott textúrával. Lásd a [MultiMeshInstance2D] osztály leírását.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_polygon
#: doc/classes/CanvasItem.xml
msgid "Draws a solid polygon of any number of points, convex or concave. Unlike [method draw_colored_polygon], each point's color can be changed individually. The [param points] array is defined in local space. See also [method draw_polyline] and [method draw_polyline_colors]. If you need more flexibility (such as being able to use bones), use [method RenderingServer.canvas_item_add_triangle_array] instead.\n[b]Note:[/b] If you frequently redraw the same polygon with a large number of vertices, consider pre-calculating the triangulation with [method Geometry2D.triangulate_polygon] and using [method draw_mesh], [method draw_multimesh], or [method RenderingServer.canvas_item_add_triangle_array].\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "Tetszőleges számú pontból álló, kitöltött domború vagy homorú sokszöget rajzol. A [method draw_colored_polygon] metódustól eltérően minden pont színe külön megadható. A [param points] tömb a helyi térben értendő. Lásd még a [method draw_polyline] és a [method draw_polyline_colors] metódust. Ha nagyobb szabadságra van szükséged, például csontokat szeretnél használni, hívd meg a [method RenderingServer.canvas_item_add_triangle_array] metódust.\n[b]Megjegyzés:[/b] Ha ugyanazt a sok csúcspontból álló sokszöget gyakran rajzolod újra, érdemes a [method Geometry2D.triangulate_polygon] metódussal előre kiszámítani a háromszögekre bontását, majd a [method draw_mesh], a [method draw_multimesh] vagy a [method RenderingServer.canvas_item_add_triangle_array] metódussal kirajzolni.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_polyline
#: doc/classes/CanvasItem.xml
msgid "Draws interconnected line segments with a uniform [param color] and [param width] and optional antialiasing (supported only for positive [param width]). The [param points] array is defined in local space. When drawing large amounts of lines, this is faster than using individual [method draw_line] calls. To draw disconnected lines, use [method draw_multiline] instead. See also [method draw_polygon].\nIf [param width] is negative, it will be ignored and the polyline will be drawn using [constant RenderingServer.PRIMITIVE_LINE_STRIP]. This means that when the CanvasItem is scaled, the polyline will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code]."
msgstr "Összefüggő vonalszakaszokat rajzol egységes [param color] színnel és [param width] vastagsággal. Az élsimítás csak pozitív [param width] esetén választható. A [param points] tömb a helyi térben értendő. Sok vonal rajzolásakor gyorsabb, mint az egyedi [method draw_line] hívások. Különálló szakaszokhoz használd a [method draw_multiline] metódust. Lásd még a [method draw_polygon] metódust.\nNegatív [param width] esetén a motor figyelmen kívül hagyja az értéket, és a [constant RenderingServer.PRIMITIVE_LINE_STRIP] primitívvel rajzol. Így a törtvonal a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code]."

#. CanvasItem.draw_polyline_colors
#: doc/classes/CanvasItem.xml
msgid "Draws interconnected line segments with a uniform [param width], point-by-point coloring, and optional antialiasing (supported only for positive [param width]). Colors assigned to line points match by index between [param points] and [param colors], i.e. each line segment is filled with a gradient between the colors of the endpoints. The [param points] array is defined in local space. When drawing large amounts of lines, this is faster than using individual [method draw_line] calls. To draw disconnected lines, use [method draw_multiline_colors] instead. See also [method draw_polygon].\nIf [param width] is negative, it will be ignored and the polyline will be drawn using [constant RenderingServer.PRIMITIVE_LINE_STRIP]. This means that when the CanvasItem is scaled, the polyline will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code]."
msgstr "Összefüggő vonalszakaszokat rajzol egységes [param width] vastagsággal, pontonként megadott színnel és opcionális élsimítással. Az élsimítás csak pozitív [param width] értéknél támogatott. A [param points] és a [param colors] tömbökben az azonos indexű elemek tartoznak össze. Így a szakaszok két végpontjuk színe közötti átmenettel jelennek meg. A [param points] tömb a helyi térben értendő. Sok vonal rajzolásakor gyorsabb, mint az egyedi [method draw_line] hívások. Különálló szakaszokhoz használd a [method draw_multiline_colors] metódust. Lásd még a [method draw_polygon] metódust.\nNegatív [param width] esetén a motor figyelmen kívül hagyja az értéket, és a [constant RenderingServer.PRIMITIVE_LINE_STRIP] primitívvel rajzol. Így a törtvonal a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code]."

#. CanvasItem.draw_primitive
#: doc/classes/CanvasItem.xml
msgid "Draws a custom primitive. 1 point for a point, 2 points for a line, 3 points for a triangle, and 4 points for a quad. If 0 points or more than 4 points are specified, nothing will be drawn and an error message will be printed. The [param points] array is defined in local space. See also [method draw_line], [method draw_polyline], [method draw_polygon], and [method draw_rect].\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "Egyéni primitívet rajzol. 1 pontból pont, 2 pontból vonal, 3 pontból háromszög, 4 pontból négyszög lesz. Ha 0 vagy 4-nél több pontot adsz meg, a motor nem rajzol semmit, és hibaüzenetet ír ki. A [param points] tömb a helyi térben értendő. Lásd még a [method draw_line], a [method draw_polyline], a [method draw_polygon] és a [method draw_rect] metódust.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_rect
#: doc/classes/CanvasItem.xml
msgid "Draws a rectangle. If [param filled] is [code]true[/code], the rectangle will be filled with the [param color] specified. If [param filled] is [code]false[/code], the rectangle will be drawn as a stroke with the [param color] and [param width] specified. The [param rect] is specified in local space. See also [method draw_texture_rect].\nIf [param width] is negative, then two-point primitives will be drawn instead of a four-point ones. This means that when the CanvasItem is scaled, the lines will remain thin. If this behavior is not desired, then pass a positive [param width] like [code]1.0[/code].\nIf [param antialiased] is [code]true[/code], half transparent \"feathers\" will be attached to the boundary, making outlines smooth.\n[b]Note:[/b] [param width] is only effective if [param filled] is [code]false[/code].\n[b]Note:[/b] Unfilled rectangles drawn with a negative [param width] may not display perfectly. For example, corners may be missing or brighter due to overlapping lines (for a translucent [param color])."
msgstr "Téglalapot rajzol. Ha a [param filled] értéke [code]true[/code], a téglalap kitöltése a megadott [param color] színnel történik. Ha a [param filled] értéke [code]false[/code], a motor a megadott [param color] színnel és [param width] vastagsággal rajzol körvonalat. A [param rect] a helyi térben értendő. Lásd még a [method draw_texture_rect] metódust.\nNegatív [param width] esetén a motor négypontos helyett kétpontos primitíveket rajzol. Így a vonal a CanvasItem méretezésekor is vékony marad. Ha ezt el szeretnéd kerülni, adj meg pozitív [param width] értéket, például [code]1.0[/code].\nHa a [param antialiased] értéke [code]true[/code], a körvonal éleire félig átlátszó képpontok kerülnek, így a körvonal simábbnak látszik.\n[b]Megjegyzés:[/b] A [param width] csak akkor hatásos, ha a [param filled] értéke [code]false[/code].\n[b]Megjegyzés:[/b] A negatív [param width] értékkel rajzolt üres téglalapok megjelenítése pontatlan lehet. Hiányozhatnak például a sarkok, vagy áttetsző [param color] esetén az egymást átfedő vonalak miatt a sarkok világosabbnak látszhatnak."

#. CanvasItem.draw_set_transform
#: doc/classes/CanvasItem.xml
msgid "Sets a custom local transform for drawing via components. Anything drawn afterwards will be transformed by this.\n[b]Note:[/b] [member FontFile.oversampling] does [i]not[/i] take [param scale] into account. This means that scaling up/down will cause bitmap fonts and rasterized (non-MSDF) dynamic fonts to appear blurry or pixelated. To ensure text remains crisp regardless of scale, you can enable MSDF font rendering by enabling [member ProjectSettings.gui/theme/default_font_multichannel_signed_distance_field] (applies to the default project font only), or enabling [b]Multichannel Signed Distance Field[/b] in the import options of a DynamicFont for custom fonts. On system fonts, [member SystemFont.multichannel_signed_distance_field] can be enabled in the inspector."
msgstr "Egyéni helyi rajzolási transzformációt állít be az összetevőiből. Minden későbbi rajzolási művelet ezt a transzformációt használja.\n[b]Megjegyzés:[/b] A [member FontFile.oversampling] [i]nem[/i] veszi figyelembe a [param scale] értékét. Így nagyításkor vagy kicsinyítéskor a bitképes és a raszterizált, MSDF nélküli dinamikus betűtípusok homályosnak vagy pixelesnek látszhatnak. A szöveg minden méretben éles maradhat, ha bekapcsolod az MSDF-megjelenítést a [member ProjectSettings.gui/theme/default_font_multichannel_signed_distance_field] beállítással (ez csak a projekt alapértelmezett betűtípusára vonatkozik), vagy egyéni dinamikus betűtípus importálásakor bekapcsolod a [b]Multichannel Signed Distance Field[/b] beállítást. Rendszerbetűtípusokhoz a Tulajdonságvizsgálóban kapcsolható be a [member SystemFont.multichannel_signed_distance_field] tulajdonság."

#. CanvasItem.draw_set_transform_matrix
#: doc/classes/CanvasItem.xml
msgid "Sets a custom local transform for drawing via matrix. Anything drawn afterwards will be transformed by this."
msgstr "Mátrixból állít be egyéni helyi rajzolási transzformációt. Minden későbbi rajzolási művelet ezt a transzformációt használja."

#. CanvasItem.draw_string
#: doc/classes/CanvasItem.xml
msgid "Draws [param text] using the specified [param font] at the [param pos] in local space (bottom-left corner using the baseline of the font). The text will have its color multiplied by [param modulate]. If [param width] is greater than or equal to 0, the text will be clipped if it exceeds the specified width. If [param oversampling] is greater than zero, it is used as font oversampling factor, otherwise viewport oversampling settings are used.\n[b]Example:[/b] Draw \"Hello world\", using the project's default font:\n[codeblocks]\n[gdscript]\ndraw_string(ThemeDB.fallback_font, Vector2(64, 64), \"Hello world\", HORIZONTAL_ALIGNMENT_LEFT, -1, ThemeDB.fallback_font_size)\n[/gdscript]\n[csharp]\nDrawString(ThemeDB.FallbackFont, new Vector2(64, 64), \"Hello world\", HorizontalAlignment.Left, -1, ThemeDB.FallbackFontSize);\n[/csharp]\n[/codeblocks]\nSee also [method Font.draw_string]."
msgstr "A [param text] szöveget rajzolja ki a megadott [param font] betűtípussal a helyi tér [param pos] pontján (a betűtípus alapvonalának bal szélén). A szöveg színét megszorozza a [param modulate] értékkel. Ha a [param width] legalább 0, a megadott szélességen túlnyúló szöveget levágja. Pozitív [param oversampling] esetén a megadott érték a betűtípus túlmintavételezési tényezője. Egyébként a nézetablak túlmintavételezési beállítása érvényes.\n[b]Példa:[/b] A „Hello world” szöveg kirajzolása a projekt alapértelmezett betűtípusával:\n[codeblocks]\n[gdscript]\ndraw_string(ThemeDB.fallback_font, Vector2(64, 64), \"Hello world\", HORIZONTAL_ALIGNMENT_LEFT, -1, ThemeDB.fallback_font_size)\n[/gdscript]\n[csharp]\nDrawString(ThemeDB.FallbackFont, new Vector2(64, 64), \"Hello world\", HorizontalAlignment.Left, -1, ThemeDB.FallbackFontSize);\n[/csharp]\n[/codeblocks]\nLásd még a [method Font.draw_string] metódust."

#. CanvasItem.draw_string_outline
#: doc/classes/CanvasItem.xml
msgid "Draws [param text] outline using the specified [param font] at the [param pos] in local space (bottom-left corner using the baseline of the font). The text will have its color multiplied by [param modulate]. If [param width] is greater than or equal to 0, the text will be clipped if it exceeds the specified width. If [param oversampling] is greater than zero, it is used as font oversampling factor, otherwise viewport oversampling settings are used."
msgstr "A [param text] szöveg körvonalát rajzolja ki a megadott [param font] betűtípussal a helyi tér [param pos] pontján (a betűtípus alapvonalának bal szélén). A szöveg színét megszorozza a [param modulate] értékkel. Ha a [param width] legalább 0, a megadott szélességen túlnyúló szöveget levágja. Pozitív [param oversampling] esetén a megadott érték a betűtípus túlmintavételezési tényezője. Egyébként a nézetablak túlmintavételezési beállítása érvényes."

#. CanvasItem.draw_style_box
#: doc/classes/CanvasItem.xml
msgid "Draws a styled rectangle. The [param rect] is defined in local space.\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "Stílusozott téglalapot rajzol. A [param rect] a helyi térben értendő.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_texture
#: doc/classes/CanvasItem.xml
msgid "Draws a texture at a given position. The [param position] is defined in local space.\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "Textúrát rajzol a megadott helyre. A [param position] a helyi térben értendő.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_texture_rect
#: doc/classes/CanvasItem.xml
msgid "Draws a textured rectangle at a given position, optionally modulated by a color. The [param rect] is defined in local space. If [param transpose] is [code]true[/code], the texture will have its X and Y coordinates swapped. See also [method draw_rect] and [method draw_texture_rect_region].\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "Textúrázott téglalapot rajzol a megadott helyre, opcionális színezéssel. A [param rect] a helyi térben értendő. Ha a [param transpose] értéke [code]true[/code], a textúra X és Y koordinátája felcserélődik. Lásd még a [method draw_rect] és a [method draw_texture_rect_region] metódust.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.draw_texture_rect_region
#: doc/classes/CanvasItem.xml
msgid "Draws a textured rectangle from a texture's region (specified by [param src_rect]) at a given position in local space, optionally modulated by a color. If [param transpose] is [code]true[/code], the texture will have its X and Y coordinates swapped. See also [method draw_texture_rect].\n[b]Note:[/b] Styleboxes, textures, and meshes stored only inside local variables should [b]not[/b] be used with this method in GDScript, because the drawing operation doesn't begin immediately once this method is called. In GDScript, when the function with the local variables ends, the local variables get destroyed before the rendering takes place."
msgstr "A textúra [param src_rect] által megadott részéből rajzol téglalapot a megadott helyi pozícióra, opcionális színezéssel. Ha a [param transpose] értéke [code]true[/code], a textúra X és Y koordinátája felcserélődik. Lásd még a [method draw_texture_rect] metódust.\n[b]Megjegyzés:[/b] GDScriptben a metódussal [b]nem[/b] ajánlott kizárólag helyi változókban tárolt stílusdobozokat, textúrákat vagy hálókat használni. A rajzolás a hívás után később kezdődik, és a helyi változók a függvény befejezésekor megszűnnek, még a megjelenítés előtt."

#. CanvasItem.force_update_transform
#: doc/classes/CanvasItem.xml
msgid "Forces the node's transform to update. Fails if the node is not inside the tree. See also [method get_transform].\n[b]Note:[/b] For performance reasons, transform changes are usually accumulated and applied [i]once[/i] at the end of the frame. The update propagates through [CanvasItem] children, as well. Therefore, use this method only when you need an up-to-date transform (such as during physics operations)."
msgstr "Azonnal frissíti a csomópont transzformációját. Ha a csomópont nincs a fában, a művelet meghiúsul. Lásd még a [method get_transform] metódust.\n[b]Megjegyzés:[/b] Teljesítménybeli okokból a motor rendszerint összegyűjti a transzformáció módosításait, és a képkocka végén [i]egyszer[/i] alkalmazza őket. A frissítés a [CanvasItem] gyermekeken is végigterjed. Ezt a metódust akkor használd, ha azonnal szükséged van a friss transzformációra, például fizikai művelet közben."

#. CanvasItem.get_canvas
#: doc/classes/CanvasItem.xml
msgid "Returns the [RID] of the [World2D] canvas where this node is registered to, used by the [RenderingServer]."
msgstr "Visszaadja annak a [World2D] vászonnak a [RID] azonosítóját, amelyhez a csomópont regisztrálva van. Az azonosítót a [RenderingServer] használja."

#. CanvasItem.get_global_mouse_position
#: doc/classes/CanvasItem.xml
msgid "Returns mouse cursor's global position relative to the [CanvasLayer] that contains this node.\n[b]Note:[/b] For screen-space coordinates (e.g. when using a non-embedded [Popup]), you can use [method DisplayServer.mouse_get_position]."
msgstr "Visszaadja az egérmutató globális helyét a csomópontot tartalmazó [CanvasLayer] réteghez viszonyítva.\n[b]Megjegyzés:[/b] Képernyő-koordinátákhoz, például nem beágyazott [Popup] esetén, a [method DisplayServer.mouse_get_position] metódus használható."

#. CanvasItem.get_global_transform
#: doc/classes/CanvasItem.xml
msgid "Returns the global transform matrix of this item, i.e. the combined transform up to the topmost [CanvasItem] node. The topmost item is a [CanvasItem] that either has no parent, has non-[CanvasItem] parent or it has [member top_level] enabled."
msgstr "Visszaadja az elem globális transzformációs mátrixát, vagyis a legfelső [CanvasItem] csomópontig összevont transzformációt. A legfelső [CanvasItem] elemnek vagy nincs szülője, vagy a szülője nem [CanvasItem] típusú, vagy az elemen be van kapcsolva a [member top_level] tulajdonság."

#. CanvasItem.get_global_transform_with_canvas
#: doc/classes/CanvasItem.xml
msgid "Returns the transform from the local coordinate system of this [CanvasItem] to the [Viewport]s coordinate system."
msgstr "Visszaadja azt a transzformációt, amely a [CanvasItem] helyi koordináta-rendszeréből a [Viewport] koordináta-rendszerébe képez."

#. CanvasItem.get_instance_shader_parameter
#. GeometryInstance3D.get_instance_shader_parameter
#: doc/classes/CanvasItem.xml doc/classes/GeometryInstance3D.xml
msgid "Get the value of a shader parameter as set on this instance."
msgstr "Visszaadja az ezen a példányon beállított árnyalóparaméter értékét."

#. CanvasItem.get_screen_transform
#: doc/classes/CanvasItem.xml
msgid "Returns the transform of this [CanvasItem] in global screen coordinates (i.e. taking window position into account). Mostly useful for editor plugins.\nEquivalent to [method get_global_transform_with_canvas] if the window is embedded (see [member Viewport.gui_embed_subwindows])."
msgstr "Visszaadja a [CanvasItem] transzformációját globális képernyő-koordinátákban, az ablak helyét is figyelembe véve. Főként szerkesztőbővítményeknél hasznos.\nBeágyazott ablaknál egyenértékű a [method get_global_transform_with_canvas] metódussal (lásd: [member Viewport.gui_embed_subwindows])."

#. CanvasItem.get_viewport_transform
#: doc/classes/CanvasItem.xml
msgid "Returns the transform of this node, converted from its registered canvas's coordinate system to its viewport embedder's coordinate system. See also [method Viewport.get_final_transform] and [method Node.get_viewport]."
msgstr "A csomópont transzformációját adja vissza a vászna koordináta-rendszeréből a nézetablakot befogadó elem koordináta-rendszerébe átszámítva. Lásd még a [method Viewport.get_final_transform] és a [method Node.get_viewport] metódust."

#. CanvasItem.get_world_2d
#: doc/classes/CanvasItem.xml
msgid "Returns the [World2D] this node is registered to.\nUsually, this is the same as this node's viewport (see [method Node.get_viewport] and [method Viewport.find_world_2d])."
msgstr "Visszaadja azt a [World2D] világot, amelyhez a csomópont regisztrálva van.\nEz általában megegyezik a csomópont nézetablakához tartozó világgal (lásd: [method Node.get_viewport] és [method Viewport.find_world_2d])."

#. CanvasItem.is_local_transform_notification_enabled
#: doc/classes/CanvasItem.xml
msgid "Returns [code]true[/code] if the node receives [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] whenever its local transform changes. This is enabled with [method set_notify_local_transform]."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont a helyi transzformáció minden változásakor megkapja a [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] értesítést. Ezt a [method set_notify_local_transform] metódussal engedélyezheted."

#. CanvasItem.is_transform_notification_enabled
#: doc/classes/CanvasItem.xml
msgid "Returns [code]true[/code] if the node receives [constant NOTIFICATION_TRANSFORM_CHANGED] whenever its global transform changes. This is enabled with [method set_notify_transform]."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont a globális transzformáció minden változásakor megkapja a [constant NOTIFICATION_TRANSFORM_CHANGED] értesítést. Ezt a [method set_notify_transform] metódussal engedélyezheted."

#. CanvasItem.is_visible_in_tree
#: doc/classes/CanvasItem.xml
msgid "Returns [code]true[/code] if the node is present in the [SceneTree], its [member visible] property is [code]true[/code] and all its ancestors are also visible. If any ancestor is hidden, this node will not be visible in the scene tree, and is therefore not drawn (see [method _draw]).\nVisibility is checked only in parent nodes that inherit from [CanvasItem], [CanvasLayer], and [Window]. If the parent is of any other type (such as [Node], [AnimationPlayer], or [Node3D]), it is assumed to be visible.\n[b]Note:[/b] This method does not take [member visibility_layer] into account, so even if this method returns [code]true[/code], the node might end up not being rendered."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont a [SceneTree] jelenetfában van, a [member visible] értéke [code]true[/code], és a felmenői is láthatók. Ha bármely felmenő rejtett, a csomópont nem lesz látható a jelenetfában, így nem rajzolódik ki (lásd: [method _draw]).\nA motor csak a [CanvasItem], [CanvasLayer] vagy [Window] osztályból származó szülők láthatóságát ellenőrzi. Más típusú szülőt, például [Node], [AnimationPlayer] vagy [Node3D] csomópontot láthatónak tekint.\n[b]Megjegyzés:[/b] A metódus figyelmen kívül hagyja a [member visibility_layer] értékét, ezért [code]true[/code] eredmény mellett is előfordulhat, hogy a motor nem rajzolja ki a csomópontot."

#. CanvasItem.make_canvas_position_local
#: doc/classes/CanvasItem.xml
msgid "Transforms [param viewport_point] from the viewport's coordinates to this node's local coordinates.\nFor the opposite operation, use [method get_global_transform_with_canvas].\n[codeblock]\nvar viewport_point = get_global_transform_with_canvas() * local_point\n[/codeblock]"
msgstr "A [param viewport_point] pontot a nézetablak koordinátáiból a csomópont helyi koordinátáiba alakítja.\nA fordított művelethez használd a [method get_global_transform_with_canvas] metódust.\n[codeblock]\nvar viewport_point = get_global_transform_with_canvas() * local_point\n[/codeblock]"

#. CanvasItem.queue_redraw
#: doc/classes/CanvasItem.xml
msgid "Queues the [CanvasItem] to redraw. During idle time, if [CanvasItem] is visible, [constant NOTIFICATION_DRAW] is sent and [method _draw] is called. This only occurs [b]once[/b] per frame, even if this method has been called multiple times."
msgstr "Újrarajzolásra jelöli a [CanvasItem] elemet. Ha a [CanvasItem] látható, a motor üresjáratban elküldi a [constant NOTIFICATION_DRAW] értesítést és meghívja a [method _draw] metódust. Egy képkockán ez csak [b]egyszer[/b] történik meg, akárhányszor hívják meg a metódust."

#. CanvasItem.set_instance_shader_parameter
#: doc/classes/CanvasItem.xml
msgid "Set the value of a shader uniform for this instance only ([url=$DOCS_URL/tutorials/shaders/shader_reference/shading_language.html#per-instance-uniforms]per-instance uniform[/url]). See also [method ShaderMaterial.set_shader_parameter] to assign a uniform on all instances using the same [ShaderMaterial].\n[b]Note:[/b] For a shader uniform to be assignable on a per-instance basis, it [i]must[/i] be defined with [code]instance uniform ...[/code] rather than [code]uniform ...[/code] in the shader code.\n[b]Note:[/b] [param name] is case-sensitive and must match the name of the uniform in the code exactly (not the capitalized name in the inspector)."
msgstr "Csak ezen a példányon állít be egy uniform árnyalóparamétert ([url=$DOCS_URL/tutorials/shaders/shader_reference/shading_language.html#per-instance-uniforms]példányonkénti uniform[/url]). Ha az azonos [ShaderMaterial] anyagot használó összes példányhoz szeretnél értéket rendelni, lásd a [method ShaderMaterial.set_shader_parameter] metódust.\n[b]Megjegyzés:[/b] A példányonkénti beállításhoz az uniform paramétert [i]kötelező[/i] [code]instance uniform ...[/code] alakban deklarálni a [code]uniform ...[/code] helyett.\n[b]Megjegyzés:[/b] A [param name] kis- és nagybetűérzékeny, és pontosan egyeznie kell az uniform paraméter kódbeli nevével. A Tulajdonságvizsgálóban megjelenő felirat eltérhet ettől."

#. CanvasItem.set_notify_local_transform
#: doc/classes/CanvasItem.xml
msgid "If [code]true[/code], the node will receive [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] whenever its local transform changes.\n[b]Note:[/b] Many canvas items such as [Bone2D] or [CollisionShape2D] automatically enable this in order to function correctly."
msgstr "[code]true[/code] értéknél a csomópont a helyi transzformáció minden változásakor megkapja a [constant NOTIFICATION_LOCAL_TRANSFORM_CHANGED] értesítést.\n[b]Megjegyzés:[/b] Számos vászonelem, például a [Bone2D] és a [CollisionShape2D], automatikusan engedélyezi ezt a helyes működéshez."

#. CanvasItem.set_notify_transform
#: doc/classes/CanvasItem.xml
msgid "If [code]true[/code], the node will receive [constant NOTIFICATION_TRANSFORM_CHANGED] whenever its global transform changes.\n[b]Note:[/b] Many canvas items such as [Camera2D] or [Light2D] automatically enable this in order to function correctly."
msgstr "[code]true[/code] értéknél a csomópont a globális transzformáció minden változásakor megkapja a [constant NOTIFICATION_TRANSFORM_CHANGED] értesítést.\n[b]Megjegyzés:[/b] Számos vászonelem, például a [Camera2D] és a [Light2D], automatikusan engedélyezi ezt a helyes működéshez."

#. CanvasItem.draw
#: doc/classes/CanvasItem.xml
msgid "Emitted when the [CanvasItem] must redraw, [i]after[/i] the related [constant NOTIFICATION_DRAW] notification, and [i]before[/i] [method _draw] is called.\n[b]Note:[/b] Deferred connections do not allow drawing through the [code]draw_*[/code] methods."
msgstr "Akkor küldi el, amikor a [CanvasItem] elemet újra kell rajzolni, a kapcsolódó [constant NOTIFICATION_DRAW] értesítés [i]után[/i], de még a [method _draw] hívása [i]előtt[/i].\n[b]Megjegyzés:[/b] Késleltetett kapcsolatoknál a [code]draw_*[/code] metódusokkal nem lehet rajzolni."

#. CanvasItem.hidden
#: doc/classes/CanvasItem.xml
msgid "Emitted when this node becomes hidden, i.e. it's no longer visible in the tree (see [method is_visible_in_tree])."
msgstr "Akkor küldi el, amikor a csomópont rejtetté válik, vagyis már nem látható a fában (lásd: [method is_visible_in_tree])."

#. CanvasItem.item_rect_changed
#: doc/classes/CanvasItem.xml
msgid "Emitted when the [CanvasItem]'s boundaries (position or size) change, or when an action took place that may have affected these boundaries (e.g. changing [member Sprite2D.texture])."
msgstr "Akkor küldi el, amikor a [CanvasItem] határai (a helye vagy a mérete) változnak, illetve ha olyan művelet történik, amely megváltoztathatta ezeket, például a [member Sprite2D.texture] módosítása."

#. CanvasItem.visibility_changed
#: doc/classes/CanvasItem.xml
msgid "Emitted when the [CanvasItem]'s visibility changes, either because its own [member visible] property changed or because its visibility in the tree changed (see [method is_visible_in_tree]).\nThis signal is emitted [i]after[/i] the related [constant NOTIFICATION_VISIBILITY_CHANGED] notification."
msgstr "Akkor küldi el, amikor megváltozik a [CanvasItem] láthatósága a saját [member visible] tulajdonsága vagy a fán belüli láthatósága miatt (lásd: [method is_visible_in_tree]).\nA jelzést a kapcsolódó [constant NOTIFICATION_VISIBILITY_CHANGED] értesítés [i]után[/i] küldi el."

#. CanvasItem.clip_children
#: doc/classes/CanvasItem.xml
msgid "The mode in which this node clips its children, acting as a mask.\n[b]Note:[/b] Clipping nodes cannot be nested or placed within a [CanvasGroup]. If an ancestor of this node clips its children or is a [CanvasGroup], then this node's clip mode should be set to [constant CLIP_CHILDREN_DISABLED] to avoid unexpected behavior."
msgstr "Megadja, hogyan vágja le a csomópont a gyermekeit maszkként.\n[b]Megjegyzés:[/b] A vágást végző csomópontok nem ágyazhatók egymásba, és nem kerülhetnek [CanvasGroup] alá. Ha valamelyik felmenő levágja a gyermekeit vagy [CanvasGroup] típusú, a váratlan viselkedés elkerüléséhez állítsd ennek a csomópontnak a módját [constant CLIP_CHILDREN_DISABLED] értékre."

#. CanvasItem.oversampling_with_scale
#: doc/classes/CanvasItem.xml
msgid "If enabled, oversampling for this [CanvasItem] is automatically adjusted with scale."
msgstr "Bekapcsolva a [CanvasItem] túlmintavételezése automatikusan követi a méretezést."

#. CanvasItem.show_behind_parent
#: doc/classes/CanvasItem.xml
msgid "If [code]true[/code], this node draws behind its parent."
msgstr "Ha az értéke [code]true[/code], a motor a csomópontot a szülője mögé rajzolja."

#. CanvasItem.texture_filter
#: doc/classes/CanvasItem.xml
msgid "The filtering mode used to render this [CanvasItem]'s texture(s)."
msgstr "A [CanvasItem] textúráinak megjelenítésekor használt szűrési mód."

#. CanvasItem.texture_repeat
#: doc/classes/CanvasItem.xml
msgid "The repeating mode used to render this [CanvasItem]'s texture(s). It affects what happens when the texture is sampled outside its extents, for example by setting a [member Sprite2D.region_rect] that is larger than the texture or assigning [Polygon2D] UV points outside the texture.\n[b]Note:[/b] [TextureRect] is not affected by [member texture_repeat], as it uses its own texture repeating implementation."
msgstr "A [CanvasItem] textúráinak megjelenítésekor használt ismétlési mód. Megadja, mi történik a textúra határain kívüli mintavételezéskor, például ha a [member Sprite2D.region_rect] nagyobb a textúránál, vagy a [Polygon2D] UV-pontjai a textúrán kívülre esnek.\n[b]Megjegyzés:[/b] A [TextureRect] saját textúraismétlést használ, ezért a [member texture_repeat] nincs rá hatással."

#. CanvasItem.top_level
#: doc/classes/CanvasItem.xml
msgid "If [code]true[/code], this [CanvasItem] will [i]not[/i] inherit its transform from parent [CanvasItem]s. Its draw order will also be changed to make it draw on top of other [CanvasItem]s that do not have [member top_level] set to [code]true[/code]. The [CanvasItem] will effectively act as if it was placed as a child of a bare [Node]."
msgstr "[code]true[/code] értéknél ez a [CanvasItem] [i]nem[/i] örökli a szülő [CanvasItem] csomópontok transzformációját. A rajzolási sorrendje is megváltozik, így az olyan [CanvasItem] elemek elé kerül, amelyeknél a [member top_level] nem [code]true[/code]. A [CanvasItem] úgy viselkedik, mintha egy egyszerű [Node] gyermeke lenne."

#. CanvasItem.use_parent_material
#: doc/classes/CanvasItem.xml
msgid "If [code]true[/code], the parent [CanvasItem]'s [member material] is used as this node's material."
msgstr "Ha az értéke [code]true[/code], a csomópont a szülő [CanvasItem] [member material] anyagát használja."

#. CanvasItem.visibility_layer
#: doc/classes/CanvasItem.xml
msgid "The rendering layer in which this [CanvasItem] is rendered by [Viewport] nodes. A [Viewport] will render a [CanvasItem] if it and all its parents share a layer with the [Viewport]'s canvas cull mask.\n[b]Note:[/b] A [CanvasItem] does not inherit its parents' visibility layers. This means that if a parent [CanvasItem] does not have all the same layers as its child, the child may not be visible even if both the parent and child have [member visible] set to [code]true[/code]. For example, if a parent has layer 1 and a child has layer 2, the child will not be visible in a [Viewport] with the canvas cull mask set to layer 1 or 2 (see [member Viewport.canvas_cull_mask]). To ensure that both the parent and child are visible, the parent must have both layers 1 and 2, or the child must have [member top_level] set to [code]true[/code]."
msgstr "A [Viewport] csomópontok ezen a megjelenítési rétegen rajzolják ki a [CanvasItem] elemet. Egy [Viewport] akkor rajzolja ki a [CanvasItem] elemet, ha az elem és minden szülője osztozik egy-egy rétegen a [Viewport] vászonszűrési maszkjával.\n[b]Megjegyzés:[/b] A [CanvasItem] nem örökli a szülők láthatósági rétegeit. Ha a szülő [CanvasItem] és a gyermeke rétegei eltérnek, a gyermek akkor is rejtve maradhat, ha mindkettő [member visible] értéke [code]true[/code]. Ha például a szülő az 1. rétegen, a gyermek a 2. rétegen van, a gyermek nem látható olyan [Viewport] nézetablakban, amelynek vászonszűrési maszkjában csak az 1. vagy csak a 2. réteg van beállítva (lásd: [member Viewport.canvas_cull_mask]). Ha mindkettőnek látszania kell, a szülő az 1. és a 2. réteget is használja, vagy a gyermek [member top_level] értéke legyen [code]true[/code]."

#. CanvasItem.y_sort_enabled
#: doc/classes/CanvasItem.xml
msgid "If [code]true[/code], this and child [CanvasItem] nodes with a higher Y position are rendered in front of nodes with a lower Y position. If [code]false[/code], this and child [CanvasItem] nodes are rendered normally in scene tree order.\nWith Y-sorting enabled on a parent node ('A') but disabled on a child node ('B'), the child node ('B') is sorted but its children ('C1', 'C2', etc.) render together on the same Y position as the child node ('B'). This allows you to organize the render order of a scene without changing the scene tree.\nNodes sort relative to each other only if they are on the same [member z_index]."
msgstr "[code]true[/code] értéknél ez a csomópont és a gyermek [CanvasItem] csomópontok Y helyzetük szerint rendeződnek. A nagyobb Y értékűek a kisebb Y értékűek elé kerülnek. [code]false[/code] értéknél ez a csomópont és a gyermek [CanvasItem] csomópontok a jelenetfa sorrendjében jelennek meg.\nHa az A szülőn be van kapcsolva az Y szerinti rendezés, a B gyermekén pedig ki van kapcsolva, B rendezésre kerül, de a gyermekei (C1, C2 stb.) vele együtt, B Y pozícióján jelennek meg. Így a jelenet megjelenítési sorrendje a jelenetfa módosítása nélkül alakítható.\nA csomópontok csak azonos [member z_index] mellett rendeződnek egymáshoz képest."

#. CanvasItem.z_as_relative
#: doc/classes/CanvasItem.xml
msgid "If [code]true[/code], this node's final Z index is relative to its parent's Z index.\nFor example, if [member z_index] is [code]2[/code] and its parent's final Z index is [code]3[/code], then this node's final Z index will be [code]5[/code] ([code]2 + 3[/code])."
msgstr "[code]true[/code] értéknél a csomópont végső Z-indexe a szülő Z-indexéhez viszonyított.\nHa például a [member z_index] értéke [code]2[/code], a szülő végső Z-indexe pedig [code]3[/code], akkor a csomópont végső Z-indexe [code]5[/code] ([code]2 + 3[/code])."

#. CanvasItem.z_index
#: doc/classes/CanvasItem.xml
msgid "The order in which this node is drawn. A node with a higher Z index will display in front of others. Must be between [constant RenderingServer.CANVAS_ITEM_Z_MIN] and [constant RenderingServer.CANVAS_ITEM_Z_MAX] (inclusive).\n[b]Note:[/b] The Z index does [b]not[/b] affect the order in which [CanvasItem] nodes are processed or the way input events are handled. This is especially important to keep in mind for [Control] nodes."
msgstr "A csomópont kirajzolási sorrendje. Nagyobb Z-indexnél a csomópont a többi elé kerül. Az érték a [constant RenderingServer.CANVAS_ITEM_Z_MIN] és a [constant RenderingServer.CANVAS_ITEM_Z_MAX] közé eshet, a határértékeket is beleértve.\n[b]Megjegyzés:[/b] A Z-index [b]nem[/b] hat a [CanvasItem] csomópontok feldolgozási sorrendjére vagy a bemeneti események kezelésére. Ez különösen fontos a [Control] csomópontoknál."

#. CanvasItem.NOTIFICATION_TRANSFORM_CHANGED
#: doc/classes/CanvasItem.xml
msgid "Notification received when this node's global transform changes, if [method is_transform_notification_enabled] is [code]true[/code]. See also [method set_notify_transform] and [method get_transform].\n[b]Note:[/b] Many canvas items such as [Camera2D] or [CollisionObject2D] automatically enable this in order to function correctly."
msgstr "A csomópont globális transzformációjának változásakor érkezik, ha a [method is_transform_notification_enabled] [code]true[/code] értéket ad vissza. Lásd még a [method set_notify_transform] és a [method get_transform] metódust.\n[b]Megjegyzés:[/b] Számos vászonelem, például a [Camera2D] vagy a [CollisionObject2D], automatikusan engedélyezi ezt a helyes működéshez."

#. CanvasItem.NOTIFICATION_LOCAL_TRANSFORM_CHANGED
#: doc/classes/CanvasItem.xml
msgid "Notification received when this node's transform changes, if [method is_local_transform_notification_enabled] is [code]true[/code]. This is not received when a parent [Node2D]'s transform changes. See also [method set_notify_local_transform].\n[b]Note:[/b] Many canvas items such as [Camera2D] or [CollisionShape2D] automatically enable this in order to function correctly."
msgstr "A csomópont helyi transzformációjának változásakor érkezik, ha a [method is_local_transform_notification_enabled] [code]true[/code] értéket ad vissza. A szülő [Node2D] transzformációjának változása ezt nem váltja ki. Lásd még a [method set_notify_local_transform] metódust.\n[b]Megjegyzés:[/b] Számos vászonelem, például a [Camera2D] vagy a [CollisionShape2D], automatikusan engedélyezi ezt a helyes működéshez."

#. CanvasItem.NOTIFICATION_DRAW
#: doc/classes/CanvasItem.xml
msgid "The [CanvasItem] is requested to draw (see [method _draw])."
msgstr "A motor a [CanvasItem] kirajzolását kéri (lásd: [method _draw])."

#. CanvasItem.NOTIFICATION_VISIBILITY_CHANGED
#. Node3D.NOTIFICATION_VISIBILITY_CHANGED
#: doc/classes/CanvasItem.xml doc/classes/Node3D.xml
msgid "Notification received when this node's visibility changes (see [member visible] and [method is_visible_in_tree]).\nThis notification is received [i]before[/i] the related [signal visibility_changed] signal."
msgstr "A csomópont láthatóságának megváltozásakor érkezik (lásd: [member visible] és [method is_visible_in_tree]).\nA kapcsolódó [signal visibility_changed] jelzés [i]előtt[/i] érkezik."

#. CanvasItem.NOTIFICATION_ENTER_CANVAS
#: doc/classes/CanvasItem.xml
msgid "The [CanvasItem] has entered the canvas."
msgstr "A [CanvasItem] belépett a vászonra."

#. CanvasItem.NOTIFICATION_EXIT_CANVAS
#: doc/classes/CanvasItem.xml
msgid "The [CanvasItem] has exited the canvas.\nThis notification is sent in reversed order."
msgstr "A [CanvasItem] kilépett a vászonról.\nEzt az értesítést fordított sorrendben küldi a motor."

#. CanvasItem.NOTIFICATION_WORLD_2D_CHANGED
#: doc/classes/CanvasItem.xml
msgid "Notification received when this [CanvasItem] is registered to a new [World2D] (see [method get_world_2d])."
msgstr "Akkor érkezik, amikor ezt a [CanvasItem] elemet új [World2D] világhoz regisztrálják (lásd: [method get_world_2d])."

#. CanvasItem.TEXTURE_FILTER_PARENT_NODE
#: doc/classes/CanvasItem.xml
msgid "The [CanvasItem] will inherit the filter from its parent."
msgstr "A [CanvasItem] a szülőjétől örökli a szűrési módot."

#. CanvasItem.TEXTURE_FILTER_NEAREST_WITH_MIPMAPS
#. RenderingServer.CANVAS_ITEM_TEXTURE_FILTER_NEAREST_WITH_MIPMAPS
#. Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST_WITH_MIPMAPS
#. VisualShaderNodeTextureParameter.FILTER_NEAREST_MIPMAP
#: doc/classes/CanvasItem.xml doc/classes/RenderingServer.xml doc/classes/Viewport.xml modules/visual_shader/doc_classes/VisualShaderNodeTextureParameter.xml
msgid "The texture filter reads from the nearest pixel and blends between the nearest 2 mipmaps (or uses the nearest mipmap if [member ProjectSettings.rendering/textures/default_filters/use_nearest_mipmap_filter] is [code]true[/code]). This makes the texture look pixelated from up close, and smooth from a distance.\nUse this for non-pixel art textures that may be viewed at a low scale (e.g. due to [Camera2D] zoom or sprite scaling), as mipmaps are important to smooth out pixels that are smaller than on-screen pixels."
msgstr "A textúraszűrő a legközelebbi képpontot mintavételezi, és a 2 legközelebbi mipmap között kever. Ha a [member ProjectSettings.rendering/textures/default_filters/use_nearest_mipmap_filter] értéke [code]true[/code], a legközelebbi mipmapet használja. Így a textúra közelről pixeles, távolról sima.\nKicsiben is megjelenő, nem pixel art textúrákhoz használható, például [Camera2D] nagyítása vagy sprite-méretezés esetén. A mipmapek simítják a képernyő egy képpontjánál kisebbre méretezett textúraképpontokat."

#. CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
#. RenderingServer.CANVAS_ITEM_TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
#. Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
#. VisualShaderNodeTextureParameter.FILTER_LINEAR_MIPMAP
#: doc/classes/CanvasItem.xml doc/classes/RenderingServer.xml doc/classes/Viewport.xml modules/visual_shader/doc_classes/VisualShaderNodeTextureParameter.xml
msgid "The texture filter blends between the nearest 4 pixels and between the nearest 2 mipmaps (or uses the nearest mipmap if [member ProjectSettings.rendering/textures/default_filters/use_nearest_mipmap_filter] is [code]true[/code]). This makes the texture look smooth from up close, and smooth from a distance.\nUse this for non-pixel art textures that may be viewed at a low scale (e.g. due to [Camera2D] zoom or sprite scaling), as mipmaps are important to smooth out pixels that are smaller than on-screen pixels."
msgstr "A textúraszűrő a 4 legközelebbi képpont és a 2 legközelebbi mipmap között kever. Ha a [member ProjectSettings.rendering/textures/default_filters/use_nearest_mipmap_filter] értéke [code]true[/code], a legközelebbi mipmapet használja. Így a textúra közelről és távolról is sima.\nKicsiben is megjelenő, nem pixel art textúrákhoz használható, például [Camera2D] nagyítása vagy sprite-méretezés esetén. A mipmapek simítják a képernyő egy képpontjánál kisebbre méretezett textúraképpontokat."

#. CanvasItem.TEXTURE_FILTER_NEAREST_WITH_MIPMAPS_ANISOTROPIC
#: doc/classes/CanvasItem.xml
msgid "The texture filter reads from the nearest pixel and blends between 2 mipmaps (or uses the nearest mipmap if [member ProjectSettings.rendering/textures/default_filters/use_nearest_mipmap_filter] is [code]true[/code]) based on the angle between the surface and the camera view. This makes the texture look pixelated from up close, and smooth from a distance. Anisotropic filtering improves texture quality on surfaces that are almost in line with the camera, but is slightly slower. The anisotropic filtering level can be changed by adjusting [member ProjectSettings.rendering/textures/default_filters/anisotropic_filtering_level].\n[b]Note:[/b] This texture filter is rarely useful in 2D projects. [constant TEXTURE_FILTER_NEAREST_WITH_MIPMAPS] is usually more appropriate in this case."
msgstr "A textúraszűrő a legközelebbi képpontot mintavételezi, és a felület és a kamera nézési iránya közötti szög alapján 2 mipmap között kever. Ha a [member ProjectSettings.rendering/textures/default_filters/use_nearest_mipmap_filter] értéke [code]true[/code], a legközelebbi mipmapet használja. Így a textúra közelről pixeles, távolról sima. Az anizotrop szűrés jobb textúraminőséget ad a kamera nézési irányával majdnem párhuzamos felületeken, de kissé lassabb. A szűrési fokozatot a [member ProjectSettings.rendering/textures/default_filters/anisotropic_filtering_level] beállítással adhatod meg.\n[b]Megjegyzés:[/b] Ez a szűrő 2D projektekben ritkán hasznos. Oda általában a [constant TEXTURE_FILTER_NEAREST_WITH_MIPMAPS] illik jobban."

#. CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
#: doc/classes/CanvasItem.xml
msgid "The texture filter blends between the nearest 4 pixels and blends between 2 mipmaps (or uses the nearest mipmap if [member ProjectSettings.rendering/textures/default_filters/use_nearest_mipmap_filter] is [code]true[/code]) based on the angle between the surface and the camera view. This makes the texture look smooth from up close, and smooth from a distance. Anisotropic filtering improves texture quality on surfaces that are almost in line with the camera, but is slightly slower. The anisotropic filtering level can be changed by adjusting [member ProjectSettings.rendering/textures/default_filters/anisotropic_filtering_level].\n[b]Note:[/b] This texture filter is rarely useful in 2D projects. [constant TEXTURE_FILTER_LINEAR_WITH_MIPMAPS] is usually more appropriate in this case."
msgstr "A textúraszűrő a 4 legközelebbi képpont között kever, és a felület és a kamera nézési iránya közötti szög alapján 2 mipmap között is kever. Ha a [member ProjectSettings.rendering/textures/default_filters/use_nearest_mipmap_filter] értéke [code]true[/code], a legközelebbi mipmapet használja. Így a textúra közelről és távolról is sima. Az anizotrop szűrés jobb textúraminőséget ad a kamera nézési irányával majdnem párhuzamos felületeken, de kissé lassabb. A szűrési fokozatot a [member ProjectSettings.rendering/textures/default_filters/anisotropic_filtering_level] beállítással adhatod meg.\n[b]Megjegyzés:[/b] Ez a szűrő 2D projektekben ritkán hasznos. Oda általában a [constant TEXTURE_FILTER_LINEAR_WITH_MIPMAPS] illik jobban."

#. CanvasItem.TEXTURE_REPEAT_PARENT_NODE
#: doc/classes/CanvasItem.xml
msgid "The [CanvasItem] will inherit the repeat mode from its parent."
msgstr "A [CanvasItem] a szülőjétől örökli az ismétlési módot."

#. CanvasItem.TEXTURE_REPEAT_DISABLED
#: doc/classes/CanvasItem.xml
msgid "The texture does not repeat. Sampling the texture outside its extents will result in \"stretching\" of the edge pixels. You can avoid this by ensuring a 1-pixel fully transparent border on each side of the texture."
msgstr "A textúra nem ismétlődik. A határain kívüli mintavételezéskor a szélső képpontok megnyúlnak. Ez elkerülhető, ha a textúra minden oldalán 1 képpontnyi teljesen átlátszó keret van."

#. CanvasItem.TEXTURE_REPEAT_ENABLED
#: doc/classes/CanvasItem.xml
msgid "The texture repeats when exceeding the texture's size."
msgstr "A textúra a méretén túl ismétlődik."

#. CanvasItem.TEXTURE_REPEAT_MIRROR
#: doc/classes/CanvasItem.xml
msgid "The texture repeats when the exceeding the texture's size in a \"2×2 tiled mode\". Repeated textures at even positions are mirrored."
msgstr "A textúra a méretén túl 2×2-es csempézéssel ismétlődik. A páros helyeken lévő ismétlések tükrözve jelennek meg."

#. CanvasItem.TEXTURE_REPEAT_MAX
#. VisualShaderNodeTextureParameter.REPEAT_MAX
#: doc/classes/CanvasItem.xml modules/visual_shader/doc_classes/VisualShaderNodeTextureParameter.xml
msgid "Represents the size of the [enum TextureRepeat] enum."
msgstr "A [enum TextureRepeat] felsorolás méretét jelöli."

#. CanvasItem.CLIP_CHILDREN_DISABLED
#: doc/classes/CanvasItem.xml
msgid "Children are drawn over this node and are not clipped."
msgstr "A gyermekek a csomópont elé rajzolódnak, vágás nélkül."

#. CanvasItem.CLIP_CHILDREN_ONLY
#: doc/classes/CanvasItem.xml
msgid "This node is used as a mask and is [b]not[/b] drawn. The mask is based on this node's alpha channel: Opaque pixels are kept, transparent pixels are discarded, and semi-transparent pixels are blended in according to their opacity. Children are clipped to this node's drawn area."
msgstr "Ez a csomópont maszkként működik, és önmaga [b]nem[/b] rajzolódik ki. A maszk a csomópont alfacsatornáján alapul. A fedő képpontokat megtartja, az átlátszó képpontokat eldobja, a részben átlátszóakat pedig a fedettségük arányában keveri. A gyermekek a csomópont kirajzolt területére korlátozódnak."

#. CanvasItem.CLIP_CHILDREN_AND_DRAW
#: doc/classes/CanvasItem.xml
msgid "This node is used as a mask and is also drawn. The mask is based on this node's alpha channel: Opaque pixels are kept, transparent pixels are discarded, and semi-transparent pixels are blended in according to their opacity. Children are clipped to the parent's drawn area."
msgstr "Ez a csomópont maszkként működik, és önmaga is kirajzolódik. A maszk a csomópont alfacsatornáján alapul. A fedő képpontokat megtartja, az átlátszó képpontokat eldobja, a részben átlátszóakat pedig a fedettségük arányában keveri. A gyermekek a szülő kirajzolt területére korlátozódnak."

#. CanvasItem.CLIP_CHILDREN_MAX
#: doc/classes/CanvasItem.xml
msgid "Represents the size of the [enum ClipChildrenMode] enum."
msgstr "A [enum ClipChildrenMode] felsorolás méretét jelöli."

#. CanvasItem.OVERSAMPLING_WITH_SCALE_PARENT_NODE
#: doc/classes/CanvasItem.xml
msgid "The [CanvasItem] will inherit the oversampling mode from its parent."
msgstr "A [CanvasItem] a szülőjétől örökli a túlmintavételezési módot."

#. CanvasItem.OVERSAMPLING_WITH_SCALE_DISABLED
#: doc/classes/CanvasItem.xml
msgid "The oversampling is not affected by [CanvasItem] scale, and is equal to the [Viewport] oversampling."
msgstr "A [CanvasItem] méretezése nem befolyásolja a túlmintavételezést, amely megegyezik a [Viewport] túlmintavételezésével."

#. CanvasItem.OVERSAMPLING_WITH_SCALE_ENABLED
#: doc/classes/CanvasItem.xml
msgid "The oversampling is a product of [CanvasItem] scale and [Viewport] oversampling."
msgstr "A túlmintavételezés a [CanvasItem] méretezésének és a [Viewport] túlmintavételezésének szorzata."

#. CanvasItem.OVERSAMPLING_WITH_SCALE_MAX
#: doc/classes/CanvasItem.xml
msgid "Represents the size of the [enum OversamplingWithScale] enum."
msgstr "A [enum OversamplingWithScale] felsorolás méretét jelöli."

#. Node.brief
#: doc/classes/Node.xml
msgid "Base class for all scene objects."
msgstr "A jelenetobjektumok alaposztálya."

#. Node.call_thread_safe
#: doc/classes/Node.xml
msgid "This function ensures that the calling of this function will succeed, no matter whether it's being done from a thread or not. If called from a thread that is not allowed to call the function, the call will become deferred. Otherwise, the call will go through directly."
msgstr "Biztosítja, hogy a metódus hívása attól függetlenül sikerüljön, hogy melyik szálról indítják. Ha a szál nem jogosult a metódus meghívására, a hívást késlelteti. Egyébként közvetlenül végrehajtja."

#. Node.get_last_exclusive_window
#: doc/classes/Node.xml
msgid "Returns the [Window] that contains this node, or the last exclusive child in a chain of windows starting with the one that contains this node."
msgstr "Visszaadja az ezt a csomópontot tartalmazó [Window] ablakot, vagy az abból induló ablaklánc utolsó kizárólagos gyermekét."

#. Node.get_window
#: doc/classes/Node.xml
msgid "Returns the [Window] that contains this node. If the node is in the main window, this is equivalent to getting the root node ([code]get_tree().get_root()[/code])."
msgstr "Visszaadja a csomópontot tartalmazó [Window] ablakot. Ha a csomópont a főablakban van, a művelet egyenértékű a gyökércsomópont lekérésével ([code]get_tree().get_root()[/code])."

#. Node.replace_by
#: doc/classes/Node.xml
msgid "Replaces this node by the given [param node]. All children of this node are moved to [param node].\nIf [param keep_groups] is [code]true[/code], the [param node] is added to the same groups that the replaced node is in (see [method add_to_group]).\n[b]Warning:[/b] The replaced node is removed from the tree, but it is [b]not[/b] deleted. To prevent memory leaks, store a reference to the node in a variable, or use [method Object.free]."
msgstr "Lecseréli ezt a csomópontot a megadott [param node] csomópontra. A csomópont minden gyermeke a [param node] alá kerül.\nHa a [param keep_groups] értéke [code]true[/code], a [param node] ugyanazokhoz a csoportokhoz csatlakozik, amelyeknek a lecserélt csomópont tagja volt (lásd: [method add_to_group]).\n[b]Figyelmeztetés:[/b] A lecserélt csomópont kikerül a fából, de [b]nem[/b] törlődik. A memóriaszivárgás elkerüléséhez őrizz rá hivatkozást egy változóban, vagy hívd meg a [method Object.free] metódust."

#. Node.request_ready
#: doc/classes/Node.xml
msgid "Requests [method _ready] to be called again the next time the node enters the tree. Does [b]not[/b] immediately call [method _ready].\n[b]Note:[/b] This method only affects the current node. If the node's children also need to request ready, this method needs to be called for each one of them. When the node and its children enter the tree again, the order of [method _ready] callbacks will be the same as normal."
msgstr "Újból kéri a [method _ready] meghívását, amikor a csomópont legközelebb belép a fába. A hívás [b]nem[/b] futtatja azonnal a [method _ready] metódust.\n[b]Megjegyzés:[/b] A metódus csak az aktuális csomópontra hat. Ha a gyermekcsomópontokon is újból le kell futnia az inicializálásnak, mindegyiken külön hívd meg ezt a metódust. A csomópont és gyermekei újabb belépésekor a [method _ready] visszahívások sorrendje a szokásos marad."

#. Node.reset_physics_interpolation
#: doc/classes/Node.xml
msgid "When physics interpolation is active, moving a node to a radically different transform (such as placement within a level) can result in a visible glitch as the object is rendered moving from the old to new position over the physics tick.\nThat glitch can be prevented by calling this method, which temporarily disables interpolation until the physics tick is complete.\nThe notification [constant NOTIFICATION_RESET_PHYSICS_INTERPOLATION] will be received by the node and all children recursively.\n[b]Note:[/b] This function should be called [b]after[/b] moving the node, rather than before."
msgstr "Bekapcsolt fizikai interpolációnál, ha a csomópont transzformációja nagyot változik, például amikor elhelyezed egy pályán, az objektum a következő fizikai lépés alatt látszólag elmozdul a régi helyéről az újra.\nA metódus hívásával ez a megjelenítési hiba elkerülhető, mert ideiglenesen kikapcsolja az interpolációt, amíg a fizikai lépés be nem fejeződik.\nA csomópont és az összes leszármazottja rekurzívan megkapja a [constant NOTIFICATION_RESET_PHYSICS_INTERPOLATION] értesítést.\n[b]Megjegyzés:[/b] A metódust az áthelyezés [b]után[/b] hívd meg."

#. InstancePlaceholder.brief
#: doc/classes/InstancePlaceholder.xml
msgid "Placeholder for the root [Node] of a [PackedScene]."
msgstr "Egy [PackedScene] gyökércsomópontjának ([Node]) helyőrzője."

#. InstancePlaceholder.description
#: doc/classes/InstancePlaceholder.xml
msgid "Turning on the option [b]Load As Placeholder[/b] for an instantiated scene in the editor causes it to be replaced by an [InstancePlaceholder] when running the game, this will not replace the node in the editor. This makes it possible to delay actually loading the scene until calling [method create_instance]. This is useful to avoid loading large scenes all at once by loading parts of it selectively.\n[b]Note:[/b] Like [Node], [InstancePlaceholder] does not have a transform. This causes any child nodes to be positioned relatively to the [Viewport] origin, rather than their parent as displayed in the editor. Replacing the placeholder with a scene with a transform will transform children relatively to their parent again."
msgstr "Ha a szerkesztőben egy példányosított jeleneten bekapcsolod a [b]Load As Placeholder[/b] (betöltés helyőrzőként) beállítást, a játék indításakor a jelenet helyére [InstancePlaceholder] kerül. A szerkesztőben az eredeti csomópont marad. A tényleges betöltés így a [method create_instance] hívásáig halasztható. Nagy jeleneteknél hasznos, ha a részeket külön-külön szeretnéd betölteni.\n[b]Megjegyzés:[/b] A [Node] csomóponthoz hasonlóan az [InstancePlaceholder] nem rendelkezik transzformációval. Emiatt gyermekei a [Viewport] origójához viszonyítva helyezkednek el, míg a szerkesztőben a szülőjükhöz viszonyítva látszanak. Ha a helyőrzőt transzformációval rendelkező jelenetre cseréled, a gyermekek ismét a szülőjükhöz viszonyulnak."

#. InstancePlaceholder.create_instance
#: doc/classes/InstancePlaceholder.xml
msgid "Call this method to actually load in the node. The created node will be placed as a sibling [i]above[/i] the [InstancePlaceholder] in the scene tree. The [Node]'s reference is also returned for convenience.\n[b]Note:[/b] [method create_instance] is not thread-safe. Use [method Object.call_deferred] if calling from a thread."
msgstr "A metódus hívásával töltheted be a csomópontot. A létrehozott csomópont testvérként, közvetlenül az [InstancePlaceholder] [i]fölé[/i] kerül a jelenetfában. A metódus kényelmi okból visszaadja a [Node] hivatkozását is.\n[b]Megjegyzés:[/b] A [method create_instance] nem szálbiztos. Ha külön szálról hívod, használd a [method Object.call_deferred] metódust."

#. InstancePlaceholder.get_instance_path
#: doc/classes/InstancePlaceholder.xml
msgid "Gets the path to the [PackedScene] resource file that is loaded by default when calling [method create_instance]. Not thread-safe. Use [method Object.call_deferred] if calling from a thread."
msgstr "Visszaadja a [method create_instance] által alapértelmezésben betöltött [PackedScene] erőforrásfájl útvonalát. A metódus nem szálbiztos. Ha külön szálról hívod, használd a [method Object.call_deferred] metódust."

#. InstancePlaceholder.get_stored_values
#: doc/classes/InstancePlaceholder.xml
msgid "Returns the list of properties that will be applied to the node when [method create_instance] is called.\nIf [param with_order] is [code]true[/code], a key named [code].order[/code] (note the leading period) is added to the dictionary. This [code].order[/code] key is an [Array] of [String] property names specifying the order in which properties will be applied (with index 0 being the first)."
msgstr "Visszaadja a [method create_instance] hívásakor a csomópontra alkalmazott tulajdonságok listáját.\nHa a [param with_order] értéke [code]true[/code], a szótárhoz egy [code].order[/code] nevű kulcs kerül (a név ponttal kezdődik). A [code].order[/code] kulcs [String] típusú tulajdonságnevek [Array] tömbje, amely megadja az alkalmazás sorrendjét. A 0 indexű tulajdonság kerül sorra elsőként."

#. MainLoop.brief
#: doc/classes/MainLoop.xml
msgid "Abstract base class for the game's main loop."
msgstr "A játék fő ciklusának absztrakt alaposztálya."

#. MainLoop.description
#: doc/classes/MainLoop.xml
msgid "[MainLoop] is the abstract base class for a Godot project's game loop. It is inherited by [SceneTree], which is the default game loop implementation used in Godot projects, though it is also possible to write and use one's own [MainLoop] subclass instead of the scene tree.\nUpon the application start, a [MainLoop] implementation must be provided to the OS; otherwise, the application will exit. This happens automatically (and a [SceneTree] is created) unless a [MainLoop] [Script] is provided from the command line (with e.g. [code]godot -s my_loop.gd[/code]) or the [member ProjectSettings.application/run/main_loop_type] project setting is overwritten.\nHere is an example script implementing a simple [MainLoop]:\n[codeblocks]\n[gdscript]\nclass_name CustomMainLoop\nextends MainLoop\n\nvar time_elapsed = 0\n\nfunc _initialize():\n\tprint(\"Initialized:\")\n\tprint(\"  Starting time: %s\" % str(time_elapsed))\n\nfunc _process(delta):\n\ttime_elapsed += delta\n\t# Return true to end the main loop.\n\treturn Input.get_mouse_button_mask() != 0 || Input.is_key_pressed(KEY_ESCAPE)\n\nfunc _finalize():\n\tprint(\"Finalized:\")\n\tprint(\"  End time: %s\" % str(time_elapsed))\n[/gdscript]\n[csharp]\nusing Godot;\n\n[GlobalClass]\npublic partial class CustomMainLoop : MainLoop\n{\n\tprivate double _timeElapsed = 0;\n\n\tpublic override void _Initialize()\n\t{\n\t\tGD.Print(\"Initialized:\");\n\t\tGD.Print($\"  Starting Time: {_timeElapsed}\");\n\t}\n\n\tpublic override bool _Process(double delta)\n\t{\n\t\t_timeElapsed += delta;\n\t\t// Return true to end the main loop.\n\t\treturn Input.GetMouseButtonMask() != 0 || Input.IsKeyPressed(Key.Escape);\n\t}\n\n\tprivate void _Finalize()\n\t{\n\t\tGD.Print(\"Finalized:\");\n\t\tGD.Print($\"  End Time: {_timeElapsed}\");\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "A [MainLoop] a Godot-projekt játékciklusának absztrakt alaposztálya. A Godot-projektek alapértelmezett játékciklusa, a [SceneTree] ebből származik, de a jelenetfa helyett saját [MainLoop] leszármazottat is írhatsz és használhatsz.\nAz alkalmazás indulásakor az operációs rendszernek kapnia kell egy [MainLoop] megvalósítást, különben az alkalmazás kilép. Ez automatikusan történik, és létrejön egy [SceneTree], kivéve, ha a parancssorból adsz meg egy [MainLoop] [Script] erőforrást (például [code]godot -s my_loop.gd[/code]), vagy felülírod a [member ProjectSettings.application/run/main_loop_type] projektbeállítást.\nAz alábbi szkript egy egyszerű [MainLoop] megvalósítást mutat be:\n[codeblocks]\n[gdscript]\nclass_name CustomMainLoop\nextends MainLoop\n\nvar time_elapsed = 0\n\nfunc _initialize():\n\tprint(\"Initialized:\")\n\tprint(\"  Starting time: %s\" % str(time_elapsed))\n\nfunc _process(delta):\n\ttime_elapsed += delta\n\t# Return true to end the main loop.\n\treturn Input.get_mouse_button_mask() != 0 || Input.is_key_pressed(KEY_ESCAPE)\n\nfunc _finalize():\n\tprint(\"Finalized:\")\n\tprint(\"  End time: %s\" % str(time_elapsed))\n[/gdscript]\n[csharp]\nusing Godot;\n\n[GlobalClass]\npublic partial class CustomMainLoop : MainLoop\n{\n\tprivate double _timeElapsed = 0;\n\n\tpublic override void _Initialize()\n\t{\n\t\tGD.Print(\"Initialized:\");\n\t\tGD.Print($\"  Starting Time: {_timeElapsed}\");\n\t}\n\n\tpublic override bool _Process(double delta)\n\t{\n\t\t_timeElapsed += delta;\n\t\t// Return true to end the main loop.\n\t\treturn Input.GetMouseButtonMask() != 0 || Input.IsKeyPressed(Key.Escape);\n\t}\n\n\tprivate void _Finalize()\n\t{\n\t\tGD.Print(\"Finalized:\");\n\t\tGD.Print($\"  End Time: {_timeElapsed}\");\n\t}\n}\n[/csharp]\n[/codeblocks]"

#. MainLoop._finalize
#: doc/classes/MainLoop.xml
msgid "Called before the program exits."
msgstr "A program kilépése előtt hívódik meg."

#. MainLoop._initialize
#: doc/classes/MainLoop.xml
msgid "Called once during initialization."
msgstr "Inicializáláskor hívódik meg egyszer."

#. MainLoop._physics_process
#: doc/classes/MainLoop.xml
msgid "Called each physics tick. [param delta] is the logical time between physics ticks in seconds and is equal to [member Engine.time_scale] / [member Engine.physics_ticks_per_second]. Equivalent to [method Node._physics_process].\nIf implemented, the method must return a boolean value. [code]true[/code] ends the main loop, while [code]false[/code] lets it proceed to the next step.\n[b]Note:[/b] [method _physics_process] may be called up to [member Engine.max_physics_steps_per_frame] times per (idle) frame. This step limit may be reached when the engine is suffering performance issues.\n[b]Note:[/b] Accumulated [param delta] may diverge from real world seconds."
msgstr "Minden fizikai lépésben meghívódik. A [param delta] a fizikai lépések közötti logikai idő másodpercben, amely a [member Engine.time_scale] / [member Engine.physics_ticks_per_second] hányadossal egyezik. Egyenértékű a [method Node._physics_process] metódussal.\nHa megvalósítod ezt a metódust, logikai értéket kell visszaadnia. A [code]true[/code] befejezi a fő ciklust, a [code]false[/code] a következő lépésre vált.\n[b]Megjegyzés:[/b] A motor üresjárati képkockánként legfeljebb [member Engine.max_physics_steps_per_frame] alkalommal hívhatja meg a [method _physics_process] metódust. Teljesítménygondok esetén elérheti ezt a korlátot.\n[b]Megjegyzés:[/b] A [param delta] összegzett értéke eltérhet a valós időtől."

#. MainLoop._process
#: doc/classes/MainLoop.xml
msgid "Called on each idle frame, prior to rendering, and after physics ticks have been processed. [param delta] is the time between frames in seconds. Equivalent to [method Node._process].\nIf implemented, the method must return a boolean value. [code]true[/code] ends the main loop, while [code]false[/code] lets it proceed to the next frame.\n[b]Note:[/b] When the engine is struggling and the frame rate is lowered, [param delta] will increase. When [param delta] is increased, it's capped at a maximum of [member Engine.time_scale] * [member Engine.max_physics_steps_per_frame] / [member Engine.physics_ticks_per_second]. As a result, accumulated [param delta] may not represent real world time.\n[b]Note:[/b] When [code]--fixed-fps[/code] is enabled or the engine is running in Movie Maker mode (see [MovieWriter]), process [param delta] will always be the same for every frame, regardless of how much time the frame took to render.\n[b]Note:[/b] Frame delta may be post-processed by [member OS.delta_smoothing] if this is enabled for the project."
msgstr "Minden üresjárati képkockában meghívódik a fizikai lépések feldolgozása után és a kirajzolás előtt. A [param delta] a képkockák közötti idő másodpercben. Egyenértékű a [method Node._process] metódussal.\nHa megvalósítod ezt a metódust, logikai értéket kell visszaadnia. A [code]true[/code] befejezi a fő ciklust, a [code]false[/code] a következő képkockára vált.\n[b]Megjegyzés:[/b] Ha a motor leterhelt és csökken a képkockasebesség, a [param delta] megnő. A nagyobb [param delta] felső határa [member Engine.time_scale] * [member Engine.max_physics_steps_per_frame] / [member Engine.physics_ticks_per_second]. Így a [param delta] összegzett értéke eltérhet a valós időtől.\n[b]Megjegyzés:[/b] A [code]--fixed-fps[/code] használatakor, illetve Filmkészítő módban (lásd: [MovieWriter]) a feldolgozási [param delta] minden képkockán azonos, függetlenül a kirajzolás időtartamától.\n[b]Megjegyzés:[/b] Ha a projektben a [member OS.delta_smoothing] engedélyezve van, a motor utólag simíthatja a képkockák közötti időt."

#. MainLoop.on_request_permissions_result
#: doc/classes/MainLoop.xml
msgid "Emitted when a user responds to a permission request."
msgstr "Akkor küldi el, amikor a felhasználó válaszol egy engedélykérésre."

#. MainLoop.NOTIFICATION_OS_MEMORY_WARNING
#: doc/classes/MainLoop.xml
msgid "Notification received from the OS when the application is exceeding its allocated memory.\nSpecific to the iOS platform."
msgstr "Az operációs rendszer akkor küldi, amikor az alkalmazás túllépi a számára biztosított memóriát.\niOS-re jellemző."

#. MainLoop.NOTIFICATION_TRANSLATION_CHANGED
#: doc/classes/MainLoop.xml
msgid "Notification received when translations may have changed. Can be triggered by the user changing the locale. Can be used to respond to language changes, for example to change the UI strings on the fly. Useful when working with the built-in translation support, like [method Object.tr]."
msgstr "Akkor érkezik, amikor a fordítások megváltozhattak. Kiválthatja például, ha a felhasználó módosítja a nyelvi beállítást. Használható nyelvváltás kezelésére, például a felület szövegeinek azonnali cseréjére. Hasznos a beépített fordítási támogatás, például a [method Object.tr] használatakor."

#. MainLoop.NOTIFICATION_WM_ABOUT
#: doc/classes/MainLoop.xml
msgid "Notification received from the OS when a request for \"About\" information is sent.\nSpecific to the macOS platform."
msgstr "Az operációs rendszer akkor küldi, amikor az alkalmazás névjegyét kérik.\nmacOS-re jellemző."

#. MainLoop.NOTIFICATION_CRASH
#: doc/classes/MainLoop.xml
msgid "Notification received from Godot's crash handler when the engine is about to crash.\nImplemented on desktop platforms if the crash handler is enabled."
msgstr "A Godot összeomláskezelője küldi közvetlenül a motor összeomlása előtt.\nAsztali platformokon érhető el, ha az összeomláskezelő engedélyezve van."

#. MainLoop.NOTIFICATION_TEXT_SERVER_CHANGED
#: doc/classes/MainLoop.xml
msgid "Notification received when text server is changed."
msgstr "Akkor érkezik, amikor megváltozik a szövegkiszolgáló."

#. Resource.brief
#: doc/classes/Resource.xml
msgid "Base class for serializable objects."
msgstr "A szerializálható objektumok alaposztálya."

#. Resource.description
#: doc/classes/Resource.xml
msgid "Resource is the base class for all Godot-specific resource types, serving primarily as data containers. Since they inherit from [RefCounted], resources are reference-counted and freed when no longer in use. They can also be nested within other resources, and saved on disk. [PackedScene], one of the most common [Object]s in a Godot project, is also a resource, uniquely capable of storing and instantiating the [Node]s it contains as many times as desired.\nIn GDScript, resources can loaded from disk by their [member resource_path] using [method @GDScript.load] or [method @GDScript.preload].\nThe engine keeps a global cache of all loaded resources, referenced by paths (see [method ResourceLoader.has_cached]). A resource will be cached when loaded for the first time and removed from cache once all references are released. When a resource is cached, subsequent loads using its path will return the cached reference.\n[b]Note:[/b] In C#, resources will not be freed instantly after they are no longer in use. Instead, garbage collection will run periodically and will free resources that are no longer in use. This means that unused resources will remain in memory for a while before being removed."
msgstr "A Resource a Godot saját erőforrástípusainak alaposztálya. Az erőforrások elsősorban adatok tárolására szolgálnak. A [RefCounted] osztályból származnak, ezért a motor számlálja a hivatkozásaikat, és felszabadítja őket, ha már nem használják. Beágyazhatók más erőforrásokba és lemezre menthetők. A Godot-projektek egyik leggyakoribb [Object] típusa, a [PackedScene] szintén erőforrás, amely a benne tárolt [Node] csomópontokat tetszőleges számban példányosíthatja.\nGDScriptben az erőforrások a [member resource_path] útvonaluk alapján a [method @GDScript.load] vagy a [method @GDScript.preload] metódussal tölthetők be a lemezről.\nA motor globális gyorsítótárban tartja az összes betöltött erőforrást, útvonal szerint (lásd: [method ResourceLoader.has_cached]). Az erőforrás az első betöltéskor kerül a gyorsítótárba, és az összes hivatkozás elengedése után kerül ki onnan. Ha egy erőforrás a gyorsítótárban van, az útvonal alapján végzett következő betöltések ugyanazt a tárolt hivatkozást adják vissza.\n[b]Megjegyzés:[/b] C#-ban a használaton kívüli erőforrások nem szabadulnak fel azonnal. A szemétgyűjtés időnként fut le, és akkor szabadítja fel a már nem használt erőforrásokat. Az ilyen erőforrások tehát átmenetileg a memóriában maradnak."

#. Resource._get_rid
#: doc/classes/Resource.xml
msgid "Override this method to return a custom [RID] when [method get_rid] is called."
msgstr "Írd felül ezt a metódust, ha a [method get_rid] hívásakor egyéni [RID] azonosítót szeretnél visszaadni."

#. Resource._reset_state
#: doc/classes/Resource.xml
msgid "For resources that store state in non-exported properties, such as via [method Object._validate_property] or [method Object._get_property_list], this method must be implemented to clear them."
msgstr "Az állapotukat nem exportált tulajdonságokban tároló erőforrásoknál meg kell valósítani ezt a metódust a tulajdonságok törléséhez. Ilyen tulajdonságok lehetnek például a [method Object._validate_property] vagy a [method Object._get_property_list] használatával kezeltek."

#. Resource._set_path_cache
#: doc/classes/Resource.xml
msgid "Override this method to execute additional logic after [method set_path_cache] is called on this object."
msgstr "Írd felül ezt a metódust, ha a [method set_path_cache] meghívása után további műveletet szeretnél futtatni ezen az objektumon."

#. Resource._setup_local_to_scene
#: doc/classes/Resource.xml
msgid "Override this method to customize the newly duplicated resource created from [method PackedScene.instantiate], if the original's [member resource_local_to_scene] is set to [code]true[/code].\n[b]Example:[/b] Set a random [code]damage[/code] value to every local resource from an instantiated scene:\n[codeblock]\nextends Resource\n\nvar damage = 0\n\nfunc _setup_local_to_scene():\n\tdamage = randi_range(10, 40)\n[/codeblock]"
msgstr "Írd felül ezt a metódust a [method PackedScene.instantiate] által létrehozott erőforrásmásolat testreszabásához, ha az eredeti [member resource_local_to_scene] tulajdonsága [code]true[/code].\n[b]Példa:[/b] Véletlen [code]damage[/code] érték beállítása a példányosított jelenet minden helyi erőforrásán:\n[codeblock]\nextends Resource\n\nvar damage = 0\n\nfunc _setup_local_to_scene():\n\tdamage = randi_range(10, 40)\n[/codeblock]"

#. Resource.copy_from_resource
#: doc/classes/Resource.xml
msgid "Copies the data from [param resource] into this resource. Both resources must share the same class."
msgstr "Átmásolja a [param resource] adatait ebbe az erőforrásba. A két erőforrásnak azonos osztályba kell tartoznia."

#. Resource.duplicate
#: doc/classes/Resource.xml
msgid "Duplicates this resource, returning a new resource with its [code]export[/code]ed or [constant PROPERTY_USAGE_STORAGE] properties copied from the original.\nIf [param deep] is [code]false[/code], a [b]shallow[/b] copy is returned: nested [Array], [Dictionary], and [Resource] properties are not duplicated and are shared with the original resource.\nIf [param deep] is [code]true[/code], a [b]deep[/b] copy is returned: all nested arrays, dictionaries, and packed arrays are also duplicated (recursively). Any [Resource] found inside will only be duplicated if it's local, like [constant DEEP_DUPLICATE_INTERNAL] used with [method duplicate_deep].\nThe following exceptions apply:\n- Subresource properties with the [constant PROPERTY_USAGE_ALWAYS_DUPLICATE] flag are always duplicated (recursively or not, depending on [param deep]).\n- Subresource properties with the [constant PROPERTY_USAGE_NEVER_DUPLICATE] flag are never duplicated.\n[b]Note:[/b] For custom resources, this method will fail if [method Object._init] has been defined with required parameters.\n[b]Note:[/b] When duplicating with [param deep] set to [code]true[/code], each resource found, including the one on which this method is called, will be only duplicated once and referenced as many times as needed in the duplicate. For instance, if you are duplicating resource A that happens to have resource B referenced twice, you'll get a new resource A' referencing a new resource B' twice."
msgstr "Lemásolja az erőforrást, és új erőforrást ad vissza az eredeti [code]export[/code] kulcsszóval exportált vagy [constant PROPERTY_USAGE_STORAGE] jelzővel ellátott tulajdonságaival.\nHa a [param deep] értéke [code]false[/code], [b]sekély[/b] másolatot ad vissza. A beágyazott [Array], [Dictionary] és [Resource] tulajdonságok nem másolódnak, így az eredeti és a másolat ugyanazt használja.\nHa a [param deep] értéke [code]true[/code], [b]mély[/b] másolatot ad vissza. A beágyazott tömbök, szótárak és tömörített tömbök rekurzívan másolódnak. A bennük található [Resource] csak akkor másolódik, ha helyi, ahogy a [method duplicate_deep] [constant DEEP_DUPLICATE_INTERNAL] módjában.\nA következő kivételek érvényesek:\n- A [constant PROPERTY_USAGE_ALWAYS_DUPLICATE] jelzővel ellátott alerőforrás-tulajdonságok mindig másolódnak. A rekurzió a [param deep] értékétől függ.\n- A [constant PROPERTY_USAGE_NEVER_DUPLICATE] jelzővel ellátott alerőforrás-tulajdonságok soha nem másolódnak.\n[b]Megjegyzés:[/b] Egyéni erőforrásnál a metódus meghiúsul, ha a [method Object._init] kötelező paramétereket vár.\n[b]Megjegyzés:[/b] Ha a [param deep] értéke [code]true[/code], minden megtalált erőforrás csak egyszer másolódik, beleértve azt is, amelyen a metódust meghívtad. A másolatban szükség szerint több hivatkozás is mutathat ugyanarra az új erőforrásra. Ha például az A erőforrás kétszer hivatkozik a B erőforrásra, az új A' erőforrás kétszer az új B' erőforrásra fog hivatkozni."

#. Resource.duplicate_deep
#: doc/classes/Resource.xml
msgid "Duplicates this resource, deeply, like [method duplicate] when passing [code]true[/code], with extra control over how subresources are handled."
msgstr "Mély másolatot készít az erőforrásról a [method duplicate] [code]true[/code] értékű hívásához hasonlóan, de az alerőforrások kezelése részletesebben szabályozható."

#. Resource.emit_changed
#: doc/classes/Resource.xml
msgid "Emits the [signal changed] signal. This method is called automatically for some built-in resources.\n[b]Note:[/b] For custom resources, it's recommended to call this method whenever a meaningful change occurs, such as a modified property. This ensures that custom [Object]s depending on the resource are properly updated.\n[codeblock]\nvar damage:\n\tset(new_value):\n\t\tif damage != new_value:\n\t\t\tdamage = new_value\n\t\t\temit_changed()\n[/codeblock]"
msgstr "Elküldi a [signal changed] jelzést. Egyes beépített erőforrások automatikusan meghívják ezt a metódust.\n[b]Megjegyzés:[/b] Egyéni erőforrásoknál érdemes minden lényeges változáskor meghívni, például egy tulajdonság módosítása után. Így az erőforrást használó egyéni [Object] objektumok is megfelelően frissülnek.\n[codeblock]\nvar damage:\n\tset(new_value):\n\t\tif damage != new_value:\n\t\t\tdamage = new_value\n\t\t\temit_changed()\n[/codeblock]"

#. Resource.generate_scene_unique_id
#: doc/classes/Resource.xml
msgid "Generates a unique identifier for a resource to be contained inside a [PackedScene], based on the current date, time, and a random value. The returned string is only composed of letters ([code]a[/code] to [code]y[/code]) and numbers ([code]0[/code] to [code]8[/code]). See also [member resource_scene_unique_id]."
msgstr "Az aktuális dátum, idő és egy véletlen érték alapján egyedi azonosítót állít elő a [PackedScene] erőforrásba kerülő erőforráshoz. A szöveg csak betűket ([code]a[/code]–[code]y[/code]) és számjegyeket ([code]0[/code]–[code]8[/code]) tartalmaz. Lásd még a [member resource_scene_unique_id] tulajdonságot."

#. Resource.get_id_for_path
#: doc/classes/Resource.xml
msgid "From the internal cache for scene-unique IDs, returns the ID of this resource for the scene at [param path]. If there is no entry, an empty string is returned. Useful to keep scene-unique IDs the same when implementing a VCS-friendly custom resource format by extending [ResourceFormatLoader] and [ResourceFormatSaver].\n[b]Note:[/b] This method is only implemented when running in an editor context. At runtime, it returns an empty string."
msgstr "A jeleneten belül egyedi azonosítók belső gyorsítótárából visszaadja az erőforrás azonosítóját a [param path] útvonalú jelenethez. Ha nincs bejegyzés, üres karakterláncot ad vissza. Azonosítók megőrzésére használható, ha verziókövetésre alkalmas saját formátumot hozol létre a [ResourceFormatLoader] és a [ResourceFormatSaver] kiterjesztésével.\n[b]Megjegyzés:[/b] A metódus csak a szerkesztőben működik. Futás közben üres karakterláncot ad vissza."

#. Resource.get_local_scene
#: doc/classes/Resource.xml
msgid "If [member resource_local_to_scene] is set to [code]true[/code] and the resource has been loaded from a [PackedScene] instantiation, returns the root [Node] of the scene where this resource is used. Otherwise, returns [code]null[/code]."
msgstr "Ha a [member resource_local_to_scene] értéke [code]true[/code], és az erőforrás egy [PackedScene] példányosításából származik, annak a jelenetnek a gyökércsomópontját ([Node]) adja vissza, amely az erőforrást használja. Egyébként az eredmény [code]null[/code]."

#. Resource.get_rid
#: doc/classes/Resource.xml
msgid "Returns the [RID] of this resource (or an empty RID). Many resources (such as [Texture2D], [Mesh], and so on) are high-level abstractions of resources stored in a specialized server ([DisplayServer], [RenderingServer], etc.), so this function will return the original [RID]."
msgstr "Visszaadja az erőforrás [RID] azonosítóját vagy egy üres RID értéket. Sok erőforrás, például a [Texture2D] és a [Mesh], egy külön kiszolgálón ([DisplayServer], [RenderingServer] stb.) tárolt erőforrás magasabb szintű megfelelője. A metódus ilyen esetben az eredeti [RID] azonosítót adja vissza."

#. Resource.is_built_in
#: doc/classes/Resource.xml
msgid "Returns [code]true[/code] if the resource is saved on disk as a part of another resource's file."
msgstr "[code]true[/code] értéket ad vissza, ha az erőforrás egy másik erőforrás fájljának részeként van a lemezre mentve."

#. Resource.reset_state
#: doc/classes/Resource.xml
msgid "Makes the resource clear its non-exported properties. See also [method _reset_state]. Useful when implementing a custom resource format by extending [ResourceFormatLoader] and [ResourceFormatSaver]."
msgstr "Törli az erőforrás nem exportált tulajdonságait. Lásd még a [method _reset_state] metódust. Saját formátum megvalósításához hasznos a [ResourceFormatLoader] és a [ResourceFormatSaver] kiterjesztésekor."

#. Resource.set_id_for_path
#: doc/classes/Resource.xml
msgid "In the internal cache for scene-unique IDs, sets the ID of this resource to [param id] for the scene at [param path]. If [param id] is empty, the cache entry for [param path] is cleared. Useful to keep scene-unique IDs the same when implementing a VCS-friendly custom resource format by extending [ResourceFormatLoader] and [ResourceFormatSaver].\n[b]Note:[/b] This method is only implemented when running in an editor context."
msgstr "A jeleneten belül egyedi azonosítók belső gyorsítótárában az erőforrás azonosítóját a [param id] értékre állítja a [param path] útvonalú jelenethez. Ha a [param id] üres, a [param path] bejegyzése törlődik a gyorsítótárból. Azonosítók megőrzésére használható, ha verziókövetésre alkalmas saját formátumot hozol létre a [ResourceFormatLoader] és a [ResourceFormatSaver] kiterjesztésével.\n[b]Megjegyzés:[/b] A metódus csak a szerkesztőben működik."

#. Resource.set_path_cache
#: doc/classes/Resource.xml
msgid "Sets the resource's path to [param path] without involving the resource cache. Useful for handling [enum ResourceFormatLoader.CacheMode] values when implementing a custom resource format by extending [ResourceFormatLoader] and [ResourceFormatSaver]."
msgstr "Az erőforrás útvonalát a [param path] értékre állítja a gyorsítótár használata nélkül. Hasznos az [enum ResourceFormatLoader.CacheMode] értékek kezeléséhez saját formátumnál, a [ResourceFormatLoader] és a [ResourceFormatSaver] kiterjesztésekor."

#. Resource.setup_local_to_scene
#: doc/classes/Resource.xml
msgid "Calls [method _setup_local_to_scene]. If [member resource_local_to_scene] is set to [code]true[/code], this method is automatically called from [method PackedScene.instantiate] by the newly duplicated resource within the scene instance."
msgstr "Meghívja a [method _setup_local_to_scene] metódust. Ha a [member resource_local_to_scene] értéke [code]true[/code], a [method PackedScene.instantiate] végrehajtása során a jelenetpéldányban létrejött erőforrásmásolat automatikusan meghívja ezt a metódust."

#. Resource.take_over_path
#: doc/classes/Resource.xml
msgid "Sets the [member resource_path] to [param path], potentially overriding an existing cache entry for this path. Further attempts to load an overridden resource by path will instead return this resource."
msgstr "A [member resource_path] értékét a [param path] értékre állítja, akár felülírva az útvonalhoz tartozó meglévő gyorsítótár-bejegyzést. Ha egy erőforrást így felülírsz, az adott útvonalról történő későbbi betöltések ezt az erőforrást adják vissza."

#. Resource.changed
#: doc/classes/Resource.xml
msgid "Emitted when the resource changes, usually when one of its properties is modified. See also [method emit_changed].\n[b]Note:[/b] This signal is not emitted automatically for properties of custom resources. If necessary, a setter needs to be created to emit the signal."
msgstr "Akkor küldi el, amikor az erőforrás megváltozik, általában egy tulajdonságának módosításakor. Lásd még a [method emit_changed] metódust.\n[b]Megjegyzés:[/b] Egyéni erőforrások tulajdonságainál a jelzés nem érkezik automatikusan. Szükség esetén olyan beállító metódust kell létrehozni, amely elküldi a jelzést."

#. Resource.setup_local_to_scene_requested
#: doc/classes/Resource.xml
msgid "Emitted by a newly duplicated resource with [member resource_local_to_scene] set to [code]true[/code]."
msgstr "Az új erőforrásmásolat küldi el, ha a [member resource_local_to_scene] értéke [code]true[/code]."

#. Resource.resource_local_to_scene
#: doc/classes/Resource.xml
msgid "If [code]true[/code], the resource is duplicated for each instance of all scenes using it. At run-time, the resource can be modified in one scene without affecting other instances (see [method PackedScene.instantiate]).\n[b]Note:[/b] Changing this property at run-time has no effect on already created duplicate resources."
msgstr "[code]true[/code] értéknél minden olyan jelenetpéldány, amely használja az erőforrást, saját másolatot kap. Futás közben az egyik jelenet erőforrása módosítható a többi példányra gyakorolt hatás nélkül (lásd: [method PackedScene.instantiate]).\n[b]Megjegyzés:[/b] A tulajdonság futás közbeni átállítása a már létrehozott erőforrásmásolatokra nincs hatással."

#. Resource.resource_name
#: doc/classes/Resource.xml
msgid "An optional name for this resource. When defined, its value is displayed to represent the resource in the Inspector dock. For built-in scripts, the name is displayed as part of the tab name in the script editor.\n[b]Note:[/b] Some resource formats do not support resource names. You can still set the name in the editor or via code, but it will be lost when the resource is reloaded. For example, only built-in scripts can have a resource name, while scripts stored in separate files cannot."
msgstr "Az erőforrás opcionális neve. Ha meg van adva, ez a név képviseli az erőforrást a Tulajdonságvizsgálóban. Beépített szkripteknél a név a szkriptszerkesztő fülének feliratában jelenik meg.\n[b]Megjegyzés:[/b] Egyes erőforrás-formátumok nem támogatják az erőforrásneveket. A szerkesztőben vagy kódból megadhatod a nevet, de újratöltéskor elveszik. Például a beépített szkripteknek lehet erőforrásnevük, a külön fájlban tárolt szkripteknek nincs."

#. Resource.resource_path
#: doc/classes/Resource.xml
msgid "The unique path to this resource. If it has been saved to disk, the value will be its filepath. If the resource is exclusively contained within a scene, the value will be the [PackedScene]'s filepath, followed by a unique identifier.\n[b]Note:[/b] Setting this property manually may fail if a resource with the same path has already been previously loaded. If necessary, use [method take_over_path]."
msgstr "Az erőforrás egyedi útvonala. Ha lemezre mentették, az érték a fájl útvonala. Ha az erőforrás kizárólag egy jelenet része, az érték a [PackedScene] fájlútvonalából és az azt követő egyedi azonosítóból áll.\n[b]Megjegyzés:[/b] A tulajdonság kézi beállítása meghiúsulhat, ha azonos útvonallal korábban már betöltöttek egy erőforrást. Szükség esetén használd a [method take_over_path] metódust."

#. Resource.resource_scene_unique_id
#: doc/classes/Resource.xml
msgid "A unique identifier relative to this resource's scene. If left empty, the ID is automatically generated when this resource is saved inside a [PackedScene]. If the resource is not inside a scene, this property is empty by default.\n[b]Note:[/b] When the [PackedScene] is saved, if multiple resources in the same scene use the same ID, only the earliest resource in the scene hierarchy keeps the original ID. The other resources are assigned new IDs from [method generate_scene_unique_id].\n[b]Note:[/b] Setting this property does not emit the [signal changed] signal.\n[b]Warning:[/b] When setting, the ID must only consist of letters, numbers, and underscores. Otherwise, it will fail and default to a randomly generated ID."
msgstr "Az erőforrás jelenetén belül egyedi azonosító. Ha üres, a motor automatikusan előállítja, amikor az erőforrást egy [PackedScene] részeként menti. Jeleneten kívüli erőforrásnál alapértelmezésben üres.\n[b]Megjegyzés:[/b] A [PackedScene] mentésekor ha több erőforrásnak azonos azonosítója van ugyanabban a jelenetben, az eredeti azonosítót csak a hierarchiában legkorábban szereplő erőforrás őrzi meg. A többinek a [method generate_scene_unique_id] új azonosítót ad.\n[b]Megjegyzés:[/b] A tulajdonság beállítása nem küldi el a [signal changed] jelzést.\n[b]Figyelmeztetés:[/b] Az azonosító csak betűkből, számjegyekből és aláhúzásjelekből állhat. Egyébként a beállítás meghiúsul, és a motor véletlenszerű azonosítót ad."

#. Resource.DEEP_DUPLICATE_NONE
#: doc/classes/Resource.xml
msgid "No subresources at all are duplicated. This is useful even in a deep duplication to have all the arrays and dictionaries duplicated but still pointing to the original resources."
msgstr "Egyetlen alerőforrás sem másolódik. Mély másoláskor is hasznos, ha az összes tömbből és szótárból másolatot szeretnél készíteni, de azok továbbra is az eredeti erőforrásokra hivatkozzanak."

#. Resource.DEEP_DUPLICATE_INTERNAL
#: doc/classes/Resource.xml
msgid "Only subresources without a path or with a scene-local path will be duplicated."
msgstr "Csak az útvonal nélküli vagy a jeleneten belüli útvonallal rendelkező alerőforrások másolódnak."

#. Resource.DEEP_DUPLICATE_ALL
#: doc/classes/Resource.xml
msgid "Every subresource found will be duplicated, even if it has a non-local path. In other words, even potentially big resources stored separately will be duplicated."
msgstr "Minden megtalált alerőforrás másolódik, akkor is, ha külső útvonala van. Így a külön fájlban tárolt, esetleg nagy erőforrásokból is másolat készül."

#. ResourceFormatLoader.CACHE_MODE_IGNORE
#. ResourceLoader.CACHE_MODE_IGNORE
#: doc/classes/ResourceFormatLoader.xml doc/classes/ResourceLoader.xml
msgid "Neither the main resource (the one requested to be loaded) nor any of its subresources are retrieved from cache nor stored into it. Dependencies (external resources) are loaded with [constant CACHE_MODE_REUSE]."
msgstr "A fő erőforrást, amelynek betöltését kérték, és az alerőforrásait sem olvassa ki a gyorsítótárból, és nem is tárolja benne. A függőségeket, vagyis a külső erőforrásokat [constant CACHE_MODE_REUSE] módban tölti be."

#. ResourceFormatLoader.CACHE_MODE_REUSE
#. ResourceLoader.CACHE_MODE_REUSE
#: doc/classes/ResourceFormatLoader.xml doc/classes/ResourceLoader.xml
msgid "The main resource (the one requested to be loaded), its subresources, and its dependencies (external resources) are retrieved from cache if present, instead of loaded. Those not cached are loaded and then stored into the cache. The same rules are propagated recursively down the tree of dependencies (external resources)."
msgstr "A fő erőforrást, amelynek betöltését kérték, az alerőforrásait és a függőségeit (külső erőforrásait) a gyorsítótárból adja vissza, ha megtalálhatók benne. A hiányzó erőforrásokat betölti, majd gyorsítótárazza. Ezeket a szabályokat rekurzívan alkalmazza a teljes függőségi fán."

#. ResourceFormatLoader.CACHE_MODE_REPLACE
#. ResourceLoader.CACHE_MODE_REPLACE
#: doc/classes/ResourceFormatLoader.xml doc/classes/ResourceLoader.xml
msgid "Like [constant CACHE_MODE_REUSE], but the cache is checked for the main resource (the one requested to be loaded) as well as for each of its subresources. Those already in the cache, as long as the loaded and cached types match, have their data refreshed from storage into the already existing instances. Otherwise, they are recreated as completely new objects."
msgstr "A [constant CACHE_MODE_REUSE] módhoz hasonló, de a motor ellenőrzi a gyorsítótárban a fő, betöltésre kért erőforrást és az összes alerőforrását. Ha egy példány már a gyorsítótárban van, és a betöltött típus egyezik a tárolttal, a motor a meglévő példány adatait frissíti a tárolóról. Egyébként új objektumot hoz létre."

#. ResourceFormatLoader.CACHE_MODE_IGNORE_DEEP
#. ResourceLoader.CACHE_MODE_IGNORE_DEEP
#: doc/classes/ResourceFormatLoader.xml doc/classes/ResourceLoader.xml
msgid "Like [constant CACHE_MODE_IGNORE], but propagated recursively down the tree of dependencies (external resources)."
msgstr "A [constant CACHE_MODE_IGNORE] módhoz hasonló, de a teljes függőségi fára (a külső erőforrásokra) rekurzívan érvényes."

#. ResourceFormatLoader.CACHE_MODE_REPLACE_DEEP
#. ResourceLoader.CACHE_MODE_REPLACE_DEEP
#: doc/classes/ResourceFormatLoader.xml doc/classes/ResourceLoader.xml
msgid "Like [constant CACHE_MODE_REPLACE], but propagated recursively down the tree of dependencies (external resources)."
msgstr "A [constant CACHE_MODE_REPLACE] módhoz hasonló, de a teljes függőségi fára (a külső erőforrásokra) rekurzívan érvényes."

#. ResourceLoader.brief
#: doc/classes/ResourceLoader.xml
msgid "A singleton for loading resource files."
msgstr "Erőforrásfájlokat betöltő globális példány."

#. ResourceLoader.description
#: doc/classes/ResourceLoader.xml
msgid "A singleton used to load resource files from the filesystem.\nIt uses the many [ResourceFormatLoader] classes registered in the engine (either built-in or from a plugin) to load files into memory and convert them to a format that can be used by the engine.\n[b]Note:[/b] You have to import the files into the engine first to load them using [method load]. If you want to load [Image]s at run-time, you may use [method Image.load]. If you want to import audio files, you can use the snippet described in [member AudioStreamMP3.data].\n[b]Note:[/b] Non-resource files such as plain text files cannot be read using [ResourceLoader]. Use [FileAccess] for those files instead, and be aware that non-resource files are not exported by default (see notes in the [FileAccess] class description for instructions on exporting them)."
msgstr "Erőforrásfájlokat tölt be a fájlrendszerből.\nA motorban regisztrált beépített vagy bővítményből származó [ResourceFormatLoader] osztályokkal tölti be a fájlokat a memóriába és alakítja át a motor számára használható formátumra.\n[b]Megjegyzés:[/b] A fájlokat előbb importálnod kell a motorba, hogy a [method load] metódussal betölthetők legyenek. Futás közben [Image] képek betöltéséhez használhatod a [method Image.load] metódust. Hangfájlok importálásához lásd a [member AudioStreamMP3.data] leírásában szereplő példakódot.\n[b]Megjegyzés:[/b] A [ResourceLoader] nem olvas erőforráson kívüli fájlokat, például egyszerű szövegfájlokat. Ezekhez használd a [FileAccess] osztályt. Az ilyen fájlok alapértelmezésben kimaradnak az exportból. Az exportálásukhoz lásd a [FileAccess] osztályleírásának megjegyzéseit."

#. ResourceLoader.add_resource_format_loader
#: doc/classes/ResourceLoader.xml
msgid "Registers a new [ResourceFormatLoader]. The ResourceLoader will use the ResourceFormatLoader as described in [method load].\nThis method is performed implicitly for ResourceFormatLoaders written in GDScript (see [ResourceFormatLoader] for more information)."
msgstr "Új [ResourceFormatLoader] betöltőt regisztrál. A ResourceLoader a [method load] leírása szerint használja.\nA GDScriptben írt ResourceFormatLoader osztályokat a motor automatikusan regisztrálja (további információkért lásd: [ResourceFormatLoader])."

#. ResourceLoader.exists
#: doc/classes/ResourceLoader.xml
msgid "Returns whether a recognized resource exists for the given [param path].\nAn optional [param type_hint] can be used to further specify the [Resource] type that should be handled by the [ResourceFormatLoader]. Anything that inherits from [Resource] can be used as a type hint, for example [Image].\n[b]Note:[/b] If you use [method Resource.take_over_path], this method will return [code]true[/code] for the taken path even if the resource wasn't saved (i.e. exists only in resource cache)."
msgstr "Megadja, hogy létezik-e felismerhető erőforrás a megadott [param path] útvonalon.\nAz opcionális [param type_hint] pontosíthatja, melyik [Resource] típust kezelje a [ResourceFormatLoader]. Típustippként a [Resource] bármely leszármazottja megadható, például az [Image].\n[b]Megjegyzés:[/b] A [method Resource.take_over_path] használata után a metódus [code]true[/code] értéket ad vissza az átvett útvonalra akkor is, ha az erőforrást még nem mentették el, és csak a gyorsítótárban létezik."

#. ResourceLoader.get_cached_ref
#: doc/classes/ResourceLoader.xml
msgid "Returns the cached resource reference for the given [param path].\n[b]Note:[/b] If the resource is not cached, the returned [Resource] will be invalid."
msgstr "Visszaadja a megadott [param path] útvonalhoz tartozó gyorsítótárazott erőforrás hivatkozását.\n[b]Megjegyzés:[/b] Ha az erőforrás nincs a gyorsítótárban, a visszaadott [Resource] érvénytelen."

#. ResourceLoader.get_dependencies
#: doc/classes/ResourceLoader.xml
msgid "Returns the dependencies for the resource at the given [param path].\nEach dependency is a string that can be divided into sections by [code]::[/code]. There can be either one section or three sections, with the second section always being empty. When there is one section, it contains the file path. When there are three sections, the first section contains the UID and the third section contains the fallback path.\n[codeblock]\nfor dependency in ResourceLoader.get_dependencies(path):\n\tif dependency.contains(\"::\"):\n\t\tprint(dependency.get_slice(\"::\", 0)) # Prints the UID.\n\t\tprint(dependency.get_slice(\"::\", 2)) # Prints the fallback path.\n\telse:\n\t\tprint(dependency) # Prints the path.\n[/codeblock]"
msgstr "Visszaadja a megadott [param path] útvonalú erőforrás függőségeit.\nMinden függőség karakterlánc, amelyet a [code]::[/code] választ részekre. A szöveg egy vagy három részből állhat. Három résznél a második rész mindig üres. Egyetlen rész esetén az a fájlútvonal. Három rész esetén az első az egyedi azonosító (UID), a harmadik pedig a tartalék útvonal.\n[codeblock]\nfor dependency in ResourceLoader.get_dependencies(path):\n\tif dependency.contains(\"::\"):\n\t\tprint(dependency.get_slice(\"::\", 0)) # Prints the UID.\n\t\tprint(dependency.get_slice(\"::\", 2)) # Prints the fallback path.\n\telse:\n\t\tprint(dependency) # Prints the path.\n[/codeblock]"

#. ResourceLoader.get_recognized_extensions_for_type
#: doc/classes/ResourceLoader.xml
msgid "Returns the list of recognized extensions for a resource type."
msgstr "Visszaadja az adott erőforrástípushoz felismert fájlkiterjesztések listáját."

#. ResourceLoader.get_resource_uid
#: doc/classes/ResourceLoader.xml
msgid "Returns the ID associated with a given resource path, or [code]-1[/code] when no such ID exists."
msgstr "Visszaadja az adott erőforrás-útvonalhoz tartozó azonosítót, vagy [code]-1[/code] értéket, ha nincs ilyen azonosító."

#. ResourceLoader.has_cached
#: doc/classes/ResourceLoader.xml
msgid "Returns whether a cached resource is available for the given [param path].\nOnce a resource has been loaded by the engine, it is cached in memory for faster access, and future calls to the [method load] method will use the cached version. The cached resource can be overridden by using [method Resource.take_over_path] on a new resource for that same path."
msgstr "Megadja, hogy elérhető-e gyorsítótárazott erőforrás a [param path] útvonalhoz.\nA motor betöltéskor az erőforrást a memóriában gyorsítótárazza, hogy a [method load] későbbi hívásai a tárolt változatot gyorsabban elérjék. A gyorsítótárazott erőforrást felülírhatod a [method Resource.take_over_path] hívásával egy új erőforráson, ugyanazzal az útvonallal."

#. ResourceLoader.list_directory
#: doc/classes/ResourceLoader.xml
msgid "Lists a directory, returning all resources and subdirectories contained within. The resource files have the original file names as visible in the editor before exporting. The directories have [code]\"/\"[/code] appended.\n[codeblock]\n# Prints [\"extra_data/\", \"model.gltf\", \"model.tscn\", \"model_slime.png\"]\nprint(ResourceLoader.list_directory(\"res://assets/enemies/slime\"))\n[/codeblock]\n[b]Note:[/b] The order of files and directories returned by this method is not deterministic, and can vary between operating systems.\n[b]Note:[/b] To normally traverse the filesystem, see [DirAccess]."
msgstr "Felsorolja a könyvtár összes erőforrását és alkönyvtárát. Az erőforrásfájlok eredeti fájlnevükkel szerepelnek, ahogyan exportálás előtt a szerkesztőben látszanak. A könyvtárnevek végére [code]\"/\"[/code] kerül.\n[codeblock]\n# Prints [\"extra_data/\", \"model.gltf\", \"model.tscn\", \"model_slime.png\"]\nprint(ResourceLoader.list_directory(\"res://assets/enemies/slime\"))\n[/codeblock]\n[b]Megjegyzés:[/b] A fájlok és könyvtárak sorrendje nem meghatározott, és operációs rendszerenként eltérhet.\n[b]Megjegyzés:[/b] A fájlrendszer általános bejárásához lásd a [DirAccess] osztályt."

#. ResourceLoader.load
#: doc/classes/ResourceLoader.xml
msgid "Loads a resource at the given [param path], caching the result for further access.\nThe registered [ResourceFormatLoader]s are queried sequentially to find the first one which can handle the file's extension, and then attempt loading. If loading fails, the remaining ResourceFormatLoaders are also attempted.\nAn optional [param type_hint] can be used to further specify the [Resource] type that should be handled by the [ResourceFormatLoader]. Anything that inherits from [Resource] can be used as a type hint, for example [Image].\nThe [param cache_mode] property defines whether and how the cache should be used or updated when loading the resource.\nReturns an empty resource if no [ResourceFormatLoader] could handle the file, and prints an error if no file is found at the specified path.\nGDScript has a simplified [method @GDScript.load] built-in method which can be used in most situations, leaving the use of [ResourceLoader] for more advanced scenarios.\n[b]Note:[/b] If [member ProjectSettings.editor/export/convert_text_resources_to_binary] is [code]true[/code], [method @GDScript.load] will not be able to read converted files in an exported project. If you rely on run-time loading of files present within the PCK, set [member ProjectSettings.editor/export/convert_text_resources_to_binary] to [code]false[/code].\n[b]Note:[/b] Relative paths will be prefixed with [code]\"res://\"[/code] before loading, to avoid unexpected results make sure your paths are absolute."
msgstr "Betölti a megadott [param path] útvonalon lévő erőforrást, és gyorsítótárazza az eredményt a későbbi eléréshez.\nA regisztrált [ResourceFormatLoader] betöltőket sorrendben kérdezi le, hogy megtalálja az elsőt, amelyik kezeli a fájlkiterjesztést. Ezután megpróbálja betölteni a fájlt. Sikertelen betöltéskor a többi ResourceFormatLoader betöltővel is próbálkozik.\nAz opcionális [param type_hint] pontosíthatja, melyik [Resource] típust kezelje a [ResourceFormatLoader]. Típustippként a [Resource] bármely leszármazottja megadható, például az [Image].\nA [param cache_mode] határozza meg, hogy az erőforrás betöltésekor használja, illetve frissíti-e a gyorsítótárat, és milyen módon.\nÜres erőforrást ad vissza, ha egyik [ResourceFormatLoader] sem tudja kezelni a fájlt, és hibaüzenetet ír ki, ha a megadott útvonalon nem található fájl.\nGDScriptben a legtöbb esetben használható az egyszerűbb, beépített [method @GDScript.load] metódus. A [ResourceLoader] összetettebb esetekhez használható.\n[b]Megjegyzés:[/b] Ha a [member ProjectSettings.editor/export/convert_text_resources_to_binary] értéke [code]true[/code], a [method @GDScript.load] az exportált projektben nem tudja olvasni az átalakított fájlokat. Ha futás közben töltesz be a PCK-ban lévő fájlokat, állítsd a [member ProjectSettings.editor/export/convert_text_resources_to_binary] értékét [code]false[/code] értékre.\n[b]Megjegyzés:[/b] A relatív útvonalak elé a motor betöltés előtt [code]\"res://\"[/code] előtagot tesz. A váratlan eredmény elkerüléséhez adj meg abszolút útvonalakat."

#. ResourceLoader.load_threaded_get
#: doc/classes/ResourceLoader.xml
msgid "Returns the resource loaded by [method load_threaded_request].\nIf this is called before the loading thread is done (i.e. [method load_threaded_get_status] is not [constant THREAD_LOAD_LOADED]), the calling thread will be blocked until the resource has finished loading. However, it's recommended to use [method load_threaded_get_status] to known when the load has actually completed."
msgstr "Visszaadja a [method load_threaded_request] használatával betöltött erőforrást.\nHa a híváskor a betöltőszál még nem végzett, vagyis a [method load_threaded_get_status] eredménye még nem [constant THREAD_LOAD_LOADED], a hívó szál a betöltés végéig várakozik. A betöltés befejezését célszerű a [method load_threaded_get_status] metódussal ellenőrizni."

#. ResourceLoader.load_threaded_get_status
#: doc/classes/ResourceLoader.xml
msgid "Returns the status of a threaded loading operation started with [method load_threaded_request] for the resource at [param path].\nAn array variable can optionally be passed via [param progress], and will return a one-element array containing the ratio of completion of the threaded loading (between [code]0.0[/code] and [code]1.0[/code]).\n[b]Note:[/b] The recommended way of using this method is to call it during different frames (e.g., in [method Node._process], instead of a loop)."
msgstr "Visszaadja a [param path] útvonalú erőforráshoz a [method load_threaded_request] metódussal indított, háttérszálon futó betöltés állapotát.\nA [param progress] paraméterként opcionálisan átadhatsz egy tömböt. A metódus ebbe egy elemet ír, a betöltés készültségi arányát [code]0.0[/code] és [code]1.0[/code] között.\n[b]Megjegyzés:[/b] A metódust célszerű különböző képkockákban meghívni, például a [method Node._process] metódusban, és nem ciklusban."

#. ResourceLoader.load_threaded_request
#: doc/classes/ResourceLoader.xml
msgid "Loads the resource using threads. If [param use_sub_threads] is [code]true[/code], multiple threads will be used to load the resource, which makes loading faster, but may affect the main thread (and thus cause game slowdowns).\nThe [param cache_mode] parameter defines whether and how the cache should be used or updated when loading the resource."
msgstr "Háttérszálon tölti be az erőforrást. Ha a [param use_sub_threads] értéke [code]true[/code], a betöltés több szálon fut. Így gyorsabb lehet, de a terhelés a főszálra is hatással lehet, ami lassíthatja a játékot.\nA [param cache_mode] szabályozza, hogy a betöltés használja-e vagy frissíti-e a gyorsítótárat, és milyen módon."

#. ResourceLoader.remove_resource_format_loader
#: doc/classes/ResourceLoader.xml
msgid "Unregisters the given [ResourceFormatLoader]."
msgstr "Törli a megadott [ResourceFormatLoader] regisztrációját."

#. ResourceLoader.set_abort_on_missing_resources
#: doc/classes/ResourceLoader.xml
msgid "Changes the behavior on missing sub-resources. The default behavior is to abort loading."
msgstr "Beállítja a hiányzó alerőforrások kezelését. Alapértelmezésben a motor megszakítja a betöltést."

#. ResourceLoader.THREAD_LOAD_INVALID_RESOURCE
#: doc/classes/ResourceLoader.xml
msgid "The resource is invalid, or has not been loaded with [method load_threaded_request]."
msgstr "Az erőforrás érvénytelen, vagy a betöltését nem kérték a [method load_threaded_request] metódussal."

#. ResourceLoader.THREAD_LOAD_IN_PROGRESS
#: doc/classes/ResourceLoader.xml
msgid "The resource is still being loaded."
msgstr "Az erőforrás betöltése még folyamatban van."

#. ResourceLoader.THREAD_LOAD_FAILED
#: doc/classes/ResourceLoader.xml
msgid "Some error occurred during loading and it failed."
msgstr "Hiba történt betöltés közben, és a betöltés meghiúsult."

#. ResourceLoader.THREAD_LOAD_LOADED
#: doc/classes/ResourceLoader.xml
msgid "The resource was loaded successfully and can be accessed via [method load_threaded_get]."
msgstr "Az erőforrás betöltése sikeres. Az erőforrás a [method load_threaded_get] metódussal érhető el."

#. ResourceSaver.brief
#: doc/classes/ResourceSaver.xml
msgid "A singleton for saving [Resource]s to the filesystem."
msgstr "Globális példány a [Resource] erőforrások fájlrendszerbe mentéséhez."

#. ResourceSaver.description
#: doc/classes/ResourceSaver.xml
msgid "A singleton for saving resource types to the filesystem.\nIt uses the many [ResourceFormatSaver] classes registered in the engine (either built-in or from a plugin) to save resource data to text-based (e.g. [code].tres[/code] or [code].tscn[/code]) or binary files (e.g. [code].res[/code] or [code].scn[/code])."
msgstr "Globális példány, amely erőforrásokat ment a fájlrendszerbe.\nA motorban regisztrált, beépített vagy bővítményből származó [ResourceFormatSaver] osztályokkal menti az adatokat szöveges (például [code].tres[/code] vagy [code].tscn[/code]) vagy bináris fájlba (például [code].res[/code] vagy [code].scn[/code])."

#. ResourceSaver.add_resource_format_saver
#: doc/classes/ResourceSaver.xml
msgid "Registers a new [ResourceFormatSaver]. The ResourceSaver will use the ResourceFormatSaver as described in [method save].\nThis method is performed implicitly for ResourceFormatSavers written in GDScript (see [ResourceFormatSaver] for more information)."
msgstr "Új [ResourceFormatSaver] mentőt regisztrál. A ResourceSaver a [method save] leírása szerint használja.\nA GDScriptben írt ResourceFormatSaver osztályokat a motor automatikusan regisztrálja (további információkért lásd: [ResourceFormatSaver])."

#. ResourceSaver.get_recognized_extensions
#: doc/classes/ResourceSaver.xml
msgid "Returns the list of extensions available for saving a resource of a given type."
msgstr "Felsorolja az adott típusú erőforrás mentéséhez használható fájlkiterjesztéseket."

#. ResourceSaver.get_resource_id_for_path
#: doc/classes/ResourceSaver.xml
msgid "Returns the resource ID for the given path. If [param generate] is [code]true[/code], a new resource ID will be generated if one for the path is not found. If [param generate] is [code]false[/code] and the path is not found, [constant ResourceUID.INVALID_ID] is returned."
msgstr "Visszaadja az adott útvonalhoz tartozó erőforrás-azonosítót. Ha a [param generate] értéke [code]true[/code], és az útvonalhoz nem található azonosító, újat állít elő. Ha a [param generate] értéke [code]false[/code], és az útvonal nem található, az eredmény [constant ResourceUID.INVALID_ID]."

#. ResourceSaver.remove_resource_format_saver
#: doc/classes/ResourceSaver.xml
msgid "Unregisters the given [ResourceFormatSaver]."
msgstr "Törli a megadott [ResourceFormatSaver] regisztrációját."

#. ResourceSaver.save
#: doc/classes/ResourceSaver.xml
msgid "Saves a resource to disk to the given path, using a [ResourceFormatSaver] that recognizes the resource object. If [param path] is empty, [ResourceSaver] will try to use [member Resource.resource_path].\nThe [param flags] bitmask can be specified to customize the save behavior.\nReturns [constant OK] on success.\n[b]Note:[/b] When the project is running, any generated UID associated with the resource will not be saved as the required code is only executed in editor mode."
msgstr "A megadott útvonalra menti az erőforrást az erőforrásobjektumot felismerő [ResourceFormatSaver] segítségével. Ha a [param path] üres, a [ResourceSaver] megpróbálja a [member Resource.resource_path] útvonalat használni.\nA mentés viselkedése a [param flags] bitmaszkkal szabályozható.\nSiker esetén [constant OK] értéket ad vissza.\n[b]Megjegyzés:[/b] A futó projektben az erőforráshoz előállított UID nem kerül mentésre, mert a szükséges kód csak szerkesztői módban fut le."

#. ResourceSaver.set_uid
#: doc/classes/ResourceSaver.xml
msgid "Sets the UID of the given [param resource] path to [param uid]. You can generate a new UID using [method ResourceUID.create_id].\nSince resources will normally get a UID automatically, this method is only useful in very specific cases."
msgstr "A megadott [param resource] útvonal egyedi azonosítóját a [param uid] értékre állítja. Új UID-t a [method ResourceUID.create_id] metódussal hozhatsz létre.\nAz erőforrások általában automatikusan kapnak UID-t, ezért ez a metódus csak különleges esetekben hasznos."

#. ResourceSaver.FLAG_NONE
#: doc/classes/ResourceSaver.xml
msgid "No resource saving option."
msgstr "Nincs beállítva erőforrás-mentési opció."

#. ResourceSaver.FLAG_RELATIVE_PATHS
#: doc/classes/ResourceSaver.xml
msgid "Save the resource with a path relative to the scene which uses it."
msgstr "Az erőforrást az azt használó jelenethez viszonyított útvonallal menti."

#. ResourceSaver.FLAG_BUNDLE_RESOURCES
#: doc/classes/ResourceSaver.xml
msgid "Bundles external resources."
msgstr "A külső erőforrásokat is becsomagolja."

#. ResourceSaver.FLAG_CHANGE_PATH
#: doc/classes/ResourceSaver.xml
msgid "Changes the [member Resource.resource_path] of the saved resource to match its new location."
msgstr "Úgy módosítja a mentett erőforrás [member Resource.resource_path] tulajdonságát, hogy az az új helyére mutasson."

#. ResourceSaver.FLAG_OMIT_EDITOR_PROPERTIES
#: doc/classes/ResourceSaver.xml
msgid "Do not save editor-specific metadata (identified by their [code]__editor[/code] prefix)."
msgstr "Kihagyja a mentésből a szerkesztő saját metaadatait, amelyeket a [code]__editor[/code] előtag azonosít."

#. ResourceSaver.FLAG_SAVE_BIG_ENDIAN
#: doc/classes/ResourceSaver.xml
msgid "Save as big endian (see [member FileAccess.big_endian])."
msgstr "Nagy bájtsorrendben ment (lásd: [member FileAccess.big_endian])."

#. ResourceSaver.FLAG_COMPRESS
#: doc/classes/ResourceSaver.xml
msgid "Compress the resource on save using [constant FileAccess.COMPRESSION_ZSTD]. Only available for binary resource types."
msgstr "Mentéskor a [constant FileAccess.COMPRESSION_ZSTD] módszerrel tömöríti az erőforrást. Csak bináris erőforrástípusoknál használható."

#. ResourceSaver.FLAG_REPLACE_SUBRESOURCE_PATHS
#: doc/classes/ResourceSaver.xml
msgid "Take over the paths of the saved subresources (see [method Resource.take_over_path])."
msgstr "Átveszi a mentett alerőforrások útvonalait (lásd: [method Resource.take_over_path])."

#. Node.is_processing_unhandled_key_input
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the node is processing unhandled key input (see [method set_process_unhandled_key_input])."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont feldolgozza a még nem kezelt billentyűbemenetet (lásd: [method set_process_unhandled_key_input])."

#. Node.move_child
#: doc/classes/Node.xml
msgid "Moves [param child_node] to the given index. A node's index is the order among its siblings. If [param to_index] is negative, the index is counted from the end of the list. See also [method get_child] and [method get_index].\n[b]Note:[/b] The processing order of several engine callbacks ([method _ready], [method _process], etc.) and notifications sent through [method propagate_notification] is affected by tree order. [CanvasItem] nodes are also rendered in tree order. See also [member process_priority]."
msgstr "A [param child_node] gyermeket a megadott indexre mozgatja. A csomópont indexe a testvérei közötti sorrendjét adja meg. Negatív [param to_index] értéknél az index a lista végétől számít. Lásd még a [method get_child] és a [method get_index] metódust.\n[b]Megjegyzés:[/b] A fa sorrendje a motor számos visszahívásának (például [method _ready] és [method _process]), valamint a [method propagate_notification] értesítéseinek feldolgozási sorrendjét is befolyásolja. A [CanvasItem] csomópontok is a fa sorrendjében rajzolódnak ki. Lásd még a [member process_priority] tulajdonságot."

#. Node.notify_deferred_thread_group
#: doc/classes/Node.xml
msgid "Similar to [method call_deferred_thread_group], but for notifications."
msgstr "A [method call_deferred_thread_group] metódushoz hasonló, de értesítésekhez használható."

#. Node.notify_thread_safe
#: doc/classes/Node.xml
msgid "Similar to [method call_thread_safe], but for notifications."
msgstr "A [method call_thread_safe] metódushoz hasonló, de értesítésekhez használható."

#. Node.print_orphan_nodes
#: doc/classes/Node.xml
msgid "Prints all orphan nodes (nodes outside the [SceneTree]). Useful for debugging.\n[b]Note:[/b] This method only works in debug builds. It does nothing in a project exported in release mode."
msgstr "Kiírja az összes árva, vagyis a [SceneTree] jelenetfán kívüli csomópontot. Hibakereséshez hasznos.\n[b]Megjegyzés:[/b] A metódus csak hibakeresési buildben működik. Kiadási módban exportált projektben nincs hatása."

#. Node.print_tree
#: doc/classes/Node.xml
msgid "Prints the node and its children to the console, recursively. The node does not have to be inside the tree. This method outputs [NodePath]s relative to this node, and is good for copy/pasting into [method get_node]. See also [method print_tree_pretty].\nMay print, for example:\n[codeblock lang=text]\n.\nMenu\nMenu/Label\nMenu/Camera2D\nSplashScreen\nSplashScreen/Camera2D\n[/codeblock]"
msgstr "Rekurzívan kiírja a konzolra a csomópontot és gyermekeit. A csomópontnak nem kell a fában lennie. A metódus ehhez a csomóponthoz viszonyított [NodePath] útvonalakat ír ki, amelyeket könnyen átmásolhatsz a [method get_node] metódus hívásába. Lásd még a [method print_tree_pretty] metódust.\nPélda a lehetséges kimenetre:\n[codeblock lang=text]\n.\nMenu\nMenu/Label\nMenu/Camera2D\nSplashScreen\nSplashScreen/Camera2D\n[/codeblock]"

#. Node.print_tree_pretty
#: doc/classes/Node.xml
msgid "Prints the node and its children to the console, recursively. The node does not have to be inside the tree. Similar to [method print_tree], but the graphical representation looks like what is displayed in the editor's Scene dock. It is useful for inspecting larger trees.\nMay print, for example:\n[codeblock lang=text]\n ┖╴TheGame\n    ┠╴Menu\n    ┃  ┠╴Label\n    ┃  ┖╴Camera2D\n    ┖╴SplashScreen\n       ┖╴Camera2D\n[/codeblock]"
msgstr "Rekurzívan kiírja a konzolra a csomópontot és gyermekeit. A csomópontnak nem kell a fában lennie. A [method print_tree] metódushoz hasonló, de a fa a szerkesztő Jelenet paneljéhez hasonló, áttekinthető formában jelenik meg. Nagyobb fák vizsgálatához hasznos.\nPélda a lehetséges kimenetre:\n[codeblock lang=text]\n ┖╴TheGame\n    ┠╴Menu\n    ┃  ┠╴Label\n    ┃  ┖╴Camera2D\n    ┖╴SplashScreen\n       ┖╴Camera2D\n[/codeblock]"

#. Node.propagate_call
#: doc/classes/Node.xml
msgid "Calls the given [param method] name, passing [param args] as arguments, on this node and all of its children, recursively.\nIf [param parent_first] is [code]true[/code], the method is called on this node first, then on all of its children. If [code]false[/code], the children's methods are called first."
msgstr "Rekurzívan meghívja a megadott nevű [param method] metódust ezen a csomóponton és összes gyermekén, a [param args] argumentumokkal.\nHa a [param parent_first] értéke [code]true[/code], először ezen a csomóponton fut le a metódus, majd az összes gyermekén. [code]false[/code] értéknél a gyermekek metódusai futnak előbb."

#. Node.propagate_notification
#: doc/classes/Node.xml
msgid "Calls [method Object.notification] with [param what] on this node and all of its children, recursively."
msgstr "Rekurzívan meghívja a [method Object.notification] metódust a [param what] értékkel ezen a csomóponton és összes gyermekén."

#. Node.queue_accessibility_update
#: doc/classes/Node.xml
msgid "Queues an accessibility information update for this node."
msgstr "Akadálymentességi adatfrissítést ütemez ehhez a csomóponthoz."

#. Node.queue_free
#: doc/classes/Node.xml
msgid "Queues this node to be deleted at the end of the current frame. When deleted, all of its children are deleted as well, and all references to the node and its children become invalid.\nUnlike with [method Object.free], the node is not deleted instantly, and it can still be accessed before deletion. It is also safe to call [method queue_free] multiple times. Use [method Object.is_queued_for_deletion] to check if the node will be deleted at the end of the frame.\n[b]Note:[/b] The node will only be freed after all other deferred calls are finished. Using this method is not always the same as calling [method Object.free] through [method Object.call_deferred]."
msgstr "Az aktuális képkocka végére ütemezi a csomópont törlését. Törléskor az összes gyermeke is törlődik, és a csomópontra, illetve a gyermekeire mutató hivatkozások érvénytelenné válnak.\nA [method Object.free] metódustól eltérően a csomópont törlése nem azonnali, így a törlésig továbbra is elérhető. A [method queue_free] biztonságosan meghívható többször is. A [method Object.is_queued_for_deletion] metódussal ellenőrizheted, hogy a csomópont a képkocka végén törlődik-e.\n[b]Megjegyzés:[/b] A motor csak az összes többi késleltetett hívás befejezése után szabadítja fel a csomópontot. Ez eltérhet a [method Object.free] metódus [method Object.call_deferred] segítségével történő meghívásától."

#. Node.remove_child
#: doc/classes/Node.xml
msgid "Removes a child [param node]. The [param node], along with its children, are [b]not[/b] deleted. To delete a node, see [method queue_free].\n[b]Note:[/b] When this node is inside the tree, this method sets the [member owner] of the removed [param node] (or its descendants) to [code]null[/code], if their [member owner] is no longer an ancestor (see [method is_ancestor_of])."
msgstr "Eltávolítja a [param node] gyermekcsomópontot. A [param node] és a gyermekei [b]nem[/b] törlődnek. A törléshez lásd a [method queue_free] metódust.\n[b]Megjegyzés:[/b] Ha ez a csomópont a fában van, a metódus az eltávolított [param node] vagy leszármazottai [member owner] értékét [code]null[/code] értékre állítja, ha a [member owner] már nem a felmenőjük (lásd: [method is_ancestor_of])."

#. Node.remove_from_group
#: doc/classes/Node.xml
msgid "Removes the node from the given [param group]. Does nothing if the node is not in the [param group]. See also notes in the description, and the [SceneTree]'s group methods."
msgstr "Eltávolítja a csomópontot a megadott [param group] csoportból. Ha a csomópont nem tagja a [param group] csoportnak, nincs hatása. Lásd még az osztályleírás megjegyzéseit és a [SceneTree] csoportkezelő metódusait."

#. CharacterBody2D.MOTION_MODE_GROUNDED
#: doc/classes/CharacterBody2D.xml
msgid "Apply when notions of walls, ceiling and floor are relevant. In this mode the body motion will react to slopes (acceleration/slowdown). This mode is suitable for sided games like platformers."
msgstr "Akkor használd, ha van jelentősége annak, hogy az ütközés fallal, mennyezettel vagy padlóval történik. Ebben a módban a lejtők gyorsítják vagy lassítják a testet. Oldalnézetes játékokhoz, például platformjátékokhoz alkalmas."

#. CharacterBody2D.MOTION_MODE_FLOATING
#: doc/classes/CharacterBody2D.xml
msgid "Apply when there is no notion of floor or ceiling. All collisions will be reported as [code]on_wall[/code]. In this mode, when you slide, the speed will always be constant. This mode is suitable for top-down games."
msgstr "Akkor használd, ha nincs padló vagy mennyezet. Minden ütközést [code]on_wall[/code] állapotként jelez. Csúszás közben a sebesség nagysága állandó marad. Felülnézetes játékokhoz alkalmas."

#. CharacterBody2D.PLATFORM_ON_LEAVE_ADD_VELOCITY
#. CharacterBody3D.PLATFORM_ON_LEAVE_ADD_VELOCITY
#: doc/classes/CharacterBody2D.xml doc/classes/CharacterBody3D.xml
msgid "Add the last platform velocity to the [member velocity] when you leave a moving platform."
msgstr "A mozgó platform elhagyásakor annak utolsó sebességét hozzáadja a [member velocity] értékéhez."

#. CharacterBody2D.PLATFORM_ON_LEAVE_ADD_UPWARD_VELOCITY
#. CharacterBody3D.PLATFORM_ON_LEAVE_ADD_UPWARD_VELOCITY
#: doc/classes/CharacterBody2D.xml doc/classes/CharacterBody3D.xml
msgid "Add the last platform velocity to the [member velocity] when you leave a moving platform, but any downward motion is ignored. It's useful to keep full jump height even when the platform is moving down."
msgstr "A mozgó platform elhagyásakor hozzáadja annak utolsó sebességét a [member velocity] értékéhez, a lefelé irányuló összetevő figyelmen kívül hagyásával. Így lefelé mozgó platformról is teljes magasságra ugorhatsz."

#. CharacterBody2D.PLATFORM_ON_LEAVE_DO_NOTHING
#. CharacterBody3D.PLATFORM_ON_LEAVE_DO_NOTHING
#: doc/classes/CharacterBody2D.xml doc/classes/CharacterBody3D.xml
msgid "Do nothing when leaving a platform."
msgstr "A platform elhagyásakor nem módosítja a test sebességét."

#. CollisionObject2D._input_event
#: doc/classes/CollisionObject2D.xml
msgid "Accepts unhandled [InputEvent]s. [param shape_idx] is the child index of the clicked [Shape2D]. Connect to [signal input_event] to easily pick up these events.\n[b]Note:[/b] [method _input_event] requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set."
msgstr "A még nem kezelt [InputEvent] eseményeket fogadja. A [param shape_idx] annak a [Shape2D] alakzatnak a gyermekindexe, amelyre kattintottak. Az események egyszerű fogadásához kapcsolódj a [signal input_event] jelzéshez.\n[b]Megjegyzés:[/b] A [method _input_event] működéséhez a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani."

#. CollisionObject2D._mouse_enter
#: doc/classes/CollisionObject2D.xml
msgid "Called when the mouse pointer enters any of this object's shapes. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set. Note that moving between different shapes within a single [CollisionObject2D] won't cause this function to be called."
msgstr "Akkor hívódik meg, amikor az egérmutató belép az objektum valamelyik alakzatába. Ehhez a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani. Az egyazon [CollisionObject2D] alakzatai közötti mozgás nem hívja meg."

#. CollisionObject2D._mouse_exit
#: doc/classes/CollisionObject2D.xml
msgid "Called when the mouse pointer exits all this object's shapes. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set. Note that moving between different shapes within a single [CollisionObject2D] won't cause this function to be called."
msgstr "Akkor hívódik meg, amikor az egérmutató elhagyja az objektum összes alakzatát. Ehhez a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani. Az egyazon [CollisionObject2D] alakzatai közötti mozgás nem hívja meg."

#. CollisionObject2D._mouse_shape_enter
#: doc/classes/CollisionObject2D.xml
msgid "Called when the mouse pointer enters any of this object's shapes or moves from one shape to another. [param shape_idx] is the child index of the newly entered [Shape2D]. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be called."
msgstr "Akkor hívódik meg, amikor az egérmutató belép az objektum valamelyik alakzatába, vagy az egyik alakzatból a másikba lép. A [param shape_idx] az újonnan érintett [Shape2D] gyermekindexe. A híváshoz a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani."

#. CollisionObject2D._mouse_shape_exit
#: doc/classes/CollisionObject2D.xml
msgid "Called when the mouse pointer exits any of this object's shapes. [param shape_idx] is the child index of the exited [Shape2D]. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be called."
msgstr "Akkor hívódik meg, amikor az egérmutató elhagyja az objektum valamelyik alakzatát. A [param shape_idx] az elhagyott [Shape2D] gyermekindexe. A híváshoz a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani."

#. CollisionObject2D.input_event
#: doc/classes/CollisionObject2D.xml
msgid "Emitted when an input event occurs. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set. See [method _input_event] for details."
msgstr "Bemeneti eseménykor küldi el. Ehhez a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani. A részleteket lásd a [method _input_event] metódusnál."

#. CollisionObject2D.mouse_entered
#: doc/classes/CollisionObject2D.xml
msgid "Emitted when the mouse pointer enters any of this object's shapes. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set. Note that moving between different shapes within a single [CollisionObject2D] won't cause this signal to be emitted.\n[b]Note:[/b] Due to the lack of continuous collision detection, this signal may not be emitted in the expected order if the mouse moves fast enough and the [CollisionObject2D]'s area is small. This signal may also not be emitted if another [CollisionObject2D] is overlapping the [CollisionObject2D] in question."
msgstr "Akkor küldi el, amikor az egérmutató belép az objektum valamelyik alakzatába. Ehhez a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani. Az egyazon [CollisionObject2D] alakzatai közötti mozgás nem váltja ki a jelzést.\n[b]Megjegyzés:[/b] Folyamatos ütközésérzékelés hiányában a jelzés eltérhet a várt sorrendtől, ha az egér gyorsan mozog, és a [CollisionObject2D] területe kicsi. A jelzés akkor is elmaradhat, ha egy másik [CollisionObject2D] átfedi a kérdéses [CollisionObject2D] objektumot."

#. CollisionObject2D.mouse_exited
#: doc/classes/CollisionObject2D.xml
msgid "Emitted when the mouse pointer exits all this object's shapes. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set. Note that moving between different shapes within a single [CollisionObject2D] won't cause this signal to be emitted.\n[b]Note:[/b] Due to the lack of continuous collision detection, this signal may not be emitted in the expected order if the mouse moves fast enough and the [CollisionObject2D]'s area is small. This signal may also not be emitted if another [CollisionObject2D] is overlapping the [CollisionObject2D] in question."
msgstr "Akkor küldi el, amikor az egérmutató az objektum összes alakzatát elhagyja. Ehhez a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani. Az egyazon [CollisionObject2D] alakzatai közötti mozgás nem váltja ki a jelzést.\n[b]Megjegyzés:[/b] Folyamatos ütközésérzékelés hiányában a jelzés eltérhet a várt sorrendtől, ha az egér gyorsan mozog, és a [CollisionObject2D] területe kicsi. A jelzés akkor is elmaradhat, ha egy másik [CollisionObject2D] átfedi a kérdéses [CollisionObject2D] objektumot."

#. CollisionObject2D.mouse_shape_entered
#: doc/classes/CollisionObject2D.xml
msgid "Emitted when the mouse pointer enters any of this object's shapes or moves from one shape to another. [param shape_idx] is the child index of the newly entered [Shape2D]. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set."
msgstr "Akkor küldi el, amikor az egérmutató belép az objektum valamelyik alakzatába, vagy az egyik alakzatból a másikba lép. A [param shape_idx] az újonnan érintett [Shape2D] gyermekindexe. A jelzéshez a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani."

#. CollisionObject2D.mouse_shape_exited
#: doc/classes/CollisionObject2D.xml
msgid "Emitted when the mouse pointer exits any of this object's shapes. [param shape_idx] is the child index of the exited [Shape2D]. Requires [member input_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set."
msgstr "Akkor küldi el, amikor az egérmutató elhagyja az objektum valamelyik alakzatát. A [param shape_idx] az elhagyott [Shape2D] gyermekindexe. A jelzéshez a [member input_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani."

#. CollisionObject2D.DISABLE_MODE_REMOVE
#: doc/classes/CollisionObject2D.xml
msgid "When [member Node.process_mode] is set to [constant Node.PROCESS_MODE_DISABLED], remove from the physics simulation to stop all physics interactions with this [CollisionObject2D].\nAutomatically re-added to the physics simulation when the [Node] is processed again."
msgstr "Ha a [member Node.process_mode] értéke [constant Node.PROCESS_MODE_DISABLED], eltávolítja ezt a [CollisionObject2D] objektumot a fizikai szimulációból, így megszűnik minden fizikai kölcsönhatása.\nA motor automatikusan visszahelyezi a fizikai szimulációba, amikor a [Node] feldolgozása újra elindul."

#. CollisionObject2D.DISABLE_MODE_MAKE_STATIC
#: doc/classes/CollisionObject2D.xml
msgid "When [member Node.process_mode] is set to [constant Node.PROCESS_MODE_DISABLED], make the body static. Doesn't affect [Area2D]. [PhysicsBody2D] can't be affected by forces or other bodies while static.\nAutomatically set [PhysicsBody2D] back to its original mode when the [Node] is processed again."
msgstr "Ha a [member Node.process_mode] értéke [constant Node.PROCESS_MODE_DISABLED], statikussá teszi a testet. Az [Area2D] területekre nincs hatással. A statikus [PhysicsBody2D] testre nem hatnak az erők és a többi test.\nA motor automatikusan visszaállítja a [PhysicsBody2D] eredeti módját, amikor a [Node] feldolgozása újra elindul."

#. CollisionPolygon2D.BUILD_SOLIDS
#: doc/classes/CollisionPolygon2D.xml
msgid "Collisions will include the polygon and its contained area. In this mode the node has the same effect as several [ConvexPolygonShape2D] nodes, one for each convex shape in the convex decomposition of the polygon (but without the overhead of multiple nodes)."
msgstr "Az ütközésérzékelés a sokszög határát és belsejét is figyelembe veszi. A csomópont úgy viselkedik, mintha a sokszög konvex felbontásának minden eleméhez külön [ConvexPolygonShape2D] alakzat tartozna, a több csomópont többletterhelése nélkül."

#. DampedSpringJoint2D.damping
#: doc/classes/DampedSpringJoint2D.xml
msgid "The spring joint's damping ratio. A value between [code]0[/code] and [code]1[/code]. When the two bodies move into different directions the system tries to align them to the spring axis again. A high [member damping] value forces the attached bodies to align faster."
msgstr "A rugós csukló csillapítási aránya [code]0[/code] és [code]1[/code] között. Ha a két test eltérő irányba mozog, a rendszer újra a rugó tengelyéhez igazítja őket. Nagyobb [member damping] értéknél az összekapcsolt testek gyorsabban igazodnak."

#. DampedSpringJoint2D.length
#: doc/classes/DampedSpringJoint2D.xml
msgid "The spring joint's maximum length. The two attached bodies cannot stretch it past this value."
msgstr "A rugós csukló legnagyobb hossza. Az összekapcsolt testek ennél hosszabbra nem nyújthatják a rugót."

#. PhysicsDirectBodyState2D.description
#: doc/classes/PhysicsDirectBodyState2D.xml
msgid "Provides direct access to a physics body in the [PhysicsServer2D], allowing safe changes to physics properties. This object is passed via the direct state callback of [RigidBody2D], and is intended for changing the direct state of that body. See [method RigidBody2D._integrate_forces]."
msgstr "Közvetlen hozzáférést biztosít a [PhysicsServer2D] fizikai testéhez, így annak fizikai tulajdonságai biztonságosan módosíthatók. A [RigidBody2D] a közvetlen állapotot kezelő visszahívásának adja át ezt az objektumot. A test állapotát ezen keresztül módosíthatod. Lásd a [method RigidBody2D._integrate_forces] metódust."

#. PhysicsDirectBodyState2D.apply_torque
#: doc/classes/PhysicsDirectBodyState2D.xml
msgid "Applies a rotational force without affecting position. A force is time dependent and meant to be applied every physics update.\n[b]Note:[/b] [member inverse_inertia] is required for this to work. To have [member inverse_inertia], an active [CollisionShape2D] must be a child of the node, or you can manually set [member inverse_inertia]."
msgstr "Forgatónyomatékot fejt ki a test helyzetének módosítása nélkül. Az erő időfüggő, ezért minden fizikai frissítéskor alkalmazni kell.\n[b]Megjegyzés:[/b] A működéshez [member inverse_inertia] érték szükséges. A [member inverse_inertia] kiszámításához a csomópontnak aktív [CollisionShape2D] gyermekkel kell rendelkeznie, illetve a [member inverse_inertia] kézzel is beállítható."

#. PhysicsDirectBodyState2D.apply_torque_impulse
#: doc/classes/PhysicsDirectBodyState2D.xml
msgid "Applies a rotational impulse to the body without affecting the position.\nAn impulse is time-independent! Applying an impulse every frame would result in a framerate-dependent force. For this reason, it should only be used when simulating one-time impacts (use the \"_force\" functions otherwise).\n[b]Note:[/b] [member inverse_inertia] is required for this to work. To have [member inverse_inertia], an active [CollisionShape2D] must be a child of the node, or you can manually set [member inverse_inertia]."
msgstr "Forgási impulzust ad a testnek a helyzet módosítása nélkül.\nAz impulzus időfüggetlen. Ha minden képkockán impulzust alkalmaznál, a hatás a képkockasebességtől függne. Ezért csak egyszeri behatás szimulálására használd. Folyamatos hatáshoz a „_force” függvényeket használd.\n[b]Megjegyzés:[/b] A működéshez [member inverse_inertia] érték szükséges. A [member inverse_inertia] kiszámításához a csomópontnak aktív [CollisionShape2D] gyermekkel kell rendelkeznie, illetve a [member inverse_inertia] kézzel is beállítható."

#. PhysicsDirectBodyState2D.get_contact_count
#: doc/classes/PhysicsDirectBodyState2D.xml
msgid "Returns the number of contacts this body has with other bodies.\n[b]Note:[/b] By default, this returns 0 unless bodies are configured to monitor contacts. See [member RigidBody2D.contact_monitor]."
msgstr "Visszaadja a test többi testtel való érintkezéseinek számát.\n[b]Megjegyzés:[/b] Alapértelmezésben 0-t ad vissza, amíg a testeken nincs beállítva az érintkezésfigyelés. Lásd a [member RigidBody2D.contact_monitor] tulajdonságot."

#. Area3D.description
#: doc/classes/Area3D.xml
msgid "[Area3D] is a region of 3D space defined by one or multiple [CollisionShape3D] or [CollisionPolygon3D] child nodes. It detects when other [CollisionObject3D]s enter or exit it, and it also keeps track of which collision objects haven't exited it yet (i.e. which one are overlapping it).\nThis node can also locally alter or override physics parameters (gravity, damping) and route audio to custom audio buses.\n[b]Note:[/b] Areas and bodies created with [PhysicsServer3D] might not interact as expected with [Area3D]s, and might not emit signals or track objects correctly.\n[b]Warning:[/b] Using a [ConcavePolygonShape3D] inside a [CollisionShape3D] child of this node (created e.g. by using the [b]Create Trimesh Collision Sibling[/b] option in the [b]Mesh[/b] menu that appears when selecting a [MeshInstance3D] node) may give unexpected results, since this collision shape is hollow. If this is not desired, it has to be split into multiple [ConvexPolygonShape3D]s or primitive shapes like [BoxShape3D], or in some cases it may be replaceable by a [CollisionPolygon3D]."
msgstr "Az [Area3D] a 3D tér olyan része, amelyet egy vagy több [CollisionShape3D] vagy [CollisionPolygon3D] gyermekcsomópont határoz meg. Érzékeli más [CollisionObject3D] objektumok be- és kilépését, és nyilvántartja azokat is, amelyek még benne vannak, vagyis átfedik.\nA csomópont helyben módosíthatja vagy felülírhatja a fizikai paramétereket, például a gravitációt és a csillapítást, illetve egyéni hangbuszokra irányíthatja a hangot.\n[b]Megjegyzés:[/b] A [PhysicsServer3D] segítségével létrehozott területek és testek kölcsönhatása az [Area3D] területekkel eltérhet a várttól. Lehet, hogy nem küldenek jelzéseket, vagy nem követik helyesen az objektumokat.\n[b]Figyelmeztetés:[/b] Ha a csomópont [CollisionShape3D] gyermekében [ConcavePolygonShape3D] alakzatot használsz, váratlan eredményt kaphatsz, mert az alakzat üreges. Ilyen alakzat keletkezhet például a [MeshInstance3D] csomópont kiválasztásakor megjelenő [b]Mesh[/b] menü [b]Create Trimesh Collision Sibling[/b] parancsával. Ennek elkerüléséhez bontsd fel több [ConvexPolygonShape3D] alakzatra vagy egyszerű, például [BoxShape3D] alakzatokra. Bizonyos esetekben [CollisionPolygon3D] is használható helyette."

#. Area3D.get_overlapping_areas
#: doc/classes/Area3D.xml
msgid "Returns a list of intersecting [Area3D]s. The overlapping area's [member CollisionObject3D.collision_layer] must be part of this area's [member CollisionObject3D.collision_mask] in order to be detected.\nFor performance reasons (collisions are all processed at the same time) this list is modified once during the physics step, not immediately after objects are moved. Consider using signals instead."
msgstr "Visszaadja az átfedő [Area3D] területek listáját. A motor akkor érzékeli a másik területet, ha annak [member CollisionObject3D.collision_layer] rétege szerepel ennek a területnek a [member CollisionObject3D.collision_mask] maszkjában.\nTeljesítménybeli okokból a motor egyszerre dolgozza fel az ütközéseket, és fizikai lépésenként egyszer frissíti a listát. Így az elmozdítás hatása nem látszik azonnal. Ehhez érdemes jelzéseket használni."

#. Area3D.get_overlapping_bodies
#: doc/classes/Area3D.xml
msgid "Returns a list of intersecting [PhysicsBody3D]s, [SoftBody3D]s, and [GridMap]s. The overlapping body's [member CollisionObject3D.collision_layer] must be part of this area's [member CollisionObject3D.collision_mask] in order to be detected.\nFor performance reasons (collisions are all processed at the same time) this list is modified once during the physics step, not immediately after objects are moved. Consider using signals instead.\n[b]Note:[/b] Godot Physics does not support reporting overlaps with [SoftBody3D], so will not return any such bodies."
msgstr "Visszaadja az átfedő [PhysicsBody3D], [SoftBody3D] és [GridMap] objektumok listáját. A motor akkor érzékeli az átfedő testet, ha annak [member CollisionObject3D.collision_layer] rétege szerepel ennek a területnek a [member CollisionObject3D.collision_mask] maszkjában.\nTeljesítménybeli okokból a motor egyszerre dolgozza fel az ütközéseket, és fizikai lépésenként egyszer frissíti a listát. Így az elmozdítás hatása nem látszik azonnal. Ehhez érdemes jelzéseket használni.\n[b]Megjegyzés:[/b] A Godot Physics nem jelenti a [SoftBody3D] átfedéseit, így az ilyen testek kimaradnak a listából."

#. Area3D.has_overlapping_areas
#: doc/classes/Area3D.xml
msgid "Returns [code]true[/code] if intersecting any [Area3D]s, otherwise returns [code]false[/code]. The overlapping area's [member CollisionObject3D.collision_layer] must be part of this area's [member CollisionObject3D.collision_mask] in order to be detected.\nFor performance reasons (collisions are all processed at the same time) the list of overlapping areas is modified once during the physics step, not immediately after objects are moved. Consider using signals instead."
msgstr "[code]true[/code] értéket ad vissza, ha van átfedő [Area3D] terület, egyébként [code]false[/code] értéket. A motor akkor érzékeli a másik területet, ha annak [member CollisionObject3D.collision_layer] rétege szerepel ennek a területnek a [member CollisionObject3D.collision_mask] maszkjában.\nTeljesítménybeli okokból a motor egyszerre dolgozza fel az ütközéseket, és fizikai lépésenként egyszer frissíti az átfedő területek listáját. Így az elmozdítás hatása nem látszik azonnal. Ehhez érdemes jelzéseket használni."

#. Area3D.has_overlapping_bodies
#: doc/classes/Area3D.xml
msgid "Returns [code]true[/code] if intersecting any [PhysicsBody3D]s, [SoftBody3D]s, or [GridMap]s, otherwise returns [code]false[/code]. The overlapping body's [member CollisionObject3D.collision_layer] must be part of this area's [member CollisionObject3D.collision_mask] in order to be detected.\nFor performance reasons (collisions are all processed at the same time) the list of overlapping bodies is modified once during the physics step, not immediately after objects are moved. Consider using signals instead.\n[b]Note:[/b] Godot Physics does not support reporting overlaps with [SoftBody3D], so will not consider such bodies."
msgstr "[code]true[/code] értéket ad vissza, ha van átfedő [PhysicsBody3D], [SoftBody3D] vagy [GridMap] objektum, egyébként [code]false[/code] értéket. A motor akkor érzékeli az átfedő testet, ha annak [member CollisionObject3D.collision_layer] rétege szerepel ennek a területnek a [member CollisionObject3D.collision_mask] maszkjában.\nTeljesítménybeli okokból a motor egyszerre dolgozza fel az ütközéseket, és fizikai lépésenként egyszer frissíti az átfedő testek listáját. Így az elmozdítás hatása nem látszik azonnal. Ehhez érdemes jelzéseket használni.\n[b]Megjegyzés:[/b] A Godot Physics nem jelenti a [SoftBody3D] átfedéseit, így az ilyen testeket figyelmen kívül hagyja."

#. Area3D.overlaps_area
#: doc/classes/Area3D.xml
msgid "Returns [code]true[/code] if the given [Area3D] intersects or overlaps this [Area3D], [code]false[/code] otherwise.\n[b]Note:[/b] The result of this test is not immediate after moving objects. For performance, list of overlaps is updated once per frame and before the physics step. Consider using signals instead."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [Area3D] metszi vagy átfedi ezt az [Area3D] területet, egyébként [code]false[/code] értéket.\n[b]Megjegyzés:[/b] Az objektumok mozgatása után az eredmény nem frissül azonnal. A motor teljesítménybeli okokból képkockánként egyszer, a fizikai lépés előtt frissíti az átfedési listát. Ehhez érdemes jelzéseket használni."

#. Area3D.overlaps_body
#: doc/classes/Area3D.xml
msgid "Returns [code]true[/code] if the given physics body intersects or overlaps this [Area3D], [code]false[/code] otherwise.\n[param body] argument can either be a [PhysicsBody3D], [SoftBody3D], or a [GridMap] instance. While GridMaps are not physics body themselves, they register their tiles with collision shapes as a virtual physics body.\n[b]Note:[/b] The result of this test is not immediate after moving objects. For performance, list of overlaps is updated once per frame and before the physics step. Consider using signals instead.\n[b]Note:[/b] Godot Physics does not support reporting overlaps with [SoftBody3D], so will return [code]false[/code] in such cases."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott fizikai test metszi vagy átfedi ezt az [Area3D] területet, egyébként [code]false[/code] értéket.\nA [param body] lehet [PhysicsBody3D], [SoftBody3D] vagy [GridMap] példány. A GridMap önmagában nem fizikai test, de az ütközési alakzatos csempéit virtuális fizikai testként regisztrálja.\n[b]Megjegyzés:[/b] Az objektumok mozgatása után az eredmény nem frissül azonnal. A motor teljesítménybeli okokból képkockánként egyszer, a fizikai lépés előtt frissíti az átfedési listát. Ehhez érdemes jelzéseket használni.\n[b]Megjegyzés:[/b] A Godot Physics nem jelenti a [SoftBody3D] átfedéseit, ezért ilyen esetben [code]false[/code] értéket ad vissza."

#. Area3D.area_shape_entered
#: doc/classes/Area3D.xml
msgid "Emitted when a [Shape3D] of the received [param area] enters a shape of this area. Requires [member monitoring] to be set to [code]true[/code].\n[param local_shape_index] and [param area_shape_index] contain indices of the interacting shapes from this area and the other area, respectively. [param area_rid] contains the [RID] of the other area. These values can be used with the [PhysicsServer3D].\n[b]Example:[/b] Get the [CollisionShape3D] node from the shape index:\n[codeblocks]\n[gdscript]\nvar other_shape_owner = area.shape_find_owner(area_shape_index)\nvar other_shape_node = area.shape_owner_get_owner(other_shape_owner)\n\nvar local_shape_owner = shape_find_owner(local_shape_index)\nvar local_shape_node = shape_owner_get_owner(local_shape_owner)\n[/gdscript]\n[/codeblocks]"
msgstr "Akkor küldi el, amikor a kapott [param area] egyik [Shape3D] alakzata belép ennek a területnek az egyik alakzatába. A [member monitoring] értékének [code]true[/code] értéken kell állnia.\nA [param local_shape_index] ennek a területnek, a [param area_shape_index] pedig a másik területnek az érintett alakzatindexe. A [param area_rid] a másik terület [RID] azonosítóját adja meg. Ezek az értékek a [PhysicsServer3D] felületével használhatók.\n[b]Példa:[/b] A [CollisionShape3D] csomópont lekérése az alakzat indexéből:\n[codeblocks]\n[gdscript]\nvar other_shape_owner = area.shape_find_owner(area_shape_index)\nvar other_shape_node = area.shape_owner_get_owner(other_shape_owner)\n\nvar local_shape_owner = shape_find_owner(local_shape_index)\nvar local_shape_node = shape_owner_get_owner(local_shape_owner)\n[/gdscript]\n[/codeblocks]"

#. Area3D.body_entered
#: doc/classes/Area3D.xml
msgid "Emitted when the received [param body] enters this area. [param body] can be a [PhysicsBody3D], [SoftBody3D] or [GridMap]. [GridMap]s are detected if their [MeshLibrary] has collision shapes configured. Requires [member monitoring] to be set to [code]true[/code].\n[b]Note:[/b] Godot Physics does not support reporting overlaps with [SoftBody3D], so will not emit this signal in such cases."
msgstr "Akkor küldi el, amikor a kapott [param body] belép a területre. A [param body] lehet [PhysicsBody3D], [SoftBody3D] vagy [GridMap]. A motor akkor érzékeli a [GridMap] csempéit, ha a [MeshLibrary] ütközési alakzatokat ad meg. A [member monitoring] értékének [code]true[/code] értéken kell állnia.\n[b]Megjegyzés:[/b] A Godot Physics nem jelenti a [SoftBody3D] átfedéseit, ezért ilyen esetben nem küldi el ezt a jelzést."

#. Area3D.body_exited
#: doc/classes/Area3D.xml
msgid "Emitted when the received [param body] exits this area. [param body] can be a [PhysicsBody3D], [SoftBody3D] or [GridMap]. [GridMap]s are detected if their [MeshLibrary] has collision shapes configured. Requires [member monitoring] to be set to [code]true[/code].\n[b]Note:[/b] Godot Physics does not support reporting overlaps with [SoftBody3D], so will not emit this signal in such cases."
msgstr "Akkor küldi el, amikor a kapott [param body] elhagyja a területet. A [param body] lehet [PhysicsBody3D], [SoftBody3D] vagy [GridMap]. A motor akkor érzékeli a [GridMap] csempéit, ha a [MeshLibrary] ütközési alakzatokat ad meg. A [member monitoring] értékének [code]true[/code] értéken kell állnia.\n[b]Megjegyzés:[/b] A Godot Physics nem jelenti a [SoftBody3D] átfedéseit, ezért ilyen esetben nem küldi el ezt a jelzést."

#. Area3D.body_shape_entered
#: doc/classes/Area3D.xml
msgid "Emitted when a [Shape3D] of the received [param body] enters a shape of this area. [param body] can be a [PhysicsBody3D], [SoftBody3D] or [GridMap]. [GridMap]s are detected if their [MeshLibrary] has collision shapes configured. Requires [member monitoring] to be set to [code]true[/code].\n[param local_shape_index] and [param body_shape_index] contain indices of the interacting shapes from this area and the interacting body, respectively. [param body_rid] contains the [RID] of the body. These values can be used with the [PhysicsServer3D].\n[b]Note:[/b] Godot Physics does not support reporting overlaps with [SoftBody3D], so will not emit this signal in such cases.\n[b]Example:[/b] Get the [CollisionShape3D] node from the shape index:\n[codeblocks]\n[gdscript]\nvar body_shape_owner = body.shape_find_owner(body_shape_index)\nvar body_shape_node = body.shape_owner_get_owner(body_shape_owner)\n\nvar local_shape_owner = shape_find_owner(local_shape_index)\nvar local_shape_node = shape_owner_get_owner(local_shape_owner)\n[/gdscript]\n[/codeblocks]"
msgstr "Akkor küldi el, amikor a kapott [param body] egyik [Shape3D] alakzata belép ennek a területnek az egyik alakzatába. A [param body] lehet [PhysicsBody3D], [SoftBody3D] vagy [GridMap]. A motor akkor érzékeli a [GridMap] csempéit, ha a [MeshLibrary] ütközési alakzatokat ad meg. A [member monitoring] értékének [code]true[/code] értéken kell állnia.\nA [param local_shape_index] a terület, a [param body_shape_index] pedig a test érintett alakzatának indexe. A [param body_rid] a test [RID] azonosítóját adja meg. Ezek az értékek a [PhysicsServer3D] felületével használhatók.\n[b]Megjegyzés:[/b] A Godot Physics nem jelenti a [SoftBody3D] átfedéseit, ezért ilyen esetben nem küldi el ezt a jelzést.\n[b]Példa:[/b] A [CollisionShape3D] csomópont lekérése az alakzat indexéből:\n[codeblocks]\n[gdscript]\nvar body_shape_owner = body.shape_find_owner(body_shape_index)\nvar body_shape_node = body.shape_owner_get_owner(body_shape_owner)\n\nvar local_shape_owner = shape_find_owner(local_shape_index)\nvar local_shape_node = shape_owner_get_owner(local_shape_owner)\n[/gdscript]\n[/codeblocks]"

#. Area3D.body_shape_exited
#: doc/classes/Area3D.xml
msgid "Emitted when a [Shape3D] of the received [param body] exits a shape of this area. [param body] can be a [PhysicsBody3D], [SoftBody3D] or [GridMap]. [GridMap]s are detected if their [MeshLibrary] has collision shapes configured. Requires [member monitoring] to be set to [code]true[/code].\nSee also [signal body_shape_entered].\n[b]Note:[/b] Godot Physics does not support reporting overlaps with [SoftBody3D], so will not emit this signal in such cases."
msgstr "Akkor küldi el, amikor a kapott [param body] egyik [Shape3D] alakzata elhagyja ennek a területnek az egyik alakzatát. A [param body] lehet [PhysicsBody3D], [SoftBody3D] vagy [GridMap]. A motor akkor érzékeli a [GridMap] csempéit, ha a [MeshLibrary] ütközési alakzatokat ad meg. A [member monitoring] értékének [code]true[/code] értéken kell állnia.\nLásd még a [signal body_shape_entered] jelzést.\n[b]Megjegyzés:[/b] A Godot Physics nem jelenti a [SoftBody3D] átfedéseit, ezért ilyen esetben nem küldi el ezt a jelzést."

#. Area3D.angular_damp
#: doc/classes/Area3D.xml
msgid "The rate at which objects stop spinning in this area. Represents the angular velocity lost per second.\nSee [member ProjectSettings.physics/3d/default_angular_damp] for more details about damping."
msgstr "A területen lévő objektumok forgásának csillapítási mértéke. A másodpercenként elvesztett szögsebességet fejezi ki.\nA csillapítás részleteit a [member ProjectSettings.physics/3d/default_angular_damp] tulajdonság ismerteti."

#. Area3D.gravity_point_unit_distance
#: doc/classes/Area3D.xml
msgid "The distance at which the gravity strength is equal to [member gravity]. For example, on a planet 100 meters in radius with a surface gravity of 4.0 m/s², set the [member gravity] to 4.0 and the unit distance to 100.0. The gravity will have falloff according to the inverse square law, so in the example, at 200 meters from the center the gravity will be 1.0 m/s² (twice the distance, 1/4th the gravity), at 50 meters it will be 16.0 m/s² (half the distance, 4x the gravity), and so on.\nThe above is true only when the unit distance is a positive number. When this is set to 0.0, the gravity will be constant regardless of distance."
msgstr "Az a távolság, amelynél a gravitáció erőssége megegyezik a [member gravity] értékével. Például egy 100 méter sugarú bolygón, amelynek felszínén a gravitáció 4.0 m/s², állítsd a [member gravity] értékét 4.0, az egységtávolságot 100.0 értékre. A gravitáció a távolság négyzetével fordított arányban gyengül. A középponttól 200 méterre 1.0 m/s² lesz (kétszeres távolság, 1/4-ed akkora gravitáció), 50 méterre pedig 16.0 m/s² (feleakkora távolság, 4-szeres gravitáció).\nEz csak pozitív egységtávolságnál érvényes. 0.0 értéknél a gravitáció a távolságtól függetlenül állandó."

#. Area3D.linear_damp
#: doc/classes/Area3D.xml
msgid "The rate at which objects stop moving in this area. Represents the linear velocity lost per second.\nSee [member ProjectSettings.physics/3d/default_linear_damp] for more details about damping."
msgstr "A területen lévő objektumok haladó mozgásának csillapítási mértéke. A másodpercenként elvesztett lineáris sebességet fejezi ki.\nA csillapítás részleteit a [member ProjectSettings.physics/3d/default_linear_damp] tulajdonság ismerteti."

#. Area3D.priority
#: doc/classes/Area3D.xml
msgid "The area's priority. Higher priority areas are processed first. The [World3D]'s physics is always processed last, after all areas."
msgstr "A terület prioritása. A motor először a nagyobb prioritású területeket dolgozza fel, a [World3D] fizikáját pedig mindig az összes terület után."

#. Area3D.reverb_bus_amount
#: doc/classes/Area3D.xml
msgid "The degree to which this area applies reverb to its associated audio. Ranges from [code]0[/code] to [code]1[/code] with [code]0.1[/code] precision."
msgstr "A terület hangjához kevert zengetés mértéke. [code]0[/code] és [code]1[/code] közötti érték [code]0.1[/code] pontossággal."

#. Area3D.reverb_bus_uniformity
#: doc/classes/Area3D.xml
msgid "The degree to which this area's reverb is a uniform effect. Ranges from [code]0[/code] to [code]1[/code] with [code]0.1[/code] precision."
msgstr "Megadja, mennyire egyenletes a terület zengetése. [code]0[/code] és [code]1[/code] közötti érték [code]0.1[/code] pontossággal."

#. CharacterBody3D.brief
#: doc/classes/CharacterBody3D.xml
msgid "A 3D physics body specialized for characters moved by script."
msgstr "Szkripttel mozgatott karakterekhez készült 3D fizikai test."

#. CharacterBody3D.description
#: doc/classes/CharacterBody3D.xml
msgid "[CharacterBody3D] is a specialized class for physics bodies that are meant to be user-controlled. They are not affected by physics at all, but they affect other physics bodies in their path. They are mainly used to provide high-level API to move objects with wall and slope detection ([method move_and_slide] method) in addition to the general collision detection provided by [method PhysicsBody3D.move_and_collide]. This makes it useful for highly configurable physics bodies that must move in specific ways and collide with the world, as is often the case with user-controlled characters.\nFor game objects that don't require complex movement or collision detection, such as moving platforms, [AnimatableBody3D] is simpler to configure."
msgstr "A [CharacterBody3D] a felhasználó által irányított fizikai testekhez készült osztály. Ezekre a testekre nem hat a fizika, de a mozgásuk útjába kerülő más testekre hatással vannak. A [method PhysicsBody3D.move_and_collide] általános ütközésérzékelése mellett a [method move_and_slide] magasabb szintű felületet ad a falakat és lejtőket érzékelő mozgáshoz. Ez akkor hasznos, ha a testnek meghatározott módon kell mozognia és ütköznie a környezettel, például egy irányítható játékoskarakternél.\nHa egy objektumnak nincs szüksége összetett mozgásra vagy ütközésérzékelésre, például egy mozgó platformnak, egyszerűbb az [AnimatableBody3D] beállítása."

#. CharacterBody3D.get_floor_angle
#: doc/classes/CharacterBody3D.xml
msgid "Returns the floor's collision angle at the last collision point according to [param up_direction], which is [constant Vector3.UP] by default. This value is always positive and only valid after calling [method move_and_slide] and when [method is_on_floor] returns [code]true[/code]."
msgstr "Visszaadja az utolsó ütközési pontban a padló szögét a [param up_direction] irányhoz viszonyítva, amely alapértelmezésben [constant Vector3.UP]. Az érték mindig pozitív, és csak a [method move_and_slide] hívása után érvényes, ha a [method is_on_floor] [code]true[/code] értéket ad vissza."

#. CharacterBody3D.get_last_motion
#: doc/classes/CharacterBody3D.xml
msgid "Returns the last motion applied to the [CharacterBody3D] during the last call to [method move_and_slide]. The movement can be split into multiple motions when sliding occurs, and this method return the last one, which is useful to retrieve the current direction of the movement."
msgstr "Visszaadja a [CharacterBody3D] testre a legutóbbi [method move_and_slide] hívás során alkalmazott utolsó elmozdulást. Csúszáskor a mozgás több elmozdulásra bomolhat. A metódus az utolsót adja vissza, amelyből meghatározható a mozgás aktuális iránya."

#. CharacterBody3D.get_last_slide_collision
#: doc/classes/CharacterBody3D.xml
msgid "Returns a [KinematicCollision3D] if a collision occurred. The returned value contains information about the latest collision that occurred during the last call to [method move_and_slide]. Returns [code]null[/code] if no collision occurred. See also [method get_slide_collision]."
msgstr "Ütközéskor [KinematicCollision3D] objektumot ad vissza. Ez a legutóbbi [method move_and_slide] hívás során észlelt utolsó ütközés adatait tartalmazza. Ha nem történt ütközés, az eredmény [code]null[/code]. Lásd még a [method get_slide_collision] metódust."

#. CharacterBody3D.get_platform_angular_velocity
#: doc/classes/CharacterBody3D.xml
msgid "Returns the angular velocity of the platform at the last collision point. Only valid after calling [method move_and_slide]."
msgstr "Visszaadja a platform szögsebességét az utolsó ütközési pontban. Csak a [method move_and_slide] hívása után érvényes."

#. CharacterBody3D.get_slide_collision
#: doc/classes/CharacterBody3D.xml
msgid "Returns a [KinematicCollision3D], which contains information about a collision that occurred during the last call to [method move_and_slide]. Since the body can collide several times in a single call to [method move_and_slide], you must specify the index of the collision in the range 0 to ([method get_slide_collision_count] - 1). See also [method get_last_slide_collision]."
msgstr "[KinematicCollision3D] objektumban adja vissza a legutóbbi [method move_and_slide] hívás egyik ütközésének adatait. Mivel a test egyetlen [method move_and_slide] hívás alatt többször is ütközhet, az ütközés indexét a 0 és a ([method get_slide_collision_count] - 1) közötti tartományban kell megadni. Lásd még a [method get_last_slide_collision] metódust."

#. CharacterBody3D.move_and_slide
#: doc/classes/CharacterBody3D.xml
msgid "Moves the body based on [member velocity]. If the body collides with another, it will slide along the other body rather than stop immediately. If the other body is a [CharacterBody3D] or [RigidBody3D], it will also be affected by the motion of the other body. You can use this to make moving and rotating platforms, or to make nodes push other nodes.\nThis method should be used in [method Node._physics_process] (or in a method called by [method Node._physics_process]), as it uses the physics step's [code]delta[/code] value automatically in calculations. Otherwise, the simulation will run at an incorrect speed.\nModifies [member velocity] if a slide collision occurred. To get the latest collision call [method get_last_slide_collision], for more detailed information about collisions that occurred, use [method get_slide_collision].\nWhen the body touches a moving platform, the platform's velocity is automatically added to the body motion. If a collision occurs due to the platform's motion, it will always be first in the slide collisions.\nReturns [code]true[/code] if the body collided, otherwise, returns [code]false[/code]."
msgstr "A [member velocity] alapján mozgatja a testet. Ütközéskor a test a másik test mentén továbbcsúszik. Ha a másik test [CharacterBody3D] vagy [RigidBody3D] típusú, rá is hat a másik test mozgása. Így mozgó és forgó platformokat hozhatsz létre, illetve a csomópontok eltolhatják egymást.\nA metódust a [method Node._physics_process] metódusban, vagy egy [method Node._physics_process] által meghívott metódusban használd, mert a számítások automatikusan a fizikai lépés [code]delta[/code] értékével dolgoznak. Egyébként a szimuláció sebessége hibás lesz.\nCsúszással járó ütközéskor módosítja a [member velocity] értékét. Az utolsó ütközést a [method get_last_slide_collision] metódussal, a részletes ütközési adatokat a [method get_slide_collision] metódussal kérheted le.\nAmikor a test mozgó platformhoz ér, annak sebessége automatikusan hozzáadódik a test mozgásához. Ha a platform mozgása miatt ütközés történik, az mindig a csúszási ütközések listájának elejére kerül.\nÜtközés esetén [code]true[/code], egyébként [code]false[/code] értéket ad vissza."

#. CharacterBody3D.platform_floor_layers
#: doc/classes/CharacterBody3D.xml
msgid "Collision layers that will be included for detecting floor bodies that will act as moving platforms to be followed by the [CharacterBody3D]. By default, all floor bodies are detected and propagate their velocity."
msgstr "Azok az ütközési rétegek, amelyekben a [CharacterBody3D] érzékeli a követendő mozgó platformként működő padlótesteket. Alapértelmezésben minden padlótestet érzékel, és átveszi a sebességüket."

#. CharacterBody3D.platform_wall_layers
#: doc/classes/CharacterBody3D.xml
msgid "Collision layers that will be included for detecting wall bodies that will act as moving platforms to be followed by the [CharacterBody3D]. By default, all wall bodies are ignored."
msgstr "Azok az ütközési rétegek, amelyekben a [CharacterBody3D] érzékeli a követendő mozgó platformként működő faltesteket. Alapértelmezésben minden faltestet figyelmen kívül hagy."

#. CharacterBody3D.up_direction
#: doc/classes/CharacterBody3D.xml
msgid "Vector pointing upwards, used to determine what is a wall and what is a floor (or a ceiling) when calling [method move_and_slide]. Defaults to [constant Vector3.UP]. As the vector will be normalized it can't be equal to [constant Vector3.ZERO], if you want all collisions to be reported as walls, consider using [constant MOTION_MODE_FLOATING] as [member motion_mode]."
msgstr "Felfelé mutató vektor. A [method move_and_slide] hívásakor ez alapján különbözteti meg a motor a falat, a padlót és a mennyezetet. Alapértelmezésben [constant Vector3.UP]. A motor egységnyi hosszúságúra alakítja a vektort, így az nem lehet [constant Vector3.ZERO]. Ha minden ütközést falként szeretnél kezelni, állítsd a [member motion_mode] értékét [constant MOTION_MODE_FLOATING] módra."

#. CharacterBody3D.velocity
#: doc/classes/CharacterBody3D.xml
msgid "Current velocity vector (typically meters per second), used and modified during calls to [method move_and_slide].\n[b]Note:[/b] A common mistake is setting this property to the desired velocity multiplied by [code]delta[/code], which produces a motion vector (typically in meters)."
msgstr "Az aktuális sebességvektor, amelyet a [method move_and_slide] hívásai használnak és módosítanak. Általában méter/másodpercben értendő.\n[b]Megjegyzés:[/b] Gyakori hiba a kívánt sebességet megszorozni a [code]delta[/code] értékével, mielőtt ezt a tulajdonságot beállítod. A szorzat már elmozdulásvektor, amely általában méterben értendő."

#. CharacterBody3D.wall_min_slide_angle
#: doc/classes/CharacterBody3D.xml
msgid "Minimum angle (in radians) where the body is allowed to slide when it encounters a wall. The default value equals 15 degrees. When [member motion_mode] is [constant MOTION_MODE_GROUNDED], it only affects movement if [member floor_block_on_wall] is [code]true[/code]."
msgstr "A legkisebb szög radiánban, amelynél a test falnak ütközve csúszhat. Az alapértelmezés 15 fok. Ha a [member motion_mode] értéke [constant MOTION_MODE_GROUNDED], csak akkor befolyásolja a mozgást, ha a [member floor_block_on_wall] értéke [code]true[/code]."

#. CharacterBody3D.MOTION_MODE_GROUNDED
#: doc/classes/CharacterBody3D.xml
msgid "Apply when notions of walls, ceiling and floor are relevant. In this mode the body motion will react to slopes (acceleration/slowdown). This mode is suitable for grounded games like platformers."
msgstr "Akkor használd, ha van jelentősége annak, hogy az ütközés fallal, mennyezettel vagy padlóval történik. Ebben a módban a lejtők gyorsítják vagy lassítják a testet. Talajon mozgó karaktereket használó játékokhoz, például platformjátékokhoz alkalmas."

#. CharacterBody3D.MOTION_MODE_FLOATING
#: doc/classes/CharacterBody3D.xml
msgid "Apply when there is no notion of floor or ceiling. All collisions will be reported as [code]on_wall[/code]. In this mode, when you slide, the speed will always be constant. This mode is suitable for games without ground like space games."
msgstr "Akkor használd, ha nincs padló vagy mennyezet. Minden ütközést [code]on_wall[/code] állapotként jelez. A sebesség nagysága csúszáskor állandó. Talaj nélküli játékokhoz, például űrjátékokhoz alkalmas."

#. CollisionObject3D.description
#: doc/classes/CollisionObject3D.xml
msgid "Abstract base class for 3D physics objects. [CollisionObject3D] can hold any number of [Shape3D]s for collision. Each shape must be assigned to a [i]shape owner[/i]. Shape owners are not nodes and do not appear in the editor, but are accessible through code using the [code]shape_owner_*[/code] methods.\n[b]Warning:[/b] With a non-uniform scale, this node will likely not behave as expected. It is advised to keep its scale the same on all axes and adjust its collision shape(s) instead."
msgstr "A 3D fizikai objektumok absztrakt alaposztálya. A [CollisionObject3D] tetszőleges számú [Shape3D] alakzatot használhat az ütközésekhez. Minden alakzatnak egy [i]alakzattulajdonoshoz[/i] kell tartoznia. Az alakzattulajdonosok nem csomópontok, ezért a szerkesztőben nem jelennek meg, de a [code]shape_owner_*[/code] metódusokkal kódból elérhetők.\n[b]Figyelmeztetés:[/b] Tengelyenként eltérő méretezésnél a csomópont viselkedése eltérhet a várttól. Érdemes minden tengelyen azonos méretezést megtartani, és magukat az ütközési alakzatokat módosítani."

#. CollisionObject3D._input_event
#: doc/classes/CollisionObject3D.xml
msgid "Receives unhandled [InputEvent]s. [param event_position] is the location in world space of the mouse pointer on the surface of the shape with index [param shape_idx] and [param normal] is the normal vector of the surface at that point. Connect to the [signal input_event] signal to easily pick up these events.\n[b]Note:[/b] [method _input_event] requires [member input_ray_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set."
msgstr "A még nem kezelt [InputEvent] eseményeket fogadja. A [param event_position] az egérmutató helye a [param shape_idx] indexű alakzat felületén, világkoordinátákban. A [param normal] a felszín normálvektora ezen a ponton. Az események egyszerű fogadásához kapcsolódj a [signal input_event] jelzéshez.\n[b]Megjegyzés:[/b] A [method _input_event] működéséhez a [member input_ray_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani."

#. CollisionObject3D._mouse_enter
#: doc/classes/CollisionObject3D.xml
msgid "Called when the mouse pointer enters any of this object's shapes. Requires [member input_ray_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set. Note that moving between different shapes within a single [CollisionObject3D] won't cause this function to be called."
msgstr "Akkor hívódik meg, amikor az egérmutató belép az objektum valamelyik alakzatába. Ehhez a [member input_ray_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani. Az egyazon [CollisionObject3D] alakzatai közötti mozgás nem hívja meg."

#. CollisionObject3D._mouse_exit
#: doc/classes/CollisionObject3D.xml
msgid "Called when the mouse pointer exits all this object's shapes. Requires [member input_ray_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set. Note that moving between different shapes within a single [CollisionObject3D] won't cause this function to be called."
msgstr "Akkor hívódik meg, amikor az egérmutató elhagyja az objektum összes alakzatát. Ehhez a [member input_ray_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani. Az egyazon [CollisionObject3D] alakzatai közötti mozgás nem hívja meg."

#. CollisionObject3D.mouse_entered
#: doc/classes/CollisionObject3D.xml
msgid "Emitted when the mouse pointer enters any of this object's shapes. Requires [member input_ray_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set.\n[b]Note:[/b] Due to the lack of continuous collision detection, this signal may not be emitted in the expected order if the mouse moves fast enough and the [CollisionObject3D]'s area is small. This signal may also not be emitted if another [CollisionObject3D] is overlapping the [CollisionObject3D] in question."
msgstr "Akkor küldi el, amikor az egérmutató belép az objektum valamelyik alakzatába. Ehhez a [member input_ray_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani.\n[b]Megjegyzés:[/b] Folyamatos ütközésérzékelés hiányában a jelzés eltérhet a várt sorrendtől, ha az egér gyorsan mozog, és a [CollisionObject3D] területe kicsi. A jelzés akkor is elmaradhat, ha egy másik [CollisionObject3D] átfedi a kérdéses [CollisionObject3D] objektumot."

#. CollisionObject3D.mouse_exited
#: doc/classes/CollisionObject3D.xml
msgid "Emitted when the mouse pointer exits all this object's shapes. Requires [member input_ray_pickable] to be [code]true[/code] and at least one [member collision_layer] bit to be set.\n[b]Note:[/b] Due to the lack of continuous collision detection, this signal may not be emitted in the expected order if the mouse moves fast enough and the [CollisionObject3D]'s area is small. This signal may also not be emitted if another [CollisionObject3D] is overlapping the [CollisionObject3D] in question."
msgstr "Akkor küldi el, amikor az egérmutató elhagyja az objektum összes alakzatát. Ehhez a [member input_ray_pickable] értékének [code]true[/code] értéken kell állnia, és a [member collision_layer] legalább egy bitjét be kell állítani.\n[b]Megjegyzés:[/b] Folyamatos ütközésérzékelés hiányában a jelzés eltérhet a várt sorrendtől, ha az egér gyorsan mozog, és a [CollisionObject3D] területe kicsi. A jelzés akkor is elmaradhat, ha egy másik [CollisionObject3D] átfedi a kérdéses [CollisionObject3D] objektumot."

#. CollisionObject3D.collision_layer
#: doc/classes/CollisionObject3D.xml
msgid "The physics layers this CollisionObject3D [b]is in[/b]. Collision objects can exist in one or more of 32 different layers. See also [member collision_mask].\n[b]Note:[/b] Object A can detect a contact with object B only if object B is in any of the layers that object A scans. See [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Collision layers and masks[/url] in the documentation for more information."
msgstr "Azok a fizikai rétegek, amelyekhez a CollisionObject3D [b]tartozik[/b]. Egy ütközési objektum a 32 különböző rétegből akár többhöz is tartozhat. Lásd még a [member collision_mask] tulajdonságot.\n[b]Megjegyzés:[/b] Az A objektum csak akkor érzékelheti a B objektummal való érintkezést, ha a B legalább az egyik olyan réteghez tartozik, amelyet az A figyel. További részletek a dokumentáció [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Ütközési rétegek és maszkok[/url] részében találhatók."

#. CollisionObject3D.collision_mask
#: doc/classes/CollisionObject3D.xml
msgid "The physics layers this CollisionObject3D [b]scans[/b]. Collision objects can scan one or more of 32 different layers. See also [member collision_layer].\n[b]Note:[/b] Object A can detect a contact with object B only if object B is in any of the layers that object A scans. See [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Collision layers and masks[/url] in the documentation for more information."
msgstr "Azok a fizikai rétegek, amelyeket a CollisionObject3D [b]figyel[/b]. Egy ütközési objektum a 32 különböző rétegből akár többet is figyelhet. Lásd még a [member collision_layer] tulajdonságot.\n[b]Megjegyzés:[/b] Az A objektum csak akkor érzékelheti a B objektummal való érintkezést, ha a B legalább az egyik olyan réteghez tartozik, amelyet az A figyel. További részletek a dokumentáció [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Ütközési rétegek és maszkok[/url] részében találhatók."

#. CollisionObject3D.input_capture_on_drag
#: doc/classes/CollisionObject3D.xml
msgid "If [code]true[/code], the [CollisionObject3D] will continue to receive input events as the mouse is dragged across its shapes."
msgstr "[code]true[/code] értéknél a [CollisionObject3D] továbbra is fogadja a bemeneti eseményeket, amikor az egérmutatót áthúzzák az alakzatain."

#. KinematicCollision3D.brief
#: doc/classes/KinematicCollision3D.xml
msgid "Holds collision data from the movement of a [PhysicsBody3D]."
msgstr "A [PhysicsBody3D] mozgása során észlelt ütközés adatait tárolja."

#. KinematicCollision3D.description
#: doc/classes/KinematicCollision3D.xml
msgid "Holds collision data from the movement of a [PhysicsBody3D], usually from [method PhysicsBody3D.move_and_collide]. When a [PhysicsBody3D] is moved, it stops if it detects a collision with another body. If a collision is detected, a [KinematicCollision3D] object is returned.\nThe collision data includes the colliding object, the remaining motion, and the collision position. This data can be used to determine a custom response to the collision."
msgstr "A [PhysicsBody3D] mozgása során észlelt ütközés adatait tárolja, rendszerint a [method PhysicsBody3D.move_and_collide] hívása után. Mozgatáskor a [PhysicsBody3D] megáll, ha egy másik testtel ütközik. Ilyenkor [KinematicCollision3D] objektumot ad vissza.\nAz adatok az ütköző objektumot, a hátralévő elmozdulást és az ütközési pontot tartalmazzák. Ezekből egyéni ütközési reakció számítható."

#. KinematicCollision3D.get_angle
#: doc/classes/KinematicCollision3D.xml
msgid "Returns the collision angle according to [param up_direction], which is [constant Vector3.UP] by default. This value is always positive."
msgstr "Visszaadja az ütközés szögét a [param up_direction] irányhoz viszonyítva, amely alapértelmezésben [constant Vector3.UP]. Az érték mindig pozitív."

#. KinematicCollision3D.get_collider
#: doc/classes/KinematicCollision3D.xml
msgid "Returns the colliding body's attached [Object] given a collision index (the deepest collision by default)."
msgstr "Visszaadja az ütköző testhez csatolt [Object] objektumot a megadott ütközési indexhez. Alapértelmezésben a legmélyebb ütközést veszi alapul."

#. KinematicCollision3D.get_collider_id
#: doc/classes/KinematicCollision3D.xml
msgid "Returns the unique instance ID of the colliding body's attached [Object] given a collision index (the deepest collision by default). See [method Object.get_instance_id]."
msgstr "Visszaadja az ütköző testhez csatolt [Object] egyedi példányazonosítóját a megadott ütközési indexhez. Alapértelmezésben a legmélyebb ütközést veszi alapul. Lásd a [method Object.get_instance_id] metódust."

#. KinematicCollision3D.get_collider_rid
#: doc/classes/KinematicCollision3D.xml
msgid "Returns the colliding body's [RID] used by the [PhysicsServer3D] given a collision index (the deepest collision by default)."
msgstr "Visszaadja az ütköző test [PhysicsServer3D] által használt [RID] azonosítóját a megadott ütközési indexhez. Alapértelmezésben a legmélyebb ütközést veszi alapul."

#. KinematicCollision3D.get_collider_shape
#: doc/classes/KinematicCollision3D.xml
msgid "Returns the colliding body's shape given a collision index (the deepest collision by default)."
msgstr "Visszaadja az ütköző test alakzatát a megadott ütközési indexhez. Alapértelmezésben a legmélyebb ütközést veszi alapul."

#. KinematicCollision3D.get_collider_shape_index
#: doc/classes/KinematicCollision3D.xml
msgid "Returns the colliding body's shape index given a collision index (the deepest collision by default). See [CollisionObject3D]."
msgstr "Visszaadja az ütköző test alakzatának indexét a megadott ütközési indexhez. Alapértelmezésben a legmélyebb ütközést veszi alapul. Lásd a [CollisionObject3D] osztályt."

#. KinematicCollision3D.get_collider_velocity
#: doc/classes/KinematicCollision3D.xml
msgid "Returns the colliding body's velocity given a collision index (the deepest collision by default)."
msgstr "Visszaadja az ütköző test sebességét a megadott ütközési indexhez. Alapértelmezésben a legmélyebb ütközést veszi alapul."

#. KinematicCollision3D.get_collision_count
#. PhysicsTestMotionResult3D.get_collision_count
#: doc/classes/KinematicCollision3D.xml doc/classes/PhysicsTestMotionResult3D.xml
msgid "Returns the number of detected collisions."
msgstr "Visszaadja az észlelt ütközések számát."

#. KinematicCollision3D.get_local_shape
#: doc/classes/KinematicCollision3D.xml
msgid "Returns the moving object's colliding shape given a collision index (the deepest collision by default)."
msgstr "Visszaadja a mozgó objektum ütköző alakzatát a megadott ütközési indexhez. Alapértelmezésben a legmélyebb ütközést veszi alapul."

#. PhysicsDirectSpaceState2D.get_rest_info
#: doc/classes/PhysicsDirectSpaceState2D.xml
msgid "Checks the intersections of a shape, given through a [PhysicsShapeQueryParameters2D] object, against the space. If it collides with more than one shape, the nearest one is selected. The returned object is a dictionary containing the following fields:\n[code]collider_id[/code]: The colliding object's ID.\n[code]linear_velocity[/code]: The colliding object's velocity [Vector2]. If the object is an [Area2D], the result is [code](0, 0)[/code].\n[code]normal[/code]: The collision normal of the query shape at the intersection point, pointing away from the intersecting object.\n[code]point[/code]: The intersection point.\n[code]rid[/code]: The intersecting object's [RID].\n[code]shape[/code]: The shape index of the colliding shape.\nIf the shape did not intersect anything, then an empty dictionary is returned instead."
msgstr "Egy [PhysicsShapeQueryParameters2D] objektumban megadott alakzat metszéseit keresi a fizikai térben. Ha több alakzattal ütközik, a legközelebbit választja. A visszaadott szótár mezői:\n[code]collider_id[/code]: Az ütköző objektum azonosítója.\n[code]linear_velocity[/code]: Az ütköző objektum [Vector2] sebessége. [Area2D] esetén az eredmény [code](0, 0)[/code].\n[code]normal[/code]: A lekérdezett alakzat ütközési normálvektora a metszéspontban. Az érintett objektumtól elfelé mutat.\n[code]point[/code]: A metszéspont.\n[code]rid[/code]: A metszett objektum [RID] azonosítója.\n[code]shape[/code]: Az ütköző alakzat indexe.\nHa az alakzat semmit sem metsz, üres szótárat ad vissza."

#. PhysicsDirectSpaceState3D.brief
#: doc/classes/PhysicsDirectSpaceState3D.xml
msgid "Provides direct access to a physics space in the [PhysicsServer3D]."
msgstr "Közvetlen hozzáférést biztosít a [PhysicsServer3D] fizikai teréhez."

#. PhysicsDirectSpaceState3D.description
#: doc/classes/PhysicsDirectSpaceState3D.xml
msgid "Provides direct access to a physics space in the [PhysicsServer3D]. It's used mainly to do queries against objects and areas residing in a given space.\n[b]Note:[/b] This class is not meant to be instantiated directly. Use [member World3D.direct_space_state] to get the world's physics 3D space state."
msgstr "Közvetlen hozzáférést biztosít a [PhysicsServer3D] fizikai teréhez. Elsősorban az adott térben lévő objektumok és területek lekérdezésére használható.\n[b]Megjegyzés:[/b] Az osztály közvetlen példányosítás helyett a [member World3D.direct_space_state] tulajdonsággal érhető el. Ez adja meg a világ 3D fizikai terének állapotát."

#. PhysicsDirectSpaceState3D.cast_motion
#: doc/classes/PhysicsDirectSpaceState3D.xml
msgid "Checks how far a [Shape3D] can move without colliding. All the parameters for the query, including the shape and the motion, are supplied through a [PhysicsShapeQueryParameters3D] object.\nReturns an array with the safe and unsafe proportions (between 0 and 1) of the motion. The safe proportion is the maximum fraction of the motion that can be made without a collision. The unsafe proportion is the minimum fraction of the distance that must be moved for a collision. If no collision is detected a result of [code][1.0, 1.0][/code] will be returned.\n[b]Note:[/b] Any [Shape3D]s that the shape is already colliding with e.g. inside of, will be ignored. Use [method collide_shape] to determine the [Shape3D]s that the shape is already colliding with."
msgstr "Ellenőrzi, milyen messzire mozoghat egy [Shape3D] ütközés nélkül. A lekérdezés minden paraméterét, köztük az alakzatot és az elmozdulást, egy [PhysicsShapeQueryParameters3D] objektumban kell megadni.\nTömbben adja vissza az elmozdulás biztonságos és ütközéssel járó arányát 0 és 1 között. A biztonságos arány a teljes elmozdulásnak az a legnagyobb része, amely ütközés nélkül megtehető. Az ütközéssel járó arány a legkisebb rész, amelynél már ütközés történik. Ha nincs ütközés, az eredmény [code][1.0, 1.0][/code].\n[b]Megjegyzés:[/b] A metódus figyelmen kívül hagyja azokat a [Shape3D] alakzatokat, amelyekkel az alakzat már ütközik, például mert bennük van. Ezeknek a [Shape3D] alakzatoknak a keresésére a [method collide_shape] metódust használd."

#. PhysicsDirectSpaceState3D.collide_shape
#: doc/classes/PhysicsDirectSpaceState3D.xml
msgid "Checks the intersections of a shape, given through a [PhysicsShapeQueryParameters3D] object, against the space. The resulting array contains a list of points where the shape intersects another. Like with [method intersect_shape], the number of returned results can be limited to save processing time.\nReturned points are a list of pairs of contact points. For each pair the first one is in the shape passed in [PhysicsShapeQueryParameters3D] object, second one is in the collided shape from the physics space.\n[b]Note:[/b] This method does not take into account the [code]motion[/code] property of the object."
msgstr "Egy [PhysicsShapeQueryParameters3D] objektumban megadott alakzat metszéseit keresi a fizikai térben. A visszaadott tömb megadja azokat a pontokat, ahol az alakzat egy másikat metsz. A [method intersect_shape] metódushoz hasonlóan a feldolgozás gyorsítására korlátozható az eredmények száma.\nAz érintkezési pontok páronként szerepelnek a listában. Minden pár első pontja a [PhysicsShapeQueryParameters3D] objektumban megadott alakzathoz, a második a fizikai térben talált ütköző alakzathoz tartozik.\n[b]Megjegyzés:[/b] A metódus figyelmen kívül hagyja az objektum [code]motion[/code] tulajdonságát."

#. PhysicsDirectSpaceState3D.get_rest_info
#: doc/classes/PhysicsDirectSpaceState3D.xml
msgid "Checks the intersections of a shape, given through a [PhysicsShapeQueryParameters3D] object, against the space. If it collides with more than one shape, the nearest one is selected. The returned object is a dictionary containing the following fields:\n[code]collider_id[/code]: The colliding object's ID.\n[code]linear_velocity[/code]: The colliding object's velocity [Vector3]. If the object is an [Area3D], the result is [code](0, 0, 0)[/code].\n[code]normal[/code]: The collision normal of the query shape at the intersection point, pointing away from the intersecting object.\n[code]point[/code]: The intersection point.\n[code]rid[/code]: The intersecting object's [RID].\n[code]shape[/code]: The shape index of the colliding shape.\nIf the shape did not intersect anything, then an empty dictionary is returned instead.\n[b]Note:[/b] This method does not take into account the [code]motion[/code] property of the object."
msgstr "Egy [PhysicsShapeQueryParameters3D] objektumban megadott alakzat metszéseit keresi a fizikai térben. Ha több alakzattal ütközik, a legközelebbit választja. A visszaadott szótár mezői:\n[code]collider_id[/code]: Az ütköző objektum azonosítója.\n[code]linear_velocity[/code]: Az ütköző objektum [Vector3] sebessége. [Area3D] esetén az eredmény [code](0, 0, 0)[/code].\n[code]normal[/code]: A lekérdezett alakzat ütközési normálvektora a metszéspontban. Az érintett objektumtól elfelé mutat.\n[code]point[/code]: A metszéspont.\n[code]rid[/code]: A metszett objektum [RID] azonosítója.\n[code]shape[/code]: Az ütköző alakzat indexe.\nHa az alakzat semmit sem metsz, üres szótárat ad vissza.\n[b]Megjegyzés:[/b] A metódus figyelmen kívül hagyja az objektum [code]motion[/code] tulajdonságát."

#. PhysicsDirectSpaceState3D.intersect_point
#: doc/classes/PhysicsDirectSpaceState3D.xml
msgid "Checks whether a point is inside any solid shape. Position and other parameters are defined through [PhysicsPointQueryParameters3D]. The shapes the point is inside of are returned in an array containing dictionaries with the following fields:\n[code]collider[/code]: The colliding object.\n[code]collider_id[/code]: The colliding object's ID.\n[code]rid[/code]: The intersecting object's [RID].\n[code]shape[/code]: The shape index of the colliding shape.\nThe number of intersections can be limited with the [param max_results] parameter, to reduce the processing time."
msgstr "Ellenőrzi, hogy egy pont bármely tömör alakzat belsejében van-e. A helyzetet és a többi paramétert [PhysicsPointQueryParameters3D] objektumban kell megadni. Azok az alakzatok, amelyek a pontot tartalmazzák, szótárak tömbjeként érkeznek vissza. A mezők:\n[code]collider[/code]: Az ütköző objektum.\n[code]collider_id[/code]: Az ütköző objektum azonosítója.\n[code]rid[/code]: A metszett objektum [RID] azonosítója.\n[code]shape[/code]: Az ütköző alakzat indexe.\nA találatok száma a [param max_results] paraméterrel korlátozható a gyorsabb feldolgozás érdekében."

#. PhysicsDirectSpaceState3D.intersect_ray
#: doc/classes/PhysicsDirectSpaceState3D.xml
msgid "Intersects a ray in a given space. Ray position and other parameters are defined through [PhysicsRayQueryParameters3D]. The returned object is a dictionary with the following fields:\n[code]collider[/code]: The colliding object.\n[code]collider_id[/code]: The colliding object's ID.\n[code]normal[/code]: The object's surface normal at the intersection point, or [code]Vector3(0, 0, 0)[/code] if the ray starts inside the shape and [member PhysicsRayQueryParameters3D.hit_from_inside] is [code]true[/code].\n[code]position[/code]: The intersection point.\n[code]face_index[/code]: The face index at the intersection point.\n[b]Note:[/b] Returns a valid number only if the intersected shape is a [ConcavePolygonShape3D]. Otherwise, [code]-1[/code] is returned.\n[code]rid[/code]: The intersecting object's [RID].\n[code]shape[/code]: The shape index of the colliding shape.\nIf the ray did not intersect anything, then an empty dictionary is returned instead."
msgstr "Egy sugár metszését keresi a megadott térben. A sugár helyét és a többi paramétert [PhysicsRayQueryParameters3D] objektumban kell megadni. A visszaadott szótár mezői:\n[code]collider[/code]: Az ütköző objektum.\n[code]collider_id[/code]: Az ütköző objektum azonosítója.\n[code]normal[/code]: Az objektum felületének normálvektora a metszéspontban. Ha a sugár az alakzat belsejéből indul, és a [member PhysicsRayQueryParameters3D.hit_from_inside] értéke [code]true[/code], a normál [code]Vector3(0, 0, 0)[/code].\n[code]position[/code]: A metszéspont.\n[code]face_index[/code]: A lap indexe a metszéspontnál.\n[b]Megjegyzés:[/b] Csak [ConcavePolygonShape3D] alakzat metszésekor ad érvényes indexet. Egyébként az eredmény [code]-1[/code].\n[code]rid[/code]: A metszett objektum [RID] azonosítója.\n[code]shape[/code]: Az ütköző alakzat indexe.\nHa a sugár semmit sem metsz, üres szótárat ad vissza."

#. PhysicsDirectSpaceState3D.intersect_shape
#: doc/classes/PhysicsDirectSpaceState3D.xml
msgid "Checks the intersections of a shape, given through a [PhysicsShapeQueryParameters3D] object, against the space. The intersected shapes are returned in an array containing dictionaries with the following fields:\n[code]collider[/code]: The colliding object.\n[code]collider_id[/code]: The colliding object's ID.\n[code]rid[/code]: The intersecting object's [RID].\n[code]shape[/code]: The shape index of the colliding shape.\nThe number of intersections can be limited with the [param max_results] parameter, to reduce the processing time.\n[b]Note:[/b] This method does not take into account the [code]motion[/code] property of the object."
msgstr "Egy [PhysicsShapeQueryParameters3D] objektumban megadott alakzat metszéseit keresi a fizikai térben. A metszett alakzatokat szótárak tömbjeként adja vissza a következő mezőkkel:\n[code]collider[/code]: Az ütköző objektum.\n[code]collider_id[/code]: Az ütköző objektum azonosítója.\n[code]rid[/code]: A metszett objektum [RID] azonosítója.\n[code]shape[/code]: Az ütköző alakzat indexe.\nA találatok száma a [param max_results] paraméterrel korlátozható a gyorsabb feldolgozás érdekében.\n[b]Megjegyzés:[/b] A metódus figyelmen kívül hagyja az objektum [code]motion[/code] tulajdonságát."

#. PhysicsPointQueryParameters3D.brief
#: doc/classes/PhysicsPointQueryParameters3D.xml
msgid "Provides parameters for [method PhysicsDirectSpaceState3D.intersect_point]."
msgstr "Paramétereket ad meg a [method PhysicsDirectSpaceState3D.intersect_point] metódushoz."

#. PhysicsPointQueryParameters3D.description
#: doc/classes/PhysicsPointQueryParameters3D.xml
msgid "By changing various properties of this object, such as the point position, you can configure the parameters for [method PhysicsDirectSpaceState3D.intersect_point]."
msgstr "Az objektum tulajdonságaival, például a pont helyével állíthatod be a [method PhysicsDirectSpaceState3D.intersect_point] metódus paramétereit."

#. PhysicsPointQueryParameters3D.collide_with_areas
#. PhysicsRayQueryParameters3D.collide_with_areas
#. PhysicsShapeQueryParameters3D.collide_with_areas
#: doc/classes/PhysicsPointQueryParameters3D.xml doc/classes/PhysicsRayQueryParameters3D.xml doc/classes/PhysicsShapeQueryParameters3D.xml
msgid "If [code]true[/code], the query will take [Area3D]s into account."
msgstr "[code]true[/code] értéknél a lekérdezés figyelembe veszi az [Area3D] területeket."

#. PhysicsPointQueryParameters3D.collide_with_bodies
#. PhysicsRayQueryParameters3D.collide_with_bodies
#. PhysicsShapeQueryParameters3D.collide_with_bodies
#: doc/classes/PhysicsPointQueryParameters3D.xml doc/classes/PhysicsRayQueryParameters3D.xml doc/classes/PhysicsShapeQueryParameters3D.xml
msgid "If [code]true[/code], the query will take [PhysicsBody3D]s into account."
msgstr "[code]true[/code] értéknél a lekérdezés figyelembe veszi a [PhysicsBody3D] testeket."

#. PhysicsPointQueryParameters3D.exclude
#. PhysicsRayQueryParameters3D.exclude
#. PhysicsShapeQueryParameters3D.exclude
#: doc/classes/PhysicsPointQueryParameters3D.xml doc/classes/PhysicsRayQueryParameters3D.xml doc/classes/PhysicsShapeQueryParameters3D.xml
msgid "The list of object [RID]s that will be excluded from collisions. Use [method CollisionObject3D.get_rid] to get the [RID] associated with a [CollisionObject3D]-derived node.\n[b]Note:[/b] The returned array is copied and any changes to it will not update the original property value. To update the value you need to modify the returned array, and then assign it to the property again."
msgstr "Az ütközésvizsgálatból kizárt objektumok [RID] azonosítóinak listája. Egy [CollisionObject3D] típusból származó csomópont [RID] azonosítóját a [method CollisionObject3D.get_rid] metódussal kérheted le.\n[b]Megjegyzés:[/b] A lekérdezés a tömb másolatát adja vissza. A másolat módosítása nem írja át a tulajdonságot. Módosítás után rendeld vissza a tömböt a tulajdonsághoz."

#. PhysicsRayQueryParameters3D.brief
#: doc/classes/PhysicsRayQueryParameters3D.xml
msgid "Provides parameters for [method PhysicsDirectSpaceState3D.intersect_ray]."
msgstr "Paramétereket ad meg a [method PhysicsDirectSpaceState3D.intersect_ray] metódushoz."

#. PhysicsRayQueryParameters3D.description
#: doc/classes/PhysicsRayQueryParameters3D.xml
msgid "By changing various properties of this object, such as the ray position, you can configure the parameters for [method PhysicsDirectSpaceState3D.intersect_ray]."
msgstr "Az objektum tulajdonságaival, például a sugár helyével állíthatod be a [method PhysicsDirectSpaceState3D.intersect_ray] metódus paramétereit."

#. PhysicsRayQueryParameters3D.create
#: doc/classes/PhysicsRayQueryParameters3D.xml
msgid "Returns a new, pre-configured [PhysicsRayQueryParameters3D] object. Use it to quickly create query parameters using the most common options.\n[codeblock]\nvar query = PhysicsRayQueryParameters3D.create(position, position + Vector3(0, -10, 0))\nvar collision = get_world_3d().direct_space_state.intersect_ray(query)\n[/codeblock]"
msgstr "Új, előre beállított [PhysicsRayQueryParameters3D] objektumot ad vissza. A leggyakoribb beállításokkal így gyorsan megadhatók egy lekérdezés paraméterei.\n[codeblock]\nvar query = PhysicsRayQueryParameters3D.create(position, position + Vector3(0, -10, 0))\nvar collision = get_world_3d().direct_space_state.intersect_ray(query)\n[/codeblock]"

#. PhysicsRayQueryParameters3D.hit_back_faces
#: doc/classes/PhysicsRayQueryParameters3D.xml
msgid "If [code]true[/code], the query will hit back faces with concave polygon shapes with back face enabled or heightmap shapes."
msgstr "[code]true[/code] értéknél a lekérdezés a hátlapokat is eltalálhatja, ha a homorú sokszögalakzaton engedélyezve vannak, illetve ha magasságtérkép-alakzatot vizsgál."

#. PhysicsRayQueryParameters3D.hit_from_inside
#: doc/classes/PhysicsRayQueryParameters3D.xml
msgid "If [code]true[/code], the query will detect a hit when starting inside shapes. In this case the collision normal will be [code]Vector3(0, 0, 0)[/code]. Does not affect concave polygon shapes or heightmap shapes."
msgstr "[code]true[/code] értéknél a lekérdezés akkor is találatot jelez, ha a sugár az alakzat belsejéből indul. Ilyenkor az ütközési normál [code]Vector3(0, 0, 0)[/code] lesz. Homorú sokszögalakzatokra és magasságtérkép-alakzatokra nincs hatással."

#. PhysicsShapeQueryParameters3D.brief
#: doc/classes/PhysicsShapeQueryParameters3D.xml
msgid "Provides parameters for [PhysicsDirectSpaceState3D]'s methods."
msgstr "Paramétereket ad meg a [PhysicsDirectSpaceState3D] metódusaihoz."

#. PhysicsShapeQueryParameters3D.description
#: doc/classes/PhysicsShapeQueryParameters3D.xml
msgid "By changing various properties of this object, such as the shape, you can configure the parameters for [PhysicsDirectSpaceState3D]'s methods."
msgstr "Az objektum tulajdonságaival, például az alakzattal állíthatod be a [PhysicsDirectSpaceState3D] metódusainak paramétereit."

#. PhysicsShapeQueryParameters3D.shape
#: doc/classes/PhysicsShapeQueryParameters3D.xml
msgid "The [Shape3D] that will be used for collision/intersection queries. This stores the actual reference which avoids the shape to be released while being used for queries, so always prefer using this over [member shape_rid]."
msgstr "Az ütközések vagy metszések lekérdezésénél használt [Shape3D] alakzat. Ez a tulajdonság az alakzatra mutató hivatkozást tárolja, így az alakzat nem szabadul fel, amíg a lekérdezés használja. Ezért ezt részesítsd előnyben a [member shape_rid] tulajdonsággal szemben."

#. PhysicsShapeQueryParameters3D.shape_rid
#: doc/classes/PhysicsShapeQueryParameters3D.xml
msgid "The queried shape's [RID] that will be used for collision/intersection queries. Use this over [member shape] if you want to optimize for performance using the Servers API:\n[codeblocks]\n[gdscript]\nvar shape_rid = PhysicsServer3D.sphere_shape_create()\nvar radius = 2.0\nPhysicsServer3D.shape_set_data(shape_rid, radius)\n\nvar params = PhysicsShapeQueryParameters3D.new()\nparams.shape_rid = shape_rid\n\n# Execute physics queries here...\n\n# Release the shape when done with physics queries.\nPhysicsServer3D.free_rid(shape_rid)\n[/gdscript]\n[csharp]\nRID shapeRid = PhysicsServer3D.SphereShapeCreate();\nfloat radius = 2.0f;\nPhysicsServer3D.ShapeSetData(shapeRid, radius);\n\nvar params = new PhysicsShapeQueryParameters3D();\nparams.ShapeRid = shapeRid;\n\n// Execute physics queries here...\n\n// Release the shape when done with physics queries.\nPhysicsServer3D.FreeRid(shapeRid);\n[/csharp]\n[/codeblocks]"
msgstr "Az ütközések vagy metszések lekérdezésénél használt alakzat [RID] azonosítója. Ha a kiszolgálói API-val szeretnéd javítani a teljesítményt, használd ezt a [member shape] helyett:\n[codeblocks]\n[gdscript]\nvar shape_rid = PhysicsServer3D.sphere_shape_create()\nvar radius = 2.0\nPhysicsServer3D.shape_set_data(shape_rid, radius)\n\nvar params = PhysicsShapeQueryParameters3D.new()\nparams.shape_rid = shape_rid\n\n# Execute physics queries here...\n\n# Release the shape when done with physics queries.\nPhysicsServer3D.free_rid(shape_rid)\n[/gdscript]\n[csharp]\nRID shapeRid = PhysicsServer3D.SphereShapeCreate();\nfloat radius = 2.0f;\nPhysicsServer3D.ShapeSetData(shapeRid, radius);\n\nvar params = new PhysicsShapeQueryParameters3D();\nparams.ShapeRid = shapeRid;\n\n// Execute physics queries here...\n\n// Release the shape when done with physics queries.\nPhysicsServer3D.FreeRid(shapeRid);\n[/csharp]\n[/codeblocks]"

#. Generic6DOFJoint3D.PARAM_LINEAR_LOWER_LIMIT
#. PhysicsServer3D.G6DOF_JOINT_LINEAR_LOWER_LIMIT
#: doc/classes/Generic6DOFJoint3D.xml doc/classes/PhysicsServer3D.xml
msgid "The minimum difference between the pivot points' axes."
msgstr "A forgáspontok tengelyei közötti legkisebb különbség."

#. Generic6DOFJoint3D.PARAM_LINEAR_UPPER_LIMIT
#. PhysicsServer3D.G6DOF_JOINT_LINEAR_UPPER_LIMIT
#: doc/classes/Generic6DOFJoint3D.xml doc/classes/PhysicsServer3D.xml
msgid "The maximum difference between the pivot points' axes."
msgstr "A forgáspontok tengelyei közötti legnagyobb különbség."

#. Generic6DOFJoint3D.PARAM_ANGULAR_LOWER_LIMIT
#. PhysicsServer3D.G6DOF_JOINT_ANGULAR_LOWER_LIMIT
#: doc/classes/Generic6DOFJoint3D.xml doc/classes/PhysicsServer3D.xml
msgid "The minimum rotation in negative direction to break loose and rotate around the axes."
msgstr "A negatív irányú forgatás alsó határa, amelynél a tengelyek körüli forgás szabaddá válik."

#. Generic6DOFJoint3D.PARAM_ANGULAR_UPPER_LIMIT
#. PhysicsServer3D.G6DOF_JOINT_ANGULAR_UPPER_LIMIT
#: doc/classes/Generic6DOFJoint3D.xml doc/classes/PhysicsServer3D.xml
msgid "The minimum rotation in positive direction to break loose and rotate around the axes."
msgstr "A pozitív irányú forgatás felső határa, amelynél a tengelyek körüli forgás szabaddá válik."

#. Generic6DOFJoint3D.PARAM_ANGULAR_MOTOR_TARGET_VELOCITY
#. PhysicsServer3D.G6DOF_JOINT_ANGULAR_MOTOR_TARGET_VELOCITY
#: doc/classes/Generic6DOFJoint3D.xml doc/classes/PhysicsServer3D.xml
msgid "Target speed for the motor at the axes."
msgstr "A motor célsebessége a tengelyek körül."

#. PhysicsServer2D.description
#: doc/classes/PhysicsServer2D.xml
msgid "PhysicsServer2D is the server responsible for all 2D physics. It can directly create and manipulate all physics objects:\n- A [i]space[/i] is a self-contained world for a physics simulation. It contains bodies, areas, and joints. Its state can be queried for collision and intersection information, and several parameters of the simulation can be modified.\n- A [i]shape[/i] is a geometric shape such as a circle, a rectangle, a capsule, or a polygon. It can be used for collision detection by adding it to a body/area, possibly with an extra transformation relative to the body/area's origin. Bodies/areas can have multiple (transformed) shapes added to them, and a single shape can be added to bodies/areas multiple times with different local transformations.\n- A [i]body[/i] is a physical object which can be in static, kinematic, or rigid mode. Its state (such as position and velocity) can be queried and updated. A force integration callback can be set to customize the body's physics.\n- An [i]area[/i] is a region in space which can be used to detect bodies and areas entering and exiting it. A body monitoring callback can be set to report entering/exiting body shapes, and similarly an area monitoring callback can be set. Gravity and damping can be overridden within the area by setting area parameters.\n- A [i]joint[/i] is a constraint, either between two bodies or on one body relative to a point. Parameters such as the joint bias and the rest length of a spring joint can be adjusted.\nPhysics objects in [PhysicsServer2D] may be created and manipulated independently; they do not have to be tied to nodes in the scene tree.\n[b]Note:[/b] All the 2D physics nodes use the physics server internally. Adding a physics node to the scene tree will cause a corresponding physics object to be created in the physics server. A rigid body node registers a callback that updates the node's transform with the transform of the respective body object in the physics server (every physics update). An area node registers a callback to inform the area node about overlaps with the respective area object in the physics server. The raycast node queries the direct state of the relevant space in the physics server."
msgstr "A PhysicsServer2D kezeli a teljes 2D fizikát. Közvetlenül létrehozhat és módosíthat bármilyen fizikai objektumot:\n- A [i]tér[/i] a fizikai szimuláció önálló világa. Testeket, területeket és csuklókat tartalmaz. Az állapotából ütközési és metszési adatok kérhetők le, és a szimuláció több paramétere módosítható.\n- Az [i]alakzat[/i] geometriai forma, például kör, téglalap, kapszula vagy sokszög. Ütközésérzékeléshez testhez vagy területhez adható, szükség szerint az origóhoz viszonyított további transzformációval. Egy testhez vagy területhez több transzformált alakzat is rendelhető, és ugyanaz az alakzat különböző helyi transzformációkkal többször is hozzárendelhető.\n- A [i]test[/i] olyan fizikai objektum, amely statikus, kinematikus vagy merev módban működhet. Az állapota, például a helye és sebessége lekérhető és módosítható. A fizikája az erőintegrálást végző visszahívással szabható testre.\n- A [i]terület[/i] a tér egy része, amely érzékelheti testek és más területek be- és kilépését. A testfigyelő visszahívás jelzi a testek alakzatainak be- és kilépését. Hasonló módon területfigyelő visszahívás is beállítható. A terület paramétereivel helyileg felülírható a gravitáció és a csillapítás.\n- A [i]csukló[/i] két test közötti vagy egy testet ponthoz kötő fizikai kényszer. A csukló paraméterei, például a korrekciós tényező és a rugó nyugalmi hossza módosíthatók.\nA [PhysicsServer2D] fizikai objektumai önállóan létrehozhatók és módosíthatók. Nem kell a jelenetfa csomópontjaihoz kötni őket.\n[b]Megjegyzés:[/b] Belsőleg minden 2D fizikai csomópont a fizikakiszolgálót használja. Amikor fizikai csomópont kerül a jelenetfába, a kiszolgáló létrehozza a neki megfelelő fizikai objektumot. A merev test csomópontja olyan visszahívást regisztrál, amely minden fizikai frissítéskor a kiszolgálóban tárolt test transzformációjához igazítja a csomópontot. A terület csomópontja a kiszolgálónál nyilvántartott átfedésekről kap értesítést a visszahívásán keresztül. A sugárvizsgáló csomópont a kiszolgáló megfelelő terének közvetlen állapotát kérdezi le."

#. PhysicsServer2D.area_add_shape
#: doc/classes/PhysicsServer2D.xml
msgid "Adds a shape to the area, with the given local transform. The shape (together with its [param transform] and [param disabled] properties) is added to an array of shapes, and the shapes of an area are usually referenced by their index in this array."
msgstr "Alakzatot ad a területhez a megadott helyi transzformációval. Az alakzat a [param transform] és a [param disabled] tulajdonságával együtt bekerül az alakzatok tömbjébe. A terület alakzataira általában ebben a tömbben elfoglalt indexükkel hivatkoznak."

#. PhysicsServer2D.area_create
#: doc/classes/PhysicsServer2D.xml
msgid "Creates a 2D area object in the physics server, and returns the [RID] that identifies it. The default settings for the created area include a collision layer and mask set to [code]1[/code], and [code]monitorable[/code] set to [code]false[/code].\nUse [method area_add_shape] to add shapes to it, use [method area_set_transform] to set its transform, and use [method area_set_space] to add the area to a space. If you want the area to be detectable use [method area_set_monitorable]."
msgstr "2D területet hoz létre a fizikakiszolgálón, és visszaadja annak [RID] azonosítóját. Az ütközési réteg és maszk kezdeti értéke [code]1[/code], a [code]monitorable[/code] értéke [code]false[/code].\nAlakzatot a [method area_add_shape] metódussal adhatsz hozzá, a transzformációt a [method area_set_transform] metódussal állíthatod be, a területet pedig a [method area_set_space] metódussal adhatod hozzá egy térhez. Ha azt szeretnéd, hogy más területek észleljék, használd a [method area_set_monitorable] metódust."

#. PhysicsServer2D.area_get_canvas_instance_id
#: doc/classes/PhysicsServer2D.xml
msgid "Returns the [code]ObjectID[/code] of the canvas attached to the area. Use [method @GlobalScope.instance_from_id] to retrieve a [CanvasLayer] from a nonzero [code]ObjectID[/code]."
msgstr "Visszaadja a területhez csatolt vászon [code]ObjectID[/code] azonosítóját. Nem nulla [code]ObjectID[/code] esetén a [method @GlobalScope.instance_from_id] metódussal kérheted le a [CanvasLayer] objektumot."

#. PhysicsServer2D.area_remove_shape
#: doc/classes/PhysicsServer2D.xml
msgid "Removes the shape with the given index from the area's array of shapes. The shape itself is not deleted, so it can continue to be used elsewhere or added back later. As a result of this operation, the area's shapes which used to have indices higher than [param shape_idx] will have their index decreased by one."
msgstr "A megadott indexű alakzatot eltávolítja a terület alakzattömbjéből. Maga az alakzat megmarad, így máshol is használható, vagy később újra hozzáadható. A [param shape_idx] értékénél nagyobb indexű alakzatok indexe eggyel csökken."

#. PhysicsServer2D.area_set_area_monitor_callback
#. PhysicsServer3D.area_set_area_monitor_callback
#: doc/classes/PhysicsServer2D.xml doc/classes/PhysicsServer3D.xml
msgid "Sets the area's area monitor callback. This callback will be called when any other (shape of an) area enters or exits (a shape of) the given area, and must take the following five parameters:\n1. an integer [code]status[/code]: either [constant AREA_BODY_ADDED] or [constant AREA_BODY_REMOVED] depending on whether the other area's shape entered or exited the area,\n2. an [RID] [code]area_rid[/code]: the [RID] of the other area that entered or exited the area,\n3. an integer [code]instance_id[/code]: the [code]ObjectID[/code] attached to the other area,\n4. an integer [code]area_shape_idx[/code]: the index of the shape of the other area that entered or exited the area,\n5. an integer [code]self_shape_idx[/code]: the index of the shape of the area where the other area entered or exited.\nBy counting (or keeping track of) the shapes that enter and exit, it can be determined if an area (with all its shapes) is entering for the first time or exiting for the last time."
msgstr "Beállítja a terület más területeket figyelő visszahívását. Akkor hívja meg, amikor egy másik terület alakzata belép ennek a területnek egy alakzatába vagy kilép belőle. A visszahívásnak az alábbi öt paramétert kell fogadnia:\n1. Egész [code]status[/code] érték. [constant AREA_BODY_ADDED] belépéskor és [constant AREA_BODY_REMOVED] kilépéskor.\n2. [RID] típusú [code]area_rid[/code]. A belépő vagy kilépő másik terület [RID] azonosítója.\n3. Egész [code]instance_id[/code] érték. A másik területhez csatolt [code]ObjectID[/code].\n4. Egész [code]area_shape_idx[/code] érték. A másik terület belépő vagy kilépő alakzatának indexe.\n5. Egész [code]self_shape_idx[/code] érték. Ennek a területnek az az alakzatindexe, ahol a belépés vagy kilépés történt.\nA belépő és kilépő alakzatok számlálásával vagy nyilvántartásával megállapítható, hogy egy terület első alakzata éppen belépett-e, illetve az utolsó alakzata elhagyta-e a területet."

#. PhysicsServer2D.area_set_monitor_callback
#. PhysicsServer3D.area_set_monitor_callback
#: doc/classes/PhysicsServer2D.xml doc/classes/PhysicsServer3D.xml
msgid "Sets the area's body monitor callback. This callback will be called when any other (shape of a) body enters or exits (a shape of) the given area, and must take the following five parameters:\n1. an integer [code]status[/code]: either [constant AREA_BODY_ADDED] or [constant AREA_BODY_REMOVED] depending on whether the other body shape entered or exited the area,\n2. an [RID] [code]body_rid[/code]: the [RID] of the body that entered or exited the area,\n3. an integer [code]instance_id[/code]: the [code]ObjectID[/code] attached to the body,\n4. an integer [code]body_shape_idx[/code]: the index of the shape of the body that entered or exited the area,\n5. an integer [code]self_shape_idx[/code]: the index of the shape of the area where the body entered or exited.\nBy counting (or keeping track of) the shapes that enter and exit, it can be determined if a body (with all its shapes) is entering for the first time or exiting for the last time."
msgstr "Beállítja a terület testeket figyelő visszahívását. Akkor hívja meg, amikor egy test alakzata belép a terület valamelyik alakzatába vagy kilép belőle. A visszahívásnak az alábbi öt paramétert kell fogadnia:\n1. Egész [code]status[/code] érték. [constant AREA_BODY_ADDED] belépéskor és [constant AREA_BODY_REMOVED] kilépéskor.\n2. [RID] típusú [code]body_rid[/code]. A belépő vagy kilépő test [RID] azonosítója.\n3. Egész [code]instance_id[/code] érték. A testhez csatolt [code]ObjectID[/code].\n4. Egész [code]body_shape_idx[/code] érték. A test belépő vagy kilépő alakzatának indexe.\n5. Egész [code]self_shape_idx[/code] érték. A terület azon alakzatának indexe, ahol a belépés vagy kilépés történt.\nA belépő és kilépő alakzatok számlálásával vagy nyilvántartásával megállapítható, hogy egy test első alakzata éppen belépett-e, illetve az utolsó alakzata elhagyta-e a területet."

#. PhysicsServer2D.area_set_monitorable
#: doc/classes/PhysicsServer2D.xml
msgid "Sets whether the area is monitorable or not. If [param monitorable] is [code]true[/code], the area monitoring callback of other areas will be called when this area enters or exits them."
msgstr "Beállítja, hogy a terület észlelhető-e. Ha a [param monitorable] értéke [code]true[/code], a többi terület figyelő visszahívása lefut, amikor ez a terület belép vagy kilép."

#. PhysicsServer2D.area_set_shape_disabled
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the disabled property of the area's shape with the given index. If [param disabled] is [code]true[/code], then the shape will not detect any other shapes entering or exiting it."
msgstr "Beállítja, hogy a terület megadott indexű alakzata le van-e tiltva. Ha a [param disabled] értéke [code]true[/code], az alakzat nem érzékeli más alakzatok be- vagy kilépését."

#. PhysicsServer2D.area_set_space
#: doc/classes/PhysicsServer2D.xml
msgid "Adds the area to the given space, after removing the area from the previously assigned space (if any).\n[b]Note:[/b] To remove an area from a space without immediately adding it back elsewhere, use [code]PhysicsServer2D.area_set_space(area, RID())[/code]."
msgstr "A megadott térhez adja a területet, miután eltávolította a korábban hozzárendelt térből, ha volt ilyen.\n[b]Megjegyzés:[/b] Egy terület másik térhez rendelés nélküli eltávolításához használd a [code]PhysicsServer2D.area_set_space(area, RID())[/code] hívást."

#. PhysicsServer2D.body_add_constant_central_force
#: doc/classes/PhysicsServer2D.xml
msgid "Adds a constant directional force to the body. The force does not affect rotation. The force remains applied over time until cleared with [code]PhysicsServer2D.body_set_constant_force(body, Vector2(0, 0))[/code].\nThis is equivalent to using [method body_add_constant_force] at the body's center of mass."
msgstr "A testre állandó irányú erőt fejt ki. Az erő nem befolyásolja a forgást, és addig hat, amíg a [code]PhysicsServer2D.body_set_constant_force(body, Vector2(0, 0))[/code] hívással nem törlik.\nEgyenértékű a [method body_add_constant_force] alkalmazásával a test tömegközéppontjában."

#. PhysicsServer2D.body_add_constant_force
#: doc/classes/PhysicsServer2D.xml
msgid "Adds a constant positioned force to the body. The force can affect rotation if [param position] is different from the body's center of mass. The force remains applied over time until cleared with [code]PhysicsServer2D.body_set_constant_force(body, Vector2(0, 0))[/code].\n[param position] is the offset from the body origin in global coordinates."
msgstr "A test egy adott pontjára állandó erőt fejt ki. Ha a [param position] eltér a tömegközépponttól, az erő a forgást is befolyásolhatja. Az erő addig hat, amíg a [code]PhysicsServer2D.body_set_constant_force(body, Vector2(0, 0))[/code] hívással nem törlik.\nA [param position] a test origójához viszonyított eltolás globális koordinátákban."

#. PhysicsServer2D.body_add_constant_torque
#: doc/classes/PhysicsServer2D.xml
msgid "Adds a constant rotational force to the body. The force does not affect position. The force remains applied over time until cleared with [code]PhysicsServer2D.body_set_constant_torque(body, 0)[/code]."
msgstr "Állandó forgatónyomatékot ad a testhez. Ez a test helyét nem befolyásolja, és addig hat, amíg a [code]PhysicsServer2D.body_set_constant_torque(body, 0)[/code] hívással nem törlik."

#. PhysicsServer2D.body_apply_central_force
#: doc/classes/PhysicsServer2D.xml
msgid "Applies a directional force to the body, at the body's center of mass. The force does not affect rotation. A force is time dependent and meant to be applied every physics update.\nThis is equivalent to using [method body_apply_force] at the body's center of mass."
msgstr "Irányított erőt fejt ki a testre a tömegközéppontjában. Az erő nem befolyásolja a forgást. Az erő időfüggő, ezért fizikai frissítésenként kell alkalmazni.\nEgyenértékű a [method body_apply_force] alkalmazásával a test tömegközéppontjában."

#. PhysicsServer2D.body_apply_central_impulse
#: doc/classes/PhysicsServer2D.xml
msgid "Applies a directional impulse to the body, at the body's center of mass. The impulse does not affect rotation.\nAn impulse is time-independent! Applying an impulse every frame would result in a framerate-dependent force. For this reason, it should only be used when simulating one-time impacts (use the \"_force\" functions otherwise).\nThis is equivalent to using [method body_apply_impulse] at the body's center of mass."
msgstr "Irányított impulzust ad a testnek a tömegközéppontjában. Az impulzus nem befolyásolja a forgást.\nAz impulzus időfüggetlen. Ha minden képkockán impulzust alkalmaznál, a hatás a képkockasebességtől függne. Ezért csak egyszeri behatás szimulálására használd. Folyamatos hatáshoz a „_force” függvényeket használd.\nEgyenértékű a [method body_apply_impulse] alkalmazásával a test tömegközéppontjában."

#. PhysicsServer2D.body_apply_force
#: doc/classes/PhysicsServer2D.xml
msgid "Applies a positioned force to the body. The force can affect rotation if [param position] is different from the body's center of mass. A force is time dependent and meant to be applied every physics update.\n[param position] is the offset from the body origin in global coordinates."
msgstr "Erőt fejt ki a test egy adott pontjára. Ha a [param position] eltér a tömegközépponttól, az erő a forgást is befolyásolhatja. Az erő időfüggő, ezért fizikai frissítésenként kell alkalmazni.\nA [param position] a test origójához viszonyított eltolás globális koordinátákban."

#. PhysicsServer2D.body_apply_impulse
#: doc/classes/PhysicsServer2D.xml
msgid "Applies a positioned impulse to the body. The impulse can affect rotation if [param position] is different from the body's center of mass.\nAn impulse is time-independent! Applying an impulse every frame would result in a framerate-dependent force. For this reason, it should only be used when simulating one-time impacts (use the \"_force\" functions otherwise).\n[param position] is the offset from the body origin in global coordinates."
msgstr "Impulzust ad a test egy adott pontjára. Ha a [param position] eltér a tömegközépponttól, az impulzus a forgást is befolyásolhatja.\nAz impulzus időfüggetlen. Ha minden képkockán impulzust alkalmaznál, a hatás a képkockasebességtől függne. Ezért csak egyszeri behatás szimulálására használd. Folyamatos hatáshoz a „_force” függvényeket használd.\nA [param position] a test origójához viszonyított eltolás globális koordinátákban."

#. PhysicsServer2D.body_apply_torque_impulse
#: doc/classes/PhysicsServer2D.xml
msgid "Applies a rotational impulse to the body. The impulse does not affect position.\nAn impulse is time-independent! Applying an impulse every frame would result in a framerate-dependent force. For this reason, it should only be used when simulating one-time impacts (use the \"_force\" functions otherwise)."
msgstr "Forgási impulzust ad a testnek. Az impulzus nem befolyásolja a test helyzetét.\nAz impulzus időfüggetlen. Ha minden képkockán impulzust alkalmaznál, a hatás a képkockasebességtől függne. Ezért csak egyszeri behatás szimulálására használd. Folyamatos hatáshoz a „_force” függvényeket használd."

#. PhysicsServer2D.body_get_canvas_instance_id
#: doc/classes/PhysicsServer2D.xml
msgid "Returns the [code]ObjectID[/code] of the canvas attached to the body. Use [method @GlobalScope.instance_from_id] to retrieve a [CanvasLayer] from a nonzero [code]ObjectID[/code]."
msgstr "Visszaadja a testhez csatolt vászon [code]ObjectID[/code] azonosítóját. Nem nulla [code]ObjectID[/code] esetén a [method @GlobalScope.instance_from_id] metódussal kérheted le a [CanvasLayer] objektumot."

#. PhysicsServer2D.body_get_collision_priority
#: doc/classes/PhysicsServer2D.xml
msgid "Returns the body's collision priority. This is used in the depenetration phase of [method body_test_motion]. The higher the priority is, the lower the penetration into the body will be."
msgstr "Visszaadja a test ütközési prioritását. A [method body_test_motion] az áthatolást megszüntető lépésnél használja ezt. Nagyobb prioritás mellett kisebb mértékű lesz a testbe való behatolás."

#. PhysicsServer2D.body_remove_shape
#: doc/classes/PhysicsServer2D.xml
msgid "Removes the shape with the given index from the body's array of shapes. The shape itself is not deleted, so it can continue to be used elsewhere or added back later. As a result of this operation, the body's shapes which used to have indices higher than [param shape_idx] will have their index decreased by one."
msgstr "A megadott indexű alakzatot eltávolítja a test alakzattömbjéből. Maga az alakzat megmarad, így máshol is használható, vagy később újra hozzáadható. A [param shape_idx] értékénél nagyobb indexű alakzatok indexe eggyel csökken."

#. PhysicsServer2D.body_set_axis_velocity
#: doc/classes/PhysicsServer2D.xml
msgid "Modifies the body's linear velocity so that its projection to the axis [code]axis_velocity.normalized()[/code] is exactly [code]axis_velocity.length()[/code]. This is useful for jumping behavior."
msgstr "Úgy módosítja a test lineáris sebességét, hogy a [code]axis_velocity.normalized()[/code] tengelyre vett vetülete éppen [code]axis_velocity.length()[/code] legyen. Ez például ugrás megvalósításához hasznos."

#. PhysicsServer2D.body_set_collision_priority
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the body's collision priority. This is used in the depenetration phase of [method body_test_motion]. The higher the priority is, the lower the penetration into the body will be."
msgstr "Beállítja a test ütközési prioritását. A [method body_test_motion] az áthatolást megszüntető lépésnél használja ezt. Nagyobb prioritás mellett kisebb mértékű lesz a testbe való behatolás."

#. PhysicsServer2D.body_set_continuous_collision_detection_mode
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the continuous collision detection mode.\nContinuous collision detection tries to predict where a moving body would collide in between physics updates, instead of moving it and correcting its movement if it collided."
msgstr "Beállítja a folyamatos ütközésérzékelés módját.\nA folyamatos ütközésérzékelés megpróbálja előre meghatározni, hol ütközne a mozgó test két fizikai frissítés között, ahelyett, hogy előbb elmozdítaná a testet, és csak az ütközés után korrigálná a mozgását."

#. PhysicsServer2D.body_set_force_integration_callback
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the body's custom force integration callback function to [param callable]. Use an empty [Callable] ([code skip-lint]Callable()[/code]) to clear the custom callback.\nThe function [param callable] will be called every physics tick, before the standard force integration (see [method body_set_omit_force_integration]). It can be used for example to update the body's linear and angular velocity based on contact with other bodies.\nIf [param userdata] is not [code]null[/code], the function [param callable] must take the following two parameters:\n1. [code]state[/code]: a [PhysicsDirectBodyState2D] used to retrieve and modify the body's state,\n2. [code skip-lint]userdata[/code]: a [Variant]; its value will be the [param userdata] passed into this method.\nIf [param userdata] is [code]null[/code], then [param callable] must take only the [code]state[/code] parameter."
msgstr "A test egyéni erőintegrálási visszahívását a [param callable] értékre állítja. A visszahívás törléséhez adj át üres [Callable] értéket ([code skip-lint]Callable()[/code]).\nA motor a [param callable] függvényt minden fizikai lépésnél meghívja a szokásos erőintegrálás előtt (lásd: [method body_set_omit_force_integration]). Használható például a test lineáris és szögsebességének frissítésére a többi testtel való érintkezés alapján.\nHa a [param userdata] értéke nem [code]null[/code], a [param callable] függvénynek két paramétert kell fogadnia:\n1. [code]state[/code]: A test állapotának lekéréséhez és módosításához használt [PhysicsDirectBodyState2D].\n2. [code skip-lint]userdata[/code]: Egy [Variant] érték, amely ennek a metódusnak átadott [param userdata] értékét kapja.\nHa a [param userdata] értéke [code]null[/code], a [param callable] csak a [code]state[/code] paramétert fogadja."

#. PhysicsServer2D.body_set_max_contacts_reported
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the maximum number of contacts that the body can report. If [param amount] is greater than zero, then the body will keep track of at most this many contacts with other bodies."
msgstr "Beállítja, hogy a test legfeljebb hány érintkezést jelenthet. Ha a [param amount] nagyobb nullánál, a test legfeljebb ennyi érintkezést tart nyilván a többi testtel."

#. PhysicsServer2D.body_set_omit_force_integration
#: doc/classes/PhysicsServer2D.xml
msgid "Sets whether the body omits the standard force integration. If [param enable] is [code]true[/code], the body will not automatically use applied forces, torques, and damping to update the body's linear and angular velocity. In this case, [method body_set_force_integration_callback] can be used to manually update the linear and angular velocity instead.\nThis method is called when the property [member RigidBody2D.custom_integrator] is set."
msgstr "Beállítja, hogy a test kihagyja-e a szokásos erőintegrálást. Ha a [param enable] értéke [code]true[/code], a motor a test lineáris és szögsebességét nem frissíti automatikusan a rá ható erők, nyomatékok és csillapítás alapján. Ilyenkor a [method body_set_force_integration_callback] segítségével kézzel frissítheted ezeket a sebességeket.\nEz a metódus a [member RigidBody2D.custom_integrator] tulajdonság beállításakor hívódik meg."

#. PhysicsServer2D.body_set_shape_as_one_way_collision
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the one-way collision properties of the body's shape with the given index. If [param enable] is [code]true[/code], the one-way collision direction given by [param direction] in the shape's local space (that is [code]body_get_shape_transform(body, shape_idx).basis_xform(direction).normalized()[/code] in the body's local space) will be used to ignore collisions with the shape in the opposite direction, and to ensure depenetration of kinematic bodies happens in this direction."
msgstr "Beállítja a test megadott indexű alakzatának egyirányú ütközését. Ha a [param enable] értéke [code]true[/code], az egyirányú ütközés irányát az alakzat helyi terében megadott [param direction] határozza meg (a test helyi terében ez [code]body_get_shape_transform(body, shape_idx).basis_xform(direction).normalized()[/code]). A motor figyelmen kívül hagyja az ellenkező irányú ütközéseket, és a kinematikus testeket a beállított irányban mozdítja ki az átfedésből."

#. PhysicsServer2D.body_set_space
#: doc/classes/PhysicsServer2D.xml
msgid "Adds the body to the given space, after removing the body from the previously assigned space (if any). If the body's mode is set to [constant BODY_MODE_RIGID], then adding the body to a space will have the following additional effects:\n- If the parameter [constant BODY_PARAM_CENTER_OF_MASS] has never been set explicitly, then the value of that parameter will be recalculated based on the body's shapes.\n- If the parameter [constant BODY_PARAM_INERTIA] is set to a value [code]<= 0.0[/code], then the value of that parameter will be recalculated based on the body's shapes, mass, and center of mass.\n[b]Note:[/b] To remove a body from a space without immediately adding it back elsewhere, use [code]PhysicsServer2D.body_set_space(body, RID())[/code]."
msgstr "A megadott térhez adja a testet, miután eltávolította a korábban hozzárendelt térből, ha volt ilyen. [constant BODY_MODE_RIGID] módban a térhez adásnak további hatásai vannak:\n- Ha a [constant BODY_PARAM_CENTER_OF_MASS] paramétert még nem állították be külön, a motor a test alakzatai alapján újraszámítja.\n- Ha a [constant BODY_PARAM_INERTIA] értéke [code]<= 0.0[/code], a motor a test alakzatai, tömege és tömegközéppontja alapján újraszámítja.\n[b]Megjegyzés:[/b] A test másik térhez rendelés nélküli eltávolításához használd a [code]PhysicsServer2D.body_set_space(body, RID())[/code] hívást."

#. PhysicsServer2D.body_set_state
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the value of a body's state.\n[b]Note:[/b] The state change doesn't take effect immediately. The state will change on the next physics frame."
msgstr "Beállítja a test állapotértékét.\n[b]Megjegyzés:[/b] Az állapotváltozás a következő fizikai képkockán lép életbe."

#. PhysicsServer2D.body_set_state_sync_callback
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the body's state synchronization callback function to [param callable]. Use an empty [Callable] ([code skip-lint]Callable()[/code]) to clear the callback.\nThe function [param callable] will be called every physics frame, assuming that the body was active during the previous physics tick, and can be used to fetch the latest state from the physics server.\nThe function [param callable] must take the following parameters:\n1. [code]state[/code]: a [PhysicsDirectBodyState2D], used to retrieve the body's state."
msgstr "A test állapotszinkronizálási visszahívását a [param callable] értékre állítja. A visszahívás törléséhez adj át üres [Callable] értéket ([code skip-lint]Callable()[/code]).\nHa a test az előző fizikai lépésben aktív volt, a motor minden fizikai képkockán meghívja a [param callable] függvényt. Ebből lekérhető a fizikakiszolgáló legfrissebb állapota.\nA [param callable] függvény a következő paramétert fogadja:\n1. [code]state[/code]: A test állapotának lekéréséhez használt [PhysicsDirectBodyState2D]."

#. PhysicsServer2D.body_test_motion
#: doc/classes/PhysicsServer2D.xml
msgid "Returns [code]true[/code] if a collision would result from moving the body along a motion vector from a given point in space. See [PhysicsTestMotionParameters2D] for the available motion parameters. Optionally a [PhysicsTestMotionResult2D] object can be passed, which will be used to store the information about the resulting collision."
msgstr "[code]true[/code] értéket ad vissza, ha a test a megadott térbeli pontból az elmozdulásvektor mentén mozgatva ütközne. Az elérhető mozgatási paramétereket a [PhysicsTestMotionParameters2D] ismerteti. Opcionálisan megadhatsz egy [PhysicsTestMotionResult2D] objektumot az ütközés adatainak tárolására."

#. PhysicsServer2D.joint_create
#: doc/classes/PhysicsServer2D.xml
msgid "Creates a 2D joint in the physics server, and returns the [RID] that identifies it. To set the joint type, use [method joint_make_damped_spring], [method joint_make_groove] or [method joint_make_pin]. Use [method joint_set_param] to set generic joint parameters."
msgstr "2D csuklót hoz létre a fizikakiszolgálón, és visszaadja a csukló [RID] azonosítóját. A típus beállításához használd a [method joint_make_damped_spring], a [method joint_make_groove] vagy a [method joint_make_pin] metódust. Az általános paraméterek a [method joint_set_param] metódussal állíthatók be."

#. PhysicsServer2D.joint_make_damped_spring
#: doc/classes/PhysicsServer2D.xml
msgid "Makes the joint a damped spring joint, attached at the point [param anchor_a] (given in global coordinates) on the body [param body_a] and at the point [param anchor_b] (given in global coordinates) on the body [param body_b]. To set the parameters which are specific to the damped spring, see [method damped_spring_joint_set_param]."
msgstr "Csillapított rugós csuklóvá alakítja a csuklót. A [param body_a] testen a globális koordinátákban megadott [param anchor_a] ponthoz, a [param body_b] testen pedig a globális koordinátákban megadott [param anchor_b] ponthoz rögzíti. A csillapított rugó saját paraméterei a [method damped_spring_joint_set_param] metódussal állíthatók be."

#. PhysicsServer2D.joint_make_pin
#: doc/classes/PhysicsServer2D.xml
msgid "Makes the joint a pin joint. If [param body_b] is an empty [RID], then [param body_a] is pinned to the point [param anchor] (given in global coordinates); otherwise, [param body_a] is pinned to [param body_b] at the point [param anchor] (given in global coordinates). To set the parameters which are specific to the pin joint, see [method pin_joint_set_param]."
msgstr "Forgócsuklóvá alakítja a csuklót. Ha a [param body_b] üres [RID], a [param body_a] testet a globális koordinátákban megadott [param anchor] ponthoz rögzíti. Egyébként a [param body_a] testet a [param body_b] testhez rögzíti a globális koordinátákban megadott [param anchor] pontnál. A forgócsukló saját paraméterei a [method pin_joint_set_param] metódussal állíthatók be."

#. PhysicsServer2D.separation_ray_shape_create
#: doc/classes/PhysicsServer2D.xml
msgid "Creates a 2D separation ray shape in the physics server, and returns the [RID] that identifies it. Use [method shape_set_data] to set the shape's [code]length[/code] and [code]slide_on_slope[/code] properties."
msgstr "2D elválasztósugár-alakzatot hoz létre a fizikakiszolgálón, és visszaadja annak [RID] azonosítóját. A [code]length[/code] és a [code]slide_on_slope[/code] tulajdonságot a [method shape_set_data] metódussal állíthatod be."

#. PhysicsServer2D.shape_get_data
#: doc/classes/PhysicsServer2D.xml
msgid "Returns the shape data that defines the configuration of the shape, such as the half-extents of a rectangle or the segments of a concave shape. See [method shape_set_data] for the precise format of this data in each case."
msgstr "Visszaadja az alakzatot meghatározó adatokat, például a téglalap félméreteit vagy a homorú alakzat szakaszait. Az egyes alakzatok adatformátumát a [method shape_set_data] ismerteti."

#. PhysicsServer2D.SPACE_PARAM_CONTACT_MAX_ALLOWED_PENETRATION
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the maximum distance a shape can penetrate another shape before it is considered a collision. The default value of this parameter is [member ProjectSettings.physics/2d/solver/contact_max_allowed_penetration]."
msgstr "Az a legnagyobb távolság, amennyire egy alakzat egy másikba hatolhat, mielőtt a motor ezt ütközésnek tekinti. Az érték ezzel az állandóval állítható be vagy kérhető le. Az alapértelmezett érték a [member ProjectSettings.physics/2d/solver/contact_max_allowed_penetration] beállításból származik."

#. PhysicsServer2D.SPACE_PARAM_CONTACT_DEFAULT_BIAS
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the default solver bias for all physics contacts. A solver bias is a factor controlling how much two objects \"rebound\", after overlapping, to avoid leaving them in that state because of numerical imprecision. The default value of this parameter is [member ProjectSettings.physics/2d/solver/default_contact_bias]."
msgstr "Az összes fizikai érintkezés alapértelmezett korrekciós tényezőjének beállítására és lekérésére szolgáló állandó. A tényező azt szabályozza, milyen erősen távolodjon el egymástól két átfedő objektum. Ezzel elkerülhető, hogy a számítási pontatlanság miatt átfedésben maradjanak. Az alapértelmezett érték a [member ProjectSettings.physics/2d/solver/default_contact_bias] beállításból származik."

#. PhysicsServer2D.SPACE_PARAM_BODY_LINEAR_VELOCITY_SLEEP_THRESHOLD
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the threshold linear velocity of activity. A body marked as potentially inactive for both linear and angular velocity will be put to sleep after the time given. The default value of this parameter is [member ProjectSettings.physics/2d/sleep_threshold_linear]."
msgstr "Az aktivitási küszöbként használt lineáris sebesség beállítására és lekérésére szolgáló állandó. Ha a test a lineáris és a szögsebessége alapján is inaktív lehet, a megadott idő elteltével alvó állapotba kerül. Az alapértelmezett érték a [member ProjectSettings.physics/2d/sleep_threshold_linear] beállításból származik."

#. PhysicsServer2D.SPACE_PARAM_BODY_ANGULAR_VELOCITY_SLEEP_THRESHOLD
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the threshold angular velocity of activity. A body marked as potentially inactive for both linear and angular velocity will be put to sleep after the time given. The default value of this parameter is [member ProjectSettings.physics/2d/sleep_threshold_angular]."
msgstr "Az aktivitási küszöbként használt szögsebesség beállítására és lekérésére szolgáló állandó. Ha a test a lineáris és a szögsebessége alapján is inaktív lehet, a megadott idő elteltével alvó állapotba kerül. Az alapértelmezett érték a [member ProjectSettings.physics/2d/sleep_threshold_angular] beállításból származik."

#. PhysicsServer2D.SPACE_PARAM_CONSTRAINT_DEFAULT_BIAS
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the default solver bias for all physics constraints. A solver bias is a factor controlling how much two objects \"rebound\", after violating a constraint, to avoid leaving them in that state because of numerical imprecision. The default value of this parameter is [member ProjectSettings.physics/2d/solver/default_constraint_bias]."
msgstr "Az összes fizikai kényszer alapértelmezett korrekciós tényezőjének beállítására és lekérésére szolgáló állandó. A tényező azt szabályozza, milyen erősen mozduljon vissza két objektum a kényszer megsértése után. Ezzel elkerülhető, hogy a számítási pontatlanság miatt ebben az állapotban maradjanak. Az alapértelmezett érték a [member ProjectSettings.physics/2d/solver/default_constraint_bias] beállításból származik."

#. PhysicsServer2D.SPACE_PARAM_SOLVER_ITERATIONS
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the number of solver iterations for all contacts and constraints. The greater the number of iterations, the more accurate the collisions will be. However, a greater number of iterations requires more CPU power, which can decrease performance. The default value of this parameter is [member ProjectSettings.physics/2d/solver/solver_iterations]."
msgstr "Az érintkezések és a kényszerek megoldásakor használt iterációszám beállítására és lekérésére szolgáló állandó. Több iteráció pontosabb ütközéseket eredményez, de nagyobb processzorterheléssel és így kisebb teljesítménnyel járhat. Az alapértelmezett érték a [member ProjectSettings.physics/2d/solver/solver_iterations] beállításból származik."

#. PhysicsServer2D.AREA_PARAM_GRAVITY_POINT_UNIT_DISTANCE
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the distance at which the gravity strength is equal to the gravity controlled by [constant AREA_PARAM_GRAVITY]. For example, on a planet 100 pixels in radius with a surface gravity of 4.0 px/s², set the gravity to 4.0 and the unit distance to 100.0. The gravity will have falloff according to the inverse square law, so in the example, at 200 pixels from the center the gravity will be 1.0 px/s² (twice the distance, 1/4th the gravity), at 50 pixels it will be 16.0 px/s² (half the distance, 4x the gravity), and so on.\nThe above is true only when the unit distance is a positive number. When the unit distance is set to 0.0, the gravity will be constant regardless of distance. The default value of this parameter is [code]0.0[/code]."
msgstr "Annak a távolságnak a beállítására és lekérésére szolgáló állandó, ahol a gravitáció erőssége megegyezik a [constant AREA_PARAM_GRAVITY] értékével. Például egy 100 képpont sugarú, a felszínén 4.0 px/s² gravitációjú bolygón a gravitáció értéke legyen 4.0, az egységtávolság pedig 100.0. A gravitáció a távolság négyzetével fordított arányban gyengül. A középponttól 200 képpont távolságra 1.0 px/s² lesz (kétszeres távolság, 1/4-ed akkora gravitáció), 50 képpont távolságra pedig 16.0 px/s² (feleakkora távolság, 4-szeres gravitáció).\nEz csak pozitív egységtávolságnál érvényes. 0.0 értéknél a gravitáció a távolságtól függetlenül állandó. Az alapértelmezett érték [code]0.0[/code]."

#. PhysicsServer2D.BODY_PARAM_MASS
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get a body's mass. The default value of this parameter is [code]1.0[/code]. If the body's mode is set to [constant BODY_MODE_RIGID], then setting this parameter will have the following additional effects:\n- If the parameter [constant BODY_PARAM_CENTER_OF_MASS] has never been set explicitly, then the value of that parameter will be recalculated based on the body's shapes.\n- If the parameter [constant BODY_PARAM_INERTIA] is set to a value [code]<= 0.0[/code], then the value of that parameter will be recalculated based on the body's shapes, mass, and center of mass."
msgstr "A test tömegének beállítására és lekérésére szolgáló állandó. Alapértelmezett értéke [code]1.0[/code]. [constant BODY_MODE_RIGID] módban a tömeg beállításának további hatásai vannak:\n- Ha a [constant BODY_PARAM_CENTER_OF_MASS] paramétert még nem állították be külön, a motor a test alakzatai alapján újraszámítja.\n- Ha a [constant BODY_PARAM_INERTIA] értéke [code]<= 0.0[/code], a motor a test alakzatai, tömege és tömegközéppontja alapján újraszámítja."

#. PhysicsServer2D.BODY_PARAM_CENTER_OF_MASS
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get a body's center of mass position in the body's local coordinate system. The default value of this parameter is [code]Vector2(0, 0)[/code]. If this parameter is never set explicitly, then it is recalculated based on the body's shapes when setting the parameter [constant BODY_PARAM_MASS] or when calling [method body_set_space]."
msgstr "A test tömegközéppontjának beállítására és lekérésére szolgáló állandó a test helyi koordináta-rendszerében. Alapértelmezett értéke [code]Vector2(0, 0)[/code]. Ha még nem adták meg külön, a [constant BODY_PARAM_MASS] paraméter beállításakor vagy a [method body_set_space] hívásakor a motor a test alakzataiból számítja ki."

#. PhysicsServer2D.JOINT_PARAM_BIAS
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get how fast the joint pulls the bodies back to satisfy the joint constraint. The lower the value, the more the two bodies can pull on the joint. The default value of this parameter is [code]0.0[/code].\n[b]Note:[/b] In Godot Physics, this parameter is only used for pin joints and groove joints."
msgstr "Annak beállítására és lekérésére szolgáló állandó, hogy a csukló milyen gyorsan húzza vissza a testeket a kényszernek megfelelő állapotba. Kisebb értéknél a két test nagyobb mértékben elhúzhatja a csuklót. Alapértelmezett értéke [code]0.0[/code].\n[b]Megjegyzés:[/b] A Godot Physics ezt a paramétert csak forgócsuklóknál és horonycsuklóknál használja."

#. PhysicsServer2D.JOINT_PARAM_MAX_BIAS
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the maximum speed with which the joint can apply corrections. The default value of this parameter is [code]3.40282e+38[/code].\n[b]Note:[/b] In Godot Physics, this parameter is only used for groove joints."
msgstr "A csukló korrekciós sebességének felső határa. Az érték ezzel az állandóval állítható be vagy kérhető le. Alapértelmezett értéke [code]3.40282e+38[/code].\n[b]Megjegyzés:[/b] A Godot Physics ezt a paramétert csak horonycsuklóknál használja."

#. PhysicsServer2D.JOINT_PARAM_MAX_FORCE
#: doc/classes/PhysicsServer2D.xml
msgid "Constant to set/get the maximum force that the joint can use to act on the two bodies. The default value of this parameter is [code]3.40282e+38[/code].\n[b]Note:[/b] In Godot Physics, this parameter is only used for groove joints."
msgstr "A két testre ható csuklóerő felső határa. Az érték ezzel az állandóval állítható be vagy kérhető le. Alapértelmezett értéke [code]3.40282e+38[/code].\n[b]Megjegyzés:[/b] A Godot Physics ezt a paramétert csak horonycsuklóknál használja."

#. PhysicsServer2D.DAMPED_SPRING_DAMPING
#: doc/classes/PhysicsServer2D.xml
msgid "Sets the damping ratio of the spring joint. A value of 0 indicates an undamped spring, while 1 causes the system to reach equilibrium as fast as possible (critical damping). The default value of this parameter is [code]1.5[/code]."
msgstr "Beállítja a rugós csukló csillapítási arányát. A 0 érték csillapítatlan rugót jelent. Az 1 értéknél a rendszer a lehető leggyorsabban éri el az egyensúlyt (kritikus csillapítás). Alapértelmezett értéke [code]1.5[/code]."

#. PhysicsServer3D.brief
#: doc/classes/PhysicsServer3D.xml
msgid "A server interface for low-level 3D physics access."
msgstr "Kiszolgálói felület a 3D fizika alacsony szintű eléréséhez."

#. PhysicsServer3D.description
#: doc/classes/PhysicsServer3D.xml
msgid "PhysicsServer3D is the server responsible for all 3D physics. It can directly create and manipulate all physics objects:\n- A [i]space[/i] is a self-contained world for a physics simulation. It contains bodies, areas, and joints. Its state can be queried for collision and intersection information, and several parameters of the simulation can be modified.\n- A [i]shape[/i] is a geometric shape such as a sphere, a box, a cylinder, or a polygon. It can be used for collision detection by adding it to a body/area, possibly with an extra transformation relative to the body/area's origin. Bodies/areas can have multiple (transformed) shapes added to them, and a single shape can be added to bodies/areas multiple times with different local transformations.\n- A [i]body[/i] is a physical object which can be in static, kinematic, or rigid mode. Its state (such as position and velocity) can be queried and updated. A force integration callback can be set to customize the body's physics.\n- An [i]area[/i] is a region in space which can be used to detect bodies and areas entering and exiting it. A body monitoring callback can be set to report entering/exiting body shapes, and similarly an area monitoring callback can be set. Gravity and damping can be overridden within the area by setting area parameters.\n- A [i]joint[/i] is a constraint, either between two bodies or on one body relative to a point. Parameters such as the joint bias and the rest length of a spring joint can be adjusted.\nPhysics objects in [PhysicsServer3D] may be created and manipulated independently; they do not have to be tied to nodes in the scene tree.\n[b]Note:[/b] All the 3D physics nodes use the physics server internally. Adding a physics node to the scene tree will cause a corresponding physics object to be created in the physics server. A rigid body node registers a callback that updates the node's transform with the transform of the respective body object in the physics server (every physics update). An area node registers a callback to inform the area node about overlaps with the respective area object in the physics server. The raycast node queries the direct state of the relevant space in the physics server."
msgstr "A PhysicsServer3D kezeli a teljes 3D fizikát. Közvetlenül létrehozhat és módosíthat bármilyen fizikai objektumot:\n- A [i]tér[/i] a fizikai szimuláció önálló világa. Testeket, területeket és csuklókat tartalmaz. Az állapotából ütközési és metszési adatok kérhetők le, és a szimuláció több paramétere módosítható.\n- Az [i]alakzat[/i] geometriai forma, például gömb, doboz, henger vagy sokszög. Ütközésérzékeléshez testhez vagy területhez adható, szükség szerint az origóhoz viszonyított további transzformációval. Egy testhez vagy területhez több transzformált alakzat is rendelhető, és ugyanaz az alakzat különböző helyi transzformációkkal többször is hozzárendelhető.\n- A [i]test[/i] olyan fizikai objektum, amely statikus, kinematikus vagy merev módban működhet. Az állapota, például a helye és sebessége lekérhető és módosítható. A fizikája az erőintegrálást végző visszahívással szabható testre.\n- A [i]terület[/i] a tér egy része, amely érzékelheti testek és más területek be- és kilépését. A testfigyelő visszahívás jelzi a testek alakzatainak be- és kilépését. Hasonló módon területfigyelő visszahívás is beállítható. A terület paramétereivel helyileg felülírható a gravitáció és a csillapítás.\n- A [i]csukló[/i] két test közötti vagy egy testet ponthoz kötő fizikai kényszer. A csukló paraméterei, például a korrekciós tényező és a rugó nyugalmi hossza módosíthatók.\nA [PhysicsServer3D] fizikai objektumai önállóan létrehozhatók és módosíthatók. Nem kell a jelenetfa csomópontjaihoz kötni őket.\n[b]Megjegyzés:[/b] Belsőleg minden 3D fizikai csomópont a fizikakiszolgálót használja. Amikor fizikai csomópont kerül a jelenetfába, a kiszolgáló létrehozza a neki megfelelő fizikai objektumot. A merev test csomópontja olyan visszahívást regisztrál, amely minden fizikai frissítéskor a kiszolgálóban tárolt test transzformációjához igazítja a csomópontot. A terület csomópontja a kiszolgálónál nyilvántartott átfedésekről kap értesítést a visszahívásán keresztül. A sugárvizsgáló csomópont a kiszolgáló megfelelő terének közvetlen állapotát kérdezi le."

#. PhysicsServer3D.area_add_shape
#: doc/classes/PhysicsServer3D.xml
msgid "Adds a shape to the area, along with a transform matrix. Shapes are usually referenced by their index, so you should track which shape has a given index."
msgstr "Alakzatot ad a területhez a transzformációs mátrixával együtt. Az alakzatokra általában az indexükkel hivatkoznak, ezért érdemes nyilvántartani, melyik index melyik alakzathoz tartozik."

#. PhysicsServer3D.area_clear_shapes
#: doc/classes/PhysicsServer3D.xml
msgid "Removes all shapes from an area. It does not delete the shapes, so they can be reassigned later."
msgstr "Eltávolítja a terület összes alakzatát. Az alakzatok megmaradnak, így később újra hozzárendelhetők."

#. PhysicsServer3D.area_create
#: doc/classes/PhysicsServer3D.xml
msgid "Creates a 3D area object in the physics server, and returns the [RID] that identifies it. The default settings for the created area include a collision layer and mask set to [code]1[/code], and [code]monitorable[/code] set to [code]false[/code].\nUse [method area_add_shape] to add shapes to it, use [method area_set_transform] to set its transform, and use [method area_set_space] to add the area to a space. If you want the area to be detectable use [method area_set_monitorable]."
msgstr "3D területet hoz létre a fizikakiszolgálón, és visszaadja annak [RID] azonosítóját. Az ütközési réteg és maszk kezdeti értéke [code]1[/code], a [code]monitorable[/code] értéke [code]false[/code].\nAlakzatot a [method area_add_shape] metódussal adhatsz hozzá, a transzformációt a [method area_set_transform] metódussal állíthatod be, a területet pedig a [method area_set_space] metódussal adhatod hozzá egy térhez. Ha azt szeretnéd, hogy más területek észleljék, használd a [method area_set_monitorable] metódust."

#. PhysicsServer3D.area_get_collision_layer
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the physics layer or layers an area belongs to."
msgstr "Visszaadja azt a fizikai réteget vagy azokat a rétegeket, amelyekhez a terület tartozik."

#. PhysicsServer3D.area_get_collision_mask
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the physics layer or layers an area can contact with."
msgstr "Visszaadja azt a fizikai réteget vagy azokat a rétegeket, amelyekkel a terület érintkezhet."

#. PhysicsServer3D.area_get_param
#: doc/classes/PhysicsServer3D.xml
msgid "Returns an area parameter value. A list of available parameters is on the [enum AreaParameter] constants."
msgstr "Visszaadja a terület egyik paraméterének értékét. Az elérhető paraméterek az [enum AreaParameter] állandói."

#. PhysicsServer3D.area_get_shape
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the [RID] of the nth shape of an area."
msgstr "Visszaadja a terület adott sorszámú alakzatának [RID] azonosítóját."

#. PhysicsServer3D.area_get_shape_count
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the number of shapes assigned to an area."
msgstr "Visszaadja a területhez rendelt alakzatok számát."

#. PhysicsServer3D.area_get_shape_transform
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the transform matrix of a shape within an area."
msgstr "Visszaadja egy területen belüli alakzat transzformációs mátrixát."

#. PhysicsServer3D.area_get_space
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the space assigned to the area."
msgstr "Visszaadja a területhez rendelt fizikai teret."

#. PhysicsServer3D.area_get_transform
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the transform matrix for an area."
msgstr "Visszaadja a terület transzformációs mátrixát."

#. PhysicsServer3D.area_remove_shape
#: doc/classes/PhysicsServer3D.xml
msgid "Removes a shape from an area. It does not delete the shape, so it can be reassigned later."
msgstr "Eltávolít egy alakzatot a területről. Maga az alakzat megmarad, így később újra hozzárendelhető."

#. PhysicsServer3D.area_set_collision_layer
#: doc/classes/PhysicsServer3D.xml
msgid "Assigns the area to one or many physics layers."
msgstr "Egy vagy több fizikai réteghez rendeli a területet."

#. PhysicsServer3D.area_set_collision_mask
#: doc/classes/PhysicsServer3D.xml
msgid "Sets which physics layers the area will monitor."
msgstr "Beállítja, hogy a terület melyik fizikai rétegeket figyelje."

#. PhysicsServer3D.area_set_param
#: doc/classes/PhysicsServer3D.xml
msgid "Sets the value for an area parameter. A list of available parameters is on the [enum AreaParameter] constants."
msgstr "Beállítja a terület egyik paraméterének értékét. Az elérhető paraméterek az [enum AreaParameter] állandói."

#. PhysicsServer3D.area_set_ray_pickable
#: doc/classes/PhysicsServer3D.xml
msgid "Sets object pickable with rays."
msgstr "Beállítja, hogy az objektum kiválasztható-e sugárral."

#. PhysicsServer3D.area_set_shape
#: doc/classes/PhysicsServer3D.xml
msgid "Substitutes a given area shape by another. The old shape is selected by its index, the new one by its [RID]."
msgstr "Lecseréli a terület megadott alakzatát. A régi alakzatot az indexe, az újat a [RID] azonosítója adja meg."

#. PhysicsServer3D.body_add_constant_central_force
#: doc/classes/PhysicsServer3D.xml
msgid "Adds a constant directional force without affecting rotation that keeps being applied over time until cleared with [code]body_set_constant_force(body, Vector3(0, 0, 0))[/code].\nThis is equivalent to using [method body_add_constant_force] at the body's center of mass."
msgstr "Állandó irányú erőt fejt ki a forgás befolyásolása nélkül. Az erő addig hat, amíg a [code]body_set_constant_force(body, Vector3(0, 0, 0))[/code] hívással nem törlik.\nEgyenértékű a [method body_add_constant_force] alkalmazásával a test tömegközéppontjában."

#. PhysicsServer3D.body_add_constant_force
#: doc/classes/PhysicsServer3D.xml
msgid "Adds a constant positioned force to the body that keeps being applied over time until cleared with [code]body_set_constant_force(body, Vector3(0, 0, 0))[/code].\n[param position] is the offset from the body origin in global coordinates."
msgstr "Állandó erőt fejt ki a test egy adott pontjára. Az erő addig hat, amíg a [code]body_set_constant_force(body, Vector3(0, 0, 0))[/code] hívással nem törlik.\nA [param position] a test origójához viszonyított eltolás globális koordinátákban."

#. PhysicsServer3D.body_add_constant_torque
#: doc/classes/PhysicsServer3D.xml
msgid "Adds a constant rotational force without affecting position that keeps being applied over time until cleared with [code]body_set_constant_torque(body, Vector3(0, 0, 0))[/code]."
msgstr "Állandó forgatónyomatékot fejt ki a test helyzetének módosítása nélkül. A nyomaték addig hat, amíg a [code]body_set_constant_torque(body, Vector3(0, 0, 0))[/code] hívással nem törlik."

#. PhysicsServer3D.body_apply_central_force
#: doc/classes/PhysicsServer3D.xml
msgid "Applies a directional force without affecting rotation. A force is time dependent and meant to be applied every physics update.\nThis is equivalent to using [method body_apply_force] at the body's center of mass."
msgstr "Irányított erőt fejt ki a forgás befolyásolása nélkül. Az erő időfüggő, ezért fizikai frissítésenként kell alkalmazni.\nEgyenértékű a [method body_apply_force] alkalmazásával a test tömegközéppontjában."

#. PhysicsServer3D.body_apply_central_impulse
#: doc/classes/PhysicsServer3D.xml
msgid "Applies a directional impulse without affecting rotation.\nAn impulse is time-independent! Applying an impulse every frame would result in a framerate-dependent force. For this reason, it should only be used when simulating one-time impacts (use the \"_force\" functions otherwise).\nThis is equivalent to using [method body_apply_impulse] at the body's center of mass."
msgstr "Irányított impulzust ad a forgás befolyásolása nélkül.\nAz impulzus időfüggetlen. Ha minden képkockán impulzust alkalmaznál, a hatás a képkockasebességtől függne. Ezért csak egyszeri behatás szimulálására használd. Folyamatos hatáshoz a „_force” függvényeket használd.\nEgyenértékű a [method body_apply_impulse] alkalmazásával a test tömegközéppontjában."

#. PhysicsServer3D.body_apply_torque_impulse
#: doc/classes/PhysicsServer3D.xml
msgid "Applies a rotational impulse to the body without affecting the position.\nAn impulse is time-independent! Applying an impulse every frame would result in a framerate-dependent force. For this reason, it should only be used when simulating one-time impacts (use the \"_force\" functions otherwise)."
msgstr "Forgási impulzust ad a testnek a helyzet módosítása nélkül.\nAz impulzus időfüggetlen. Ha minden képkockán impulzust alkalmaznál, a hatás a képkockasebességtől függne. Ezért csak egyszeri behatás szimulálására használd. Folyamatos hatáshoz a „_force” függvényeket használd."

#. PhysicsServer3D.body_get_constant_force
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the body's total constant positional forces applied during each physics update.\nSee [method body_add_constant_force] and [method body_add_constant_central_force]."
msgstr "Visszaadja a testre minden fizikai frissítéskor, adott pontokon ható állandó erők összegét.\nLásd a [method body_add_constant_force] és a [method body_add_constant_central_force] metódust."

#. PhysicsServer3D.body_set_force_integration_callback
#: doc/classes/PhysicsServer3D.xml
msgid "Sets the body's custom force integration callback function to [param callable]. Use an empty [Callable] ([code skip-lint]Callable()[/code]) to clear the custom callback.\nThe function [param callable] will be called every physics tick, before the standard force integration (see [method body_set_omit_force_integration]). It can be used for example to update the body's linear and angular velocity based on contact with other bodies.\nIf [param userdata] is not [code]null[/code], the function [param callable] must take the following two parameters:\n1. [code]state[/code]: a [PhysicsDirectBodyState3D], used to retrieve and modify the body's state,\n2. [code skip-lint]userdata[/code]: a [Variant]; its value will be the [param userdata] passed into this method.\nIf [param userdata] is [code]null[/code], then [param callable] must take only the [code]state[/code] parameter."
msgstr "A test egyéni erőintegrálási visszahívását a [param callable] értékre állítja. A visszahívás törléséhez adj át üres [Callable] értéket ([code skip-lint]Callable()[/code]).\nA motor a [param callable] függvényt minden fizikai lépésnél meghívja a szokásos erőintegrálás előtt (lásd: [method body_set_omit_force_integration]). Használható például a test lineáris és szögsebességének frissítésére a többi testtel való érintkezés alapján.\nHa a [param userdata] értéke nem [code]null[/code], a [param callable] függvénynek két paramétert kell fogadnia:\n1. [code]state[/code]: A test állapotának lekéréséhez és módosításához használt [PhysicsDirectBodyState3D].\n2. [code skip-lint]userdata[/code]: Egy [Variant] érték, amely ennek a metódusnak átadott [param userdata] értékét kapja.\nHa a [param userdata] értéke [code]null[/code], a [param callable] csak a [code]state[/code] paramétert fogadja."

#. PhysicsServer3D.body_set_omit_force_integration
#: doc/classes/PhysicsServer3D.xml
msgid "Sets whether the body omits the standard force integration. If [param enable] is [code]true[/code], the body will not automatically use applied forces, torques, and damping to update the body's linear and angular velocity. In this case, [method body_set_force_integration_callback] can be used to manually update the linear and angular velocity instead.\nThis method is called when the property [member RigidBody3D.custom_integrator] is set."
msgstr "Beállítja, hogy a test kihagyja-e a szokásos erőintegrálást. Ha a [param enable] értéke [code]true[/code], a motor a test lineáris és szögsebességét nem frissíti automatikusan a rá ható erők, nyomatékok és csillapítás alapján. Ilyenkor a [method body_set_force_integration_callback] segítségével kézzel frissítheted ezeket a sebességeket.\nEz a metódus a [member RigidBody3D.custom_integrator] tulajdonság beállításakor hívódik meg."

#. PhysicsServer3D.body_set_state_sync_callback
#: doc/classes/PhysicsServer3D.xml
msgid "Sets the body's state synchronization callback function to [param callable]. Use an empty [Callable] ([code skip-lint]Callable()[/code]) to clear the callback.\nThe function [param callable] will be called every physics frame, assuming that the body was active during the previous physics tick, and can be used to fetch the latest state from the physics server.\nThe function [param callable] must take the following parameters:\n1. [code]state[/code]: a [PhysicsDirectBodyState3D], used to retrieve the body's state."
msgstr "A test állapotszinkronizálási visszahívását a [param callable] értékre állítja. A visszahívás törléséhez adj át üres [Callable] értéket ([code skip-lint]Callable()[/code]).\nHa a test az előző fizikai lépésben aktív volt, a motor minden fizikai képkockán meghívja a [param callable] függvényt. Ebből lekérhető a fizikakiszolgáló legfrissebb állapota.\nA [param callable] függvény a következő paramétert fogadja:\n1. [code]state[/code]: A test állapotának lekéréséhez használt [PhysicsDirectBodyState3D]."

#. PhysicsServer3D.custom_shape_create
#: doc/classes/PhysicsServer3D.xml
msgid "Creates a custom shape in the physics server, and returns the [RID] that identifies it. Use [method shape_set_data] to set the shape's data.\n[b]Note:[/b] Custom shapes are not supported by the built-in physics servers, so calling this method always produces an error when using Godot Physics or Jolt Physics. Custom physics servers implemented as GDExtensions may support a custom shape."
msgstr "Egyéni alakzatot hoz létre a fizikakiszolgálón, és visszaadja az alakzat [RID] azonosítóját. Az alakzat adatait a [method shape_set_data] metódussal állíthatod be.\n[b]Megjegyzés:[/b] A beépített fizikakiszolgálók nem támogatják az egyéni alakzatokat. A metódus Godot Physics vagy Jolt Physics használatakor mindig hibát jelez. A GDExtension formájában megvalósított egyéni fizikakiszolgálók támogathatják ezt az alakzattípust."

#. PhysicsServer3D.soft_body_apply_central_impulse
#. SoftBody3D.apply_central_impulse
#: doc/classes/PhysicsServer3D.xml doc/classes/SoftBody3D.xml
msgid "Distributes and applies an impulse to all points.\nAn impulse is time-independent! Applying an impulse every frame would result in a framerate-dependent force. For this reason, it should only be used when simulating one-time impacts (use the \"_force\" functions otherwise)."
msgstr "Szétosztja az impulzust, és minden pontra alkalmazza.\nAz impulzus időfüggetlen. Ha minden képkockán impulzust alkalmaznál, a hatás a képkockasebességtől függne. Ezért csak egyszeri behatás szimulálására használd. Folyamatos hatáshoz a „_force” függvényeket használd."

#. PhysicsServer3D.soft_body_get_state
#: doc/classes/PhysicsServer3D.xml
msgid "Returns the given soft body state.\n[b]Note:[/b] Godot's default physics implementation does not support [constant BODY_STATE_LINEAR_VELOCITY], [constant BODY_STATE_ANGULAR_VELOCITY], [constant BODY_STATE_SLEEPING], or [constant BODY_STATE_CAN_SLEEP]."
msgstr "Visszaadja a lágy test megadott állapotértékét.\n[b]Megjegyzés:[/b] A Godot alapértelmezett fizikai megvalósítása nem támogatja a [constant BODY_STATE_LINEAR_VELOCITY], a [constant BODY_STATE_ANGULAR_VELOCITY], a [constant BODY_STATE_SLEEPING] és a [constant BODY_STATE_CAN_SLEEP] állapotot."

#. PhysicsServer3D.soft_body_set_drag_coefficient
#: doc/classes/PhysicsServer3D.xml
msgid "Sets the drag coefficient of the given soft body. Higher values increase this body's air resistance.\n[b]Note:[/b] This value is currently unused by Godot's default physics implementation."
msgstr "Beállítja a megadott lágy test légellenállási tényezőjét. Nagyobb értéknél nagyobb a test légellenállása.\n[b]Megjegyzés:[/b] A Godot alapértelmezett fizikai megvalósítása jelenleg nem használja ezt az értéket."

#. PhysicsServer3D.soft_body_set_state
#: doc/classes/PhysicsServer3D.xml
msgid "Sets the given body state for the given body.\n[b]Note:[/b] Godot's default physics implementation does not support [constant BODY_STATE_LINEAR_VELOCITY], [constant BODY_STATE_ANGULAR_VELOCITY], [constant BODY_STATE_SLEEPING], or [constant BODY_STATE_CAN_SLEEP]."
msgstr "Beállítja a megadott test megadott állapotértékét.\n[b]Megjegyzés:[/b] A Godot alapértelmezett fizikai megvalósítása nem támogatja a [constant BODY_STATE_LINEAR_VELOCITY], a [constant BODY_STATE_ANGULAR_VELOCITY], a [constant BODY_STATE_SLEEPING] és a [constant BODY_STATE_CAN_SLEEP] állapotot."

#. PhysicsServer3D.space_create
#: doc/classes/PhysicsServer3D.xml
msgid "Creates a space. A space is a collection of parameters for the physics engine that can be assigned to an area or a body. It can be assigned to an area with [method area_set_space], or to a body with [method body_set_space]."
msgstr "Fizikai teret hoz létre. A tér a fizikai motor paramétereinek gyűjteménye, amely területhez vagy testhez rendelhető. Területhez a [method area_set_space], testhez a [method body_set_space] metódussal rendelhető."

#. PhysicsServer3D.space_set_active
#: doc/classes/PhysicsServer3D.xml
msgid "Marks a space as active. It will not have an effect, unless it is assigned to an area or body."
msgstr "Aktívnak jelöli a teret. Ennek csak akkor van hatása, ha a térhez terület vagy test van rendelve."

#. PhysicsServer3D.CONE_TWIST_JOINT_SWING_SPAN
#: doc/classes/PhysicsServer3D.xml
msgid "Swing is rotation from side to side, around the axis perpendicular to the twist axis.\nThe swing span defines, how much rotation will not get corrected along the swing axis.\nCould be defined as looseness in the [ConeTwistJoint3D]. If below 0.05, this behavior is locked."
msgstr "A kilengés a csavarodási tengelyre merőleges tengely körüli, oldalirányú forgás.\nA kilengési tartomány azt adja meg, mennyi forgást hagy a motor korrekció nélkül a kilengési tengely körül.\nA [ConeTwistJoint3D] lazaságaként is értelmezhető. 0.05 alatti értéknél a kilengés zárolt."

#. PhysicsServer3D.G6DOF_JOINT_ANGULAR_ERP
#: doc/classes/PhysicsServer3D.xml
msgid "When correcting the crossing of limits in rotation across the axes, this error tolerance factor defines how much the correction gets slowed down. The lower, the slower.\n[b]Note:[/b] Only supported when using GodotPhysics3D. This parameter is ignored when using Jolt Physics."
msgstr "A forgási határok túllépésének korrekciójakor ez a hibatűrési tényező szabályozza, mennyire lassuljon a korrekció. Kisebb értéknél lassabb.\n[b]Megjegyzés:[/b] Csak GodotPhysics3D használatakor támogatott. A Jolt Physics figyelmen kívül hagyja ezt a paramétert."

#. PhysicsServer3D.G6DOF_JOINT_FLAG_ENABLE_LINEAR_LIMIT
#: doc/classes/PhysicsServer3D.xml
msgid "If set, linear motion is possible within the given limits."
msgstr "Beállítva a lineáris mozgás a megadott határokon belül lehetséges."

#. PhysicsServer3D.G6DOF_JOINT_FLAG_ENABLE_ANGULAR_LIMIT
#: doc/classes/PhysicsServer3D.xml
msgid "If set, rotational motion is possible."
msgstr "Beállítva a forgás engedélyezett."

#. PhysicsServer3D.AREA_PARAM_GRAVITY_POINT_UNIT_DISTANCE
#: doc/classes/PhysicsServer3D.xml
msgid "Constant to set/get the distance at which the gravity strength is equal to the gravity controlled by [constant AREA_PARAM_GRAVITY]. For example, on a planet 100 meters in radius with a surface gravity of 4.0 m/s², set the gravity to 4.0 and the unit distance to 100.0. The gravity will have falloff according to the inverse square law, so in the example, at 200 meters from the center the gravity will be 1.0 m/s² (twice the distance, 1/4th the gravity), at 50 meters it will be 16.0 m/s² (half the distance, 4x the gravity), and so on.\nThe above is true only when the unit distance is a positive number. When this is set to 0.0, the gravity will be constant regardless of distance."
msgstr "Annak a távolságnak a beállítására és lekérésére szolgáló állandó, ahol a gravitáció erőssége megegyezik a [constant AREA_PARAM_GRAVITY] értékével. Például egy 100 méter sugarú, a felszínén 4.0 m/s² gravitációjú bolygón a gravitáció értéke legyen 4.0, az egységtávolság pedig 100.0. A gravitáció a távolság négyzetével fordított arányban gyengül. A középponttól 200 méter távolságra 1.0 m/s² lesz (kétszeres távolság, 1/4-ed akkora gravitáció), 50 méter távolságra pedig 16.0 m/s² (feleakkora távolság, 4-szeres gravitáció).\nEz csak pozitív egységtávolságnál érvényes. 0.0 értéknél a gravitáció a távolságtól függetlenül állandó."

#. PhysicsServer3D.SPACE_PARAM_CONTACT_MAX_ALLOWED_PENETRATION
#: doc/classes/PhysicsServer3D.xml
msgid "Constant to set/get the maximum distance a shape can penetrate another shape before it is considered a collision."
msgstr "Annak a legnagyobb távolságnak a beállítására vagy lekérésére szolgáló állandó, amennyire egy alakzat egy másikba hatolhat, mielőtt a motor ezt ütközésnek tekinti."

#. PhysicsServer3D.SPACE_PARAM_BODY_LINEAR_VELOCITY_SLEEP_THRESHOLD
#: doc/classes/PhysicsServer3D.xml
msgid "Constant to set/get the threshold linear velocity of activity. A body marked as potentially inactive for both linear and angular velocity will be put to sleep after the time given.\n[b]Note:[/b] Only supported when using GodotPhysics3D. This parameter is ignored when using Jolt Physics."
msgstr "Az aktivitási küszöbként használt lineáris sebesség beállítására és lekérésére szolgáló állandó. Ha a test a lineáris és a szögsebessége alapján is inaktív lehet, a megadott idő elteltével alvó állapotba kerül.\n[b]Megjegyzés:[/b] Csak GodotPhysics3D használatakor támogatott. A Jolt Physics figyelmen kívül hagyja ezt a paramétert."

#. PhysicsServer3D.SPACE_PARAM_BODY_ANGULAR_VELOCITY_SLEEP_THRESHOLD
#: doc/classes/PhysicsServer3D.xml
msgid "Constant to set/get the threshold angular velocity of activity. A body marked as potentially inactive for both linear and angular velocity will be put to sleep after the time given.\n[b]Note:[/b] Only supported when using GodotPhysics3D. This parameter is ignored when using Jolt Physics."
msgstr "Az aktivitási küszöbként használt szögsebesség beállítására és lekérésére szolgáló állandó. Ha a test a lineáris és a szögsebessége alapján is inaktív lehet, a megadott idő elteltével alvó állapotba kerül.\n[b]Megjegyzés:[/b] Csak GodotPhysics3D használatakor támogatott. A Jolt Physics figyelmen kívül hagyja ezt a paramétert."

#. PhysicsServer3D.SPACE_PARAM_SOLVER_ITERATIONS
#: doc/classes/PhysicsServer3D.xml
msgid "Constant to set/get the number of solver iterations for contacts and constraints. The greater the number of iterations, the more accurate the collisions and constraints will be. However, a greater number of iterations requires more CPU power, which can decrease performance."
msgstr "Az érintkezések és a kényszerek megoldásakor használt iterációszám beállítására és lekérésére szolgáló állandó. Több iteráció pontosabb ütközéseket és kényszereket eredményez, de nagyobb processzorterheléssel és így kisebb teljesítménnyel járhat."

#. PhysicsDirectBodyState2DExtension.brief
#: doc/classes/PhysicsDirectBodyState2DExtension.xml
msgid "Provides virtual methods that can be overridden to create custom [PhysicsDirectBodyState2D] implementations."
msgstr "Felülírható virtuális metódusokat biztosít a [PhysicsDirectBodyState2D] egyéni megvalósításához."

#. PhysicsDirectBodyState2DExtension.description
#: doc/classes/PhysicsDirectBodyState2DExtension.xml
msgid "This class extends [PhysicsDirectBodyState2D] by providing additional virtual methods that can be overridden. When these methods are overridden, they will be called instead of the internal methods of the physics server.\nIntended for use with GDExtension to create custom implementations of [PhysicsDirectBodyState2D]."
msgstr "Ez az osztály további felülírható virtuális metódusokkal egészíti ki a [PhysicsDirectBodyState2D] osztályt. Ha felülírod ezeket a metódusokat, a fizikakiszolgáló a saját belső metódusai helyett a felülírt változatokat hívja.\nGDExtensionhöz készült, a [PhysicsDirectBodyState2D] egyéni megvalósításához."

