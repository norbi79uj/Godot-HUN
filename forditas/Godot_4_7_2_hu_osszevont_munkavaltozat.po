msgid "A 2D vector type."
msgstr "2D-s vektortípus."

#. VisualShaderNodeClamp.OP_TYPE_VECTOR_3D
#. VisualShaderNodeCompare.CTYPE_VECTOR_3D
#. VisualShaderNodeDerivativeFunc.OP_TYPE_VECTOR_3D
#. VisualShaderNodeMix.OP_TYPE_VECTOR_3D
