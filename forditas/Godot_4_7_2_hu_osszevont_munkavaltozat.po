#. String.operator <
#: doc/classes/String.xml
msgid "Returns [code]true[/code] if the left [String] comes before [param right] in [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url], which roughly matches the alphabetical order. Useful for sorting."
msgstr "[code]true[/code] értéket ad vissza, ha a bal oldali [String] a [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode-sorrendben[/url] megelőzi a [param right] értéket. Ez a sorrend nagyjából megfelel az ábécésorrendnek. Rendezéshez használható."

#. String.operator <=
#: doc/classes/String.xml
msgid "Returns [code]true[/code] if the left [String] comes before [param right] in [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url], which roughly matches the alphabetical order, or if both are equal."
msgstr "[code]true[/code] értéket ad vissza, ha a bal oldali [String] a [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode-sorrendben[/url] megelőzi a [param right] értéket, vagy a két érték egyenlő. Ez a sorrend nagyjából megfelel az ábécésorrendnek."

#. String.operator >
#: doc/classes/String.xml
msgid "Returns [code]true[/code] if the left [String] comes after [param right] in [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url], which roughly matches the alphabetical order. Useful for sorting."
msgstr "[code]true[/code] értéket ad vissza, ha a bal oldali [String] a [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode-sorrendben[/url] követi a [param right] értéket. Ez a sorrend nagyjából megfelel az ábécésorrendnek. Rendezéshez használható."

#. String.operator >=
#: doc/classes/String.xml
msgid "Returns [code]true[/code] if the left [String] comes after [param right] in [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url], which roughly matches the alphabetical order, or if both are equal."
msgstr "[code]true[/code] értéket ad vissza, ha a bal oldali [String] a [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode-sorrendben[/url] követi a [param right] értéket, vagy a két érték egyenlő. Ez a sorrend nagyjából megfelel az ábécésorrendnek."

#. StringName.operator <
#: doc/classes/StringName.xml
msgid "Returns [code]true[/code] if the left [StringName]'s pointer comes before [param right]. Note that this will not match their [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url]."
msgstr "[code]true[/code] értéket ad vissza, ha a bal oldali [StringName] mutatójában tárolt memóriacím kisebb a [param right] mutatójában tárolt címnél. Ez a sorrend eltér a [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode-sorrendtől[/url]."

#. StringName.operator <=
#: doc/classes/StringName.xml
msgid "Returns [code]true[/code] if the left [StringName]'s pointer comes before [param right] or if they are the same. Note that this will not match their [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url]."
msgstr "[code]true[/code] értéket ad vissza, ha a bal oldali [StringName] mutatójában tárolt memóriacím kisebb a [param right] mutatójában tárolt címnél, vagy a két cím megegyezik. Ez a sorrend eltér a [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode-sorrendtől[/url]."

#. StringName.operator >
#: doc/classes/StringName.xml
msgid "Returns [code]true[/code] if the left [StringName]'s pointer comes after [param right]. Note that this will not match their [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url]."
msgstr "[code]true[/code] értéket ad vissza, ha a bal oldali [StringName] mutatójában tárolt memóriacím nagyobb a [param right] mutatójában tárolt címnél. Ez a sorrend eltér a [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode-sorrendtől[/url]."

#. StringName.operator >=
#: doc/classes/StringName.xml
msgid "Returns [code]true[/code] if the left [StringName]'s pointer comes after [param right] or if they are the same. Note that this will not match their [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url]."
msgstr "[code]true[/code] értéket ad vissza, ha a bal oldali [StringName] mutatójában tárolt memóriacím nagyobb a [param right] mutatójában tárolt címnél, vagy a két cím megegyezik. Ez a sorrend eltér a [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode-sorrendtől[/url]."

#. Array.brief
#: doc/classes/Array.xml
msgid "A built-in data structure that holds a sequence of elements."
msgstr "Elemek sorozatát tároló beépített adatszerkezet."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an empty [Array]."
msgstr "Üres [Array] tömböt hoz létre."

#. Array.Array
#: doc/classes/Array.xml
msgid "Returns the same array as [param from]. If you need a copy of the array, use [method duplicate]."
msgstr "Ugyanazt a tömböt adja vissza, mint a [param from] paraméterben átadott tömb. Másolathoz használd a [method duplicate] metódust."

#. Array.append
#: doc/classes/Array.xml
msgid "Appends [param value] at the end of the array (alias of [method push_back])."
msgstr "A [param value] értéket a tömb végéhez fűzi. A [method push_back] másik neve."

#. Array.append_array
#: doc/classes/Array.xml
msgid "Appends another [param array] at the end of this array.\n[codeblock]\nvar numbers = [1, 2, 3]\nvar extra = [4, 5, 6]\nnumbers.append_array(extra)\nprint(numbers) # Prints [1, 2, 3, 4, 5, 6]\n[/codeblock]"
msgstr "A megadott [param array] tömb elemeit ennek a tömbnek a végéhez fűzi.\n[codeblock]\nvar numbers = [1, 2, 3]\nvar extra = [4, 5, 6]\nnumbers.append_array(extra)\nprint(numbers) # Prints [1, 2, 3, 4, 5, 6]\n[/codeblock]"

#. Array.assign
#: doc/classes/Array.xml
msgid "Assigns elements of another [param array] into the array. Resizes the array to match [param array]. Performs type conversions if the array is typed."
msgstr "Átveszi a másik [param array] tömb elemeit. A méretet a [param array] tömb méretéhez igazítja. Típusos tömb esetén szükség szerint átalakítja az elemek típusát."

#. Array.back
#: doc/classes/Array.xml
msgid "Returns the last element of the array. If the array is empty, fails and returns [code]null[/code]. See also [method front].\n[b]Note:[/b] Unlike with the [code][][/code] operator ([code]array[-1][/code]), an error is generated without stopping project execution."
msgstr "Visszaadja a tömb utolsó elemét. Üres tömbnél a művelet sikertelen, az eredmény [code]null[/code]. Lásd még: [method front].\n[b]Megjegyzés:[/b] A [code][][/code] operátortól ([code]array[-1][/code]) eltérően úgy jelez hibát, hogy a projekt futása nem áll le."

#. Array.clear
#: doc/classes/Array.xml
msgid "Removes all elements from the array. This is equivalent to using [method resize] with a size of [code]0[/code]."
msgstr "Eltávolítja a tömb összes elemét. Ez egyenértékű a [method resize] használatával [code]0[/code] mérettel."

#. Array.count
#: doc/classes/Array.xml
msgid "Returns the number of times an element is in the array.\nTo count how many elements in an array satisfy a condition, see [method reduce]."
msgstr "Visszaadja, hányszor fordul elő egy elem a tömbben.\nHa egy feltételnek megfelelő elemeket szeretnél megszámolni, lásd a [method reduce] metódust."

#. Array.duplicate_deep
#: doc/classes/Array.xml
msgid "Duplicates this array, deeply, like [method duplicate] when passing [code]true[/code], with extra control over how subresources are handled.\n[param deep_subresources_mode] must be one of the values from [enum Resource.DeepDuplicateMode]. By default, only internal resources will be duplicated (recursively)."
msgstr "A [method duplicate] metódus [code]true[/code] paraméterű hívásához hasonlóan mély másolatot készít a tömbről, de külön szabályozható, hogyan kezelje a beágyazott erőforrásokat.\nA [param deep_subresources_mode] értékét a [enum Resource.DeepDuplicateMode] értékei közül kell kiválasztani. Alapértelmezés szerint csak a belső erőforrásokat másolja rekurzívan."

#. Array.fill
#: doc/classes/Array.xml
msgid "Assigns the given [param value] to all elements in the array.\nThis method can often be combined with [method resize] to create an array with a given size and initialized elements:\n[codeblocks]\n[gdscript]\nvar array = []\narray.resize(5)\narray.fill(2)\nprint(array) # Prints [2, 2, 2, 2, 2]\n[/gdscript]\n[csharp]\nGodot.Collections.Array array = [];\narray.Resize(5);\narray.Fill(2);\nGD.Print(array); // Prints [2, 2, 2, 2, 2]\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] If [param value] is a [Variant] passed by reference ([Object]-derived, [Array], [Dictionary], etc.), the array will be filled with references to the same [param value], which are not duplicates."
msgstr "A megadott [param value] értéket rendeli a tömb összes eleméhez.\nA [method resize] metódussal együtt egy adott méretű, kezdőértékekkel feltöltött tömb létrehozására használható.\n[codeblocks]\n[gdscript]\nvar array = []\narray.resize(5)\narray.fill(2)\nprint(array) # Prints [2, 2, 2, 2, 2]\n[/gdscript]\n[csharp]\nGodot.Collections.Array array = [];\narray.Resize(5);\narray.Fill(2);\nGD.Print(array); // Prints [2, 2, 2, 2, 2]\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] Ha a [param value] hivatkozással átadott [Variant] (például [Object] leszármazottja, [Array] vagy [Dictionary]), a tömb minden eleme ugyanarra a [param value] értékre fog hivatkozni. Az érték nem másolódik."

#. Array.front
#: doc/classes/Array.xml
msgid "Returns the first element of the array. If the array is empty, fails and returns [code]null[/code]. See also [method back].\n[b]Note:[/b] Unlike with the [code][][/code] operator ([code]array[0][/code]), an error is generated without stopping project execution."
msgstr "Visszaadja a tömb első elemét. Üres tömbnél a művelet sikertelen, az eredmény [code]null[/code]. Lásd még: [method back].\n[b]Megjegyzés:[/b] A [code][][/code] operátortól ([code]array[0][/code]) eltérően úgy jelez hibát, hogy a projekt futása nem áll le."

#. Array.get
#: doc/classes/Array.xml
msgid "Returns the element at the given [param index] in the array. If [param index] is out-of-bounds or negative, this method fails and returns [code]null[/code].\nThis method is similar (but not identical) to the [code][][/code] operator. Most notably, when this method fails, it doesn't pause project execution if run from the editor."
msgstr "Visszaadja a tömb [param index] indexén lévő elemet. Ha a [param index] negatív vagy kívül esik a megengedett tartományon, a metódus sikertelen, és [code]null[/code] értéket ad vissza.\nEz a metódus a [code][][/code] operátorhoz hasonlóan működik. A fő különbség, hogy ennél a metódusnál a hiba a szerkesztőből futtatva sem szünetelteti a projektet."

#. Array.get_typed_builtin
#: doc/classes/Array.xml
msgid "Returns the built-in [Variant] type of the typed array as a [enum Variant.Type] constant. If the array is not typed, returns [constant TYPE_NIL]. See also [method is_typed]."
msgstr "Visszaadja a típusos tömb beépített [Variant] típusát a [enum Variant.Type] egyik állandójaként. Típus nélküli tömb esetén az eredmény [constant TYPE_NIL]. Lásd még: [method is_typed]."

#. Array.get_typed_class_name
#: doc/classes/Array.xml
msgid "Returns the [b]built-in[/b] class name of the typed array, if the built-in [Variant] type [constant TYPE_OBJECT]. Otherwise, returns an empty [StringName]. See also [method is_typed] and [method Object.get_class]."
msgstr "Ha a tömb beépített [Variant] típusa [constant TYPE_OBJECT], visszaadja a típusos tömb [b]beépített[/b] osztálynevét. Egyébként üres [StringName] értéket ad vissza. Lásd még: [method is_typed] és [method Object.get_class]."

#. Array.get_typed_script
#: doc/classes/Array.xml
msgid "Returns the [Script] instance associated with this typed array, or [code]null[/code] if it does not exist. See also [method is_typed]."
msgstr "Visszaadja a típusos tömbhöz tartozó [Script] példányt. Ha nincs ilyen példány, az eredmény [code]null[/code]. Lásd még: [method is_typed]."

#. Array.has
#: doc/classes/Array.xml
msgid "Returns [code]true[/code] if the array contains the given [param value].\n[codeblocks]\n[gdscript]\nprint([\"inside\", 7].has(\"inside\"))  # Prints true\nprint([\"inside\", 7].has(\"outside\")) # Prints false\nprint([\"inside\", 7].has(7))         # Prints true\nprint([\"inside\", 7].has(\"7\"))       # Prints false\n[/gdscript]\n[csharp]\nGodot.Collections.Array arr = [\"inside\", 7];\n// By C# convention, this method is renamed to `Contains`.\nGD.Print(arr.Contains(\"inside\"));  // Prints True\nGD.Print(arr.Contains(\"outside\")); // Prints False\nGD.Print(arr.Contains(7));         // Prints True\nGD.Print(arr.Contains(\"7\"));       // Prints False\n[/csharp]\n[/codeblocks]\nIn GDScript, this is equivalent to the [code]in[/code] operator:\n[codeblock]\nif 4 in [2, 4, 6, 8]:\n\tprint(\"4 is here!\") # Will be printed.\n[/codeblock]\n[b]Note:[/b] For performance reasons, the search is affected by the [param value]'s [enum Variant.Type]. For example, [code]7[/code] ([int]) and [code]7.0[/code] ([float]) are not considered equal for this method."
msgstr "[code]true[/code] értéket ad vissza, ha a tömb tartalmazza a megadott [param value] értéket.\n[codeblocks]\n[gdscript]\nprint([\"inside\", 7].has(\"inside\"))  # Prints true\nprint([\"inside\", 7].has(\"outside\")) # Prints false\nprint([\"inside\", 7].has(7))         # Prints true\nprint([\"inside\", 7].has(\"7\"))       # Prints false\n[/gdscript]\n[csharp]\nGodot.Collections.Array arr = [\"inside\", 7];\n// By C# convention, this method is renamed to `Contains`.\nGD.Print(arr.Contains(\"inside\"));  // Prints True\nGD.Print(arr.Contains(\"outside\")); // Prints False\nGD.Print(arr.Contains(7));         // Prints True\nGD.Print(arr.Contains(\"7\"));       // Prints False\n[/csharp]\n[/codeblocks]\nGDScriptben ez egyenértékű a [code]in[/code] operátor használatával.\n[codeblock]\nif 4 in [2, 4, 6, 8]:\n\tprint(\"4 is here!\") # Will be printed.\n[/codeblock]\n[b]Megjegyzés:[/b] Teljesítménybeli okokból a keresés figyelembe veszi a [param value] érték [enum Variant.Type] típusát. Ez a metódus például a [code]7[/code] ([int]) és a [code]7.0[/code] ([float]) értéket különbözőnek tekinti."

#. Array.hash
#: doc/classes/Array.xml
msgid "Returns a hashed 32-bit integer value representing the array and its contents.\n[b]Note:[/b] Arrays with equal hash values are [i]not[/i] guaranteed to be the same, as a result of hash collisions. On the contrary, arrays with different hash values are guaranteed to be different."
msgstr "A tömböt és tartalmát képviselő 32 bites egész kivonatértéket ad vissza.\n[b]Megjegyzés:[/b] Kivonatütközés miatt az azonos kivonatú tömbök [i]nem[/i] feltétlenül egyeznek. A különböző kivonatú tömbök viszont biztosan eltérnek."

#. Array.is_empty
#: doc/classes/Array.xml
msgid "Returns [code]true[/code] if the array is empty ([code][][/code]). See also [method size]."
msgstr "[code]true[/code] értéket ad vissza, ha a tömb üres ([code][][/code]). Lásd még: [method size]."

#. Array.is_read_only
#: doc/classes/Array.xml
msgid "Returns [code]true[/code] if the array is read-only. See [method make_read_only].\nIn GDScript, arrays are automatically read-only if declared with the [code]const[/code] keyword."
msgstr "[code]true[/code] értéket ad vissza, ha a tömb csak olvasható. Lásd: [method make_read_only].\nGDScriptben a [code]const[/code] kulcsszóval deklarált tömbök automatikusan csak olvashatók."

#. Array.is_same_typed
#: doc/classes/Array.xml
msgid "Returns [code]true[/code] if this array is typed the same as the given [param array]. See also [method is_typed]."
msgstr "[code]true[/code] értéket ad vissza, ha a tömb típusa megegyezik a megadott [param array] tömb típusával. Lásd még: [method is_typed]."

#. Array.is_typed
#: doc/classes/Array.xml
msgid "Returns [code]true[/code] if the array is typed. Typed arrays can only contain elements of a specific type, as defined by the typed array constructor. The methods of a typed array are still expected to return a generic [Variant].\nIn GDScript, it is possible to define a typed array with static typing:\n[codeblock]\nvar numbers: Array[float] = [0.2, 4.2, -2.0]\nprint(numbers.is_typed()) # Prints true\n[/codeblock]"
msgstr "[code]true[/code] értéket ad vissza, ha a tömb típusos. Egy típusos tömb csak olyan elemeket tartalmazhat, amelyek megfelelnek a konstruktorban megadott típusnak. A tömb metódusainak visszatérési típusa ettől függetlenül általános [Variant].\nGDScriptben statikus típusmegadással is létrehozható típusos tömb.\n[codeblock]\nvar numbers: Array[float] = [0.2, 4.2, -2.0]\nprint(numbers.is_typed()) # Prints true\n[/codeblock]"

#. Array.make_read_only
#: doc/classes/Array.xml
msgid "Makes the array read-only. The array's elements cannot be overridden with different values, and their order cannot change. Does not apply to nested elements, such as dictionaries.\nIn GDScript, arrays are automatically read-only if declared with the [code]const[/code] keyword."
msgstr "A tömböt csak olvashatóvá teszi. A tömb elemei nem írhatók felül és a sorrendjük sem módosítható. Ez a korlátozás a beágyazott elemek, például a szótárak tartalmára nem vonatkozik.\nGDScriptben a [code]const[/code] kulcsszóval deklarált tömbök automatikusan csak olvashatók."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedByteArray]."
msgstr "A megadott [PackedByteArray] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedColorArray]."
msgstr "A megadott [PackedColorArray] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedFloat32Array]."
msgstr "A megadott [PackedFloat32Array] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedFloat64Array]."
msgstr "A megadott [PackedFloat64Array] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedInt32Array]."
msgstr "A megadott [PackedInt32Array] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedInt64Array]."
msgstr "A megadott [PackedInt64Array] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedStringArray]."
msgstr "A megadott [PackedStringArray] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedVector2Array]."
msgstr "A megadott [PackedVector2Array] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedVector3Array]."
msgstr "A megadott [PackedVector3Array] tömbből hoz létre tömböt."

#. Array.Array
#: doc/classes/Array.xml
msgid "Constructs an array from a [PackedVector4Array]."
msgstr "A megadott [PackedVector4Array] tömbből hoz létre tömböt."

#. Array.description
#: doc/classes/Array.xml
msgid "An array data structure that can contain a sequence of elements of any [Variant] type by default. Values can optionally be constrained to a specific type by creating a [i]typed array[/i]. Elements are accessed by a numerical index starting at [code]0[/code]. Negative indices are used to count from the back ([code]-1[/code] is the last element, [code]-2[/code] is the second to last, etc.).\n[codeblocks]\n[gdscript]\nvar array = [\"First\", 2, 3, \"Last\"]\nprint(array[0])  # Prints \"First\"\nprint(array[2])  # Prints 3\nprint(array[-1]) # Prints \"Last\"\n\narray[1] = \"Second\"\nprint(array[1])  # Prints \"Second\"\nprint(array[-3]) # Prints \"Second\"\n\n# This typed array can only contain integers.\n# Attempting to add any other type will result in an error.\nvar typed_array: Array[int] = [1, 2, 3]\n[/gdscript]\n[csharp]\nGodot.Collections.Array array = [\"First\", 2, 3, \"Last\"];\nGD.Print(array[0]); // Prints \"First\"\nGD.Print(array[2]); // Prints 3\nGD.Print(array[^1]); // Prints \"Last\"\n\narray[1] = \"Second\";\nGD.Print(array[1]); // Prints \"Second\"\nGD.Print(array[^3]); // Prints \"Second\"\n\n// This typed array can only contain integers.\n// Attempting to add any other type will result in an error.\nGodot.Collections.Array<int> typedArray = [1, 2, 3];\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] Arrays are always passed by [b]reference[/b]. To get a copy of an array that can be modified independently of the original array, use [method duplicate].\n[b]Note:[/b] Erasing elements while iterating over arrays is [b]not[/b] supported and will result in unpredictable behavior.\n[b]Note:[/b] In a boolean context, an array will evaluate to [code]false[/code] if it's empty ([code][][/code]). Otherwise, an array will always evaluate to [code]true[/code].\n[b]Differences between packed arrays, typed arrays, and untyped arrays:[/b] Packed arrays are generally faster to iterate on and modify compared to a typed array of the same type (e.g. [PackedInt64Array] versus [code]Array[int][/code]). Also, packed arrays consume less memory. As a downside, packed arrays are less flexible as they don't offer as many convenience methods such as [method Array.map]. Typed arrays are in turn faster to iterate on and modify than untyped arrays."
msgstr "A tömb olyan adatszerkezet, amely alapértelmezés szerint tetszőleges [Variant] típusú elemek sorozatát tárolhatja. Ha az értékeket egy adott típusra szeretnéd korlátozni, hozz létre [i]típusos tömböt[/i]. Az elemeket [code]0[/code]-tól kezdődő számozott indexszel érheted el. A negatív indexek a tömb végétől számítanak: [code]-1[/code] az utolsó elem, [code]-2[/code] az utolsó előtti, és így tovább.\n[codeblocks]\n[gdscript]\nvar array = [\"First\", 2, 3, \"Last\"]\nprint(array[0])  # Prints \"First\"\nprint(array[2])  # Prints 3\nprint(array[-1]) # Prints \"Last\"\n\narray[1] = \"Second\"\nprint(array[1])  # Prints \"Second\"\nprint(array[-3]) # Prints \"Second\"\n\n# This typed array can only contain integers.\n# Attempting to add any other type will result in an error.\nvar typed_array: Array[int] = [1, 2, 3]\n[/gdscript]\n[csharp]\nGodot.Collections.Array array = [\"First\", 2, 3, \"Last\"];\nGD.Print(array[0]); // Prints \"First\"\nGD.Print(array[2]); // Prints 3\nGD.Print(array[^1]); // Prints \"Last\"\n\narray[1] = \"Second\";\nGD.Print(array[1]); // Prints \"Second\"\nGD.Print(array[^3]); // Prints \"Second\"\n\n// This typed array can only contain integers.\n// Attempting to add any other type will result in an error.\nGodot.Collections.Array<int> typedArray = [1, 2, 3];\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] A tömbök átadása mindig [b]hivatkozással[/b] történik. Ha az eredetitől függetlenül módosítható másolatra van szükséged, használd a [method duplicate] metódust.\n[b]Megjegyzés:[/b] A tömb bejárása közbeni elemtörlés [b]nem[/b] támogatott, és kiszámíthatatlan működést okoz.\n[b]Megjegyzés:[/b] Logikai értékként az üres tömb ([code][][/code]) értéke [code]false[/code], minden más tömbé [code]true[/code].\n[b]A tömör, a típusos és a típus nélküli tömbök közötti különbségek:[/b] A tömör tömbök bejárása és módosítása általában gyorsabb, mint az azonos elemtípusú típusos tömböké (például [PackedInt64Array] és [code]Array[int][/code] esetén). A tömör tömbök kevesebb memóriát is használnak, de kevesebb kényelmi metódus érhető el hozzájuk. Ilyen például a [method Array.map], amely a tömör tömböknél hiányzik. A típusos tömbök bejárása és módosítása gyorsabb a típus nélküli tömbökénél."

#. Array.Array
#: doc/classes/Array.xml
msgid "Creates a typed array from the [param base] array. A typed array can only contain elements of the given type, or that inherit from the given class, as described by this constructor's parameters:\n- [param type] is the built-in [Variant] type, as one the [enum Variant.Type] constants.\n- [param class_name] is the built-in class name (see [method Object.get_class]).\n- [param script] is the associated script. It must be a [Script] instance or [code]null[/code].\nIf [param type] is not [constant TYPE_OBJECT], [param class_name] must be an empty [StringName] and [param script] must be [code]null[/code].\n[codeblock]\nclass_name Sword\nextends Node\n\nclass Stats:\n\tpass\n\nfunc _ready():\n\tvar a = Array([], TYPE_INT, \"\", null)               # Array[int]\n\tvar b = Array([], TYPE_OBJECT, \"Node\", null)        # Array[Node]\n\tvar c = Array([], TYPE_OBJECT, \"Node\", Sword)       # Array[Sword]\n\tvar d = Array([], TYPE_OBJECT, \"RefCounted\", Stats) # Array[Stats]\n[/codeblock]\nThe [param base] array's elements are converted when necessary. If this is not possible or [param base] is already typed, this constructor fails and returns an empty [Array].\nIn GDScript, this constructor is usually not necessary, as it is possible to create a typed array through static typing:\n[codeblock]\nvar numbers: Array[float] = []\nvar children: Array[Node] = [$Node, $Sprite2D, $RigidBody3D]\n\nvar integers: Array[int] = [0.2, 4.5, -2.0]\nprint(integers) # Prints [0, 4, -2]\n[/codeblock]"
msgstr "Típusos tömböt hoz létre a [param base] tömbből. A típusos tömb csak a megadott típusú vagy a megadott osztályból származó elemeket tartalmazhat. Ezt a konstruktor következő paraméterei határozzák meg:\n- A [param type] a beépített [Variant] típus a [enum Variant.Type] egyik állandójaként.\n- A [param class_name] a beépített osztály neve (lásd: [method Object.get_class]).\n- A [param script] a társított szkript. Egy [Script] példányt vagy [code]null[/code] értéket kell megadni.\nHa a [param type] értéke eltér a [constant TYPE_OBJECT] értéktől, a [param class_name] értékének üres [StringName] értéknek, a [param script] értékének pedig [code]null[/code] értéknek kell lennie.\n[codeblock]\nclass_name Sword\nextends Node\n\nclass Stats:\n\tpass\n\nfunc _ready():\n\tvar a = Array([], TYPE_INT, \"\", null)               # Array[int]\n\tvar b = Array([], TYPE_OBJECT, \"Node\", null)        # Array[Node]\n\tvar c = Array([], TYPE_OBJECT, \"Node\", Sword)       # Array[Sword]\n\tvar d = Array([], TYPE_OBJECT, \"RefCounted\", Stats) # Array[Stats]\n[/codeblock]\nA konstruktor szükség esetén átalakítja a [param base] tömb elemeit. Ha az átalakítás nem lehetséges, vagy a [param base] már típusos, a konstruktor sikertelen, és üres [Array] tömböt ad vissza.\nGDScriptben általában nincs szükség erre a konstruktorra, mert statikus típusmegadással is létrehozható típusos tömb.\n[codeblock]\nvar numbers: Array[float] = []\nvar children: Array[Node] = [$Node, $Sprite2D, $RigidBody3D]\n\nvar integers: Array[int] = [0.2, 4.5, -2.0]\nprint(integers) # Prints [0, 4, -2]\n[/codeblock]"

#. Array.all
#: doc/classes/Array.xml
msgid "Calls the given [Callable] on each element in the array and returns [code]true[/code] if the [Callable] returns [code]true[/code] for [i]all[/i] elements in the array. If the [Callable] returns [code]false[/code] for one array element or more, this method returns [code]false[/code].\nThe [param method] should take one [Variant] parameter (the current array element) and return a [bool].\n[codeblocks]\n[gdscript]\nfunc greater_than_5(number):\n\treturn number > 5\n\nfunc _ready():\n\tprint([6, 10, 6].all(greater_than_5)) # Prints true (3/3 elements evaluate to true).\n\tprint([4, 10, 4].all(greater_than_5)) # Prints false (1/3 elements evaluate to true).\n\tprint([4, 4, 4].all(greater_than_5))  # Prints false (0/3 elements evaluate to true).\n\tprint([].all(greater_than_5))         # Prints true (0/0 elements evaluate to true).\n\n\t# Same as the first line above, but using a lambda function.\n\tprint([6, 10, 6].all(func(element): return element > 5)) # Prints true\n[/gdscript]\n[csharp]\nprivate static bool GreaterThan5(int number)\n{\n\treturn number > 5;\n}\n\npublic override void _Ready()\n{\n\t// Prints True (3/3 elements evaluate to true).\n\tGD.Print(new Godot.Collections.Array<int> { 6, 10, 6 }.All(GreaterThan5));\n\t// Prints False (1/3 elements evaluate to true).\n\tGD.Print(new Godot.Collections.Array<int> { 4, 10, 4 }.All(GreaterThan5));\n\t// Prints False (0/3 elements evaluate to true).\n\tGD.Print(new Godot.Collections.Array<int> { 4, 4, 4 }.All(GreaterThan5));\n\t// Prints True (0/0 elements evaluate to true).\n\tGD.Print(new Godot.Collections.Array<int> { }.All(GreaterThan5));\n\n\t// Same as the first line above, but using a lambda function.\n\tGD.Print(new Godot.Collections.Array<int> { 6, 10, 6 }.All(element => element > 5)); // Prints True\n}\n[/csharp]\n[/codeblocks]\nSee also [method any], [method filter], [method map] and [method reduce].\n[b]Note:[/b] Unlike relying on the size of an array returned by [method filter], this method will return as early as possible to improve performance (especially with large arrays).\n[b]Note:[/b] For an empty array, this method [url=https://en.wikipedia.org/wiki/Vacuous_truth]always[/url] returns [code]true[/code]."
msgstr "A megadott [Callable] függvényt sorban meghívja a tömb elemeire. [code]true[/code] értéket ad vissza, ha a [Callable] [i]minden[/i] elemnél [code]true[/code] értéket ad. Ha a [Callable] legalább egy elemnél [code]false[/code] értéket ad, az eredmény [code]false[/code].\nA [param method] egy [Variant] paramétert kap (a tömb aktuális elemét), és [bool] értéket ad vissza.\n[codeblocks]\n[gdscript]\nfunc greater_than_5(number):\n\treturn number > 5\n\nfunc _ready():\n\tprint([6, 10, 6].all(greater_than_5)) # Prints true (3/3 elements evaluate to true).\n\tprint([4, 10, 4].all(greater_than_5)) # Prints false (1/3 elements evaluate to true).\n\tprint([4, 4, 4].all(greater_than_5))  # Prints false (0/3 elements evaluate to true).\n\tprint([].all(greater_than_5))         # Prints true (0/0 elements evaluate to true).\n\n\t# Same as the first line above, but using a lambda function.\n\tprint([6, 10, 6].all(func(element): return element > 5)) # Prints true\n[/gdscript]\n[csharp]\nprivate static bool GreaterThan5(int number)\n{\n\treturn number > 5;\n}\n\npublic override void _Ready()\n{\n\t// Prints True (3/3 elements evaluate to true).\n\tGD.Print(new Godot.Collections.Array<int> { 6, 10, 6 }.All(GreaterThan5));\n\t// Prints False (1/3 elements evaluate to true).\n\tGD.Print(new Godot.Collections.Array<int> { 4, 10, 4 }.All(GreaterThan5));\n\t// Prints False (0/3 elements evaluate to true).\n\tGD.Print(new Godot.Collections.Array<int> { 4, 4, 4 }.All(GreaterThan5));\n\t// Prints True (0/0 elements evaluate to true).\n\tGD.Print(new Godot.Collections.Array<int> { }.All(GreaterThan5));\n\n\t// Same as the first line above, but using a lambda function.\n\tGD.Print(new Godot.Collections.Array<int> { 6, 10, 6 }.All(element => element > 5)); // Prints True\n}\n[/csharp]\n[/codeblocks]\nLásd még: [method any], [method filter], [method map] és [method reduce].\n[b]Megjegyzés:[/b] A [method filter] által visszaadott tömb méretének vizsgálatánál gyorsabb lehet, mert amint eldönthető az eredmény, befejezi a bejárást. Ez nagy tömböknél különösen számít.\n[b]Megjegyzés:[/b] Üres tömb esetén a metódus [url=https://en.wikipedia.org/wiki/Vacuous_truth]mindig[/url] [code]true[/code] értéket ad vissza."

#. Array.any
#: doc/classes/Array.xml
msgid "Calls the given [Callable] on each element in the array and returns [code]true[/code] if the [Callable] returns [code]true[/code] for [i]one or more[/i] elements in the array. If the [Callable] returns [code]false[/code] for all elements in the array, this method returns [code]false[/code].\nThe [param method] should take one [Variant] parameter (the current array element) and return a [bool].\n[codeblock]\nfunc greater_than_5(number):\n\treturn number > 5\n\nfunc _ready():\n\tprint([6, 10, 6].any(greater_than_5)) # Prints true (3 elements evaluate to true).\n\tprint([4, 10, 4].any(greater_than_5)) # Prints true (1 elements evaluate to true).\n\tprint([4, 4, 4].any(greater_than_5))  # Prints false (0 elements evaluate to true).\n\tprint([].any(greater_than_5))         # Prints false (0 elements evaluate to true).\n\n\t# Same as the first line above, but using a lambda function.\n\tprint([6, 10, 6].any(func(number): return number > 5)) # Prints true\n[/codeblock]\nSee also [method all], [method filter], [method map] and [method reduce].\n[b]Note:[/b] Unlike relying on the size of an array returned by [method filter], this method will return as early as possible to improve performance (especially with large arrays).\n[b]Note:[/b] For an empty array, this method always returns [code]false[/code]."
msgstr "A megadott [Callable] függvényt meghívja a tömb elemeire. [code]true[/code] értéket ad vissza, ha a [Callable] [i]legalább egy[/i] elemnél [code]true[/code] értéket ad. Ha a [Callable] minden elemnél [code]false[/code] értéket ad, az eredmény [code]false[/code].\nA [param method] egy [Variant] paramétert kap (a tömb aktuális elemét), és [bool] értéket ad vissza.\n[codeblock]\nfunc greater_than_5(number):\n\treturn number > 5\n\nfunc _ready():\n\tprint([6, 10, 6].any(greater_than_5)) # Prints true (3 elements evaluate to true).\n\tprint([4, 10, 4].any(greater_than_5)) # Prints true (1 elements evaluate to true).\n\tprint([4, 4, 4].any(greater_than_5))  # Prints false (0 elements evaluate to true).\n\tprint([].any(greater_than_5))         # Prints false (0 elements evaluate to true).\n\n\t# Same as the first line above, but using a lambda function.\n\tprint([6, 10, 6].any(func(number): return number > 5)) # Prints true\n[/codeblock]\nLásd még: [method all], [method filter], [method map] és [method reduce].\n[b]Megjegyzés:[/b] A [method filter] által visszaadott tömb méretének vizsgálatánál gyorsabb lehet, mert amint eldönthető az eredmény, befejezi a bejárást. Ez nagy tömböknél különösen számít.\n[b]Megjegyzés:[/b] Üres tömb esetén a metódus mindig [code]false[/code] értéket ad vissza."

#. Array.bsearch
#: doc/classes/Array.xml
msgid "Returns the index of [param value] in the sorted array. If it cannot be found, returns where [param value] should be inserted to keep the array sorted. The algorithm used is [url=https://en.wikipedia.org/wiki/Binary_search_algorithm]binary search[/url].\nIf [param before] is [code]true[/code] (as by default), the returned index comes before all existing elements equal to [param value] in the array.\n[codeblock]\nvar numbers = [2, 4, 8, 10]\nvar idx = numbers.bsearch(7)\n\nnumbers.insert(idx, 7)\nprint(numbers) # Prints [2, 4, 7, 8, 10]\n\nvar fruits = [\"Apple\", \"Lemon\", \"Lemon\", \"Orange\"]\nprint(fruits.bsearch(\"Lemon\", true))  # Prints 1, points at the first \"Lemon\".\nprint(fruits.bsearch(\"Lemon\", false)) # Prints 3, points at \"Orange\".\n[/codeblock]\n[b]Note:[/b] Calling [method bsearch] on an [i]unsorted[/i] array will result in unexpected behavior. Use [method sort] before calling this method."
msgstr "Visszaadja a [param value] érték indexét a rendezett tömbben. Ha az érték nincs a tömbben, a [param value] azon beszúrási indexét adja meg, ahol a tömb rendezett marad. Az algoritmus [url=https://en.wikipedia.org/wiki/Binary_search_algorithm]bináris keresést[/url] használ.\nHa a [param before] értéke [code]true[/code] (ez az alapértelmezés), az eredmény a [param value] értékkel egyező összes elem előtti index.\n[codeblock]\nvar numbers = [2, 4, 8, 10]\nvar idx = numbers.bsearch(7)\n\nnumbers.insert(idx, 7)\nprint(numbers) # Prints [2, 4, 7, 8, 10]\n\nvar fruits = [\"Apple\", \"Lemon\", \"Lemon\", \"Orange\"]\nprint(fruits.bsearch(\"Lemon\", true))  # Prints 1, points at the first \"Lemon\".\nprint(fruits.bsearch(\"Lemon\", false)) # Prints 3, points at \"Orange\".\n[/codeblock]\n[b]Megjegyzés:[/b] A [method bsearch] [i]rendezetlen[/i] tömbön váratlan eredményt ad. Előbb rendezd a tömböt a [method sort] metódussal."

#. Array.duplicate
#: doc/classes/Array.xml
msgid "Returns a new copy of the array.\nBy default, a [b]shallow[/b] copy is returned: all nested [Array], [Dictionary], and [Resource] elements are shared with the original array. Modifying any of those in one array will also affect them in the other.\nIf [param deep] is [code]true[/code], a [b]deep[/b] copy is returned: all nested arrays and dictionaries are also duplicated (recursively). Any [Resource] is still shared with the original array, though."
msgstr "Visszaadja a tömb új másolatát.\nAlapértelmezés szerint [b]sekély[/b] másolat készül. A másolat és az eredeti ugyanazokat a beágyazott [Array], [Dictionary] és [Resource] elemeket használja. Ha az egyik tömbből módosítasz egy ilyen elemet, a változás a másikban is látszik.\nHa a [param deep] értéke [code]true[/code], [b]mély[/b] másolat készül. A beágyazott tömbökről és szótárakról is rekurzívan másolat készül. A [Resource] elemek továbbra is közösek az eredetivel."

#. Array.erase
#: doc/classes/Array.xml
msgid "Finds and removes the first occurrence of [param value] from the array. If [param value] does not exist in the array, nothing happens. To remove an element by index, use [method remove_at] instead.\n[b]Note:[/b] This method shifts every element's index after the removed [param value] back, which may have a noticeable performance cost, especially on larger arrays.\n[b]Note:[/b] Erasing elements while iterating over arrays is [b]not[/b] supported and will result in unpredictable behavior."
msgstr "Megkeresi és eltávolítja a [param value] első előfordulását. Ha a [param value] nincs a tömbben, nem történik változás. Index szerinti eltávolításhoz használd a [method remove_at] metódust.\n[b]Megjegyzés:[/b] A törölt [param value] után álló elemek indexe eggyel csökken. Ez különösen nagy tömböknél járhat érezhető teljesítményköltséggel.\n[b]Megjegyzés:[/b] A tömb bejárása közbeni elemtörlés [b]nem[/b] támogatott, és kiszámíthatatlan működést okoz."

#. Array.filter
#: doc/classes/Array.xml
msgid "Calls the given [Callable] on each element in the array and returns a new, filtered [Array].\nThe [param method] receives one of the array elements as an argument, and should return [code]true[/code] to add the element to the filtered array, or [code]false[/code] to exclude it.\n[codeblock]\nfunc is_even(number):\n\treturn number % 2 == 0\n\nfunc _ready():\n\tprint([1, 4, 5, 8].filter(is_even)) # Prints [4, 8]\n\n\t# Same as above, but using a lambda function.\n\tprint([1, 4, 5, 8].filter(func(number): return number % 2 == 0))\n[/codeblock]\nSee also [method any], [method all], [method map] and [method reduce]."
msgstr "A megadott [Callable] függvényt a tömb minden elemére meghívja, és új, szűrt [Array] tömböt ad vissza.\nA [param method] argumentumként kapja a tömb egy elemét. Ha az elemnek be kell kerülnie a szűrt tömbbe, a függvény [code]true[/code] értéket adjon vissza, egyébként [code]false[/code] értéket.\n[codeblock]\nfunc is_even(number):\n\treturn number % 2 == 0\n\nfunc _ready():\n\tprint([1, 4, 5, 8].filter(is_even)) # Prints [4, 8]\n\n\t# Same as above, but using a lambda function.\n\tprint([1, 4, 5, 8].filter(func(number): return number % 2 == 0))\n[/codeblock]\nLásd még: [method any], [method all], [method map] és [method reduce]."

#. Array.find
#: doc/classes/Array.xml
msgid "Returns the index of the [b]first[/b] occurrence of [param what] in this array, or [code]-1[/code] if there are none. The search's start can be specified with [param from], continuing to the end of the array.\n[b]Note:[/b] If you just want to know whether the array contains [param what], use [method has] ([code]Contains[/code] in C#). In GDScript, you may also use the [code]in[/code] operator.\n[b]Note:[/b] For performance reasons, the search is affected by [param what]'s [enum Variant.Type]. For example, [code]7[/code] ([int]) and [code]7.0[/code] ([float]) are not considered equal for this method."
msgstr "Visszaadja a [param what] érték [b]első[/b] előfordulásának indexét a tömbben. Ha nincs ilyen elem, [code]-1[/code] az eredmény. A keresés a megadható [param from] indextől a tömb végéig tart.\n[b]Megjegyzés:[/b] Ha csak azt szeretnéd tudni, hogy a tömb tartalmazza-e a [param what] értéket, használd a [method has] metódust (C#-ban [code]Contains[/code]). GDScriptben a [code]in[/code] operátor is használható.\n[b]Megjegyzés:[/b] Teljesítménybeli okokból a keresés figyelembe veszi a [param what] érték [enum Variant.Type] típusát. Ez a metódus például a [code]7[/code] ([int]) és a [code]7.0[/code] ([float]) értéket különbözőnek tekinti."

#. Array.find_custom
#: doc/classes/Array.xml
msgid "Returns the index of the [b]first[/b] element in the array that causes [param method] to return [code]true[/code], or [code]-1[/code] if there are none. The search's start can be specified with [param from], continuing to the end of the array.\n[param method] is a callable that takes an element of the array, and returns a [bool].\n[b]Note:[/b] If you just want to know whether the array contains [i]anything[/i] that satisfies [param method], use [method any].\n[codeblocks]\n[gdscript]\nfunc is_even(number):\n\treturn number % 2 == 0\n\nfunc _ready():\n\tprint([1, 3, 4, 7].find_custom(is_even.bind())) # Prints 2\n\n# Another example using `bind()` to pass an additional parameter:\nfunc is_specific_number(number, expected):\n\treturn number == expected\n\nfunc _ready():\n\tprint([1, 3, 4, 7].find_custom(is_specific_number.bind(4))) # Prints 2\n[/gdscript]\n[/codeblocks]"
msgstr "Visszaadja az [b]első[/b] olyan tömbelem indexét, amelyre a [param method] [code]true[/code] értéket ad. Ha nincs ilyen, [code]-1[/code] az eredmény. A keresés a megadható [param from] indextől a tömb végéig tart.\nA [param method] olyan függvény, amely a tömb egy elemét kapja, és [bool] értéket ad vissza.\n[b]Megjegyzés:[/b] Ha csak arra vagy kíváncsi, van-e a tömbben [i]bármilyen[/i] elem, amely megfelel a [param method] feltételének, használd a [method any] metódust.\n[codeblocks]\n[gdscript]\nfunc is_even(number):\n\treturn number % 2 == 0\n\nfunc _ready():\n\tprint([1, 3, 4, 7].find_custom(is_even.bind())) # Prints 2\n\n# Another example using `bind()` to pass an additional parameter:\nfunc is_specific_number(number, expected):\n\treturn number == expected\n\nfunc _ready():\n\tprint([1, 3, 4, 7].find_custom(is_specific_number.bind(4))) # Prints 2\n[/gdscript]\n[/codeblocks]"

#. Array.insert
#: doc/classes/Array.xml
msgid "Inserts a new element ([param value]) at a given index ([param position]) in the array. [param position] should be between [code]0[/code] and the array's [method size]. If negative, [param position] is considered relative to the end of the array.\nReturns [constant OK] on success, or one of the other [enum Error] constants if this method fails.\n[b]Note:[/b] Every element's index after [param position] needs to be shifted forward, which may have a noticeable performance cost, especially on larger arrays."
msgstr "Új elemet ([param value]) szúr be a tömb megadott indexére ([param position]). A [param position] értéke [code]0[/code] és a tömb [method size] mérete közé essen. Negatív [param position] esetén a tömb végétől számítja a helyet.\nSiker esetén [constant OK], hiba esetén az [enum Error] valamelyik másik állandója az eredmény.\n[b]Megjegyzés:[/b] A [param position] után következő elemek indexét eggyel el kell tolni. Ez különösen nagy tömböknél járhat érezhető teljesítményköltséggel."

#. Array.map
#: doc/classes/Array.xml
msgid "Calls the given [Callable] for each element in the array and returns a new array filled with values returned by the [param method].\nThe [param method] should take one [Variant] parameter (the current array element) and can return any [Variant].\n[codeblock]\nfunc double(number):\n\treturn number * 2\n\nfunc _ready():\n\tprint([1, 2, 3].map(double)) # Prints [2, 4, 6]\n\n\t# Same as above, but using a lambda function.\n\tprint([1, 2, 3].map(func(element): return element * 2))\n[/codeblock]\nSee also [method filter], [method reduce], [method any] and [method all]."
msgstr "A megadott [Callable] függvényt a tömb minden elemére meghívja, és a [param method] által visszaadott értékeket új tömbbe gyűjti.\nA [param method] egy [Variant] paramétert kap (a tömb aktuális elemét), és tetszőleges [Variant] értéket adhat vissza.\n[codeblock]\nfunc double(number):\n\treturn number * 2\n\nfunc _ready():\n\tprint([1, 2, 3].map(double)) # Prints [2, 4, 6]\n\n\t# Same as above, but using a lambda function.\n\tprint([1, 2, 3].map(func(element): return element * 2))\n[/codeblock]\nLásd még: [method filter], [method reduce], [method any] és [method all]."

#. Array.max
#: doc/classes/Array.xml
msgid "Returns the maximum value contained in the array, if all elements can be compared. Otherwise, returns [code]null[/code]. See also [method min].\nTo find the maximum value using a custom comparator, you can use [method reduce]."
msgstr "Visszaadja a tömb legnagyobb értékét, ha az összes elem összehasonlítható. Egyébként [code]null[/code] értéket ad vissza. Lásd még: [method min].\nSaját összehasonlítási szabály esetén a [method reduce] metódussal keresheted meg a legnagyobb értéket."

#. Array.min
#: doc/classes/Array.xml
msgid "Returns the minimum value contained in the array, if all elements can be compared. Otherwise, returns [code]null[/code]. See also [method max]."
msgstr "Visszaadja a tömb legkisebb értékét, ha az összes elem összehasonlítható. Egyébként [code]null[/code] értéket ad vissza. Lásd még: [method max]."

#. Array.pick_random
#: doc/classes/Array.xml
msgid "Returns a random element from the array. Generates an error and returns [code]null[/code] if the array is empty.\n[codeblocks]\n[gdscript]\n# May print 1, 2, 3.25, or \"Hi\".\nprint([1, 2, 3.25, \"Hi\"].pick_random())\n[/gdscript]\n[csharp]\nGodot.Collections.Array array = [1, 2, 3.25f, \"Hi\"];\nGD.Print(array.PickRandom()); // May print 1, 2, 3.25, or \"Hi\".\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] Like many similar functions in the engine (such as [method @GlobalScope.randi] or [method shuffle]), this method uses a common, global random seed. To get a predictable outcome from this method, see [method @GlobalScope.seed]."
msgstr "Véletlenszerű elemet ad vissza a tömbből. Üres tömb esetén hibát jelez, és [code]null[/code] értéket ad vissza.\n[codeblocks]\n[gdscript]\n# May print 1, 2, 3.25, or \"Hi\".\nprint([1, 2, 3.25, \"Hi\"].pick_random())\n[/gdscript]\n[csharp]\nGodot.Collections.Array array = [1, 2, 3.25f, \"Hi\"];\nGD.Print(array.PickRandom()); // May print 1, 2, 3.25, or \"Hi\".\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] A motor számos hasonló függvényéhez (például a [method @GlobalScope.randi] vagy a [method shuffle] metódushoz) hasonlóan a közös, globális véletlenmagot használja. A megismételhető eredményhez lásd a [method @GlobalScope.seed] metódust."

#. Array.pop_at
#: doc/classes/Array.xml
msgid "Removes and returns the element of the array at index [param position]. If negative, [param position] is considered relative to the end of the array. Returns [code]null[/code] if the array is empty. If [param position] is out of bounds, an error message is also generated.\n[b]Note:[/b] This method shifts every element's index after [param position] back, which may have a noticeable performance cost, especially on larger arrays."
msgstr "Eltávolítja és visszaadja a [param position] indexű elemet. Negatív [param position] esetén a tömb végétől számítja a helyet. Üres tömbnél [code]null[/code] az eredmény. Érvénytelen [param position] esetén hibaüzenetet is ad.\n[b]Megjegyzés:[/b] A [param position] után álló elemek indexe eggyel csökken. Ez különösen nagy tömböknél járhat érezhető teljesítményköltséggel."

#. Array.pop_back
#: doc/classes/Array.xml
msgid "Removes and returns the last element of the array. Returns [code]null[/code] if the array is empty, without generating an error. See also [method pop_front]."
msgstr "Eltávolítja és visszaadja a tömb utolsó elemét. Üres tömb esetén hiba nélkül [code]null[/code] értéket ad vissza. Lásd még: [method pop_front]."

#. Array.pop_front
#: doc/classes/Array.xml
msgid "Removes and returns the first element of the array. Returns [code]null[/code] if the array is empty, without generating an error. See also [method pop_back].\n[b]Note:[/b] This method shifts every other element's index back, which may have a noticeable performance cost, especially on larger arrays."
msgstr "Eltávolítja és visszaadja a tömb első elemét. Üres tömb esetén hiba nélkül [code]null[/code] értéket ad vissza. Lásd még: [method pop_back].\n[b]Megjegyzés:[/b] A többi elem indexe eggyel csökken. Ez különösen nagy tömböknél járhat érezhető teljesítményköltséggel."

#. Array.push_back
#: doc/classes/Array.xml
msgid "Appends an element at the end of the array. See also [method push_front]."
msgstr "Elemet fűz a tömb végéhez. Lásd még: [method push_front]."

#. Array.push_front
#: doc/classes/Array.xml
msgid "Adds an element at the beginning of the array. See also [method push_back].\n[b]Note:[/b] This method shifts every other element's index forward, which may have a noticeable performance cost, especially on larger arrays."
msgstr "Új elemet tesz a tömb elejére. Lásd még: [method push_back].\n[b]Megjegyzés:[/b] A többi elem indexe eggyel nő. Ez különösen nagy tömböknél járhat érezhető teljesítményköltséggel."

#. Array.reduce
#: doc/classes/Array.xml
msgid "Calls the given [Callable] for each element in array, accumulates the result in [param accum], then returns it.\nThe [param method] takes two arguments: the current value of [param accum] and the current array element. If [param accum] is [code]null[/code] (as by default), the iteration will start from the second element, with the first one used as initial value of [param accum].\n[codeblock]\nfunc sum(accum, number):\n\treturn accum + number\n\nfunc _ready():\n\tprint([1, 2, 3].reduce(sum, 0))  # Prints 6\n\tprint([1, 2, 3].reduce(sum, 10)) # Prints 16\n\n\t# Same as above, but using a lambda function.\n\tprint([1, 2, 3].reduce(func(accum, number): return accum + number, 10))\n[/codeblock]\nIf [method max] is not desirable, this method may also be used to implement a custom comparator:\n[codeblock]\nfunc _ready():\n\tvar arr = [Vector2i(5, 0), Vector2i(3, 4), Vector2i(1, 2)]\n\n\tvar longest_vec = arr.reduce(func(max, vec): return vec if is_length_greater(vec, max) else max)\n\tprint(longest_vec) # Prints (3, 4)\n\nfunc is_length_greater(a, b):\n\treturn a.length() > b.length()\n[/codeblock]\nThis method can also be used to count how many elements in an array satisfy a certain condition, similar to [method count]:\n[codeblock]\nfunc is_even(number):\n\treturn number % 2 == 0\n\nfunc _ready():\n\tvar arr = [1, 2, 3, 4, 5]\n\t# If the current element is even, increment count, otherwise leave count the same.\n\tvar even_count = arr.reduce(func(count, next): return count + 1 if is_even(next) else count, 0)\n\tprint(even_count) # Prints 2\n[/codeblock]\nSee also [method map], [method filter], [method any], and [method all]."
msgstr "A megadott [Callable] függvényt a tömb minden elemére meghívja, az eredményt a [param accum] értékben gyűjti, majd visszaadja.\nA [param method] két argumentumot kap: a [param accum] aktuális értékét és a tömb aktuális elemét. Ha a [param accum] értéke [code]null[/code] (ez az alapértelmezés), a bejárás a második elemtől indul, az első elem pedig a [param accum] kezdeti értéke lesz.\n[codeblock]\nfunc sum(accum, number):\n\treturn accum + number\n\nfunc _ready():\n\tprint([1, 2, 3].reduce(sum, 0))  # Prints 6\n\tprint([1, 2, 3].reduce(sum, 10)) # Prints 16\n\n\t# Same as above, but using a lambda function.\n\tprint([1, 2, 3].reduce(func(accum, number): return accum + number, 10))\n[/codeblock]\nHa a [method max] nem megfelelő, ezzel a metódussal saját összehasonlítási szabályt is megvalósíthatsz.\n[codeblock]\nfunc _ready():\n\tvar arr = [Vector2i(5, 0), Vector2i(3, 4), Vector2i(1, 2)]\n\n\tvar longest_vec = arr.reduce(func(max, vec): return vec if is_length_greater(vec, max) else max)\n\tprint(longest_vec) # Prints (3, 4)\n\nfunc is_length_greater(a, b):\n\treturn a.length() > b.length()\n[/codeblock]\nMegszámolhatod vele azt is, hány elem felel meg egy feltételnek, a [method count] metódushoz hasonlóan.\n[codeblock]\nfunc is_even(number):\n\treturn number % 2 == 0\n\nfunc _ready():\n\tvar arr = [1, 2, 3, 4, 5]\n\t# If the current element is even, increment count, otherwise leave count the same.\n\tvar even_count = arr.reduce(func(count, next): return count + 1 if is_even(next) else count, 0)\n\tprint(even_count) # Prints 2\n[/codeblock]\nLásd még: [method map], [method filter], [method any] és [method all]."

#. Array.remove_at
#: doc/classes/Array.xml
msgid "Removes the element from the array at the given index ([param position]). If the index is out of bounds, this method fails. If the index is negative, [param position] is considered relative to the end of the array.\nIf you need to return the removed element, use [method pop_at]. To remove an element by value, use [method erase] instead.\n[b]Note:[/b] This method shifts every element's index after [param position] back, which may have a noticeable performance cost, especially on larger arrays."
msgstr "Eltávolítja a megadott indexen ([param position]) lévő elemet. Tartományon kívüli index esetén a művelet sikertelen. Negatív [param position] esetén a tömb végétől számítja a helyet.\nHa az eltávolított elemre is szükséged van, használd a [method pop_at] metódust. Érték szerinti eltávolításhoz használd a [method erase] metódust.\n[b]Megjegyzés:[/b] A [param position] után álló elemek indexe eggyel csökken. Ez különösen nagy tömböknél járhat érezhető teljesítményköltséggel."

#. Array.resize
#: doc/classes/Array.xml
msgid "Sets the array's number of elements to [param size]. If [param size] is smaller than the array's current size, the elements at the end are removed. If [param size] is greater, new default elements (usually [code]null[/code]) are added, depending on the array's type.\nReturns [constant OK] on success, or one of the following [enum Error] constants if this method fails: [constant ERR_LOCKED] if the array is read-only, [constant ERR_INVALID_PARAMETER] if the size is negative, or [constant ERR_OUT_OF_MEMORY] if allocations fail. Use [method size] to find the actual size of the array after resize.\n[b]Note:[/b] Calling this method once and assigning the new values is faster than calling [method append] for every new element."
msgstr "A tömb elemszámát [param size] értékre állítja. Ha a [param size] kisebb az aktuális méretnél, eltávolítja a tömb végéről a felesleges elemeket. Ha a [param size] nagyobb, a tömb típusának megfelelő alapértelmezett értékű elemeket (általában [code]null[/code]) ad hozzá.\nSiker esetén [constant OK], hiba esetén az [enum Error] egyik állandója az eredmény: [constant ERR_LOCKED], ha a tömb csak olvasható, [constant ERR_INVALID_PARAMETER], ha a méret negatív, vagy [constant ERR_OUT_OF_MEMORY], ha sikertelen a memóriafoglalás. Az átméretezés utáni tényleges méretet a [method size] metódussal kérheted le.\n[b]Megjegyzés:[/b] Gyorsabb ezt a metódust egyszer meghívni, majd beállítani az új értékeket, mint minden új elemhez meghívni a [method append] metódust."

#. Array.reverse
#: doc/classes/Array.xml
msgid "Reverses the order of all elements in the array."
msgstr "Megfordítja a tömb összes elemének sorrendjét."

#. Array.rfind
#: doc/classes/Array.xml
msgid "Returns the index of the [b]last[/b] occurrence of [param what] in this array, or [code]-1[/code] if there are none. The search's start can be specified with [param from], continuing to the beginning of the array. This method is the reverse of [method find]."
msgstr "Visszaadja a [param what] [b]utolsó[/b] előfordulásának indexét a tömbben. Ha nem talál ilyet, [code]-1[/code] az eredmény. A keresés a megadható [param from] indextől a tömb elejéig tart. A metódus a [method find] fordított irányú változata."

#. Array.rfind_custom
#: doc/classes/Array.xml
msgid "Returns the index of the [b]last[/b] element of the array that causes [param method] to return [code]true[/code], or [code]-1[/code] if there are none. The search's start can be specified with [param from], continuing to the beginning of the array. This method is the reverse of [method find_custom]."
msgstr "Visszaadja az [b]utolsó[/b] olyan tömbelem indexét, amelyre a [param method] [code]true[/code] értéket ad. Ha nincs ilyen, [code]-1[/code] az eredmény. A keresés a megadható [param from] indextől a tömb elejéig tart. A metódus a [method find_custom] fordított irányú változata."

#. Array.set
#: doc/classes/Array.xml
msgid "Sets the value of the element at the given [param index] to the given [param value]. This will not change the size of the array, it only changes the value at an index already in the array. This is the same as using the [code][][/code] operator ([code]array[index] = value[/code])."
msgstr "A tömb [param index] indexén lévő elem értékét [param value] értékre állítja. Csak a már létező elem értéke változik, a tömb mérete marad. Ez egyenértékű a [code][][/code] operátor használatával ([code]array[index] = value[/code])."

#. Array.shuffle
#: doc/classes/Array.xml
msgid "Shuffles all elements of the array in a random order.\n[b]Note:[/b] Like many similar functions in the engine (such as [method @GlobalScope.randi] or [method pick_random]), this method uses a common, global random seed. To get a predictable outcome from this method, see [method @GlobalScope.seed]."
msgstr "Véletlenszerű sorrendbe keveri a tömb minden elemét.\n[b]Megjegyzés:[/b] A motor számos hasonló függvényéhez (például a [method @GlobalScope.randi] vagy a [method pick_random] metódushoz) hasonlóan a közös, globális véletlenmagot használja. A megismételhető eredményhez lásd a [method @GlobalScope.seed] metódust."

#. Array.size
#: doc/classes/Array.xml
msgid "Returns the number of elements in the array. Empty arrays ([code][][/code]) always return [code]0[/code]. See also [method is_empty]."
msgstr "Visszaadja a tömb elemeinek számát. Üres tömbnél ([code][][/code]) az eredmény mindig [code]0[/code]. Lásd még: [method is_empty]."

#. Array.slice
#: doc/classes/Array.xml
msgid "Returns a new [Array] containing this array's elements, from index [param begin] (inclusive) to [param end] (exclusive), every [param step] elements.\nIf either [param begin] or [param end] are negative, their value is relative to the end of the array.\nIf [param step] is negative, this method iterates through the array in reverse, returning a slice ordered backwards. For this to work, [param begin] must be greater than [param end].\nIf [param deep] is [code]true[/code], all nested [Array] and [Dictionary] elements in the slice are duplicated from the original, recursively. See also [method duplicate].\n[codeblock]\nvar letters = [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"]\n\nprint(letters.slice(0, 2))  # Prints [\"A\", \"B\"]\nprint(letters.slice(2, -2)) # Prints [\"C\", \"D\"]\nprint(letters.slice(-2, 6)) # Prints [\"E\", \"F\"]\n\nprint(letters.slice(0, 6, 2))  # Prints [\"A\", \"C\", \"E\"]\nprint(letters.slice(4, 1, -1)) # Prints [\"E\", \"D\", \"C\"]\n[/codeblock]"
msgstr "Új [Array] tömböt ad vissza, a tömb elemeivel a [param begin] indextől (beleértve) a [param end] indexig (kihagyva), [param step] elemenként.\nHa a [param begin] vagy a [param end] negatív, a tömb végétől számítja a helyet.\nNegatív [param step] esetén fordított irányban járja be a tömböt, így fordított sorrendű szeletet ad vissza. Ehhez a [param begin] értékének nagyobbnak kell lennie a [param end] értékénél.\nHa a [param deep] értéke [code]true[/code], a szelet beágyazott [Array] és [Dictionary] elemeiről rekurzívan másolat készül. Lásd még: [method duplicate].\n[codeblock]\nvar letters = [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"]\n\nprint(letters.slice(0, 2))  # Prints [\"A\", \"B\"]\nprint(letters.slice(2, -2)) # Prints [\"C\", \"D\"]\nprint(letters.slice(-2, 6)) # Prints [\"E\", \"F\"]\n\nprint(letters.slice(0, 6, 2))  # Prints [\"A\", \"C\", \"E\"]\nprint(letters.slice(4, 1, -1)) # Prints [\"E\", \"D\", \"C\"]\n[/codeblock]"

#. Array.sort
#: doc/classes/Array.xml
msgid "Sorts the array in ascending order. The final order is dependent on the \"less than\" ([code]<[/code]) comparison between elements.\n[codeblocks]\n[gdscript]\nvar numbers = [10, 5, 2.5, 8]\nnumbers.sort()\nprint(numbers) # Prints [2.5, 5, 8, 10]\n[/gdscript]\n[csharp]\nGodot.Collections.Array numbers = [10, 5, 2.5, 8];\nnumbers.Sort();\nGD.Print(numbers); // Prints [2.5, 5, 8, 10]\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] The sorting algorithm used is not [url=https://en.wikipedia.org/wiki/Sorting_algorithm#Stability]stable[/url]. This means that equivalent elements (such as [code]2[/code] and [code]2.0[/code]) may have their order changed when calling [method sort]."
msgstr "A tömböt növekvő sorrendbe rendezi. A sorrendet az elemek közötti „kisebb mint” ([code]<[/code]) összehasonlítás határozza meg.\n[codeblocks]\n[gdscript]\nvar numbers = [10, 5, 2.5, 8]\nnumbers.sort()\nprint(numbers) # Prints [2.5, 5, 8, 10]\n[/gdscript]\n[csharp]\nGodot.Collections.Array numbers = [10, 5, 2.5, 8];\nnumbers.Sort();\nGD.Print(numbers); // Prints [2.5, 5, 8, 10]\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] Az alkalmazott rendezési algoritmus nem [url=https://en.wikipedia.org/wiki/Sorting_algorithm#Stability]stabil[/url]. Ez azt jelenti, hogy az egyenértékű elemek (például [code]2[/code] és [code]2.0[/code]) egymáshoz viszonyított sorrendje változhat a [method sort] hívásakor."

#. Array.sort_custom
#: doc/classes/Array.xml
msgid "Sorts the array using a custom [Callable].\n[param func] is called as many times as necessary, receiving two array elements as arguments. The function should return [code]true[/code] if the first element should be moved [i]before[/i] the second one, otherwise it should return [code]false[/code].\n[codeblock]\nfunc sort_ascending(a, b):\n\tif a[1] < b[1]:\n\t\treturn true\n\treturn false\n\nfunc _ready():\n\tvar my_items = [[\"Tomato\", 5], [\"Apple\", 9], [\"Rice\", 4]]\n\tmy_items.sort_custom(sort_ascending)\n\tprint(my_items) # Prints [[\"Rice\", 4], [\"Tomato\", 5], [\"Apple\", 9]]\n\n\t# Sort descending, using a lambda function.\n\tmy_items.sort_custom(func(a, b): return a[1] > b[1])\n\tprint(my_items) # Prints [[\"Apple\", 9], [\"Tomato\", 5], [\"Rice\", 4]]\n[/codeblock]\nIt may also be necessary to use this method to sort strings by natural order, with [method String.naturalnocasecmp_to], as in the following example:\n[codeblock]\nvar files = [\"newfile1\", \"newfile2\", \"newfile10\", \"newfile11\"]\nfiles.sort_custom(func(a, b): return a.naturalnocasecmp_to(b) < 0)\nprint(files) # Prints [\"newfile1\", \"newfile2\", \"newfile10\", \"newfile11\"]\n[/codeblock]\n[b]Note:[/b] In C#, this method is not supported.\n[b]Note:[/b] The sorting algorithm used is not [url=https://en.wikipedia.org/wiki/Sorting_algorithm#Stability]stable[/url]. This means that values considered equal may have their order changed when calling this method.\n[b]Note:[/b] You should not randomize the return value of [param func], as the heapsort algorithm expects a consistent result. Randomizing the return value will result in unexpected behavior."
msgstr "A tömböt egyéni [Callable] függvénnyel rendezi.\nA [param func] annyiszor hívódik meg, ahányszor szükséges. Argumentumként a tömb két elemét kapja. Ha az első elemnek a második [i]elé[/i] kell kerülnie, a függvény [code]true[/code] értéket adjon vissza, egyébként [code]false[/code] értéket.\n[codeblock]\nfunc sort_ascending(a, b):\n\tif a[1] < b[1]:\n\t\treturn true\n\treturn false\n\nfunc _ready():\n\tvar my_items = [[\"Tomato\", 5], [\"Apple\", 9], [\"Rice\", 4]]\n\tmy_items.sort_custom(sort_ascending)\n\tprint(my_items) # Prints [[\"Rice\", 4], [\"Tomato\", 5], [\"Apple\", 9]]\n\n\t# Sort descending, using a lambda function.\n\tmy_items.sort_custom(func(a, b): return a[1] > b[1])\n\tprint(my_items) # Prints [[\"Apple\", 9], [\"Tomato\", 5], [\"Rice\", 4]]\n[/codeblock]\nA sztringek természetes sorrendbe rendezéséhez is szükség lehet erre a metódusra, a [method String.naturalnocasecmp_to] használatával, ahogy a következő példa mutatja.\n[codeblock]\nvar files = [\"newfile1\", \"newfile2\", \"newfile10\", \"newfile11\"]\nfiles.sort_custom(func(a, b): return a.naturalnocasecmp_to(b) < 0)\nprint(files) # Prints [\"newfile1\", \"newfile2\", \"newfile10\", \"newfile11\"]\n[/codeblock]\n[b]Megjegyzés:[/b] C#-ban ez a metódus nem támogatott.\n[b]Megjegyzés:[/b] Az alkalmazott rendezési algoritmus nem [url=https://en.wikipedia.org/wiki/Sorting_algorithm#Stability]stabil[/url]. Az egyenlőnek tekintett értékek egymáshoz viszonyított sorrendje megváltozhat a metódus hívásakor.\n[b]Megjegyzés:[/b] A [param func] visszatérési értéke ne legyen véletlenszerű. A kupacrendezés következetes eredményt igényel, a véletlenszerű visszatérési érték kiszámíthatatlan működést okoz."

#. Array.operator !=
#: doc/classes/Array.xml
msgid "Returns [code]true[/code] if the array's size or its elements are different than [param right]'s."
msgstr "[code]true[/code] értéket ad vissza, ha a tömb mérete vagy elemei eltérnek a [param right] tömbétől."

#. Array.operator +
#: doc/classes/Array.xml
msgid "Appends the [param right] array to the left operand, creating a new [Array]. This is also known as an array concatenation.\n[codeblocks]\n[gdscript]\nvar array1 = [\"One\", 2]\nvar array2 = [3, \"Four\"]\nprint(array1 + array2) # Prints [\"One\", 2, 3, \"Four\"]\n[/gdscript]\n[csharp]\n// Note that concatenation is not possible with C#'s native Array type.\nGodot.Collections.Array array1 = [\"One\", 2];\nGodot.Collections.Array array2 = [3, \"Four\"];\nGD.Print(array1 + array2); // Prints [\"One\", 2, 3, \"Four\"]\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] For existing arrays, [method append_array] is much more efficient than concatenation and assignment with the [code]+=[/code] operator."
msgstr "A bal oldali tömb végéhez fűzi a [param right] tömböt, és új [Array] tömböt hoz létre. Ezt a műveletet a tömbök összefűzésének is nevezik.\n[codeblocks]\n[gdscript]\nvar array1 = [\"One\", 2]\nvar array2 = [3, \"Four\"]\nprint(array1 + array2) # Prints [\"One\", 2, 3, \"Four\"]\n[/gdscript]\n[csharp]\n// Note that concatenation is not possible with C#'s native Array type.\nGodot.Collections.Array array1 = [\"One\", 2];\nGodot.Collections.Array array2 = [3, \"Four\"];\nGD.Print(array1 + array2); // Prints [\"One\", 2, 3, \"Four\"]\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] A meglévő tömbök esetén a [method append_array] jóval hatékonyabb, mint a [code]+=[/code] operátorral végzett összefűzés és értékadás."

#. Array.operator ==
#: doc/classes/Array.xml
msgid "Compares the left operand [Array] against the [param right] [Array]. Returns [code]true[/code] if the sizes and contents of the arrays are equal, [code]false[/code] otherwise."
msgstr "Összehasonlítja a bal oldali [Array] tömböt a [param right] [Array] tömbbel. Ha a két tömb mérete és tartalma egyezik, [code]true[/code] értéket ad vissza, egyébként [code]false[/code] értéket."

#. Array.operator []
#: doc/classes/Array.xml
msgid "Returns the [Variant] element at the specified [param index]. Arrays start at index 0. If [param index] is greater or equal to [code]0[/code], the element is fetched starting from the beginning of the array. If [param index] is a negative value, the element is fetched starting from the end. Accessing an array out-of-bounds will cause a run-time error, pausing the project execution if run from the editor."
msgstr "Visszaadja a megadott [param index] indexű [Variant] elemet. A tömbök indexelése 0-tól indul. Ha a [param index] legalább [code]0[/code], a tömb elejétől, negatív [param index] esetén a végétől számítja a helyet. A tartományon kívüli index futásidejű hibát okoz, amely a szerkesztőből futtatott projektet szünetelteti."

#. Dictionary.brief
#: doc/classes/Dictionary.xml
msgid "A built-in data structure that holds key-value pairs."
msgstr "Kulcs–érték párokat tároló beépített adatszerkezet."

#. Dictionary.description
#: doc/classes/Dictionary.xml
msgid "Dictionaries are associative containers that contain values referenced by unique keys. Dictionaries will preserve the insertion order when adding new entries. In other programming languages, this data structure is often referred to as a hash map or an associative array.\nYou can define a dictionary by placing a comma-separated list of [code]key: value[/code] pairs inside curly braces [code]{}[/code].\nCreating a dictionary:\n[codeblocks]\n[gdscript]\nvar my_dict = {} # Creates an empty dictionary.\n\nvar dict_variable_key = \"Another key name\"\nvar dict_variable_value = \"value2\"\nvar another_dict = {\n\t\"Some key name\": \"value1\",\n\tdict_variable_key: dict_variable_value,\n}\n\nvar points_dict = { \"White\": 50, \"Yellow\": 75, \"Orange\": 100 }\n\n# Alternative Lua-style syntax.\n# Doesn't require quotes around keys, but only string constants can be used as key names.\n# Additionally, key names must start with a letter or an underscore.\n# Here, `some_key` is a string literal, not a variable!\nanother_dict = {\n\tsome_key = 42,\n}\n[/gdscript]\n[csharp]\nvar myDict = new Godot.Collections.Dictionary(); // Creates an empty dictionary.\nvar pointsDict = new Godot.Collections.Dictionary\n{\n\t{ \"White\", 50 },\n\t{ \"Yellow\", 75 },\n\t{ \"Orange\", 100 },\n};\n[/csharp]\n[/codeblocks]\nYou can access a dictionary's value by referencing its corresponding key. In the above example, [code]points_dict[\"White\"][/code] will return [code]50[/code]. You can also write [code]points_dict.White[/code], which is equivalent. However, you'll have to use the bracket syntax if the key you're accessing the dictionary with isn't a fixed string (such as a number or variable).\n[codeblocks]\n[gdscript]\n@export_enum(\"White\", \"Yellow\", \"Orange\") var my_color: String\nvar points_dict = { \"White\": 50, \"Yellow\": 75, \"Orange\": 100 }\nfunc _ready():\n\t# We can't use dot syntax here as `my_color` is a variable.\n\tvar points = points_dict[my_color]\n[/gdscript]\n[csharp]\n[Export(PropertyHint.Enum, \"White,Yellow,Orange\")]\npublic string MyColor { get; set; }\nprivate Godot.Collections.Dictionary _pointsDict = new Godot.Collections.Dictionary\n{\n\t{ \"White\", 50 },\n\t{ \"Yellow\", 75 },\n\t{ \"Orange\", 100 },\n};\n\npublic override void _Ready()\n{\n\tint points = (int)_pointsDict[MyColor];\n}\n[/csharp]\n[/codeblocks]\nIn the above code, [code]points[/code] will be assigned the value that is paired with the appropriate color selected in [code]my_color[/code].\nDictionaries can contain more complex data:\n[codeblocks]\n[gdscript]\nvar my_dict = {\n\t\"First Array\": [1, 2, 3, 4] # Assigns an Array to a String key.\n}\n[/gdscript]\n[csharp]\nvar myDict = new Godot.Collections.Dictionary\n{\n\t{ \"First Array\", new Godot.Collections.Array { 1, 2, 3, 4 } }\n};\n[/csharp]\n[/codeblocks]\nTo add a key to an existing dictionary, access it like an existing key and assign to it:\n[codeblocks]\n[gdscript]\nvar points_dict = { \"White\": 50, \"Yellow\": 75, \"Orange\": 100 }\npoints_dict[\"Blue\"] = 150 # Add \"Blue\" as a key and assign 150 as its value.\n[/gdscript]\n[csharp]\nvar pointsDict = new Godot.Collections.Dictionary\n{\n\t{ \"White\", 50 },\n\t{ \"Yellow\", 75 },\n\t{ \"Orange\", 100 },\n};\npointsDict[\"Blue\"] = 150; // Add \"Blue\" as a key and assign 150 as its value.\n[/csharp]\n[/codeblocks]\nFinally, untyped dictionaries can contain different types of keys and values in the same dictionary:\n[codeblocks]\n[gdscript]\n# This is a valid dictionary.\n# To access the string \"Nested value\" below, use `my_dict.sub_dict.sub_key` or `my_dict[\"sub_dict\"][\"sub_key\"]`.\n# Indexing styles can be mixed and matched depending on your needs.\nvar my_dict = {\n\t\"String Key\": 5,\n\t4: [1, 2, 3],\n\t7: \"Hello\",\n\t\"sub_dict\": { \"sub_key\": \"Nested value\" },\n}\n[/gdscript]\n[csharp]\n// This is a valid dictionary.\n// To access the string \"Nested value\" below, use `((Godot.Collections.Dictionary)myDict[\"sub_dict\"])[\"sub_key\"]`.\nvar myDict = new Godot.Collections.Dictionary {\n\t{ \"String Key\", 5 },\n\t{ 4, new Godot.Collections.Array { 1, 2, 3 } },\n\t{ 7, \"Hello\" },\n\t{ \"sub_dict\", new Godot.Collections.Dictionary { { \"sub_key\", \"Nested value\" } } },\n};\n[/csharp]\n[/codeblocks]\nThe keys of a dictionary can be iterated with the [code]for[/code] keyword:\n[codeblocks]\n[gdscript]\nvar groceries = { \"Orange\": 20, \"Apple\": 2, \"Banana\": 4 }\nfor fruit in groceries:\n\tvar amount = groceries[fruit]\n[/gdscript]\n[csharp]\nvar groceries = new Godot.Collections.Dictionary { { \"Orange\", 20 }, { \"Apple\", 2 }, { \"Banana\", 4 } };\nforeach (var (fruit, amount) in groceries)\n{\n\t// `fruit` is the key, `amount` is the value.\n}\n[/csharp]\n[/codeblocks]\nTo enforce a certain type for keys and values, you can create a [i]typed dictionary[/i]. Typed dictionaries can only contain keys and values of the given types, or that inherit from the given classes:\n[codeblocks]\n[gdscript]\n# Creates a typed dictionary with String keys and int values.\n# Attempting to use any other type for keys or values will result in an error.\nvar typed_dict: Dictionary[String, int] = {\n\t\"some_key\": 1,\n\t\"some_other_key\": 2,\n}\n\n# Creates a typed dictionary with String keys and values of any type.\n# Attempting to use any other type for keys will result in an error.\nvar typed_dict_key_only: Dictionary[String, Variant] = {\n\t\"some_key\": 12.34,\n\t\"some_other_key\": \"string\",\n}\n[/gdscript]\n[csharp]\n// Creates a typed dictionary with String keys and int values.\n// Attempting to use any other type for keys or values will result in an error.\nvar typedDict = new Godot.Collections.Dictionary<String, int> {\n\t{\"some_key\", 1},\n\t{\"some_other_key\", 2},\n};\n\n// Creates a typed dictionary with String keys and values of any type.\n// Attempting to use any other type for keys will result in an error.\nvar typedDictKeyOnly = new Godot.Collections.Dictionary<String, Variant> {\n\t{\"some_key\", 12.34},\n\t{\"some_other_key\", \"string\"},\n};\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] Dictionaries are always passed by reference. To get a copy of a dictionary which can be modified independently of the original dictionary, use [method duplicate].\n[b]Note:[/b] Erasing elements while iterating over dictionaries is [b]not[/b] supported and will result in unpredictable behavior.\n[b]Note:[/b] In a boolean context, a dictionary will evaluate to [code]false[/code] if it's empty ([code]{}[/code]). Otherwise, a dictionary will always evaluate to [code]true[/code]."
msgstr "A szótár asszociatív tároló. Az értékeket egyedi kulcsokkal lehet elérni. Új bejegyzés hozzáadásakor a szótár megőrzi a beszúrás sorrendjét. Más programozási nyelvekben ezt az adatszerkezetet gyakran hasítótáblának vagy asszociatív tömbnek nevezik.\nSzótárat úgy adhatsz meg, hogy kapcsos zárójelek ([code]{}[/code]) közé vesszővel elválasztott [code]key: value[/code] párokat írsz.\nPélda szótár létrehozására:\n[codeblocks]\n[gdscript]\nvar my_dict = {} # Creates an empty dictionary.\n\nvar dict_variable_key = \"Another key name\"\nvar dict_variable_value = \"value2\"\nvar another_dict = {\n\t\"Some key name\": \"value1\",\n\tdict_variable_key: dict_variable_value,\n}\n\nvar points_dict = { \"White\": 50, \"Yellow\": 75, \"Orange\": 100 }\n\n# Alternative Lua-style syntax.\n# Doesn't require quotes around keys, but only string constants can be used as key names.\n# Additionally, key names must start with a letter or an underscore.\n# Here, `some_key` is a string literal, not a variable!\nanother_dict = {\n\tsome_key = 42,\n}\n[/gdscript]\n[csharp]\nvar myDict = new Godot.Collections.Dictionary(); // Creates an empty dictionary.\nvar pointsDict = new Godot.Collections.Dictionary\n{\n\t{ \"White\", 50 },\n\t{ \"Yellow\", 75 },\n\t{ \"Orange\", 100 },\n};\n[/csharp]\n[/codeblocks]\nEgy értéket a hozzá tartozó kulccsal érhetsz el. A fenti példában a [code]points_dict[\"White\"][/code] értéke [code]50[/code]. A [code]points_dict.White[/code] rövid alak ugyanazt jelenti. Ha a kulcs nem rögzített sztring, hanem például szám vagy változó, a szögletes zárójeles alakot kell használnod.\n[codeblocks]\n[gdscript]\n@export_enum(\"White\", \"Yellow\", \"Orange\") var my_color: String\nvar points_dict = { \"White\": 50, \"Yellow\": 75, \"Orange\": 100 }\nfunc _ready():\n\t# We can't use dot syntax here as `my_color` is a variable.\n\tvar points = points_dict[my_color]\n[/gdscript]\n[csharp]\n[Export(PropertyHint.Enum, \"White,Yellow,Orange\")]\npublic string MyColor { get; set; }\nprivate Godot.Collections.Dictionary _pointsDict = new Godot.Collections.Dictionary\n{\n\t{ \"White\", 50 },\n\t{ \"Yellow\", 75 },\n\t{ \"Orange\", 100 },\n};\n\npublic override void _Ready()\n{\n\tint points = (int)_pointsDict[MyColor];\n}\n[/csharp]\n[/codeblocks]\nA fenti példában a [code]points[/code] azt az értéket kapja, amely a [code]my_color[/code] változóban kiválasztott színhez tartozik.\nA szótárak összetettebb adatokat is tartalmazhatnak.\n[codeblocks]\n[gdscript]\nvar my_dict = {\n\t\"First Array\": [1, 2, 3, 4] # Assigns an Array to a String key.\n}\n[/gdscript]\n[csharp]\nvar myDict = new Godot.Collections.Dictionary\n{\n\t{ \"First Array\", new Godot.Collections.Array { 1, 2, 3, 4 } }\n};\n[/csharp]\n[/codeblocks]\nÚj kulcs hozzáadásához hivatkozz rá ugyanúgy, mint egy meglévő kulcsra, és adj neki értéket.\n[codeblocks]\n[gdscript]\nvar points_dict = { \"White\": 50, \"Yellow\": 75, \"Orange\": 100 }\npoints_dict[\"Blue\"] = 150 # Add \"Blue\" as a key and assign 150 as its value.\n[/gdscript]\n[csharp]\nvar pointsDict = new Godot.Collections.Dictionary\n{\n\t{ \"White\", 50 },\n\t{ \"Yellow\", 75 },\n\t{ \"Orange\", 100 },\n};\npointsDict[\"Blue\"] = 150; // Add \"Blue\" as a key and assign 150 as its value.\n[/csharp]\n[/codeblocks]\nTípus nélküli szótárban a kulcsok és az értékek többféle típusúak lehetnek.\n[codeblocks]\n[gdscript]\n# This is a valid dictionary.\n# To access the string \"Nested value\" below, use `my_dict.sub_dict.sub_key` or `my_dict[\"sub_dict\"][\"sub_key\"]`.\n# Indexing styles can be mixed and matched depending on your needs.\nvar my_dict = {\n\t\"String Key\": 5,\n\t4: [1, 2, 3],\n\t7: \"Hello\",\n\t\"sub_dict\": { \"sub_key\": \"Nested value\" },\n}\n[/gdscript]\n[csharp]\n// This is a valid dictionary.\n// To access the string \"Nested value\" below, use `((Godot.Collections.Dictionary)myDict[\"sub_dict\"])[\"sub_key\"]`.\nvar myDict = new Godot.Collections.Dictionary {\n\t{ \"String Key\", 5 },\n\t{ 4, new Godot.Collections.Array { 1, 2, 3 } },\n\t{ 7, \"Hello\" },\n\t{ \"sub_dict\", new Godot.Collections.Dictionary { { \"sub_key\", \"Nested value\" } } },\n};\n[/csharp]\n[/codeblocks]\nA szótár kulcsait a [code]for[/code] kulcsszóval járhatod be.\n[codeblocks]\n[gdscript]\nvar groceries = { \"Orange\": 20, \"Apple\": 2, \"Banana\": 4 }\nfor fruit in groceries:\n\tvar amount = groceries[fruit]\n[/gdscript]\n[csharp]\nvar groceries = new Godot.Collections.Dictionary { { \"Orange\", 20 }, { \"Apple\", 2 }, { \"Banana\", 4 } };\nforeach (var (fruit, amount) in groceries)\n{\n\t// `fruit` is the key, `amount` is the value.\n}\n[/csharp]\n[/codeblocks]\nHa a kulcsokat és az értékeket egy adott típusra szeretnéd korlátozni, hozz létre [i]típusos szótárt[/i]. A kulcsok és az értékek típusának meg kell egyeznie a megadott típusokkal, vagy a megadott osztályokból kell származnia.\n[codeblocks]\n[gdscript]\n# Creates a typed dictionary with String keys and int values.\n# Attempting to use any other type for keys or values will result in an error.\nvar typed_dict: Dictionary[String, int] = {\n\t\"some_key\": 1,\n\t\"some_other_key\": 2,\n}\n\n# Creates a typed dictionary with String keys and values of any type.\n# Attempting to use any other type for keys will result in an error.\nvar typed_dict_key_only: Dictionary[String, Variant] = {\n\t\"some_key\": 12.34,\n\t\"some_other_key\": \"string\",\n}\n[/gdscript]\n[csharp]\n// Creates a typed dictionary with String keys and int values.\n// Attempting to use any other type for keys or values will result in an error.\nvar typedDict = new Godot.Collections.Dictionary<String, int> {\n\t{\"some_key\", 1},\n\t{\"some_other_key\", 2},\n};\n\n// Creates a typed dictionary with String keys and values of any type.\n// Attempting to use any other type for keys will result in an error.\nvar typedDictKeyOnly = new Godot.Collections.Dictionary<String, Variant> {\n\t{\"some_key\", 12.34},\n\t{\"some_other_key\", \"string\"},\n};\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] A szótárak átadása mindig hivatkozással történik. Ha az eredetitől függetlenül módosítható másolatra van szükséged, használd a [method duplicate] metódust.\n[b]Megjegyzés:[/b] A szótár bejárása közbeni törlés [b]nem[/b] támogatott, és kiszámíthatatlan működést okoz.\n[b]Megjegyzés:[/b] Logikai értékként az üres szótár ([code]{}[/code]) értéke [code]false[/code], minden más szótáré [code]true[/code]."

#. Dictionary.Dictionary
#: doc/classes/Dictionary.xml
msgid "Constructs an empty [Dictionary]."
msgstr "Üres [Dictionary] szótárt hoz létre."

#. Dictionary.Dictionary
#: doc/classes/Dictionary.xml
msgid "Creates a typed dictionary from the [param base] dictionary. A typed dictionary can only contain keys and values of the given types, or that inherit from the given classes, as described by this constructor's parameters."
msgstr "Típusos szótárt hoz létre a [param base] szótárból. Csak a konstruktor paramétereiben megadott típusú vagy az ott megadott osztályokból származó kulcsokat és értékeket tárolhat."

#. Dictionary.Dictionary
#: doc/classes/Dictionary.xml
msgid "Returns the same dictionary as [param from]. If you need a copy of the dictionary, use [method duplicate]."
msgstr "Ugyanazt a szótárt adja vissza, mint a [param from] paraméterben átadott szótár. Másolathoz használd a [method duplicate] metódust."

#. Dictionary.assign
#: doc/classes/Dictionary.xml
msgid "Assigns elements of another [param dictionary] into the dictionary. Resizes the dictionary to match [param dictionary]. Performs type conversions if the dictionary is typed."
msgstr "Átveszi a másik [param dictionary] szótár bejegyzéseit. A méretet a [param dictionary] méretéhez igazítja. Típusos szótárnál szükség szerint átalakítja a típusokat."

#. Dictionary.clear
#: doc/classes/Dictionary.xml
msgid "Clears the dictionary, removing all entries from it."
msgstr "Kiüríti a szótárt, minden bejegyzést eltávolít belőle."

#. Dictionary.duplicate
#: doc/classes/Dictionary.xml
msgid "Returns a new copy of the dictionary.\nBy default, a [b]shallow[/b] copy is returned: all nested [Array], [Dictionary], and [Resource] keys and values are shared with the original dictionary. Modifying any of those in one dictionary will also affect them in the other.\nIf [param deep] is [code]true[/code], a [b]deep[/b] copy is returned: all nested arrays and dictionaries are also duplicated (recursively). Any [Resource] is still shared with the original dictionary, though."
msgstr "Visszaadja a szótár új másolatát.\nAlapértelmezés szerint [b]sekély[/b] másolat készül. A másolat és az eredeti ugyanazokat a beágyazott [Array], [Dictionary] és [Resource] kulcsokat és értékeket használja. Ha az egyik szótárból módosítasz egy ilyen elemet, a változás a másikban is látszik.\nHa a [param deep] értéke [code]true[/code], [b]mély[/b] másolat készül. A beágyazott tömbökről és szótárakról is rekurzívan másolat készül. A [Resource] elemek továbbra is közösek az eredetivel."

#. Dictionary.duplicate_deep
#: doc/classes/Dictionary.xml
msgid "Duplicates this dictionary, deeply, like [method duplicate] when passing [code]true[/code], with extra control over how subresources are handled.\n[param deep_subresources_mode] must be one of the values from [enum Resource.DeepDuplicateMode]. By default, only internal resources will be duplicated (recursively)."
msgstr "A [method duplicate] metódus [code]true[/code] paraméterű hívásához hasonlóan mély másolatot készít a szótárról, de külön szabályozható, hogyan kezelje a beágyazott erőforrásokat.\nA [param deep_subresources_mode] értékét a [enum Resource.DeepDuplicateMode] értékei közül kell kiválasztani. Alapértelmezés szerint csak a belső erőforrásokat másolja rekurzívan."

#. Dictionary.erase
#: doc/classes/Dictionary.xml
msgid "Removes the dictionary entry by key, if it exists. Returns [code]true[/code] if the given [param key] existed in the dictionary, otherwise [code]false[/code].\n[b]Note:[/b] Do not erase entries while iterating over the dictionary. You can iterate over the [method keys] array instead."
msgstr "Kulcs alapján eltávolítja a létező szótárbejegyzést. Ha a megadott [param key] szerepelt a szótárban, [code]true[/code] az eredmény, egyébként [code]false[/code].\n[b]Megjegyzés:[/b] Bejárás közben ne törölj bejegyzéseket a szótárból. Ehelyett a [method keys] által visszaadott tömböt járhatod be."

#. Dictionary.find_key
#: doc/classes/Dictionary.xml
msgid "Finds and returns the first key whose associated value is equal to [param value], or [code]null[/code] if it is not found.\n[b]Note:[/b] [code]null[/code] is also a valid key. If inside the dictionary, [method find_key] may give misleading results."
msgstr "Megkeresi és visszaadja az első kulcsot, amelynek értéke megegyezik a [param value] értékkel. Ha nincs ilyen, az eredmény [code]null[/code].\n[b]Megjegyzés:[/b] A [code]null[/code] is lehet kulcs. Ha van ilyen kulcs a szótárban, a [method find_key] eredménye félreérthető lehet."

#. Dictionary.get
#: doc/classes/Dictionary.xml
msgid "Returns the corresponding value for the given [param key] in the dictionary. If the [param key] does not exist, returns [param default], or [code]null[/code] if the parameter is omitted.\n[b]Note:[/b] If the [param default] argument is computationally expensive or has unwanted side effects, consider using the [method has] method instead:\n[codeblock]\n# Always calls `expensive_function()`.\ndict.get(\"key\", expensive_function())\n# Calls `expensive_function()` only if the key does not exist.\ndict.get(\"key\") if dict.has(\"key\") else expensive_function()\n[/codeblock]"
msgstr "Visszaadja a szótár megadott [param key] kulcsához tartozó értéket. Ha a [param key] nincs a szótárban, a [param default] értéket adja vissza, illetve [code]null[/code] értéket, ha ezt a paramétert elhagytad.\n[b]Megjegyzés:[/b] Ha a [param default] argumentum kiszámítása erőforrás-igényes vagy nem kívánt mellékhatással jár, használhatod a [method has] metódust.\n[codeblock]\n# Always calls `expensive_function()`.\ndict.get(\"key\", expensive_function())\n# Calls `expensive_function()` only if the key does not exist.\ndict.get(\"key\") if dict.has(\"key\") else expensive_function()\n[/codeblock]"

#. Dictionary.get_or_add
#: doc/classes/Dictionary.xml
msgid "Gets a value and ensures the key is set. If the [param key] exists in the dictionary, this behaves like [method get]. Otherwise, the [param default] value is inserted into the dictionary and returned."
msgstr "Lekéri az értéket, és gondoskodik arról, hogy a kulcs létezzen. Ha a [param key] már szerepel a szótárban, úgy működik, mint a [method get]. Egyébként beszúrja a [param default] értéket a szótárba, majd visszaadja."

#. Dictionary.has
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary contains an entry with the given [param key].\n[codeblocks]\n[gdscript]\nvar my_dict = {\n\t\"Godot\" : 4,\n\t210 : null,\n}\n\nprint(my_dict.has(\"Godot\")) # Prints true\nprint(my_dict.has(210))     # Prints true\nprint(my_dict.has(4))       # Prints false\n[/gdscript]\n[csharp]\nvar myDict = new Godot.Collections.Dictionary\n{\n\t{ \"Godot\", 4 },\n\t{ 210, default },\n};\n\nGD.Print(myDict.ContainsKey(\"Godot\")); // Prints True\nGD.Print(myDict.ContainsKey(210));     // Prints True\nGD.Print(myDict.ContainsKey(4));       // Prints False\n[/csharp]\n[/codeblocks]\nIn GDScript, this is equivalent to the [code]in[/code] operator:\n[codeblock]\nif \"Godot\" in { \"Godot\": 4 }:\n\tprint(\"The key is here!\") # Will be printed.\n[/codeblock]\n[b]Note:[/b] This method returns [code]true[/code] as long as the [param key] exists, even if its corresponding value is [code]null[/code]."
msgstr "[code]true[/code] értéket ad vissza, ha a szótárban létezik bejegyzés a megadott [param key] kulccsal.\n[codeblocks]\n[gdscript]\nvar my_dict = {\n\t\"Godot\" : 4,\n\t210 : null,\n}\n\nprint(my_dict.has(\"Godot\")) # Prints true\nprint(my_dict.has(210))     # Prints true\nprint(my_dict.has(4))       # Prints false\n[/gdscript]\n[csharp]\nvar myDict = new Godot.Collections.Dictionary\n{\n\t{ \"Godot\", 4 },\n\t{ 210, default },\n};\n\nGD.Print(myDict.ContainsKey(\"Godot\")); // Prints True\nGD.Print(myDict.ContainsKey(210));     // Prints True\nGD.Print(myDict.ContainsKey(4));       // Prints False\n[/csharp]\n[/codeblocks]\nGDScriptben ez egyenértékű a [code]in[/code] operátor használatával.\n[codeblock]\nif \"Godot\" in { \"Godot\": 4 }:\n\tprint(\"The key is here!\") # Will be printed.\n[/codeblock]\n[b]Megjegyzés:[/b] Ha a [param key] szerepel a szótárban, az eredmény akkor is [code]true[/code], ha a hozzá tartozó érték [code]null[/code]."

#. Dictionary.has_all
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary contains all keys in the given [param keys] array.\n[codeblock]\nvar data = { \"width\": 10, \"height\": 20 }\ndata.has_all([\"height\", \"width\"]) # Returns true\n[/codeblock]"
msgstr "[code]true[/code] értéket ad vissza, ha a szótár tartalmazza a megadott [param keys] tömb összes kulcsát.\n[codeblock]\nvar data = { \"width\": 10, \"height\": 20 }\ndata.has_all([\"height\", \"width\"]) # Returns true\n[/codeblock]"

#. Dictionary.hash
#: doc/classes/Dictionary.xml
msgid "Returns a hashed 32-bit integer value representing the dictionary contents.\n[codeblocks]\n[gdscript]\nvar dict1 = { \"A\": 10, \"B\": 2 }\nvar dict2 = { \"A\": 10, \"B\": 2 }\n\nprint(dict1.hash() == dict2.hash()) # Prints true\n[/gdscript]\n[csharp]\nvar dict1 = new Godot.Collections.Dictionary { { \"A\", 10 }, { \"B\", 2 } };\nvar dict2 = new Godot.Collections.Dictionary { { \"A\", 10 }, { \"B\", 2 } };\n\n// Godot.Collections.Dictionary has no Hash() method. Use GD.Hash() instead.\nGD.Print(GD.Hash(dict1) == GD.Hash(dict2)); // Prints True\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] Dictionaries with the same entries but in a different order will not have the same hash.\n[b]Note:[/b] Dictionaries with equal hash values are [i]not[/i] guaranteed to be the same, because of hash collisions. On the contrary, dictionaries with different hash values are guaranteed to be different."
msgstr "A szótár tartalmát képviselő 32 bites egész kivonatértéket ad vissza.\n[codeblocks]\n[gdscript]\nvar dict1 = { \"A\": 10, \"B\": 2 }\nvar dict2 = { \"A\": 10, \"B\": 2 }\n\nprint(dict1.hash() == dict2.hash()) # Prints true\n[/gdscript]\n[csharp]\nvar dict1 = new Godot.Collections.Dictionary { { \"A\", 10 }, { \"B\", 2 } };\nvar dict2 = new Godot.Collections.Dictionary { { \"A\", 10 }, { \"B\", 2 } };\n\n// Godot.Collections.Dictionary has no Hash() method. Use GD.Hash() instead.\nGD.Print(GD.Hash(dict1) == GD.Hash(dict2)); // Prints True\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] Azonos bejegyzések eltérő sorrendben különböző kivonatot eredményeznek.\n[b]Megjegyzés:[/b] Kivonatütközés miatt az azonos kivonatú szótárak [i]nem[/i] feltétlenül egyeznek. A különböző kivonatú szótárak viszont eltérnek."

#. Dictionary.is_empty
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary is empty (its size is [code]0[/code]). See also [method size]."
msgstr "[code]true[/code] értéket ad vissza, ha a szótár üres (a mérete [code]0[/code]). Lásd még: [method size]."

#. Dictionary.is_read_only
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary is read-only. See [method make_read_only]. Dictionaries are automatically read-only if declared with [code]const[/code] keyword."
msgstr "[code]true[/code] értéket ad vissza, ha a szótár csak olvasható. Lásd: [method make_read_only]. A [code]const[/code] kulcsszóval deklarált szótárak automatikusan csak olvashatók."

#. Dictionary.is_same_typed
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary is typed the same as [param dictionary]."
msgstr "[code]true[/code] értéket ad vissza, ha a szótár típusbeállításai megegyeznek a [param dictionary] típusbeállításaival."

#. Dictionary.is_same_typed_key
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary's keys are typed the same as [param dictionary]'s keys."
msgstr "[code]true[/code] értéket ad vissza, ha a szótár kulcsainak típusa megegyezik a [param dictionary] kulcsainak típusával."

#. Dictionary.is_same_typed_value
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary's values are typed the same as [param dictionary]'s values."
msgstr "[code]true[/code] értéket ad vissza, ha a szótár értékeinek típusa megegyezik a [param dictionary] értékeinek típusával."

#. Dictionary.is_typed
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary is typed. Typed dictionaries can only store keys/values of their associated type and provide type safety for the [code][][/code] operator. Methods of typed dictionary still return [Variant]."
msgstr "[code]true[/code] értéket ad vissza, ha a szótár típusos. A típusos szótárak csak a megadott típusú kulcsokat és értékeket tárolhatják. A [code][][/code] operátor típusbiztos hozzáférést biztosít. A típusos szótár metódusai továbbra is [Variant] értéket adnak vissza."

#. Dictionary.is_typed_key
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary's keys are typed."
msgstr "[code]true[/code] értéket ad vissza, ha a szótár kulcsai típusosak."

#. Dictionary.is_typed_value
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the dictionary's values are typed."
msgstr "[code]true[/code] értéket ad vissza, ha a szótár értékei típusosak."

#. Dictionary.keys
#: doc/classes/Dictionary.xml
msgid "Returns the list of keys in the dictionary."
msgstr "Visszaadja a szótár kulcsainak listáját."

#. Dictionary.make_read_only
#: doc/classes/Dictionary.xml
msgid "Makes the dictionary read-only, i.e. disables modification of the dictionary's contents. Does not apply to nested content, e.g. content of nested dictionaries."
msgstr "Csak olvashatóvá teszi a szótárt, így annak tartalma nem módosítható. A korlátozás nem terjed ki a beágyazott tartalomra, például a beágyazott szótárakra."

#. Dictionary.merge
#: doc/classes/Dictionary.xml
msgid "Adds entries from [param dictionary] to this dictionary. By default, duplicate keys are not copied over, unless [param overwrite] is [code]true[/code].\n[codeblocks]\n[gdscript]\nvar dict = { \"item\": \"sword\", \"quantity\": 2 }\nvar other_dict = { \"quantity\": 15, \"color\": \"silver\" }\n\n# Overwriting of existing keys is disabled by default.\ndict.merge(other_dict)\nprint(dict)  # { \"item\": \"sword\", \"quantity\": 2, \"color\": \"silver\" }\n\n# With overwriting of existing keys enabled.\ndict.merge(other_dict, true)\nprint(dict)  # { \"item\": \"sword\", \"quantity\": 15, \"color\": \"silver\" }\n[/gdscript]\n[csharp]\nvar dict = new Godot.Collections.Dictionary\n{\n\t[\"item\"] = \"sword\",\n\t[\"quantity\"] = 2,\n};\n\nvar otherDict = new Godot.Collections.Dictionary\n{\n\t[\"quantity\"] = 15,\n\t[\"color\"] = \"silver\",\n};\n\n// Overwriting of existing keys is disabled by default.\ndict.Merge(otherDict);\nGD.Print(dict); // { \"item\": \"sword\", \"quantity\": 2, \"color\": \"silver\" }\n\n// With overwriting of existing keys enabled.\ndict.Merge(otherDict, true);\nGD.Print(dict); // { \"item\": \"sword\", \"quantity\": 15, \"color\": \"silver\" }\n[/csharp]\n[/codeblocks]\n[b]Note:[/b] [method merge] is [i]not[/i] recursive. Nested dictionaries are considered as keys that can be overwritten or not depending on the value of [param overwrite], but they will never be merged together."
msgstr "A [param dictionary] szótár bejegyzéseit hozzáadja ehhez a szótárhoz. A már létező kulcsokhoz tartozó bejegyzéseket csak akkor írja felül, ha a [param overwrite] értéke [code]true[/code].\n[codeblocks]\n[gdscript]\nvar dict = { \"item\": \"sword\", \"quantity\": 2 }\nvar other_dict = { \"quantity\": 15, \"color\": \"silver\" }\n\n# Overwriting of existing keys is disabled by default.\ndict.merge(other_dict)\nprint(dict)  # { \"item\": \"sword\", \"quantity\": 2, \"color\": \"silver\" }\n\n# With overwriting of existing keys enabled.\ndict.merge(other_dict, true)\nprint(dict)  # { \"item\": \"sword\", \"quantity\": 15, \"color\": \"silver\" }\n[/gdscript]\n[csharp]\nvar dict = new Godot.Collections.Dictionary\n{\n\t[\"item\"] = \"sword\",\n\t[\"quantity\"] = 2,\n};\n\nvar otherDict = new Godot.Collections.Dictionary\n{\n\t[\"quantity\"] = 15,\n\t[\"color\"] = \"silver\",\n};\n\n// Overwriting of existing keys is disabled by default.\ndict.Merge(otherDict);\nGD.Print(dict); // { \"item\": \"sword\", \"quantity\": 2, \"color\": \"silver\" }\n\n// With overwriting of existing keys enabled.\ndict.Merge(otherDict, true);\nGD.Print(dict); // { \"item\": \"sword\", \"quantity\": 15, \"color\": \"silver\" }\n[/csharp]\n[/codeblocks]\n[b]Megjegyzés:[/b] A [method merge] [i]nem[/i] rekurzív. A beágyazott szótárakat a [param overwrite] értékétől függően egészben felülírhatja, de tartalmukat soha nem fésüli össze."

#. Dictionary.merged
#: doc/classes/Dictionary.xml
msgid "Returns a copy of this dictionary merged with the other [param dictionary]. By default, duplicate keys are not copied over, unless [param overwrite] is [code]true[/code]. See also [method merge].\nThis method is useful for quickly making dictionaries with default values:\n[codeblock]\nvar base = { \"fruit\": \"apple\", \"vegetable\": \"potato\" }\nvar extra = { \"fruit\": \"orange\", \"dressing\": \"vinegar\" }\n# Prints { \"fruit\": \"orange\", \"vegetable\": \"potato\", \"dressing\": \"vinegar\" }\nprint(extra.merged(base))\n# Prints { \"fruit\": \"apple\", \"vegetable\": \"potato\", \"dressing\": \"vinegar\" }\nprint(extra.merged(base, true))\n[/codeblock]"
msgstr "Visszaadja a szótárnak a másik [param dictionary] szótárral egyesített másolatát. A már létező kulcsokhoz tartozó bejegyzéseket csak akkor írja felül, ha a [param overwrite] értéke [code]true[/code]. Lásd még: [method merge].\nEzzel a metódussal gyorsan létrehozhatsz alapértelmezett értékeket tartalmazó szótárakat.\n[codeblock]\nvar base = { \"fruit\": \"apple\", \"vegetable\": \"potato\" }\nvar extra = { \"fruit\": \"orange\", \"dressing\": \"vinegar\" }\n# Prints { \"fruit\": \"orange\", \"vegetable\": \"potato\", \"dressing\": \"vinegar\" }\nprint(extra.merged(base))\n# Prints { \"fruit\": \"apple\", \"vegetable\": \"potato\", \"dressing\": \"vinegar\" }\nprint(extra.merged(base, true))\n[/codeblock]"

#. Dictionary.recursive_equal
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the two dictionaries contain the same keys and values, inner [Dictionary] and [Array] keys and values are compared recursively."
msgstr "[code]true[/code] értéket ad vissza, ha a két szótár ugyanazokat a kulcsokat és értékeket tartalmazza. A beágyazott [Dictionary] és [Array] típusú kulcsokat és értékeket rekurzívan hasonlítja össze."

#. Dictionary.set
#: doc/classes/Dictionary.xml
msgid "Sets the value of the element at the given [param key] to the given [param value]. Returns [code]true[/code] if the value is set successfully. Fails and returns [code]false[/code] if the dictionary is read-only, or if [param key] and [param value] don't match the dictionary's types. This is the same as using the [code][][/code] operator ([code]dict[key] = value[/code])."
msgstr "A megadott [param key] kulcshoz rendeli a [param value] értéket. Siker esetén [code]true[/code] értéket ad vissza. A művelet sikertelen, és az eredmény [code]false[/code], ha a szótár csak olvasható, vagy a [param key] és a [param value] típusa nem felel meg a szótár típusainak. Ez egyenértékű a [code][][/code] operátor használatával ([code]dict[key] = value[/code])."

#. Dictionary.size
#: doc/classes/Dictionary.xml
msgid "Returns the number of entries in the dictionary. Empty dictionaries ([code]{ }[/code]) always return [code]0[/code]. See also [method is_empty]."
msgstr "Visszaadja a szótár bejegyzéseinek számát. Üres szótárnál ([code]{ }[/code]) az eredmény mindig [code]0[/code]. Lásd még: [method is_empty]."

#. Dictionary.sort
#: doc/classes/Dictionary.xml
msgid "Sorts the dictionary in ascending order, by key. The final order is dependent on the \"less than\" ([code]<[/code]) comparison between keys.\n[codeblocks]\n[gdscript]\nvar numbers = { \"c\": 2, \"a\": 0, \"b\": 1 }\nnumbers.sort()\nprint(numbers) # Prints { \"a\": 0, \"b\": 1, \"c\": 2 }\n[/gdscript]\n[/codeblocks]\nThis method ensures that the dictionary's entries are ordered consistently when [method keys] or [method values] are called, or when the dictionary needs to be converted to a string through [method @GlobalScope.str] or [method JSON.stringify]."
msgstr "A szótárt kulcs szerint növekvő sorrendbe rendezi. A sorrendet a kulcsok közti „kisebb mint” ([code]<[/code]) összehasonlítás határozza meg.\n[codeblocks]\n[gdscript]\nvar numbers = { \"c\": 2, \"a\": 0, \"b\": 1 }\nnumbers.sort()\nprint(numbers) # Prints { \"a\": 0, \"b\": 1, \"c\": 2 }\n[/gdscript]\n[/codeblocks]\nÍgy a bejegyzések sorrendje következetes lesz a [method keys] vagy a [method values] hívásakor, illetve akkor, ha a szótárt a [method @GlobalScope.str] vagy a [method JSON.stringify] metódussal sztringgé alakítod."

#. Dictionary.values
#: doc/classes/Dictionary.xml
msgid "Returns the list of values in this dictionary."
msgstr "Visszaadja a szótár értékeinek listáját."

#. Dictionary.operator !=
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the two dictionaries do not contain the same keys and values."
msgstr "[code]true[/code] értéket ad vissza, ha a két szótár kulcsai vagy értékei eltérnek."

#. Dictionary.operator ==
#: doc/classes/Dictionary.xml
msgid "Returns [code]true[/code] if the two dictionaries contain the same keys and values. The order of the entries does not matter.\n[b]Note:[/b] In C#, by convention, this operator compares by [b]reference[/b]. If you need to compare by value, iterate over both dictionaries."
msgstr "[code]true[/code] értéket ad vissza, ha a két szótár ugyanazokat a kulcsokat és értékeket tartalmazza. A bejegyzések sorrendje nem számít.\n[b]Megjegyzés:[/b] C#-ban az operátor a nyelvi szokás szerint [b]hivatkozás[/b] alapján hasonlít össze. Érték szerinti összehasonlításhoz járd be mindkét szótárt."

#. Dictionary.operator []
#: doc/classes/Dictionary.xml
msgid "Returns the corresponding value for the given [param key] in the dictionary. If the entry does not exist, fails and returns [code]null[/code]. For safe access, use [method get] or [method has]."
msgstr "Visszaadja a szótár megadott [param key] kulcsához tartozó értéket. Ha nincs ilyen bejegyzés, a művelet sikertelen, és [code]null[/code] értéket ad vissza. Biztonságos hozzáféréshez használd a [method get] vagy a [method has] metódust."

#. Array.operator <
#: doc/classes/Array.xml
msgid "Compares the elements of both arrays in order, starting from index [code]0[/code] and ending on the last index in common between both arrays. For each pair of elements, returns [code]true[/code] if this array's element is less than [param right]'s, [code]false[/code] if this element is greater. Otherwise, continues to the next pair.\nIf all searched elements are equal, returns [code]true[/code] if this array's size is less than [param right]'s, otherwise returns [code]false[/code]."
msgstr "Sorrendben összehasonlítja a két tömb elemeit a [code]0[/code] indextől az utolsó közös indexig. Minden párnál [code]true[/code] értéket ad vissza, ha ennek a tömbnek az eleme kisebb a [param right] tömb eleménél, és [code]false[/code] értéket, ha nagyobb. Egyezésnél a következő párt vizsgálja.\nHa minden összehasonlított elem egyezik, [code]true[/code] értéket ad vissza, ha ennek a tömbnek a mérete kisebb a [param right] tömb méreténél. Egyébként az eredmény [code]false[/code]."

#. Array.operator <=
#: doc/classes/Array.xml
msgid "Compares the elements of both arrays in order, starting from index [code]0[/code] and ending on the last index in common between both arrays. For each pair of elements, returns [code]true[/code] if this array's element is less than [param right]'s, [code]false[/code] if this element is greater. Otherwise, continues to the next pair.\nIf all searched elements are equal, returns [code]true[/code] if this array's size is less or equal to [param right]'s, otherwise returns [code]false[/code]."
msgstr "Sorrendben összehasonlítja a két tömb elemeit a [code]0[/code] indextől az utolsó közös indexig. Minden párnál [code]true[/code] értéket ad vissza, ha ennek a tömbnek az eleme kisebb a [param right] tömb eleménél, és [code]false[/code] értéket, ha nagyobb. Egyezésnél a következő párt vizsgálja.\nHa minden összehasonlított elem egyezik, [code]true[/code] értéket ad vissza, ha ennek a tömbnek a mérete legfeljebb akkora, mint a [param right] tömb mérete. Egyébként az eredmény [code]false[/code]."

#. Array.operator >
#: doc/classes/Array.xml
msgid "Compares the elements of both arrays in order, starting from index [code]0[/code] and ending on the last index in common between both arrays. For each pair of elements, returns [code]true[/code] if this array's element is greater than [param right]'s, [code]false[/code] if this element is less. Otherwise, continues to the next pair.\nIf all searched elements are equal, returns [code]true[/code] if this array's size is greater than [param right]'s, otherwise returns [code]false[/code]."
msgstr "Sorrendben összehasonlítja a két tömb elemeit a [code]0[/code] indextől az utolsó közös indexig. Minden párnál [code]true[/code] értéket ad vissza, ha ennek a tömbnek az eleme nagyobb a [param right] tömb eleménél, és [code]false[/code] értéket, ha kisebb. Egyezésnél a következő párt vizsgálja.\nHa minden összehasonlított elem egyezik, [code]true[/code] értéket ad vissza, ha ennek a tömbnek a mérete nagyobb a [param right] tömb méreténél. Egyébként az eredmény [code]false[/code]."

#. Array.operator >=
#: doc/classes/Array.xml
msgid "Compares the elements of both arrays in order, starting from index [code]0[/code] and ending on the last index in common between both arrays. For each pair of elements, returns [code]true[/code] if this array's element is greater than [param right]'s, [code]false[/code] if this element is less. Otherwise, continues to the next pair.\nIf all searched elements are equal, returns [code]true[/code] if this array's size is greater or equal to [param right]'s, otherwise returns [code]false[/code]."
msgstr "Sorrendben összehasonlítja a két tömb elemeit a [code]0[/code] indextől az utolsó közös indexig. Minden párnál [code]true[/code] értéket ad vissza, ha ennek a tömbnek az eleme nagyobb a [param right] tömb eleménél, és [code]false[/code] értéket, ha kisebb. Egyezésnél a következő párt vizsgálja.\nHa minden összehasonlított elem egyezik, [code]true[/code] értéket ad vissza, ha ennek a tömbnek a mérete legalább akkora, mint a [param right] tömb mérete. Egyébként az eredmény [code]false[/code]."

#. Dictionary.get_typed_key_builtin
#: doc/classes/Dictionary.xml
msgid "Returns the built-in [Variant] type of the typed dictionary's keys as a [enum Variant.Type] constant. If the keys are not typed, returns [constant TYPE_NIL]. See also [method is_typed_key]."
msgstr "Visszaadja a típusos szótár kulcsainak beépített [Variant] típusát a [enum Variant.Type] egyik állandójaként. Ha a szótár kulcsai nem típusosak, az eredmény [constant TYPE_NIL]. Lásd még: [method is_typed_key]."

#. Dictionary.get_typed_key_class_name
#: doc/classes/Dictionary.xml
msgid "Returns the [b]built-in[/b] class name of the typed dictionary's keys, if the built-in [Variant] type is [constant TYPE_OBJECT]. Otherwise, returns an empty [StringName]. See also [method is_typed_key] and [method Object.get_class]."
msgstr "Ha a szótár kulcsainak beépített [Variant] típusa [constant TYPE_OBJECT], visszaadja a típusos szótár kulcsainak [b]beépített[/b] osztálynevét. Egyébként üres [StringName] értéket ad vissza. Lásd még: [method is_typed_key] és [method Object.get_class]."

#. Dictionary.get_typed_key_script
#: doc/classes/Dictionary.xml
msgid "Returns the [Script] instance associated with this typed dictionary's keys, or [code]null[/code] if it does not exist. See also [method is_typed_key]."
msgstr "Visszaadja a típusos szótár kulcsaihoz tartozó [Script] példányt. Ha nincs ilyen példány, az eredmény [code]null[/code]. Lásd még: [method is_typed_key]."

#. Dictionary.get_typed_value_builtin
#: doc/classes/Dictionary.xml
msgid "Returns the built-in [Variant] type of the typed dictionary's values as a [enum Variant.Type] constant. If the values are not typed, returns [constant TYPE_NIL]. See also [method is_typed_value]."
msgstr "Visszaadja a típusos szótár értékeinek beépített [Variant] típusát a [enum Variant.Type] egyik állandójaként. Ha a szótár értékei nem típusosak, az eredmény [constant TYPE_NIL]. Lásd még: [method is_typed_value]."

#. Dictionary.get_typed_value_class_name
#: doc/classes/Dictionary.xml
msgid "Returns the [b]built-in[/b] class name of the typed dictionary's values, if the built-in [Variant] type is [constant TYPE_OBJECT]. Otherwise, returns an empty [StringName]. See also [method is_typed_value] and [method Object.get_class]."
msgstr "Ha a szótár értékeinek beépített [Variant] típusa [constant TYPE_OBJECT], visszaadja a típusos szótár értékeinek [b]beépített[/b] osztálynevét. Egyébként üres [StringName] értéket ad vissza. Lásd még: [method is_typed_value] és [method Object.get_class]."

#. Dictionary.get_typed_value_script
#: doc/classes/Dictionary.xml
msgid "Returns the [Script] instance associated with this typed dictionary's values, or [code]null[/code] if it does not exist. See also [method is_typed_value]."
msgstr "Visszaadja a típusos szótár értékeihez tartozó [Script] példányt. Ha nincs ilyen példány, az eredmény [code]null[/code]. Lásd még: [method is_typed_value]."

#. JSON.brief
#: doc/classes/JSON.xml
msgid "Helper class for creating and parsing JSON data."
msgstr "Segédosztály JSON-adatok létrehozásához és feldolgozásához."

#. JSON.from_native
#: doc/classes/JSON.xml
msgid "Converts a native engine type to a JSON-compliant value.\nBy default, objects are ignored for security reasons, unless [param full_objects] is [code]true[/code].\nYou can convert a native value to a JSON string like this:\n[codeblock]\nfunc encode_data(value, full_objects = false):\n\treturn JSON.stringify(JSON.from_native(value, full_objects))\n[/codeblock]"
msgstr "A motor natív típusú értékét JSON-kompatibilis értékké alakítja.\nBiztonsági okokból alapértelmezés szerint figyelmen kívül hagyja az objektumokat. Ezeket akkor dolgozza fel, ha a [param full_objects] értéke [code]true[/code].\nEgy natív értéket így alakíthatsz JSON-sztringgé:\n[codeblock]\nfunc encode_data(value, full_objects = false):\n\treturn JSON.stringify(JSON.from_native(value, full_objects))\n[/codeblock]"

#. JSON.get_error_line
#: doc/classes/JSON.xml
msgid "Returns [code]0[/code] if the last call to [method parse] was successful, or the line number where the parse failed."
msgstr "[code]0[/code] értéket ad vissza, ha a [method parse] legutóbbi hívása sikeres volt. Hiba esetén annak a sornak a számát adja vissza, amelynél a feldolgozás meghiúsult."

#. JSON.get_error_message
#: doc/classes/JSON.xml
msgid "Returns an empty string if the last call to [method parse] was successful, or the error message if it failed."
msgstr "Üres sztringet ad vissza, ha a [method parse] legutóbbi hívása sikeres volt. Hiba esetén a hibaüzenetet adja vissza."

#. JSON.get_parsed_text
#: doc/classes/JSON.xml
msgid "Return the text parsed by [method parse] (requires passing [code]keep_text[/code] to [method parse])."
msgstr "Visszaadja a [method parse] által feldolgozott szöveget, ha a [method parse] hívásakor bekapcsoltad a [code]keep_text[/code] beállítást."

#. JSON.parse
#: doc/classes/JSON.xml
msgid "Attempts to parse the [param json_text] provided.\nReturns an [enum Error]. If the parse was successful, it returns [constant OK] and the result can be retrieved using [member data]. If unsuccessful, use [method get_error_line] and [method get_error_message] to identify the source of the failure.\nNon-static variant of [method parse_string], if you want custom error handling.\nThe optional [param keep_text] argument instructs the parser to keep a copy of the original text. This text can be obtained later by using the [method get_parsed_text] function and is used when saving the resource (instead of generating new text from [member data])."
msgstr "Megpróbálja feldolgozni a megadott [param json_text] JSON-szöveget.\nEgy [enum Error] értéket ad vissza. Siker esetén az eredménykód [constant OK], és a feldolgozott adatot a [member data] tulajdonságból olvashatod ki. Hiba esetén a [method get_error_line] és a [method get_error_message] metódusokkal keresheted meg a hiba okát.\nA [method parse_string] példánymetódusként használható változata saját hibakezeléshez.\nAz opcionális [param keep_text] argumentummal megőriztetheted az eredeti szöveg másolatát. Később a [method get_parsed_text] metódussal kérheted le. Az erőforrás mentésekor ezt a szöveget használja, ahelyett hogy a [member data] értékéből új szöveget állítana elő."

#. JSON.parse_string
#: doc/classes/JSON.xml
msgid "Attempts to parse the [param json_string] provided and returns the parsed data. Returns [code]null[/code] if parse failed."
msgstr "Megpróbálja feldolgozni a megadott [param json_string] sztringet, és visszaadja a feldolgozott adatot. Sikertelen feldolgozás esetén [code]null[/code] értéket ad vissza."

#. JSON.to_native
#: doc/classes/JSON.xml
msgid "Converts a JSON-compliant value that was created with [method from_native] back to native engine types.\nBy default, objects are ignored for security reasons, unless [param allow_objects] is [code]true[/code].\nYou can convert a JSON string back to a native value like this:\n[codeblock]\nfunc decode_data(string, allow_objects = false):\n\treturn JSON.to_native(JSON.parse_string(string), allow_objects)\n[/codeblock]"
msgstr "A [method from_native] által létrehozott JSON-kompatibilis értéket visszaalakítja a motor megfelelő natív típusú értékévé.\nBiztonsági okokból alapértelmezés szerint figyelmen kívül hagyja az objektumokat. Ezeket akkor dolgozza fel, ha a [param allow_objects] értéke [code]true[/code].\nEgy JSON-sztringet így alakíthatsz vissza natív értékké:\n[codeblock]\nfunc decode_data(string, allow_objects = false):\n\treturn JSON.to_native(JSON.parse_string(string), allow_objects)\n[/codeblock]"

#. JSON.data
#: doc/classes/JSON.xml
msgid "Contains the parsed JSON data in [Variant] form."
msgstr "A feldolgozott JSON-adatot tartalmazza [Variant] értékként."

#. JSONRPC.brief
#: doc/classes/JSONRPC.xml
msgid "A helper to handle dictionaries which look like JSONRPC documents."
msgstr "Segédosztály JSON-RPC formátumú szótárak kezelésére."

#. JSONRPC.description
#: doc/classes/JSONRPC.xml
msgid "[url=https://www.jsonrpc.org/]JSON-RPC[/url] is a standard which wraps a method call in a [JSON] object. The object has a particular structure and identifies which method is called, the parameters to that function, and carries an ID to keep track of responses. This class implements that standard on top of [Dictionary]; you will have to convert between a [Dictionary] and [JSON] with other functions."
msgstr "A [url=https://www.jsonrpc.org/]JSON-RPC[/url] szabvány a metódushívásokat [JSON] objektumba csomagolja. Az objektum meghatározott szerkezetben rögzíti a meghívandó metódust és annak paramétereit, valamint a válaszok követéséhez szükséges azonosítót. Ez az osztály a szabványt [Dictionary] szótárakkal valósítja meg. A [Dictionary] és a [JSON] közötti átalakítást más függvényekkel kell elvégezned."

#. JSONRPC.make_notification
#: doc/classes/JSONRPC.xml
msgid "Returns a dictionary in the form of a JSON-RPC notification. Notifications are one-shot messages which do not expect a response.\n- [param method]: Name of the method being called.\n- [param params]: An array or dictionary of parameters being passed to the method."
msgstr "JSON-RPC értesítés formájú szótárt ad vissza. Az értesítés egyszeri üzenet, amelyre a küldő nem vár választ.\n- [param method]: A meghívott metódus neve.\n- [param params]: A metódusnak átadott paraméterek tömbje vagy szótára."

#. JSONRPC.make_request
#: doc/classes/JSONRPC.xml
msgid "Returns a dictionary in the form of a JSON-RPC request. Requests are sent to a server with the expectation of a response. The ID field is used for the server to specify which exact request it is responding to.\n- [param method]: Name of the method being called.\n- [param params]: An array or dictionary of parameters being passed to the method.\n- [param id]: Uniquely identifies this request. The server is expected to send a response with the same ID."
msgstr "JSON-RPC kérés formájú szótárt ad vissza. A kliens választ vár a kiszolgálónak küldött kérésre. A kiszolgáló az azonosítómezővel jelzi, pontosan melyik kérésre válaszol.\n- [param method]: A meghívott metódus neve.\n- [param params]: A metódusnak átadott paraméterek tömbje vagy szótára.\n- [param id]: A kérés egyedi azonosítója. A kiszolgálótól ugyanezzel az azonosítóval várható válasz."

#. JSONRPC.make_response
#: doc/classes/JSONRPC.xml
msgid "When a server has received and processed a request, it is expected to send a response. If you did not want a response then you need to have sent a Notification instead.\n- [param result]: The return value of the function which was called.\n- [param id]: The ID of the request this response is targeted to."
msgstr "A kérés fogadása és feldolgozása után a kiszolgáló választ küld. Ha nincs szükséged válaszra, küldj inkább értesítést.\n- [param result]: A meghívott függvény visszatérési értéke.\n- [param id]: Annak a kérésnek az azonosítója, amelyhez a válasz tartozik."

#. JSONRPC.make_response_error
#: doc/classes/JSONRPC.xml
msgid "Creates a response which indicates a previous reply has failed in some way.\n- [param code]: The error code corresponding to what kind of error this is. See the [enum ErrorCode] constants.\n- [param message]: A custom message about this error.\n- [param id]: The request this error is a response to."
msgstr "Olyan választ hoz létre, amely jelzi, hogy az adott kérés feldolgozása hibába ütközött.\n- [param code]: A hiba típusát megadó hibakód. Lásd az [enum ErrorCode] állandóit.\n- [param message]: A hibát leíró egyéni üzenet.\n- [param id]: Annak a kérésnek az azonosítója, amelyhez a hibaválasz tartozik."

#. ConfigFile.brief
#: doc/classes/ConfigFile.xml
msgid "Helper class to handle INI-style files."
msgstr "Segédosztály INI-szerű fájlok kezelésére."

#. ConfigFile.description
#: doc/classes/ConfigFile.xml
msgid "This helper class can be used to store [Variant] values on the filesystem using INI-style formatting. The stored values are identified by a section and a key:\n[codeblock lang=text]\n[section]\nsome_key=42\nstring_example=\"Hello World3D!\"\na_vector=Vector3(1, 0, 2)\n[/codeblock]\nThe stored data can be saved to or parsed from a file, though ConfigFile objects can also be used directly without accessing the filesystem.\nThe following example shows how to create a simple [ConfigFile] and save it on disc:\n[codeblocks]\n[gdscript]\n# Create new ConfigFile object.\nvar config = ConfigFile.new()\n\n# Store some values.\nconfig.set_value(\"Player1\", \"player_name\", \"Steve\")\nconfig.set_value(\"Player1\", \"best_score\", 10)\nconfig.set_value(\"Player2\", \"player_name\", \"V3geta\")\nconfig.set_value(\"Player2\", \"best_score\", 9001)\n\n# Save it to a file (overwrite if already exists).\nconfig.save(\"user://scores.cfg\")\n[/gdscript]\n[csharp]\n// Create new ConfigFile object.\nvar config = new ConfigFile();\n\n// Store some values.\nconfig.SetValue(\"Player1\", \"player_name\", \"Steve\");\nconfig.SetValue(\"Player1\", \"best_score\", 10);\nconfig.SetValue(\"Player2\", \"player_name\", \"V3geta\");\nconfig.SetValue(\"Player2\", \"best_score\", 9001);\n\n// Save it to a file (overwrite if already exists).\nconfig.Save(\"user://scores.cfg\");\n[/csharp]\n[/codeblocks]\nThis example shows how the above file could be loaded:\n[codeblocks]\n[gdscript]\nvar score_data = {}\nvar config = ConfigFile.new()\n\n# Load data from a file.\nvar err = config.load(\"user://scores.cfg\")\n\n# If the file didn't load, ignore it.\nif err != OK:\n\treturn\n\n# Iterate over all sections.\nfor player in config.get_sections():\n\t# Fetch the data for each section.\n\tvar player_name = config.get_value(player, \"player_name\")\n\tvar player_score = config.get_value(player, \"best_score\")\n\tscore_data[player_name] = player_score\n[/gdscript]\n[csharp]\nvar score_data = new Godot.Collections.Dictionary();\nvar config = new ConfigFile();\n\n// Load data from a file.\nError err = config.Load(\"user://scores.cfg\");\n\n// If the file didn't load, ignore it.\nif (err != Error.Ok)\n{\n\treturn;\n}\n\n// Iterate over all sections.\nforeach (String player in config.GetSections())\n{\n\t// Fetch the data for each section.\n\tvar player_name = (String)config.GetValue(player, \"player_name\");\n\tvar player_score = (int)config.GetValue(player, \"best_score\");\n\tscore_data[player_name] = player_score;\n}\n[/csharp]\n[/codeblocks]\nAny operation that mutates the ConfigFile such as [method set_value], [method clear], or [method erase_section], only changes what is loaded in memory. If you want to write the change to a file, you have to save the changes with [method save], [method save_encrypted], or [method save_encrypted_pass].\nKeep in mind that section and property names can't contain spaces. Anything after a space will be ignored on save and on load.\nConfigFiles can also contain manually written comment lines starting with a semicolon ([code];[/code]). Those lines will be ignored when parsing the file. Note that comments will be lost when saving the ConfigFile. This can still be useful for dedicated server configuration files, which are typically never overwritten without explicit user action.\n[b]Note:[/b] The file extension given to a ConfigFile does not have any impact on its formatting or behavior. By convention, the [code].cfg[/code] extension is used here, but any other extension such as [code].ini[/code] is also valid. Since neither [code].cfg[/code] nor [code].ini[/code] are standardized, Godot's ConfigFile formatting may differ from files written by other programs."
msgstr "Ezzel a segédosztállyal [Variant] értékeket tárolhatsz a fájlrendszerben, INI-szerű formátumban. Minden tárolt értéket egy szakasz és egy kulcs azonosít:\n[codeblock lang=text]\n[section]\nsome_key=42\nstring_example=\"Hello World3D!\"\na_vector=Vector3(1, 0, 2)\n[/codeblock]\nAz adatokat fájlba mentheted, vagy fájlból olvashatod be. A ConfigFile objektumot közvetlenül, fájlművelet nélkül is használhatod.\nA következő példa egy egyszerű [ConfigFile] létrehozását és lemezre mentését mutatja be:\n[codeblocks]\n[gdscript]\n# Create new ConfigFile object.\nvar config = ConfigFile.new()\n\n# Store some values.\nconfig.set_value(\"Player1\", \"player_name\", \"Steve\")\nconfig.set_value(\"Player1\", \"best_score\", 10)\nconfig.set_value(\"Player2\", \"player_name\", \"V3geta\")\nconfig.set_value(\"Player2\", \"best_score\", 9001)\n\n# Save it to a file (overwrite if already exists).\nconfig.save(\"user://scores.cfg\")\n[/gdscript]\n[csharp]\n// Create new ConfigFile object.\nvar config = new ConfigFile();\n\n// Store some values.\nconfig.SetValue(\"Player1\", \"player_name\", \"Steve\");\nconfig.SetValue(\"Player1\", \"best_score\", 10);\nconfig.SetValue(\"Player2\", \"player_name\", \"V3geta\");\nconfig.SetValue(\"Player2\", \"best_score\", 9001);\n\n// Save it to a file (overwrite if already exists).\nconfig.Save(\"user://scores.cfg\");\n[/csharp]\n[/codeblocks]\nÍgy töltheted be a fenti fájlt:\n[codeblocks]\n[gdscript]\nvar score_data = {}\nvar config = ConfigFile.new()\n\n# Load data from a file.\nvar err = config.load(\"user://scores.cfg\")\n\n# If the file didn't load, ignore it.\nif err != OK:\n\treturn\n\n# Iterate over all sections.\nfor player in config.get_sections():\n\t# Fetch the data for each section.\n\tvar player_name = config.get_value(player, \"player_name\")\n\tvar player_score = config.get_value(player, \"best_score\")\n\tscore_data[player_name] = player_score\n[/gdscript]\n[csharp]\nvar score_data = new Godot.Collections.Dictionary();\nvar config = new ConfigFile();\n\n// Load data from a file.\nError err = config.Load(\"user://scores.cfg\");\n\n// If the file didn't load, ignore it.\nif (err != Error.Ok)\n{\n\treturn;\n}\n\n// Iterate over all sections.\nforeach (String player in config.GetSections())\n{\n\t// Fetch the data for each section.\n\tvar player_name = (String)config.GetValue(player, \"player_name\");\n\tvar player_score = (int)config.GetValue(player, \"best_score\");\n\tscore_data[player_name] = player_score;\n}\n[/csharp]\n[/codeblocks]\nA ConfigFile tartalmát módosító műveletek, például a [method set_value], a [method clear] és a [method erase_section], csak a memóriában tárolt adatokra hatnak. A változásokat a [method save], a [method save_encrypted] vagy a [method save_encrypted_pass] hívásával írhatod fájlba.\nA szakaszok és a tulajdonságok neve nem tartalmazhat szóközt. A szóköz utáni részt a mentés és a betöltés is figyelmen kívül hagyja.\nA ConfigFile fájlok kézzel írt, pontosvesszővel ([code];[/code]) kezdődő megjegyzéssorokat is tartalmazhatnak. Ezeket az osztály beolvasáskor figyelmen kívül hagyja, mentéskor pedig elhagyja. A megjegyzéssorok így is jól jöhetnek például dedikált kiszolgálók konfigurációs fájljaiban, amelyeket általában csak a felhasználó kifejezett kérésére írnak felül.\n[b]Megjegyzés:[/b] A fájlkiterjesztés nem befolyásolja a ConfigFile formátumát vagy működését. A szokásos kiterjesztés a [code].cfg[/code], de más kiterjesztés, például az [code].ini[/code] is használható. A [code].cfg[/code] és az [code].ini[/code] formátuma sem szabványos, ezért a Godot ConfigFile formátuma eltérhet a más programok által írt fájlokétól."

#. ConfigFile.clear
#: doc/classes/ConfigFile.xml
msgid "Removes the entire contents of the config."
msgstr "Törli a konfiguráció teljes tartalmát."

#. ConfigFile.encode_to_text
#: doc/classes/ConfigFile.xml
msgid "Obtain the text version of this config file (the same text that would be written to a file)."
msgstr "Visszaadja a konfiguráció szöveges alakját, vagyis ugyanazt a szöveget, amely mentéskor a fájlba kerülne."

#. ConfigFile.erase_section
#: doc/classes/ConfigFile.xml
msgid "Deletes the specified section along with all the key-value pairs inside. Raises an error if the section does not exist."
msgstr "Törli a megadott szakaszt a benne lévő összes kulcs–érték párral együtt. Ha a szakasz nem létezik, hibát jelez."

#. ConfigFile.erase_section_key
#: doc/classes/ConfigFile.xml
msgid "Deletes the specified key in a section. Raises an error if either the section or the key do not exist."
msgstr "Törli a megadott kulcsot a szakaszból. Ha a szakasz vagy a kulcs nem létezik, hibát jelez."

#. ConfigFile.get_section_keys
#: doc/classes/ConfigFile.xml
msgid "Returns an array of all defined key identifiers in the specified section. Raises an error and returns an empty array if the section does not exist."
msgstr "Tömbben adja vissza a megadott szakasz összes kulcsát. Ha a szakasz nem létezik, hibát jelez és üres tömböt ad vissza."

#. ConfigFile.get_sections
#: doc/classes/ConfigFile.xml
msgid "Returns an array of all defined section identifiers."
msgstr "Tömbben adja vissza az összes szakasz azonosítóját."

#. ConfigFile.get_value
#: doc/classes/ConfigFile.xml
msgid "Returns the current value for the specified section and key. If either the section or the key do not exist, the method returns the fallback [param default] value. If [param default] is not specified or set to [code]null[/code], an error is also raised."
msgstr "Visszaadja a megadott szakasz és kulcs aktuális értékét. Ha a szakasz vagy a kulcs nem létezik, a [param default] tartalékértéket adja vissza. Ha a [param default] paramétert elhagyod, vagy [code]null[/code] értéket adsz meg, hibát is jelez."

#. ConfigFile.has_section
#: doc/classes/ConfigFile.xml
msgid "Returns [code]true[/code] if the specified section exists."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott szakasz létezik."

#. ConfigFile.has_section_key
#: doc/classes/ConfigFile.xml
msgid "Returns [code]true[/code] if the specified section-key pair exists."
msgstr "[code]true[/code] értéket ad vissza, ha a kulcs létezik a megadott szakaszban."

#. ConfigFile.load
#: doc/classes/ConfigFile.xml
msgid "Loads the config file specified as a parameter. The file's contents are parsed and loaded in the [ConfigFile] object which the method was called on.\nReturns [constant OK] on success, or one of the other [enum Error] values if the operation failed."
msgstr "Betölti a paraméterként megadott konfigurációs fájlt. A fájl tartalmát feldolgozza, és betölti abba a [ConfigFile] objektumba, amelyen a metódust meghívtad.\nSiker esetén [constant OK], sikertelen művelet esetén az [enum Error] valamelyik másik értéke az eredmény."

#. ConfigFile.load_encrypted
#: doc/classes/ConfigFile.xml
msgid "Loads the encrypted config file specified as a parameter, using the provided [param key] to decrypt it. The file's contents are parsed and loaded in the [ConfigFile] object which the method was called on.\nReturns [constant OK] on success, or one of the other [enum Error] values if the operation failed."
msgstr "A megadott [param key] kulccsal visszafejti és betölti a paraméterként megadott, titkosított konfigurációs fájlt. A fájl tartalmát feldolgozza, és betölti abba a [ConfigFile] objektumba, amelyen a metódust meghívtad.\nSiker esetén [constant OK], sikertelen művelet esetén az [enum Error] valamelyik másik értéke az eredmény."

#. ConfigFile.load_encrypted_pass
#: doc/classes/ConfigFile.xml
msgid "Loads the encrypted config file specified as a parameter, using the provided [param password] to decrypt it. The file's contents are parsed and loaded in the [ConfigFile] object which the method was called on.\nReturns [constant OK] on success, or one of the other [enum Error] values if the operation failed."
msgstr "A megadott [param password] jelszóval visszafejti és betölti a paraméterként megadott, titkosított konfigurációs fájlt. A fájl tartalmát feldolgozza, és betölti abba a [ConfigFile] objektumba, amelyen a metódust meghívtad.\nSiker esetén [constant OK], sikertelen művelet esetén az [enum Error] valamelyik másik értéke az eredmény."

#. ConfigFile.parse
#: doc/classes/ConfigFile.xml
msgid "Parses the passed string as the contents of a config file. The string is parsed and loaded in the ConfigFile object which the method was called on.\nReturns [constant OK] on success, or one of the other [enum Error] values if the operation failed."
msgstr "A kapott sztringet konfigurációs fájl tartalmaként dolgozza fel, és betölti abba a ConfigFile objektumba, amelyen a metódust meghívtad.\nSiker esetén [constant OK], sikertelen művelet esetén az [enum Error] valamelyik másik értéke az eredmény."

#. ConfigFile.save
#: doc/classes/ConfigFile.xml
msgid "Saves the contents of the [ConfigFile] object to the file specified as a parameter. The output file uses an INI-style structure.\nReturns [constant OK] on success, or one of the other [enum Error] values if the operation failed."
msgstr "A [ConfigFile] objektum tartalmát a paraméterként megadott fájlba menti. A kimeneti fájl szerkezete INI-szerű.\nSiker esetén [constant OK], sikertelen művelet esetén az [enum Error] valamelyik másik értéke az eredmény."

#. ConfigFile.save_encrypted
#: doc/classes/ConfigFile.xml
msgid "Saves the contents of the [ConfigFile] object to the AES-256 encrypted file specified as a parameter, using the provided [param key] to encrypt it. The output file uses an INI-style structure.\nReturns [constant OK] on success, or one of the other [enum Error] values if the operation failed."
msgstr "A [ConfigFile] objektum tartalmát a paraméterként megadott fájlba menti, AES-256 titkosítással. A titkosításhoz a megadott [param key] kulcsot használja. A kimeneti fájl szerkezete INI-szerű.\nSiker esetén [constant OK], sikertelen művelet esetén az [enum Error] valamelyik másik értéke az eredmény."

#. ConfigFile.save_encrypted_pass
#: doc/classes/ConfigFile.xml
msgid "Saves the contents of the [ConfigFile] object to the AES-256 encrypted file specified as a parameter, using the provided [param password] to encrypt it. The output file uses an INI-style structure.\nReturns [constant OK] on success, or one of the other [enum Error] values if the operation failed."
msgstr "A [ConfigFile] objektum tartalmát a paraméterként megadott fájlba menti, AES-256 titkosítással. A titkosításhoz a megadott [param password] jelszót használja. A kimeneti fájl szerkezete INI-szerű.\nSiker esetén [constant OK], sikertelen művelet esetén az [enum Error] valamelyik másik értéke az eredmény."

#. ConfigFile.set_value
#: doc/classes/ConfigFile.xml
msgid "Assigns a value to the specified key of the specified section. If either the section or the key do not exist, they are created. Passing a [code]null[/code] value deletes the specified key if it exists, and deletes the section if it ends up empty once the key has been removed."
msgstr "Értéket rendel a megadott szakasz megadott kulcsához. Szükség esetén létrehozza a szakaszt vagy a kulcsot. A [code]null[/code] érték átadása törli a kulcsot, ha létezik. Ha ettől a szakasz kiürül, magát a szakaszt is törli."

#. DirAccess.brief
#: doc/classes/DirAccess.xml
msgid "Provides methods for managing directories and their content."
msgstr "Metódusokat biztosít a mappák és tartalmuk kezeléséhez."

#. DirAccess.description
#: doc/classes/DirAccess.xml
msgid "This class is used to manage directories and their content, even outside of the project folder.\n[DirAccess] can't be instantiated directly. Instead it is created with a static method that takes a path for which it will be opened.\nMost of the methods have a static alternative that can be used without creating a [DirAccess]. Static methods only support absolute paths (including [code]res://[/code] and [code]user://[/code]).\n[codeblock]\n# Standard\nvar dir = DirAccess.open(\"user://levels\")\ndir.make_dir(\"world1\")\n# Static\nDirAccess.make_dir_absolute(\"user://levels/world1\")\n[/codeblock]\n[b]Note:[/b] Accessing project (\"res://\") directories once exported may behave unexpectedly as some files are converted to engine-specific formats and their original source files may not be present in the expected PCK package. Because of this, to access resources in an exported project, it is recommended to use [ResourceLoader] instead of [FileAccess].\nHere is an example on how to iterate through the files of a directory:\n[codeblocks]\n[gdscript]\nfunc dir_contents(path):\n\tvar dir = DirAccess.open(path)\n\tif dir:\n\t\tdir.list_dir_begin()\n\t\tvar file_name = dir.get_next()\n\t\twhile file_name != \"\":\n\t\t\tif dir.current_is_dir():\n\t\t\t\tprint(\"Found directory: \" + file_name)\n\t\t\telse:\n\t\t\t\tprint(\"Found file: \" + file_name)\n\t\t\tfile_name = dir.get_next()\n\telse:\n\t\tprint(\"An error occurred when trying to access the path.\")\n[/gdscript]\n[csharp]\npublic void DirContents(string path)\n{\n\tusing var dir = DirAccess.Open(path);\n\tif (dir != null)\n\t{\n\t\tdir.ListDirBegin();\n\t\tstring fileName = dir.GetNext();\n\t\twhile (fileName != \"\")\n\t\t{\n\t\t\tif (dir.CurrentIsDir())\n\t\t\t{\n\t\t\t\tGD.Print($\"Found directory: {fileName}\");\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tGD.Print($\"Found file: {fileName}\");\n\t\t\t}\n\t\t\tfileName = dir.GetNext();\n\t\t}\n\t}\n\telse\n\t{\n\t\tGD.Print(\"An error occurred when trying to access the path.\");\n\t}\n}\n[/csharp]\n[/codeblocks]\nKeep in mind that file names may change or be remapped after export. If you want to see the actual resource file list as it appears in the editor, use [method ResourceLoader.list_directory] instead."
msgstr "Ezzel az osztállyal a projektmappán belüli és kívüli mappákat, illetve azok tartalmát kezelheted.\nA [DirAccess] közvetlenül nem példányosítható. Egy statikus metódussal hozhatsz létre példányt, és annak adhatod át a megnyitandó mappa útvonalát.\nA legtöbb metódusnak van statikus változata, amely [DirAccess] példány nélkül is használható. A statikus metódusok csak abszolút útvonalakat támogatnak (ideértve a [code]res://[/code] és a [code]user://[/code] kezdetű útvonalakat).\n[codeblock]\n# Standard\nvar dir = DirAccess.open(\"user://levels\")\ndir.make_dir(\"world1\")\n# Static\nDirAccess.make_dir_absolute(\"user://levels/world1\")\n[/codeblock]\n[b]Megjegyzés:[/b] Exportálás után a projektmappák („res://”) elérése eltérhet a szerkesztőben tapasztaltaktól. Egyes fájlokat a motor saját formátumára alakít, így az eredeti forrásfájlok hiányozhatnak a PCK-csomagból. Exportált projektben ezért az erőforrásokat a [ResourceLoader] használatával érdemes elérni a [FileAccess] helyett.\nPélda arra, hogyan járhatod be egy mappa fájljait:\n[codeblocks]\n[gdscript]\nfunc dir_contents(path):\n\tvar dir = DirAccess.open(path)\n\tif dir:\n\t\tdir.list_dir_begin()\n\t\tvar file_name = dir.get_next()\n\t\twhile file_name != \"\":\n\t\t\tif dir.current_is_dir():\n\t\t\t\tprint(\"Found directory: \" + file_name)\n\t\t\telse:\n\t\t\t\tprint(\"Found file: \" + file_name)\n\t\t\tfile_name = dir.get_next()\n\telse:\n\t\tprint(\"An error occurred when trying to access the path.\")\n[/gdscript]\n[csharp]\npublic void DirContents(string path)\n{\n\tusing var dir = DirAccess.Open(path);\n\tif (dir != null)\n\t{\n\t\tdir.ListDirBegin();\n\t\tstring fileName = dir.GetNext();\n\t\twhile (fileName != \"\")\n\t\t{\n\t\t\tif (dir.CurrentIsDir())\n\t\t\t{\n\t\t\t\tGD.Print($\"Found directory: {fileName}\");\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tGD.Print($\"Found file: {fileName}\");\n\t\t\t}\n\t\t\tfileName = dir.GetNext();\n\t\t}\n\t}\n\telse\n\t{\n\t\tGD.Print(\"An error occurred when trying to access the path.\");\n\t}\n}\n[/csharp]\n[/codeblocks]\nExportáláskor a fájlnevek megváltozhatnak, vagy a motor más útvonalra irányíthatja őket. Ha az erőforrásokat a szerkesztőben látható nevükön szeretnéd felsorolni, használd a [method ResourceLoader.list_directory] metódust."

#. DirAccess.change_dir
#: doc/classes/DirAccess.xml
msgid "Changes the currently opened directory to the one passed as an argument. The argument can be relative to the current directory (e.g. [code]newdir[/code] or [code]../newdir[/code]), or an absolute path (e.g. [code]/tmp/newdir[/code] or [code]res://somedir/newdir[/code]).\nReturns one of the [enum Error] code constants ([constant OK] on success).\n[b]Note:[/b] The new directory must be within the same scope, e.g. when you had opened a directory inside [code]res://[/code], you can't change it to [code]user://[/code] directory. If you need to open a directory in another access scope, use [method open] to create a new instance instead."
msgstr "Az éppen megnyitott mappát az argumentumként átadott mappára váltja. Az útvonal lehet az aktuális mappához viszonyított (például [code]newdir[/code] vagy [code]../newdir[/code]), illetve abszolút (például [code]/tmp/newdir[/code] vagy [code]res://somedir/newdir[/code]).\nAz [enum Error] valamelyik hibakódját adja vissza (siker esetén [constant OK]).\n[b]Megjegyzés:[/b] Az új mappának ugyanabban a hozzáférési tartományban kell lennie. Például egy [code]res://[/code] alatti mappából nem válthatsz [code]user://[/code] alatti mappára. Másik hozzáférési tartományban a [method open] metódussal hozz létre új példányt."

#. DirAccess.copy
#: doc/classes/DirAccess.xml
msgid "Copies the [param from] file to the [param to] destination. Both arguments should be paths to files, either relative or absolute. If the destination file exists and is not access-protected, it will be overwritten.\nIf [param chmod_flags] is different than [code]-1[/code], the Unix permissions for the destination path will be set to the provided value, if available on the current operating system.\nReturns one of the [enum Error] code constants ([constant OK] on success)."
msgstr "A [param from] fájlt a [param to] célhelyre másolja. Mindkét argumentumnak relatív vagy abszolút fájlútvonalnak kell lennie. Ha a célfájl létezik, és a hozzáférése nincs korlátozva, a metódus felülírja.\nHa a [param chmod_flags] értéke eltér a [code]-1[/code] értéktől, a megadott értékre állítja a célfájl Unix-jogosultságait, amennyiben ezt az operációs rendszer támogatja.\nAz [enum Error] valamelyik hibakódját adja vissza (siker esetén [constant OK])."

#. DirAccess.copy_absolute
#: doc/classes/DirAccess.xml
msgid "Static version of [method copy]. Supports only absolute paths."
msgstr "A [method copy] statikus változata. Csak abszolút útvonalakat támogat."

#. DirAccess.create_link
#: doc/classes/DirAccess.xml
msgid "Creates symbolic link between files or folders.\n[b]Note:[/b] On Windows, this method works only if the application is running with elevated privileges or Developer Mode is enabled.\n[b]Note:[/b] This method is implemented on macOS, Linux, and Windows."
msgstr "Szimbolikus hivatkozást hoz létre fájlok vagy mappák között.\n[b]Megjegyzés:[/b] Windowson csak akkor működik, ha az alkalmazás emelt jogosultsággal fut, vagy be van kapcsolva a fejlesztői mód.\n[b]Megjegyzés:[/b] A metódus macOS-en, Linuxon és Windowson érhető el."

#. DirAccess.create_temp
#: doc/classes/DirAccess.xml
msgid "Creates a temporary directory. This directory will be freed when the returned [DirAccess] is freed.\nIf [param prefix] is not empty, it will be prefixed to the directory name, separated by a [code]-[/code].\nIf [param keep] is [code]true[/code], the directory is not deleted when the returned [DirAccess] is freed.\nReturns [code]null[/code] if opening the directory failed. You can use [method get_open_error] to check the error that occurred."
msgstr "Ideiglenes mappát hoz létre. A mappa a visszaadott [DirAccess] felszabadításakor törlődik.\nHa a [param prefix] nem üres, az előtag a mappa nevének elejére kerül, [code]-[/code] jellel elválasztva.\nHa a [param keep] értéke [code]true[/code], a visszaadott [DirAccess] felszabadításakor a mappa megmarad.\nHa a mappa megnyitása sikertelen, [code]null[/code] értéket ad vissza. A hibakódot a [method get_open_error] metódussal kérheted le."

#. DirAccess.current_is_dir
#: doc/classes/DirAccess.xml
msgid "Returns whether the current item processed with the last [method get_next] call is a directory ([code].[/code] and [code]..[/code] are considered directories)."
msgstr "Megadja, hogy a [method get_next] legutóbbi hívásával kapott elem mappa-e. A [code].[/code] és a [code]..[/code] is mappának számít."

#. DirAccess.dir_exists
#: doc/classes/DirAccess.xml
msgid "Returns whether the target directory exists. The argument can be relative to the current directory, or an absolute path.\n[b]Note:[/b] The returned [bool] in the editor and after exporting when used on a path in the [code]res://[/code] directory may be different. Some files are converted to engine-specific formats when exported, potentially changing the directory structure."
msgstr "Megadja, hogy a célmappa létezik-e. Az argumentum az aktuális mappához viszonyított vagy abszolút útvonal lehet.\n[b]Megjegyzés:[/b] A [code]res://[/code] alatti útvonalaknál a szerkesztőben és az exportált projektben eltérhet a visszaadott [bool] érték. A motor exportáláskor a saját formátumára alakíthat egyes fájlokat, ami megváltoztathatja a mappaszerkezetet."

#. DirAccess.dir_exists_absolute
#: doc/classes/DirAccess.xml
msgid "Static version of [method dir_exists]. Supports only absolute paths.\n[b]Note:[/b] The returned [bool] in the editor and after exporting when used on a path in the [code]res://[/code] directory may be different. Some files are converted to engine-specific formats when exported, potentially changing the directory structure."
msgstr "A [method dir_exists] statikus változata. Csak abszolút útvonalakat támogat.\n[b]Megjegyzés:[/b] A [code]res://[/code] alatti útvonalaknál a szerkesztőben és az exportált projektben eltérhet a visszaadott [bool] érték. A motor exportáláskor a saját formátumára alakíthat egyes fájlokat, ami megváltoztathatja a mappaszerkezetet."

#. DirAccess.file_exists
#: doc/classes/DirAccess.xml
msgid "Returns whether the target file exists. The argument can be relative to the current directory, or an absolute path.\nFor a static equivalent, use [method FileAccess.file_exists].\n[b]Note:[/b] Many resources types are imported (e.g. textures or sound files), and their source asset will not be included in the exported game, as only the imported version is used. See [method ResourceLoader.exists] for an alternative approach that takes resource remapping into account."
msgstr "Megadja, hogy a célfájl létezik-e. Az argumentum az aktuális mappához viszonyított vagy abszolút útvonal lehet.\nA statikus megfelelője a [method FileAccess.file_exists].\n[b]Megjegyzés:[/b] A Godot számos erőforrástípust importál, például textúrákat és hangfájlokat. Az exportált játék csak az importált változatot használja, ezért az eredeti fájl nem kerül bele. A [method ResourceLoader.exists] az exportált erőforrások átirányított útvonalát is figyelembe veszi."

#. DirAccess.get_current_dir
#: doc/classes/DirAccess.xml
msgid "Returns the absolute path to the currently opened directory (e.g. [code]res://folder[/code] or [code]C:\\tmp\\folder[/code])."
msgstr "Visszaadja az éppen megnyitott mappa abszolút útvonalát (például [code]res://folder[/code] vagy [code]C:\\tmp\\folder[/code])."

#. DirAccess.get_current_drive
#: doc/classes/DirAccess.xml
msgid "Returns the currently opened directory's drive index. See [method get_drive_name] to convert returned index to the name of the drive."
msgstr "Visszaadja az éppen megnyitott mappa meghajtójának indexét. Az indexhez tartozó meghajtó nevét a [method get_drive_name] metódussal kérheted le."

#. DirAccess.get_directories
#: doc/classes/DirAccess.xml
msgid "Returns a [PackedStringArray] containing filenames of the directory contents, excluding files. The array is sorted alphabetically.\nAffected by [member include_hidden] and [member include_navigational].\n[b]Note:[/b] The returned directories in the editor and after exporting in the [code]res://[/code] directory may differ as some files are converted to engine-specific formats when exported."
msgstr "Betűrendbe állított [PackedStringArray] tömbben adja vissza az aktuális mappában található mappák nevét. A fájlok nem szerepelnek a tömbben.\nA [member include_hidden] és a [member include_navigational] beállítás befolyásolja az eredményt.\n[b]Megjegyzés:[/b] A [code]res://[/code] útvonalon felsorolt mappák eltérhetnek a szerkesztőben és az exportált projektben, mert exportáláskor a motor egyes fájlokat saját formátumra alakít."

#. DirAccess.get_directories_at
#: doc/classes/DirAccess.xml
msgid "Returns a [PackedStringArray] containing filenames of the directory contents, excluding files, at the given [param path]. The array is sorted alphabetically.\nUse [method get_directories] if you want more control of what gets included.\n[b]Note:[/b] The returned directories in the editor and after exporting in the [code]res://[/code] directory may differ as some files are converted to engine-specific formats when exported."
msgstr "Betűrendbe állított [PackedStringArray] tömbben adja vissza a megadott [param path] alatti mappák nevét. A fájlok nem szerepelnek a tömbben.\nHa szabályozni szeretnéd, mely mappák kerüljenek a tömbbe, használd a [method get_directories] metódust.\n[b]Megjegyzés:[/b] A [code]res://[/code] útvonalon felsorolt mappák eltérhetnek a szerkesztőben és az exportált projektben, mert exportáláskor a motor egyes fájlokat saját formátumra alakít."

#. DirAccess.get_drive_count
#: doc/classes/DirAccess.xml
msgid "On Windows, returns the number of drives (partitions) mounted on the current filesystem.\nOn macOS and Android, returns the number of mounted volumes.\nOn Linux, returns the number of mounted volumes and GTK 3 bookmarks.\nOn other platforms, the method returns 0."
msgstr "Windowson az aktuális fájlrendszerbe csatolt meghajtók (partíciók) számát adja vissza.\nmacOS-en és Androidon a csatolt kötetek számát adja vissza.\nLinuxon a csatolt kötetek és a GTK 3-könyvjelzők számát adja vissza.\nMás platformokon 0 az eredmény."

#. DirAccess.get_drive_label
#: doc/classes/DirAccess.xml
msgid "On Windows, returns the label of the drive (partition) passed as an argument.\nOn other platforms, or if the requested drive does not exist, returns an empty String."
msgstr "Windowson az argumentumként átadott meghajtó (partíció) címkéjét adja vissza.\nMás platformon, illetve ha a kért meghajtó nem létezik, az eredmény üres sztring."

#. DirAccess.get_drive_name
#: doc/classes/DirAccess.xml
msgid "On Windows, returns the name of the drive (partition) passed as an argument (e.g. [code]C:[/code]).\nOn macOS, returns the path to the mounted volume passed as an argument.\nOn Linux, returns the path to the mounted volume or GTK 3 bookmark passed as an argument.\nOn Android (API level 30+), returns the path to the mounted volume as an argument.\nOn other platforms, or if the requested drive does not exist, returns an empty String."
msgstr "Windowson az argumentumként átadott meghajtó (partíció) nevét adja vissza (például [code]C:[/code]).\nmacOS-en az argumentumként megadott csatolt kötet útvonalát adja vissza.\nLinuxon az argumentumként megadott csatolt kötet vagy GTK 3-könyvjelző útvonalát adja vissza.\nAndroidon (30-as API-szinttől) az argumentumként megadott csatolt kötet útvonalát adja vissza.\nMás platformon, illetve ha a kért meghajtó nem létezik, az eredmény üres sztring."

#. DirAccess.get_files
#: doc/classes/DirAccess.xml
msgid "Returns a [PackedStringArray] containing filenames of the directory contents, excluding directories. The array is sorted alphabetically.\nAffected by [member include_hidden].\n[b]Note:[/b] When used on a [code]res://[/code] path in an exported project, only the files actually included in the PCK at the given folder level are returned. In practice, this means that since imported resources are stored in a top-level [code].godot/[/code] folder, only paths to [code]*.gd[/code] and [code]*.import[/code] files are returned (plus a few files such as [code]project.godot[/code] or [code]project.binary[/code] and the project icon). In an exported project, the list of returned files will also vary depending on whether [member ProjectSettings.editor/export/convert_text_resources_to_binary] is [code]true[/code]."
msgstr "Betűrendbe állított [PackedStringArray] tömbben adja vissza az aktuális mappában található fájlok nevét. A mappák nem szerepelnek a tömbben.\nA [member include_hidden] beállítás befolyásolja az eredményt.\n[b]Megjegyzés:[/b] Ha exportált projektben [code]res://[/code] kezdetű útvonalon hívod meg, csak a PCK-csomag adott mappájában ténylegesen szereplő fájlokat adja vissza. Az importált erőforrások a legfelső szintű [code].godot/[/code] mappában vannak, így a gyakorlatban csak a [code]*.gd[/code] és [code]*.import[/code] fájlok útvonalait kapod meg, néhány egyéb fájl, például a [code]project.godot[/code] vagy a [code]project.binary[/code] és a projektikon mellett. Exportált projektben a lista attól is függ, hogy a [member ProjectSettings.editor/export/convert_text_resources_to_binary] értéke [code]true[/code]-e."

#. DirAccess.get_filesystem_type
#: doc/classes/DirAccess.xml
msgid "Returns file system type name of the current directory's disk. Returned values are uppercase strings like [code]NTFS[/code], [code]FAT32[/code], [code]EXFAT[/code], [code]APFS[/code], [code]EXT4[/code], [code]BTRFS[/code], and so on.\n[b]Note:[/b] This method is implemented on macOS, Linux, Windows and for PCK virtual file system."
msgstr "Visszaadja az aktuális mappát tartalmazó meghajtó fájlrendszerének típusát. A visszaadott érték nagybetűs sztring, például [code]NTFS[/code], [code]FAT32[/code], [code]EXFAT[/code], [code]APFS[/code], [code]EXT4[/code] vagy [code]BTRFS[/code].\n[b]Megjegyzés:[/b] A metódus macOS-en, Linuxon, Windowson és a virtuális PCK-fájlrendszeren érhető el."

#. DirAccess.get_next
#: doc/classes/DirAccess.xml
msgid "Returns the next element (file or directory) in the current directory.\nThe name of the file or directory is returned (and not its full path). Once the stream has been fully processed, the method returns an empty [String] and closes the stream automatically (i.e. [method list_dir_end] would not be mandatory in such a case)."
msgstr "Visszaadja az aktuális mappa következő elemét (fájlt vagy mappát).\nA metódus a fájl vagy mappa nevét adja vissza. A bejárás végén üres [String] értéket ad, és automatikusan lezárja a bejárást. Ilyenkor nem kötelező meghívni a [method list_dir_end] metódust."

#. DirAccess.get_space_left
#: doc/classes/DirAccess.xml
msgid "Returns the available space on the current directory's disk, in bytes. Returns [code]0[/code] if the platform-specific method to query the available space fails."
msgstr "Bájtban adja vissza az aktuális mappát tartalmazó meghajtó szabad helyét. Ha a platformon a szabad hely lekérdezése sikertelen, [code]0[/code] az eredmény."

#. DirAccess.is_bundle
#: doc/classes/DirAccess.xml
msgid "Returns [code]true[/code] if the directory is a macOS bundle.\n[b]Note:[/b] This method is implemented on macOS."
msgstr "[code]true[/code] értéket ad vissza, ha a mappa macOS-alkalmazáscsomag vagy más macOS-csomag.\n[b]Megjegyzés:[/b] A metódus macOS-en érhető el."

#. DirAccess.is_case_sensitive
#: doc/classes/DirAccess.xml
msgid "Returns [code]true[/code] if the file system or directory use case sensitive file names.\n[b]Note:[/b] This method is implemented on macOS, Linux (for EXT4 and F2FS filesystems only) and Windows. On other platforms, it always returns [code]true[/code]."
msgstr "[code]true[/code] értéket ad vissza, ha a fájlrendszer vagy a mappa megkülönbözteti a kis- és nagybetűket a fájlnevekben.\n[b]Megjegyzés:[/b] Ez a metódus macOS-en, Linuxon (csak EXT4 és F2FS fájlrendszeren), valamint Windowson működik. Más platformokon mindig [code]true[/code] az eredmény."

#. DirAccess.is_equivalent
#: doc/classes/DirAccess.xml
msgid "Returns [code]true[/code] if paths [param path_a] and [param path_b] resolve to the same file system object. Returns [code]false[/code] otherwise, even if the files are bit-for-bit identical (e.g., identical copies of the file that are not symbolic links)."
msgstr "[code]true[/code] értéket ad vissza, ha a [param path_a] és a [param path_b] ugyanarra a fájlrendszerbeli objektumra mutat. Egyébként [code]false[/code] az eredmény akkor is, ha a fájlok bitről bitre megegyeznek (például ha egymás pontos másolatai, és egyik sem szimbolikus hivatkozás)."

#. DirAccess.is_link
#: doc/classes/DirAccess.xml
msgid "Returns [code]true[/code] if the file or directory is a symbolic link, directory junction, or other reparse point.\n[b]Note:[/b] This method is implemented on macOS, Linux, and Windows."
msgstr "[code]true[/code] értéket ad vissza, ha a fájl vagy mappa szimbolikus hivatkozás, mappacsatolás (junction) vagy más újraelemzési pont.\n[b]Megjegyzés:[/b] A metódus macOS-en, Linuxon és Windowson érhető el."

#. DirAccess.list_dir_begin
#: doc/classes/DirAccess.xml
msgid "Initializes the stream used to list all files and directories using the [method get_next] function, closing the currently opened stream if needed. Once the stream has been processed, it should typically be closed with [method list_dir_end].\nAffected by [member include_hidden] and [member include_navigational].\n[b]Note:[/b] The order of files and directories returned by this method is not deterministic, and can vary between operating systems. If you want a list of all files or folders sorted alphabetically, use [method get_files] or [method get_directories]."
msgstr "Elindítja a mappa fájljainak és almappáinak felsorolását. Az elemeket a [method get_next] függvénnyel kérheted le. Szükség esetén lezárja a korábban megnyitott bejárást. A lista feldolgozása után a bejárást általában a [method list_dir_end] metódussal érdemes lezárni.\nA [member include_hidden] és a [member include_navigational] beállítás befolyásolja az eredményt.\n[b]Megjegyzés:[/b] A metódus nem garantálja az elemek sorrendjét, amely operációs rendszerenként eltérhet. Betűrendbe állított listához használd a [method get_files] vagy a [method get_directories] metódust."

#. DirAccess.list_dir_end
#: doc/classes/DirAccess.xml
msgid "Closes the current stream opened with [method list_dir_begin] (whether it has been fully processed with [method get_next] does not matter)."
msgstr "Lezárja a [method list_dir_begin] hívásával megnyitott bejárást akkor is, ha a [method get_next] metódussal még nem olvastad ki az összes elemet."

#. DirAccess.make_dir
#: doc/classes/DirAccess.xml
msgid "Creates a directory. The argument can be relative to the current directory, or an absolute path. The target directory should be placed in an already existing directory (to create the full path recursively, see [method make_dir_recursive]).\nReturns one of the [enum Error] code constants ([constant OK] on success)."
msgstr "Mappát hoz létre. Az argumentum az aktuális mappához viszonyított vagy abszolút útvonal lehet. A célmappa szülőmappájának már léteznie kell. A teljes útvonal rekurzív létrehozásához használd a [method make_dir_recursive] metódust.\nAz [enum Error] valamelyik hibakódját adja vissza (siker esetén [constant OK])."

#. DirAccess.make_dir_absolute
#: doc/classes/DirAccess.xml
msgid "Static version of [method make_dir]. Supports only absolute paths."
msgstr "A [method make_dir] statikus változata. Csak abszolút útvonalakat támogat."

#. DirAccess.make_dir_recursive
#: doc/classes/DirAccess.xml
msgid "Creates a target directory and all necessary intermediate directories in its path, by calling [method make_dir] recursively. The argument can be relative to the current directory, or an absolute path.\nReturns one of the [enum Error] code constants ([constant OK] on success)."
msgstr "A [method make_dir] ismételt hívásával létrehozza a célmappát és az útvonalához szükséges összes köztes mappát. Az argumentum az aktuális mappához viszonyított vagy abszolút útvonal lehet.\nAz [enum Error] valamelyik hibakódját adja vissza (siker esetén [constant OK])."

#. DirAccess.make_dir_recursive_absolute
#: doc/classes/DirAccess.xml
msgid "Static version of [method make_dir_recursive]. Supports only absolute paths."
msgstr "A [method make_dir_recursive] statikus változata. Csak abszolút útvonalakat támogat."

#. DirAccess.open
#: doc/classes/DirAccess.xml
msgid "Creates a new [DirAccess] object and opens an existing directory of the filesystem. The [param path] argument can be within the project tree ([code]res://folder[/code]), the user directory ([code]user://folder[/code]) or an absolute path of the user filesystem (e.g. [code]/tmp/folder[/code] or [code]C:\\tmp\\folder[/code]).\nReturns [code]null[/code] if opening the directory failed. You can use [method get_open_error] to check the error that occurred."
msgstr "Új [DirAccess] objektumot hoz létre, és megnyitja a fájlrendszer egyik létező mappáját. A [param path] a projekten belüli útvonal ([code]res://folder[/code]), a felhasználói mappán belüli útvonal ([code]user://folder[/code]) vagy a felhasználó fájlrendszerének abszolút útvonala (például [code]/tmp/folder[/code] vagy [code]C:\\tmp\\folder[/code]) lehet.\nHa a mappa megnyitása sikertelen, [code]null[/code] értéket ad vissza. A hibakódot a [method get_open_error] metódussal kérheted le."

#. DirAccess.read_link
#: doc/classes/DirAccess.xml
msgid "Returns target of the symbolic link.\n[b]Note:[/b] This method is implemented on macOS, Linux, and Windows."
msgstr "Visszaadja a szimbolikus hivatkozás célját.\n[b]Megjegyzés:[/b] A metódus macOS-en, Linuxon és Windowson érhető el."

#. DirAccess.remove
#: doc/classes/DirAccess.xml
msgid "Permanently deletes the target file or an empty directory. The argument can be relative to the current directory, or an absolute path. If the target directory is not empty, the operation will fail.\nIf you don't want to delete the file/directory permanently, use [method OS.move_to_trash] instead.\nReturns one of the [enum Error] code constants ([constant OK] on success)."
msgstr "Véglegesen törli a célfájlt vagy az üres célmappát. Az argumentum az aktuális mappához viszonyított vagy abszolút útvonal lehet. Ha a célmappa nem üres, a művelet sikertelen.\nHa a fájlt vagy mappát a lomtárba szeretnéd helyezni, használd a [method OS.move_to_trash] metódust.\nAz [enum Error] valamelyik hibakódját adja vissza (siker esetén [constant OK])."

#. DirAccess.remove_absolute
#: doc/classes/DirAccess.xml
msgid "Static version of [method remove]. Supports only absolute paths."
msgstr "A [method remove] statikus változata. Csak abszolút útvonalakat támogat."

#. DirAccess.rename
#: doc/classes/DirAccess.xml
msgid "Renames (move) the [param from] file or directory to the [param to] destination. Both arguments should be paths to files or directories, either relative or absolute. If the destination file or directory exists and is not access-protected, it will be overwritten.\nReturns one of the [enum Error] code constants ([constant OK] on success)."
msgstr "Átnevezi vagy áthelyezi a [param from] fájlt vagy mappát a [param to] célhelyre. Mindkét argumentum relatív vagy abszolút fájl- vagy mappaútvonal lehet. Ha a célfájl vagy célmappa létezik, és a hozzáférése nincs korlátozva, a metódus felülírja.\nAz [enum Error] valamelyik hibakódját adja vissza (siker esetén [constant OK])."

#. DirAccess.rename_absolute
#: doc/classes/DirAccess.xml
msgid "Static version of [method rename]. Supports only absolute paths."
msgstr "A [method rename] statikus változata. Csak abszolút útvonalakat támogat."

#. DirAccess.include_hidden
#: doc/classes/DirAccess.xml
msgid "If [code]true[/code], hidden files are included when navigating the directory.\nAffects [method list_dir_begin], [method get_directories] and [method get_files]."
msgstr "Ha az értéke [code]true[/code], a bejárás a rejtett fájlokat is felsorolja.\nA [method list_dir_begin], a [method get_directories] és a [method get_files] eredményére hat."

#. DirAccess.include_navigational
#: doc/classes/DirAccess.xml
msgid "If [code]true[/code], [code].[/code] and [code]..[/code] are included when navigating the directory.\nAffects [method list_dir_begin] and [method get_directories]."
msgstr "Ha az értéke [code]true[/code], a bejárás a [code].[/code] és a [code]..[/code] bejegyzést is felsorolja.\nA [method list_dir_begin] és a [method get_directories] eredményére hat."

#. DirAccess.get_files_at
#: doc/classes/DirAccess.xml
msgid "Returns a [PackedStringArray] containing filenames of the directory contents, excluding directories, at the given [param path]. The array is sorted alphabetically.\nUse [method get_files] if you want more control of what gets included.\n[b]Note:[/b] When used on a [code]res://[/code] path in an exported project, only the files included in the PCK at the given folder level are returned. In practice, this means that since imported resources are stored in a top-level [code].godot/[/code] folder, only paths to [code].gd[/code] and [code].import[/code] files are returned (plus a few other files, such as [code]project.godot[/code] or [code]project.binary[/code] and the project icon). In an exported project, the list of returned files will also vary depending on [member ProjectSettings.editor/export/convert_text_resources_to_binary]."
msgstr "Betűrendbe állított [PackedStringArray] tömbben adja vissza a megadott [param path] mappában található fájlok nevét. A mappák nem szerepelnek a tömbben.\nHa szabályozni szeretnéd, mely fájlok kerüljenek a tömbbe, használd a [method get_files] metódust.\n[b]Megjegyzés:[/b] Exportált projektben [code]res://[/code] kezdetű útvonalon csak a PCK-csomag adott mappájában szereplő fájlokat adja vissza. Az importált erőforrások a legfelső szintű [code].godot/[/code] mappában vannak, így a gyakorlatban csak a [code].gd[/code] és [code].import[/code] kiterjesztésű fájlok útvonalait kapod meg, néhány egyéb fájl, például a [code]project.godot[/code] vagy a [code]project.binary[/code] és a projektikon mellett. Exportált projektben a lista a [member ProjectSettings.editor/export/convert_text_resources_to_binary] beállítástól is függ."

#. FileAccess.brief
#: doc/classes/FileAccess.xml
msgid "Provides methods for file reading and writing operations."
msgstr "Metódusokat biztosít fájlok olvasásához és írásához."

#. FileAccess.description
#: doc/classes/FileAccess.xml
msgid "This class can be used to permanently store data in the user device's file system and to read from it. This is useful for storing game save data or player configuration files.\n[b]Example:[/b] How to write and read from a file. The file named [code]\"save_game.dat\"[/code] will be stored in the user data folder, as specified in the [url=$DOCS_URL/tutorials/io/data_paths.html]Data paths[/url] documentation:\n[codeblocks]\n[gdscript]\nfunc save_to_file(content):\n\tvar file = FileAccess.open(\"user://save_game.dat\", FileAccess.WRITE)\n\tfile.store_string(content)\n\nfunc load_from_file():\n\tvar file = FileAccess.open(\"user://save_game.dat\", FileAccess.READ)\n\tvar content = file.get_as_text()\n\treturn content\n[/gdscript]\n[csharp]\npublic void SaveToFile(string content)\n{\n\tusing var file = FileAccess.Open(\"user://save_game.dat\", FileAccess.ModeFlags.Write);\n\tfile.StoreString(content);\n}\n\npublic string LoadFromFile()\n{\n\tusing var file = FileAccess.Open(\"user://save_game.dat\", FileAccess.ModeFlags.Read);\n\tstring content = file.GetAsText();\n\treturn content;\n}\n[/csharp]\n[/codeblocks]\nA [FileAccess] instance has its own file cursor, which is the position in bytes in the file where the next read/write operation will occur. Functions such as [method get_8], [method get_16], [method store_8], and [method store_16] will move the file cursor forward by the number of bytes read/written. The file cursor can be moved to a specific position using [method seek] or [method seek_end], and its position can be retrieved using [method get_position].\nA [FileAccess] instance will close its file when the instance is freed. Since it inherits [RefCounted], this happens automatically when it is no longer in use. [method close] can be called to close it earlier. In C#, the reference must be disposed manually, which can be done with the [code]using[/code] statement or by calling the [code]Dispose[/code] method directly.\n[b]Note:[/b] To access project resources once exported, it is recommended to use [ResourceLoader] instead of [FileAccess], as some files are converted to engine-specific formats and their original source files might not be present in the exported PCK package. If using [FileAccess], make sure the file is included in the export by changing its import mode to [b]Keep File (exported as is)[/b] in the Import dock, or, for files where this option is not available, change the non-resource export filter in the Export dialog to include the file's extension (e.g. [code]*.txt[/code]).\n[b]Note:[/b] Files are automatically closed only if the process exits \"normally\" (such as by clicking the window manager's close button or pressing [kbd]Alt + F4[/kbd]). If you stop the project execution by pressing [kbd]F8[/kbd] while the project is running, the file won't be closed as the game process will be killed. You can work around this by calling [method flush] at regular intervals."
msgstr "Ezzel az osztállyal tartósan tárolhatsz és visszaolvashatsz adatokat a felhasználó eszközének fájlrendszerében. Így mentheted például a játékállást vagy a játékos beállításait.\n[b]Példa:[/b] Fájl írása és visszaolvasása. A [code]\"save_game.dat\"[/code] nevű fájl a felhasználói adatmappába kerül, amelyről az [url=$DOCS_URL/tutorials/io/data_paths.html]Adatútvonalak[/url] dokumentációban olvashatsz:\n[codeblocks]\n[gdscript]\nfunc save_to_file(content):\n\tvar file = FileAccess.open(\"user://save_game.dat\", FileAccess.WRITE)\n\tfile.store_string(content)\n\nfunc load_from_file():\n\tvar file = FileAccess.open(\"user://save_game.dat\", FileAccess.READ)\n\tvar content = file.get_as_text()\n\treturn content\n[/gdscript]\n[csharp]\npublic void SaveToFile(string content)\n{\n\tusing var file = FileAccess.Open(\"user://save_game.dat\", FileAccess.ModeFlags.Write);\n\tfile.StoreString(content);\n}\n\npublic string LoadFromFile()\n{\n\tusing var file = FileAccess.Open(\"user://save_game.dat\", FileAccess.ModeFlags.Read);\n\tstring content = file.GetAsText();\n\treturn content;\n}\n[/csharp]\n[/codeblocks]\nMinden [FileAccess] példányhoz külön fájlpozíció tartozik. Ez bájtban adja meg, hol kezdődik a következő olvasás vagy írás. A [method get_8], [method get_16], [method store_8] és [method store_16] metódus az olvasott vagy írt bájtok számával lépteti előre a fájlpozíciót. Adott helyre a [method seek] vagy a [method seek_end] metódussal ugorhatsz, a jelenlegi pozíciót pedig a [method get_position] metódussal kérheted le.\nA [FileAccess] példány a felszabadításakor bezárja a fájlt. Mivel a [RefCounted] osztályból származik, ez automatikusan megtörténik, ha már nincs rá hivatkozás. Ha hamarabb szeretnéd bezárni a fájlt, hívd meg a [method close] metódust. C#-ban az erőforrást külön fel kell szabadítani a [code]using[/code] utasítással vagy a [code]Dispose[/code] metódus közvetlen hívásával.\n[b]Megjegyzés:[/b] Exportálás után a projekt erőforrásait érdemes a [ResourceLoader] használatával elérni a [FileAccess] helyett. A motor néhány fájlt saját formátumára alakít, így az eredeti forrásfájl hiányozhat az exportált PCK-csomagból. Ha [FileAccess] segítségével olvasol egy fájlt, az Importálás dokkban válaszd a [b]Fájl megtartása (exportálás változtatás nélkül)[/b] importálási módot. Azoknál a fájltípusoknál, ahol ez a lehetőség nem érhető el, vedd fel a kiterjesztést (például [code]*.txt[/code]) az Exportálás ablak nem erőforrásfájlokra vonatkozó szűrőjébe.\n[b]Megjegyzés:[/b] A fájlok csak szabályos kilépéskor záródnak be automatikusan, például az ablak bezárásakor vagy az [kbd]Alt + F4[/kbd] megnyomásakor. Ha futás közben az [kbd]F8[/kbd] billentyűvel állítod le a projektet, a játékfolyamat kényszerített leállítása miatt a fájl szabályos bezárása elmarad. Az addig írt adatok megőrzéséhez rendszeresen meghívhatod a [method flush] metódust."

#. FileAccess.close
#: doc/classes/FileAccess.xml
msgid "Closes the currently opened file and prevents subsequent read/write operations. Use [method flush] to persist the data to disk without closing the file.\n[b]Note:[/b] [FileAccess] will automatically close when it's freed, which happens when it goes out of scope or when it gets assigned with [code]null[/code]. In C# the reference must be disposed after we are done using it, this can be done with the [code]using[/code] statement or calling the [code]Dispose[/code] method directly."
msgstr "Bezárja az éppen megnyitott fájlt, így azon további olvasás vagy írás nem végezhető. Ha a fájl bezárása nélkül szeretnéd lemezre írni az adatokat, használd a [method flush] metódust.\n[b]Megjegyzés:[/b] A [FileAccess] felszabadításakor automatikusan bezárja a fájlt. Ez például akkor történik meg, ha az utolsó hivatkozás kikerül a hatókörből, vagy [code]null[/code] értéket kap. C#-ban használat után fel kell szabadítani az erőforrást a [code]using[/code] utasítással vagy a [code]Dispose[/code] metódus közvetlen hívásával."

#. FileAccess.create_temp
#: doc/classes/FileAccess.xml
msgid "Creates a temporary file. This file will be freed when the returned [FileAccess] is freed.\nIf [param prefix] is not empty, it will be prefixed to the file name, separated by a [code]-[/code].\nIf [param extension] is not empty, it will be appended to the temporary file name.\nIf [param keep] is [code]true[/code], the file is not deleted when the returned [FileAccess] is freed.\nReturns [code]null[/code] if opening the file failed. You can use [method get_open_error] to check the error that occurred."
msgstr "Ideiglenes fájlt hoz létre. A fájl a visszaadott [FileAccess] felszabadításakor törlődik.\nHa a [param prefix] nem üres, az előtag a fájlnevet megelőzve, [code]-[/code] jellel elválasztva jelenik meg.\nHa a [param extension] nem üres, a kiterjesztés az ideiglenes fájl nevének végére kerül.\nHa a [param keep] értéke [code]true[/code], a visszaadott [FileAccess] felszabadításakor a fájl megmarad.\nHa a fájl megnyitása sikertelen, [code]null[/code] értéket ad vissza. A hibakódot a [method get_open_error] metódussal kérheted le."

#. FileAccess.eof_reached
#: doc/classes/FileAccess.xml
msgid "Returns [code]true[/code] if the file cursor has already read past the end of the file.\n[b]Note:[/b] [code]eof_reached() == false[/code] cannot be used to check whether there is more data available. To loop while there is more data available, use:\n[codeblocks]\n[gdscript]\nwhile file.get_position() < file.get_length():\n\t# Read data\n[/gdscript]\n[csharp]\nwhile (file.GetPosition() < file.GetLength())\n{\n\t// Read data\n}\n[/csharp]\n[/codeblocks]"
msgstr "[code]true[/code] értéket ad vissza, ha az olvasás már túllépte a fájl végét.\n[b]Megjegyzés:[/b] Az [code]eof_reached() == false[/code] feltétel önmagában nem jelzi, hogy van-e még olvasható adat. Az olvasási ciklust így tarthatod fenn, amíg van adat:\n[codeblocks]\n[gdscript]\nwhile file.get_position() < file.get_length():\n\t# Read data\n[/gdscript]\n[csharp]\nwhile (file.GetPosition() < file.GetLength())\n{\n\t// Read data\n}\n[/csharp]\n[/codeblocks]"

#. FileAccess.file_exists
#: doc/classes/FileAccess.xml
msgid "Returns [code]true[/code] if the file exists in the given path.\n[b]Note:[/b] Many resources types are imported (e.g. textures or sound files), and their source asset will not be included in the exported game, as only the imported version is used. See [method ResourceLoader.exists] for an alternative approach that takes resource remapping into account.\nFor a non-static, relative equivalent, use [method DirAccess.file_exists]."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott útvonalon létezik a fájl.\n[b]Megjegyzés:[/b] A Godot számos erőforrástípust importál, például textúrákat és hangfájlokat. Az exportált játék csak az importált változatot használja, ezért az eredeti fájl nem kerül bele. A [method ResourceLoader.exists] az exportált erőforrások átirányított útvonalát is figyelembe veszi.\nHa példánymetódusra van szükséged, amely relatív útvonalat is elfogad, használd a [method DirAccess.file_exists] metódust."

#. FileAccess.flush
#: doc/classes/FileAccess.xml
msgid "Writes the file's buffer to disk. Flushing is automatically performed when the file is closed. This means you don't need to call [method flush] manually before closing a file. Still, calling [method flush] can be used to ensure the data is safe even if the project crashes instead of being closed gracefully.\n[b]Note:[/b] Only call [method flush] when you actually need it. Otherwise, it will decrease performance due to constant disk writes."
msgstr "Lemezre írja a fájl pufferét. Bezáráskor ez automatikusan megtörténik, ezért nem kell előtte kézzel meghívnod a [method flush] metódust. Ha azonban a projekt szabályos bezárás helyett összeomlik, a korábban meghívott [method flush] gondoskodik róla, hogy az addigi adatok lemezen legyenek.\n[b]Megjegyzés:[/b] Csak akkor hívd meg a [method flush] metódust, amikor szükséged van rá. A folyamatos lemezírás rontja a teljesítményt."

#. FileAccess.get_csv_line
#: doc/classes/FileAccess.xml
msgid "Returns the next value of the file in CSV (Comma-Separated Values) format. You can pass a different delimiter [param delim] to use other than the default [code]\",\"[/code] (comma). This delimiter must be one-character long, and cannot be a double quotation mark.\nText is interpreted as being UTF-8 encoded. Text values must be enclosed in double quotes if they include the delimiter character. Double quotes within a text value can be escaped by doubling their occurrence. This advances the file cursor to after the newline character at the end of the line.\nFor example, the following CSV lines are valid and will be properly parsed as two strings each:\n[codeblock lang=text]\nAlice,\"Hello, Bob!\"\nBob,Alice! What a surprise!\nAlice,\"I thought you'd reply with \"\"Hello, world\"\".\"\n[/codeblock]\nNote how the second line can omit the enclosing quotes as it does not include the delimiter. However it [i]could[/i] very well use quotes, it was only written without for demonstration purposes. The third line must use [code]\"\"[/code] for each quotation mark that needs to be interpreted as such instead of the end of a text value."
msgstr "CSV-formátumban (vesszővel elválasztott értékekként) beolvassa a fájl következő sorát. Az alapértelmezett [code]\",\"[/code] (vessző) helyett a [param delim] paraméterben más elválasztót is megadhatsz. Az elválasztó egyetlen karakter lehet, és nem lehet dupla idézőjel.\nA szöveget UTF-8 kódolásúként olvassa be. Ha egy mező tartalmazza az elválasztó karaktert, a mezőt dupla idézőjelek közé kell tenni. A mezőn belüli dupla idézőjelet két egymást követő dupla idézőjellel adhatod meg. A fájlpozíció a sort lezáró újsorjel mögé kerül.\nAz alábbi CSV-sorok mind érvényesek. Mindegyikből két sztringet olvas be a metódus:\n[codeblock lang=text]\nAlice,\"Hello, Bob!\"\nBob,Alice! What a surprise!\nAlice,\"I thought you'd reply with \"\"Hello, world\"\".\"\n[/codeblock]\nA második sorban elhagyhatók a határoló idézőjelek, mert az értékek nem tartalmazzák az elválasztót. A sor [i]lehetne[/i] idézőjelek között is, a példa csak az elhagyás lehetőségét mutatja. A harmadik sorban minden olyan idézőjelet [code]\"\"[/code] alakban kell írni, amely az érték része, és nem a mezőt zárja le."

#. FileAccess.get_extended_attribute
#: doc/classes/FileAccess.xml
msgid "Reads the file extended attribute with name [param attribute_name] as a byte array.\n[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n[b]Note:[/b] Extended attributes support depends on the file system. Attributes will be lost when the file is moved between incompatible file systems.\n[b]Note:[/b] On Linux, only \"user\" namespace attributes are accessible, namespace prefix should not be included.\n[b]Note:[/b] On Windows, alternate data streams are used to store extended attributes."
msgstr "Bájttömbként olvassa be a [param attribute_name] nevű kiterjesztett fájlattribútumot.\n[b]Megjegyzés:[/b] A metódus Linuxon, macOS-en és Windowson érhető el.\n[b]Megjegyzés:[/b] A kiterjesztett attribútumok támogatása a fájlrendszertől függ. Ha a fájlt nem kompatibilis fájlrendszerre helyezed át, az attribútumok elvesznek.\n[b]Megjegyzés:[/b] Linuxon csak a „user” névtér attribútumai érhetők el. A névtér előtagját el kell hagyni.\n[b]Megjegyzés:[/b] Windows a kiterjesztett attribútumokat alternatív adatfolyamokban tárolja."

#. FileAccess.get_extended_attribute_string
#: doc/classes/FileAccess.xml
msgid "Reads the file extended attribute with name [param attribute_name] as a UTF-8 encoded string.\n[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n[b]Note:[/b] Extended attributes support depends on the file system. Attributes will be lost when the file is moved between incompatible file systems.\n[b]Note:[/b] On Linux, only \"user\" namespace attributes are accessible, namespace prefix should not be included.\n[b]Note:[/b] On Windows, alternate data streams are used to store extended attributes."
msgstr "UTF-8 kódolású sztringként olvassa be a [param attribute_name] nevű kiterjesztett fájlattribútumot.\n[b]Megjegyzés:[/b] A metódus Linuxon, macOS-en és Windowson érhető el.\n[b]Megjegyzés:[/b] A kiterjesztett attribútumok támogatása a fájlrendszertől függ. Ha a fájlt nem kompatibilis fájlrendszerre helyezed át, az attribútumok elvesznek.\n[b]Megjegyzés:[/b] Linuxon csak a „user” névtér attribútumai érhetők el. A névtér előtagját el kell hagyni.\n[b]Megjegyzés:[/b] Windows a kiterjesztett attribútumokat alternatív adatfolyamokban tárolja."

#. FileAccess.get_extended_attributes_list
#: doc/classes/FileAccess.xml
msgid "Returns a list of file extended attributes.\n[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n[b]Note:[/b] Extended attributes support depends on the file system. Attributes will be lost when the file is moved between incompatible file systems.\n[b]Note:[/b] On Linux, only \"user\" namespace attributes are accessible, namespace prefix should not be included.\n[b]Note:[/b] On Windows, alternate data streams are used to store extended attributes."
msgstr "Felsorolja a fájl kiterjesztett attribútumait.\n[b]Megjegyzés:[/b] A metódus Linuxon, macOS-en és Windowson érhető el.\n[b]Megjegyzés:[/b] A kiterjesztett attribútumok támogatása a fájlrendszertől függ. Ha a fájlt nem kompatibilis fájlrendszerre helyezed át, az attribútumok elvesznek.\n[b]Megjegyzés:[/b] Linuxon csak a „user” névtér attribútumai érhetők el. A névtér előtagját el kell hagyni.\n[b]Megjegyzés:[/b] Windows a kiterjesztett attribútumokat alternatív adatfolyamokban tárolja."

#. FileAccess.get_line
#: doc/classes/FileAccess.xml
msgid "Returns the next line of the file as a [String]. The returned string doesn't include newline ([code]\\n[/code]) or carriage return ([code]\\r[/code]) characters, but does include any other leading or trailing whitespace. This advances the file cursor to after the newline character at the end of the line.\nText is interpreted as being UTF-8 encoded."
msgstr "A fájl következő sorát [String] értékként adja vissza. Az újsor ([code]\\n[/code]) és a kocsivissza ([code]\\r[/code]) karaktert elhagyja, a többi kezdő és záró térközkaraktert megőrzi. A fájlpozíciót a sort lezáró újsorjel mögé állítja.\nA szöveget UTF-8 kódolásúként olvassa be."

#. FileAccess.get_real
#: doc/classes/FileAccess.xml
msgid "Returns the next bits from the file as a floating-point number. This advances the file cursor by either 4 or 8 bytes, depending on the precision used by the Godot build that saved the file.\nIf the file was saved by a Godot build compiled with the [code]precision=single[/code] option (the default), the number of read bits for that file is 32. Otherwise, if compiled with the [code]precision=double[/code] option, the number of read bits is 64."
msgstr "A fájl aktuális pozíciójáról lebegőpontos számot olvas be. A fájlpozíció 4 vagy 8 bájttal lép előre attól függően, hogy a fájlt mentő Godot-verzió milyen pontosságot használt.\nHa a fájlt mentő Godot a [code]precision=single[/code] beállítással készült (ez az alapértelmezés), a metódus 32 bitet olvas. A [code]precision=double[/code] beállítással készült Godot által mentett fájlból 64 bitet olvas."

#. FileAccess.get_var
#: doc/classes/FileAccess.xml
msgid "Returns the next [Variant] value from the file. If [param allow_objects] is [code]true[/code], decoding objects is allowed. This advances the file cursor by the number of bytes read.\nInternally, this uses the same decoding mechanism as the [method @GlobalScope.bytes_to_var] method, as described in the [url=$DOCS_URL/tutorials/io/binary_serialization_api.html]Binary serialization API[/url] documentation.\n[b]Warning:[/b] Deserialized objects can contain code which gets executed. Do not use this option if the serialized object comes from untrusted sources to avoid potential security threats such as remote code execution."
msgstr "A fájl következő [Variant] értékét adja vissza. Ha a [param allow_objects] értéke [code]true[/code], az objektumok visszaállítása is engedélyezett. A fájlpozíció az olvasott bájtok számával lép előre.\nA metódus belsőleg ugyanazt a dekódolást használja, mint a [method @GlobalScope.bytes_to_var]. A részleteket a [url=$DOCS_URL/tutorials/io/binary_serialization_api.html]bináris szerializálási API[/url] dokumentációja ismerteti.\n[b]Figyelmeztetés:[/b] A visszaállított objektumok futtatható kódot tartalmazhatnak, amely végre is hajtódhat. Ha az objektum nem megbízható forrásból származik, ne kapcsold be ezt a beállítást, mert például távoli kódfuttatást tehet lehetővé."

#. FileAccess.open_compressed
#: doc/classes/FileAccess.xml
msgid "Creates a new [FileAccess] object and opens a compressed file for reading or writing.\n[b]Note:[/b] [method open_compressed] can only read files that were saved by Godot, not third-party compression formats. See [url=https://github.com/godotengine/godot/issues/28999]GitHub issue #28999[/url] for a workaround.\nReturns [code]null[/code] if opening the file failed. You can use [method get_open_error] to check the error that occurred."
msgstr "Új [FileAccess] objektumot hoz létre, és olvasásra vagy írásra megnyit egy tömörített fájlt.\n[b]Megjegyzés:[/b] A [method open_compressed] csak a Godot által mentett fájlokat tudja olvasni. Más eszközökkel készült tömörített fájlokhoz a [url=https://github.com/godotengine/godot/issues/28999]#28999-es GitHub-hibajegy[/url] mutat kerülő megoldást.\nHa a fájl megnyitása sikertelen, [code]null[/code] értéket ad vissza. A hibakódot a [method get_open_error] metódussal kérheted le."

#. FileAccess.open_encrypted
#: doc/classes/FileAccess.xml
msgid "Creates a new [FileAccess] object and opens an encrypted file in write or read mode. You need to pass a binary key to encrypt/decrypt it.\n[b]Note:[/b] The provided key must be 32 bytes long.\nReturns [code]null[/code] if opening the file failed. You can use [method get_open_error] to check the error that occurred."
msgstr "Új [FileAccess] objektumot hoz létre, és írásra vagy olvasásra megnyit egy titkosított fájlt. A titkosításhoz vagy visszafejtéshez bináris kulcsot kell megadnod.\n[b]Megjegyzés:[/b] A megadott kulcsnak 32 bájt hosszúnak kell lennie.\nHa a fájl megnyitása sikertelen, [code]null[/code] értéket ad vissza. A hibakódot a [method get_open_error] metódussal kérheted le."

#. FileAccess.remove_extended_attribute
#: doc/classes/FileAccess.xml
msgid "Removes file extended attribute with name [param attribute_name].\n[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n[b]Note:[/b] Extended attributes support depends on the file system. Attributes will be lost when the file is moved between incompatible file systems.\n[b]Note:[/b] On Linux, only \"user\" namespace attributes are accessible, namespace prefix should not be included.\n[b]Note:[/b] On Windows, alternate data streams are used to store extended attributes."
msgstr "Eltávolítja a [param attribute_name] nevű kiterjesztett fájlattribútumot.\n[b]Megjegyzés:[/b] A metódus Linuxon, macOS-en és Windowson érhető el.\n[b]Megjegyzés:[/b] A kiterjesztett attribútumok támogatása a fájlrendszertől függ. Ha a fájlt nem kompatibilis fájlrendszerre helyezed át, az attribútumok elvesznek.\n[b]Megjegyzés:[/b] Linuxon csak a „user” névtér attribútumai érhetők el. A névtér előtagját el kell hagyni.\n[b]Megjegyzés:[/b] Windows a kiterjesztett attribútumokat alternatív adatfolyamokban tárolja."

#. FileAccess.set_extended_attribute
#: doc/classes/FileAccess.xml
msgid "Writes file extended attribute with name [param attribute_name] as a byte array.\n[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n[b]Note:[/b] Extended attributes support depends on the file system. Attributes will be lost when the file is moved between incompatible file systems.\n[b]Note:[/b] On Linux, only \"user\" namespace attributes are accessible, namespace prefix should not be included.\n[b]Note:[/b] On Windows, alternate data streams are used to store extended attributes."
msgstr "A [param attribute_name] nevű kiterjesztett fájlattribútum értékét bájttömbként írja ki.\n[b]Megjegyzés:[/b] A metódus Linuxon, macOS-en és Windowson érhető el.\n[b]Megjegyzés:[/b] A kiterjesztett attribútumok támogatása a fájlrendszertől függ. Ha a fájlt nem kompatibilis fájlrendszerre helyezed át, az attribútumok elvesznek.\n[b]Megjegyzés:[/b] Linuxon csak a „user” névtér attribútumai érhetők el. A névtér előtagját el kell hagyni.\n[b]Megjegyzés:[/b] Windows a kiterjesztett attribútumokat alternatív adatfolyamokban tárolja."

#. FileAccess.set_extended_attribute_string
#: doc/classes/FileAccess.xml
msgid "Writes file extended attribute with name [param attribute_name] as a UTF-8 encoded string.\n[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n[b]Note:[/b] Extended attributes support depends on the file system. Attributes will be lost when the file is moved between incompatible file systems.\n[b]Note:[/b] On Linux, only \"user\" namespace attributes are accessible, namespace prefix should not be included.\n[b]Note:[/b] On Windows, alternate data streams are used to store extended attributes."
msgstr "A [param attribute_name] nevű kiterjesztett fájlattribútum értékét UTF-8 kódolású sztringként írja ki.\n[b]Megjegyzés:[/b] A metódus Linuxon, macOS-en és Windowson érhető el.\n[b]Megjegyzés:[/b] A kiterjesztett attribútumok támogatása a fájlrendszertől függ. Ha a fájlt nem kompatibilis fájlrendszerre helyezed át, az attribútumok elvesznek.\n[b]Megjegyzés:[/b] Linuxon csak a „user” névtér attribútumai érhetők el. A névtér előtagját el kell hagyni.\n[b]Megjegyzés:[/b] Windows a kiterjesztett attribútumokat alternatív adatfolyamokban tárolja."

#. FileAccess.store_8
#: doc/classes/FileAccess.xml
msgid "Stores an integer as 8 bits in the file. This advances the file cursor by 1 byte. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] The [param value] should lie in the interval [code][0, 255][/code]. Any other value will overflow and wrap around.\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate.\nTo store a signed integer, use [method store_64], or convert it manually (see [method store_16] for an example)."
msgstr "8 bites egészként írja a számot a fájlba. A fájlpozíció 1 bájttal lép előre. Siker esetén [code]true[/code] értéket ad vissza.\n[b]Megjegyzés:[/b] A [param value] értékének a [code][0, 255][/code] tartományba kell esnie. A tartományon kívüli érték túlcsordul és átfordul.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott.\nElőjeles egész számhoz használd a [method store_64] metódust, vagy végezd el kézzel az átalakítást (példa a [method store_16] leírásában)."

#. FileAccess.store_16
#: doc/classes/FileAccess.xml
msgid "Stores an integer as 16 bits in the file. This advances the file cursor by 2 bytes. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] The [param value] should lie in the interval [code][0, 2^16 - 1][/code]. Any other value will overflow and wrap around.\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate.\nTo store a signed integer, use [method store_64] or store a signed integer from the interval [code][-2^15, 2^15 - 1][/code] (i.e. keeping one bit for the signedness) and compute its sign manually when reading. For example:\n[codeblocks]\n[gdscript]\nconst MAX_15B = 1 << 15\nconst MAX_16B = 1 << 16\n\nfunc unsigned16_to_signed(unsigned):\n\treturn (unsigned + MAX_15B) % MAX_16B - MAX_15B\n\nfunc _ready():\n\tvar f = FileAccess.open(\"user://file.dat\", FileAccess.WRITE_READ)\n\tf.store_16(-42) # This wraps around and stores 65494 (2^16 - 42).\n\tf.store_16(121) # In bounds, will store 121.\n\tf.seek(0) # Go back to start to read the stored value.\n\tvar read1 = f.get_16() # 65494\n\tvar read2 = f.get_16() # 121\n\tvar converted1 = unsigned16_to_signed(read1) # -42\n\tvar converted2 = unsigned16_to_signed(read2) # 121\n[/gdscript]\n[csharp]\npublic override void _Ready()\n{\n\tusing var f = FileAccess.Open(\"user://file.dat\", FileAccess.ModeFlags.WriteRead);\n\tf.Store16(unchecked((ushort)-42)); // This wraps around and stores 65494 (2^16 - 42).\n\tf.Store16(121); // In bounds, will store 121.\n\tf.Seek(0); // Go back to start to read the stored value.\n\tushort read1 = f.Get16(); // 65494\n\tushort read2 = f.Get16(); // 121\n\tshort converted1 = (short)read1; // -42\n\tshort converted2 = (short)read2; // 121\n}\n[/csharp]\n[/codeblocks]"
msgstr "16 bites egészként írja a számot a fájlba. A fájlpozíció 2 bájttal lép előre. Siker esetén [code]true[/code] értéket ad vissza.\n[b]Megjegyzés:[/b] A [param value] értékének a [code][0, 2^16 - 1][/code] tartományba kell esnie. A tartományon kívüli érték túlcsordul és átfordul.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott.\nElőjeles egész számhoz használd a [method store_64] metódust, vagy tárolj egy [code][-2^15, 2^15 - 1][/code] tartományba eső előjeles számot (egy bitet fenntartva az előjelnek), és olvasáskor kézzel állítsd vissza az előjelet. Példa:\n[codeblocks]\n[gdscript]\nconst MAX_15B = 1 << 15\nconst MAX_16B = 1 << 16\n\nfunc unsigned16_to_signed(unsigned):\n\treturn (unsigned + MAX_15B) % MAX_16B - MAX_15B\n\nfunc _ready():\n\tvar f = FileAccess.open(\"user://file.dat\", FileAccess.WRITE_READ)\n\tf.store_16(-42) # This wraps around and stores 65494 (2^16 - 42).\n\tf.store_16(121) # In bounds, will store 121.\n\tf.seek(0) # Go back to start to read the stored value.\n\tvar read1 = f.get_16() # 65494\n\tvar read2 = f.get_16() # 121\n\tvar converted1 = unsigned16_to_signed(read1) # -42\n\tvar converted2 = unsigned16_to_signed(read2) # 121\n[/gdscript]\n[csharp]\npublic override void _Ready()\n{\n\tusing var f = FileAccess.Open(\"user://file.dat\", FileAccess.ModeFlags.WriteRead);\n\tf.Store16(unchecked((ushort)-42)); // This wraps around and stores 65494 (2^16 - 42).\n\tf.Store16(121); // In bounds, will store 121.\n\tf.Seek(0); // Go back to start to read the stored value.\n\tushort read1 = f.Get16(); // 65494\n\tushort read2 = f.Get16(); // 121\n\tshort converted1 = (short)read1; // -42\n\tshort converted2 = (short)read2; // 121\n}\n[/csharp]\n[/codeblocks]"

#. FileAccess.store_32
#: doc/classes/FileAccess.xml
msgid "Stores an integer as 32 bits in the file. This advances the file cursor by 4 bytes. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] The [param value] should lie in the interval [code][0, 2^32 - 1][/code]. Any other value will overflow and wrap around.\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate.\nTo store a signed integer, use [method store_64], or convert it manually (see [method store_16] for an example)."
msgstr "32 bites egészként írja a számot a fájlba. A fájlpozíció 4 bájttal lép előre. Siker esetén [code]true[/code] értéket ad vissza.\n[b]Megjegyzés:[/b] A [param value] értékének a [code][0, 2^32 - 1][/code] tartományba kell esnie. A tartományon kívüli érték túlcsordul és átfordul.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott.\nElőjeles egész számhoz használd a [method store_64] metódust, vagy végezd el kézzel az átalakítást (példa a [method store_16] leírásában)."

#. FileAccess.store_64
#: doc/classes/FileAccess.xml
msgid "Stores an integer as 64 bits in the file. This advances the file cursor by 8 bytes. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] The [param value] must lie in the interval [code][-2^63, 2^63 - 1][/code] (i.e. be a valid [int] value).\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate."
msgstr "64 bites egészként írja a számot a fájlba. A fájlpozíció 8 bájttal lép előre. Siker esetén [code]true[/code] értéket ad vissza.\n[b]Megjegyzés:[/b] A [param value] értékének a [code][-2^63, 2^63 - 1][/code] tartományba kell esnie, vagyis érvényes [int] értéknek kell lennie.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott."

#. FileAccess.store_csv_line
#: doc/classes/FileAccess.xml
msgid "Stores the given [PackedStringArray] in the file as a line formatted in the CSV (Comma-Separated Values) format. You can pass a different delimiter [param delim] to use other than the default [code]\",\"[/code] (comma). This delimiter must be one-character long.\nText will be encoded as UTF-8. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate."
msgstr "A megadott [PackedStringArray] értéket egyetlen, elválasztóval tagolt CSV-sorként írja a fájlba. Az alapértelmezett [code]\",\"[/code] (vessző) helyett a [param delim] paraméterben más elválasztót is megadhatsz. Az elválasztónak egyetlen karakterből kell állnia.\nA szöveget UTF-8 kódolással írja ki. Siker esetén [code]true[/code] értéket ad vissza.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott."

#. FileAccess.store_line
#: doc/classes/FileAccess.xml
msgid "Stores [param line] in the file followed by a newline character ([code]\\n[/code]), encoding the text as UTF-8. This advances the file cursor by the length of the line, after the newline character. The amount of bytes written depends on the UTF-8 encoded bytes, which may be different from [method String.length] which counts the number of UTF-32 codepoints. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate."
msgstr "A [param line] értéket UTF-8 kódolással, egy lezáró újsorjellel ([code]\\n[/code]) írja a fájlba. A fájlpozíció a kiírt sor hosszával lép előre, az újsorjel utánra. A kiírt bájtok számát az UTF-8 kódolás határozza meg. Ez eltérhet a [method String.length] eredményétől, amely az UTF-32 kódpontok számát adja meg. Siker esetén [code]true[/code] értéket ad vissza.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott."

#. FileAccess.store_pascal_string
#: doc/classes/FileAccess.xml
msgid "Stores the given [String] as a line in the file in Pascal format (i.e. also store the length of the string). Text will be encoded as UTF-8. This advances the file cursor by the number of bytes written depending on the UTF-8 encoded bytes, which may be different from [method String.length] which counts the number of UTF-32 codepoints. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate."
msgstr "A megadott [String] értéket Pascal-formátumban írja a fájlba. Először a sztring UTF-8 kódolású bájtjainak hosszát tárolja 32 bites értékként, majd magukat a bájtokat. Külön újsorjelet nem ír.\n\nA fájlpozíció a kiírt bájtok számával lép előre. Ez eltérhet a [method String.length] eredményétől, amely az UTF-32-kódpontokat számolja. Siker esetén [code]true[/code] értéket ad vissza.\n\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott."

#. FileAccess.store_real
#: doc/classes/FileAccess.xml
msgid "Stores a floating-point number in the file. This advances the file cursor by either 4 or 8 bytes, depending on the precision used by the current Godot build.\nIf using a Godot build compiled with the [code]precision=single[/code] option (the default), this method will save a 32-bit float. Otherwise, if compiled with the [code]precision=double[/code] option, this will save a 64-bit float. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate."
msgstr "Lebegőpontos számot ír a fájlba. A fájlpozíció 4 vagy 8 bájttal lép előre az éppen futó Godot pontossági beállításától függően.\n[code]precision=single[/code] beállítással fordított Godot esetén (ez az alapértelmezés) a metódus 32 bites lebegőpontos számot ír. [code]precision=double[/code] esetén 64 bites lebegőpontos számot ír. Siker esetén [code]true[/code] értéket ad vissza.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott."

#. FileAccess.store_string
#: doc/classes/FileAccess.xml
msgid "Stores [param string] in the file without a newline character ([code]\\n[/code]), encoding the text as UTF-8. This advances the file cursor by the length of the string in UTF-8 encoded bytes, which may be different from [method String.length] which counts the number of UTF-32 codepoints. Returns [code]true[/code] if the operation is successful.\n[b]Note:[/b] This method is intended to be used to write text files. The string is stored as a UTF-8 encoded buffer without string length or terminating zero, which means that it can't be loaded back easily. If you want to store a retrievable string in a binary file, consider using [method store_pascal_string] instead. For retrieving strings from a text file, you can use [code]get_buffer(length).get_string_from_utf8()[/code] (if you know the length) or [method get_as_text].\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate."
msgstr "A [param string] szöveget UTF-8 kódolással, hozzáfűzött újsorjel ([code]\\n[/code]) nélkül írja a fájlba. A fájlpozíció az UTF-8 kódolású sztring bájtban mért hosszával lép előre. Ez eltérhet a [method String.length] eredményétől, amely az UTF-32 kódpontok számát adja meg. Siker esetén [code]true[/code] értéket ad vissza.\n[b]Megjegyzés:[/b] A metódus szövegfájlok írására szolgál. A sztringet UTF-8 kódolású pufferként tárolja, hosszelőtag és lezáró nullabájt nélkül, így a sztring határait visszaolvasáskor nem lehet közvetlenül megállapítani. Ha bináris fájlba írsz és később külön szeretnéd visszaolvasni a sztringet, érdemes a [method store_pascal_string] metódust használni. Szövegfájlból a [code]get_buffer(length).get_string_from_utf8()[/code] hívással (ha ismered a bájthosszt) vagy a [method get_as_text] metódussal olvashatsz be szöveget.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott."

#. FileAccess.store_var
#: doc/classes/FileAccess.xml
msgid "Stores any Variant value in the file. If [param full_objects] is [code]true[/code], encoding objects is allowed (and can potentially include code). This advances the file cursor by the number of bytes written. Returns [code]true[/code] if the operation is successful.\nInternally, this uses the same encoding mechanism as the [method @GlobalScope.var_to_bytes] method, as described in the [url=$DOCS_URL/tutorials/io/binary_serialization_api.html]Binary serialization API[/url] documentation.\n[b]Note:[/b] Not all properties are included. Only properties that are configured with the [constant PROPERTY_USAGE_STORAGE] flag set will be serialized. You can add a new usage flag to a property by overriding the [method Object._get_property_list] method in your class. You can also check how property usage is configured by calling [method Object._get_property_list]. See [enum PropertyUsageFlags] for the possible usage flags.\n[b]Note:[/b] If an error occurs, the resulting value of the file position indicator is indeterminate."
msgstr "Tetszőleges Variant értéket ír a fájlba. Ha a [param full_objects] értéke [code]true[/code], objektumokat is szerializálhat, a bennük lévő kóddal együtt. A fájlpozíció a kiírt bájtok számával lép előre. Siker esetén [code]true[/code] értéket ad vissza.\nA metódus belsőleg ugyanazt a kódolást használja, mint a [method @GlobalScope.var_to_bytes]. A részleteket a [url=$DOCS_URL/tutorials/io/binary_serialization_api.html]bináris szerializálási API[/url] dokumentációja ismerteti.\n[b]Megjegyzés:[/b] Csak a [constant PROPERTY_USAGE_STORAGE] jelzővel ellátott tulajdonságok kerülnek a szerializált adatokba. Tulajdonsághoz a [method Object._get_property_list] felülírásával adhatsz hozzá új használati jelzőt. A használati beállításokat a [method Object._get_property_list] hívásával is ellenőrizheted. A lehetséges használati jelzőket a [enum PropertyUsageFlags] sorolja fel.\n[b]Megjegyzés:[/b] Hiba esetén a fájlpozíció értéke nem meghatározott."

#. FileAccess.big_endian
#: doc/classes/FileAccess.xml
msgid "If [code]true[/code], the file is read with big-endian [url=https://en.wikipedia.org/wiki/Endianness]endianness[/url]. If [code]false[/code], the file is read with little-endian endianness. If in doubt, leave this to [code]false[/code] as most files are written with little-endian endianness.\n[b]Note:[/b] This is always reset to system endianness, which is little-endian on all supported platforms, whenever you open the file. Therefore, you must set [member big_endian] [i]after[/i] opening the file, not before."
msgstr "[code]true[/code] esetén a fájlt a legnagyobb helyi értékű bájttal kezdődő (big-endian) [url=https://en.wikipedia.org/wiki/Endianness]bájtsorrendben[/url] olvassa. [code]false[/code] esetén a legkisebb helyi értékű bájttal kezdődő (little-endian) sorrendben olvassa. Ha nem ismered a fájl bájtsorrendjét, hagyd a beállítást [code]false[/code] értéken, mert a legtöbb fájl little-endian sorrendben készül.\n[b]Megjegyzés:[/b] A fájl megnyitásakor az érték mindig visszaáll a rendszer bájtsorrendjére, amely az összes támogatott platformon little-endian. A [member big_endian] értékét ezért a fájl megnyitása [i]után[/i] állítsd be."

#. FileAccess.READ
#: doc/classes/FileAccess.xml
msgid "Opens the file for read operations. The file cursor is positioned at the beginning of the file."
msgstr "Olvasásra nyitja meg a fájlt. A fájlpozíció a fájl elejére kerül."

#. FileAccess.WRITE
#: doc/classes/FileAccess.xml
msgid "Opens the file for write operations. If the file exists, it is truncated to zero length and its contents are cleared. Otherwise, it is created.\n[b]Note:[/b] When creating a file it must be in an already existing directory. To recursively create directories for a file path, see [method DirAccess.make_dir_recursive]."
msgstr "Írásra nyitja meg a fájlt. Ha a fájl létezik, nullára csökkenti a hosszát, és törli a korábbi tartalmat. Ha még nem létezik, létrehozza.\n[b]Megjegyzés:[/b] Fájlt csak létező mappában lehet létrehozni. Az útvonal hiányzó mappáinak létrehozásához lásd a [method DirAccess.make_dir_recursive] metódust."

#. FileAccess.READ_WRITE
#: doc/classes/FileAccess.xml
msgid "Opens the file for read and write operations. Does not truncate the file. The file cursor is positioned at the beginning of the file."
msgstr "Olvasásra és írásra nyitja meg a fájlt. A meglévő tartalmat megőrzi, a fájlpozíciót a fájl elejére állítja."

#. FileAccess.WRITE_READ
#: doc/classes/FileAccess.xml
msgid "Opens the file for read and write operations. If the file exists, it is truncated to zero length and its contents are cleared. Otherwise, it is created. The file cursor is positioned at the beginning of the file.\n[b]Note:[/b] When creating a file it must be in an already existing directory. To recursively create directories for a file path, see [method DirAccess.make_dir_recursive]."
msgstr "Írásra és olvasásra nyitja meg a fájlt. Ha a fájl létezik, nullára csökkenti a hosszát, és törli a korábbi tartalmat. Ha még nem létezik, létrehozza. A fájlpozíció a fájl elejére kerül.\n[b]Megjegyzés:[/b] Fájlt csak létező mappában lehet létrehozni. Az útvonal hiányzó mappáinak létrehozásához lásd a [method DirAccess.make_dir_recursive] metódust."

#. FileAccess.COMPRESSION_FASTLZ
#: doc/classes/FileAccess.xml
msgid "Uses the [url=https://fastlz.org/]FastLZ[/url] compression method."
msgstr "A [url=https://fastlz.org/]FastLZ[/url] tömörítési eljárást használja."

#. FileAccess.COMPRESSION_DEFLATE
#: doc/classes/FileAccess.xml
msgid "Uses the [url=https://en.wikipedia.org/wiki/DEFLATE]DEFLATE[/url] compression method."
msgstr "A [url=https://en.wikipedia.org/wiki/DEFLATE]DEFLATE[/url] tömörítési eljárást használja."

#. FileAccess.COMPRESSION_ZSTD
#: doc/classes/FileAccess.xml
msgid "Uses the [url=https://facebook.github.io/zstd/]Zstandard[/url] compression method."
msgstr "A [url=https://facebook.github.io/zstd/]Zstandard[/url] tömörítési eljárást használja."

#. FileAccess.COMPRESSION_GZIP
#: doc/classes/FileAccess.xml
msgid "Uses the [url=https://www.gzip.org/]gzip[/url] compression method."
msgstr "A [url=https://www.gzip.org/]gzip[/url] tömörítési eljárást használja."

#. FileAccess.COMPRESSION_BROTLI
#: doc/classes/FileAccess.xml
msgid "Uses the [url=https://github.com/google/brotli]brotli[/url] compression method (only decompression is supported)."
msgstr "A [url=https://github.com/google/brotli]brotli[/url] tömörítési eljárást használja. Csak a kitömörítés támogatott."

#. FileAccess.UNIX_READ_OWNER
#: doc/classes/FileAccess.xml
msgid "Read for owner bit."
msgstr "A tulajdonos olvasási jogosultságának bitje."

#. FileAccess.UNIX_WRITE_OWNER
#: doc/classes/FileAccess.xml
msgid "Write for owner bit."
msgstr "A tulajdonos írási jogosultságának bitje."

#. FileAccess.UNIX_EXECUTE_OWNER
#: doc/classes/FileAccess.xml
msgid "Execute for owner bit."
msgstr "A tulajdonos futtatási jogosultságának bitje."

#. FileAccess.UNIX_READ_GROUP
#: doc/classes/FileAccess.xml
msgid "Read for group bit."
msgstr "A csoport olvasási jogosultságának bitje."

#. FileAccess.UNIX_WRITE_GROUP
#: doc/classes/FileAccess.xml
msgid "Write for group bit."
msgstr "A csoport írási jogosultságának bitje."

#. FileAccess.UNIX_EXECUTE_GROUP
#: doc/classes/FileAccess.xml
msgid "Execute for group bit."
msgstr "A csoport futtatási jogosultságának bitje."

#. FileAccess.UNIX_READ_OTHER
#: doc/classes/FileAccess.xml
msgid "Read for other bit."
msgstr "A többi felhasználó olvasási jogosultságának bitje."

#. FileAccess.UNIX_WRITE_OTHER
#: doc/classes/FileAccess.xml
msgid "Write for other bit."
msgstr "A többi felhasználó írási jogosultságának bitje."

#. FileAccess.UNIX_EXECUTE_OTHER
#: doc/classes/FileAccess.xml
msgid "Execute for other bit."
msgstr "A többi felhasználó futtatási jogosultságának bitje."

#. FileAccess.UNIX_SET_USER_ID
#: doc/classes/FileAccess.xml
msgid "Set user id on execution bit."
msgstr "A futtatáskori felhasználóazonosító beállítására szolgáló bit (setuid)."

#. FileAccess.UNIX_SET_GROUP_ID
#: doc/classes/FileAccess.xml
msgid "Set group id on execution bit."
msgstr "A futtatáskori csoportazonosító beállítására szolgáló bit (setgid)."

#. FileAccess.UNIX_RESTRICTED_DELETE
#: doc/classes/FileAccess.xml
msgid "Restricted deletion (sticky) bit."
msgstr "A törlés korlátozására szolgáló bit (sticky bit)."

#. VisualShader.brief
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A custom shader program with a visual editor."
msgstr "Egyéni shaderprogram vizuális szerkesztővel."

#. VisualShader.description
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "This class provides a graph-like visual editor for creating a [Shader]. Although [VisualShader]s do not require coding, they share the same logic with script shaders. They use [VisualShaderNode]s that can be connected to each other to control the flow of the shader. The visual shader graph is converted to a script shader behind the scenes."
msgstr "Ebben a vizuális szerkesztőben gráfból készíthetsz [Shader] erőforrást. A [VisualShader] a kódban írt shaderek logikáját követi, így kódírás nélkül állíthatod össze a műveleteket. A gráfban a [VisualShaderNode] csomópontok összekötésével adod meg az adatok útját. A motor a háttérben shaderkódot állít elő a gráfból."

#. VisualShader.add_node
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Adds the specified [param node] to the shader."
msgstr "Hozzáadja a megadott [param node] csomópontot a shaderhez."

#. VisualShader.attach_node_to_frame
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Attaches the given node to the given frame."
msgstr "A megadott kerethez csatolja a csomópontot."

#. VisualShader.can_connect_nodes
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Returns [code]true[/code] if the specified nodes and ports can be connected together."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott csomópontok portjai összekapcsolhatók."

#. VisualShader.connect_nodes
#. VisualShader.disconnect_nodes
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Connects the specified nodes and ports."
msgstr "A megadott csomópontok portjai közötti kapcsolatot kezeli. A connect_nodes létrehozza a kapcsolatot, a disconnect_nodes megszünteti."

#. VisualShader.connect_nodes_forced
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Connects the specified nodes and ports, even if they can't be connected. Such connection is invalid and will not function properly."
msgstr "A megadott portok között a szokásos ellenőrzés megkerülésével hoz létre kapcsolatot. Ha a két port nem illik össze, a kapcsolat nem működik megfelelően."

#. VisualShader.detach_node_from_frame
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Detaches the given node from the frame it is attached to."
msgstr "Leválasztja a csomópontot a keretéről."

#. VisualShader.get_node
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Returns the shader node instance with specified [param type] and [param id]."
msgstr "Visszaadja a megadott [param type] típusú és [param id] azonosítójú shadercsomópont példányát."

#. VisualShader.get_node_list
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Returns the list of all nodes in the shader with the specified type."
msgstr "Felsorolja a shader megadott szakaszához tartozó összes csomópontot."

#. VisualShader.get_node_position
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Returns the position of the specified node within the shader graph."
msgstr "Visszaadja a megadott csomópont helyét a shadergráfban."

#. VisualShader.get_valid_node_id
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Returns next valid node ID that can be added to the shader graph."
msgstr "Visszaadja azt a következő szabad azonosítót, amelyet a gráfhoz adott új csomópont kaphat."

#. VisualShader.has_varying
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Returns [code]true[/code] if the shader has a varying with the given [param name]."
msgstr "[code]true[/code] értéket ad vissza, ha a shaderben létezik a megadott [param name] nevű átadott változó."

#. VisualShader.is_node_connection
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Returns [code]true[/code] if the specified node and port connection exist."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott csomópontok portjai között létezik a kapcsolat."

#. VisualShader.remove_node
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Removes the specified node from the shader."
msgstr "Eltávolítja a megadott csomópontot a shaderből."

#. VisualShader.replace_node
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Replaces the specified node with a node of new class type."
msgstr "A megadott csomópontot egy másik osztályba tartozó csomópontra cseréli."

#. VisualShader.set_mode
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Sets the mode of this shader."
msgstr "Beállítja a shader módját."

#. VisualShader.set_node_position
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Sets the position of the specified node."
msgstr "Beállítja a megadott csomópont helyét."

#. VisualShader.TYPE_VERTEX
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A vertex shader, operating on vertices."
msgstr "Csúcspontokon futó vertexshader."

#. VisualShader.TYPE_FRAGMENT
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A fragment shader, operating on fragments (pixels)."
msgstr "A fragmenseken (képpontokon) futó fragmentshader."

#. VisualShader.TYPE_LIGHT
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A shader for light calculations."
msgstr "A megvilágítás kiszámítására szolgáló shader."

#. VisualShader.TYPE_START
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A function for the \"start\" stage of particle shader."
msgstr "A részecskeshader „start” szakaszának függvénye."

#. VisualShader.TYPE_PROCESS
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A function for the \"process\" stage of particle shader."
msgstr "A részecskeshader „process” szakaszának függvénye."

#. VisualShader.TYPE_COLLIDE
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A function for the \"collide\" stage (particle collision handler) of particle shader."
msgstr "A részecskeshader „collide” szakaszának függvénye, amely a részecskék ütközéseit kezeli."

#. VisualShader.TYPE_START_CUSTOM
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A function for the \"start\" stage of particle shader, with customized output."
msgstr "A részecskeshader „start” szakaszának függvénye, egyéni kimenettel."

#. VisualShader.TYPE_PROCESS_CUSTOM
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A function for the \"process\" stage of particle shader, with customized output."
msgstr "A részecskeshader „process” szakaszának függvénye, egyéni kimenettel."

#. VisualShader.TYPE_SKY
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A shader for 3D environment's sky."
msgstr "A 3D-s környezet egét kirajzoló shader."

#. VisualShader.TYPE_FOG
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A compute shader that runs for each froxel of the volumetric fog map."
msgstr "A térfogati köd minden cellájához (froxeléhez) lefutó számítási shader."

#. VisualShader.TYPE_TEXTURE_BLIT
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "A shader used to process blit calls to a DrawableTexture."
msgstr "A DrawableTexture textúrára irányuló képmásolási (blit) hívásokat feldolgozó shader."

#. VisualShader.VARYING_MODE_VERTEX_TO_FRAG_LIGHT
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Varying is passed from [code]Vertex[/code] function to [code]Fragment[/code] and [code]Light[/code] functions."
msgstr "Az átadott változó a [code]Vertex[/code] függvénytől a [code]Fragment[/code] és a [code]Light[/code] függvényhez jut."

#. VisualShader.VARYING_MODE_FRAG_TO_LIGHT
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Varying is passed from [code]Fragment[/code] function to [code]Light[/code] function."
msgstr "Az átadott változó a [code]Fragment[/code] függvénytől a [code]Light[/code] függvényhez jut."

#. VisualShader.VARYING_TYPE_UINT
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Varying is of type unsigned [int]."
msgstr "Az átadott változó előjel nélküli egész ([int]) típusú."

#. VisualShader.NODE_ID_INVALID
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Indicates an invalid [VisualShader] node."
msgstr "Érvénytelen [VisualShader] csomópontot jelöl."

#. VisualShader.NODE_ID_OUTPUT
#: modules/visual_shader/doc_classes/VisualShader.xml
msgid "Indicates an output node of [VisualShader]."
msgstr "A [VisualShader] kimeneti csomópontját jelöli."

#. VisualShaderNode.brief
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Base class for [VisualShader] nodes. Not related to scene nodes."
msgstr "A [VisualShader] csomópontjainak alaposztálya. A jelenet csomópontjaitól független."

#. VisualShaderNode.description
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Visual shader graphs consist of various nodes. Each node in the graph is a separate object and they are represented as a rectangular boxes with title and a set of properties. Each node also has connection ports that allow to connect it to another nodes and control the flow of the shader."
msgstr "A vizuális shadergráf különálló objektumokból, úgynevezett csomópontokból áll. A szerkesztő a csomópontokat címmel és tulajdonságokkal ellátott téglalapként jeleníti meg. A portjaikon keresztül egymáshoz kapcsolhatók, és a kapcsolatok határozzák meg az adatok útját a shaderben."

#. VisualShaderNode.clear_default_input_values
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Clears the default input ports value."
msgstr "Törli a bemeneti portok alapértelmezett értékeit."

#. VisualShaderNode.get_default_input_port
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Returns the input port which should be connected by default when this node is created as a result of dragging a connection from an existing node to the empty space on the graph."
msgstr "Visszaadja, melyik bemenetre kerüljön az új kapcsolat, ha a csomópontot úgy hozod létre, hogy egy meglévő portból a gráf üres részére húzol egy vezetéket."

#. VisualShaderNode.get_default_input_values
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Returns an [Array] containing default values for all of the input ports of the node in the form [code][index0, value0, index1, value1, ...][/code]."
msgstr "[Array] tömbben adja vissza a csomópont összes bemeneti portjának alapértelmezett értékét, [code][index0, value0, index1, value1, ...][/code] formában."

#. VisualShaderNode.get_input_port_default_value
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Returns the default value of the input [param port]."
msgstr "Visszaadja a bemeneti [param port] alapértelmezett értékét."

#. VisualShaderNode.remove_input_port_default_value
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Removes the default value of the input [param port]."
msgstr "Törli a bemeneti [param port] alapértelmezett értékét."

#. VisualShaderNode.set_default_input_values
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Sets the default input ports values using an [Array] of the form [code][index0, value0, index1, value1, ...][/code]. For example: [code][0, Vector3(0, 0, 0), 1, Vector3(0, 0, 0)][/code]."
msgstr "Beállítja a bemeneti portok alapértelmezett értékeit egy [Array] tömbből, amelynek formátuma [code][index0, value0, index1, value1, ...][/code]. Példa: [code][0, Vector3(0, 0, 0), 1, Vector3(0, 0, 0)][/code]."

#. VisualShaderNode.set_input_port_default_value
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Sets the default [param value] for the selected input [param port]."
msgstr "A kiválasztott bemeneti [param port] alapértelmezett értékét [param value] értékre állítja."

#. VisualShaderNode.linked_parent_graph_frame
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Represents the index of the frame this node is linked to. If set to [code]-1[/code] the node is not linked to any frame."
msgstr "Annak a keretnek az indexe, amelyhez ez a csomópont hozzá van csatolva. A [code]-1[/code] érték azt jelzi, hogy a csomópont nincs kerethez csatolva."

#. VisualShaderNode.output_port_for_preview
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Sets the output port index which will be showed for preview. If set to [code]-1[/code] no port will be open for preview."
msgstr "Annak a kimeneti portnak az indexe, amelynek az értéke megjelenik az előnézetben. A [code]-1[/code] érték kikapcsolja az előnézetet."

#. VisualShaderNode.PORT_TYPE_SAMPLER
#: modules/visual_shader/doc_classes/VisualShaderNode.xml
msgid "Sampler type. Translated to reference of sampler uniform in shader code. Can only be used for input ports in non-uniform nodes."
msgstr "Textúramintavételező típus. A shaderkódban egy uniform mintavételezőre hivatkozik. Csak uniformnak nem minősülő csomópontok bemeneti portján használható."

#. VisualShaderNodeBillboard.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeBillboard.xml
msgid "A node that controls how the object faces the camera to be used within the visual shader graph."
msgstr "A vizuális shadergráfban szabályozza, hogyan forduljon az objektum a kamera felé."

#. VisualShaderNodeBillboard.description
#: modules/visual_shader/doc_classes/VisualShaderNodeBillboard.xml
msgid "The output port of this node needs to be connected to [code]Model View Matrix[/code] port of [VisualShaderNodeOutput]."
msgstr "A csomópont kimeneti portját a [VisualShaderNodeOutput] [code]Model View Matrix[/code] portjához kell csatlakoztatni."

#. VisualShaderNodeBillboard.billboard_type
#: modules/visual_shader/doc_classes/VisualShaderNodeBillboard.xml
msgid "Controls how the object faces the camera."
msgstr "Szabályozza, hogyan forduljon az objektum a kamera felé."

#. VisualShaderNodeBillboard.keep_scale
#: modules/visual_shader/doc_classes/VisualShaderNodeBillboard.xml
msgid "If [code]true[/code], the shader will keep the scale set for the mesh. Otherwise, the scale is lost when billboarding."
msgstr "Ha az érték [code]true[/code], a háló megtartja a méretezését, amikor a kamera felé fordul. Egyébként a kamerához igazítás felülírja a méretezést."

#. VisualShaderNodeBillboard.BILLBOARD_TYPE_DISABLED
#: modules/visual_shader/doc_classes/VisualShaderNodeBillboard.xml
msgid "Billboarding is disabled and the node does nothing."
msgstr "A kamerához igazítás ki van kapcsolva, így a csomópontnak nincs hatása."

#. VisualShaderNodeBillboard.BILLBOARD_TYPE_ENABLED
#: modules/visual_shader/doc_classes/VisualShaderNodeBillboard.xml
msgid "A standard billboarding algorithm is enabled."
msgstr "Bekapcsolja a szokásos kamerához igazítást."

#. VisualShaderNodeBillboard.BILLBOARD_TYPE_FIXED_Y
#: modules/visual_shader/doc_classes/VisualShaderNodeBillboard.xml
msgid "A billboarding algorithm to rotate around Y-axis is enabled."
msgstr "Bekapcsolja a csak az Y tengely körüli forgatással végzett kamerához igazítást."

#. VisualShaderNodeBillboard.BILLBOARD_TYPE_PARTICLES
#: modules/visual_shader/doc_classes/VisualShaderNodeBillboard.xml
msgid "A billboarding algorithm designed to use on particles is enabled."
msgstr "Bekapcsolja a részecskékhez készült kamerához igazítást."

#. VisualShaderNodeBooleanConstant.description
#: modules/visual_shader/doc_classes/VisualShaderNodeBooleanConstant.xml
msgid "Has only one output port and no inputs.\nTranslated to [code skip-lint]bool[/code] in the shader language."
msgstr "Egyetlen kimeneti portja van, bemenete nincs.\nA shadernyelvben [code skip-lint]bool[/code] típusként jelenik meg."

