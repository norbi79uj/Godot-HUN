msgstr "A beállítások száma."

#. ChainIK3D.get_end_bone_length
#. SpringBoneSimulator3D.get_end_bone_length
#. TwoBoneIK3D.get_end_bone_length
#: doc/classes/ChainIK3D.xml doc/classes/SpringBoneSimulator3D.xml doc/classes/TwoBoneIK3D.xml
msgid "Returns the end bone tail length of the bone chain when [method is_end_bone_extended] is [code]true[/code]."
msgstr "Visszaadja a csontlánc végcsontja meghosszabbításának hosszát, ha a [method is_end_bone_extended] értéke [code]true[/code]."

#. ChainIK3D.set_end_bone_length
#. SpringBoneSimulator3D.set_end_bone_length
#: doc/classes/ChainIK3D.xml doc/classes/SpringBoneSimulator3D.xml
msgid "Sets the end bone tail length of the bone chain when [method is_end_bone_extended] is [code]true[/code]."
msgstr "Beállítja a csontlánc végcsontja meghosszabbításának hosszát, ha a [method is_end_bone_extended] értéke [code]true[/code]."

#. IterateIK3D.get_joint_rotation_axis
#. SpringBoneSimulator3D.get_joint_rotation_axis
#: doc/classes/IterateIK3D.xml doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the rotation axis at [param joint] in the bone chain's joint list."
msgstr "Visszaadja a csontlánc [param joint] indexű csuklójának forgástengelyét."

#. PhysicalBoneSimulator3D.brief
#. PhysicalBoneSimulator3D.description
#: doc/classes/PhysicalBoneSimulator3D.xml
msgid "Node that can be the parent of [PhysicalBone3D] and can apply the simulation results to [Skeleton3D]."
msgstr "[PhysicalBone3D] csomópontok szülőjeként használható csomópont, amely a szimuláció eredményét a [Skeleton3D] csontvázra alkalmazza."

#. PhysicalBoneSimulator3D.is_simulating_physics
#: doc/classes/PhysicalBoneSimulator3D.xml
msgid "Returns a boolean that indicates whether the [PhysicalBoneSimulator3D] is running and simulating."
msgstr "Logikai értéket ad vissza, amely jelzi, hogy fut-e a [PhysicalBoneSimulator3D] fizikai szimulációja."

#. SkeletonModifier3D.brief
#: doc/classes/SkeletonModifier3D.xml
msgid "A node that may modify a Skeleton3D's bones."
msgstr "A Skeleton3D csontjainak módosítására szolgáló csomópont."

#. SkeletonModifier3D._skeleton_changed
#: doc/classes/SkeletonModifier3D.xml
msgid "Called when the skeleton is changed."
msgstr "A csontváz változásakor hívódik meg."

#. SkeletonModifier3D._validate_bone_names
#: doc/classes/SkeletonModifier3D.xml
msgid "Called when bone names and indices need to be validated, such as when entering the scene tree or changing skeleton."
msgstr "Akkor hívódik meg, amikor ellenőrizni kell a csontneveket és indexeket, például a jelenetfába lépéskor vagy a csontváz cseréjekor."

#. SkeletonModifier3D.get_skeleton
#: doc/classes/SkeletonModifier3D.xml
msgid "Returns the parent [Skeleton3D] node if it exists. Otherwise, returns [code]null[/code]."
msgstr "Visszaadja a szülő [Skeleton3D] csomópontot, ha létezik. Egyébként [code]null[/code] értéket ad vissza."

#. SkeletonModifier3D.active
#: doc/classes/SkeletonModifier3D.xml
msgid "If [code]true[/code], the [SkeletonModifier3D] will be processing."
msgstr "Ha az értéke [code]true[/code], fut a [SkeletonModifier3D] feldolgozása."

#. SkeletonModifier3D.influence
#: doc/classes/SkeletonModifier3D.xml
msgid "Sets the influence of the modification.\n[b]Note:[/b] This value is used by [Skeleton3D] to blend, so the [SkeletonModifier3D] should always apply only 100% of the result without interpolation."
msgstr "Beállítja a módosítás mértékét.\n[b]Megjegyzés:[/b] Ezt az értéket a [Skeleton3D] használja a keveréshez. A [SkeletonModifier3D] mindig a teljes eredményt adja át interpoláció nélkül."

#. SkeletonModifier3D.BONE_DIRECTION_FROM_PARENT
#: doc/classes/SkeletonModifier3D.xml
msgid "Enumerated value for the axis from a parent bone to the child bone."
msgstr "A szülőcsonttól a gyermekcsont felé mutató tengelyt jelölő felsorolásérték."

#. SkeletonModifier3D.SECONDARY_DIRECTION_NONE
#: doc/classes/SkeletonModifier3D.xml
msgid "Enumerated value for the case when the axis is undefined."
msgstr "A meghatározatlan tengelyt jelölő felsorolásérték."

#. SkeletonModifier3D.SECONDARY_DIRECTION_CUSTOM
#: doc/classes/SkeletonModifier3D.xml
msgid "Enumerated value for an optional axis."
msgstr "A választható tengelyt jelölő felsorolásérték."

#. SkeletonModifier3D.ROTATION_AXIS_X
#: doc/classes/SkeletonModifier3D.xml
msgid "Enumerated value for the rotation of the X axis."
msgstr "Az X tengely körüli forgatást jelölő felsorolásérték."

#. SkeletonModifier3D.ROTATION_AXIS_Y
#: doc/classes/SkeletonModifier3D.xml
msgid "Enumerated value for the rotation of the Y axis."
msgstr "Az Y tengely körüli forgatást jelölő felsorolásérték."

#. SkeletonModifier3D.ROTATION_AXIS_Z
#: doc/classes/SkeletonModifier3D.xml
msgid "Enumerated value for the rotation of the Z axis."
msgstr "A Z tengely körüli forgatást jelölő felsorolásérték."

#. SkeletonModifier3D.ROTATION_AXIS_ALL
#: doc/classes/SkeletonModifier3D.xml
msgid "Enumerated value for the unconstrained rotation."
msgstr "A korlátozás nélküli forgatást jelölő felsorolásérték."

#. SkeletonModifier3D.ROTATION_AXIS_CUSTOM
#: doc/classes/SkeletonModifier3D.xml
msgid "Enumerated value for an optional rotation axis."
msgstr "A választható forgástengelyt jelölő felsorolásérték."

#. SkeletonProfile.brief
#: doc/classes/SkeletonProfile.xml
msgid "Base class for a profile of a virtual skeleton used as a target for retargeting."
msgstr "Az animációátvitel céljaként használt virtuális csontvázprofil alaposztálya."

#. SkeletonProfile.find_bone
#: doc/classes/SkeletonProfile.xml
msgid "Returns the bone index that matches [param bone_name] as its name."
msgstr "Visszaadja a [param bone_name] nevű csont indexét."

#. SkeletonProfile.get_bone_name
#: doc/classes/SkeletonProfile.xml
msgid "Returns the name of the bone at [param bone_idx] that will be the key name in the [BoneMap].\nIn the retargeting process, the returned bone name is the bone name of the target skeleton."
msgstr "Visszaadja a [param bone_idx] indexű csont nevét, amely a [BoneMap] kulcsa lesz.\nAnimációátvitelnél a visszaadott név a célcsontváz csontneve."

#. SkeletonProfile.get_bone_parent
#: doc/classes/SkeletonProfile.xml
msgid "Returns the name of the bone which is the parent to the bone at [param bone_idx]. The result is empty if the bone has no parent."
msgstr "Visszaadja a [param bone_idx] indexű csont szülőcsontjának nevét. Ha nincs szülőcsont, az eredmény üres."

#. SkeletonProfile.get_bone_tail
#: doc/classes/SkeletonProfile.xml
msgid "Returns the name of the bone which is the tail of the bone at [param bone_idx]."
msgstr "Visszaadja a [param bone_idx] indexű csont végpontját kijelölő csont nevét."

#. SkeletonProfile.get_group
#: doc/classes/SkeletonProfile.xml
msgid "Returns the group of the bone at [param bone_idx]."
msgstr "Visszaadja a [param bone_idx] indexű csont csoportját."

#. SkeletonProfile.get_group_name
#: doc/classes/SkeletonProfile.xml
msgid "Returns the name of the group at [param group_idx] that will be the drawing group in the [BoneMap] editor."
msgstr "Visszaadja a [param group_idx] indexű csoport megjelenítési nevét a [BoneMap] szerkesztőjében."

#. SkeletonProfile.get_handle_offset
#: doc/classes/SkeletonProfile.xml
msgid "Returns the offset of the bone at [param bone_idx] that will be the button position in the [BoneMap] editor.\nThis is the offset with origin at the top left corner of the square."
msgstr "Visszaadja a [param bone_idx] indexű csont eltolását, amely a hozzá tartozó gomb helye lesz a [BoneMap] szerkesztőjében.\nAz eltolás a négyzet bal felső sarkától értendő."

#. SkeletonProfile.get_reference_pose
#: doc/classes/SkeletonProfile.xml
msgid "Returns the reference pose transform for bone [param bone_idx]."
msgstr "Visszaadja a [param bone_idx] indexű csont referenciapózának transzformációját."

#. SkeletonProfile.get_tail_direction
#: doc/classes/SkeletonProfile.xml
msgid "Returns the tail direction of the bone at [param bone_idx]."
msgstr "Visszaadja a [param bone_idx] indexű csont végpontjának iránybeállítását."

#. SkeletonProfile.get_texture
#: doc/classes/SkeletonProfile.xml
msgid "Returns the texture of the group at [param group_idx] that will be the drawing group background image in the [BoneMap] editor."
msgstr "Visszaadja a [param group_idx] indexű csoport textúráját, amely a csoport háttérképe lesz a [BoneMap] szerkesztőjében."

#. SkeletonProfile.is_required
#: doc/classes/SkeletonProfile.xml
msgid "Returns whether the bone at [param bone_idx] is required for retargeting.\nThis value is used by the bone map editor. If this method returns [code]true[/code], and no bone is assigned, the handle color will be red on the bone map editor."
msgstr "Megadja, hogy a [param bone_idx] indexű csont kötelező-e az animációátvitelhez.\nEzt az értéket a csontmegfeleltető szerkesztő használja. Ha a visszatérési érték [code]true[/code], de nincs hozzárendelt csont, a szerkesztőben a fogantyú vörös lesz."

#. SkeletonProfile.set_bone_name
#: doc/classes/SkeletonProfile.xml
msgid "Sets the name of the bone at [param bone_idx] that will be the key name in the [BoneMap].\nIn the retargeting process, the setting bone name is the bone name of the target skeleton."
msgstr "Beállítja a [param bone_idx] indexű csont nevét, amely a [BoneMap] kulcsa lesz.\nAnimációátvitelnél a beállított név a célcsontváz csontneve."

#. SkeletonProfile.set_bone_parent
#: doc/classes/SkeletonProfile.xml
msgid "Sets the bone with name [param bone_parent] as the parent of the bone at [param bone_idx]. If an empty string is passed, then the bone has no parent."
msgstr "A [param bone_parent] nevű csontot a [param bone_idx] indexű csont szülőjeként állítja be. Üres név esetén a csontnak nem lesz szülője."

#. SkeletonProfile.set_bone_tail
#: doc/classes/SkeletonProfile.xml
msgid "Sets the bone with name [param bone_tail] as the tail of the bone at [param bone_idx]."
msgstr "A [param bone_tail] nevű csonttal jelöli ki a [param bone_idx] indexű csont végpontját."

#. SkeletonProfile.set_group
#: doc/classes/SkeletonProfile.xml
msgid "Sets the group of the bone at [param bone_idx]."
msgstr "Beállítja a [param bone_idx] indexű csont csoportját."

#. SkeletonProfile.set_group_name
#: doc/classes/SkeletonProfile.xml
msgid "Sets the name of the group at [param group_idx] that will be the drawing group in the [BoneMap] editor."
msgstr "Beállítja a [param group_idx] indexű csoport megjelenítési nevét a [BoneMap] szerkesztőjében."

#. SkeletonProfile.set_handle_offset
#: doc/classes/SkeletonProfile.xml
msgid "Sets the offset of the bone at [param bone_idx] that will be the button position in the [BoneMap] editor.\nThis is the offset with origin at the top left corner of the square."
msgstr "Beállítja a [param bone_idx] indexű csont eltolását, amely a hozzá tartozó gomb helye lesz a [BoneMap] szerkesztőjében.\nAz eltolás a négyzet bal felső sarkától értendő."

#. SkeletonProfile.set_reference_pose
#: doc/classes/SkeletonProfile.xml
msgid "Sets the reference pose transform for bone [param bone_idx]."
msgstr "Beállítja a [param bone_idx] indexű csont referenciapózának transzformációját."

#. SkeletonProfile.set_required
#: doc/classes/SkeletonProfile.xml
msgid "Sets the required status for bone [param bone_idx] to [param required]."
msgstr "A [param required] értékkel beállítja, hogy a [param bone_idx] indexű csont kötelező-e."

#. SkeletonProfile.set_tail_direction
#: doc/classes/SkeletonProfile.xml
msgid "Sets the tail direction of the bone at [param bone_idx].\n[b]Note:[/b] This only specifies the method of calculation. The actual coordinates required should be stored in an external skeleton, so the calculation itself needs to be done externally."
msgstr "Beállítja a [param bone_idx] indexű csont végpontjának irányát.\n[b]Megjegyzés:[/b] Ez csak a számítás módját határozza meg. A számításhoz szükséges tényleges koordinátákat egy külső csontvázban kell tárolni, magát a számítást pedig külsőleg kell elvégezni."

#. SkeletonProfile.set_texture
#: doc/classes/SkeletonProfile.xml
msgid "Sets the texture of the group at [param group_idx] that will be the drawing group background image in the [BoneMap] editor."
msgstr "Beállítja a [param group_idx] indexű csoport textúráját, amely a csoport háttérképe lesz a [BoneMap] szerkesztőjében."

#. SkeletonProfile.group_size
#: doc/classes/SkeletonProfile.xml
msgid "The amount of groups of bones in retargeting section's [BoneMap] editor. For example, [SkeletonProfileHumanoid] has 4 groups.\nThis property exists to separate the bone list into several sections in the editor."
msgstr "A csontcsoportok száma a [BoneMap] animációátviteli szerkesztőjében. A [SkeletonProfileHumanoid] például négy csoportot tartalmaz.\nEzzel a tulajdonsággal a szerkesztő több részre osztja a csontlistát."

#. SkeletonProfile.TAIL_DIRECTION_AVERAGE_CHILDREN
#: doc/classes/SkeletonProfile.xml
msgid "Direction to the average coordinates of bone children."
msgstr "A gyermekcsontok átlagos koordinátája felé mutató irány."

#. SkeletonProfile.TAIL_DIRECTION_SPECIFIC_CHILD
#: doc/classes/SkeletonProfile.xml
msgid "Direction to the coordinates of specified bone child."
msgstr "A kiválasztott gyermekcsont koordinátái felé mutató irány."

#. SkeletonProfile.TAIL_DIRECTION_END
#: doc/classes/SkeletonProfile.xml
msgid "Direction is not calculated."
msgstr "A motor nem számít irányt."

#. SkeletonProfileHumanoid.brief
#: doc/classes/SkeletonProfileHumanoid.xml
msgid "A humanoid [SkeletonProfile] preset."
msgstr "Ember alakú csontvázhoz készült [SkeletonProfile] előbeállítás."

#. SkinReference.brief
#: doc/classes/SkinReference.xml
msgid "A reference-counted holder object for a skeleton RID used in the [RenderingServer]."
msgstr "A [RenderingServer] által használt csontváz RID azonosítóját tároló, hivatkozásszámlált objektum."

#. SkinReference.get_skeleton
#: doc/classes/SkinReference.xml
msgid "Returns the [RID] owned by this SkinReference, as returned by [method RenderingServer.skeleton_create]."
msgstr "Visszaadja a SkinReference által tárolt [RID] azonosítót, amelyet a [method RenderingServer.skeleton_create] hozott létre."

#. SpringBoneCollision3D.brief
#: doc/classes/SpringBoneCollision3D.xml
msgid "A base class of the collision that interacts with [SpringBoneSimulator3D]."
msgstr "A [SpringBoneSimulator3D] által használt ütközési alakzatok alaposztálya."

#. SpringBoneCollision3D.get_skeleton
#: doc/classes/SpringBoneCollision3D.xml
msgid "Get parent [Skeleton3D] node of the parent [SpringBoneSimulator3D] if found."
msgstr "Visszaadja a szülő [SpringBoneSimulator3D] csomópont szülő [Skeleton3D] csomópontját, ha megtalálható."

#. SpringBoneCollision3D.position_offset
#: doc/classes/SpringBoneCollision3D.xml
msgid "The offset of the position from [Skeleton3D]'s [member bone] pose position."
msgstr "A helyzet eltolása a [Skeleton3D] csontvázban kijelölt [member bone] csont pózának helyzetéhez képest."

#. SpringBoneCollision3D.rotation_offset
#: doc/classes/SpringBoneCollision3D.xml
msgid "The offset of the rotation from [Skeleton3D]'s [member bone] pose rotation."
msgstr "A forgatás eltolása a [Skeleton3D] csontvázban kijelölt [member bone] csont pózának forgatásához képest."

#. SpringBoneCollisionCapsule3D.brief
#. SpringBoneCollisionCapsule3D.description
#: doc/classes/SpringBoneCollisionCapsule3D.xml
msgid "A capsule shape collision that interacts with [SpringBoneSimulator3D]."
msgstr "A [SpringBoneSimulator3D] által kezelt, kapszula alakú ütközési alakzat."

#. SpringBoneCollisionCapsule3D.inside
#. SpringBoneCollisionSphere3D.inside
#: doc/classes/SpringBoneCollisionCapsule3D.xml doc/classes/SpringBoneCollisionSphere3D.xml
msgid "If [code]true[/code], the collision acts to trap the joint within the collision."
msgstr "Ha az értéke [code]true[/code], az ütközési alakzat a belsejében tartja a csuklót."

#. SpringBoneCollisionPlane3D.brief
#: doc/classes/SpringBoneCollisionPlane3D.xml
msgid "An infinite plane collision that interacts with [SpringBoneSimulator3D]."
msgstr "A [SpringBoneSimulator3D] által kezelt, végtelen kiterjedésű ütközési sík."

#. SpringBoneCollisionPlane3D.description
#: doc/classes/SpringBoneCollisionPlane3D.xml
msgid "An infinite plane collision that interacts with [SpringBoneSimulator3D]. It is an infinite size XZ plane, and the +Y direction is treated as normal."
msgstr "A [SpringBoneSimulator3D] által kezelt, végtelen kiterjedésű ütközési sík. Az XZ síkban fekszik, normálvektora a pozitív Y irányba mutat."

#. SpringBoneCollisionSphere3D.brief
#. SpringBoneCollisionSphere3D.description
#: doc/classes/SpringBoneCollisionSphere3D.xml
msgid "A sphere shape collision that interacts with [SpringBoneSimulator3D]."
msgstr "A [SpringBoneSimulator3D] által kezelt, gömb alakú ütközési alakzat."

#. SpringBoneCollisionSphere3D.radius
#: doc/classes/SpringBoneCollisionSphere3D.xml
msgid "The sphere's radius."
msgstr "A gömb sugara."

#. SpringBoneSimulator3D.brief
#: doc/classes/SpringBoneSimulator3D.xml
msgid "A [SkeletonModifier3D] to apply inertial wavering to bone chains."
msgstr "[SkeletonModifier3D], amely tehetetlenségből eredő lengést ad a csontláncokhoz."

#. SpringBoneSimulator3D.get_center_bone
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the center bone index of the bone chain."
msgstr "Visszaadja a csontlánc középpontját meghatározó csont indexét."

#. SpringBoneSimulator3D.get_center_bone_name
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the center bone name of the bone chain."
msgstr "Visszaadja a csontlánc középpontját meghatározó csont nevét."

#. SpringBoneSimulator3D.get_center_from
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns what the center originates from in the bone chain."
msgstr "Visszaadja, hogy mi határozza meg a csontlánc középpontját."

#. SpringBoneSimulator3D.get_center_node
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the center node path of the bone chain."
msgstr "Visszaadja a csontlánc középpontját meghatározó csomópont útvonalát."

#. SpringBoneSimulator3D.get_gravity
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the gravity amount of the bone chain."
msgstr "Visszaadja a csontláncra ható gravitáció erősségét."

#. SpringBoneSimulator3D.get_gravity_direction
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the gravity direction of the bone chain."
msgstr "Visszaadja a csontláncra ható gravitáció irányát."

#. SpringBoneSimulator3D.get_radius
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the joint radius of the bone chain."
msgstr "Visszaadja a csontlánc csuklóinak sugarát."

#. SpringBoneSimulator3D.get_rotation_axis
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the rotation axis of the bone chain."
msgstr "Visszaadja a csontlánc forgástengelyét."

#. SpringBoneSimulator3D.get_gravity_damping_curve
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the gravity amount damping curve of the bone chain."
msgstr "Visszaadja a csontláncra ható gravitáció csillapítási görbéjét."

#. SpringBoneSimulator3D.get_radius_damping_curve
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns the joint radius damping curve of the bone chain."
msgstr "Visszaadja a csontlánc csuklósugarának csillapítási görbéjét."

#. SpringBoneSimulator3D.is_config_individual
#: doc/classes/SpringBoneSimulator3D.xml
msgid "Returns [code]true[/code] if the config can be edited individually for each joint."
msgstr "[code]true[/code] értéket ad vissza, ha a csuklók külön-külön beállíthatók."

#. AimModifier3D.is_relative
#. ConvertTransformModifier3D.is_relative
#. CopyTransformModifier3D.is_relative
#: doc/classes/AimModifier3D.xml doc/classes/ConvertTransformModifier3D.xml doc/classes/CopyTransformModifier3D.xml
msgid "Returns [code]true[/code] if the relative option is enabled in the setting at [param index]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű beállításban a relatív mód engedélyezve van."

#. AimModifier3D.setting_count
#. ConvertTransformModifier3D.setting_count
#. CopyTransformModifier3D.setting_count
#: doc/classes/AimModifier3D.xml doc/classes/ConvertTransformModifier3D.xml doc/classes/CopyTransformModifier3D.xml
msgid "The number of settings in the modifier."
msgstr "A módosító beállításainak száma."

#. Bone2D.brief
#: doc/classes/Bone2D.xml
msgid "A joint used with [Skeleton2D] to control and animate other nodes."
msgstr "A [Skeleton2D] csontvázzal együtt használt csukló más csomópontok vezérléséhez és animálásához."

#. Bone2D.apply_rest
#: doc/classes/Bone2D.xml
msgid "Resets the bone to the rest pose. This is equivalent to setting [member Node2D.transform] to [member rest]."
msgstr "Visszaállítja a csontot nyugalmi pózba. Ugyanazt eredményezi, mint a [member Node2D.transform] beállítása a [member rest] értékére."

#. Bone2D.get_index_in_skeleton
#: doc/classes/Bone2D.xml
msgid "Returns the node's index as part of the entire skeleton. See [Skeleton2D]."
msgstr "Visszaadja a csomópont indexét a teljes csontvázban. Lásd: [Skeleton2D]."

#. Bone2D.get_length
#: doc/classes/Bone2D.xml
msgid "Returns the length of the bone in the [Bone2D] node."
msgstr "Visszaadja a [Bone2D] csomópontban lévő csont hosszát."

#. Bone2D.set_length
#: doc/classes/Bone2D.xml
msgid "Sets the length of the bone in the [Bone2D]."
msgstr "Beállítja a [Bone2D] csontjának hosszát."

#. Bone2D.rest
#: doc/classes/Bone2D.xml
msgid "Rest transform of the bone. You can reset the node's transforms to this value using [method apply_rest]."
msgstr "A csont nyugalmi transzformációja. A csomópont transzformációja a [method apply_rest] metódussal állítható erre az értékre."

#. BoneConstraint3D.brief
#: doc/classes/BoneConstraint3D.xml
msgid "A node that may modify Skeleton3D's bone with associating the two bones."
msgstr "Csomópont, amely két csont összekapcsolásával módosíthatja a Skeleton3D egyik csontját."

#. BoneConstraint3D.get_amount
#: doc/classes/BoneConstraint3D.xml
msgid "Returns the apply amount of the setting at [param index]."
msgstr "Visszaadja a [param index] indexű beállítás alkalmazási mértékét."

#. BoneConstraint3D.get_apply_bone
#: doc/classes/BoneConstraint3D.xml
msgid "Returns the apply bone of the setting at [param index]. This bone will be modified."
msgstr "Visszaadja a [param index] indexű beállítás célcsontját. A módosító ezt a csontot változtatja meg."

#. BoneConstraint3D.get_apply_bone_name
#: doc/classes/BoneConstraint3D.xml
msgid "Returns the apply bone name of the setting at [param index]. This bone will be modified."
msgstr "Visszaadja a [param index] indexű beállítás célcsontjának nevét. A módosító ezt a csontot változtatja meg."

#. BoneConstraint3D.get_reference_bone
#: doc/classes/BoneConstraint3D.xml
msgid "Returns the reference bone of the setting at [param index].\nThis bone will be only referenced and not modified by this modifier."
msgstr "Visszaadja a [param index] indexű beállítás referenciacsontját.\nA módosító ezt a csontot csak hivatkozásként használja."

#. BoneConstraint3D.get_reference_bone_name
#: doc/classes/BoneConstraint3D.xml
msgid "Returns the reference bone name of the setting at [param index].\nThis bone will be only referenced and not modified by this modifier."
msgstr "Visszaadja a [param index] indexű beállítás referenciacsontjának nevét.\nA módosító ezt a csontot csak hivatkozásként használja."

#. BoneConstraint3D.get_reference_node
#: doc/classes/BoneConstraint3D.xml
msgid "Returns the reference node path of the setting at [param index].\nThis node will be only referenced and not modified by this modifier."
msgstr "Visszaadja a [param index] indexű beállítás referenciacsomópontjának útvonalát.\nA módosító ezt a csomópontot csak hivatkozásként használja."

#. BoneConstraint3D.get_reference_type
#: doc/classes/BoneConstraint3D.xml
msgid "Returns the reference target type of the setting at [param index]. See also [enum ReferenceType]."
msgstr "Visszaadja a [param index] indexű beállítás referenciacéljának típusát. Lásd még: [enum ReferenceType]."

#. BoneConstraint3D.set_amount
#: doc/classes/BoneConstraint3D.xml
msgid "Sets the apply amount of the setting at [param index] to [param amount]."
msgstr "A [param index] indexű beállítás alkalmazási mértékét [param amount] értékre állítja."

#. BoneConstraint3D.set_apply_bone
#: doc/classes/BoneConstraint3D.xml
msgid "Sets the apply bone of the setting at [param index] to [param bone]. This bone will be modified."
msgstr "A [param index] indexű beállítás célcsontját [param bone] értékre állítja. A módosító ezt a csontot változtatja meg."

#. BoneConstraint3D.set_apply_bone_name
#: doc/classes/BoneConstraint3D.xml
msgid "Sets the apply bone of the setting at [param index] to [param bone_name]. This bone will be modified."
msgstr "A [param index] indexű beállítás célcsontjának nevét [param bone_name] értékre állítja. A módosító ezt a csontot változtatja meg."

#. BoneConstraint3D.set_reference_bone
#: doc/classes/BoneConstraint3D.xml
msgid "Sets the reference bone of the setting at [param index] to [param bone].\nThis bone will be only referenced and not modified by this modifier."
msgstr "A [param index] indexű beállítás referenciacsontját [param bone] értékre állítja.\nA módosító ezt a csontot csak hivatkozásként használja."

#. BoneConstraint3D.set_reference_bone_name
#: doc/classes/BoneConstraint3D.xml
msgid "Sets the reference bone of the setting at [param index] to [param bone_name].\nThis bone will be only referenced and not modified by this modifier."
msgstr "A [param index] indexű beállítás referenciacsontjának nevét [param bone_name] értékre állítja.\nA módosító ezt a csontot csak hivatkozásként használja."

#. BoneConstraint3D.set_reference_node
#: doc/classes/BoneConstraint3D.xml
msgid "Sets the reference node path of the setting at [param index] to [param node].\nThis node will be only referenced and not modified by this modifier."
msgstr "A [param index] indexű beállítás referenciacsomópontjának útvonalát [param node] értékre állítja.\nA módosító ezt a csomópontot csak hivatkozásként használja."

#. BoneConstraint3D.set_reference_type
#: doc/classes/BoneConstraint3D.xml
msgid "Sets the reference target type of the setting at [param index] to [param type]. See also [enum ReferenceType]."
msgstr "A [param index] indexű beállítás referenciacéljának típusát [param type] értékre állítja. Lásd még: [enum ReferenceType]."

#. BoneConstraint3D.set_setting_count
#: doc/classes/BoneConstraint3D.xml
msgid "Sets the number of settings in the modifier."
msgstr "Beállítja a módosító beállításainak számát."

#. BoneConstraint3D.REFERENCE_TYPE_BONE
#: doc/classes/BoneConstraint3D.xml
msgid "The reference target is a bone. In this case, the reference target spaces is local space."
msgstr "A referenciacél egy csont. Ebben az esetben a referenciacél koordinátái a helyi térben értendők."

#. CCDIK3D.brief
#: doc/classes/CCDIK3D.xml
msgid "Rotation based cyclic coordinate descent inverse kinematics solver."
msgstr "Forgatáson alapuló, ciklikus koordinátacsökkentést alkalmazó inverz kinematikai megoldó."

#. ChainIK3D.brief
#: doc/classes/ChainIK3D.xml
msgid "A [SkeletonModifier3D] to apply inverse kinematics to bone chains containing an arbitrary number of bones."
msgstr "Tetszőleges számú csontból álló láncra inverz kinematikát alkalmazó [SkeletonModifier3D]."

#. ConvertTransformModifier3D.is_additive
#. CopyTransformModifier3D.is_additive
#: doc/classes/ConvertTransformModifier3D.xml doc/classes/CopyTransformModifier3D.xml
msgid "Returns [code]true[/code] if the additive option is enabled in the setting at [param index]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű beállításban az additív mód engedélyezve van."

#. CopyTransformModifier3D.brief
#: doc/classes/CopyTransformModifier3D.xml
msgid "A [SkeletonModifier3D] that apply transform to the bone which copied from reference."
msgstr "[SkeletonModifier3D], amely a referenciáról másolt transzformációt alkalmazza a csontra."

#. CopyTransformModifier3D.get_axis_flags
#: doc/classes/CopyTransformModifier3D.xml
msgid "Returns the axis flags of the setting at [param index]."
msgstr "Visszaadja a [param index] indexű beállítás tengelyjelzőit."

#. CopyTransformModifier3D.get_copy_flags
#: doc/classes/CopyTransformModifier3D.xml
msgid "Returns the copy flags of the setting at [param index]."
msgstr "Visszaadja a [param index] indexű beállítás másolási jelzőit."

#. CopyTransformModifier3D.get_invert_flags
#: doc/classes/CopyTransformModifier3D.xml
msgid "Returns the invert flags of the setting at [param index]."
msgstr "Visszaadja a [param index] indexű beállítás irányfordítási jelzőit."

#. CopyTransformModifier3D.is_position_copying
#: doc/classes/CopyTransformModifier3D.xml
msgid "Returns [code]true[/code] if the copy flags has the flag for the position in the setting at [param index]. See also [method set_copy_flags]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű beállításban a helyzet másolási jelzője aktív. Lásd még: [method set_copy_flags]."

#. CopyTransformModifier3D.is_rotation_copying
#: doc/classes/CopyTransformModifier3D.xml
msgid "Returns [code]true[/code] if the copy flags has the flag for the rotation in the setting at [param index]. See also [method set_copy_flags]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű beállításban a forgatás másolási jelzője aktív. Lásd még: [method set_copy_flags]."

#. CopyTransformModifier3D.is_scale_copying
#: doc/classes/CopyTransformModifier3D.xml
msgid "Returns [code]true[/code] if the copy flags has the flag for the scale in the setting at [param index]. See also [method set_copy_flags]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű beállításban a méretezés másolási jelzője aktív. Lásd még: [method set_copy_flags]."

#. CopyTransformModifier3D.set_axis_flags
#: doc/classes/CopyTransformModifier3D.xml
msgid "Sets the flags to copy axes. If the flag is valid, the axis is copied."
msgstr "Beállítja a tengelymásolási jelzőket. Az aktív jelzőhöz tartozó tengely értéke másolódik."

#. CopyTransformModifier3D.set_copy_position
#: doc/classes/CopyTransformModifier3D.xml
msgid "If sets [param enabled] to [code]true[/code], the position will be copied."
msgstr "Ha a [param enabled] értéke [code]true[/code], a helyzet másolódik."

#. CopyTransformModifier3D.set_copy_rotation
#: doc/classes/CopyTransformModifier3D.xml
msgid "If sets [param enabled] to [code]true[/code], the rotation will be copied."
msgstr "Ha a [param enabled] értéke [code]true[/code], a forgatás másolódik."

#. CopyTransformModifier3D.set_copy_scale
#: doc/classes/CopyTransformModifier3D.xml
msgid "If sets [param enabled] to [code]true[/code], the scale will be copied."
msgstr "Ha a [param enabled] értéke [code]true[/code], a méretezés másolódik."

#. CopyTransformModifier3D.TRANSFORM_FLAG_POSITION
#: doc/classes/CopyTransformModifier3D.xml
msgid "If set, allows to copy the position."
msgstr "Aktív állapotban engedélyezi a helyzet másolását."

#. CopyTransformModifier3D.TRANSFORM_FLAG_ROTATION
#: doc/classes/CopyTransformModifier3D.xml
msgid "If set, allows to copy the rotation."
msgstr "Aktív állapotban engedélyezi a forgatás másolását."

#. CopyTransformModifier3D.TRANSFORM_FLAG_SCALE
#: doc/classes/CopyTransformModifier3D.xml
msgid "If set, allows to copy the scale."
msgstr "Aktív állapotban engedélyezi a méretezés másolását."

#. CopyTransformModifier3D.TRANSFORM_FLAG_ALL
#: doc/classes/CopyTransformModifier3D.xml
msgid "If set, allows to copy the position/rotation/scale."
msgstr "Aktív állapotban engedélyezi a helyzet, a forgatás és a méretezés másolását."

#. FABRIK3D.brief
#: doc/classes/FABRIK3D.xml
msgid "Position based forward and backward reaching inverse kinematics solver."
msgstr "Helyzetalapú inverz kinematikai megoldó, amely előre és visszafelé is végighalad a láncon."

#. IKModifier3D.brief
#: doc/classes/IKModifier3D.xml
msgid "A node for inverse kinematics which may modify more than one bone."
msgstr "Inverz kinematikai csomópont, amely több csontot is módosíthat."

#. IKModifier3D.get_setting_count
#: doc/classes/IKModifier3D.xml
msgid "Returns the number of settings."
msgstr "Visszaadja a beállítások számát."

#. IKModifier3D.reset
#: doc/classes/IKModifier3D.xml
msgid "Resets a state with respect to the current bone pose."
msgstr "Az aktuális csontpóz alapján visszaállítja a megoldó állapotát."

#. IterateIK3D.get_target_node
#. TwoBoneIK3D.get_target_node
#: doc/classes/IterateIK3D.xml doc/classes/TwoBoneIK3D.xml
msgid "Returns the target node that the end bone is trying to reach."
msgstr "Visszaadja azt a célcsomópontot, amelyet a végcsont próbál elérni."

#. IterateIK3D.set_target_node
#. TwoBoneIK3D.set_target_node
#: doc/classes/IterateIK3D.xml doc/classes/TwoBoneIK3D.xml
msgid "Sets the target node that the end bone is trying to reach."
msgstr "Beállítja azt a célcsomópontot, amelyet a végcsont próbál elérni."

#. JointLimitation3D.brief
#: doc/classes/JointLimitation3D.xml
msgid "A base class of the limitation that interacts with [ChainIK3D]."
msgstr "A [ChainIK3D] által használt forgáskorlátozások alaposztálya."

#. JointLimitation3D.description
#: doc/classes/JointLimitation3D.xml
msgid "The limitation is attached to each joint and limits the rotation of the bone."
msgstr "A korlátozás az egyes csuklókhoz kapcsolódik, és határt szab a csont elfordulásának."

#. LookAtModifier3D.brief
#: doc/classes/LookAtModifier3D.xml
msgid "The [LookAtModifier3D] rotates a bone to look at a target."
msgstr "A [LookAtModifier3D] úgy forgatja el a csontot, hogy az a cél felé nézzen."

#. LookAtModifier3D.get_interpolation_remaining
#: doc/classes/LookAtModifier3D.xml
msgid "Returns the remaining seconds of the time-based interpolation."
msgstr "Visszaadja az időalapú interpolációból hátralévő másodpercek számát."

#. LookAtModifier3D.bone
#: doc/classes/LookAtModifier3D.xml
msgid "Index of the [member bone_name] in the parent [Skeleton3D]."
msgstr "A [member bone_name] nevű csont indexe a szülő [Skeleton3D] csontvázban."

#. LookAtModifier3D.bone_name
#: doc/classes/LookAtModifier3D.xml
msgid "The bone name of the [Skeleton3D] that the modification will operate on."
msgstr "A módosítással érintett csont neve a [Skeleton3D] csontvázban."

#. LookAtModifier3D.ease_type
#: doc/classes/LookAtModifier3D.xml
msgid "The ease type of the time-based interpolation. See also [enum Tween.EaseType]."
msgstr "Az időalapú interpoláció gyorsulási módja. Lásd még: [enum Tween.EaseType]."

#. LookAtModifier3D.forward_axis
#: doc/classes/LookAtModifier3D.xml
msgid "The forward axis of the bone. This [SkeletonModifier3D] modifies the bone so that this axis points toward the [member target_node]."
msgstr "A csont előre mutató tengelye. A [SkeletonModifier3D] úgy módosítja a csontot, hogy ez a tengely a [member target_node] felé mutasson."

#. LookAtModifier3D.origin_bone
#: doc/classes/LookAtModifier3D.xml
msgid "Index of the [member origin_bone_name] in the parent [Skeleton3D]."
msgstr "A [member origin_bone_name] nevű csont indexe a szülő [Skeleton3D] csontvázban."

#. LookAtModifier3D.origin_bone_name
#: doc/classes/LookAtModifier3D.xml
msgid "If [member origin_from] is [constant ORIGIN_FROM_SPECIFIC_BONE], the bone global pose position specified for this is used as origin."
msgstr "Ha a [member origin_from] értéke [constant ORIGIN_FROM_SPECIFIC_BONE], a megadott csont globális pózának helyzete lesz az origó."

#. LookAtModifier3D.origin_external_node
#: doc/classes/LookAtModifier3D.xml
msgid "If [member origin_from] is [constant ORIGIN_FROM_EXTERNAL_NODE], the global position of the [Node3D] specified for this is used as origin."
msgstr "Ha a [member origin_from] értéke [constant ORIGIN_FROM_EXTERNAL_NODE], a megadott [Node3D] csomópont világkoordinátákban vett helyzete lesz az origó."

#. LookAtModifier3D.origin_from
#: doc/classes/LookAtModifier3D.xml
msgid "This value determines from what origin is retrieved for use in the calculation of the forward vector."
msgstr "Meghatározza az előre mutató vektor kiszámításához használt origó forrását."

#. LookAtModifier3D.origin_safe_margin
#: doc/classes/LookAtModifier3D.xml
msgid "If the target passes through too close to the origin than this value, time-based interpolation is used even if the target is within the angular limitations, to prevent the angular velocity from becoming too high."
msgstr "Ha a cél az origóhoz ennél közelebb halad el, a módosító akkor is időalapú interpolációt használ, ha a cél a szöghatárokon belül marad. Így a szögsebesség nem nő túl nagyra."

#. LookAtModifier3D.primary_limit_angle
#: doc/classes/LookAtModifier3D.xml
msgid "The limit angle of the primary rotation when [member symmetry_limitation] is [code]true[/code], in radians."
msgstr "Az elsődleges forgás határszöge radiánban, ha a [member symmetry_limitation] értéke [code]true[/code]."

#. LookAtModifier3D.primary_negative_damp_threshold
#: doc/classes/LookAtModifier3D.xml
msgid "The threshold to start damping for [member primary_negative_limit_angle]."
msgstr "Az elsődleges forgás csillapítási küszöbe a [member primary_negative_limit_angle] felé."

#. LookAtModifier3D.primary_negative_limit_angle
#: doc/classes/LookAtModifier3D.xml
msgid "The limit angle of negative side of the primary rotation when [member symmetry_limitation] is [code]false[/code], in radians."
msgstr "Az elsődleges forgás negatív oldali határszöge radiánban, ha a [member symmetry_limitation] értéke [code]false[/code]."

#. LookAtModifier3D.primary_positive_damp_threshold
#: doc/classes/LookAtModifier3D.xml
msgid "The threshold to start damping for [member primary_positive_limit_angle]."
msgstr "Az elsődleges forgás csillapítási küszöbe a [member primary_positive_limit_angle] felé."

#. LookAtModifier3D.primary_positive_limit_angle
#: doc/classes/LookAtModifier3D.xml
msgid "The limit angle of positive side of the primary rotation when [member symmetry_limitation] is [code]false[/code], in radians."
msgstr "Az elsődleges forgás pozitív oldali határszöge radiánban, ha a [member symmetry_limitation] értéke [code]false[/code]."

#. LookAtModifier3D.secondary_damp_threshold
#: doc/classes/LookAtModifier3D.xml
msgid "The threshold to start damping for [member secondary_limit_angle]."
msgstr "A másodlagos forgás csillapítási küszöbe a [member secondary_limit_angle] felé."

#. LookAtModifier3D.secondary_limit_angle
#: doc/classes/LookAtModifier3D.xml
msgid "The limit angle of the secondary rotation when [member symmetry_limitation] is [code]true[/code], in radians."
msgstr "A másodlagos forgás határszöge radiánban, ha a [member symmetry_limitation] értéke [code]true[/code]."

#. LookAtModifier3D.secondary_negative_damp_threshold
#: doc/classes/LookAtModifier3D.xml
msgid "The threshold to start damping for [member secondary_negative_limit_angle]."
msgstr "A másodlagos forgás csillapítási küszöbe a [member secondary_negative_limit_angle] felé."

#. LookAtModifier3D.secondary_negative_limit_angle
#: doc/classes/LookAtModifier3D.xml
msgid "The limit angle of negative side of the secondary rotation when [member symmetry_limitation] is [code]false[/code], in radians."
msgstr "A másodlagos forgás negatív oldali határszöge radiánban, ha a [member symmetry_limitation] értéke [code]false[/code]."

#. LookAtModifier3D.secondary_positive_damp_threshold
#: doc/classes/LookAtModifier3D.xml
msgid "The threshold to start damping for [member secondary_positive_limit_angle]."
msgstr "A másodlagos forgás csillapítási küszöbe a [member secondary_positive_limit_angle] felé."

#. LookAtModifier3D.secondary_positive_limit_angle
#: doc/classes/LookAtModifier3D.xml
msgid "The limit angle of positive side of the secondary rotation when [member symmetry_limitation] is [code]false[/code], in radians."
msgstr "A másodlagos forgás pozitív oldali határszöge radiánban, ha a [member symmetry_limitation] értéke [code]false[/code]."

#. LookAtModifier3D.symmetry_limitation
#: doc/classes/LookAtModifier3D.xml
msgid "If [code]true[/code], the limitations are spread from the bone symmetrically.\nIf [code]false[/code], the limitation can be specified separately for each side of the bone rest."
msgstr "Ha az értéke [code]true[/code], a forgáshatárok szimmetrikusak a csont nyugalmi helyzetéhez képest.\nHa az értéke [code]false[/code], a nyugalmi helyzet két oldalán külön határok állíthatók be."

#. LookAtModifier3D.target_node
#: doc/classes/LookAtModifier3D.xml
msgid "The [NodePath] to the node that is the target for the look at modification. This node is what the modification will rotate the bone to."
msgstr "A célcsomópont [NodePath] útvonala. A módosító e csomópont felé fordítja a csontot."

#. LookAtModifier3D.transition_type
#: doc/classes/LookAtModifier3D.xml
msgid "The transition type of the time-based interpolation. See also [enum Tween.TransitionType]."
msgstr "Az időalapú interpoláció átmenettípusa. Lásd még: [enum Tween.TransitionType]."

#. LookAtModifier3D.use_secondary_rotation
#: doc/classes/LookAtModifier3D.xml
msgid "If [code]true[/code], provides rotation by two axes."
msgstr "Ha az értéke [code]true[/code], a csont két tengely körül foroghat."

#. LookAtModifier3D.ORIGIN_FROM_SELF
#: doc/classes/LookAtModifier3D.xml
msgid "The bone rest position of the bone specified in [member bone] is used as origin."
msgstr "Az origó a [member bone] által megadott csont nyugalmi helyzete."

#. RetargetModifier3D.brief
#: doc/classes/RetargetModifier3D.xml
msgid "A modifier to transfer parent skeleton poses (or global poses) to child skeletons in model space with different rests."
msgstr "A szülőcsontváz pózait vagy globális pózait modelltérben átviszi az eltérő nyugalmi pózú gyermekcsontvázakra."

#. RetargetModifier3D.is_position_enabled
#: doc/classes/RetargetModifier3D.xml
msgid "Returns [code]true[/code] if [member enable] has [constant TRANSFORM_FLAG_POSITION]."
msgstr "[code]true[/code] értéket ad vissza, ha a [member enable] tartalmazza a [constant TRANSFORM_FLAG_POSITION] jelzőt."

#. RetargetModifier3D.is_rotation_enabled
#: doc/classes/RetargetModifier3D.xml
msgid "Returns [code]true[/code] if [member enable] has [constant TRANSFORM_FLAG_ROTATION]."
msgstr "[code]true[/code] értéket ad vissza, ha a [member enable] tartalmazza a [constant TRANSFORM_FLAG_ROTATION] jelzőt."

#. RetargetModifier3D.is_scale_enabled
#: doc/classes/RetargetModifier3D.xml
msgid "Returns [code]true[/code] if [member enable] has [constant TRANSFORM_FLAG_SCALE]."
msgstr "[code]true[/code] értéket ad vissza, ha a [member enable] tartalmazza a [constant TRANSFORM_FLAG_SCALE] jelzőt."

#. RetargetModifier3D.enable
#: doc/classes/RetargetModifier3D.xml
msgid "Flags to control the process of the transform elements individually when [member use_global_pose] is disabled."
msgstr "A transzformáció összetevőinek feldolgozását külön vezérlő jelzők, ha a [member use_global_pose] ki van kapcsolva."

#. RetargetModifier3D.profile
#: doc/classes/RetargetModifier3D.xml
msgid "[SkeletonProfile] for retargeting bones with names matching the bone list."
msgstr "A csontlistával egyező nevű csontok animációátviteléhez használt [SkeletonProfile]."

#. RetargetModifier3D.TRANSFORM_FLAG_POSITION
#: doc/classes/RetargetModifier3D.xml
msgid "If set, allows to retarget the position."
msgstr "Aktív állapotban engedélyezi a helyzet átvitelét."

#. RetargetModifier3D.TRANSFORM_FLAG_ROTATION
#: doc/classes/RetargetModifier3D.xml
msgid "If set, allows to retarget the rotation."
msgstr "Aktív állapotban engedélyezi a forgatás átvitelét."

#. RetargetModifier3D.TRANSFORM_FLAG_SCALE
#: doc/classes/RetargetModifier3D.xml
msgid "If set, allows to retarget the scale."
msgstr "Aktív állapotban engedélyezi a méretezés átvitelét."

#. RetargetModifier3D.TRANSFORM_FLAG_ALL
#: doc/classes/RetargetModifier3D.xml
msgid "If set, allows to retarget the position/rotation/scale."
msgstr "Aktív állapotban engedélyezi a helyzet, a forgatás és a méretezés átvitelét."

#. RootMotionView.brief
#: doc/classes/RootMotionView.xml
msgid "Editor-only helper for setting up root motion in [AnimationMixer]."
msgstr "Csak a szerkesztőben használható segédeszköz az [AnimationMixer] gyökérmozgásának beállításához."

#. RootMotionView.animation_path
#: doc/classes/RootMotionView.xml
msgid "Path to an [AnimationMixer] node to use as a basis for root motion."
msgstr "A gyökérmozgás alapjaként használt [AnimationMixer] csomópont útvonala."

#. RootMotionView.cell_size
#: doc/classes/RootMotionView.xml
msgid "The grid's cell size in 3D units."
msgstr "A rácscella mérete a 3D tér egységeiben."

#. RootMotionView.color
#: doc/classes/RootMotionView.xml
msgid "The grid's color."
msgstr "A rács színe."

#. RootMotionView.radius
#: doc/classes/RootMotionView.xml
msgid "The grid's radius in 3D units. The grid's opacity will fade gradually as the distance from the origin increases until this [member radius] is reached."
msgstr "A rács sugara a 3D tér egységeiben. Az origótól távolodva a rács fokozatosan elhalványul a megadott [member radius] értékig."

#. RootMotionView.zero_y
#: doc/classes/RootMotionView.xml
msgid "If [code]true[/code], the grid's points will all be on the same Y coordinate ([i]local[/i] Y = 0). If [code]false[/code], the points' original Y coordinate is preserved."
msgstr "Ha az értéke [code]true[/code], a rács pontjai azonos Y koordinátán lesznek ([i]helyi[/i] Y = 0). Ha az értéke [code]false[/code], mindegyik pont megtartja az eredeti Y koordinátáját."

#. Skeleton2D.brief
#: doc/classes/Skeleton2D.xml
msgid "The parent of a hierarchy of [Bone2D]s, used to create a 2D skeletal animation."
msgstr "Egy [Bone2D] hierarchia szülője, amely 2D csontvázas animációhoz használható."

#. Skeleton2D.get_bone_count
#: doc/classes/Skeleton2D.xml
msgid "Returns the number of [Bone2D] nodes in the node hierarchy parented by Skeleton2D."
msgstr "Visszaadja a Skeleton2D alatti hierarchiában lévő [Bone2D] csomópontok számát."

#. Skeleton2D.get_bone_local_pose_override
#: doc/classes/Skeleton2D.xml
msgid "Returns the local pose override transform for [param bone_idx]."
msgstr "Visszaadja a [param bone_idx] indexű csont helyi pózát felülbíráló transzformációt."

#. Skeleton2D.get_modification_stack
#: doc/classes/Skeleton2D.xml
msgid "Returns the [SkeletonModificationStack2D] attached to this skeleton, if one exists."
msgstr "Visszaadja a csontvázhoz kapcsolt [SkeletonModificationStack2D] erőforrást, ha van ilyen."

#. Skeleton2D.get_skeleton
#: doc/classes/Skeleton2D.xml
msgid "Returns the [RID] of a Skeleton2D instance."
msgstr "Visszaadja a Skeleton2D példány [RID] azonosítóját."

#. Skeleton2D.set_modification_stack
#: doc/classes/Skeleton2D.xml
msgid "Sets the [SkeletonModificationStack2D] attached to this skeleton."
msgstr "Beállítja a csontvázhoz kapcsolt [SkeletonModificationStack2D] erőforrást."

#. Image.brief
#: doc/classes/Image.xml
msgid "Image datatype."
msgstr "Kép adattípus."

#. Image.adjust_bcs
#: doc/classes/Image.xml
msgid "Adjusts this image's [param brightness], [param contrast], and [param saturation] by the given values. Does not work if the image is compressed (see [method is_compressed])."
msgstr "A megadott értékekkel módosítja a kép fényerejét ([param brightness]), kontrasztját ([param contrast]) és telítettségét ([param saturation]). Tömörített képen nem működik (lásd: [method is_compressed])."

#. Image.blend_rect
#: doc/classes/Image.xml
msgid "Alpha-blends [param src_rect] from [param src] image to this image at coordinates [param dst], clipped accordingly to both image bounds. This image and [param src] image [b]must[/b] have the same format. [param src_rect] with non-positive size is treated as empty."
msgstr "Alfa-csatorna alapján összekeveri a [param src] kép [param src_rect] területét az aktuális képpel a [param dst] koordinátán. A művelet mindkét kép határain belül marad. Az aktuális kép és a [param src] kép formátuma [b]azonos kell legyen[/b]. A nem pozitív méretű [param src_rect] üresnek számít."

#. Image.bump_map_to_normal_map
#: doc/classes/Image.xml
msgid "Converts a bump map to a normal map. A bump map provides a height offset per-pixel, while a normal map provides a normal direction per pixel."
msgstr "Domborulattérképet alakít normáltérképpé. A domborulattérkép képpontonként magassági eltérést, a normáltérkép pedig normálirányt ad meg."

#. Image.clear_mipmaps
#: doc/classes/Image.xml
msgid "Removes the image's mipmaps."
msgstr "Eltávolítja a kép mipmapszintjeit."

#. Image.compute_image_metrics
#: doc/classes/Image.xml
msgid "Compute image metrics on the current image and the compared image. This can be used to calculate the similarity between two images.\nThe dictionary contains [code]max[/code], [code]mean[/code], [code]mean_squared[/code], [code]root_mean_squared[/code] and [code]peak_snr[/code]."
msgstr "Kiszámítja az aktuális és az összehasonlításra megadott kép közötti eltérés mérőszámait. Ezekkel a két kép hasonlósága mérhető.\nA szótár a [code]max[/code], [code]mean[/code], [code]mean_squared[/code], [code]root_mean_squared[/code] és [code]peak_snr[/code] értékeket tartalmazza."

#. Image.convert
#: doc/classes/Image.xml
msgid "Converts this image's format to the given [param format]."
msgstr "A képet a megadott [param format] formátumba alakítja."

#. Image.copy_from
#: doc/classes/Image.xml
msgid "Copies [param src] image to this image."
msgstr "A [param src] képet ebbe a képbe másolja."

#. Image.create
#. Image.create_empty
#: doc/classes/Image.xml
msgid "Creates an empty image of the given size and format. If [param use_mipmaps] is [code]true[/code], generates mipmaps for this image (see [method generate_mipmaps])."
msgstr "Üres képet hoz létre a megadott mérettel és formátummal. Ha a [param use_mipmaps] értéke [code]true[/code], mipmapszinteket is készít hozzá (lásd: [method generate_mipmaps])."

#. Image.create_from_data
#: doc/classes/Image.xml
msgid "Creates a new image of the given size and format. Fills the image with the given raw data. If [param use_mipmaps] is [code]true[/code], loads the mipmaps for this image from [param data]. See [method generate_mipmaps]."
msgstr "Új képet hoz létre a megadott mérettel és formátummal, és kitölti a megadott nyers adatokkal. Ha a [param use_mipmaps] értéke [code]true[/code], a mipmapszinteket a [param data] adataiból tölti be. Lásd: [method generate_mipmaps]."

#. Image.crop
#: doc/classes/Image.xml
msgid "Crops the image to the given [param width] and [param height]. If the specified size is larger than the current size, the extra area is filled with black pixels."
msgstr "A képet a megadott [param width] szélességre és [param height] magasságra vágja. Ha a megadott méret nagyobb a jelenleginél, a hozzáadott területet fekete képpontokkal tölti ki."

#. Image.detect_used_channels
#: doc/classes/Image.xml
msgid "Returns the color channels used by this image. If the image is compressed, the original [param source] must be specified."
msgstr "Visszaadja a kép által használt színcsatornákat. Tömörített képnél meg kell adni az eredeti [param source] értéket."

#. Image.fill
#: doc/classes/Image.xml
msgid "Fills the image with [param color]."
msgstr "Kitölti a képet a [param color] színnel."

#. Image.fill_rect
#: doc/classes/Image.xml
msgid "Fills [param rect] with [param color]."
msgstr "Kitölti a [param rect] területet a [param color] színnel."

#. Image.fix_alpha_edges
#: doc/classes/Image.xml
msgid "Blends low-alpha pixels with nearby pixels."
msgstr "Az alacsony alfaértékű képpontokat a környező képpontokkal keveri."

#. Image.flip_x
#: doc/classes/Image.xml
msgid "Flips the image horizontally."
msgstr "Vízszintesen tükrözi a képet."

#. Image.flip_y
#: doc/classes/Image.xml
msgid "Flips the image vertically."
msgstr "Függőlegesen tükrözi a képet."

#. Image.get_data
#: doc/classes/Image.xml
msgid "Returns a copy of the image's raw data."
msgstr "Visszaadja a kép nyers adatainak másolatát."

#. Image.get_data_size
#: doc/classes/Image.xml
msgid "Returns size (in bytes) of the image's raw data."
msgstr "Visszaadja a kép nyers adatainak méretét bájtban."

#. Image.get_format
#: doc/classes/Image.xml
msgid "Returns this image's format."
msgstr "Visszaadja a kép formátumát."

#. Image.get_height
#: doc/classes/Image.xml
msgid "Returns the image's height."
msgstr "Visszaadja a kép magasságát."

#. Image.get_mipmap_count
#: doc/classes/Image.xml
msgid "Returns the number of mipmap levels or 0 if the image has no mipmaps. The largest main level image is not counted as a mipmap level by this method, so if you want to include it you can add 1 to this count."
msgstr "Visszaadja a mipmapszintek számát. Ha a képnek nincsenek mipmapszintjei, az eredmény 0. A legnagyobb, eredeti kép nem számít bele, így a teljes szintszámhoz adj egyet a visszaadott értékhez."

#. Image.get_pixel
#: doc/classes/Image.xml
msgid "Returns the color of the pixel at [code](x, y)[/code].\nThis is the same as [method get_pixelv], but with two integer arguments instead of a [Vector2i] argument."
msgstr "Visszaadja a [code](x, y)[/code] helyen lévő képpont színét.\nUgyanazt végzi, mint a [method get_pixelv], de egy [Vector2i] helyett két egész számot vár."

#. Image.get_pixelv
#: doc/classes/Image.xml
msgid "Returns the color of the pixel at [param point].\nThis is the same as [method get_pixel], but with a [Vector2i] argument instead of two integer arguments."
msgstr "Visszaadja a [param point] helyen lévő képpont színét.\nUgyanazt végzi, mint a [method get_pixel], de két egész szám helyett egy [Vector2i] értéket vár."

#. Image.get_region
#: doc/classes/Image.xml
msgid "Returns a new [Image] that is a copy of this [Image]'s area specified with [param region]."
msgstr "Új [Image] erőforrást ad vissza, amely az aktuális [Image] [param region] által megadott területének másolata."

#. Image.get_size
#: doc/classes/Image.xml
msgid "Returns the image's size (width and height)."
msgstr "Visszaadja a kép méretét, vagyis a szélességét és magasságát."

#. Image.get_used_rect
#: doc/classes/Image.xml
msgid "Returns a [Rect2i] enclosing the visible portion of the image, considering each pixel with a non-zero alpha channel as visible."
msgstr "A kép látható részét befoglaló [Rect2i] téglalapot adja vissza. Minden nem nulla alfaértékű képpontot láthatónak tekint."

#. Image.get_width
#: doc/classes/Image.xml
msgid "Returns the image's width."
msgstr "Visszaadja a kép szélességét."

#. Image.has_mipmaps
#: doc/classes/Image.xml
msgid "Returns [code]true[/code] if the image has generated mipmaps."
msgstr "[code]true[/code] értéket ad vissza, ha a képhez készültek mipmapszintek."

#. Image.is_compressed
#: doc/classes/Image.xml
msgid "Returns [code]true[/code] if the image is compressed."
msgstr "[code]true[/code] értéket ad vissza, ha a kép tömörített."

#. Image.is_empty
#: doc/classes/Image.xml
msgid "Returns [code]true[/code] if the image has no data."
msgstr "[code]true[/code] értéket ad vissza, ha a kép nem tartalmaz adatot."

#. Image.is_invisible
#: doc/classes/Image.xml
msgid "Returns [code]true[/code] if all the image's pixels have an alpha value of 0. Returns [code]false[/code] if any pixel has an alpha value higher than 0."
msgstr "[code]true[/code] értéket ad vissza, ha a kép összes képpontjának alfaértéke nulla. Ha bármely képpont alfaértéke nagyobb nullánál, [code]false[/code] értéket ad vissza."

#. Image.linear_to_srgb
#: doc/classes/Image.xml
msgid "Converts the entire image from linear encoding to nonlinear sRGB encoding by using a lookup table. Only works on images with [constant FORMAT_RGB8] or [constant FORMAT_RGBA8] formats."
msgstr "Keresőtáblával a teljes képet lineáris kódolásból nemlineáris sRGB-kódolásba alakítja. Csak [constant FORMAT_RGB8] vagy [constant FORMAT_RGBA8] formátumú képeken működik."

#. Image.load_dds_from_buffer
#: doc/classes/Image.xml
msgid "Loads an image from the binary contents of a DDS file.\n[b]Note:[/b] This method is only available in engine builds with the DDS module enabled. By default, the DDS module is enabled, but it can be disabled at build-time using the [code]module_dds_enabled=no[/code] SCons option."
msgstr "DDS-fájl bináris tartalmából tölti be a képet.\n[b]Megjegyzés:[/b] A metódus csak a DDS-modult tartalmazó motorverziókban érhető el. A modul alapértelmezésben engedélyezve van, de a motor összeállításakor a [code]module_dds_enabled=no[/code] SCons-beállítással kikapcsolható."

#. Image.load_exr_from_buffer
#: doc/classes/Image.xml
msgid "Loads an image from the binary contents of an OpenEXR file."
msgstr "OpenEXR-fájl bináris tartalmából tölti be a képet."

#. Image.load_from_file
#: doc/classes/Image.xml
msgid "Creates a new [Image] and loads data from the specified file."
msgstr "Új [Image] erőforrást hoz létre, és betölti a megadott fájl adatait."

#. Image.load_jpg_from_buffer
#: doc/classes/Image.xml
msgid "Loads an image from the binary contents of a JPEG file."
msgstr "JPEG-fájl bináris tartalmából tölti be a képet."

#. Image.load_png_from_buffer
#: doc/classes/Image.xml
msgid "Loads an image from the binary contents of a PNG file."
msgstr "PNG-fájl bináris tartalmából tölti be a képet."

#. Image.load_tga_from_buffer
#: doc/classes/Image.xml
msgid "Loads an image from the binary contents of a TGA file.\n[b]Note:[/b] This method is only available in engine builds with the TGA module enabled. By default, the TGA module is enabled, but it can be disabled at build-time using the [code]module_tga_enabled=no[/code] SCons option."
msgstr "TGA-fájl bináris tartalmából tölti be a képet.\n[b]Megjegyzés:[/b] A metódus csak a TGA-modult tartalmazó motorverziókban érhető el. A modul alapértelmezésben engedélyezve van, de a motor összeállításakor a [code]module_tga_enabled=no[/code] SCons-beállítással kikapcsolható."

#. Image.load_webp_from_buffer
#: doc/classes/Image.xml
msgid "Loads an image from the binary contents of a WebP file."
msgstr "WebP-fájl bináris tartalmából tölti be a képet."

#. Image.premultiply_alpha
#: doc/classes/Image.xml
msgid "Multiplies color values with alpha values. Resulting color values for a pixel are [code](color * alpha)/256[/code]. See also [member CanvasItemMaterial.blend_mode]."
msgstr "A színértékeket megszorozza az alfaértékekkel. A képpont eredményül kapott színértékei [code](color * alpha)/256[/code]. Lásd még: [member CanvasItemMaterial.blend_mode]."

#. Image.rgbe_to_srgb
#: doc/classes/Image.xml
msgid "Converts a standard linear RGBE (Red Green Blue Exponent) image to an image that uses nonlinear sRGB encoding."
msgstr "Szabványos lineáris RGBE (vörös, zöld, kék, kitevő) képet nemlineáris sRGB-kódolású képpé alakít."

#. Image.save_png
#: doc/classes/Image.xml
msgid "Saves the image as a PNG file to the file at [param path]."
msgstr "A képet PNG-fájlként menti a [param path] útvonalra."

#. Image.save_png_to_buffer
#: doc/classes/Image.xml
msgid "Saves the image as a PNG file to a byte array."
msgstr "A képet PNG-formátumban bájttömbbe menti."

#. Image.set_data
#: doc/classes/Image.xml
msgid "Overwrites data of an existing [Image]. Non-static equivalent of [method create_from_data]."
msgstr "Felülírja egy meglévő [Image] adatait. A [method create_from_data] példányon meghívható megfelelője."

#. Image.shrink_x2
#: doc/classes/Image.xml
msgid "Shrinks the image by a factor of 2 on each axis (this divides the pixel count by 4)."
msgstr "Mindkét tengely mentén felére csökkenti a kép méretét, így negyedannyi képpont marad."

#. Image.data
#: doc/classes/Image.xml
msgid "Holds all the image's color data in a given format. See [enum Format] constants."
msgstr "A kép összes színadatát tárolja egy meghatározott formátumban. Lásd az [enum Format] felsorolás állandóit."

#. Image.MAX_WIDTH
#: doc/classes/Image.xml
msgid "The maximal width allowed for [Image] resources."
msgstr "Az [Image] erőforrások megengedett legnagyobb szélessége."

#. Image.MAX_HEIGHT
#: doc/classes/Image.xml
msgid "The maximal height allowed for [Image] resources."
msgstr "Az [Image] erőforrások megengedett legnagyobb magassága."

#. Image.FORMAT_LA8
#: doc/classes/Image.xml
msgid "OpenGL texture format with two values, luminance and alpha each stored with 8 bits."
msgstr "Két összetevős OpenGL-textúraformátum. A fénysűrűséget és az alfaértéket is 8 biten tárolja."

#. Image.FORMAT_R8
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]RED[/code] with a single component and a bitdepth of 8."
msgstr "[code]RED[/code] OpenGL-textúraformátum, egyetlen 8 bites összetevővel."

#. Image.FORMAT_RG8
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]RG[/code] with two components and a bitdepth of 8 for each."
msgstr "[code]RG[/code] OpenGL-textúraformátum, két összetevővel, összetevőnként 8 bittel."

#. Image.FORMAT_RGB8
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]RGB[/code] with three components, each with a bitdepth of 8.\n[b]Note:[/b] When creating an [ImageTexture], a nonlinear sRGB to linear encoding conversion is performed."
msgstr "[code]RGB[/code] OpenGL-textúraformátum, három összetevővel, összetevőnként 8 bittel.\n[b]Megjegyzés:[/b] Egy [ImageTexture] létrehozásakor a nemlineáris sRGB-kódolás lineáris kódolássá alakul."

#. Image.FORMAT_RGBA8
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]RGBA[/code] with four components, each with a bitdepth of 8.\n[b]Note:[/b] When creating an [ImageTexture], a nonlinear sRGB to linear encoding conversion is performed."
msgstr "[code]RGBA[/code] OpenGL-textúraformátum, négy összetevővel, összetevőnként 8 bittel.\n[b]Megjegyzés:[/b] Egy [ImageTexture] létrehozásakor a nemlineáris sRGB-kódolás lineáris kódolássá alakul."

#. Image.FORMAT_RGBA4444
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]RGBA[/code] with four components, each with a bitdepth of 4."
msgstr "[code]RGBA[/code] OpenGL-textúraformátum, négy összetevővel, összetevőnként 4 bittel."

#. Image.FORMAT_RGB565
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]RGB[/code] with three components. Red and blue have a bitdepth of 5, and green has a bitdepth of 6."
msgstr "[code]RGB[/code] OpenGL-textúraformátum három összetevővel. A vörös és a kék összetevő 5 bites, a zöld 6 bites."

#. Image.FORMAT_RF
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]GL_R32F[/code] where there's one component, a 32-bit floating-point value."
msgstr "[code]GL_R32F[/code] OpenGL-textúraformátum, egyetlen 32 bites lebegőpontos összetevővel."

#. Image.FORMAT_RGF
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]GL_RG32F[/code] where there are two components, each a 32-bit floating-point values."
msgstr "[code]GL_RG32F[/code] OpenGL-textúraformátum, két 32 bites lebegőpontos összetevővel."

#. Image.FORMAT_RGBF
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]GL_RGB32F[/code] where there are three components, each a 32-bit floating-point values."
msgstr "[code]GL_RGB32F[/code] OpenGL-textúraformátum, három 32 bites lebegőpontos összetevővel."

#. Image.FORMAT_RGBAF
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]GL_RGBA32F[/code] where there are four components, each a 32-bit floating-point values."
msgstr "[code]GL_RGBA32F[/code] OpenGL-textúraformátum, négy 32 bites lebegőpontos összetevővel."

#. Image.FORMAT_RH
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]GL_R16F[/code] where there's one component, a 16-bit \"half-precision\" floating-point value."
msgstr "[code]GL_R16F[/code] OpenGL-textúraformátum, egyetlen 16 bites, félpontosságú lebegőpontos összetevővel."

#. Image.FORMAT_RGH
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]GL_RG16F[/code] where there are two components, each a 16-bit \"half-precision\" floating-point value."
msgstr "[code]GL_RG16F[/code] OpenGL-textúraformátum, két 16 bites, félpontosságú lebegőpontos összetevővel."

#. Image.FORMAT_RGBH
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]GL_RGB16F[/code] where there are three components, each a 16-bit \"half-precision\" floating-point value."
msgstr "[code]GL_RGB16F[/code] OpenGL-textúraformátum, három 16 bites, félpontosságú lebegőpontos összetevővel."

#. Image.FORMAT_RGBAH
#: doc/classes/Image.xml
msgid "OpenGL texture format [code]GL_RGBA16F[/code] where there are four components, each a 16-bit \"half-precision\" floating-point value."
msgstr "[code]GL_RGBA16F[/code] OpenGL-textúraformátum, négy 16 bites, félpontosságú lebegőpontos összetevővel."

#. Image.FORMAT_RGBE9995
#: doc/classes/Image.xml
msgid "A special OpenGL texture format where the three color components have 9 bits of precision and all three share a single 5-bit exponent."
msgstr "Speciális OpenGL-textúraformátum, amelyben a három színösszetevő egyenként 9 bites, és közös 5 bites kitevőt használ."

#. Image.FORMAT_RGTC_R
#: doc/classes/Image.xml
msgid "Texture format that uses [url=https://www.khronos.org/opengl/wiki/Red_Green_Texture_Compression]Red Green Texture Compression[/url], normalizing the red channel data using the same compression algorithm that DXT5 uses for the alpha channel."
msgstr "[url=https://www.khronos.org/opengl/wiki/Red_Green_Texture_Compression]Red Green Texture Compression[/url] tömörítésű textúraformátum. A vörös csatornát ugyanazzal az algoritmussal normálja, amelyet a DXT5 az alfa-csatornához használ."

#. Image.FORMAT_RGTC_RG
#: doc/classes/Image.xml
msgid "Texture format that uses [url=https://www.khronos.org/opengl/wiki/Red_Green_Texture_Compression]Red Green Texture Compression[/url], normalizing the red and green channel data using the same compression algorithm that DXT5 uses for the alpha channel."
msgstr "[url=https://www.khronos.org/opengl/wiki/Red_Green_Texture_Compression]Red Green Texture Compression[/url] tömörítésű textúraformátum. A vörös és zöld csatornát ugyanazzal az algoritmussal normálja, amelyet a DXT5 az alfa-csatornához használ."

#. Image.FORMAT_BPTC_RGBA
#: doc/classes/Image.xml
msgid "Texture format that uses [url=https://www.khronos.org/opengl/wiki/BPTC_Texture_Compression]BPTC[/url] compression with unsigned normalized RGBA components.\n[b]Note:[/b] When creating an [ImageTexture], a nonlinear sRGB to linear encoding conversion is performed."
msgstr "[url=https://www.khronos.org/opengl/wiki/BPTC_Texture_Compression]BPTC[/url]-tömörítést használó textúraformátum előjel nélküli, normált RGBA-összetevőkkel.\n[b]Megjegyzés:[/b] Egy [ImageTexture] létrehozásakor a nemlineáris sRGB-kódolás lineáris kódolássá alakul."

#. Image.FORMAT_BPTC_RGBF
#: doc/classes/Image.xml
msgid "Texture format that uses [url=https://www.khronos.org/opengl/wiki/BPTC_Texture_Compression]BPTC[/url] compression with signed floating-point RGB components."
msgstr "[url=https://www.khronos.org/opengl/wiki/BPTC_Texture_Compression]BPTC[/url]-tömörítést használó textúraformátum előjeles, lebegőpontos RGB-összetevőkkel."

#. Image.FORMAT_BPTC_RGBFU
#: doc/classes/Image.xml
msgid "Texture format that uses [url=https://www.khronos.org/opengl/wiki/BPTC_Texture_Compression]BPTC[/url] compression with unsigned floating-point RGB components."
msgstr "[url=https://www.khronos.org/opengl/wiki/BPTC_Texture_Compression]BPTC[/url]-tömörítést használó textúraformátum előjel nélküli, lebegőpontos RGB-összetevőkkel."

#. Image.FORMAT_ETC
#: doc/classes/Image.xml
msgid "[url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC1]Ericsson Texture Compression format 1[/url], also referred to as \"ETC1\", and is part of the OpenGL ES graphics standard. This format cannot store an alpha channel."
msgstr "Az [url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC1]Ericsson Texture Compression 1[/url], röviden ETC1, az OpenGL ES grafikus szabvány része. A formátum nem tud alfa-csatornát tárolni."

#. Image.FORMAT_ETC2_R11
#: doc/classes/Image.xml
msgid "[url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC2_and_EAC]Ericsson Texture Compression format 2[/url] ([code]R11_EAC[/code] variant), which provides one channel of unsigned data."
msgstr "Az [url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC2_and_EAC]Ericsson Texture Compression 2[/url] formátum [code]R11_EAC[/code] változata, egy előjel nélküli adatcsatornával."

#. Image.FORMAT_ETC2_R11S
#: doc/classes/Image.xml
msgid "[url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC2_and_EAC]Ericsson Texture Compression format 2[/url] ([code]SIGNED_R11_EAC[/code] variant), which provides one channel of signed data."
msgstr "Az [url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC2_and_EAC]Ericsson Texture Compression 2[/url] formátum [code]SIGNED_R11_EAC[/code] változata, egy előjeles adatcsatornával."

#. Image.FORMAT_ETC2_RG11
#: doc/classes/Image.xml
msgid "[url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC2_and_EAC]Ericsson Texture Compression format 2[/url] ([code]RG11_EAC[/code] variant), which provides two channels of unsigned data."
msgstr "Az [url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC2_and_EAC]Ericsson Texture Compression 2[/url] formátum [code]RG11_EAC[/code] változata, két előjel nélküli adatcsatornával."

#. Image.FORMAT_ETC2_RG11S
#: doc/classes/Image.xml
msgid "[url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC2_and_EAC]Ericsson Texture Compression format 2[/url] ([code]SIGNED_RG11_EAC[/code] variant), which provides two channels of signed data."
msgstr "Az [url=https://en.wikipedia.org/wiki/Ericsson_Texture_Compression#ETC2_and_EAC]Ericsson Texture Compression 2[/url] formátum [code]SIGNED_RG11_EAC[/code] változata, két előjeles adatcsatornával."

#. Image.FORMAT_ASTC_4x4
#: doc/classes/Image.xml
msgid "[url=https://en.wikipedia.org/wiki/Adaptive_scalable_texture_compression]Adaptive Scalable Texture Compression[/url]. This implements the 4×4 (high quality) mode."
msgstr "Az [url=https://en.wikipedia.org/wiki/Adaptive_scalable_texture_compression]Adaptive Scalable Texture Compression[/url] jó minőségű, 4×4-es módja."

#. Image.FORMAT_ASTC_4x4_HDR
#: doc/classes/Image.xml
msgid "Same format as [constant FORMAT_ASTC_4x4], but with the hint to let the GPU know it is used for HDR."
msgstr "A [constant FORMAT_ASTC_4x4] formátummal azonos, de a GPU jelzést kap a HDR-használatról."

#. Image.FORMAT_ASTC_8x8
#: doc/classes/Image.xml
msgid "[url=https://en.wikipedia.org/wiki/Adaptive_scalable_texture_compression]Adaptive Scalable Texture Compression[/url]. This implements the 8×8 (low quality) mode."
msgstr "Az [url=https://en.wikipedia.org/wiki/Adaptive_scalable_texture_compression]Adaptive Scalable Texture Compression[/url] kisebb minőségű, 8×8-as módja."

#. Image.FORMAT_ASTC_8x8_HDR
#: doc/classes/Image.xml
msgid "Same format as [constant FORMAT_ASTC_8x8], but with the hint to let the GPU know it is used for HDR."
msgstr "A [constant FORMAT_ASTC_8x8] formátummal azonos, de a GPU jelzést kap a HDR-használatról."

#. Image.INTERPOLATE_NEAREST
#: doc/classes/Image.xml
msgid "Performs nearest-neighbor interpolation. If the image is resized, it will be pixelated."
msgstr "Legközelebbi szomszéd szerinti interpoláció. Átméretezéskor a kép pixelesnek látszik."

#. Image.INTERPOLATE_BILINEAR
#: doc/classes/Image.xml
msgid "Performs bilinear interpolation. If the image is resized, it will be blurry. This mode is faster than [constant INTERPOLATE_CUBIC], but it results in lower quality."
msgstr "Bilineáris interpoláció. Átméretezéskor a kép elmosódik. Gyorsabb a [constant INTERPOLATE_CUBIC] módnál, de kisebb képminőséget ad."

#. Image.INTERPOLATE_CUBIC
#: doc/classes/Image.xml
msgid "Performs cubic interpolation. If the image is resized, it will be blurry. This mode often gives better results compared to [constant INTERPOLATE_BILINEAR], at the cost of being slower."
msgstr "Köbös interpoláció. Átméretezéskor a kép elmosódik. Gyakran jobb eredményt ad a [constant INTERPOLATE_BILINEAR] módnál, de lassabb."

#. Image.INTERPOLATE_LANCZOS
#: doc/classes/Image.xml
msgid "Performs Lanczos interpolation. This is the slowest image resizing mode, but it typically gives the best results, especially when downscaling images."
msgstr "Lanczos-interpoláció. Ez a leglassabb átméretezési mód, de rendszerint a legjobb eredményt adja, különösen kicsinyítéskor."

#. Image.ALPHA_NONE
#: doc/classes/Image.xml
msgid "Image is fully opaque. It does not store alpha data."
msgstr "A kép teljesen átlátszatlan. Nem tárol alfaadatot."

#. Image.ALPHA_BIT
#: doc/classes/Image.xml
msgid "Image stores either fully opaque or fully transparent pixels. Also known as punchthrough alpha."
msgstr "A képpontok vagy teljesen átlátszatlanok, vagy teljesen átlátszók. Ezt kivágásos alfának is nevezik."

#. Image.ALPHA_BLEND
#: doc/classes/Image.xml
msgid "Image stores alpha data with values varying between [code]0.0[/code] and [code]1.0[/code]."
msgstr "A kép [code]0.0[/code] és [code]1.0[/code] közötti alfaértékeket tárol."

#. Image.USED_CHANNELS_L
#: doc/classes/Image.xml
msgid "The image only uses one channel for luminance (grayscale)."
msgstr "A kép egyetlen fénysűrűség-csatornát használ, így szürkeárnyalatos."

#. Image.USED_CHANNELS_LA
#: doc/classes/Image.xml
msgid "The image uses two channels for luminance and alpha, respectively."
msgstr "A kép két csatornát használ, egyet a fénysűrűséghez és egyet az alfaértékhez."

#. Image.USED_CHANNELS_R
#: doc/classes/Image.xml
msgid "The image only uses the red channel."
msgstr "A kép csak a vörös csatornát használja."

#. Image.USED_CHANNELS_RG
#: doc/classes/Image.xml
msgid "The image uses two channels for red and green."
msgstr "A kép két csatornát használ, a vöröset és a zöldet."

#. Image.USED_CHANNELS_RGB
#: doc/classes/Image.xml
msgid "The image uses three channels for red, green, and blue."
msgstr "A kép három csatornát használ, a vöröset, a zöldet és a kéket."

#. Image.USED_CHANNELS_RGBA
#: doc/classes/Image.xml
msgid "The image uses four channels for red, green, blue, and alpha."
msgstr "A kép négy csatornát használ, a vöröset, a zöldet, a kéket és az alfa-csatornát."

#. Image.COMPRESS_SOURCE_SRGB
#: doc/classes/Image.xml
msgid "Source texture (before compression) uses nonlinear sRGB encoding."
msgstr "A tömörítés előtti forrástextúra nemlineáris sRGB-kódolású."

#. Image.COMPRESS_SOURCE_NORMAL
#: doc/classes/Image.xml
msgid "Source texture (before compression) is a normal texture (e.g. it can be compressed into two channels)."
msgstr "A tömörítés előtti forrástextúra normáltérkép, amely például két csatornába tömöríthető."

#. ImageFormatLoader.description
#: doc/classes/ImageFormatLoader.xml
msgid "The engine supports multiple image formats out of the box (PNG, SVG, JPEG, WebP to name a few), but you can choose to implement support for additional image formats by extending [ImageFormatLoaderExtension]."
msgstr "A motor alapból több képformátumot támogat, például a PNG-t, az SVG-t, a JPEG-et és a WebP-t. További képformátumokhoz az [ImageFormatLoaderExtension] osztály leszármazottjában valósítható meg a támogatás."

#. ImageFormatLoaderExtension.brief
#: doc/classes/ImageFormatLoaderExtension.xml
msgid "Base class for creating [ImageFormatLoader] extensions (adding support for extra image formats)."
msgstr "Az [ImageFormatLoader] bővítményeinek alaposztálya további képformátumok támogatásához."

#. ImageFormatLoaderExtension._get_recognized_extensions
#: doc/classes/ImageFormatLoaderExtension.xml
msgid "Returns the list of file extensions for this image format. Files with the given extensions will be treated as image file and loaded using this class."
msgstr "Visszaadja a képformátum fájlkiterjesztéseit. A megadott kiterjesztésű fájlok képfájlnak számítanak, és ezzel az osztállyal töltődnek be."

#. ImageFormatLoaderExtension._load_image
#: doc/classes/ImageFormatLoaderExtension.xml
msgid "Loads the content of [param fileaccess] into the provided [param image]."
msgstr "Betölti a [param fileaccess] tartalmát a megadott [param image] képbe."

#. ImageFormatLoaderExtension.add_format_loader
#: doc/classes/ImageFormatLoaderExtension.xml
msgid "Add this format loader to the engine, allowing it to recognize the file extensions returned by [method _get_recognized_extensions]."
msgstr "Hozzáadja ezt a formátumbetöltőt a motorhoz. Ezzel a motor felismeri a [method _get_recognized_extensions] által visszaadott fájlkiterjesztéseket."

#. ImageFormatLoaderExtension.remove_format_loader
#: doc/classes/ImageFormatLoaderExtension.xml
msgid "Remove this format loader from the engine."
msgstr "Eltávolítja ezt a formátumbetöltőt a motorból."

#. Color.brief
#: doc/classes/Color.xml
msgid "A color represented in RGBA format."
msgstr "RGBA-formátumban ábrázolt szín."

#. Color.Color
#: doc/classes/Color.xml
msgid "Constructs a default [Color] from opaque black. This is the same as [constant BLACK].\n[b]Note:[/b] In C#, this constructs a [Color] with all of its components set to [code]0.0[/code] (transparent black)."
msgstr "Fedő feketéből alapértelmezett [Color] értéket hoz létre. Ez a [constant BLACK] értékkel egyezik meg.\n[b]Megjegyzés:[/b] C#-ban olyan [Color] értéket hoz létre, amelynek minden összetevője [code]0.0[/code] (átlátszó fekete)."

#. Color.Color
#: doc/classes/Color.xml
msgid "Constructs a [Color] from the existing color, with [member a] set to the given [param alpha] value.\n[codeblocks]\n[gdscript]\nvar red = Color(Color.RED, 0.2) # 20% opaque red.\n[/gdscript]\n[csharp]\nvar red = new Color(Colors.Red, 0.2f); // 20% opaque red.\n[/csharp]\n[/codeblocks]"
msgstr "A meglévő színből [Color] értéket hoz létre, amelynek [member a] összetevője a megadott [param alpha] lesz.\n[codeblocks]\n[gdscript]\nvar red = Color(Color.RED, 0.2) # 20% opaque red.\n[/gdscript]\n[csharp]\nvar red = new Color(Colors.Red, 0.2f); // 20% opaque red.\n[/csharp]\n[/codeblocks]"

#. Color.Color
#: doc/classes/Color.xml
msgid "Constructs a [Color] as a copy of the given [Color]."
msgstr "A megadott [Color] másolataként új [Color] értéket hoz létre."

#. Color.Color
#: doc/classes/Color.xml
msgid "Constructs a [Color] either from an HTML color code or from a standardized color name. The supported color names are the same as the constants."
msgstr "HTML-színkódból vagy szabványos színnévből [Color] értéket hoz létre. A támogatott színnevek megegyeznek az állandók neveivel."

#. Color.Color
#: doc/classes/Color.xml
msgid "Constructs a [Color] either from an HTML color code or from a standardized color name, with [param alpha] on the range of 0.0 to 1.0. The supported color names are the same as the constants."
msgstr "HTML-színkódból vagy szabványos színnévből [Color] értéket hoz létre, 0.0 és 1.0 közötti [param alpha] értékkel. A támogatott színnevek megegyeznek az állandók neveivel."

#. Color.clamp
#: doc/classes/Color.xml
msgid "Returns a new color with all components clamped between the components of [param min] and [param max], by running [method @GlobalScope.clamp] on each component."
msgstr "Új színt ad vissza. Minden összetevőt a [param min] és a [param max] megfelelő összetevői közé korlátoz a [method @GlobalScope.clamp] függvénnyel."

#. Color.darkened
#: doc/classes/Color.xml
msgid "Returns a new color resulting from making this color darker by the specified [param amount] (ratio from 0.0 to 1.0). See also [method lightened].\n[codeblocks]\n[gdscript]\nvar green = Color(0.0, 1.0, 0.0)\nvar darkgreen = green.darkened(0.2) # 20% darker than regular green\n[/gdscript]\n[csharp]\nvar green = new Color(0.0f, 1.0f, 0.0f);\nColor darkgreen = green.Darkened(0.2f); // 20% darker than regular green\n[/csharp]\n[/codeblocks]"
msgstr "A megadott [param amount] mértékben sötétített új színt ad vissza. A mérték 0.0 és 1.0 közötti arány. Lásd még: [method lightened].\n[codeblocks]\n[gdscript]\nvar green = Color(0.0, 1.0, 0.0)\nvar darkgreen = green.darkened(0.2) # 20% darker than regular green\n[/gdscript]\n[csharp]\nvar green = new Color(0.0f, 1.0f, 0.0f);\nColor darkgreen = green.Darkened(0.2f); // 20% darker than regular green\n[/csharp]\n[/codeblocks]"

#. Color.from_hsv
#: doc/classes/Color.xml
msgid "Constructs a color from an [url=https://en.wikipedia.org/wiki/HSL_and_HSV]HSV profile[/url]. The hue ([param h]), saturation ([param s]), and value ([param v]) are typically between 0.0 and 1.0.\n[codeblocks]\n[gdscript]\nvar color = Color.from_hsv(0.58, 0.5, 0.79, 0.8)\n[/gdscript]\n[csharp]\nvar color = Color.FromHsv(0.58f, 0.5f, 0.79f, 0.8f);\n[/csharp]\n[/codeblocks]"
msgstr "[url=https://en.wikipedia.org/wiki/HSL_and_HSV]HSV-profilból[/url] hoz létre színt. A színárnyalat ([param h]), a telítettség ([param s]) és a világossági érték ([param v]) általában 0.0 és 1.0 közé esik.\n[codeblocks]\n[gdscript]\nvar color = Color.from_hsv(0.58, 0.5, 0.79, 0.8)\n[/gdscript]\n[csharp]\nvar color = Color.FromHsv(0.58f, 0.5f, 0.79f, 0.8f);\n[/csharp]\n[/codeblocks]"

#. Color.from_ok_hsl
#: doc/classes/Color.xml
msgid "Constructs a color from an [url=https://bottosson.github.io/posts/colorpicker/]OK HSL profile[/url]. The hue ([param h]), saturation ([param s]), and lightness ([param l]) are typically between 0.0 and 1.0.\n[codeblocks]\n[gdscript]\nvar color = Color.from_ok_hsl(0.58, 0.5, 0.79, 0.8)\n[/gdscript]\n[csharp]\nvar color = Color.FromOkHsl(0.58f, 0.5f, 0.79f, 0.8f);\n[/csharp]\n[/codeblocks]"
msgstr "[url=https://bottosson.github.io/posts/colorpicker/]OK HSL-profilból[/url] hoz létre színt. A színárnyalat ([param h]), a telítettség ([param s]) és a világosság ([param l]) általában 0.0 és 1.0 közé esik.\n[codeblocks]\n[gdscript]\nvar color = Color.from_ok_hsl(0.58, 0.5, 0.79, 0.8)\n[/gdscript]\n[csharp]\nvar color = Color.FromOkHsl(0.58f, 0.5f, 0.79f, 0.8f);\n[/csharp]\n[/codeblocks]"

#. Color.from_rgbe9995
#: doc/classes/Color.xml
msgid "Decodes a [Color] from an RGBE9995 format integer. See [constant Image.FORMAT_RGBE9995]."
msgstr "RGBE9995 formátumú egész számból [Color] értéket dekódol. Lásd: [constant Image.FORMAT_RGBE9995]."

#. Color.from_string
#: doc/classes/Color.xml
msgid "Creates a [Color] from the given string, which can be either an HTML color code or a named color (case-insensitive). Returns [param default] if the color cannot be inferred from the string.\nIf you want to create a color from String in a constant expression, use the equivalent constructor instead (i.e. [code]Color(\"color string\")[/code])."
msgstr "A megadott karakterláncból [Color] értéket hoz létre. A karakterlánc HTML-színkód vagy színnév lehet, a kis- és nagybetűk megkülönböztetése nélkül. Ha a szín nem ismerhető fel, [param default] értéket ad vissza.\nHa konstans kifejezésben szeretnél karakterláncból színt létrehozni, használd az egyenértékű konstruktort ([code]Color(\"color string\")[/code])."

#. Color.is_equal_approx
#: doc/classes/Color.xml
msgid "Returns [code]true[/code] if this color and [param to] are approximately equal, by running [method @GlobalScope.is_equal_approx] on each component."
msgstr "[code]true[/code] értéket ad vissza, ha ez a szín és a [param to] közel egyenlők. Összetevőnként a [method @GlobalScope.is_equal_approx] függvényt használja."

#. Color.lightened
#: doc/classes/Color.xml
msgid "Returns a new color resulting from making this color lighter by the specified [param amount], which should be a ratio from 0.0 to 1.0. See also [method darkened].\n[codeblocks]\n[gdscript]\nvar green = Color(0.0, 1.0, 0.0)\nvar light_green = green.lightened(0.2) # 20% lighter than regular green\n[/gdscript]\n[csharp]\nvar green = new Color(0.0f, 1.0f, 0.0f);\nColor lightGreen = green.Lightened(0.2f); // 20% lighter than regular green\n[/csharp]\n[/codeblocks]"
msgstr "A megadott [param amount] mértékben világosított új színt ad vissza. A mérték 0.0 és 1.0 közötti arány legyen. Lásd még: [method darkened].\n[codeblocks]\n[gdscript]\nvar green = Color(0.0, 1.0, 0.0)\nvar light_green = green.lightened(0.2) # 20% lighter than regular green\n[/gdscript]\n[csharp]\nvar green = new Color(0.0f, 1.0f, 0.0f);\nColor lightGreen = green.Lightened(0.2f); // 20% lighter than regular green\n[/csharp]\n[/codeblocks]"

#. Color.linear_to_srgb
#: doc/classes/Color.xml
msgid "Returns a copy of the color that is encoded using the [url=https://en.wikipedia.org/wiki/SRGB]nonlinear sRGB transfer function[/url]. This method requires the original color to use linear encoding. See also [method srgb_to_linear] which performs the opposite operation.\n[b]Note:[/b] The color's alpha channel ([member a]) is not affected. The alpha channel is always stored with linear encoding, regardless of the color space of the other color channels."
msgstr "A szín [url=https://en.wikipedia.org/wiki/SRGB]nemlineáris sRGB átviteli függvénnyel[/url] kódolt másolatát adja vissza. Az eredeti színnek lineáris kódolásúnak kell lennie. Az ellenkező művelethez lásd a [method srgb_to_linear] metódust.\n[b]Megjegyzés:[/b] A szín alfa-csatornája ([member a]) változatlan marad. Az alfa-csatorna a többi színcsatorna színterétől függetlenül mindig lineáris kódolású."

#. Color.srgb_to_linear
#: doc/classes/Color.xml
msgid "Returns a copy of the color that uses linear encoding. This method requires the original color to be encoded using the [url=https://en.wikipedia.org/wiki/SRGB]nonlinear sRGB transfer function[/url]. See also [method linear_to_srgb] which performs the opposite operation.\n[b]Note:[/b] The color's alpha channel ([member a]) is not affected. The alpha channel is always stored with linear encoding, regardless of the color space of the other color channels."
msgstr "A szín lineáris kódolású másolatát adja vissza. Az eredeti színnek a [url=https://en.wikipedia.org/wiki/SRGB]nemlineáris sRGB átviteli függvényt[/url] kell használnia. Az ellenkező művelethez lásd a [method linear_to_srgb] metódust.\n[b]Megjegyzés:[/b] A szín alfa-csatornája ([member a]) változatlan marad. Az alfa-csatorna a többi színcsatorna színterétől függetlenül mindig lineáris kódolású."

#. Color.operator *
#: doc/classes/Color.xml
msgid "Multiplies each component of the [Color] by the components of the given [Color]."
msgstr "A [Color] minden összetevőjét megszorozza a megadott [Color] megfelelő összetevőjével."

#. Color.operator *
#: doc/classes/Color.xml
msgid "Multiplies each component of the [Color] by the given [float]."
msgstr "A [Color] minden összetevőjét megszorozza a megadott [float] értékkel."

#. Color.operator *
#: doc/classes/Color.xml
msgid "Multiplies each component of the [Color] by the given [int]."
msgstr "A [Color] minden összetevőjét megszorozza a megadott [int] értékkel."

#. Color.operator +
#: doc/classes/Color.xml
msgid "Adds each component of the [Color] with the components of the given [Color]."
msgstr "A [Color] minden összetevőjéhez hozzáadja a megadott [Color] megfelelő összetevőjét."

#. Color.operator -
#: doc/classes/Color.xml
msgid "Subtracts each component of the [Color] by the components of the given [Color]."
msgstr "A [Color] minden összetevőjéből kivonja a megadott [Color] megfelelő összetevőjét."

#. Color.operator /
#: doc/classes/Color.xml
msgid "Divides each component of the [Color] by the components of the given [Color]."
msgstr "A [Color] minden összetevőjét elosztja a megadott [Color] megfelelő összetevőjével."

#. Color.operator /
#: doc/classes/Color.xml
msgid "Divides each component of the [Color] by the given [float]."
msgstr "A [Color] minden összetevőjét elosztja a megadott [float] értékkel."

#. Color.operator /
#: doc/classes/Color.xml
msgid "Divides each component of the [Color] by the given [int]."
msgstr "A [Color] minden összetevőjét elosztja a megadott [int] értékkel."

#. Color.operator []
#: doc/classes/Color.xml
msgid "Access color components using their index. [code][0][/code] is equivalent to [member r], [code][1][/code] is equivalent to [member g], [code][2][/code] is equivalent to [member b], and [code][3][/code] is equivalent to [member a]."
msgstr "A színösszetevőket index alapján éri el. A [code][0][/code] az [member r], a [code][1][/code] a [member g], a [code][2][/code] a [member b], a [code][3][/code] pedig az [member a] megfelelője."

