msgstr "Bemeneti csomópontként használható [Vector2] állandó."

#. VisualShaderNodeVec2Constant.constant
#: modules/visual_shader/doc_classes/VisualShaderNodeVec2Constant.xml
msgid "A [Vector2] constant which represents the state of this node."
msgstr "A csomópont állapotát meghatározó [Vector2] állandó."

#. VisualShaderNodeVec2Parameter.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVec2Parameter.xml
msgid "A [Vector2] parameter to be used within the visual shader graph."
msgstr "[Vector2] típusú paraméter a vizuális shadergráfhoz."

#. VisualShaderNodeVec2Parameter.description
#: modules/visual_shader/doc_classes/VisualShaderNodeVec2Parameter.xml
msgid "Translated to [code]uniform vec2[/code] in the shader language."
msgstr "A shaderkódban a [code]uniform vec2[/code] deklarációnak felel meg."

#. VisualShaderNodeVec3Constant.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVec3Constant.xml
msgid "A [Vector3] constant to be used within the visual shader graph."
msgstr "[Vector3] típusú állandó a vizuális shadergráfhoz."

#. VisualShaderNodeVec3Constant.description
#: modules/visual_shader/doc_classes/VisualShaderNodeVec3Constant.xml
msgid "A constant [Vector3], which can be used as an input node."
msgstr "Bemeneti csomópontként használható [Vector3] állandó."

#. VisualShaderNodeVec3Constant.constant
#: modules/visual_shader/doc_classes/VisualShaderNodeVec3Constant.xml
msgid "A [Vector3] constant which represents the state of this node."
msgstr "A csomópont állapotát meghatározó [Vector3] állandó."

#. VisualShaderNodeVec3Parameter.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVec3Parameter.xml
msgid "A [Vector3] parameter to be used within the visual shader graph."
msgstr "[Vector3] típusú paraméter a vizuális shadergráfhoz."

#. VisualShaderNodeVec3Parameter.description
#: modules/visual_shader/doc_classes/VisualShaderNodeVec3Parameter.xml
msgid "Translated to [code]uniform vec3[/code] in the shader language."
msgstr "A shaderkódban a [code]uniform vec3[/code] deklarációnak felel meg."

#. VisualShaderNodeVec4Constant.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVec4Constant.xml
msgid "A 4D vector constant to be used within the visual shader graph."
msgstr "4D-s vektorállandó a vizuális shadergráfhoz."

#. VisualShaderNodeVec4Constant.description
#: modules/visual_shader/doc_classes/VisualShaderNodeVec4Constant.xml
msgid "A constant 4D vector, which can be used as an input node."
msgstr "Bemeneti csomópontként használható 4D-s vektorállandó."

#. VisualShaderNodeVec4Constant.constant
#: modules/visual_shader/doc_classes/VisualShaderNodeVec4Constant.xml
msgid "A 4D vector (represented as a [Quaternion]) constant which represents the state of this node."
msgstr "A csomópont állapotát meghatározó 4D-s vektorállandó, amelyet [Quaternion] képvisel."

#. VisualShaderNodeVec4Parameter.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVec4Parameter.xml
msgid "A 4D vector parameter to be used within the visual shader graph."
msgstr "4D-s vektorparaméter a vizuális shadergráfhoz."

#. VisualShaderNodeVectorBase.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorBase.xml
msgid "A base type for the nodes that perform vector operations within the visual shader graph."
msgstr "A vizuális shadergráfban vektorműveleteket végző csomópontok alaptípusa."

#. VisualShaderNodeVectorBase.description
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorBase.xml
msgid "This is an abstract class. See the derived types for descriptions of the possible operations."
msgstr "Ez egy absztrakt osztály. A választható műveletek leírását a leszármazott típusokban találod."

#. VisualShaderNodeVectorBase.op_type
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorBase.xml
msgid "A vector type that this operation is performed on."
msgstr "Annak a vektornak a típusa, amelyen a művelet fut."

#. VisualShaderNodeVectorFunc.FUNC_LOG
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Natural logarithm."
msgstr "Természetes logaritmus."

#. VisualShaderNodeVectorFunc.FUNC_LOG2
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Base-2 logarithm."
msgstr "2-es alapú logaritmus."

#. VisualShaderNodeVectorFunc.FUNC_RADIANS
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Converts a quantity in degrees to radians."
msgstr "Fokban megadott értéket radiánra vált."

#. VisualShaderNodeVectorFunc.FUNC_ROUND
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Finds the nearest integer to the parameter."
msgstr "A legközelebbi egészre kerekíti az értéket."

#. VisualShaderNodeVectorFunc.FUNC_ROUNDEVEN
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Finds the nearest even integer to the parameter."
msgstr "A legközelebbi egészre kerekíti az értéket. Két egyformán közeli egész közül a párosat választja."

#. VisualShaderNodeVectorFunc.FUNC_SIGN
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Extracts the sign of the parameter, i.e. returns [code]-1[/code] if the parameter is negative, [code]1[/code] if it's positive and [code]0[/code] otherwise."
msgstr "Az érték előjelét adja vissza. Negatív értéknél az eredmény [code]-1[/code], pozitívnál [code]1[/code], nullánál [code]0[/code]."

#. VisualShaderNodeVectorFunc.FUNC_SIN
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Returns the sine of the parameter."
msgstr "Az érték szinuszát adja vissza."

#. VisualShaderNodeVectorFunc.FUNC_SINH
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Returns the hyperbolic sine of the parameter."
msgstr "Az érték hiperbolikus szinuszát adja vissza."

#. VisualShaderNodeVectorFunc.FUNC_SQRT
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Returns the square root of the parameter."
msgstr "Az érték négyzetgyökét adja vissza."

#. VisualShaderNodeVectorFunc.FUNC_TAN
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Returns the tangent of the parameter."
msgstr "Az érték tangensét adja vissza."

#. VisualShaderNodeVectorFunc.FUNC_TANH
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Returns the hyperbolic tangent of the parameter."
msgstr "Az érték hiperbolikus tangensét adja vissza."

#. VisualShaderNodeVectorFunc.FUNC_TRUNC
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Returns a value equal to the nearest integer to the parameter whose absolute value is not larger than the absolute value of the parameter."
msgstr "A tört részt elhagyva, nulla felé kerekíti az értéket egészre."

#. VisualShaderNodeVectorFunc.FUNC_ONEMINUS
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorFunc.xml
msgid "Returns [code]1.0 - vector[/code]."
msgstr "A [code]1.0 - vector[/code] értéket adja vissza."

#. VisualShaderNodeVectorLen.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorLen.xml
msgid "Returns the length of a [Vector3] within the visual shader graph."
msgstr "Egy [Vector3] vektor hosszát adja vissza a vizuális shadergráfban."

#. VisualShaderNodeVectorLen.description
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorLen.xml
msgid "Translated to [code]length(p0)[/code] in the shader language."
msgstr "A shaderkódban a [code]length(p0)[/code] hívásnak felel meg."

#. VisualShaderNodeVectorOp.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "A vector operator to be used within the visual shader graph."
msgstr "Vektorműveleti operátor a vizuális shadergráfhoz."

#. VisualShaderNodeVectorOp.description
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "A visual shader node for use of vector operators. Operates on vector [code]a[/code] and vector [code]b[/code]."
msgstr "A vizuális shadercsomópont az [code]a[/code] és a [code]b[/code] vektoron végzi el a kiválasztott műveletet."

#. VisualShaderNodeVectorOp.operator
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "The operator to be used."
msgstr "A végrehajtandó művelet."

#. VisualShaderNodeVectorOp.OP_ADD
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "Adds two vectors."
msgstr "Összeadja a két vektort."

#. VisualShaderNodeVectorOp.OP_SUB
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "Subtracts a vector from a vector."
msgstr "Kivonja az egyik vektort a másikból."

#. VisualShaderNodeVectorOp.OP_MUL
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "Multiplies two vectors."
msgstr "Komponensenként összeszorozza a két vektort."

#. VisualShaderNodeVectorOp.OP_DIV
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "Divides vector by vector."
msgstr "Komponensenként elosztja az egyik vektort a másikkal."

#. VisualShaderNodeVectorOp.OP_MOD
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "Returns the remainder of the two vectors."
msgstr "Komponensenként modulóműveletet végez az első értéken a második értékkel."

#. VisualShaderNodeVectorOp.OP_POW
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "Returns the value of the first parameter raised to the power of the second, for each component of the vectors."
msgstr "Komponensenként a második érték hatványára emeli az elsőt."

#. VisualShaderNodeVectorOp.OP_MAX
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "Returns the greater of two values, for each component of the vectors."
msgstr "Minden komponenshez a két érték közül a nagyobbat adja vissza."

#. VisualShaderNodeVectorOp.OP_MIN
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorOp.xml
msgid "Returns the lesser of two values, for each component of the vectors."
msgstr "Minden komponenshez a két érték közül a kisebbet adja vissza."

#. VisualShaderNodeVectorRefract.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorRefract.xml
msgid "Returns the vector that points in the direction of refraction. For use within the visual shader graph."
msgstr "A fénytörés irányába mutató vektort adja vissza a vizuális shadergráfban."

#. VisualShaderNodeVectorRefract.description
#: modules/visual_shader/doc_classes/VisualShaderNodeVectorRefract.xml
msgid "Translated to [code]refract(I, N, eta)[/code] in the shader language, where [code]I[/code] is the incident vector, [code]N[/code] is the normal vector and [code]eta[/code] is the ratio of the indices of the refraction."
msgstr "A shaderkódban a [code]refract(I, N, eta)[/code] hívásnak felel meg. Az [code]I[/code] a beeső vektor, az [code]N[/code] a felületi normálvektor, az [code]eta[/code] pedig a törésmutatók aránya."

#. VisualShaderNodeWorldPositionFromDepth.brief
#: modules/visual_shader/doc_classes/VisualShaderNodeWorldPositionFromDepth.xml
msgid "A visual shader node that calculates the position of the pixel in world space using the depth texture."
msgstr "A mélységtextúra alapján kiszámítja a képpont világkoordinátáit a vizuális shadergráfban."

#. VisualShaderNodeWorldPositionFromDepth.description
#: modules/visual_shader/doc_classes/VisualShaderNodeWorldPositionFromDepth.xml
msgid "The WorldPositionFromDepth node reconstructs the depth position of the pixel in world space. This can be used to obtain world space UVs for projection mapping like Caustics."
msgstr "A WorldPositionFromDepth csomópont a mélységből állítja elő a képpont világkoordinátáit. Ezekből világkoordinátákhoz igazodó UV-koordinátákat képezhetsz vetítési effektekhez, például kausztikához."

