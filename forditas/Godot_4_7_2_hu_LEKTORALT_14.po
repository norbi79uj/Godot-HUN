#. TileMapLayer.brief
#: doc/classes/TileMapLayer.xml
msgid "Node for 2D tile-based maps."
msgstr "Csempékre épülő 2D térképek csomópontja."

#. TileMapLayer.clear
#: doc/classes/TileMapLayer.xml
msgid "Clears all cells."
msgstr "Törli az összes cellát."

#. TileMapLayer.erase_cell
#: doc/classes/TileMapLayer.xml
msgid "Erases the cell at coordinates [param coords]."
msgstr "Törli a [param coords] koordinátájú cellát."

#. TileMapLayer.fix_invalid_tiles
#: doc/classes/TileMapLayer.xml
msgid "Clears cells containing tiles that do not exist in the [member tile_set]."
msgstr "Törli azokat a cellákat, amelyek a [member tile_set] készletben nem létező csempéket tartalmaznak."

#. TileMapLayer.get_cell_source_id
#: doc/classes/TileMapLayer.xml
msgid "Returns the tile source ID of the cell at coordinates [param coords]. Returns [code]-1[/code] if the cell does not exist."
msgstr "Visszaadja a [param coords] koordinátáknál található cella csempeforrás-azonosítóját. Ha a cella nem létezik, [code]-1[/code] értéket ad vissza."

#. TileMapLayer.get_cell_atlas_coords
#: doc/classes/TileMapLayer.xml
msgid "Returns the tile atlas coordinates ID of the cell at coordinates [param coords]. Returns [code]Vector2i(-1, -1)[/code] if the cell does not exist."
msgstr "Visszaadja a [param coords] koordinátájú cella atlaszkoordináta-azonosítóját. Ha a cella nem létezik, [code]Vector2i(-1, -1)[/code] értéket ad vissza."

#. TileMapLayer.get_cell_alternative_tile
#: doc/classes/TileMapLayer.xml
msgid "Returns the tile alternative ID of the cell at coordinates [param coords]."
msgstr "Visszaadja a [param coords] koordinátáknál található cella alternatív csempéjének azonosítóját."

#. TileMapLayer.get_used_rect
#: doc/classes/TileMapLayer.xml
msgid "Returns a rectangle enclosing the used (non-empty) tiles of the map."
msgstr "Visszaad egy téglalapot, amely körülhatárolja a térkép használt (nem üres) csempéit."

#. TileMapLayer.get_used_cells
#: doc/classes/TileMapLayer.xml
msgid "Returns a [Vector2i] array with the positions of all cells containing a tile. A cell is considered empty if its source identifier equals [code]-1[/code], its atlas coordinate identifier is [code]Vector2(-1, -1)[/code] and its alternative identifier is [code]-1[/code]."
msgstr "Egy [Vector2i] tömbben visszaadja az összes csempét tartalmazó cella helyét. Egy cella akkor számít üresnek, ha a forrásazonosítója [code]-1[/code], az atlaszkoordináta-azonosítója [code]Vector2(-1, -1)[/code], az alternatív azonosítója pedig [code]-1[/code]."

#. TileMapLayer.get_neighbor_cell
#: doc/classes/TileMapLayer.xml
msgid "Returns the neighboring cell to the one at coordinates [param coords], identified by the [param neighbor] direction. This method takes into account the different layouts a TileMap can take."
msgstr "Visszaadja a [param coords] koordinátáknál található cella [param neighbor] irány szerinti szomszédját. A metódus figyelembe veszi a csempetérkép különböző elrendezéseit."

#. TileMapLayer.get_surrounding_cells
#: doc/classes/TileMapLayer.xml
msgid "Returns the list of all neighboring cells to the one at [param coords]. Any neighboring cell is one that is touching edges, so for a square cell 4 cells would be returned, for a hexagon 6 cells are returned."
msgstr "Visszaadja a [param coords] koordinátáknál található cellával él mentén szomszédos cellák listáját. Négyzetes cellánál ez 4, hatszögletűnél pedig 6 cellát jelent."

#. TileMapLayer.get_pattern
#: doc/classes/TileMapLayer.xml
msgid "Creates and returns a new [TileMapPattern] from the given array of cells. See also [method set_pattern]."
msgstr "Létrehoz és visszaad egy új [TileMapPattern] mintát a megadott cellatömbből. Lásd még: [method set_pattern]."

#. TileMapLayer.set_pattern
#: doc/classes/TileMapLayer.xml
msgid "Pastes the [TileMapPattern] at the given [param position] in the tile map. See also [method get_pattern]."
msgstr "Beilleszti a [TileMapPattern] mintát a csempetérkép megadott [param position] pozíciójába. Lásd még: [method get_pattern]."

#. TileMapLayer.local_to_map
#: doc/classes/TileMapLayer.xml
msgid "Returns the map coordinates of the cell containing the given [param local_position]. If [param local_position] is in global coordinates, consider using [method Node2D.to_local] before passing it to this method. See also [method map_to_local]."
msgstr "Visszaadja annak a cellának a térképkoordinátáit, amely tartalmazza a megadott [param local_position] pontot. Ha [param local_position] globális koordinátákkal van megadva, előbb célszerű a [method Node2D.to_local] metódussal átalakítani. Lásd még: [method map_to_local]."

#. TileMapLayer.map_to_local
#: doc/classes/TileMapLayer.xml
msgid "Returns the centered position of a cell in the [TileMapLayer]'s local coordinate space. To convert the returned value into global coordinates, use [method Node2D.to_global]. See also [method local_to_map].\n[b]Note:[/b] This may not correspond to the visual position of the tile, i.e. it ignores the [member TileData.texture_origin] property of individual tiles."
msgstr "Visszaadja a cella középpontjának helyét a [TileMapLayer] helyi koordinátarendszerében. A visszaadott érték globális koordinátává alakításához használd a [method Node2D.to_global] metódust. Lásd még: [method local_to_map].\n[b]Megjegyzés:[/b] Ez nem feltétlenül egyezik meg a csempe látható helyzetével, mert figyelmen kívül hagyja az egyes csempék [member TileData.texture_origin] tulajdonságát."

#. TileMapLayer.collision_enabled
#: doc/classes/TileMapLayer.xml
msgid "Enable or disable collisions."
msgstr "Engedélyezi vagy letiltja az ütközéseket."

#. TileMapLayer.collision_visibility_mode
#: doc/classes/TileMapLayer.xml
msgid "Show or hide the [TileMapLayer]'s collision shapes. If set to [constant DEBUG_VISIBILITY_MODE_DEFAULT], this depends on the show collision debug settings."
msgstr "Megjeleníti vagy elrejti a [TileMapLayer] ütközési alakzatait. A [constant DEBUG_VISIBILITY_MODE_DEFAULT] értéknél ezt az ütközések hibakeresési megjelenítésének beállításai határozzák meg."

#. TileMapLayer.navigation_enabled
#: doc/classes/TileMapLayer.xml
msgid "If [code]true[/code], navigation regions are enabled."
msgstr "Ha [code]true[/code], a navigációs területek engedélyezve vannak."

#. TileMapLayer.occlusion_enabled
#: doc/classes/TileMapLayer.xml
msgid "Enable or disable light occlusion."
msgstr "Engedélyezi vagy letiltja a fény kitakarását."

#. TileMapLayer.enabled
#: doc/classes/TileMapLayer.xml
msgid "If [code]false[/code], disables this [TileMapLayer] completely (rendering, collision, navigation, scene tiles, etc.)"
msgstr "Ha [code]false[/code], teljesen letiltja ezt a [TileMapLayer] réteget (megjelenítés, ütközés, navigáció, jelenetcsempék stb.)."

#. TileMapLayer.tile_set
#: doc/classes/TileMapLayer.xml
msgid "The [TileSet] used by this layer. The textures, collisions, and additional behavior of all available tiles are stored here."
msgstr "A réteg által használt [TileSet]. Ez tárolja az elérhető csempék textúráit, ütközési adatait és egyéb viselkedési beállításait."

#. TileMapLayer.is_cell_flipped_h
#: doc/classes/TileMapLayer.xml
msgid "Returns [code]true[/code] if the cell at coordinates [param coords] is flipped horizontally. The result is valid only for atlas sources."
msgstr "[code]true[/code] értéket ad vissza, ha a [param coords] koordinátáknál található cella vízszintesen tükrözött. Az eredmény csak atlaszforrásoknál érvényes."

#. TileMapLayer.is_cell_flipped_v
#: doc/classes/TileMapLayer.xml
msgid "Returns [code]true[/code] if the cell at coordinates [param coords] is flipped vertically. The result is valid only for atlas sources."
msgstr "[code]true[/code] értéket ad vissza, ha a [param coords] koordinátáknál található cella függőlegesen tükrözött. Az eredmény csak atlaszforrásoknál érvényes."

#. TileMapLayer.is_cell_transposed
#: doc/classes/TileMapLayer.xml
msgid "Returns [code]true[/code] if the cell at coordinates [param coords] is transposed. The result is valid only for atlas sources."
msgstr "[code]true[/code] értéket ad vissza, ha a [param coords] koordinátáknál található cella transzponált. Az eredmény csak atlaszforrásoknál érvényes."

#. TileMapLayer.y_sort_origin
#: doc/classes/TileMapLayer.xml
msgid "This Y-sort origin value is added to each tile's Y-sort origin value. This allows, for example, to fake a different height level. This can be useful for top-down view games."
msgstr "Ez az Y-rendezési kiindulóérték hozzáadódik az egyes csempék saját Y-rendezési kiindulóértékéhez. Így például eltérő magassági szintet lehet szimulálni. Ez felülnézetes játékoknál lehet hasznos."

#. TileMapLayer.use_kinematic_bodies
#: doc/classes/TileMapLayer.xml
msgid "If [code]true[/code], this [TileMapLayer] collision shapes will be instantiated as kinematic bodies. This can be needed for moving [TileMapLayer] nodes (i.e. moving platforms)."
msgstr "Ha [code]true[/code], a [TileMapLayer] ütközési alakzatai kinematikus testekként jönnek létre. Erre mozgó [TileMapLayer] csomópontoknál (például mozgó platformoknál) lehet szükség."

#. TileMapLayer.description
#: doc/classes/TileMapLayer.xml
msgid "Node for 2D tile-based maps. A [TileMapLayer] uses a [TileSet] which contain a list of tiles which are used to create grid-based maps. Unlike the [TileMap] node, which is deprecated, [TileMapLayer] has only one layer of tiles. You can use several [TileMapLayer] to achieve the same result as a [TileMap] node.\nFor performance reasons, all TileMap updates are batched at the end of a frame. Notably, this means that scene tiles from a [TileSetScenesCollectionSource] are initialized after their parent. This is only queued when inside the scene tree.\nTo force an update earlier on, call [method update_internals].\n[b]Note:[/b] For performance and compatibility reasons, the coordinates serialized by [TileMapLayer] are limited to 16-bit signed integers, i.e. the range for X and Y coordinates is from [code]-32768[/code] to [code]32767[/code]. When saving tile data, tiles outside this range are wrapped."
msgstr "Csempéken alapuló 2D-s térképek csomópontja. A [TileMapLayer] egy [TileSet] csempekészletet használ, amelyből rácsalapú térképek készíthetők. A már elavult [TileMap] csomóponttal ellentétben a [TileMapLayer] csak egyetlen csemperéteget tartalmaz. Több [TileMapLayer] használatával azonban a [TileMap] csomópontéval azonos eredmény érhető el.\nTeljesítménybeli okokból a TileMap frissítéseit a Godot összegyűjti, és a képkocka végén hajtja végre. Emiatt a [TileSetScenesCollectionSource] jelenetcsempéi csak a szülőcsomópontjuk után jönnek létre. A frissítés ütemezése csak a jelenetfában történik.\nHa korábban szeretnél frissíteni, hívd meg a [method update_internals] metódust.\n[b]Megjegyzés:[/b] Teljesítménybeli és kompatibilitási okokból a [TileMapLayer] által mentett koordináták előjeles 16 bites egészekre korlátozódnak: az X és Y értéke [code]-32768[/code] és [code]32767[/code] közé eshet. Mentéskor a tartományon túli csempék koordinátái körbefordulnak."

#. TileMapLayer._tile_data_runtime_update
#: doc/classes/TileMapLayer.xml
msgid "Called with a [TileData] object about to be used internally by the [TileMapLayer], allowing its modification at runtime.\nThis method is only called if [method _use_tile_data_runtime_update] is implemented and returns [code]true[/code] for the given tile [param coords].\n[b]Warning:[/b] The [param tile_data] object's sub-resources are the same as the one in the TileSet. Modifying them might impact the whole TileSet. Instead, make sure to duplicate those resources.\n[b]Note:[/b] If the properties of [param tile_data] object should change over time, use [method notify_runtime_tile_data_update] to notify the [TileMapLayer] it needs an update."
msgstr "A [TileMapLayer] által belsőleg használni kívánt [TileData] objektummal hívódik meg, így futás közben módosíthatod annak adatait.\nA metódus csak akkor fut le, ha a [method _use_tile_data_runtime_update] meg van valósítva, és [code]true[/code] értéket ad vissza a [param coords] koordinátájú csempére.\n[b]Figyelmeztetés:[/b] A [param tile_data] rész-erőforrásai ugyanazok, mint amelyek a TileSet készletben találhatók. Módosításuk az egész TileSet készletre hatással lehet. Ehelyett célszerű másolatot készíteni ezekről az erőforrásokról.\n[b]Megjegyzés:[/b] Ha a [param tile_data] tulajdonságai idővel változnak, hívd meg a [method notify_runtime_tile_data_update] metódust a [TileMapLayer] frissítésének jelzésére."

#. TileMapLayer._update_cells
#: doc/classes/TileMapLayer.xml
msgid "Called when this [TileMapLayer]'s cells need an internal update. This update may be caused from individual cells being modified or by a change in the [member tile_set] (causing all cells to be queued for an update). The first call to this function is always for initializing all the [TileMapLayer]'s cells. [param coords] contains the coordinates of all modified cells, roughly in the order they were modified. [param forced_cleanup] is [code]true[/code] when the [TileMapLayer]'s internals should be fully cleaned up. This is the case when:\n- The layer is disabled;\n- The layer is not visible;\n- [member tile_set] is set to [code]null[/code];\n- The node is removed from the tree;\n- The node is freed.\nNote that any internal update happening while one of these conditions is verified is considered to be a \"cleanup\". See also [method update_internals].\n[b]Warning:[/b] Implementing this method may degrade the [TileMapLayer]'s performance."
msgstr "Akkor hívódik meg, amikor a [TileMapLayer] celláinak belső frissítésre van szükségük. Ezt egyes cellák változása vagy a [member tile_set] módosulása okozhatja (utóbbi esetben minden cella frissítésre kerül). Az első hívás mindig a [TileMapLayer] összes cellájának inicializálására szolgál. A [param coords] a módosított cellák koordinátáit tartalmazza, megközelítőleg a módosításuk sorrendjében. A [param forced_cleanup] értéke [code]true[/code], ha a [TileMapLayer] belső adatait teljesen fel kell szabadítani. Ez akkor történik, ha:\n- A réteg le van tiltva;\n- A réteg nem látható;\n- A [member tile_set] értéke [code]null[/code];\n- A csomópont kikerül a jelenetfából;\n- A csomópont felszabadul.\nAmíg bármelyik feltétel fennáll, a belső frissítés tisztításnak számít. Lásd még: [method update_internals].\n[b]Figyelmeztetés:[/b] A metódus megvalósítása ronthatja a [TileMapLayer] teljesítményét."

#. TileMapLayer._use_tile_data_runtime_update
#: doc/classes/TileMapLayer.xml
msgid "Should return [code]true[/code] if the tile at coordinates [param coords] requires a runtime update.\n[b]Warning:[/b] Make sure this function only returns [code]true[/code] when needed. Any tile processed at runtime without a need for it will imply a significant performance penalty.\n[b]Note:[/b] If the result of this function should change, use [method notify_runtime_tile_data_update] to notify the [TileMapLayer] it needs an update."
msgstr "[code]true[/code] értéket kell visszaadnia, ha a [param coords] koordinátájú csempe futás közbeni adatfrissítést igényel.\n[b]Figyelmeztetés:[/b] Csak akkor adj vissza [code]true[/code] értéket, ha a frissítés tényleg szükséges. A fölösleges futás közbeni csempefeldolgozás jelentős teljesítményveszteséget okozhat.\n[b]Megjegyzés:[/b] Ha a függvény eredménye megváltozhat, a [method notify_runtime_tile_data_update] segítségével jelezd a [TileMapLayer] számára, hogy frissítésre van szüksége."

#. TileMapLayer.get_cell_tile_data
#: doc/classes/TileMapLayer.xml
msgid "Returns the [TileData] object associated with the given cell, or [code]null[/code] if the cell does not exist or is not a [TileSetAtlasSource].\n[codeblock]\nfunc get_clicked_tile_power():\nvar clicked_cell = tile_map_layer.local_to_map(tile_map_layer.get_local_mouse_position())\nvar data = tile_map_layer.get_cell_tile_data(clicked_cell)\nif data:\nreturn data.get_custom_data(\"power\")\nelse:\nreturn 0\n[/codeblock]"
msgstr "Visszaadja a megadott cellához tartozó [TileData] objektumot, illetve [code]null[/code] értéket, ha a cella nem létezik, vagy nem [TileSetAtlasSource] forrásból származik.\n[codeblock]\nfunc get_clicked_tile_power():\nvar clicked_cell = tile_map_layer.local_to_map(tile_map_layer.get_local_mouse_position())\nvar data = tile_map_layer.get_cell_tile_data(clicked_cell)\nif data:\nreturn data.get_custom_data(\"power\")\nelse:\nreturn 0\n[/codeblock]"

#. TileMapLayer.get_coords_for_body_rid
#: doc/classes/TileMapLayer.xml
msgid "Returns the coordinates of the physics quadrant (see [member physics_quadrant_size]) for given physics body [RID]. Such an [RID] can be retrieved from [method KinematicCollision2D.get_collider_rid], when colliding with a tile.\n[b]Note:[/b] Higher values of [member physics_quadrant_size] will make this function less precise. To get the exact cell coordinates, you need to set [member physics_quadrant_size] to [code]1[/code], which disables physics chunking."
msgstr "Visszaadja a megadott fizikai test [RID] azonosítójához tartozó fizikai kvadráns koordinátáit (lásd [member physics_quadrant_size]). Ilyen [RID] például a [method KinematicCollision2D.get_collider_rid] metódussal kérdezhető le, amikor egy csempének ütközünk.\n[b]Megjegyzés:[/b] A [member physics_quadrant_size] nagyobb értékei kevésbé pontos eredményt adnak. A pontos cellakoordináták lekéréséhez állítsd a [member physics_quadrant_size] értékét [code]1[/code]-re; ezzel kikapcsolod a fizikai cellák csoportosítását."

#. TileMapLayer.get_navigation_map
#: doc/classes/TileMapLayer.xml
msgid "Returns the [RID] of the [NavigationServer2D] navigation used by this [TileMapLayer].\nBy default this returns the default [World2D] navigation map, unless a custom map was provided using [method set_navigation_map]."
msgstr "Visszaadja a [TileMapLayer] által használt [NavigationServer2D] navigációs térkép [RID] azonosítóját.\nAlapértelmezés szerint a [World2D] alapértelmezett navigációs térképét adja vissza, hacsak nem adtál meg egyedit a [method set_navigation_map] segítségével."

#. TileMapLayer.get_used_cells_by_id
#: doc/classes/TileMapLayer.xml
msgid "Returns a [Vector2i] array with the positions of all cells containing a tile. Tiles may be filtered according to their source ([param source_id]), their atlas coordinates ([param atlas_coords]), or alternative id ([param alternative_tile]).\nIf a parameter has its value set to the default one, this parameter is not used to filter a cell. Thus, if all parameters have their respective default values, this method returns the same result as [method get_used_cells].\nA cell is considered empty if its source identifier equals [code]-1[/code], its atlas coordinate identifier is [code]Vector2(-1, -1)[/code] and its alternative identifier is [code]-1[/code]."
msgstr "Egy [Vector2i] tömbben visszaadja az összes csempét tartalmazó cella pozícióját. A csempék szűrhetők forrásazonosító ([param source_id]), atlaszkoordináták ([param atlas_coords]) vagy alternatív azonosító ([param alternative_tile]) alapján.\nHa valamelyik paraméter az alapértelmezett értékét kapja, a rendszer nem szűr annak alapján. Ha minden paraméter alapértelmezett, a metódus ugyanazt adja vissza, mint a [method get_used_cells].\nA cella akkor üres, ha a forrásazonosítója [code]-1[/code], az atlaszkoordinátája [code]Vector2(-1, -1)[/code], az alternatív azonosítója pedig [code]-1[/code]."

#. TileMapLayer.has_body_rid
#: doc/classes/TileMapLayer.xml
msgid "Returns whether the provided [param body] [RID] belongs to one of this [TileMapLayer]'s cells."
msgstr "Megadja, hogy a [param body] [RID] azonosító a [TileMapLayer] valamelyik cellájához tartozik-e."

#. TileMapLayer.map_pattern
#: doc/classes/TileMapLayer.xml
msgid "Returns for the given coordinates [param coords_in_pattern] in a [TileMapPattern] the corresponding cell coordinates if the pattern was pasted at the [param position_in_tilemap] coordinates (see [method set_pattern]). This mapping is required as in half-offset tile shapes, the mapping might not work by calculating [code]position_in_tile_map + coords_in_pattern[/code]."
msgstr "Egy [TileMapPattern] minta [param coords_in_pattern] koordinátáihoz visszaadja a megfelelő cellakoordinátákat, mintha a mintát a [param position_in_tilemap] koordinátáknál illesztetted volna be (lásd [method set_pattern]). Az átalakításra azért van szükség, mert féleltolásos csempealakzatoknál az egyszerű [code]position_in_tile_map + coords_in_pattern[/code] összeadás nem feltétlenül megfelelő."

#. TileMapLayer.notify_runtime_tile_data_update
#: doc/classes/TileMapLayer.xml
msgid "Notifies the [TileMapLayer] node that calls to [method _use_tile_data_runtime_update] or [method _tile_data_runtime_update] will lead to different results. This will thus trigger a [TileMapLayer] update.\n[b]Warning:[/b] Updating the [TileMapLayer] is computationally expensive and may impact performance. Try to limit the number of calls to this function to avoid unnecessary update.\n[b]Note:[/b] This does not trigger a direct update of the [TileMapLayer], the update will be done at the end of the frame as usual (unless you call [method update_internals])."
msgstr "Jelzi a [TileMapLayer] számára, hogy a [method _use_tile_data_runtime_update] vagy a [method _tile_data_runtime_update] hívása már más eredményhez vezethet, ezért a [TileMapLayer] frissítése szükséges.\n[b]Figyelmeztetés:[/b] A [TileMapLayer] frissítése számításigényes, ezért ronthatja a teljesítményt. Kerüld a fölösleges hívásokat.\n[b]Megjegyzés:[/b] Ez nem azonnal frissíti a [TileMapLayer] csomópontot: a frissítés szokás szerint a képkocka végén történik (kivéve, ha meghívod a [method update_internals] metódust)."

#. TileMapLayer.set_cell
#: doc/classes/TileMapLayer.xml
msgid "Sets the tile identifiers for the cell at coordinates [param coords]. Each tile of the [TileSet] is identified using three parts:\n- The source identifier [param source_id] identifies a [TileSetSource] identifier. See [method TileSet.set_source_id],\n- The atlas coordinate identifier [param atlas_coords] identifies a tile coordinates in the atlas (if the source is a [TileSetAtlasSource]). For [TileSetScenesCollectionSource] it should always be [code]Vector2i(0, 0)[/code],\n- The alternative tile identifier [param alternative_tile] identifies a tile alternative in the atlas (if the source is a [TileSetAtlasSource]), and the scene for a [TileSetScenesCollectionSource].\nIf [param source_id] is set to [code]-1[/code], [param atlas_coords] to [code]Vector2i(-1, -1)[/code], or [param alternative_tile] to [code]-1[/code], the cell will be erased. An erased cell gets [b]all[/b] its identifiers automatically set to their respective invalid values, namely [code]-1[/code], [code]Vector2i(-1, -1)[/code] and [code]-1[/code]."
msgstr "Beállítja a [param coords] koordinátájú cella csempeazonosítóit. A [TileSet] minden csempéjét három összetevő azonosítja:\n- A [param source_id] forrásazonosító, amely egy [TileSetSource] forrást jelöl. Lásd: [method TileSet.set_source_id];\n- A [param atlas_coords] atlaszkoordináta, amely egy csempét azonosít az atlaszban ([TileSetAtlasSource] esetén). [TileSetScenesCollectionSource] forrásnál mindig [code]Vector2i(0, 0)[/code] értékű;\n- A [param alternative_tile] alternatív csempeazonosító, amely az atlaszbeli változatot jelöli ([TileSetAtlasSource] esetén), illetve a jelenetet azonosítja [TileSetScenesCollectionSource] forrásnál.\nHa a [param source_id] értéke [code]-1[/code], vagy a [param atlas_coords] értéke [code]Vector2i(-1, -1)[/code], vagy a [param alternative_tile] értéke [code]-1[/code], a cella törlődik. A törölt cella [b]összes[/b] azonosítója automatikusan érvénytelen lesz: [code]-1[/code], [code]Vector2i(-1, -1)[/code] és [code]-1[/code]."

#. TileMapLayer.set_cells_terrain_connect
#: doc/classes/TileMapLayer.xml
msgid "Update all the cells in the [param cells] coordinates array so that they use the given [param terrain] for the given [param terrain_set]. If an updated cell has the same terrain as one of its neighboring cells, this function tries to join the two. This function might update neighboring tiles if needed to create correct terrain transitions.\nIf [param ignore_empty_terrains] is [code]true[/code], empty terrains will be ignored when trying to find the best fitting tile for the given terrain constraints.\n[b]Note:[/b] To work correctly, this method requires the [TileMapLayer]'s TileSet to have terrains set up with all required terrain combinations. Otherwise, it may produce unexpected results."
msgstr "A [param cells] koordinátatömb összes celláját frissíti, hogy a megadott [param terrain_set] terepkészlet [param terrain] tereptípusát használják. Ha valamelyik frissített cella egy szomszédos cellával azonos tereptípusú, megpróbálja összekapcsolni őket. A megfelelő átmenetek kialakításához szükség esetén a szomszédos csempéket is módosíthatja.\nHa [param ignore_empty_terrains] értéke [code]true[/code], a legjobban illeszkedő csempe kiválasztásakor figyelmen kívül hagyja az üres tereptípusokat.\n[b]Megjegyzés:[/b] A helyes működéshez a [TileMapLayer] TileSet készletében minden szükséges terepkombinációnak léteznie kell. Máskülönben váratlan eredmény születhet."

#. TileMapLayer.set_cells_terrain_path
#: doc/classes/TileMapLayer.xml
msgid "Update all the cells in the [param path] coordinates array so that they use the given [param terrain] for the given [param terrain_set]. The function will also connect two successive cell in the path with the same terrain. This function might update neighboring tiles if needed to create correct terrain transitions.\nIf [param ignore_empty_terrains] is [code]true[/code], empty terrains will be ignored when trying to find the best fitting tile for the given terrain constraints.\n[b]Note:[/b] To work correctly, this method requires the [TileMapLayer]'s TileSet to have terrains set up with all required terrain combinations. Otherwise, it may produce unexpected results."
msgstr "A [param path] koordinátatömb összes celláját frissíti, hogy a megadott [param terrain_set] terepkészlet [param terrain] tereptípusát használják. A függvény az útvonal két egymást követő, azonos tereptípusú celláját is összekapcsolja. Szükség esetén a szomszédos csempéket is módosíthatja a megfelelő terepátmenetekhez.\nHa [param ignore_empty_terrains] értéke [code]true[/code], a legjobban illeszkedő csempe kiválasztásakor figyelmen kívül hagyja az üres tereptípusokat.\n[b]Megjegyzés:[/b] A helyes működéshez a [TileMapLayer] TileSet készletében minden szükséges terepkombinációnak léteznie kell. Máskülönben váratlan eredmény születhet."

#. TileMapLayer.set_navigation_map
#: doc/classes/TileMapLayer.xml
msgid "Sets a custom [param map] as a [NavigationServer2D] navigation map. If not set, uses the default [World2D] navigation map instead."
msgstr "A [param map] térképet állítja be egyéni [NavigationServer2D] navigációs térképként. Ha nincs megadva, a [World2D] alapértelmezett navigációs térképét használja."

#. TileMapLayer.update_internals
#: doc/classes/TileMapLayer.xml
msgid "Triggers a direct update of the [TileMapLayer]. Usually, calling this function is not needed, as [TileMapLayer] node updates automatically when one of its properties or cells is modified.\nHowever, for performance reasons, those updates are batched and delayed to the end of the frame. Calling this function will force the [TileMapLayer] to update right away instead.\n[b]Warning:[/b] Updating the [TileMapLayer] is computationally expensive and may impact performance. Try to limit the number of updates and how many tiles they impact."
msgstr "Azonnal frissíti a [TileMapLayer] csomópontot. Általában erre nincs szükség, mert a [TileMapLayer] tulajdonságainak vagy celláinak módosításakor automatikusan frissül.\nTeljesítménybeli okokból a Godot összegyűjti a frissítéseket, és a képkocka végéig késlelteti őket. A metódus meghívásakor azonban a [TileMapLayer] azonnal frissül.\n[b]Figyelmeztetés:[/b] A [TileMapLayer] frissítése számításigényes, és ronthatja a teljesítményt. Törekedj a hívások és az érintett csempék számának korlátozására."

#. TileMapLayer.navigation_visibility_mode
#: doc/classes/TileMapLayer.xml
msgid "Show or hide the [TileMapLayer]'s navigation meshes. If set to [constant DEBUG_VISIBILITY_MODE_DEFAULT], this depends on the show navigation debug settings."
msgstr "Megjeleníti vagy elrejti a [TileMapLayer] navigációs hálóit. [constant DEBUG_VISIBILITY_MODE_DEFAULT] értéknél a navigációs hibakeresési megjelenítés beállításaitól függ."

#. TileMapLayer.physics_quadrant_size
#: doc/classes/TileMapLayer.xml
msgid "The [TileMapLayer]'s physics quadrant size. Within a physics quadrant, cells with similar physics properties are grouped together and their collision shapes get merged. [member physics_quadrant_size] defines the length of a square's side, in the map's coordinate system, that forms the quadrant. Thus, the default quadrant size groups together [code]16 * 16 = 256[/code] tiles.\n[b]Note:[/b] As quadrants are created according to the map's coordinate system, the quadrant's \"square shape\" might not look like square in the [TileMapLayer]'s local coordinate system.\n[b]Note:[/b] This impacts the value returned by [method get_coords_for_body_rid]. Higher values will make that function less precise. To get the exact cell coordinates, you need to set [member physics_quadrant_size] to [code]1[/code], which disables physics chunking."
msgstr "A [TileMapLayer] fizikai kvadránsának mérete. Egy kvadránson belül a hasonló fizikai tulajdonságú cellák egy csoportba kerülnek, és az ütközési alakzataikat egyesíti a rendszer. A [member physics_quadrant_size] egy négyzet oldalhosszát határozza meg a térkép koordinátarendszerében. Az alapértelmezett kvadráns [code]16 * 16 = 256[/code] csempét fog össze.\n[b]Megjegyzés:[/b] A kvadránsok a térkép koordinátarendszere alapján jönnek létre, ezért a négyzet alakjuk a [TileMapLayer] helyi koordinátarendszerében nem feltétlenül látszik négyzetesnek.\n[b]Megjegyzés:[/b] A beállítás a [method get_coords_for_body_rid] eredményét is befolyásolja. A nagyobb érték kevésbé pontos lekérdezést eredményez; a pontos cellakoordinátákhoz a [member physics_quadrant_size] értékét [code]1[/code]-re kell állítani, amely kikapcsolja a fizikai cellák csoportosítását."

#. TileMapLayer.rendering_quadrant_size
#: doc/classes/TileMapLayer.xml
msgid "The [TileMapLayer]'s rendering quadrant size. A quadrant is a group of tiles to be drawn together on a single canvas item, for optimization purposes. [member rendering_quadrant_size] defines the length of a square's side, in the map's coordinate system, that forms the quadrant. Thus, the default quadrant size groups together [code]16 * 16 = 256[/code] tiles.\nThe quadrant size does not apply on a Y-sorted [TileMapLayer], as tiles are grouped by Y position instead in that case.\n[b]Note:[/b] As quadrants are created according to the map's coordinate system, the quadrant's \"square shape\" might not look like square in the [TileMapLayer]'s local coordinate system."
msgstr "A [TileMapLayer] kirajzolási kvadránsának mérete. A kvadráns csempék olyan csoportja, amelyet teljesítményoptimalizálás céljából egyetlen vászonelemként rajzol ki a rendszer. A [member rendering_quadrant_size] a kvadráns négyzetének oldalhosszát határozza meg a térkép koordinátarendszerében. Az alapértelmezett kvadráns [code]16 * 16 = 256[/code] csempét tartalmaz.\nAz Y szerint rendezett [TileMapLayer] esetén ez nem érvényes, mert a csempéket a rendszer az Y-pozíciójuk alapján csoportosítja.\n[b]Megjegyzés:[/b] A kvadránsok a térkép koordinátarendszerében jönnek létre, így a négyzet alakjuk a [TileMapLayer] helyi koordinátarendszerében nem feltétlenül látszik négyzetesnek."

#. TileMapLayer.tile_map_data
#: doc/classes/TileMapLayer.xml
msgid "The raw tile map data as a byte array."
msgstr "A csempetérkép nyers adatai bájttömbként."

#. TileMapLayer.x_draw_order_reversed
#: doc/classes/TileMapLayer.xml
msgid "If [member CanvasItem.y_sort_enabled] is enabled, setting this to [code]true[/code] will reverse the order the tiles are drawn on the X-axis."
msgstr "Ha engedélyezett a [member CanvasItem.y_sort_enabled], a [code]true[/code] érték megfordítja a csempék X tengely menti kirajzolási sorrendjét."

#. TileSet.brief
#: doc/classes/TileSet.xml
msgid "Tile library for tilemaps."
msgstr "Csempekészlet csempetérképekhez."

#. TileSet.description
#: doc/classes/TileSet.xml
msgid "A TileSet is a library of tiles for a [TileMapLayer]. A TileSet handles a list of [TileSetSource], each of them storing a set of tiles.\nTiles can either be from a [TileSetAtlasSource], which renders tiles out of a texture with support for physics, navigation, etc., or from a [TileSetScenesCollectionSource], which exposes scene-based tiles.\nTiles are referenced by using three IDs: their source ID, their atlas coordinates ID, and their alternative tile ID.\nA TileSet can be configured so that its tiles expose more or fewer properties. To do so, the TileSet resources use property layers, which you can add or remove depending on your needs.\nFor example, adding a physics layer allows giving collision shapes to your tiles. Each layer has dedicated properties (physics layer and mask), so you may add several TileSet physics layers for each type of collision you need.\nSee the functions to add new layers for more information."
msgstr "A TileSet egy [TileMapLayer] csempekönyvtára. A TileSet [TileSetSource] források listáját kezeli, amelyek mindegyike csempéket tárol.\nA csempék származhatnak [TileSetAtlasSource] forrásból, amely egy textúra részeiből rajzolja ki őket, és támogatja többek között a fizikát és a navigációt; vagy [TileSetScenesCollectionSource] forrásból, amely jelenetalapú csempéket biztosít.\nA csempékre három azonosítóval hivatkozunk: forrásazonosítóval, atlaszkoordináta-azonosítóval és alternatívcsempe-azonosítóval.\nA TileSet beállítható úgy, hogy a csempéi több vagy kevesebb tulajdonságot kínáljanak. Ehhez tulajdonságrétegeket használ, amelyeket az igények szerint hozzáadhatsz vagy eltávolíthatsz.\nPéldául egy fizikai réteg hozzáadásával ütközési alakzatokat rendelhetsz a csempékhez. Minden ilyen rétegnek saját tulajdonságai vannak (ütközési réteg és maszk), ezért különböző ütközési célokra több fizikai réteget is létrehozhatsz.\nTovábbi tudnivalókért lásd az új rétegek hozzáadására szolgáló függvényeket."

#. TileSet.tile_size
#: doc/classes/TileSet.xml
msgid "The tile size, in pixels. For all tile shapes, this size corresponds to the encompassing rectangle of the tile shape. This is thus the minimal cell size required in an atlas."
msgstr "A csempe mérete képpontban. Bármilyen alakú csempénél az azt körülvevő téglalap méretét jelenti, vagyis az atlaszban szükséges legkisebb cellaméretet."

#. TileSet.tile_shape
#: doc/classes/TileSet.xml
msgid "The tile shape."
msgstr "A csempe alakja."

#. TileSet.tile_layout
#: doc/classes/TileSet.xml
msgid "For all half-offset shapes (Isometric, Hexagonal and Half-Offset square), changes the way tiles are indexed in the [TileMapLayer] grid."
msgstr "A féleltolásos alakzatoknál (izometrikus, hatszögletű és féleltolásos négyzetes) megváltoztatja a csempék indexelését a [TileMapLayer] rácsában."

#. TileSet.tile_offset_axis
#: doc/classes/TileSet.xml
msgid "For all half-offset shapes (Isometric, Hexagonal and Half-Offset square), determines the offset axis."
msgstr "A féleltolásos alakzatoknál (izometrikus, hatszögletű és féleltolásos négyzetes) meghatározza az eltolás tengelyét."

#. TileSet.uv_clipping
#: doc/classes/TileSet.xml
msgid "Enables/Disable uv clipping when rendering the tiles."
msgstr "Engedélyezi vagy letiltja az UV-koordináták szerinti levágást a csempék kirajzolásakor."

#. TileSet.add_source
#: doc/classes/TileSet.xml
msgid "Adds a [TileSetSource] to the TileSet. If [param atlas_source_id_override] is not -1, also set its source ID. Otherwise, a unique identifier is automatically generated.\nThe function returns the added source ID or -1 if the source could not be added.\n[b]Warning:[/b] A source cannot belong to two TileSets at the same time. If the added source was attached to another [TileSet], it will be removed from that one."
msgstr "Hozzáad egy [TileSetSource] forrást a TileSet készlethez. Ha az [param atlas_source_id_override] értéke nem -1, ezt az értéket állítja be forrásazonosítóként. Egyébként automatikusan létrehoz egy egyedi azonosítót.\nA függvény a hozzáadott forrás azonosítóját adja vissza, vagy -1-et, ha a forrást nem sikerült hozzáadni.\n[b]Figyelmeztetés:[/b] Egy forrás egyszerre nem tartozhat két TileSet készlethez. Ha a hozzáadott forrás már egy másik [TileSet] része volt, onnan eltávolítja."

#. TileSet.get_source
#: doc/classes/TileSet.xml
msgid "Returns the [TileSetSource] with ID [param source_id]."
msgstr "Visszaadja a [param source_id] azonosítójú [TileSetSource] forrást."

#. TileSet.get_source_count
#: doc/classes/TileSet.xml
msgid "Returns the number of [TileSetSource] in this TileSet."
msgstr "Visszaadja a TileSet készletben található [TileSetSource] források számát."

#. TileSet.get_source_id
#: doc/classes/TileSet.xml
msgid "Returns the source ID for source with index [param index]."
msgstr "Visszaadja a [param index] indexű forrás azonosítóját."

#. TileSet.has_source
#: doc/classes/TileSet.xml
msgid "Returns if this TileSet has a source for the given source ID."
msgstr "Megadja, hogy a TileSet tartalmaz-e forrást a megadott forrásazonosítóval."

#. TileSet.remove_source
#: doc/classes/TileSet.xml
msgid "Removes the source with the given source ID."
msgstr "Eltávolítja a megadott forrásazonosítójú forrást."

#. TileSet.get_next_source_id
#: doc/classes/TileSet.xml
msgid "Returns a new unused source ID. This generated ID is the same that a call to [method add_source] would return."
msgstr "Visszaad egy új, még nem használt forrásazonosítót. Ez ugyanaz az azonosító, amelyet a [method add_source] metódus adna vissza."

#. TileSet.add_physics_layer
#: doc/classes/TileSet.xml
msgid "Adds a physics layer to the TileSet at the given position [param to_position] in the array. If [param to_position] is -1, adds it at the end of the array.\nPhysics layers allow assigning collision polygons to atlas tiles."
msgstr "Fizikai réteget ad a TileSet készlethez a tömb [param to_position] pozíciójára. Ha [param to_position] értéke -1, a tömb végére illeszti.\nA fizikai rétegek segítségével ütközési sokszögeket rendelhetsz az atlaszcsempékhez."

#. TileSet.get_physics_layers_count
#: doc/classes/TileSet.xml
msgid "Returns the physics layers count."
msgstr "Visszaadja a fizikai rétegek számát."

#. TileSet.set_physics_layer_collision_layer
#: doc/classes/TileSet.xml
msgid "Sets the collision layer (as in the physics server) for bodies in the given TileSet physics layer."
msgstr "Beállítja a megadott TileSet-fizikai réteghez tartozó testek ütközési rétegét a fizikai szerver rétegbeállításai szerint."

#. TileSet.set_physics_layer_collision_mask
#: doc/classes/TileSet.xml
msgid "Sets the collision mask for bodies in the given TileSet physics layer."
msgstr "Beállítja a megadott TileSet-fizikai réteghez tartozó testek ütközési maszkját."

#. TileSet.add_custom_data_layer
#: doc/classes/TileSet.xml
msgid "Adds a custom data layer to the TileSet at the given position [param to_position] in the array. If [param to_position] is -1, adds it at the end of the array.\nCustom data layers allow assigning custom properties to atlas tiles."
msgstr "Egyediadatréteget ad a TileSet készlethez a tömb [param to_position] pozíciójára. Ha [param to_position] értéke -1, a tömb végére illeszti.\nAz egyediadatrétegekkel saját tulajdonságokat rendelhetsz az atlaszcsempékhez."

#. TileSet.set_custom_data_layer_name
#: doc/classes/TileSet.xml
msgid "Sets the name of the custom data layer identified by the given index. Names are identifiers of the layer therefore if the name is already taken it will fail and raise an error."
msgstr "Beállítja a megadott indexű egyediadatréteg nevét. A nevek a rétegek azonosítói, ezért ha egy név már foglalt, a művelet hibát jelez és sikertelen lesz."

#. TileSet.get_custom_data_layer_name
#: doc/classes/TileSet.xml
msgid "Returns the name of the custom data layer identified by the given index."
msgstr "Visszaadja a megadott indexű egyediadatréteg nevét."

#. TileSet.get_custom_data_layers_count
#: doc/classes/TileSet.xml
msgid "Returns the custom data layers count."
msgstr "Visszaadja az egyediadatrétegek számát."

#. TileSet.add_pattern
#: doc/classes/TileSet.xml
msgid "Adds a [TileMapPattern] to be stored in the TileSet resource. If provided, insert it at the given [param index]."
msgstr "Eltárol egy [TileMapPattern] mintát a TileSet erőforrásban. Ha megadtad a [param index] értékét, a mintát a megfelelő helyre illeszti."

#. TileSet.get_pattern
#: doc/classes/TileSet.xml
msgid "Returns the [TileMapPattern] at the given [param index]."
msgstr "Visszaadja a [param index] indexű [TileMapPattern] mintát."

#. TileSet.add_terrain
#: doc/classes/TileSet.xml
msgid "Adds a new terrain to the given terrain set [param terrain_set] at the given position [param to_position] in the array. If [param to_position] is -1, adds it at the end of the array."
msgstr "Új tereptípust ad a [param terrain_set] terepkészlethez a tömb [param to_position] pozíciójára. Ha [param to_position] értéke -1, a tömb végére illeszti."

#. TileSet.add_terrain_set
#: doc/classes/TileSet.xml
msgid "Adds a new terrain set at the given position [param to_position] in the array. If [param to_position] is -1, adds it at the end of the array."
msgstr "Új terepkészletet ad a tömb [param to_position] pozíciójára. Ha [param to_position] értéke -1, a tömb végére illeszti."

#. TileSet.add_navigation_layer
#: doc/classes/TileSet.xml
msgid "Adds a navigation layer to the TileSet at the given position [param to_position] in the array. If [param to_position] is -1, adds it at the end of the array.\nNavigation layers allow assigning a navigable area to atlas tiles."
msgstr "Navigációs réteget ad a TileSet készlethez a tömb [param to_position] pozíciójára. Ha [param to_position] értéke -1, a tömb végére illeszti.\nA navigációs rétegek segítségével bejárható terület rendelhető az atlaszcsempékhez."

#. TileSet.add_occlusion_layer
#: doc/classes/TileSet.xml
msgid "Adds an occlusion layer to the TileSet at the given position [param to_position] in the array. If [param to_position] is -1, adds it at the end of the array.\nOcclusion layers allow assigning occlusion polygons to atlas tiles."
msgstr "Fénykitakarási réteget ad a TileSet készlethez a tömb [param to_position] pozíciójára. Ha [param to_position] értéke -1, a tömb végére illeszti.\nA fénykitakarási rétegekkel kitakarási sokszögek rendelhetők az atlaszcsempékhez."

#. TileSet.clear_terrains
#: doc/classes/TileSet.xml
msgid "Clears all terrain properties for the given terrain set."
msgstr "Törli a megadott terepkészlet összes tereptulajdonságát."

#. TileSet.get_custom_data_layer_by_name
#: doc/classes/TileSet.xml
msgid "Returns the index of the custom data layer identified by the given name."
msgstr "Visszaadja a megadott nevű egyediadatréteg indexét."

#. TileSet.get_custom_data_layer_type
#: doc/classes/TileSet.xml
msgid "Returns the type of the custom data layer identified by the given index."
msgstr "Visszaadja a megadott indexű egyediadatréteg típusát."

#. TileSet.get_navigation_layer_layers
#: doc/classes/TileSet.xml
msgid "Returns the navigation layers (as in the Navigation server) of the given TileSet navigation layer."
msgstr "Visszaadja a megadott TileSet-navigációs réteg navigációs rétegeit (a navigációs kiszolgáló rendszerében)."

#. TileSet.get_navigation_layers_count
#: doc/classes/TileSet.xml
msgid "Returns the navigation layers count."
msgstr "Visszaadja a navigációs rétegek számát."

#. TileSet.get_occlusion_layers_count
#: doc/classes/TileSet.xml
msgid "Returns the occlusion layers count."
msgstr "Visszaadja a fénykitakarási rétegek számát."

#. TileSet.get_patterns_count
#: doc/classes/TileSet.xml
msgid "Returns the number of [TileMapPattern] this tile set handles."
msgstr "Visszaadja a TileSet által kezelt [TileMapPattern] minták számát."

#. TileSet.get_physics_layer_collision_layer
#: doc/classes/TileSet.xml
msgid "Returns the collision layer (as in the physics server) bodies on the given TileSet's physics layer are in."
msgstr "Visszaadja a megadott TileSet-fizikai réteghez tartozó testek ütközési rétegét a fizikai szerverben."

#. TileSet.get_physics_layer_collision_mask
#: doc/classes/TileSet.xml
msgid "Returns the collision mask of bodies on the given TileSet's physics layer."
msgstr "Visszaadja a megadott TileSet-fizikai réteg testeihez tartozó ütközési maszkot."

#. TileSet.get_physics_layer_collision_priority
#: doc/classes/TileSet.xml
msgid "Returns the collision priority of bodies on the given TileSet's physics layer."
msgstr "Visszaadja a megadott TileSet-fizikai réteg testeihez tartozó ütközési prioritást."

#. TileSet.get_physics_layer_physics_material
#: doc/classes/TileSet.xml
msgid "Returns the physics material of bodies on the given TileSet's physics layer."
msgstr "Visszaadja a megadott TileSet-fizikai réteg testeihez tartozó fizikai anyagot."

#. TileSet.get_terrain_color
#: doc/classes/TileSet.xml
msgid "Returns a terrain's color."
msgstr "Visszaadja a tereptípus színét."

#. TileSet.get_terrain_name
#: doc/classes/TileSet.xml
msgid "Returns a terrain's name."
msgstr "Visszaadja a tereptípus nevét."

#. TileSet.get_terrain_set_mode
#: doc/classes/TileSet.xml
msgid "Returns a terrain set mode."
msgstr "Visszaadja a terepkészlet módját."

#. TileSet.get_terrain_sets_count
#: doc/classes/TileSet.xml
msgid "Returns the terrain sets count."
msgstr "Visszaadja a terepkészletek számát."

#. TileSet.get_terrains_count
#: doc/classes/TileSet.xml
msgid "Returns the number of terrains in the given terrain set."
msgstr "Visszaadja a megadott terepkészlet tereptípusainak számát."

#. TileSet.has_custom_data_layer_by_name
#: doc/classes/TileSet.xml
msgid "Returns if there is a custom data layer named [param layer_name]."
msgstr "Megadja, hogy létezik-e [param layer_name] nevű egyediadatréteg."

#. TileSet.move_navigation_layer
#: doc/classes/TileSet.xml
msgid "Moves the navigation layer at index [param layer_index] to the given position [param to_position] in the array. Also updates the atlas tiles accordingly."
msgstr "A [param layer_index] indexű navigációs réteget a tömb [param to_position] pozíciójára helyezi át. A változásnak megfelelően frissíti az atlaszcsempéket is."

#. TileSet.remove_custom_data_layer
#: doc/classes/TileSet.xml
msgid "Removes the custom data layer at index [param layer_index]. Also updates the atlas tiles accordingly."
msgstr "Eltávolítja a [param layer_index] indexű egyediadatréteget. A változásnak megfelelően frissíti az atlaszcsempéket is."

#. TileSet.remove_navigation_layer
#: doc/classes/TileSet.xml
msgid "Removes the navigation layer at index [param layer_index]. Also updates the atlas tiles accordingly."
msgstr "Eltávolítja a [param layer_index] indexű navigációs réteget. A változásnak megfelelően frissíti az atlaszcsempéket is."

#. TileSet.remove_occlusion_layer
#: doc/classes/TileSet.xml
msgid "Removes the occlusion layer at index [param layer_index]. Also updates the atlas tiles accordingly."
msgstr "Eltávolítja a [param layer_index] indexű fénykitakarási réteget. A változásnak megfelelően frissíti az atlaszcsempéket is."

#. TileSet.remove_pattern
#: doc/classes/TileSet.xml
msgid "Remove the [TileMapPattern] at the given index."
msgstr "Eltávolítja a megadott indexű [TileMapPattern] mintát."

#. TileSet.remove_physics_layer
#: doc/classes/TileSet.xml
msgid "Removes the physics layer at index [param layer_index]. Also updates the atlas tiles accordingly."
msgstr "Eltávolítja a [param layer_index] indexű fizikai réteget. A változásnak megfelelően frissíti az atlaszcsempéket is."

#. TileSet.remove_terrain
#: doc/classes/TileSet.xml
msgid "Removes the terrain at index [param terrain_index] in the given terrain set [param terrain_set]. Also updates the atlas tiles accordingly."
msgstr "Eltávolítja a [param terrain_set] terepkészlet [param terrain_index] indexű tereptípusát. A változásnak megfelelően frissíti az atlaszcsempéket is."

#. TileSet.remove_terrain_set
#: doc/classes/TileSet.xml
msgid "Removes the terrain set at index [param terrain_set]. Also updates the atlas tiles accordingly."
msgstr "Eltávolítja a [param terrain_set] indexű terepkészletet. A változásnak megfelelően frissíti az atlaszcsempéket is."

#. TileSet.set_custom_data_layer_type
#: doc/classes/TileSet.xml
msgid "Sets the type of the custom data layer identified by the given index."
msgstr "Beállítja a megadott indexű egyediadatréteg típusát."

#. TileSet.set_navigation_layer_layers
#: doc/classes/TileSet.xml
msgid "Sets the navigation layers (as in the navigation server) for navigation regions in the given TileSet navigation layer."
msgstr "Beállítja a navigációs kiszolgáló rendszerében használt navigációs rétegeket a megadott TileSet-navigációs réteg navigációs területeihez."

#. TileSet.set_terrain_color
#: doc/classes/TileSet.xml
msgid "Sets a terrain's color. This color is used for identifying the different terrains in the TileSet editor."
msgstr "Beállítja a tereptípus színét. Ez a szín segít megkülönböztetni a tereptípusokat a TileSet-szerkesztőben."

#. TileSet.set_terrain_name
#: doc/classes/TileSet.xml
msgid "Sets a terrain's name."
msgstr "Beállítja a tereptípus nevét."

#. TileSet.set_terrain_set_mode
#: doc/classes/TileSet.xml
msgid "Sets a terrain mode. Each mode determines which bits of a tile shape is used to match the neighboring tiles' terrains."
msgstr "Beállítja a terepkészlet módját. A választott mód határozza meg, hogy a csempe alakzatának mely részei alapján illeszkedjenek a szomszédos csempék tereptípusai."

#. TileSet.cleanup_invalid_tile_proxies
#: doc/classes/TileSet.xml
msgid "Clears tile proxies pointing to invalid tiles."
msgstr "Törli az érvénytelen csempékre mutató csempehelyettesítési szabályokat (proxykat)."

#. TileSet.clear_tile_proxies
#: doc/classes/TileSet.xml
msgid "Clears all tile proxies."
msgstr "Törli az összes csempehelyettesítési szabályt."

#. TileSet.get_alternative_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Returns the alternative-level proxy for the given identifiers. The returned array contains the three proxie's target identifiers (source ID, atlas coords ID and alternative tile ID).\nIf the TileSet has no proxy for the given identifiers, returns an empty Array."
msgstr "Visszaadja a megadott azonosítókhoz tartozó alternatívszintű helyettesítési szabályt. A kapott tömb a célcsempe három azonosítóját tartalmazza: forrásazonosító, atlaszkoordináta-azonosító és alternatív csempeazonosító.\nHa a TileSet nem tartalmaz ilyen szabályt, üres Array tömböt ad vissza."

#. TileSet.get_coords_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Returns the coordinate-level proxy for the given identifiers. The returned array contains the two target identifiers of the proxy (source ID and atlas coordinates ID).\nIf the TileSet has no proxy for the given identifiers, returns an empty Array."
msgstr "Visszaadja a megadott azonosítókhoz tartozó koordinátaszintű helyettesítési szabályt. A kapott tömb a két célazonosítót tartalmazza: forrásazonosító és atlaszkoordináta-azonosító.\nHa a TileSet nem tartalmaz ilyen szabályt, üres Array tömböt ad vissza."

#. TileSet.get_navigation_layer_layer_value
#: doc/classes/TileSet.xml
msgid "Returns whether or not the specified navigation layer of the TileSet navigation data layer identified by the given [param layer_index] is enabled, given a navigation_layers [param layer_number] between 1 and 32."
msgstr "Megadja, hogy a [param layer_index] indexű TileSet-navigációs adatréteg [param layer_number] számú navigációs rétege engedélyezett-e. A réteg sorszáma 1 és 32 közé eshet."

#. TileSet.get_occlusion_layer_light_mask
#: doc/classes/TileSet.xml
msgid "Returns the light mask of the occlusion layer."
msgstr "Visszaadja a fénykitakarási réteg fénymaszkját."

#. TileSet.get_occlusion_layer_sdf_collision
#: doc/classes/TileSet.xml
msgid "Returns if the occluders from this layer use [code]sdf_collision[/code]."
msgstr "Megadja, hogy az ezen a rétegen lévő fénykitakaró objektumok használják-e a [code]sdf_collision[/code] beállítást."

#. TileSet.get_source_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Returns the source-level proxy for the given source identifier.\nIf the TileSet has no proxy for the given identifier, returns -1."
msgstr "Visszaadja a megadott forrásazonosítóhoz tartozó forrásszintű helyettesítési szabályt.\nHa a TileSet nem tartalmaz ilyen szabályt, -1 értéket ad vissza."

#. TileSet.has_alternative_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Returns if there is an alternative-level proxy for the given identifiers."
msgstr "Megadja, hogy létezik-e alternatívszintű helyettesítési szabály a megadott azonosítókhoz."

#. TileSet.has_coords_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Returns if there is a coodinates-level proxy for the given identifiers."
msgstr "Megadja, hogy létezik-e koordinátaszintű helyettesítési szabály a megadott azonosítókhoz."

#. TileSet.has_source_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Returns if there is a source-level proxy for the given source ID."
msgstr "Megadja, hogy létezik-e forrásszintű helyettesítési szabály a megadott forrásazonosítóhoz."

#. TileSet.map_tile_proxy
#: doc/classes/TileSet.xml
msgid "According to the configured proxies, maps the provided identifiers to a new set of identifiers. The source ID, atlas coordinates ID and alternative tile ID are returned as a 3 elements Array.\nThis function first look for matching alternative-level proxies, then coordinates-level proxies, then source-level proxies.\nIf no proxy corresponding to provided identifiers are found, returns the same values the ones used as arguments."
msgstr "A beállított helyettesítési szabályok alapján új azonosítókra képezi le a megadott csempeazonosítókat. Háromelemű Array tömbben adja vissza a forrásazonosítót, az atlaszkoordináta-azonosítót és az alternatív csempeazonosítót.\nElőször az alternatívszintű, majd a koordinátaszintű, végül a forrásszintű szabályok között keres egyezést.\nHa egyik szabály sem illeszkedik, a kapott azonosítók megegyeznek a bemeneti argumentumokkal."

#. TileSet.move_custom_data_layer
#: doc/classes/TileSet.xml
msgid "Moves the custom data layer at index [param layer_index] to the given position [param to_position] in the array. Also updates the atlas tiles accordingly."
msgstr "A [param layer_index] indexű egyediadatréteget a tömb [param to_position] pozíciójára helyezi át. Ennek megfelelően az atlaszcsempéket is frissíti."

#. TileSet.move_occlusion_layer
#: doc/classes/TileSet.xml
msgid "Moves the occlusion layer at index [param layer_index] to the given position [param to_position] in the array. Also updates the atlas tiles accordingly."
msgstr "A [param layer_index] indexű fénykitakarási réteget a tömb [param to_position] pozíciójára helyezi át. Ennek megfelelően az atlaszcsempéket is frissíti."

#. TileSet.move_physics_layer
#: doc/classes/TileSet.xml
msgid "Moves the physics layer at index [param layer_index] to the given position [param to_position] in the array. Also updates the atlas tiles accordingly."
msgstr "A [param layer_index] indexű fizikai réteget a tömb [param to_position] pozíciójára helyezi át. Ennek megfelelően az atlaszcsempéket is frissíti."

#. TileSet.move_terrain
#: doc/classes/TileSet.xml
msgid "Moves the terrain at index [param terrain_index] for terrain set [param terrain_set] to the given position [param to_position] in the array. Also updates the atlas tiles accordingly."
msgstr "A [param terrain_set] terepkészlet [param terrain_index] indexű tereptípusát a tömb [param to_position] pozíciójára helyezi át. Ennek megfelelően az atlaszcsempéket is frissíti."

#. TileSet.move_terrain_set
#: doc/classes/TileSet.xml
msgid "Moves the terrain set at index [param terrain_set] to the given position [param to_position] in the array. Also updates the atlas tiles accordingly."
msgstr "A [param terrain_set] indexű terepkészletet a tömb [param to_position] pozíciójára helyezi át. Ennek megfelelően az atlaszcsempéket is frissíti."

#. TileSet.remove_alternative_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Removes an alternative-level proxy for the given identifiers."
msgstr "Eltávolítja a megadott azonosítókhoz tartozó alternatívszintű helyettesítési szabályt."

#. TileSet.remove_coords_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Removes a coordinates-level proxy for the given identifiers."
msgstr "Eltávolítja a megadott azonosítókhoz tartozó koordinátaszintű helyettesítési szabályt."

#. TileSet.remove_source_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Removes a source-level tile proxy."
msgstr "Eltávolít egy forrásszintű csempehelyettesítési szabályt."

#. TileSet.set_alternative_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Create an alternative-level proxy for the given identifiers. A proxy will map set of tile identifiers to another set of identifiers.\nProxied tiles can be automatically replaced in TileMapLayer nodes using the editor."
msgstr "Alternatívszintű helyettesítési szabályt hoz létre a megadott azonosítókhoz. A szabály egy csempeazonosító-készletet egy másikra képez le.\nA helyettesített csempék a szerkesztő segítségével automatikusan kicserélhetők a TileMapLayer csomópontokban."

#. TileSet.set_coords_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Creates a coordinates-level proxy for the given identifiers. A proxy will map set of tile identifiers to another set of identifiers. The alternative tile ID is kept the same when using coordinates-level proxies.\nProxied tiles can be automatically replaced in TileMapLayer nodes using the editor."
msgstr "Koordinátaszintű helyettesítési szabályt hoz létre a megadott azonosítókhoz. A szabály egy csempeazonosító-készletet egy másikra képez le. Koordinátaszintű helyettesítéskor az alternatív csempeazonosító nem változik.\nA helyettesített csempék a szerkesztő segítségével automatikusan kicserélhetők a TileMapLayer csomópontokban."

#. TileSet.set_navigation_layer_layer_value
#: doc/classes/TileSet.xml
msgid "Based on [param value], enables or disables the specified navigation layer of the TileSet navigation data layer identified by the given [param layer_index], given a navigation_layers [param layer_number] between 1 and 32."
msgstr "A [param value] alapján engedélyezi vagy letiltja a [param layer_index] indexű TileSet-navigációs adatréteg megadott navigációs rétegét. A navigation_layers [param layer_number] sorszáma 1 és 32 közötti lehet."

#. TileSet.set_occlusion_layer_light_mask
#: doc/classes/TileSet.xml
msgid "Sets the occlusion layer (as in the rendering server) for occluders in the given TileSet occlusion layer."
msgstr "Beállítja a megadott TileSet-fénykitakarási rétegben található fénykitakarók renderelési kiszolgáló szerinti fénykitakarási rétegét."

#. TileSet.set_occlusion_layer_sdf_collision
#: doc/classes/TileSet.xml
msgid "Enables or disables SDF collision for occluders in the given TileSet occlusion layer."
msgstr "Engedélyezi vagy letiltja az SDF-alapú ütközést a megadott TileSet-fénykitakarási rétegben található fénykitakaróknál."

#. TileSet.set_physics_layer_collision_priority
#: doc/classes/TileSet.xml
msgid "Sets the collision priority for bodies in the given TileSet physics layer."
msgstr "Beállítja a megadott TileSet-fizikai réteg testeihez tartozó ütközési prioritást."

#. TileSet.set_physics_layer_physics_material
#: doc/classes/TileSet.xml
msgid "Sets the physics material for bodies in the given TileSet physics layer."
msgstr "Beállítja a megadott TileSet-fizikai réteg testeihez tartozó fizikai anyagot."

#. TileSet.set_source_id
#: doc/classes/TileSet.xml
msgid "Changes a source's ID."
msgstr "Megváltoztatja egy csempeforrás azonosítóját."

#. TileSet.set_source_level_tile_proxy
#: doc/classes/TileSet.xml
msgid "Creates a source-level proxy for the given source ID. A proxy will map set of tile identifiers to another set of identifiers. Both the atlas coordinates ID and the alternative tile ID are kept the same when using source-level proxies.\nProxied tiles can be automatically replaced in TileMapLayer nodes using the editor."
msgstr "Forrásszintű helyettesítési szabályt hoz létre a megadott forrásazonosítóhoz. A szabály egy csempeazonosító-készletet egy másikra képez le. Forrásszintű helyettesítéskor az atlaszkoordináta- és az alternatív csempeazonosító változatlan marad.\nA helyettesített csempék a szerkesztő segítségével automatikusan kicserélhetők a TileMapLayer csomópontokban."

#. TileSetAtlasSource.brief
#: doc/classes/TileSetAtlasSource.xml
msgid "Exposes a 2D atlas texture as a set of tiles for a [TileSet] resource."
msgstr "Egy 2D atlasztextúrát tesz elérhetővé csempék gyűjteményeként egy [TileSet] erőforrás számára."

#. TileSetAtlasSource.texture
#: doc/classes/TileSetAtlasSource.xml
msgid "The atlas texture."
msgstr "Az atlasz textúrája."

#. TileSetAtlasSource.texture_region_size
#: doc/classes/TileSetAtlasSource.xml
msgid "The base tile size in the texture (in pixel). This size must be bigger than or equal to the TileSet's [code]tile_size[/code] value."
msgstr "A textúrában található alapcsempe mérete (képpontban). Ennek legalább akkorának kell lennie, mint a TileSet [code]tile_size[/code] értéke."

#. TileSetAtlasSource.margins
#: doc/classes/TileSetAtlasSource.xml
msgid "Margins, in pixels, to offset the origin of the grid in the texture."
msgstr "A textúrán lévő rács kezdőpontjának eltolására szolgáló margók, képpontban megadva."

#. TileSetAtlasSource.separation
#: doc/classes/TileSetAtlasSource.xml
msgid "Separation, in pixels, between each tile texture region of the grid."
msgstr "A rács egyes csempetextúra-területei közötti távolság, képpontban."

#. TileSetAtlasSource.use_texture_padding
#: doc/classes/TileSetAtlasSource.xml
msgid "If [code]true[/code], generates an internal texture with an additional one pixel padding around each tile. Texture padding avoids a common artifact where lines appear between tiles.\nDisabling this setting might lead a small performance improvement, as generating the internal texture requires both memory and processing time when the TileSetAtlasSource resource is modified."
msgstr "Ha [code]true[/code], létrehoz egy belső textúrát, amelyben minden csempe körül további egy képpontnyi szegély található. Ez megakadályozza azt a gyakori képhibát, amikor vonalak látszanak a csempék között.\nA beállítás letiltása kis teljesítménynövekedést eredményezhet, mert a belső textúra létrehozása memória- és feldolgozási időt igényel, valahányszor a TileSetAtlasSource erőforrás módosul."

#. TileSetAtlasSource.create_tile
#: doc/classes/TileSetAtlasSource.xml
msgid "Creates a new tile at coordinates [param atlas_coords] with the given [param size]."
msgstr "Új csempét hoz létre a [param atlas_coords] koordinátáknál, a megadott [param size] mérettel."

#. TileSetAtlasSource.create_alternative_tile
#: doc/classes/TileSetAtlasSource.xml
msgid "Creates an alternative tile for the tile at coordinates [param atlas_coords]. If [param alternative_id_override] is -1, give it an automatically generated unique ID, or assigns it the given ID otherwise.\nReturns the new alternative identifier, or -1 if the alternative could not be created with a provided [param alternative_id_override]."
msgstr "Alternatív csempét hoz létre a [param atlas_coords] koordinátáknál található csempéhez. Ha [param alternative_id_override] értéke -1, automatikusan egyedi azonosítót hoz létre, egyébként a megadott azonosítót állítja be.\nVisszaadja az új alternatív azonosítót, vagy -1-et, ha az alternatíva nem hozható létre a megadott [param alternative_id_override] értékkel."

#. TileSetAtlasSource.has_room_for_tile
#: doc/classes/TileSetAtlasSource.xml
msgid "Returns whether there is enough room in an atlas to create/modify a tile with the given properties. If [param ignored_tile] is provided, act as is the given tile was not present in the atlas. This may be used when you want to modify a tile's properties."
msgstr "Visszaadja, hogy van-e elegendő hely az atlaszban a megadott tulajdonságú csempe létrehozásához vagy módosításához. Ha [param ignored_tile] meg van adva, úgy vizsgálja a helyet, mintha ez a csempe nem lenne az atlaszban. Ez akkor hasznos, ha egy meglévő csempe tulajdonságait szeretnéd módosítani."

#. TileSetAtlasSource.has_tiles_outside_texture
#: doc/classes/TileSetAtlasSource.xml
msgid "Checks if the source has any tiles that don't fit the texture area (either partially or completely)."
msgstr "Ellenőrzi, hogy van-e a forrásban olyan csempe, amely részben vagy teljesen kívül esik a textúra területén."

#. TileSetAtlasSource.clear_tiles_outside_texture
#: doc/classes/TileSetAtlasSource.xml
msgid "Removes all tiles that don't fit the available texture area. This method iterates over all the source's tiles, so it's advised to use [method has_tiles_outside_texture] beforehand."
msgstr "Eltávolítja az összes csempét, amely nem fér el a rendelkezésre álló textúraterületen. A metódus a forrás összes csempéjét végigvizsgálja, ezért előtte célszerű a [method has_tiles_outside_texture] metódust használni."

#. TileSetAtlasSource.get_tiles_to_be_removed_on_change
#: doc/classes/TileSetAtlasSource.xml
msgid "Returns an array of tiles coordinates ID that will be automatically removed when modifying one or several of those properties: [param texture], [param margins], [param separation] or [param texture_region_size]. This can be used to undo changes that would have caused tiles data loss."
msgstr "Visszaadja azon csempék atlaszkoordináta-azonosítóinak tömbjét, amelyeket a rendszer automatikusan eltávolítana az alábbi tulajdonságok valamelyikének módosításakor: [param texture], [param margins], [param separation] vagy [param texture_region_size]. Ez segíthet visszavonni az olyan változtatásokat, amelyek csempeadatok elvesztéséhez vezetnének."

#. TileSetAtlasSource.remove_tile
#: doc/classes/TileSetAtlasSource.xml
msgid "Remove a tile and its alternative at coordinates [param atlas_coords]."
msgstr "Eltávolítja a [param atlas_coords] koordinátáknál található csempét és annak alternatíváit."

#. TileSetAtlasSource.remove_alternative_tile
#: doc/classes/TileSetAtlasSource.xml
msgid "Remove a tile's alternative with alternative ID [param alternative_tile].\nCalling this function with [param alternative_tile] equals to 0 will fail, as the base tile alternative cannot be removed."
msgstr "Eltávolítja a csempe [param alternative_tile] alternatív azonosítójú változatát.\nA függvény meghívása 0 értékű [param alternative_tile] paraméterrel sikertelen lesz, mert az alapcsempe alternatívája nem távolítható el."

#. TileSetAtlasSource.get_tile_data
#: doc/classes/TileSetAtlasSource.xml
msgid "Returns the [TileData] object for the given atlas coordinates and alternative ID."
msgstr "Visszaadja a megadott atlaszkoordinátákhoz és alternatív azonosítóhoz tartozó [TileData] objektumot."

#. TileSetAtlasSource.get_tile_texture_region
#: doc/classes/TileSetAtlasSource.xml
msgid "Returns a tile's texture region in the atlas texture. For animated tiles, a [param frame] argument might be provided for the different frames of the animation."
msgstr "Visszaadja a csempe textúraterületét az atlasztextúrában. Animált csempéknél a [param frame] paraméterrel megadható az animáció kívánt képkockája."

#. TileSetAtlasSource.get_atlas_grid_size
#: doc/classes/TileSetAtlasSource.xml
msgid "Returns the atlas grid size, which depends on how many tiles can fit in the texture. It thus depends on the [member texture]'s size, the atlas [member margins], and the tiles' [member texture_region_size]."
msgstr "Visszaadja az atlaszrács méretét, amely attól függ, hány csempe fér el a textúrán. Ezt a [member texture] mérete, az atlasz [member margins] margói és a csempék [member texture_region_size] mérete határozza meg."

#. TileSetAtlasSource.get_tile_animation_frames_count
#: doc/classes/TileSetAtlasSource.xml
msgid "Returns how many animation frames has the tile at coordinates [param atlas_coords]."
msgstr "Visszaadja a [param atlas_coords] koordinátáknál található csempe animációs képkockáinak számát."

#. TileSetAtlasSource.get_tile_animation_speed
#: doc/classes/TileSetAtlasSource.xml
msgid "Returns the animation speed of the tile at coordinates [param atlas_coords]."
msgstr "Visszaadja a [param atlas_coords] koordinátáknál található csempe animációs sebességét."

#. TileSetAtlasSource.set_tile_animation_speed
#: doc/classes/TileSetAtlasSource.xml
msgid "Sets the animation speed of the tile at coordinates [param atlas_coords] has."
msgstr "Beállítja a [param atlas_coords] koordinátáknál található csempe animációs sebességét."

#. TileSetAtlasSource.get_tile_animation_total_duration
#: doc/classes/TileSetAtlasSource.xml
msgid "Returns the sum of the sum of the frame durations of the tile at coordinates [param atlas_coords]. This value needs to be divided by the animation speed to get the actual animation loop duration."
msgstr "Visszaadja a [param atlas_coords] koordinátáknál található csempe animációs képkockái időtartamainak összegét. A tényleges animációs ciklus hosszának meghatározásához ezt az értéket el kell osztani az animáció sebességével."

#. TileData.brief
#: doc/classes/TileData.xml
msgid "Settings for a single tile in a [TileSet]."
msgstr "Egyetlen csempe beállításai egy [TileSet] készletben."

#. TileData.description
#: doc/classes/TileData.xml
msgid "[TileData] object represents a single tile in a [TileSet]. It is usually edited using the tileset editor, but it can be modified at runtime using [method TileMapLayer._tile_data_runtime_update]."
msgstr "A [TileData] objektum egyetlen csempét képvisel egy [TileSet] készletben. Általában a csempekészlet-szerkesztőben módosítható, de futás közben is változtatható a [method TileMapLayer._tile_data_runtime_update] használatával."

#. TileData.flip_h
#: doc/classes/TileData.xml
msgid "If [code]true[/code], the tile will have its texture flipped horizontally."
msgstr "Ha [code]true[/code], a csempe textúrája vízszintesen tükrözve jelenik meg."

#. TileData.flip_v
#: doc/classes/TileData.xml
msgid "If [code]true[/code], the tile will have its texture flipped vertically."
msgstr "Ha [code]true[/code], a csempe textúrája függőlegesen tükrözve jelenik meg."

#. TileData.transpose
#: doc/classes/TileData.xml
msgid "If [code]true[/code], the tile will display transposed, i.e. with horizontal and vertical texture UVs swapped."
msgstr "Ha [code]true[/code], a csempe transzponálva jelenik meg, azaz a vízszintes és függőleges textúra-UV-koordináták felcserélődnek."

#. TileData.texture_origin
#: doc/classes/TileData.xml
msgid "Offsets the position of where the tile is drawn."
msgstr "Eltolja a csempe kirajzolási helyét."

#. TileData.modulate
#: doc/classes/TileData.xml
msgid "Color modulation of the tile."
msgstr "A csempe színét módosító szorzótényező."

#. TileData.probability
#: doc/classes/TileData.xml
msgid "Relative probability of this tile being selected when drawing a pattern of random tiles."
msgstr "A csempe relatív kiválasztási valószínűsége véletlenszerű csempékből álló minta festésekor."

#. TileData.y_sort_origin
#: doc/classes/TileData.xml
msgid "Vertical point of the tile used for determining y-sorted order."
msgstr "A csempe Y-rendezéshez használt függőleges referenciapontja, amely meghatározza a kirajzolási sorrendet."

#. TileData.z_index
#: doc/classes/TileData.xml
msgid "Ordering index of this tile, relative to [TileMapLayer]."
msgstr "A csempe kirajzolási sorrendjét meghatározó index a [TileMapLayer] réteghez viszonyítva."

#. TileData.material
#: doc/classes/TileData.xml
msgid "The [Material] to use for this [TileData]. This can be a [CanvasItemMaterial] to use the default shader, or a [ShaderMaterial] to use a custom shader."
msgstr "Az ehhez a [TileData] objektumhoz rendelt [Material]. Ez lehet [CanvasItemMaterial] az alapértelmezett shaderhez, vagy [ShaderMaterial] egyedi shader használatához."

#. TileData.get_custom_data
#: doc/classes/TileData.xml
msgid "Returns the custom data value for custom data layer named [param layer_name]. To check if a custom data layer exists, use [method has_custom_data]."
msgstr "Visszaadja a [param layer_name] nevű egyediadatréteghez tartozó értéket. A réteg létezését a [method has_custom_data] metódussal ellenőrizheted."

#. TileData.set_custom_data
#: doc/classes/TileData.xml
msgid "Sets the tile's custom data value for the TileSet custom data layer with name [param layer_name]."
msgstr "Beállítja a csempe egyedi adatának értékét a [param layer_name] nevű TileSet-egyediadatrétegben."

#. TileData.has_custom_data
#: doc/classes/TileData.xml
msgid "Returns whether there exists a custom data layer named [param layer_name]."
msgstr "Megadja, hogy létezik-e [param layer_name] nevű egyediadatréteg."

#. TileData.get_collision_polygons_count
#: doc/classes/TileData.xml
msgid "Returns how many polygons the tile has for TileSet physics layer with index [param layer_id]."
msgstr "Visszaadja, hány ütközési sokszöge van a csempének a [param layer_id] indexű TileSet-fizikai rétegen."

#. TileData.get_collision_polygon_points
#: doc/classes/TileData.xml
msgid "Returns the points of the polygon at index [param polygon_index] for TileSet physics layer with index [param layer_id]."
msgstr "Visszaadja a [param polygon_index] indexű sokszög pontjait a [param layer_id] indexű TileSet-fizikai rétegen."

#. TileData.set_collision_polygon_points
#: doc/classes/TileData.xml
msgid "Sets the points of the polygon at index [param polygon_index] for TileSet physics layer with index [param layer_id]."
msgstr "Beállítja a [param polygon_index] indexű sokszög pontjait a [param layer_id] indexű TileSet-fizikai rétegen."

#. TileData.get_navigation_polygon
#: doc/classes/TileData.xml
msgid "Returns the navigation polygon of the tile for the TileSet navigation layer with index [param layer_id].\n[param flip_h], [param flip_v], and [param transpose] allow transforming the returned polygon."
msgstr "Visszaadja a csempe navigációs sokszögét a [param layer_id] indexű TileSet-navigációs rétegen.\nA [param flip_h], [param flip_v] és [param transpose] paraméterekkel a visszaadott sokszög átalakítható."

#. TileData.get_terrain_peering_bit
#: doc/classes/TileData.xml
msgid "Returns the tile's terrain bit for the given [param peering_bit] direction. To check that a direction is valid, use [method is_valid_terrain_peering_bit]."
msgstr "Visszaadja a csempe terepilleszkedési bitjét a megadott [param peering_bit] irányhoz. Az irány érvényességét a [method is_valid_terrain_peering_bit] metódussal ellenőrizheted."

#. AnimatedSprite2D.brief
#: doc/classes/AnimatedSprite2D.xml
msgid "Sprite node that contains multiple textures as frames to play for animation."
msgstr "Több textúrából álló animációt lejátszó sprite-csomópont."

#. AnimatedSprite2D.description
#: doc/classes/AnimatedSprite2D.xml
msgid "[AnimatedSprite2D] is similar to the [Sprite2D] node, except it carries multiple textures as animation frames. Animations are created using a [SpriteFrames] resource, which allows you to import image files (or a folder containing said files) to provide the animation frames for the sprite. The [SpriteFrames] resource can be configured in the editor via the SpriteFrames bottom panel."
msgstr "Az [AnimatedSprite2D] hasonló a [Sprite2D] csomóponthoz, de egyetlen textúra helyett több textúrát tárol animációs képkockákként. Az animációk [SpriteFrames] erőforrás segítségével készülnek; ebbe képfájlokat (vagy azokat tartalmazó mappát) importálhatsz, hogy megadd a sprite animációs képkockáit. A [SpriteFrames] erőforrást a szerkesztő alsó SpriteFrames paneljén állíthatod be."

#. AnimatedSprite2D.sprite_frames
#: doc/classes/AnimatedSprite2D.xml
msgid "The [SpriteFrames] resource containing the animation(s). Allows you the option to load, edit, clear, make unique and save the states of the [SpriteFrames] resource."
msgstr "Az animációkat tartalmazó [SpriteFrames] erőforrás. Lehetővé teszi a [SpriteFrames] erőforrás állapotainak betöltését, szerkesztését, törlését, egyedivé tételét és mentését."

#. AnimatedSprite2D.animation
#: doc/classes/AnimatedSprite2D.xml
msgid "The current animation from the [member sprite_frames] resource. If this value is changed, the [member frame] counter and the [member frame_progress] are reset."
msgstr "A [member sprite_frames] erőforrás aktuális animációja. Az érték módosításakor a [member frame] számláló és a [member frame_progress] előrehaladás visszaáll."

#. AnimatedSprite2D.autoplay
#. AnimationPlayer.autoplay
#: doc/classes/AnimatedSprite2D.xml
#: doc/classes/AnimationPlayer.xml
msgid "The key of the animation to play when the scene loads."
msgstr "A jelenet betöltésekor automatikusan lejátszandó animáció kulcsa."

#. AnimatedSprite2D.play
#: doc/classes/AnimatedSprite2D.xml
msgid "Plays the animation with key [param name]. If [param custom_speed] is negative and [param from_end] is [code]true[/code], the animation will play backwards (which is equivalent to calling [method play_backwards]).\nIf this method is called with that same animation [param name], or with no [param name] parameter, the assigned animation will resume playing if it was paused."
msgstr "Lejátssza a [param name] kulcsú animációt. Ha a [param custom_speed] negatív, és a [param from_end] értéke [code]true[/code], az animáció visszafelé játszódik le (ez megfelel a [method play_backwards] meghívásának).\nHa a metódust ugyanazzal a [param name] animációval vagy [param name] paraméter nélkül hívod meg, a korábban szüneteltetett animáció lejátszása folytatódik."

#. AnimatedSprite2D.play_backwards
#. AnimationPlayer.play_backwards
#: doc/classes/AnimatedSprite2D.xml
#: doc/classes/AnimationPlayer.xml
msgid "Plays the animation with key [param name] in reverse.\nThis method is a shorthand for [method play] with [code]custom_speed = -1.0[/code] and [code]from_end = true[/code], so see its description for more information."
msgstr "Visszafelé játssza le a [param name] kulcsú animációt.\nEz a [method play] metódus rövidített hívása [code]custom_speed = -1.0[/code] és [code]from_end = true[/code] paraméterekkel; részletekért lásd annak leírását."

#. AnimatedSprite2D.stop
#: doc/classes/AnimatedSprite2D.xml
msgid "Stops the currently playing animation. The animation position is reset to [code]0[/code] and the [code]custom_speed[/code] is reset to [code]1.0[/code]. See also [method pause]."
msgstr "Leállítja az éppen futó animációt. A lejátszási pozíció visszaáll [code]0[/code] értékre, a [code]custom_speed[/code] pedig [code]1.0[/code] lesz. Lásd még: [method pause]."

#. AnimatedSprite2D.pause
#: doc/classes/AnimatedSprite2D.xml
msgid "Pauses the currently playing animation. The [member frame] and [member frame_progress] will be kept and calling [method play] or [method play_backwards] without arguments will resume the animation from the current playback position.\nSee also [method stop]."
msgstr "Szünetelteti az éppen futó animációt. A [member frame] és a [member frame_progress] megmarad; a [method play] vagy [method play_backwards] paraméter nélküli meghívása az aktuális pozíciótól folytatja a lejátszást.\nLásd még: [method stop]."

#. AnimatedSprite2D.is_playing
#. AnimationPlayer.is_playing
#: doc/classes/AnimatedSprite2D.xml
#: doc/classes/AnimationPlayer.xml
msgid "Returns [code]true[/code] if an animation is currently playing (even if [member speed_scale] and/or [code]custom_speed[/code] are [code]0[/code])."
msgstr "[code]true[/code] értéket ad vissza, ha éppen animáció lejátszása zajlik (akkor is, ha a [member speed_scale] és/vagy a [code]custom_speed[/code] értéke [code]0[/code])."

#. AnimatedSprite2D.flip_h
#. Sprite2D.flip_h
#. TextureRect.flip_h
#: doc/classes/AnimatedSprite2D.xml
#: doc/classes/Sprite2D.xml
#: doc/classes/TextureRect.xml
msgid "If [code]true[/code], texture is flipped horizontally."
msgstr "Ha [code]true[/code], vízszintesen tükrözi a textúrát."

#. AnimatedSprite2D.flip_v
#. Sprite2D.flip_v
#. TextureRect.flip_v
#: doc/classes/AnimatedSprite2D.xml
#: doc/classes/Sprite2D.xml
#: doc/classes/TextureRect.xml
msgid "If [code]true[/code], texture is flipped vertically."
msgstr "Ha [code]true[/code], függőlegesen tükrözi a textúrát."

#. AnimatedSprite2D.frame
#: doc/classes/AnimatedSprite2D.xml
msgid "The displayed animation frame's index. Setting this property also resets [member frame_progress]. If this is not desired, use [method set_frame_and_progress]."
msgstr "A megjelenített animációs képkocka indexe. A tulajdonság beállítása a [member frame_progress] értékét is visszaállítja. Ha ezt el akarod kerülni, használd a [method set_frame_and_progress] metódust."

#. AnimatedSprite2D.frame_progress
#: doc/classes/AnimatedSprite2D.xml
msgid "The progress value between [code]0.0[/code] and [code]1.0[/code] until the current frame transitions to the next frame. If the animation is playing backwards, the value transitions from [code]1.0[/code] to [code]0.0[/code]."
msgstr "Az aktuális képkocka lejátszásának előrehaladása [code]0.0[/code] és [code]1.0[/code] között. Ha az animáció visszafelé játszódik, az érték [code]1.0[/code] felől [code]0.0[/code] felé halad."

#. AnimatedSprite2D.speed_scale
#. AnimationPlayer.speed_scale
#: doc/classes/AnimatedSprite2D.xml
#: doc/classes/AnimationPlayer.xml
msgid "The speed scaling ratio. For example, if this value is [code]1[/code], then the animation plays at normal speed. If it's [code]0.5[/code], then it plays at half speed. If it's [code]2[/code], then it plays at double speed.\nIf set to a negative value, the animation is played in reverse. If set to [code]0[/code], the animation will not advance."
msgstr "Az animáció sebességének szorzója. Például a [code]1[/code] normál sebességet, a [code]0.5[/code] félsebességet, a [code]2[/code] kétszeres sebességet jelent.\nNegatív értéknél az animáció visszafelé játszódik. [code]0[/code] értéknél nem lép tovább."

#. AnimatedSprite2D.centered
#: doc/classes/AnimatedSprite2D.xml
msgid "If [code]true[/code], texture will be centered.\n[b]Note:[/b] For games with a pixel art aesthetic, textures may appear deformed when centered. This is caused by their position being between pixels. To prevent this, set this property to [code]false[/code], or consider enabling [member ProjectSettings.rendering/2d/snap/snap_2d_vertices_to_pixel] and [member ProjectSettings.rendering/2d/snap/snap_2d_transforms_to_pixel]."
msgstr "Ha [code]true[/code], a textúra középre kerül.\n[b]Megjegyzés:[/b] Pixelgrafikás játékokban a textúrák középre igazítva torzulhatnak, ha a pozíciójuk képpontok közé esik. Ennek elkerülésére állítsd a tulajdonságot [code]false[/code] értékre, vagy kapcsold be a [member ProjectSettings.rendering/2d/snap/snap_2d_vertices_to_pixel] és [member ProjectSettings.rendering/2d/snap/snap_2d_transforms_to_pixel] beállításokat."

#. AnimatedSprite2D.offset
#: doc/classes/AnimatedSprite2D.xml
msgid "The texture's drawing offset."
msgstr "A textúra kirajzolási eltolása."

#. AnimatedSprite2D.get_playing_speed
#. AnimationPlayer.get_playing_speed
#: doc/classes/AnimatedSprite2D.xml
#: doc/classes/AnimationPlayer.xml
msgid "Returns the actual playing speed of current animation or [code]0[/code] if not playing. This speed is the [member speed_scale] property multiplied by [code]custom_speed[/code] argument specified when calling the [method play] method.\nReturns a negative value if the current animation is playing backwards."
msgstr "Visszaadja az aktuális animáció tényleges lejátszási sebességét, illetve [code]0[/code] értéket, ha nincs lejátszás. A sebesség a [member speed_scale] tulajdonság és a [method play] meghívásakor megadott [code]custom_speed[/code] paraméter szorzata.\nNegatív értéket ad vissza, ha az animáció visszafelé játszódik."

#. CharacterBody2D.brief
#: doc/classes/CharacterBody2D.xml
msgid "A 2D physics body specialized for characters moved by script."
msgstr "Kifejezetten scripttel mozgatott karakterekhez készült 2D fizikai test."

#. CharacterBody2D.description
#: doc/classes/CharacterBody2D.xml
msgid "[CharacterBody2D] is a specialized class for physics bodies that are meant to be user-controlled. They are not affected by physics at all, but they affect other physics bodies in their path. They are mainly used to provide high-level API to move objects with wall and slope detection ([method move_and_slide] method) in addition to the general collision detection provided by [method PhysicsBody2D.move_and_collide]. This makes it useful for highly configurable physics bodies that must move in specific ways and collide with the world, as is often the case with user-controlled characters.\nFor game objects that don't require complex movement or collision detection, such as moving platforms, [AnimatableBody2D] is simpler to configure."
msgstr "A [CharacterBody2D] olyan speciális fizikai test, amelyet a felhasználó vezérelhet. A fizikai rendszer nem mozgatja automatikusan, de a test hatással lehet az útjába kerülő más fizikai testekre. Elsősorban magas szintű mozgáskezelést kínál falak és lejtők felismerésével ([method move_and_slide]), a [method PhysicsBody2D.move_and_collide] általános ütközésérzékelése mellett. Ez különösen hasznos olyan testekhez, amelyek meghatározott módon mozognak, és ütköznek a világgal, mint például a játékos által irányított karakterek.\nAzokhoz a játékobjektumokhoz, amelyeknél nincs szükség összetett mozgásra vagy ütközésérzékelésre (például mozgó platformoknál), az [AnimatableBody2D] egyszerűbben beállítható."

#. CharacterBody2D.velocity
#: doc/classes/CharacterBody2D.xml
msgid "Current velocity vector in pixels per second, used and modified during calls to [method move_and_slide].\n[b]Note:[/b] A common mistake is setting this property to the desired velocity multiplied by [code]delta[/code], which produces a motion vector in pixels."
msgstr "Az aktuális sebességvektor képpont/másodperc egységben, amelyet a [method move_and_slide] hívás felhasznál és módosíthat.\n[b]Megjegyzés:[/b] Gyakori hiba, hogy ezt a tulajdonságot a kívánt sebesség és a [code]delta[/code] szorzatára állítják; így képpontban megadott elmozdulásvektor keletkezik."

#. CharacterBody2D.motion_mode
#: doc/classes/CharacterBody2D.xml
msgid "Sets the motion mode which defines the behavior of [method move_and_slide]."
msgstr "Beállítja a [method move_and_slide] működését meghatározó mozgási módot."

#. CharacterBody2D.move_and_slide
#: doc/classes/CharacterBody2D.xml
msgid "Moves the body based on [member velocity]. If the body collides with another, it will slide along the other body (by default only on floor) rather than stop immediately. If the other body is a [CharacterBody2D] or [RigidBody2D], it will also be affected by the motion of the other body. You can use this to make moving and rotating platforms, or to make nodes push other nodes.\nThis method should be used in [method Node._physics_process] (or in a method called by [method Node._physics_process]), as it uses the physics step's [code]delta[/code] value automatically in calculations. Otherwise, the simulation will run at an incorrect speed.\nModifies [member velocity] if a slide collision occurred. To get the latest collision call [method get_last_slide_collision], for detailed information about collisions that occurred, use [method get_slide_collision].\nWhen the body touches a moving platform, the platform's velocity is automatically added to the body motion. If a collision occurs due to the platform's motion, it will always be first in the slide collisions.\nThe general behavior and available properties change according to the [member motion_mode].\nReturns [code]true[/code] if the body collided, otherwise, returns [code]false[/code]."
msgstr "A testet a [member velocity] alapján mozgatja. Ha a test egy másiknak ütközik, nem áll meg azonnal, hanem elcsúszhat annak felülete mentén (alapértelmezés szerint csak a padlón). Ha a másik test [CharacterBody2D] vagy [RigidBody2D], annak mozgása is hatással van rá. Ezzel például mozgó és forgó platformokat készíthetsz, vagy egyes csomópontokkal más csomópontokat mozgathatsz ütközéssel.\nA metódust a [method Node._physics_process] függvényben (vagy a [method Node._physics_process] által meghívott függvényben) kell használni, mert a számításokhoz automatikusan a fizikai lépés [code]delta[/code] értékét veszi figyelembe. Egyébként a szimuláció hibás sebességgel futna.\nCsúszással járó ütközéskor módosítja a [member velocity] értékét. A legutóbbi ütközést a [method get_last_slide_collision] segítségével kérdezheted le, részletes ütközési adatokhoz pedig a [method get_slide_collision] metódust használhatod. \nHa a test mozgó platformhoz ér, a platform sebessége automatikusan hozzáadódik a test mozgásához. Ha a platform mozgása miatt ütközés történik, az mindig az első lesz a csúszásos ütközések között.\nAz általános működés és az elérhető tulajdonságok a [member motion_mode] beállítástól függnek.\nÜtközés esetén [code]true[/code], egyébként [code]false[/code] értéket ad vissza."

#. CharacterBody2D.is_on_floor
#: doc/classes/CharacterBody2D.xml
msgid "Returns [code]true[/code] if the body collided with the floor on the last call of [method move_and_slide]. Otherwise, returns [code]false[/code]. The [member up_direction] and [member floor_max_angle] are used to determine whether a surface is \"floor\" or not."
msgstr "[code]true[/code] értéket ad vissza, ha a test a [method move_and_slide] legutóbbi hívásakor padlóval ütközött, egyébként [code]false[/code] értéket. A padló felismeréséhez a [member up_direction] és a [member floor_max_angle] tulajdonságokat használja."

#. CharacterBody2D.is_on_wall
#: doc/classes/CharacterBody2D.xml
msgid "Returns [code]true[/code] if the body collided with a wall on the last call of [method move_and_slide]. Otherwise, returns [code]false[/code]. The [member up_direction] and [member floor_max_angle] are used to determine whether a surface is \"wall\" or not."
msgstr "[code]true[/code] értéket ad vissza, ha a test a [method move_and_slide] legutóbbi hívásakor fallal ütközött, egyébként [code]false[/code] értéket. A fal felismeréséhez a [member up_direction] és a [member floor_max_angle] tulajdonságokat használja."

#. CharacterBody2D.is_on_ceiling
#: doc/classes/CharacterBody2D.xml
msgid "Returns [code]true[/code] if the body collided with the ceiling on the last call of [method move_and_slide]. Otherwise, returns [code]false[/code]. The [member up_direction] and [member floor_max_angle] are used to determine whether a surface is \"ceiling\" or not."
msgstr "[code]true[/code] értéket ad vissza, ha a test a [method move_and_slide] legutóbbi hívásakor mennyezettel ütközött, egyébként [code]false[/code] értéket. A mennyezet felismeréséhez a [member up_direction] és a [member floor_max_angle] tulajdonságokat használja."

#. CharacterBody2D.get_real_velocity
#: doc/classes/CharacterBody2D.xml
msgid "Returns the current real velocity since the last call to [method move_and_slide]. For example, when you climb a slope, you will move diagonally even though the velocity is horizontal. This method returns the diagonal movement, as opposed to [member velocity] which returns the requested velocity."
msgstr "Visszaadja a [method move_and_slide] legutóbbi hívása óta érvényes tényleges sebességet. Például lejtőn felfelé haladva a test átlósan mozoghat akkor is, ha a megadott sebesség vízszintes. Ez a metódus a tényleges átlós mozgás sebességét adja vissza, szemben a kívánt sebességet megadó [member velocity] értékkel."

#. CharacterBody2D.get_last_motion
#: doc/classes/CharacterBody2D.xml
msgid "Returns the last motion applied to the [CharacterBody2D] during the last call to [method move_and_slide]. The movement can be split into multiple motions when sliding occurs, and this method return the last one, which is useful to retrieve the current direction of the movement."
msgstr "Visszaadja a legutóbbi [method move_and_slide] hívás során a [CharacterBody2D] testre alkalmazott utolsó elmozdulást. A csúszás miatt a mozgás több részre oszolhat; ez a metódus ezek közül az utolsót adja vissza, ami segít meghatározni az aktuális mozgásirányt."

#. CharacterBody2D.get_position_delta
#: doc/classes/CharacterBody2D.xml
msgid "Returns the travel (position delta) that occurred during the last call to [method move_and_slide]."
msgstr "Visszaadja a [method move_and_slide] legutóbbi hívása során megtett elmozdulást (pozícióváltozást)."

#. CharacterBody2D.get_slide_collision_count
#: doc/classes/CharacterBody2D.xml
msgid "Returns the number of times the body collided and changed direction during the last call to [method move_and_slide]."
msgstr "Visszaadja, hogy a test a [method move_and_slide] legutóbbi hívása során hányszor ütközött úgy, hogy irányt változtatott."

#. CharacterBody2D.max_slides
#: doc/classes/CharacterBody2D.xml
msgid "Maximum number of times the body can change direction before it stops when calling [method move_and_slide]. Must be greater than zero."
msgstr "Megadja, hogy a [method move_and_slide] meghívásakor a test legfeljebb hányszor változtathat irányt, mielőtt megáll. Az értéknek nullánál nagyobbnak kell lennie."

#. CharacterBody2D.floor_max_angle
#: doc/classes/CharacterBody2D.xml
msgid "Maximum angle (in radians) where a slope is still considered a floor (or a ceiling), rather than a wall, when calling [method move_and_slide]. The default value equals 45 degrees."
msgstr "A legnagyobb szög (radiánban), amelynél a lejtő még padlónak (vagy mennyezetnek) számít, nem pedig falnak a [method move_and_slide] használatakor. Az alapértelmezett érték 45 fok."

#. CharacterBody2D.floor_stop_on_slope
#: doc/classes/CharacterBody2D.xml
msgid "If [code]true[/code], the body will not slide on slopes when calling [method move_and_slide] when the body is standing still.\nIf [code]false[/code], the body will slide on floor's slopes when [member velocity] applies a downward force."
msgstr "Ha [code]true[/code], a nyugalomban lévő test a [method move_and_slide] használatakor nem csúszik le a lejtőn.\nHa [code]false[/code], a test lecsúszik a lejtőn, amikor a [member velocity] lefelé irányuló sebességkomponenst tartalmaz."

#. CharacterBody2D.apply_floor_snap
#: doc/classes/CharacterBody2D.xml
msgid "Allows to manually apply a snap to the floor regardless of the body's velocity. This function does nothing when [method is_on_floor] returns [code]true[/code]."
msgstr "Lehetővé teszi a test kézi talajhoz igazítását a sebességétől függetlenül. A metódus nem végez műveletet, ha a [method is_on_floor] [code]true[/code] értéket ad vissza."

#. CharacterBody2D.get_floor_angle
#: doc/classes/CharacterBody2D.xml
msgid "Returns the floor's collision angle at the last collision point according to [param up_direction], which is [constant Vector2.UP] by default. This value is always positive and only valid after calling [method move_and_slide] and when [method is_on_floor] returns [code]true[/code]."
msgstr "Visszaadja a padló ütközési szögét a legutóbbi ütközési pontban, a [param up_direction] irányhoz viszonyítva, amely alapértelmezés szerint [constant Vector2.UP]. Az eredmény mindig pozitív, és csak a [method move_and_slide] meghívása után érvényes, amikor a [method is_on_floor] [code]true[/code] értéket ad vissza."

#. CharacterBody2D.get_floor_normal
#: doc/classes/CharacterBody2D.xml
msgid "Returns the collision normal of the floor at the last collision point. Only valid after calling [method move_and_slide] and when [method is_on_floor] returns [code]true[/code].\n[b]Warning:[/b] The collision normal is not always the same as the surface normal."
msgstr "Visszaadja a padló ütközési normálvektorát a legutóbbi ütközési pontban. Csak a [method move_and_slide] meghívása után érvényes, amikor a [method is_on_floor] [code]true[/code] értéket ad vissza.\n[b]Figyelmeztetés:[/b] Az ütközési normálvektor nem minden esetben egyezik meg a felület normálvektorával."

#. CharacterBody2D.get_last_slide_collision
#: doc/classes/CharacterBody2D.xml
msgid "Returns a [KinematicCollision2D] if a collision occurred. The returned value contains information about the latest collision that occurred during the last call to [method move_and_slide]. Returns [code]null[/code] if no collision occurred. See also [method get_slide_collision]."
msgstr "Ha történt ütközés, egy [KinematicCollision2D] objektumot ad vissza, amely a legutóbbi [method move_and_slide] meghívás során történt utolsó ütközés adatait tartalmazza. Ha nem történt ütközés, [code]null[/code] értéket ad vissza. Lásd még: [method get_slide_collision]."

#. CharacterBody2D.get_platform_velocity
#: doc/classes/CharacterBody2D.xml
msgid "Returns the linear velocity of the platform at the last collision point. Only valid after calling [method move_and_slide]."
msgstr "Visszaadja a platform lineáris sebességét a legutóbbi ütközési pontban. Csak a [method move_and_slide] meghívása után érvényes."

#. CharacterBody2D.get_slide_collision
#: doc/classes/CharacterBody2D.xml
msgid "Returns a [KinematicCollision2D], which contains information about a collision that occurred during the last call to [method move_and_slide]. Since the body can collide several times in a single call to [method move_and_slide], you must specify the index of the collision in the range 0 to ([method get_slide_collision_count] - 1). See also [method get_last_slide_collision].\n[b]Example:[/b] Iterate through the collisions with a [code]for[/code] loop:\n[codeblocks]\n[gdscript]\nfor i in get_slide_collision_count():\nvar collision = get_slide_collision(i)\nprint(\"Collided with: \", collision.get_collider().name)\n[/gdscript]\n[csharp]\nfor (int i = 0; i &lt; GetSlideCollisionCount(); i++)\n{\nKinematicCollision2D collision = GetSlideCollision(i);\nGD.Print(\"Collided with: \", (collision.GetCollider() as Node).Name);\n}\n[/csharp]\n[/codeblocks]"
msgstr "Visszaadja a legutóbbi [method move_and_slide] hívás során történt ütközés adatait tartalmazó [KinematicCollision2D] objektumot. Mivel a test egyetlen [method move_and_slide] meghívás alatt többször is ütközhet, az ütközés indexét 0 és ([method get_slide_collision_count] - 1) között kell megadni. Lásd még: [method get_last_slide_collision].\n[b]Példa:[/b] Az ütközések bejárása [code]for[/code] ciklussal:\n[codeblocks]\n[gdscript]\nfor i in get_slide_collision_count():\nvar collision = get_slide_collision(i)\nprint(\"Collided with: \", collision.get_collider().name)\n[/gdscript]\n[csharp]\nfor (int i = 0; i &lt; GetSlideCollisionCount(); i++)\n{\nKinematicCollision2D collision = GetSlideCollision(i);\nGD.Print(\"Collided with: \", (collision.GetCollider() as Node).Name);\n}\n[/csharp]\n[/codeblocks]"

#. CharacterBody2D.get_wall_normal
#: doc/classes/CharacterBody2D.xml
msgid "Returns the collision normal of the wall at the last collision point. Only valid after calling [method move_and_slide] and when [method is_on_wall] returns [code]true[/code].\n[b]Warning:[/b] The collision normal is not always the same as the surface normal."
msgstr "Visszaadja a fal ütközési normálvektorát a legutóbbi ütközési pontban. Csak a [method move_and_slide] meghívása után érvényes, amikor a [method is_on_wall] [code]true[/code] értéket ad vissza.\n[b]Figyelmeztetés:[/b] Az ütközési normálvektor nem minden esetben egyezik meg a felület normálvektorával."

#. CharacterBody2D.is_on_ceiling_only
#: doc/classes/CharacterBody2D.xml
msgid "Returns [code]true[/code] if the body collided only with the ceiling on the last call of [method move_and_slide]. Otherwise, returns [code]false[/code]. The [member up_direction] and [member floor_max_angle] are used to determine whether a surface is \"ceiling\" or not."
msgstr "[code]true[/code] értéket ad vissza, ha a test a [method move_and_slide] legutóbbi hívásakor kizárólag a mennyezettel ütközött. Egyébként [code]false[/code] értéket ad vissza. A felület mennyezetként való felismerését a [member up_direction] és a [member floor_max_angle] határozza meg."

#. CharacterBody2D.is_on_floor_only
#: doc/classes/CharacterBody2D.xml
msgid "Returns [code]true[/code] if the body collided only with the floor on the last call of [method move_and_slide]. Otherwise, returns [code]false[/code]. The [member up_direction] and [member floor_max_angle] are used to determine whether a surface is \"floor\" or not."
msgstr "[code]true[/code] értéket ad vissza, ha a test a [method move_and_slide] legutóbbi hívásakor kizárólag a padlóval ütközött. Egyébként [code]false[/code] értéket ad vissza. A felület padlóként való felismerését a [member up_direction] és a [member floor_max_angle] határozza meg."

#. CharacterBody2D.is_on_wall_only
#: doc/classes/CharacterBody2D.xml
msgid "Returns [code]true[/code] if the body collided only with a wall on the last call of [method move_and_slide]. Otherwise, returns [code]false[/code]. The [member up_direction] and [member floor_max_angle] are used to determine whether a surface is \"wall\" or not."
msgstr "[code]true[/code] értéket ad vissza, ha a test a [method move_and_slide] legutóbbi hívásakor kizárólag a fallal ütközött. Egyébként [code]false[/code] értéket ad vissza. A felület falként való felismerését a [member up_direction] és a [member floor_max_angle] határozza meg."

#. CharacterBody2D.floor_block_on_wall
#: doc/classes/CharacterBody2D.xml
msgid "If [code]true[/code], the body will be able to move on the floor only. This option avoids to be able to walk on walls, it will however allow to slide down along them."
msgstr "Ha [code]true[/code], a test csak a padlón tud haladni. Ez megakadályozza a falon járást, de a fal mentén lefelé csúszást továbbra is engedélyezi."

#. CharacterBody2D.floor_constant_speed
#: doc/classes/CharacterBody2D.xml
msgid "If [code]false[/code] (by default), the body will move faster on downward slopes and slower on upward slopes.\nIf [code]true[/code], the body will always move at the same speed on the ground no matter the slope. Note that you need to use [member floor_snap_length] to stick along a downward slope at constant speed."
msgstr "Ha [code]false[/code] (ez az alapértelmezés), a test lejtőn lefelé gyorsabban, emelkedőn felfelé lassabban mozog.\nHa [code]true[/code], a test a lejtésétől függetlenül mindig azonos sebességgel halad a talajon. Fontos, hogy az állandó sebességű lefelé haladáshoz a [member floor_snap_length] segítségével kell a testet a lejtőhöz tapasztani."

#. CharacterBody2D.floor_snap_length
#: doc/classes/CharacterBody2D.xml
msgid "Sets a snapping distance. When set to a value different from [code]0.0[/code], the body is kept attached to slopes when calling [method move_and_slide]. The snapping vector is determined by the given distance along the opposite direction of the [member up_direction].\nAs long as the snapping vector is in contact with the ground and the body moves against [member up_direction], the body will remain attached to the surface. Snapping is not applied if the body moves along [member up_direction], meaning it contains vertical rising velocity, so it will be able to detach from the ground when jumping or when the body is pushed up by something. If you want to apply a snap without taking into account the velocity, use [method apply_floor_snap]."
msgstr "Beállítja a talajhoz igazítás távolságát. Ha az érték nem [code]0.0[/code], a test a [method move_and_slide] meghívásakor a lejtőhöz tapad. Az igazítás irányát a [member up_direction] ellentétes irányában mért megadott távolság határozza meg.\nAmíg az igazítás vektora érintkezik a talajjal, és a test a [member up_direction] irányával ellentétesen mozog, a felszínen marad. Az igazítás nem történik meg, ha a test a [member up_direction] irányában mozog, vagyis felfelé irányuló sebessége van, így ugráskor vagy felfelé lökéskor elemelkedhet a talajtól. Ha a sebesség figyelmen kívül hagyásával szeretnéd végrehajtani az igazítást, használd a [method apply_floor_snap] metódust."

#. CharacterBody2D.platform_floor_layers
#: doc/classes/CharacterBody2D.xml
msgid "Collision layers that will be included for detecting floor bodies that will act as moving platforms to be followed by the [CharacterBody2D]. By default, all floor bodies are detected and propagate their velocity."
msgstr "Azok az ütközési rétegek, amelyek padlóként érzékelt testei követhető mozgó platformként működnek a [CharacterBody2D] számára. Alapértelmezés szerint minden padlóként érzékelt test ide tartozik, és továbbadja a sebességét."

#. CharacterBody2D.platform_on_leave
#: doc/classes/CharacterBody2D.xml
msgid "Sets the behavior to apply when you leave a moving platform. By default, to be physically accurate, when you leave the last platform velocity is applied."
msgstr "Meghatározza a mozgó platform elhagyásakor alkalmazott működést. Alapértelmezés szerint a fizikai hűség érdekében az utolsó platform sebessége tovább hat a testre, amikor az elhagyja a platformot."

#. CharacterBody2D.platform_wall_layers
#: doc/classes/CharacterBody2D.xml
msgid "Collision layers that will be included for detecting wall bodies that will act as moving platforms to be followed by the [CharacterBody2D]. By default, all wall bodies are ignored."
msgstr "Azok az ütközési rétegek, amelyek falként érzékelt testei követhető mozgó platformként működnek a [CharacterBody2D] számára. Alapértelmezés szerint a falként érzékelt testeket figyelmen kívül hagyja a mozgó platformok követésekor."

#. CharacterBody2D.safe_margin
#: doc/classes/CharacterBody2D.xml
msgid "Extra margin used for collision recovery when calling [method move_and_slide].\nIf the body is at least this close to another body, it will consider them to be colliding and will be pushed away before performing the actual motion.\nA higher value means it's more flexible for detecting collision, which helps with consistently detecting walls and floors.\nA lower value forces the collision algorithm to use more exact detection, so it can be used in cases that specifically require precision, e.g at very low scale to avoid visible jittering, or for stability with a stack of character bodies."
msgstr "További biztonsági távolság az ütközések korrigálásához a [method move_and_slide] meghívásakor.\nHa a test ennyire vagy ennél közelebb kerül egy másik testhez, a rendszer ütközőnek tekinti őket, és még a tényleges elmozdulás előtt eltolja a testet a másiktól.\nA nagyobb érték rugalmasabb ütközésérzékelést biztosít, ami segíti a falak és padlók következetes felismerését.\nA kisebb érték pontosabb ütközésérzékelést kényszerít ki; ez például nagyon kis méretarány esetén csökkentheti a látható remegést, vagy segíthet az egymásra helyezett karaktertestek stabilitásában."

#. CharacterBody2D.slide_on_ceiling
#: doc/classes/CharacterBody2D.xml
msgid "If [code]true[/code], during a jump against the ceiling, the body will slide, if [code]false[/code] it will be stopped and will fall vertically."
msgstr "Ha [code]true[/code], a test mennyezetbe ugráskor elcsúszhat annak mentén. Ha [code]false[/code], megáll, majd függőlegesen leesik."

#. CharacterBody2D.up_direction
#: doc/classes/CharacterBody2D.xml
msgid "Vector pointing upwards, used to determine what is a wall and what is a floor (or a ceiling) when calling [method move_and_slide]. Defaults to [constant Vector2.UP]. As the vector will be normalized it can't be equal to [constant Vector2.ZERO], if you want all collisions to be reported as walls, consider using [constant MOTION_MODE_FLOATING] as [member motion_mode]."
msgstr "Felfelé mutató vektor, amely alapján a [method move_and_slide] meghatározza, hogy a felület fal, padló vagy mennyezet. Alapértelmezett értéke [constant Vector2.UP]. Mivel a vektort normalizálja, nem lehet [constant Vector2.ZERO]. Ha minden ütközést falként szeretnél kezelni, a [member motion_mode] tulajdonságnál használd a [constant MOTION_MODE_FLOATING] módot."

#. CharacterBody2D.wall_min_slide_angle
#: doc/classes/CharacterBody2D.xml
msgid "Minimum angle (in radians) where the body is allowed to slide when it encounters a wall. The default value equals 15 degrees. This property only affects movement when [member motion_mode] is [constant MOTION_MODE_FLOATING]."
msgstr "Az a legkisebb szög (radiánban), amelynél a test falnak ütközve elcsúszhat annak mentén. Alapértelmezés szerint 15 fok. Csak akkor befolyásolja a mozgást, ha a [member motion_mode] értéke [constant MOTION_MODE_FLOATING]."

#. Camera2D.brief
#: doc/classes/Camera2D.xml
msgid "Camera node for 2D scenes."
msgstr "Kameracsomópont 2D jelenetekhez."

#. Camera2D.enabled
#: doc/classes/Camera2D.xml
msgid "Controls whether the camera can be active or not. If [code]true[/code], the [Camera2D] will become the main camera when it enters the scene tree and there is no active camera currently (see [method Viewport.get_camera_2d]).\nWhen the camera is currently active and [member enabled] is set to [code]false[/code], the next enabled [Camera2D] in the scene tree will become active."
msgstr "Szabályozza, hogy a kamera aktívvá válhat-e. Ha [code]true[/code], a [Camera2D] a jelenetfába kerülésekor főkamerává válik, amennyiben nincs másik aktív kamera (lásd [method Viewport.get_camera_2d]).\nHa az aktuális kamera aktív, de a [member enabled] értékét [code]false[/code] értékre állítod, a jelenetfa következő engedélyezett [Camera2D] csomópontja válik aktívvá."

#. Camera2D.limit_enabled
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], the limits will be enabled. Disabling this will allow the camera to focus anywhere, when the four [code]limit_*[/code] properties will not work."
msgstr "Ha [code]true[/code], a kamerakorlátok érvényesek. Letiltáskor a kamera bárhová fókuszálhat, és a négy [code]limit_*[/code] tulajdonság nem működik."

#. Camera2D.limit_left
#: doc/classes/Camera2D.xml
msgid "Left scroll limit in pixels. The camera stops moving when reaching this value, but [member offset] can push the view past the limit."
msgstr "A kamera bal oldali görgetési korlátja képpontban. A kamera e határ elérésekor megáll, de a [member offset] a nézetet a korláton túlra is tolhatja."

#. Camera2D.limit_right
#: doc/classes/Camera2D.xml
msgid "Right scroll limit in pixels. The camera stops moving when reaching this value, but [member offset] can push the view past the limit."
msgstr "A kamera jobb oldali görgetési korlátja képpontban. A kamera e határ elérésekor megáll, de a [member offset] a nézetet a korláton túlra is tolhatja."

#. Camera2D.limit_top
#: doc/classes/Camera2D.xml
msgid "Top scroll limit in pixels. The camera stops moving when reaching this value, but [member offset] can push the view past the limit."
msgstr "A kamera felső görgetési korlátja képpontban. A kamera e határ elérésekor megáll, de a [member offset] a nézetet a korláton túlra is tolhatja."

#. Camera2D.limit_bottom
#: doc/classes/Camera2D.xml
msgid "Bottom scroll limit in pixels. The camera stops moving when reaching this value, but [member offset] can push the view past the limit."
msgstr "A kamera alsó görgetési korlátja képpontban. A kamera e határ elérésekor megáll, de a [member offset] a nézetet a korláton túlra is tolhatja."

#. Camera2D.limit_smoothed
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], the camera smoothly stops when reaches its limits.\nThis property has no effect if [member position_smoothing_enabled] is [code]false[/code].\n[b]Note:[/b] To immediately update the camera's position to be within limits without smoothing, even with this setting enabled, invoke [method reset_smoothing]."
msgstr "Ha [code]true[/code], a kamera a korlátokhoz közeledve fokozatosan áll meg.\nA tulajdonságnak nincs hatása, ha a [member position_smoothing_enabled] értéke [code]false[/code].\n[b]Megjegyzés:[/b] A kamera helyzetének azonnali, simítás nélküli korlátok közé igazításához hívd meg a [method reset_smoothing] metódust, még akkor is, ha ez a beállítás engedélyezett."

#. Camera2D.position_smoothing_enabled
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], the camera's view smoothly moves towards its target position at [member position_smoothing_speed]."
msgstr "Ha [code]true[/code], a kamera nézete a [member position_smoothing_speed] sebesség szerint, finoman közelít a célpozícióhoz."

#. Camera2D.position_smoothing_speed
#: doc/classes/Camera2D.xml
msgid "Speed in pixels per second of the camera's smoothing effect when [member position_smoothing_enabled] is [code]true[/code]."
msgstr "A kamera pozíciósimításának sebessége képpont/másodpercben, amikor a [member position_smoothing_enabled] értéke [code]true[/code]."

#. Camera2D.rotation_smoothing_enabled
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], the camera's view smoothly rotates, via asymptotic smoothing, to align with its target rotation at [member rotation_smoothing_speed].\n[b]Note:[/b] This property has no effect if [member ignore_rotation] is [code]true[/code]."
msgstr "Ha [code]true[/code], a kamera nézete aszimptotikus simítással, a [member rotation_smoothing_speed] sebességnek megfelelően fordul a célforgatás felé.\n[b]Megjegyzés:[/b] A tulajdonságnak nincs hatása, ha a [member ignore_rotation] értéke [code]true[/code]."

#. Camera2D.rotation_smoothing_speed
#: doc/classes/Camera2D.xml
msgid "The angular, asymptotic speed of the camera's rotation smoothing effect when [member rotation_smoothing_enabled] is [code]true[/code]."
msgstr "A kamera forgatássimításának aszimptotikus szögsebessége, amikor a [member rotation_smoothing_enabled] értéke [code]true[/code]."

#. Camera2D.drag_horizontal_enabled
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], the camera only moves when reaching the horizontal (left and right) drag margins. If [code]false[/code], the camera moves horizontally regardless of margins."
msgstr "Ha [code]true[/code], a kamera csak a vízszintes (bal és jobb oldali) követési margók elérésekor mozdul el. Ha [code]false[/code], a kamera a margóktól függetlenül követi a vízszintes mozgást."

#. Camera2D.drag_vertical_enabled
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], the camera only moves when reaching the vertical (top and bottom) drag margins. If [code]false[/code], the camera moves vertically regardless of the drag margins."
msgstr "Ha [code]true[/code], a kamera csak a függőleges (felső és alsó) követési margók elérésekor mozdul el. Ha [code]false[/code], a kamera a margóktól függetlenül követi a függőleges mozgást."

#. Camera2D.drag_left_margin
#: doc/classes/Camera2D.xml
msgid "Left margin needed to drag the camera. A value of [code]1[/code] makes the camera move only when reaching the left edge of the screen."
msgstr "A kamera elmozdításához szükséges bal oldali margó. A [code]1[/code] érték azt jelenti, hogy a kamera csak a képernyő bal szélének elérésekor mozdul el."

#. Camera2D.drag_right_margin
#: doc/classes/Camera2D.xml
msgid "Right margin needed to drag the camera. A value of [code]1[/code] makes the camera move only when reaching the right edge of the screen."
msgstr "A kamera elmozdításához szükséges jobb oldali margó. A [code]1[/code] érték azt jelenti, hogy a kamera csak a képernyő jobb szélének elérésekor mozdul el."

#. Camera2D.drag_top_margin
#: doc/classes/Camera2D.xml
msgid "Top margin needed to drag the camera. A value of [code]1[/code] makes the camera move only when reaching the top edge of the screen."
msgstr "A kamera elmozdításához szükséges felső margó. A [code]1[/code] érték azt jelenti, hogy a kamera csak a képernyő felső szélének elérésekor mozdul el."

#. Camera2D.drag_bottom_margin
#: doc/classes/Camera2D.xml
msgid "Bottom margin needed to drag the camera. A value of [code]1[/code] makes the camera move only when reaching the bottom edge of the screen."
msgstr "A kamera elmozdításához szükséges alsó margó. A [code]1[/code] érték azt jelenti, hogy a kamera csak a képernyő alsó szélének elérésekor mozdul el."

#. Camera2D.editor_draw_limits
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], draws the camera's limits rectangle in the editor."
msgstr "Ha [code]true[/code], a szerkesztőben kirajzolja a kamera korlátait jelölő téglalapot."

#. Camera2D.editor_draw_screen
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], draws the camera's screen rectangle in the editor."
msgstr "Ha [code]true[/code], a szerkesztőben kirajzolja a kamera képernyőterületét jelölő téglalapot."

#. Camera2D.get_screen_center_position
#: doc/classes/Camera2D.xml
msgid "Returns the center of the screen from this camera's point of view, in global coordinates.\n[b]Note:[/b] The exact targeted position of the camera may be different. See [method get_target_position]."
msgstr "Visszaadja a képernyő középpontját e kamera nézőpontjából, globális koordinátákban.\n[b]Megjegyzés:[/b] A kamera pontos célpozíciója ettől eltérhet. Lásd: [method get_target_position]."

#. Camera2D.make_current
#: doc/classes/Camera2D.xml
msgid "Forces this [Camera2D] to become the current active one. [member enabled] must be [code]true[/code]."
msgstr "Ezt a [Camera2D] csomópontot teszi az aktuális aktív kamerává. Ehhez a [member enabled] értékének [code]true[/code] kell lennie."

#. Camera2D.reset_smoothing
#: doc/classes/Camera2D.xml
msgid "Sets the camera's position immediately to its current smoothing destination.\nThis method has no effect if [member position_smoothing_enabled] is [code]false[/code]."
msgstr "A kamera pozícióját azonnal az aktuális simítási célpontra állítja.\nA metódusnak nincs hatása, ha a [member position_smoothing_enabled] értéke [code]false[/code]."

#. Camera2D.offset
#: doc/classes/Camera2D.xml
msgid "The camera's relative offset. Useful for looking around or camera shake animations. The offsetted camera can go past the limits defined in [member limit_top], [member limit_bottom], [member limit_left] and [member limit_right]."
msgstr "A kamera relatív eltolása. Hasznos a körbenézéshez vagy a kamerarázás animálásához. Az eltolt kamera túlléphet a [member limit_top], [member limit_bottom], [member limit_left] és [member limit_right] tulajdonságokkal megadott korlátokon."

#. Camera2D.anchor_mode
#: doc/classes/Camera2D.xml
msgid "The Camera2D's anchor point."
msgstr "A Camera2D horgonypontja."

#. Camera2D.ignore_rotation
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], the camera's rendered view is not affected by its [member Node2D.rotation] and [member Node2D.global_rotation]."
msgstr "Ha [code]true[/code], a kamera által megjelenített nézetet nem befolyásolja a kamera [member Node2D.rotation] és [member Node2D.global_rotation] értéke."

#. CollisionShape2D.brief
#: doc/classes/CollisionShape2D.xml
msgid "A node that provides a [Shape2D] to a [CollisionObject2D] parent."
msgstr "Olyan csomópont, amely [Shape2D] alakzatot biztosít a szülő [CollisionObject2D] számára."

#. CollisionShape2D.description
#: doc/classes/CollisionShape2D.xml
msgid "A node that provides a [Shape2D] to a [CollisionObject2D] parent and allows it to be edited. This can give a detection shape to an [Area2D] or turn a [PhysicsBody2D] into a solid object."
msgstr "Olyan csomópont, amely szerkeszthető [Shape2D] alakzatot biztosít a szülő [CollisionObject2D] számára. Ezzel érzékelési területet adhatsz egy [Area2D] csomóponthoz, vagy ütközési alakzatot adhatsz egy [PhysicsBody2D] testhez, hogy szilárd testként működjön."

#. CollisionShape2D.shape
#: doc/classes/CollisionShape2D.xml
msgid "The actual shape owned by this collision shape."
msgstr "Az ütközési alakzathoz tartozó tényleges alakzat."

#. CollisionShape2D.disabled
#: doc/classes/CollisionShape2D.xml
msgid "A disabled collision shape has no effect in the world. This property should be changed with [method Object.set_deferred]."
msgstr "A letiltott ütközési alakzat nincs hatással a világra. Ezt a tulajdonságot a [method Object.set_deferred] metódussal célszerű módosítani."

#. CollisionShape2D.one_way_collision
#: doc/classes/CollisionShape2D.xml
msgid "Sets whether this collision shape should only detect collision on one side (top or bottom).\n[b]Note:[/b] This property has no effect if this [CollisionShape2D] is a child of an [Area2D] node.\n[b]Note:[/b] The one way collision direction can be configured by setting [member one_way_collision_direction]."
msgstr "Meghatározza, hogy az ütközési alakzat csak az egyik oldalán (fent vagy lent) érzékeljen-e ütközést.\n[b]Megjegyzés:[/b] Ennek a tulajdonságnak nincs hatása, ha a [CollisionShape2D] egy [Area2D] csomópont gyermeke.\n[b]Megjegyzés:[/b] Az egyirányú ütközés iránya a [member one_way_collision_direction] tulajdonsággal állítható be."

#. CollisionShape2D.one_way_collision_direction
#. CollisionPolygon2D.one_way_collision_direction
#: doc/classes/CollisionShape2D.xml
#: doc/classes/CollisionPolygon2D.xml
msgid "The direction used for one-way collision."
msgstr "Az egyirányú ütközéshez használt irány."

#. CollisionShape2D.one_way_collision_margin
#: doc/classes/CollisionShape2D.xml
msgid "The margin used for one-way collision (in pixels). Higher values will make the shape thicker, and work better for colliders that enter the shape at a high velocity."
msgstr "Az egyirányú ütközéshez használt margó képpontban. A nagyobb érték megnöveli az egyirányú ütközéshez használt hatásos vastagságot, és jobb eredményt adhat, amikor az ütköző testek nagy sebességgel lépnek be az alakzatba."

#. CollisionShape2D.debug_color
#: doc/classes/CollisionShape2D.xml
msgid "The collision shape color that is displayed in the editor, or in the running project if [b]Debug &gt; Visible Collision Shapes[/b] is checked at the top of the editor.\n[b]Note:[/b] The default value is [member ProjectSettings.debug/shapes/collision/shape_color]. The [code]Color(0, 0, 0, 0)[/code] value documented here is a placeholder, and not the actual default debug color."
msgstr "Az ütközési alakzat szerkesztőben megjelenő színe, illetve futó projektben is ez látható, ha a szerkesztő tetején be van jelölve a [b]Hibakeresés &gt; Látható ütközési alakzatok[/b] lehetőség.\n[b]Megjegyzés:[/b] Az alapértelmezett érték a [member ProjectSettings.debug/shapes/collision/shape_color]. Az itt dokumentált [code]Color(0, 0, 0, 0)[/code] csak helyőrző, nem a tényleges alapértelmezett hibakeresési szín."

#. Sprite2D.brief
#: doc/classes/Sprite2D.xml
msgid "General-purpose sprite node."
msgstr "Általános célú sprite-csomópont."

#. Sprite2D.description
#: doc/classes/Sprite2D.xml
msgid "A node that displays a 2D texture. The texture displayed can be a region from a larger atlas texture, or a frame from a sprite sheet animation."
msgstr "2D textúrát megjelenítő csomópont. A megjelenített textúra lehet egy nagyobb atlasztextúra kijelölt területe vagy egy sprite-lap animációjának valamelyik képkockája."

#. Sprite2D.centered
#: doc/classes/Sprite2D.xml
msgid "If [code]true[/code], texture is centered.\n[b]Note:[/b] For games with a pixel art aesthetic, textures may appear deformed when centered. This is caused by their position being between pixels. To prevent this, set this property to [code]false[/code], or consider enabling [member ProjectSettings.rendering/2d/snap/snap_2d_vertices_to_pixel] and [member ProjectSettings.rendering/2d/snap/snap_2d_transforms_to_pixel]."
msgstr "Ha [code]true[/code], a textúra középre kerül.\n[b]Megjegyzés:[/b] Pixelgrafikás játékokban a középre igazított textúrák torzultnak tűnhetnek, ha a pozíciójuk képpontok közé esik. Ennek elkerüléséhez állítsd ezt a tulajdonságot [code]false[/code] értékre, vagy kapcsold be a [member ProjectSettings.rendering/2d/snap/snap_2d_vertices_to_pixel] és a [member ProjectSettings.rendering/2d/snap/snap_2d_transforms_to_pixel] beállítást."

#. Sprite2D.frame
#: doc/classes/Sprite2D.xml
msgid "Current frame to display from sprite sheet. [member hframes] or [member vframes] must be greater than 1. This property is automatically adjusted when [member hframes] or [member vframes] are changed to keep pointing to the same visual frame (same column and row). If that's impossible, this value is reset to [code]0[/code]."
msgstr "A sprite-lapról megjelenítendő aktuális képkocka. A [member hframes] vagy a [member vframes] értékének 1-nél nagyobbnak kell lennie. Ha a [member hframes] vagy [member vframes] megváltozik, a tulajdonság automatikusan igazodik, hogy ugyanarra a látható képkockára (ugyanarra a sorra és oszlopra) mutasson. Ha ez nem lehetséges, az érték [code]0[/code] lesz."

#. Sprite2D.frame_coords
#: doc/classes/Sprite2D.xml
msgid "Coordinates of the frame to display from sprite sheet. This is as an alias for the [member frame] property. [member hframes] or [member vframes] must be greater than 1."
msgstr "A sprite-lapról megjelenítendő képkocka koordinátái. Ez a [member frame] tulajdonság másik megadási módja. A [member hframes] vagy a [member vframes] értékének 1-nél nagyobbnak kell lennie."

#. Sprite2D.hframes
#: doc/classes/Sprite2D.xml
msgid "The number of columns in the sprite sheet. When this property is changed, [member frame] is adjusted so that the same visual frame is maintained (same row and column). If that's impossible, [member frame] is reset to [code]0[/code]."
msgstr "A sprite-lap oszlopainak száma. A tulajdonság módosításakor a [member frame] úgy igazodik, hogy ugyanaz a látható képkocka maradjon kiválasztva (ugyanaz a sor és oszlop). Ha ez nem lehetséges, a [member frame] értéke [code]0[/code] lesz."

#. Sprite2D.vframes
#: doc/classes/Sprite2D.xml
msgid "The number of rows in the sprite sheet. When this property is changed, [member frame] is adjusted so that the same visual frame is maintained (same row and column). If that's impossible, [member frame] is reset to [code]0[/code]."
msgstr "A sprite-lap sorainak száma. A tulajdonság módosításakor a [member frame] úgy igazodik, hogy ugyanaz a látható képkocka maradjon kiválasztva (ugyanaz a sor és oszlop). Ha ez nem lehetséges, a [member frame] értéke [code]0[/code] lesz."

#. Sprite2D.offset
#: doc/classes/Sprite2D.xml
msgid "The texture's drawing offset.\n[b]Note:[/b] When you increase [member offset].y in Sprite2D, the sprite moves downward on screen (i.e., +Y is down)."
msgstr "A textúra kirajzolási eltolása.\n[b]Megjegyzés:[/b] Ha a Sprite2D [member offset].y értékét növeled, a sprite lefelé mozdul a képernyőn (vagyis a pozitív Y irány lefelé mutat)."

#. Sprite2D.region_enabled
#: doc/classes/Sprite2D.xml
msgid "If [code]true[/code], texture is cut from a larger atlas texture. See [member region_rect].\n[b]Note:[/b] When using a custom [Shader] on a [Sprite2D], the [code]UV[/code] shader built-in will refer to the entire texture space. Use the [code]REGION_RECT[/code] built-in to get the currently visible region defined in [member region_rect] instead. See [url=$DOCS_URL/tutorials/shaders/shader_reference/canvas_item_shader.html]CanvasItem shaders[/url] for details."
msgstr "Ha [code]true[/code], a textúrát egy nagyobb atlasztextúrából vágja ki. Lásd: [member region_rect].\n[b]Megjegyzés:[/b] Ha egyéni [Shader] van a [Sprite2D] csomóponton, a shader beépített [code]UV[/code] változója a teljes textúrára vonatkozik. A [member region_rect] által meghatározott látható rész eléréséhez inkább a [code]REGION_RECT[/code] beépített változót használd. Részletek: [url=$DOCS_URL/tutorials/shaders/shader_reference/canvas_item_shader.html]CanvasItem shaderek[/url]."

#. Sprite2D.region_filter_clip_enabled
#: doc/classes/Sprite2D.xml
msgid "If [code]true[/code], the area outside of the [member region_rect] is clipped to avoid bleeding of the surrounding texture pixels. [member region_enabled] must be [code]true[/code]."
msgstr "Ha [code]true[/code], a [member region_rect] területén kívüli részeket levágja, így a szomszédos textúraképpontok nem szivárognak át a kijelölt területre. A [member region_enabled] értékének [code]true[/code] kell lennie."

#. Sprite2D.region_rect
#: doc/classes/Sprite2D.xml
msgid "The region of the atlas texture to display. [member region_enabled] must be [code]true[/code]."
msgstr "Az atlasztextúra megjelenítendő területe. A [member region_enabled] értékének [code]true[/code] kell lennie."

#. Sprite2D.texture
#: doc/classes/Sprite2D.xml
msgid "[Texture2D] object to draw."
msgstr "A kirajzolandó [Texture2D] objektum."

#. Sprite2D.is_pixel_opaque
#: doc/classes/Sprite2D.xml
msgid "Returns [code]true[/code] if the pixel at the given position is opaque, [code]false[/code] otherwise. Also returns [code]false[/code] if the given position is out of bounds or this sprite's [member texture] is [code]null[/code]. [param pos] is in local coordinates."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott pozíció képpontja átlátszatlan, egyébként [code]false[/code] értéket. Akkor is [code]false[/code] értéket ad vissza, ha a pozíció kívül esik a határokon, vagy a sprite [member texture] értéke [code]null[/code]. A [param pos] helyi koordinátákban értendő."

#. Node2D.brief
#: doc/classes/Node2D.xml
msgid "A 2D game object, inherited by all 2D-related nodes. Has a position, rotation, scale, and skew."
msgstr "2D játékobjektum, amelyből minden 2D-s csomópont származik. Van pozíciója, elforgatása, méretezése és nyírása."

#. Node2D.description
#: doc/classes/Node2D.xml
msgid "A 2D game object, with a transform (position, rotation, and scale). All 2D nodes, including physics objects and sprites, inherit from Node2D. Use Node2D as a parent node to move, scale and rotate children in a 2D project. Also gives control of the node's render order.\n[b]Note:[/b] Since both [Node2D] and [Control] inherit from [CanvasItem], they share several concepts from the class such as the [member CanvasItem.z_index] and [member CanvasItem.visible] properties."
msgstr "2D játékobjektum transzformációval (pozíció, elforgatás és méretezés). Minden 2D-s csomópont, beleértve a fizikai objektumokat és a sprite-okat, a Node2D osztályból származik. Használd a Node2D-t szülőcsomópontként, ha egy 2D projektben együtt szeretnéd mozgatni, méretezni vagy forgatni a gyermekcsomópontokat. A csomópont kirajzolási sorrendje is szabályozható vele.\n[b]Megjegyzés:[/b] Mivel a [Node2D] és a [Control] egyaránt a [CanvasItem] leszármazottja, több közös tulajdonságuk van, például a [member CanvasItem.z_index] és a [member CanvasItem.visible]."

#. Node2D.position
#: doc/classes/Node2D.xml
msgid "Position, relative to the node's parent. See also [member global_position]."
msgstr "A csomópont pozíciója a szülőjéhez viszonyítva. Lásd még: [member global_position]."

#. Node2D.global_position
#: doc/classes/Node2D.xml
msgid "Global position. See also [member position]."
msgstr "Globális pozíció. Lásd még: [member position]."

#. Node2D.rotation
#: doc/classes/Node2D.xml
msgid "Rotation in radians, relative to the node's parent. See also [member global_rotation].\n[b]Note:[/b] This property is edited in the inspector in degrees. If you want to use degrees in a script, use [member rotation_degrees]."
msgstr "A csomópont elforgatása radiánban, a szülőjéhez viszonyítva. Lásd még: [member global_rotation].\n[b]Megjegyzés:[/b] A tulajdonság a Felügyelőben fokban szerkeszthető. Ha scriptből fokokban szeretnéd megadni, használd a [member rotation_degrees] tulajdonságot."

#. Node2D.rotation_degrees
#: doc/classes/Node2D.xml
msgid "Helper property to access [member rotation] in degrees instead of radians. See also [member global_rotation_degrees]."
msgstr "Segédtulajdonság, amellyel a [member rotation] értéke radián helyett fokban érhető el. Lásd még: [member global_rotation_degrees]."

#. Node2D.global_rotation
#: doc/classes/Node2D.xml
msgid "Global rotation in radians. See also [member rotation]."
msgstr "Globális elforgatás radiánban. Lásd még: [member rotation]."

#. Node2D.global_rotation_degrees
#: doc/classes/Node2D.xml
msgid "Helper property to access [member global_rotation] in degrees instead of radians. See also [member rotation_degrees]."
msgstr "Segédtulajdonság, amellyel a [member global_rotation] értéke radián helyett fokban érhető el. Lásd még: [member rotation_degrees]."

#. Node2D.scale
#: doc/classes/Node2D.xml
msgid "The node's scale, relative to the node's parent. Unscaled value: [code](1, 1)[/code]. See also [member global_scale].\n[b]Note:[/b] Negative X scales in 2D are not decomposable from the transformation matrix. Due to the way scale is represented with transformation matrices in Godot, negative scales on the X axis will be changed to negative scales on the Y axis and a rotation of 180 degrees when decomposed."
msgstr "A csomópont méretezése a szülőjéhez viszonyítva. A méretezetlen érték: [code](1, 1)[/code]. Lásd még: [member global_scale].\n[b]Megjegyzés:[/b] 2D-ben a negatív X irányú méretezés nem bontható fel közvetlenül a transzformációs mátrixból. A Godot mátrixos ábrázolása miatt a negatív X skála felbontáskor negatív Y skálává és 180 fokos elforgatássá alakul."

#. Node2D.global_scale
#: doc/classes/Node2D.xml
msgid "Global scale. See also [member scale]."
msgstr "Globális méretezés. Lásd még: [member scale]."

#. Node2D.skew
#: doc/classes/Node2D.xml
msgid "If set to a non-zero value, slants the node in one direction or another. This can be used for pseudo-3D effects. See also [member global_skew].\n[b]Note:[/b] Skew is performed on the X axis only, and [i]between[/i] rotation and scaling.\n[b]Note:[/b] This property is edited in the inspector in degrees. If you want to use degrees in a script, use [code]skew = deg_to_rad(value_in_degrees)[/code]."
msgstr "Ha nem nulla az értéke, a csomópontot az egyik vagy a másik irányba ferdíti. Ez ál-3D hatásokhoz is használható. Lásd még: [member global_skew].\n[b]Megjegyzés:[/b] A nyírás csak az X tengely mentén történik, és a műveleti sorrendben az elforgatás [i]és[/i] a méretezés közé esik.\n[b]Megjegyzés:[/b] A tulajdonság a Felügyelőben fokban szerkeszthető. Ha scriptben fokokat szeretnél használni, írd ezt: [code]skew = deg_to_rad(value_in_degrees)[/code]."

#. Node2D.global_skew
#: doc/classes/Node2D.xml
msgid "Global skew in radians. See also [member skew]."
msgstr "Globális nyírás radiánban. Lásd még: [member skew]."

#. Node2D.transform
#: doc/classes/Node2D.xml
msgid "The node's [Transform2D], relative to the node's parent. See also [member global_transform]."
msgstr "A csomópont [Transform2D] transzformációja a szülőjéhez viszonyítva. Lásd még: [member global_transform]."

#. Node2D.global_transform
#: doc/classes/Node2D.xml
msgid "Global [Transform2D]. See also [member transform]."
msgstr "Globális [Transform2D] transzformáció. Lásd még: [member transform]."

#. Node2D.apply_scale
#: doc/classes/Node2D.xml
msgid "Multiplies the current scale by the [param ratio] vector."
msgstr "Megszorozza az aktuális méretezést a [param ratio] vektorral."

#. Node2D.get_angle_to
#: doc/classes/Node2D.xml
msgid "Returns the angle between the node and the [param point] in radians. See also [method look_at].\n[url=https://raw.githubusercontent.com/godotengine/godot-docs/master/img/node2d_get_angle_to.png]Illustration of the returned angle.[/url]"
msgstr "Visszaadja a csomópont és a [param point] közötti szöget radiánban. Lásd még: [method look_at].\n[url=https://raw.githubusercontent.com/godotengine/godot-docs/master/img/node2d_get_angle_to.png]A visszaadott szög szemléltetése.[/url]"

#. Node2D.get_relative_transform_to_parent
#: doc/classes/Node2D.xml
msgid "Returns the [Transform2D] relative to this node's parent."
msgstr "Visszaadja a csomópont szülőjéhez viszonyított [Transform2D] transzformációját."

#. Node2D.global_translate
#: doc/classes/Node2D.xml
msgid "Adds the [param offset] vector to the node's global position."
msgstr "Hozzáadja a [param offset] vektort a csomópont globális pozíciójához."

#. Node2D.look_at
#: doc/classes/Node2D.xml
msgid "Rotates the node so that its local +X axis points towards the [param point], which is expected to use global coordinates. This method is a combination of both [method rotate] and [method get_angle_to].\n[param point] should not be the same as the node's position, otherwise the node always looks to the right."
msgstr "Elforgatja a csomópontot úgy, hogy a helyi +X tengelye a globális koordinátákkal megadott [param point] felé mutasson. A metódus a [method rotate] és a [method get_angle_to] működését egyesíti.\nA [param point] nem egyezhet meg a csomópont pozíciójával, különben a csomópont mindig jobbra néz."

#. Node2D.move_local_x
#: doc/classes/Node2D.xml
msgid "Applies a local translation on the node's X axis with the amount specified in [param delta]. If [param scaled] is [code]false[/code], normalizes the movement to occur independently of the node's [member scale]."
msgstr "A csomópontot helyi X tengelye mentén eltolja a [param delta] értékkel. Ha [param scaled] értéke [code]false[/code], a mozgást normalizálja, hogy ne függjön a csomópont [member scale] értékétől."

#. Node2D.move_local_y
#: doc/classes/Node2D.xml
msgid "Applies a local translation on the node's Y axis with the amount specified in [param delta]. If [param scaled] is [code]false[/code], normalizes the movement to occur independently of the node's [member scale]."
msgstr "A csomópontot helyi Y tengelye mentén eltolja a [param delta] értékkel. Ha [param scaled] értéke [code]false[/code], a mozgást normalizálja, hogy ne függjön a csomópont [member scale] értékétől."

#. Node2D.rotate
#: doc/classes/Node2D.xml
msgid "Applies a rotation to the node, in radians, starting from its current rotation. This is equivalent to [code]rotation += radians[/code]."
msgstr "Az aktuális elforgatáshoz hozzáadott, radiánban megadott szöggel forgatja el a csomópontot. Ez megfelel a [code]rotation += radians[/code] utasításnak."

#. Node2D.to_global
#: doc/classes/Node2D.xml
msgid "Transforms the provided local position into a position in global coordinate space. The input is expected to be local relative to the [Node2D] it is called on. e.g. Applying this method to the positions of child nodes will correctly transform their positions into the global coordinate space, but applying it to a node's own position will give an incorrect result, as it will incorporate the node's own transformation into its global position."
msgstr "A megadott helyi pozíciót globális koordinátákká alakítja. A bemenetet annak a [Node2D] csomópontnak a helyi koordinátarendszerében kell megadni, amelyen meghívod. Például a gyermekcsomópontok pozícióit helyesen alakítja át globális koordinátákká, de a csomópont saját pozíciójának átalakítása hibás eredményt ad, mert annak saját transzformációját is hozzáadja a globális pozíciójához."

#. Node2D.to_local
#: doc/classes/Node2D.xml
msgid "Transforms the provided global position into a position in local coordinate space. The output will be local relative to the [Node2D] it is called on. e.g. It is appropriate for determining the positions of child nodes, but it is not appropriate for determining its own position relative to its parent."
msgstr "A megadott globális pozíciót helyi koordinátákká alakítja. Az eredmény annak a [Node2D] csomópontnak a helyi koordinátarendszerében értendő, amelyen meghívod. Használható a gyermekcsomópontok helyzetének meghatározására, de nem alkalmas a csomópont saját, szülőhöz viszonyított pozíciójának meghatározására."

#. Node2D.translate
#: doc/classes/Node2D.xml
msgid "Translates the node by the given [param offset] in local coordinates. This is equivalent to [code]position += offset[/code]."
msgstr "A csomópontot a megadott [param offset] vektorral eltolja helyi koordináták szerint. Ez megfelel a [code]position += offset[/code] utasításnak."

#. AnimationPlayer.brief
#: doc/classes/AnimationPlayer.xml
msgid "A node used for animation playback."
msgstr "Animációk lejátszására szolgáló csomópont."

#. AnimationPlayer.description
#: doc/classes/AnimationPlayer.xml
msgid "An animation player is used for general-purpose playback of animations. It contains a dictionary of [AnimationLibrary] resources and custom blend times between animation transitions.\nSome methods and properties use a single key to reference an animation directly. These keys are formatted as the key for the library, followed by a forward slash, then the key for the animation within the library, for example [code]\"movement/run\"[/code]. If the library's key is an empty string (known as the default library), the forward slash is omitted, being the same key used by the library.\n[AnimationPlayer] is better-suited than [Tween] for more complex animations, for example ones with non-trivial timings. It can also be used over [Tween] if the animation track editor is more convenient than doing it in code.\nUpdating the target properties of animations occurs at the process frame."
msgstr "Az animációlejátszó általános célú animációk lejátszására használható. [AnimationLibrary] erőforrások szótárát tartalmazza, és egyedi áttűnési időket kezelhet az animációk közötti váltásokhoz.\nEgyes metódusok és tulajdonságok egyetlen kulccsal hivatkoznak egy animációra. A kulcs a könyvtár kulcsából, egy perjelből és a könyvtáron belüli animáció kulcsából áll, például [code]\"movement/run\"[/code]. Ha a könyvtár kulcsa üres karakterlánc (ez az alapértelmezett könyvtár), a perjel elmarad, és az animáció kulcsa közvetlenül használható.\nAz [AnimationPlayer] összetettebb, például különleges időzítésű animációkhoz alkalmasabb, mint a [Tween]. Akkor is használható a [Tween] helyett, ha kényelmesebb az animációs sávokat szerkesztőben megadni, mint kódban.\nAz animációk céltulajdonságainak frissítése a feldolgozási képkockában történik."

#. AnimationPlayer.assigned_animation
#: doc/classes/AnimationPlayer.xml
msgid "If playing, the current animation's key, otherwise, the animation last played. When set, this changes the animation, but will not play it unless already playing. See also [member current_animation]."
msgstr "Lejátszás közben az aktuális animáció kulcsa, egyébként a legutóbb lejátszott animációé. Beállítása megváltoztatja a kiválasztott animációt, de csak akkor indítja el, ha már folyik lejátszás. Lásd még: [member current_animation]."

#. AnimationPlayer.current_animation
#: doc/classes/AnimationPlayer.xml
msgid "The key of the currently playing animation. If no animation is playing, the property's value is an empty string. Changing this value does not restart the animation. See [method play] for more information on playing animations.\n[b]Note:[/b] While this property appears in the Inspector, it's not meant to be edited, and it's not saved in the scene. This property is mainly used to get the currently playing animation, and internally for animation playback tracks. For more information, see [Animation]."
msgstr "Az éppen lejátszott animáció kulcsa. Ha nincs lejátszás, a tulajdonság értéke üres karakterlánc. Az érték módosítása nem indítja újra az animációt. Az animációk indításáról lásd: [method play].\n[b]Megjegyzés:[/b] Bár ez a tulajdonság látható a Felügyelőben, nem szerkesztésre szolgál, és nem kerül mentésre a jelenetben. Elsősorban az éppen futó animáció lekérdezésére, valamint belső használatra, az animációlejátszási sávokhoz szolgál. További információ: [Animation]."

#. AnimationPlayer.current_animation_length
#: doc/classes/AnimationPlayer.xml
msgid "The length (in seconds) of the currently playing animation."
msgstr "Az éppen lejátszott animáció hossza másodpercben."

#. AnimationPlayer.current_animation_position
#: doc/classes/AnimationPlayer.xml
msgid "The position (in seconds) of the currently playing animation."
msgstr "Az éppen lejátszott animáció aktuális pozíciója másodpercben."

#. AnimationPlayer.movie_quit_on_finish
#: doc/classes/AnimationPlayer.xml
msgid "If [code]true[/code] and the engine is running in Movie Maker mode (see [MovieWriter]), exits the engine with [method SceneTree.quit] as soon as an animation is done playing in this [AnimationPlayer]. A message is printed when the engine quits for this reason.\n[b]Note:[/b] This obeys the same logic as the [signal AnimationMixer.animation_finished] signal, so it will not quit the engine if the animation is set to be looping."
msgstr "Ha [code]true[/code], és a motor Filmkészítő módban fut (lásd [MovieWriter]), az [AnimationPlayer] animációjának befejeződésekor a [method SceneTree.quit] metódussal kilép. A kilépés okáról üzenetet ír ki.\n[b]Megjegyzés:[/b] Ez a [signal AnimationMixer.animation_finished] jelzéssel azonos logikát követ, ezért ismétlődőre állított animációnál nem lép ki."

#. AnimationPlayer.playback_auto_capture
#: doc/classes/AnimationPlayer.xml
msgid "If [code]true[/code], performs [method AnimationMixer.capture] before playback automatically. This means just [method play_with_capture] is executed with default arguments instead of [method play].\n[b]Note:[/b] Capture interpolation is only performed if the animation contains a capture track. See also [constant Animation.UPDATE_CAPTURE]."
msgstr "Ha [code]true[/code], a lejátszás előtt automatikusan meghívja a [method AnimationMixer.capture] metódust. Így a [method play] helyett lényegében a [method play_with_capture] fut alapértelmezett paraméterekkel.\n[b]Megjegyzés:[/b] A rögzítési interpoláció csak akkor történik meg, ha az animáció tartalmaz rögzítési sávot. Lásd még: [constant Animation.UPDATE_CAPTURE]."

#. AnimationPlayer.playback_default_blend_time
#: doc/classes/AnimationPlayer.xml
msgid "The default time in which to blend animations. Ranges from 0 to 4096 with 0.01 precision."
msgstr "Az animációk közötti átmenet alapértelmezett időtartama. Értéke 0 és 4096 között állítható, 0,01-es pontossággal."

#. AnimationPlayer.animation_get_next
#: doc/classes/AnimationPlayer.xml
msgid "Returns the key of the animation which is queued to play after the [param animation_from] animation."
msgstr "Visszaadja annak az animációnak a kulcsát, amely a [param animation_from] animáció után következőként van beállítva."

#. AnimationPlayer.animation_set_next
#: doc/classes/AnimationPlayer.xml
msgid "Triggers the [param animation_to] animation when the [param animation_from] animation completes."
msgstr "A [param animation_from] animáció befejezésekor elindítja a [param animation_to] animációt."

#. AnimationPlayer.clear_queue
#: doc/classes/AnimationPlayer.xml
msgid "Clears all queued, unplayed animations."
msgstr "Kiüríti a lejátszási sort, eltávolítva az összes még el nem indított animációt."

#. AnimationPlayer.get_blend_time
#: doc/classes/AnimationPlayer.xml
msgid "Returns the blend time (in seconds) between two animations, referenced by their keys."
msgstr "Visszaadja a kulcsukkal megadott két animáció közötti átmenet időtartamát másodpercben."

#. AnimationPlayer.pause
#: doc/classes/AnimationPlayer.xml
msgid "Pauses the currently playing animation. The [member current_animation_position] will be kept and calling [method play] or [method play_backwards] without arguments or with the same animation name as [member assigned_animation] will resume the animation.\nSee also [method stop]."
msgstr "Szünetelteti az éppen futó animációt. A [member current_animation_position] megmarad; a [method play] vagy a [method play_backwards] paraméter nélküli meghívása, illetve a [member assigned_animation] értékével megegyező animációnév megadása folytatja a lejátszást.\nLásd még: [method stop]."

#. AnimationPlayer.play
#: doc/classes/AnimationPlayer.xml
msgid "Plays the animation with key [param name]. Custom blend times and speed can be set.\nThe [param from_end] option only affects when switching to a new animation track, or if the same track but at the start or end. It does not affect resuming playback that was paused in the middle of an animation. If [param custom_speed] is negative and [param from_end] is [code]true[/code], the animation will play backwards (which is equivalent to calling [method play_backwards]).\nThe [AnimationPlayer] keeps track of its current or last played animation with [member assigned_animation]. If this method is called with that same animation [param name], or with no [param name] parameter, the assigned animation will resume playing if it was paused.\n[b]Note:[/b] The animation will be updated the next time the [AnimationPlayer] is processed. If other variables are updated at the same time this is called, they may be updated too early. To perform the update immediately, call [code]advance(0)[/code]."
msgstr "Lejátssza a [param name] kulcsú animációt. Egyéni áttűnési idő és sebesség adható meg.\nA [param from_end] beállítás csak új animációs sávra váltáskor hat, vagy ugyanazon sáv elején, illetve végén. A közepén szüneteltetett animáció folytatását nem befolyásolja. Ha [param custom_speed] negatív, és [param from_end] értéke [code]true[/code], az animáció visszafelé játszódik, ami megfelel a [method play_backwards] meghívásának.\nAz [AnimationPlayer] a [member assigned_animation] segítségével tartja nyilván az aktuális vagy legutóbb lejátszott animációt. Ha ezzel azonos [param name] értékkel, vagy [param name] nélkül hívod meg, a szüneteltetett animáció folytatódik.\n[b]Megjegyzés:[/b] Az animáció az [AnimationPlayer] következő feldolgozásakor frissül. Ha ugyanakkor más változók is frissülnek, azok túl korán kaphatnak új értéket. Az azonnali frissítéshez hívd meg az [code]advance(0)[/code] utasítást."

#. AnimationPlayer.play_section
#: doc/classes/AnimationPlayer.xml
msgid "Plays the animation with key [param name] and the section starting from [param start_time] and ending on [param end_time]. See also [method play].\nSetting [param start_time] to a value outside the range of the animation means the start of the animation will be used instead, and setting [param end_time] to a value outside the range of the animation means the end of the animation will be used instead. [param start_time] cannot be equal to [param end_time]."
msgstr "A [param name] kulcsú animációnak csak a [param start_time] és [param end_time] közötti szakaszát játssza le. Lásd még: [method play].\nHa a [param start_time] kívül esik az animáció időtartamán, az animáció elejét veszi kezdőpontnak; ha a [param end_time] esik kívül, a végét veszi végpontnak. A [param start_time] nem lehet azonos a [param end_time] értékével."

#. AnimationPlayer.queue
#: doc/classes/AnimationPlayer.xml
msgid "Queues an animation for playback once the current animation and all previously queued animations are done.\n[b]Note:[/b] If a looped animation is currently playing, the queued animation will never play unless the looped animation is stopped somehow."
msgstr "Az animációt a lejátszási sorba állítja; akkor indul el, amikor az aktuális és minden korábban sorba tett animáció befejeződött.\n[b]Megjegyzés:[/b] Ha jelenleg végtelenítve ismétlődő animáció fut, a sorba állított animáció nem indul el, amíg az ismétlődőt valamilyen módon meg nem állítod."

#. AnimationPlayer.seek
#: doc/classes/AnimationPlayer.xml
msgid "Seeks the animation to the [param seconds] point in time (in seconds). If [param update] is [code]true[/code], the animation updates too, otherwise it updates at process time. Events between the current frame and [param seconds] are skipped.\nIf [param update_only] is [code]true[/code], the method / audio / animation playback tracks will not be processed.\n[b]Note:[/b] Seeking to the end of the animation doesn't emit [signal AnimationMixer.animation_finished]. If you want to skip animation and emit the signal, use [method AnimationMixer.advance]."
msgstr "Az animáció lejátszási pozícióját a [param seconds] időpontra (másodpercben) állítja. Ha a [param update] értéke [code]true[/code], az animáció azonnal frissül, máskülönben csak a feldolgozáskor. Az aktuális képkocka és a [param seconds] közötti események kimaradnak.\nHa a [param update_only] értéke [code]true[/code], a metódus-, hang- és animációlejátszási sávok nem kerülnek feldolgozásra.\n[b]Megjegyzés:[/b] Az animáció végére ugrás nem váltja ki a [signal AnimationMixer.animation_finished] jelzést. Ha át szeretnéd ugrani az animációt, de szeretnéd kiváltani ezt a jelzést is, használd a [method AnimationMixer.advance] metódust."

#. AnimationPlayer.stop
#: doc/classes/AnimationPlayer.xml
msgid "Stops the currently playing animation. The animation position is reset to [code]0[/code] and the [code]custom_speed[/code] is reset to [code]1.0[/code]. See also [method pause].\nIf [param keep_state] is [code]true[/code], the animation state is not updated visually.\n[b]Note:[/b] The method / audio / animation playback tracks will not be processed by this method."
msgstr "Leállítja az aktuális animációt. A lejátszási pozíció [code]0[/code], a [code]custom_speed[/code] pedig [code]1.0[/code] értékre áll vissza. Lásd még: [method pause].\nHa a [param keep_state] értéke [code]true[/code], az animáció állapota vizuálisan nem frissül.\n[b]Megjegyzés:[/b] A metódus-, hang- és animációlejátszási sávokat ez a metódus nem dolgozza fel."

#. AnimationPlayer.set_blend_time
#: doc/classes/AnimationPlayer.xml
msgid "Specifies a blend time (in seconds) between two animations, referenced by their keys."
msgstr "Megadja a kulcsukkal hivatkozott két animáció közötti átmenet időtartamát másodpercben."

#. AnimationPlayer.get_queue
#: doc/classes/AnimationPlayer.xml
msgid "Returns a list of the animation keys that are currently queued to play."
msgstr "Visszaadja a lejátszásra váró animációk kulcsainak listáját."

#. AnimationPlayer.get_root
#: doc/classes/AnimationPlayer.xml
msgid "Returns the node which node path references will travel from."
msgstr "Visszaadja azt a csomópontot, amelyből a csomópontútvonal-hivatkozások kiindulnak."

#. AnimationPlayer.reset_section
#: doc/classes/AnimationPlayer.xml
msgid "Resets the current section. Does nothing if a section has not been set."
msgstr "Visszaállítja az aktuális lejátszási szakasz beállítását. Ha nincs megadva szakasz, nem történik semmi."

#. AnimationPlayer.set_section
#: doc/classes/AnimationPlayer.xml
msgid "Changes the start and end times of the section being played. The current playback position will be clamped within the new section. See also [method play_section]."
msgstr "Módosítja az éppen lejátszott szakasz kezdő- és végidejét. Az aktuális lejátszási pozíciót az új szakasz kezdő- és végpontja közé korlátozza. Lásd még: [method play_section]."

#. SpriteFrames.brief
#: doc/classes/SpriteFrames.xml
msgid "Sprite frame library for AnimatedSprite2D and AnimatedSprite3D."
msgstr "Sprite-képkockák gyűjteménye az AnimatedSprite2D és AnimatedSprite3D csomópontokhoz."

#. SpriteFrames.description
#: doc/classes/SpriteFrames.xml
msgid "Sprite frame library for an [AnimatedSprite2D] or [AnimatedSprite3D] node. Contains frames and animation data for playback."
msgstr "Sprite-képkockák könyvtára egy [AnimatedSprite2D] vagy [AnimatedSprite3D] csomóponthoz. A lejátszáshoz szükséges képkockákat és animációs adatokat tárolja."

#. SpriteFrames.add_animation
#: doc/classes/SpriteFrames.xml
msgid "Adds a new [param anim] animation to the library."
msgstr "Új [param anim] nevű animációt ad a könyvtárhoz."

#. SpriteFrames.add_frame
#: doc/classes/SpriteFrames.xml
msgid "Adds a frame to the [param anim] animation. If [param at_position] is [code]-1[/code], the frame will be added to the end of the animation. [param duration] specifies the relative duration, see [method get_frame_duration] for details."
msgstr "Képkockát ad a [param anim] animációhoz. Ha [param at_position] értéke [code]-1[/code], a képkockát az animáció végére helyezi. A [param duration] a relatív időtartamot határozza meg; részletekért lásd: [method get_frame_duration]."

#. SpriteFrames.clear
#: doc/classes/SpriteFrames.xml
msgid "Removes all frames from the [param anim] animation."
msgstr "Eltávolítja a [param anim] animáció összes képkockáját."

#. SpriteFrames.clear_all
#: doc/classes/SpriteFrames.xml
msgid "Removes all animations. An empty [code]default[/code] animation will be created."
msgstr "Eltávolítja az összes animációt. Létrehoz egy üres [code]default[/code] animációt."

#. SpriteFrames.duplicate_animation
#: doc/classes/SpriteFrames.xml
msgid "Duplicates the animation [param anim_from] to a new animation named [param anim_to]. Fails if [param anim_to] already exists, or if [param anim_from] does not exist."
msgstr "Lemásolja a [param anim_from] animációt, és [param anim_to] néven hozza létre az új példányt. Sikertelen a művelet, ha [param anim_to] már létezik, vagy [param anim_from] nem létezik."

#. SpriteFrames.get_animation_loop
#: doc/classes/SpriteFrames.xml
msgid "Returns [code]true[/code] if [code]get_animation_loop_mode(anim) == LOOP_LINEAR[/code]. Otherwise, returns [code]false[/code]."
msgstr "[code]true[/code] értéket ad vissza, ha [code]get_animation_loop_mode(anim) == LOOP_LINEAR[/code]. Egyébként [code]false[/code] értéket ad vissza."

#. SpriteFrames.get_animation_names
#: doc/classes/SpriteFrames.xml
msgid "Returns an array containing the names associated to each animation. Values are placed in alphabetical order."
msgstr "Az animációkhoz tartozó neveket tartalmazó tömböt ad vissza. A neveket ábécérendben rendezi."

#. SpriteFrames.get_animation_speed
#: doc/classes/SpriteFrames.xml
msgid "Returns the speed in frames per second for the [param anim] animation."
msgstr "Visszaadja a [param anim] animáció sebességét másodpercenkénti képkockákban (FPS)."

#. SpriteFrames.get_frame_count
#: doc/classes/SpriteFrames.xml
msgid "Returns the number of frames for the [param anim] animation."
msgstr "Visszaadja a [param anim] animáció képkockáinak számát."

#. SpriteFrames.get_frame_duration
#: doc/classes/SpriteFrames.xml
msgid "Returns a relative duration of the frame [param idx] in the [param anim] animation (defaults to [code]1.0[/code]). For example, a frame with a duration of [code]2.0[/code] is displayed twice as long as a frame with a duration of [code]1.0[/code]. You can calculate the absolute duration (in seconds) of a frame using the following formula:\n[codeblock]\nabsolute_duration = relative_duration / (animation_fps * abs(playing_speed))\n[/codeblock]\nIn this example, [code]playing_speed[/code] refers to either [method AnimatedSprite2D.get_playing_speed] or [method AnimatedSprite3D.get_playing_speed]."
msgstr "Visszaadja a [param anim] animáció [param idx] indexű képkockájának relatív időtartamát (alapértelmezés szerint [code]1.0[/code]). Például a [code]2.0[/code] időtartamú képkocka kétszer olyan sokáig látható, mint a [code]1.0[/code] értékű. A tényleges időtartam (másodpercben) a következő képlettel számítható:\n[codeblock]\nabsolute_duration = relative_duration / (animation_fps * abs(playing_speed))\n[/codeblock]\nItt a [code]playing_speed[/code] a [method AnimatedSprite2D.get_playing_speed] vagy a [method AnimatedSprite3D.get_playing_speed] által visszaadott sebességet jelenti."

#. SpriteFrames.get_frame_texture
#: doc/classes/SpriteFrames.xml
msgid "Returns the texture of the frame [param idx] in the [param anim] animation."
msgstr "Visszaadja a [param anim] animáció [param idx] indexű képkockájának textúráját."

#. SpriteFrames.has_animation
#: doc/classes/SpriteFrames.xml
msgid "Returns [code]true[/code] if the [param anim] animation exists."
msgstr "[code]true[/code] értéket ad vissza, ha a [param anim] animáció létezik."

#. SpriteFrames.remove_animation
#: doc/classes/SpriteFrames.xml
msgid "Removes the [param anim] animation."
msgstr "Eltávolítja a [param anim] animációt."

#. SpriteFrames.remove_frame
#: doc/classes/SpriteFrames.xml
msgid "Removes the [param anim] animation's frame [param idx]."
msgstr "Eltávolítja a [param anim] animáció [param idx] indexű képkockáját."

#. SpriteFrames.rename_animation
#: doc/classes/SpriteFrames.xml
msgid "Changes the [param anim] animation's name to [param newname]."
msgstr "A [param anim] animáció nevét [param newname] értékre változtatja."

#. SpriteFrames.set_animation_loop
#: doc/classes/SpriteFrames.xml
msgid "If [param loop] is [code]false[/code] equivalent to [code]set_animation_loop_mode(LOOP_NONE)[/code].\nIf [param loop] is [code]true[/code] equivalent to [code]set_animation_loop_mode(LOOP_LINEAR)[/code]."
msgstr "Ha [param loop] értéke [code]false[/code], ez megfelel a [code]set_animation_loop_mode(LOOP_NONE)[/code] beállításnak.\nHa [param loop] értéke [code]true[/code], ez megfelel a [code]set_animation_loop_mode(LOOP_LINEAR)[/code] beállításnak."

#. SpriteFrames.set_animation_speed
#: doc/classes/SpriteFrames.xml
msgid "Sets the speed for the [param anim] animation in frames per second."
msgstr "Beállítja a [param anim] animáció sebességét másodpercenkénti képkockákban (FPS)."

#. SpriteFrames.set_frame
#: doc/classes/SpriteFrames.xml
msgid "Sets the [param texture] and the [param duration] of the frame [param idx] in the [param anim] animation. [param duration] specifies the relative duration, see [method get_frame_duration] for details."
msgstr "Beállítja a [param anim] animáció [param idx] indexű képkockájának [param texture] textúráját és [param duration] időtartamát. A [param duration] relatív időtartam; további információ: [method get_frame_duration]."

#. Animation.brief
#: doc/classes/Animation.xml
msgid "Holds data that can be used to animate anything in the engine."
msgstr "A motor bármely objektumának animálásához használható adatokat tárol."

#. Animation.length
#: doc/classes/Animation.xml
msgid "The total length of the animation (in seconds).\n[b]Note:[/b] Length is not delimited by the last key, as this one may be before or after the end to ensure correct interpolation and looping."
msgstr "Az animáció teljes hossza másodpercben.\n[b]Megjegyzés:[/b] A hossz nem feltétlenül az utolsó kulcsképkockánál ér véget: az a helyes interpoláció és ismétlés érdekében az animáció vége elé vagy után is eshet."

#. Animation.loop_mode
#: doc/classes/Animation.xml
msgid "Determines the behavior of both ends of the animation timeline during animation playback. This indicates whether and how the animation should be restarted, and is also used to correctly interpolate animation cycles."
msgstr "Meghatározza az animáció idővonalának két végén érvényes működést lejátszás közben. Szabályozza, hogy az animáció újraindul-e, és ha igen, hogyan; az animációs ciklusok megfelelő interpolációját is segíti."

#. Animation.step
#: doc/classes/Animation.xml
msgid "The animation step value."
msgstr "Az animáció lépésköze."

#. Animation.clear
#: doc/classes/Animation.xml
msgid "Clear the animation (clear all tracks and reset all)."
msgstr "Törli az animációt (az összes sávot és beállítást visszaállítja)."

#. Animation.add_track
#: doc/classes/Animation.xml
msgid "Adds a track to the Animation."
msgstr "Új sávot ad az animációhoz."

#. Animation.find_track
#: doc/classes/Animation.xml
msgid "Returns the index of the specified track. If the track is not found, return -1."
msgstr "Visszaadja a megadott sáv indexét. Ha a sáv nem található, -1-et ad vissza."

#. Animation.get_track_count
#: doc/classes/Animation.xml
msgid "Returns the amount of tracks in the animation."
msgstr "Visszaadja az animáció sávjainak számát."

#. Animation.remove_track
#: doc/classes/Animation.xml
msgid "Removes a track by specifying the track index."
msgstr "Eltávolítja az indexével megadott sávot."

#. Animation.add_marker
#: doc/classes/Animation.xml
msgid "Adds a marker to this Animation."
msgstr "Jelölőt ad ehhez az animációhoz."

#. Animation.has_marker
#: doc/classes/Animation.xml
msgid "Returns [code]true[/code] if this Animation contains a marker with the given name."
msgstr "[code]true[/code] értéket ad vissza, ha az animáció tartalmazza a megadott nevű jelölőt."

#. Animation.get_marker_names
#: doc/classes/Animation.xml
msgid "Returns every marker in this Animation, sorted ascending by time."
msgstr "Visszaadja az animáció összes jelölőjének nevét, idő szerint növekvő sorrendben."

#. Animation.get_marker_time
#: doc/classes/Animation.xml
msgid "Returns the given marker's time."
msgstr "Visszaadja a megadott jelölő időpontját."

#. Animation.remove_marker
#: doc/classes/Animation.xml
msgid "Removes the marker with the given name from this Animation."
msgstr "Eltávolítja a megadott nevű jelölőt az animációból."

#. Animation.track_get_key_count
#: doc/classes/Animation.xml
msgid "Returns the number of keys in a given track."
msgstr "Visszaadja a megadott sáv kulcsképkockáinak számát."

#. Animation.track_get_path
#: doc/classes/Animation.xml
msgid "Gets the path of a track. For more information on the path format, see [method track_set_path]."
msgstr "Lekéri a sáv útvonalát. Az útvonal formátumáról lásd: [method track_set_path]."

#. Animation.track_set_enabled
#: doc/classes/Animation.xml
msgid "Enables/disables the given track. Tracks are enabled by default."
msgstr "Engedélyezi vagy letiltja a megadott sávot. A sávok alapértelmezés szerint engedélyezettek."

#. Animation.track_is_enabled
#: doc/classes/Animation.xml
msgid "Returns [code]true[/code] if the track at index [param track_idx] is enabled."
msgstr "[code]true[/code] értéket ad vissza, ha a [param track_idx] indexű sáv engedélyezett."

#. Animation.track_insert_key
#: doc/classes/Animation.xml
msgid "Inserts a generic key in a given track. Returns the key index."
msgstr "Általános kulcsképkockát illeszt be a megadott sávba. Visszaadja a kulcsképkocka indexét."

#. Animation.track_remove_key
#: doc/classes/Animation.xml
msgid "Removes a key by index in a given track."
msgstr "Eltávolítja a megadott sávból az indexével kijelölt kulcsképkockát."

#. Animation.track_set_path
#: doc/classes/Animation.xml
msgid "Sets the path of a track. Paths must be valid scene-tree paths to a node and must be specified starting from the [member AnimationMixer.root_node] that will reproduce the animation. Tracks that control properties or bones must append their name after the path, separated by [code]\":\"[/code].\nFor example, [code]\"character/skeleton:ankle\"[/code] or [code]\"character/mesh:transform/local\"[/code]."
msgstr "Beállítja a sáv útvonalát. Az útvonalnak érvényes jelenetfa-útvonalnak kell lennie, amely a lejátszást végző [member AnimationMixer.root_node] csomóponttól indul. A tulajdonságokat vagy csontokat vezérlő sávoknál az útvonal végére [code]\":\"[/code] elválasztóval hozzá kell fűzni a tulajdonság vagy csont nevét.\nPéldául: [code]\"character/skeleton:ankle\"[/code] vagy [code]\"character/mesh:transform/local\"[/code]."

#. Area2D.brief
#: doc/classes/Area2D.xml
msgid "A region of 2D space that detects other [CollisionObject2D]s entering or exiting it."
msgstr "Olyan 2D térbeli terület, amely érzékeli, amikor más [CollisionObject2D] objektumok belépnek a területre vagy kilépnek onnan."

#. Area2D.description
#: doc/classes/Area2D.xml
msgid "[Area2D] is a region of 2D space defined by one or multiple [CollisionShape2D] or [CollisionPolygon2D] child nodes. It detects when other [CollisionObject2D]s enter or exit it, and it also keeps track of which collision objects haven't exited it yet (i.e. which one are overlapping it).\nThis node can also locally alter or override physics parameters (gravity, damping) and route audio to custom audio buses.\n[b]Note:[/b] Areas and bodies created with [PhysicsServer2D] might not interact as expected with [Area2D]s, and might not emit signals or track objects correctly."
msgstr "Az [Area2D] egy 2D-s terület, amelyet egy vagy több gyermek [CollisionShape2D] vagy [CollisionPolygon2D] csomópont határoz meg. Érzékeli, amikor más [CollisionObject2D] objektumok belépnek a területére vagy kilépnek onnan, és nyilvántartja azokat is, amelyek még átfedésben vannak vele.\nA csomópont helyileg módosíthatja vagy felülírhatja a fizikai paramétereket (gravitáció, csillapítás), és a hangot egyéni hangbuszokra irányíthatja.\n[b]Megjegyzés:[/b] A [PhysicsServer2D] segítségével létrehozott területek és testek nem feltétlenül a várt módon működnek együtt az [Area2D] csomópontokkal; előfordulhat, hogy nem küldenek jelzéseket, vagy nem megfelelően követik az objektumokat."

#. Area2D.monitoring
#: doc/classes/Area2D.xml
msgid "If [code]true[/code], the area detects bodies or areas entering and exiting it."
msgstr "Ha [code]true[/code], a terület érzékeli a testek és más területek belépését és kilépését."

#. Area2D.monitorable
#: doc/classes/Area2D.xml
msgid "If [code]true[/code], other monitoring areas can detect this area."
msgstr "Ha [code]true[/code], más, érzékelést végző területek felismerhetik ezt a területet."

#. Area2D.priority
#: doc/classes/Area2D.xml
msgid "The area's priority. Higher priority areas are processed first. The [World2D]'s physics is always processed last, after all areas."
msgstr "A terület prioritása. A nagyobb prioritású területeket előbb dolgozza fel a rendszer. A [World2D] fizikáját mindig az összes terület után dolgozza fel."

#. Area2D.gravity
#: doc/classes/Area2D.xml
msgid "The area's gravity intensity (in pixels per second squared). This value multiplies the gravity direction. This is useful to alter the force of gravity without altering its direction."
msgstr "A terület gravitációjának erőssége (képpont/másodperc négyzetben). Ez az érték a gravitáció irányvektorának szorzójaként működik. Így a gravitáció erőssége az irány megváltoztatása nélkül módosítható."

#. Area2D.gravity_direction
#: doc/classes/Area2D.xml
msgid "The area's gravity vector (not normalized)."
msgstr "A terület gravitációvektora (nem normalizált)."

#. Area2D.gravity_point
#: doc/classes/Area2D.xml
msgid "If [code]true[/code], gravity is calculated from a point (set via [member gravity_point_center]). See also [member gravity_space_override]."
msgstr "Ha [code]true[/code], a gravitációt egy pontból számítja (amelyet a [member gravity_point_center] határoz meg). Lásd még: [member gravity_space_override]."

#. Area2D.gravity_point_center
#: doc/classes/Area2D.xml
msgid "If gravity is a point (see [member gravity_point]), this will be the point of attraction."
msgstr "Pontszerű gravitáció esetén (lásd [member gravity_point]) ez a vonzás középpontja."

#. Area2D.gravity_space_override
#: doc/classes/Area2D.xml
msgid "Override mode for gravity calculations within this area."
msgstr "A gravitáció számításának felülírási módja ezen a területen."

#. Area2D.linear_damp
#: doc/classes/Area2D.xml
msgid "The rate at which objects stop moving in this area. Represents the linear velocity lost per second.\nSee [member ProjectSettings.physics/2d/default_linear_damp] for more details about damping."
msgstr "Az objektumok mozgásának lelassulási üteme ezen a területen. A másodpercenként elveszített lineáris sebességet jelenti.\nA csillapításról további információ: [member ProjectSettings.physics/2d/default_linear_damp]."

#. Area2D.angular_damp
#: doc/classes/Area2D.xml
msgid "The rate at which objects stop spinning in this area. Represents the angular velocity lost per second.\nSee [member ProjectSettings.physics/2d/default_angular_damp] for more details about damping."
msgstr "Az objektumok forgásának lelassulási üteme ezen a területen. A másodpercenként elveszített szögsebességet jelenti.\nA csillapításról további információ: [member ProjectSettings.physics/2d/default_angular_damp]."

#. Area2D.audio_bus_override
#: doc/classes/Area2D.xml
msgid "If [code]true[/code], the area's audio bus overrides the default audio bus."
msgstr "Ha [code]true[/code], a terület hangbusza felülírja az alapértelmezett hangbuszt."

#. Area2D.audio_bus_name
#: doc/classes/Area2D.xml
msgid "The name of the area's audio bus."
msgstr "A terület hangbuszának neve."

#. Area2D.get_overlapping_areas
#: doc/classes/Area2D.xml
msgid "Returns a list of intersecting [Area2D]s. The overlapping area's [member CollisionObject2D.collision_layer] must be part of this area's [member CollisionObject2D.collision_mask] in order to be detected.\nFor performance reasons (collisions are all processed at the same time) this list is modified once during the physics step, not immediately after objects are moved. Consider using signals instead."
msgstr "Visszaadja az egymást metsző [Area2D] területek listáját. A másik terület [member CollisionObject2D.collision_layer] rétegének szerepelnie kell ennek a területnek a [member CollisionObject2D.collision_mask] maszkjában ahhoz, hogy a rendszer érzékelje.\nTeljesítménybeli okokból (az ütközések közös feldolgozása miatt) ez a lista csak a fizikai lépések során frissül, nem azonnal az objektumok mozgatása után. Ehelyett érdemes lehet jelzéseket használni."

#. Area2D.get_overlapping_bodies
#: doc/classes/Area2D.xml
msgid "Returns a list of intersecting [PhysicsBody2D]s and [TileMap]s. The overlapping body's [member CollisionObject2D.collision_layer] must be part of this area's [member CollisionObject2D.collision_mask] in order to be detected.\nFor performance reasons (collisions are all processed at the same time) this list is modified once during the physics step, not immediately after objects are moved. Consider using signals instead."
msgstr "Visszaadja az ezzel a területtel átfedésben lévő [PhysicsBody2D] testek és [TileMap] csomópontok listáját. A másik test [member CollisionObject2D.collision_layer] rétegének szerepelnie kell ennek a területnek a [member CollisionObject2D.collision_mask] maszkjában ahhoz, hogy a rendszer érzékelje.\nTeljesítménybeli okokból (az ütközések közös feldolgozása miatt) ez a lista csak a fizikai lépések során frissül, nem azonnal az objektumok mozgatása után. Ehelyett érdemes lehet jelzéseket használni."

#. Area2D.has_overlapping_areas
#: doc/classes/Area2D.xml
msgid "Returns [code]true[/code] if intersecting any [Area2D]s, otherwise returns [code]false[/code]. The overlapping area's [member CollisionObject2D.collision_layer] must be part of this area's [member CollisionObject2D.collision_mask] in order to be detected.\nFor performance reasons (collisions are all processed at the same time) the list of overlapping areas is modified once during the physics step, not immediately after objects are moved. Consider using signals instead."
msgstr "[code]true[/code] értéket ad vissza, ha a terület metsz legalább egy [Area2D] területet, egyébként [code]false[/code] értéket. A másik terület [member CollisionObject2D.collision_layer] rétegének szerepelnie kell ennek a területnek a [member CollisionObject2D.collision_mask] maszkjában ahhoz, hogy a rendszer érzékelje.\nTeljesítménybeli okokból (az ütközések közös feldolgozása miatt) az átfedő területek listája csak a fizikai lépések során frissül, nem azonnal az objektumok mozgatása után. Ehelyett érdemes lehet jelzéseket használni."

#. Area2D.has_overlapping_bodies
#: doc/classes/Area2D.xml
msgid "Returns [code]true[/code] if intersecting any [PhysicsBody2D]s or [TileMap]s, otherwise returns [code]false[/code]. The overlapping body's [member CollisionObject2D.collision_layer] must be part of this area's [member CollisionObject2D.collision_mask] in order to be detected.\nFor performance reasons (collisions are all processed at the same time) the list of overlapping bodies is modified once during the physics step, not immediately after objects are moved. Consider using signals instead."
msgstr "[code]true[/code] értéket ad vissza, ha a terület metsz legalább egy [PhysicsBody2D] testet vagy [TileMap] csomópontot, egyébként [code]false[/code] értéket. A másik test [member CollisionObject2D.collision_layer] rétegének szerepelnie kell ennek a területnek a [member CollisionObject2D.collision_mask] maszkjában ahhoz, hogy a rendszer érzékelje.\nTeljesítménybeli okokból (az ütközések közös feldolgozása miatt) az átfedő testek listája csak a fizikai lépések során frissül, nem azonnal az objektumok mozgatása után. Ehelyett érdemes lehet jelzéseket használni."

#. Area2D.overlaps_area
#: doc/classes/Area2D.xml
msgid "Returns [code]true[/code] if the given [Area2D] intersects or overlaps this [Area2D], [code]false[/code] otherwise.\n[b]Note:[/b] The result of this test is not immediate after moving objects. For performance, the list of overlaps is updated once per frame and before the physics step. Consider using signals instead."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [Area2D] metszi ezt az [Area2D] területet, egyébként [code]false[/code] értéket.\n[b]Megjegyzés:[/b] Az ellenőrzés eredménye nem frissül azonnal az objektumok mozgatása után. A teljesítmény érdekében az átfedések listája képkockánként egyszer, a fizikai lépés előtt frissül. Ehelyett érdemes lehet jelzéseket használni."

#. Area2D.overlaps_body
#: doc/classes/Area2D.xml
msgid "Returns [code]true[/code] if the given physics body intersects or overlaps this [Area2D], [code]false[/code] otherwise.\n[b]Note:[/b] The result of this test is not immediate after moving objects. For performance, list of overlaps is updated once per frame and before the physics step. Consider using signals instead.\nThe [param body] argument can either be a [PhysicsBody2D] or a [TileMap] instance. While TileMaps are not physics bodies themselves, they register their tiles with collision shapes as a virtual physics body."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott fizikai test metszi ezt az [Area2D] területet, egyébként [code]false[/code] értéket.\n[b]Megjegyzés:[/b] Az ellenőrzés eredménye nem frissül azonnal az objektumok mozgatása után. A teljesítmény érdekében az átfedések listája képkockánként egyszer, a fizikai lépés előtt frissül. Ehelyett érdemes lehet jelzéseket használni.\nA [param body] paraméter [PhysicsBody2D] vagy [TileMap] példány lehet. Bár a TileMap csomópontok maguk nem fizikai testek, az ütközési alakzatokkal rendelkező csempéiket virtuális fizikai testként regisztrálják."

#. CollisionObject2D.brief
#: doc/classes/CollisionObject2D.xml
msgid "Abstract base class for 2D physics objects."
msgstr "Absztrakt alaposztály 2D-s fizikai objektumokhoz."

#. CollisionObject2D.description
#: doc/classes/CollisionObject2D.xml
msgid "Abstract base class for 2D physics objects. [CollisionObject2D] can hold any number of [Shape2D]s for collision. Each shape must be assigned to a [i]shape owner[/i]. Shape owners are not nodes and do not appear in the editor, but are accessible through code using the [code]shape_owner_*[/code] methods.\n[b]Note:[/b] Only collisions between objects within the same canvas ([Viewport] canvas or [CanvasLayer]) are supported. The behavior of collisions between objects in different canvases is undefined."
msgstr "Absztrakt alaposztály 2D-s fizikai objektumokhoz. Egy [CollisionObject2D] tetszőleges számú [Shape2D] alakzatot tartalmazhat az ütközések kezeléséhez. Minden alakzatot hozzá kell rendelni egy [i]alakzattulajdonoshoz[/i]. Az alakzattulajdonosok nem csomópontok, ezért nem jelennek meg a szerkesztőben, de a [code]shape_owner_*[/code] metódusokkal elérhetők a kódból.\n[b]Megjegyzés:[/b] Csak az azonos vásznon ([Viewport] vászna vagy [CanvasLayer]) található objektumok közötti ütközések támogatottak. A különböző vásznakon található objektumok ütközéseinek működése nincs meghatározva."

#. CollisionObject2D.collision_layer
#: doc/classes/CollisionObject2D.xml
msgid "The physics layers this CollisionObject2D is in. Collision objects can exist in one or more of 32 different layers. See also [member collision_mask].\n[b]Note:[/b] Object A can detect a contact with object B only if object B is in any of the layers that object A scans. See [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Collision layers and masks[/url] in the documentation for more information."
msgstr "Azok a fizikai rétegek, amelyekhez ez a CollisionObject2D tartozik. Egy ütközési objektum a 32 különböző réteg közül egyhez vagy többhöz tartozhat. Lásd még: [member collision_mask].\n[b]Megjegyzés:[/b] Az A objektum csak akkor érzékeli a B objektummal való érintkezést, ha B legalább az A által vizsgált rétegek egyikéhez tartozik. További információ: [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Ütközési rétegek és maszkok[/url]."

#. CollisionObject2D.collision_mask
#: doc/classes/CollisionObject2D.xml
msgid "The physics layers this CollisionObject2D scans. Collision objects can scan one or more of 32 different layers. See also [member collision_layer].\n[b]Note:[/b] Object A can detect a contact with object B only if object B is in any of the layers that object A scans. See [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Collision layers and masks[/url] in the documentation for more information."
msgstr "Azok a fizikai rétegek, amelyeket ez a CollisionObject2D vizsgál. Egy ütközési objektum a 32 különböző rétegből egyet vagy többet vizsgálhat. Lásd még: [member collision_layer].\n[b]Megjegyzés:[/b] Az A objektum csak akkor érzékeli a B objektummal való érintkezést, ha B legalább az A által vizsgált rétegek egyikéhez tartozik. További információ: [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Ütközési rétegek és maszkok[/url]."

#. CollisionObject2D.collision_priority
#: doc/classes/CollisionObject2D.xml
msgid "The priority used to solve colliding when occurring penetration. The higher the priority is, the lower the penetration into the object will be. This can for example be used to prevent the player from breaking through the boundaries of a level."
msgstr "Az egymásba hatoló objektumok szétválasztásához használt ütközési prioritás. Minél nagyobb a prioritás, annál kevésbé tudnak más testek behatolni ebbe az objektumba. Ez például segíthet megakadályozni, hogy a játékos áttörjön a pálya határain."

#. CollisionObject2D.disable_mode
#: doc/classes/CollisionObject2D.xml
msgid "Defines the behavior in physics when [member Node.process_mode] is set to [constant Node.PROCESS_MODE_DISABLED]."
msgstr "Meghatározza a fizikai működést, amikor a [member Node.process_mode] értéke [constant Node.PROCESS_MODE_DISABLED]."

#. CollisionObject2D.input_pickable
#: doc/classes/CollisionObject2D.xml
msgid "If [code]true[/code], this object is pickable. A pickable object can detect the mouse pointer entering/leaving, and if the mouse is inside it, report input events. Requires at least one [member collision_layer] bit to be set."
msgstr "Ha [code]true[/code], az objektum egérmutatóval kiválasztható, és fogadhatja az egérbemeneti eseményeket. Felismerheti az egérmutató belépését vagy kilépését, és bemeneti eseményeket jelezhet, ha az egérmutató felette van. Ehhez a [member collision_layer] legalább egy bitjének beállítottnak kell lennie."

#. CollisionObject2D.create_shape_owner
#: doc/classes/CollisionObject2D.xml
msgid "Creates a new shape owner for the given object. Returns [code]owner_id[/code] of the new owner for future reference."
msgstr "Új alakzattulajdonost hoz létre a megadott objektumhoz. Visszaadja az új tulajdonos [code]owner_id[/code] azonosítóját későbbi használatra."

#. CollisionObject2D.get_collision_layer_value
#: doc/classes/CollisionObject2D.xml
msgid "Returns whether or not the specified layer of the [member collision_layer] is enabled, given a [param layer_number] between 1 and 32."
msgstr "Visszaadja, hogy a [member collision_layer] adott rétege engedélyezett-e; a [param layer_number] értéke 1 és 32 közé eshet."

#. CollisionObject2D.get_collision_mask_value
#. RayCast2D.get_collision_mask_value
#: doc/classes/CollisionObject2D.xml
#: doc/classes/RayCast2D.xml
msgid "Returns whether or not the specified layer of the [member collision_mask] is enabled, given a [param layer_number] between 1 and 32."
msgstr "Visszaadja, hogy a [member collision_mask] adott rétege engedélyezett-e; a [param layer_number] értéke 1 és 32 közé eshet."

#. CollisionObject2D.get_rid
#: doc/classes/CollisionObject2D.xml
msgid "Returns the object's [RID]."
msgstr "Visszaadja az objektum [RID] azonosítóját."

#. CollisionObject2D.get_shape_owners
#: doc/classes/CollisionObject2D.xml
msgid "Returns an [Array] of [code]owner_id[/code] identifiers. You can use these ids in other methods that take [code]owner_id[/code] as an argument."
msgstr "Visszaadja az alakzattulajdonosok [code]owner_id[/code] azonosítóit tartalmazó [Array] tömböt. Ezeket az azonosítókat olyan más metódusokban is használhatod, amelyek [code]owner_id[/code] paramétert várnak."

#. CollisionObject2D.is_shape_owner_disabled
#: doc/classes/CollisionObject2D.xml
msgid "If [code]true[/code], the shape owner and its shapes are disabled."
msgstr "Ha [code]true[/code], az alakzattulajdonos és a hozzá tartozó alakzatok le vannak tiltva."

#. CollisionObject2D.remove_shape_owner
#: doc/classes/CollisionObject2D.xml
msgid "Removes the given shape owner."
msgstr "Eltávolítja a megadott alakzattulajdonost."

#. CollisionObject2D.set_collision_layer_value
#: doc/classes/CollisionObject2D.xml
msgid "Based on [param value], enables or disables the specified layer in the [member collision_layer], given a [param layer_number] between 1 and 32."
msgstr "A [param value] alapján engedélyezi vagy letiltja a [member collision_layer] [param layer_number] sorszámú rétegét (1 és 32 között)."

#. CollisionObject2D.set_collision_mask_value
#. RayCast2D.set_collision_mask_value
#: doc/classes/CollisionObject2D.xml
#: doc/classes/RayCast2D.xml
msgid "Based on [param value], enables or disables the specified layer in the [member collision_mask], given a [param layer_number] between 1 and 32."
msgstr "A [param value] alapján engedélyezi vagy letiltja a [member collision_mask] [param layer_number] sorszámú rétegét (1 és 32 között)."

#. CollisionObject2D.shape_find_owner
#: doc/classes/CollisionObject2D.xml
msgid "Returns the [code]owner_id[/code] of the given shape."
msgstr "Visszaadja a megadott alakzathoz tartozó [code]owner_id[/code] azonosítót."

#. CollisionObject2D.shape_owner_add_shape
#: doc/classes/CollisionObject2D.xml
msgid "Adds a [Shape2D] to the shape owner."
msgstr "Hozzáad egy [Shape2D] alakzatot az alakzattulajdonoshoz."

#. CollisionObject2D.shape_owner_clear_shapes
#: doc/classes/CollisionObject2D.xml
msgid "Removes all shapes from the shape owner."
msgstr "Eltávolítja az alakzattulajdonos összes alakzatát."

#. CollisionObject2D.shape_owner_get_owner
#: doc/classes/CollisionObject2D.xml
msgid "Returns the parent object of the given shape owner."
msgstr "Visszaadja a megadott alakzattulajdonos szülőobjektumát."

#. CollisionObject2D.shape_owner_get_shape
#: doc/classes/CollisionObject2D.xml
msgid "Returns the [Shape2D] with the given ID from the given shape owner."
msgstr "Visszaadja a megadott alakzattulajdonos megadott azonosítójú [Shape2D] alakzatát."

#. CollisionObject2D.shape_owner_get_shape_count
#: doc/classes/CollisionObject2D.xml
msgid "Returns the number of shapes the given shape owner contains."
msgstr "Visszaadja a megadott alakzattulajdonoshoz tartozó alakzatok számát."

#. CollisionObject2D.shape_owner_remove_shape
#: doc/classes/CollisionObject2D.xml
msgid "Removes a shape from the given shape owner."
msgstr "Eltávolít egy alakzatot a megadott alakzattulajdonostól."

#. CollisionObject2D.shape_owner_set_disabled
#: doc/classes/CollisionObject2D.xml
msgid "If [code]true[/code], disables the given shape owner."
msgstr "Ha [code]true[/code], letiltja a megadott alakzattulajdonost."

#. CollisionObject2D.shape_owner_set_transform
#: doc/classes/CollisionObject2D.xml
msgid "Sets the [Transform2D] of the given shape owner."
msgstr "Beállítja a megadott alakzattulajdonos [Transform2D] transzformációját."

#. AudioStreamPlayer2D.brief
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Plays positional sound in 2D space."
msgstr "Térbeli hangot játszik le 2D környezetben."

#. AudioStreamPlayer2D.description
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Plays audio that is attenuated with distance to the listener.\nBy default, audio is heard from the screen center. This can be changed by adding an [AudioListener2D] node to the scene and enabling it by calling [method AudioListener2D.make_current] on it.\nSee also [AudioStreamPlayer] to play a sound non-positionally.\n[b]Note:[/b] Hiding an [AudioStreamPlayer2D] node does not disable its audio output. To temporarily disable an [AudioStreamPlayer2D]'s audio output, set [member volume_db] to a very low value like [code]-100[/code] (which isn't audible to human hearing)."
msgstr "Olyan hangot játszik le, amelynek hangereje a hallgatótól mért távolsággal csökken.\nAlapértelmezés szerint a hangot a képernyő közepéből halljuk. Ezt úgy módosíthatod, hogy [AudioListener2D] csomópontot adsz a jelenethez, majd a [method AudioListener2D.make_current] hívással aktiválod.\nHa térbeli elhelyezkedés nélkül szeretnél hangot lejátszani, lásd még: [AudioStreamPlayer].\n[b]Megjegyzés:[/b] Az [AudioStreamPlayer2D] csomópont elrejtése nem némítja el a hangot. A hangkimenet átmeneti letiltásához állítsd az [AudioStreamPlayer2D] [member volume_db] értékét nagyon alacsonyra, például [code]-100[/code] értékre (amit az emberi fül már nem hall)."

#. AudioStreamPlayer2D.area_mask
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Determines which [Area2D] layers affect the sound for reverb and audio bus effects. Areas can be used to redirect [AudioStream]s so that they play in a certain audio bus. An example of how you might use this is making a \"water\" area so that sounds played in the water are redirected through an audio bus to make them sound like they are being played underwater."
msgstr "Meghatározza, hogy mely [Area2D] rétegek befolyásolják a hangot visszhang és hangbusz-effektek szempontjából. A területek átirányíthatják az [AudioStream] hangfolyamokat egy meghatározott hangbuszra. Például létrehozhatsz egy „víz” területet, amely a vízben lejátszott hangokat olyan buszra irányítja, hogy víz alatti hangzásuk legyen."

#. AudioStreamPlayer2D.attenuation
#: doc/classes/AudioStreamPlayer2D.xml
msgid "The volume is attenuated over distance with this as an exponent."
msgstr "Ezzel a kitevővel határozható meg, hogyan csökken a hangerő a távolság növekedésével."

#. AudioStreamPlayer2D.autoplay
#: doc/classes/AudioStreamPlayer2D.xml
msgid "If [code]true[/code], audio plays when added to scene tree."
msgstr "Ha [code]true[/code], a jelenetfához hozzáadáskor elindul a hanglejátszás."

#. AudioStreamPlayer2D.bus
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Bus on which this audio is playing.\n[b]Note:[/b] When setting this property, keep in mind that no validation is performed to see if the given name matches an existing bus. This is because audio bus layouts might be loaded after this property is set. If this given name can't be resolved at runtime, it will fall back to [code]\"Master\"[/code]."
msgstr "Az a hangbusz, amelyen ez a hang szól.\n[b]Megjegyzés:[/b] A beállításkor a Godot nem ellenőrzi, hogy a megadott név valóban létező buszhoz tartozik-e. Ennek oka, hogy a hangbusz-elrendezés később is betöltődhet. Ha a név futás közben nem található, a rendszer a [code]\"Master\"[/code] buszra vált."

#. AudioStreamPlayer2D.max_distance
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Maximum distance from which audio is still hearable."
msgstr "Az a legnagyobb távolság, ahonnan a hang még hallható."

#. AudioStreamPlayer2D.max_polyphony
#: doc/classes/AudioStreamPlayer2D.xml
msgid "The maximum number of sounds this node can play at the same time. Playing additional sounds after this value is reached will cut off the oldest sounds."
msgstr "A csomópont által egyszerre lejátszható hangok legnagyobb száma. Ha a korlát elérése után újabb hang indul, a legrégebbi hangok megszakadnak."

#. AudioStreamPlayer2D.panning_strength
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Scales the panning strength for this node by multiplying the base [member ProjectSettings.audio/general/2d_panning_strength] with this factor. Higher values will pan audio from left to right more dramatically than lower values."
msgstr "A csomópont sztereó panorámázásának erősségét szorozza meg a [member ProjectSettings.audio/general/2d_panning_strength] alapértékkel. Nagyobb értéknél erősebben érzékelhető a hang balra-jobbra eltolódása, mint kisebb értéknél."

#. AudioStreamPlayer2D.pitch_scale
#: doc/classes/AudioStreamPlayer2D.xml
msgid "The pitch and the tempo of the audio, as a multiplier of the audio sample's sample rate."
msgstr "A hang magasságának és tempójának szorzója a hangminta mintavételi frekvenciájához viszonyítva."

#. AudioStreamPlayer2D.playback_type
#: doc/classes/AudioStreamPlayer2D.xml
msgid "The playback type of the stream player. If set other than to the default value, it will force that playback type."
msgstr "A hangfolyam lejátszási típusa. Az alapértelmezettől eltérő érték megadása kikényszeríti ezt a típust."

#. AudioStreamPlayer2D.playing
#: doc/classes/AudioStreamPlayer2D.xml
msgid "If [code]true[/code], audio is playing or is queued to be played (see [method play])."
msgstr "Ha [code]true[/code], a hang éppen szól, vagy lejátszásra van előkészítve (lásd [method play])."

#. AudioStreamPlayer2D.stream
#: doc/classes/AudioStreamPlayer2D.xml
msgid "The [AudioStream] object to be played."
msgstr "A lejátszandó [AudioStream] objektum."

#. AudioStreamPlayer2D.stream_paused
#: doc/classes/AudioStreamPlayer2D.xml
msgid "If [code]true[/code], the playback is paused. You can resume it by setting [member stream_paused] to [code]false[/code]."
msgstr "Ha [code]true[/code], a lejátszás szünetel. A folytatáshoz állítsd a [member stream_paused] értékét [code]false[/code] értékre."

#. AudioStreamPlayer2D.volume_db
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Base volume before attenuation, in decibels."
msgstr "Alaphangerő a távolság miatti csillapítás előtt, decibelben."

#. AudioStreamPlayer2D.volume_linear
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Base volume before attenuation, as a linear value.\n[b]Note:[/b] This member modifies [member volume_db] for convenience. The returned value is equivalent to the result of [method @GlobalScope.db_to_linear] on [member volume_db]. Setting this member is equivalent to setting [member volume_db] to the result of [method @GlobalScope.linear_to_db] on a value."
msgstr "Alaphangerő a távolság miatti csillapítás előtt, lineáris értékként.\n[b]Megjegyzés:[/b] Ez a tulajdonság a [member volume_db] kényelmesebb beállítására szolgál. A visszaadott érték megegyezik a [method @GlobalScope.db_to_linear] segítségével a [member volume_db] értékből számított eredménnyel. A beállítása olyan, mintha a [member volume_db] tulajdonságot a [method @GlobalScope.linear_to_db] által átalakított értékre állítanád."

#. AudioStreamPlayer2D.get_playback_position
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Returns the position in the [AudioStream]."
msgstr "Visszaadja az aktuális lejátszási pozíciót az [AudioStream] hangfolyamban."

#. AudioStreamPlayer2D.get_stream_playback
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Returns the [AudioStreamPlayback] object associated with this [AudioStreamPlayer2D]."
msgstr "Visszaadja az ehhez az [AudioStreamPlayer2D] csomóponthoz tartozó [AudioStreamPlayback] objektumot."

#. AudioStreamPlayer2D.has_stream_playback
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Returns whether the [AudioStreamPlayer] can return the [AudioStreamPlayback] object or not."
msgstr "Megadja, hogy az [AudioStreamPlayer] vissza tud-e adni [AudioStreamPlayback] objektumot."

#. AudioStreamPlayer2D.play
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Queues the audio to play on the next physics frame, from the given position [param from_position], in seconds."
msgstr "A hang lejátszását a következő fizikai képkockára ütemezi a [param from_position] pozíciótól kezdve (másodpercben)."

#. AudioStreamPlayer2D.seek
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Sets the position from which audio will be played, in seconds."
msgstr "Beállítja a hang lejátszásának kezdőpozícióját másodpercben."

#. AudioStreamPlayer2D.stop
#: doc/classes/AudioStreamPlayer2D.xml
msgid "Stops the audio."
msgstr "Leállítja a hang lejátszását."

#. AnimationTree.brief
#: doc/classes/AnimationTree.xml
msgid "A node used for advanced animation transitions in an [AnimationPlayer]."
msgstr "Az [AnimationPlayer] összetett animációváltásainak kezelésére szolgáló csomópont."

#. AnimationTree.description
#: doc/classes/AnimationTree.xml
msgid "A node used for advanced animation transitions in an [AnimationPlayer].\n[b]Note:[/b] When linked with an [AnimationPlayer], several properties and methods of the corresponding [AnimationPlayer] will not function as expected. Playback and transitions should be handled using only the [AnimationTree] and its constituent [AnimationNode](s). The [AnimationPlayer] node should be used solely for adding, deleting, and editing animations."
msgstr "Az [AnimationPlayer] összetett animációváltásainak kezelésére szolgáló csomópont.\n[b]Megjegyzés:[/b] Ha egy [AnimationPlayer] csomóponthoz kapcsolódik, a hozzá tartozó [AnimationPlayer] egyes tulajdonságai és metódusai nem a megszokott módon működnek. A lejátszást és az animációk közötti váltásokat kizárólag az [AnimationTree] és az azt alkotó [AnimationNode] csomópontok segítségével kezeld. Az [AnimationPlayer] csomópontot csak az animációk hozzáadására, törlésére és szerkesztésére használd."

#. AnimationTree.advance_expression_base_node
#: doc/classes/AnimationTree.xml
msgid "The path to the [Node] used to evaluate the [AnimationNode] [Expression] if one is not explicitly specified internally."
msgstr "Annak a [Node] csomópontnak az útvonala, amelyet az [AnimationNode] [Expression] kiértékeléséhez használ a rendszer, ha belsőleg nincs kifejezetten megadva másik csomópont."

#. AnimationTree.anim_player
#: doc/classes/AnimationTree.xml
msgid "The path to the [AnimationPlayer] used for animating."
msgstr "Az animációhoz használt [AnimationPlayer] csomópont útvonala."

#. AnimationTree.tree_root
#: doc/classes/AnimationTree.xml
msgid "The root animation node of this [AnimationTree]. See [AnimationRootNode]."
msgstr "Az [AnimationTree] gyökér animációs csomópontja. Lásd: [AnimationRootNode]."

#. AnimationTree.get_process_callback
#: doc/classes/AnimationTree.xml
msgid "Returns the process notification in which to update animations."
msgstr "Visszaadja az animációk frissítéséhez használt feldolgozási értesítés típusát."

#. AnimationTree.set_process_callback
#: doc/classes/AnimationTree.xml
msgid "Sets the process notification in which to update animations."
msgstr "Beállítja az animációk frissítéséhez használt feldolgozási értesítés típusát."

#. TileSetScenesCollectionSource.brief
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Exposes a set of scenes as tiles for a [TileSet] resource."
msgstr "Jelenetek gyűjteményét teszi elérhetővé csempékként egy [TileSet] erőforrás számára."

#. TileSetScenesCollectionSource.create_scene_tile
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Creates a scene-based tile out of the given scene.\nReturns a newly generated unique ID."
msgstr "Jelenetalapú csempét készít a megadott jelenetből.\nVisszaad egy újonnan létrehozott egyedi azonosítót."

#. TileSetScenesCollectionSource.get_next_scene_tile_id
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Returns the scene ID a following call to [method create_scene_tile] would return."
msgstr "Visszaadja azt a jelenetazonosítót, amelyet a [method create_scene_tile] következő meghívása adna vissza."

#. TileSetScenesCollectionSource.get_scene_tile_display_placeholder
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Returns whether the scene tile with [param id] displays a placeholder in the editor."
msgstr "Visszaadja, hogy a [param id] azonosítójú jelenetcsempe megjelenít-e helyőrzőt a szerkesztőben."

#. TileSetScenesCollectionSource.get_scene_tile_id
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Returns the scene tile ID of the scene tile at [param index]."
msgstr "Visszaadja a [param index] indexű jelenetcsempe azonosítóját."

#. TileSetScenesCollectionSource.get_scene_tile_scene
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Returns the [PackedScene] resource of scene tile with [param id]."
msgstr "Visszaadja a [param id] azonosítójú jelenetcsempe [PackedScene] erőforrását."

#. TileSetScenesCollectionSource.get_scene_tiles_count
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Returns the number or scene tiles this TileSet source has."
msgstr "Visszaadja, hogy a TileSet-forrás hány jelenetcsempét tartalmaz."

#. TileSetScenesCollectionSource.has_scene_tile_id
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Returns whether this TileSet source has a scene tile with [param id]."
msgstr "Megadja, hogy a TileSet-forrás tartalmaz-e [param id] azonosítójú jelenetcsempét."

#. TileSetScenesCollectionSource.remove_scene_tile
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Remove the scene tile with [param id]."
msgstr "Eltávolítja a [param id] azonosítójú jelenetcsempét."

#. TileSetScenesCollectionSource.set_scene_tile_display_placeholder
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Sets whether or not the scene tile with [param id] should display a placeholder in the editor. This might be useful for scenes that are not visible."
msgstr "Beállítja, hogy a [param id] azonosítójú jelenetcsempe helyőrzőt jelenítsen-e meg a szerkesztőben. Ez a nem látható jeleneteknél lehet hasznos."

#. TileSetScenesCollectionSource.set_scene_tile_id
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Changes a scene tile's ID from [param id] to [param new_id]. This will fail if there is already a tile with an ID equal to [param new_id]."
msgstr "A jelenetcsempe azonosítóját [param id] értékről [param new_id] értékre változtatja. A művelet sikertelen, ha már létezik [param new_id] azonosítójú csempe."

#. TileSetScenesCollectionSource.set_scene_tile_scene
#: doc/classes/TileSetScenesCollectionSource.xml
msgid "Assigns a [PackedScene] resource to the scene tile with [param id]. This will fail if the scene does not extend [CanvasItem], as positioning properties are needed to place the scene on the [TileMapLayer]."
msgstr "A [param id] azonosítójú jelenetcsempéhez rendel egy [PackedScene] erőforrást. A művelet sikertelen, ha a jelenet nem a [CanvasItem] osztályból származik, mert a [TileMapLayer] rétegen való elhelyezéshez pozicionálási tulajdonságok szükségesek."

#. NavigationAgent2D.brief
#: doc/classes/NavigationAgent2D.xml
msgid "A 2D agent used to pathfind to a position while avoiding obstacles."
msgstr "2D-s navigációs ügynök, amely akadályok elkerülésével keres útvonalat egy célponthoz."

#. NavigationAgent2D.description
#: doc/classes/NavigationAgent2D.xml
msgid "A 2D agent used to pathfind to a position while avoiding static and dynamic obstacles. The calculation can be used by the parent node to dynamically move it along the path. Requires navigation data to work correctly.\nDynamic obstacles are avoided using RVO collision avoidance. Avoidance is computed before physics, so the pathfinding information can be used safely in the physics step.\n[b]Note:[/b] After setting the [member target_position] property, the [method get_next_path_position] method must be used once every physics frame to update the internal path logic of the navigation agent. The vector position it returns should be used as the next movement position for the agent's parent node.\n[b]Note:[/b] Several methods of this class, such as [method get_next_path_position], can trigger a new path calculation. Calling these in your callback to an agent's signal, such as [signal waypoint_reached], can cause infinite recursion. It is recommended to call these methods in the physics step or, alternatively, delay their call until the end of the frame (see [method Object.call_deferred] or [constant Object.CONNECT_DEFERRED])."
msgstr "Olyan 2D-s ügynök, amely statikus és mozgó akadályok elkerülésével keres útvonalat egy célponthoz. A kiszámított útvonalat a szülőcsomópont felhasználhatja a saját dinamikus mozgatásához. A megfelelő működéshez navigációs adatok szükségesek.\nA dinamikus akadályok elkerülése RVO-alapú ütközéselkerüléssel történik. Az elkerülési számítás a fizikai feldolgozás előtt fut le, így az útvonal-információk biztonságosan használhatók a fizikai lépésben.\n[b]Megjegyzés:[/b] A [member target_position] beállítása után minden fizikai képkockában egyszer meg kell hívni a [method get_next_path_position] metódust, hogy az ügynök belső útvonalkövetése frissüljön. A visszaadott vektorpozíciót a szülőcsomópont következő mozgási célpontjaként kell használni.\n[b]Megjegyzés:[/b] Az osztály több metódusa, például a [method get_next_path_position], új útvonaltervezést indíthat. Ha ezeket egy ügynök jelzésének, például a [signal waypoint_reached] jelzésnek a kezelőjében hívod meg, végtelen rekurzió alakulhat ki. Ajánlott ezeket a metódusokat a fizikai lépésben meghívni, vagy a képkocka végére halasztani (lásd: [method Object.call_deferred] vagy [constant Object.CONNECT_DEFERRED])."

#. NavigationAgent2D.avoidance_enabled
#: doc/classes/NavigationAgent2D.xml
msgid "If [code]true[/code] the agent is registered for an RVO avoidance callback on the [NavigationServer2D]. When [member velocity] is used and the processing is completed a [code]safe_velocity[/code] Vector2 is received with a signal connection to [signal velocity_computed]. Avoidance processing with many registered agents has a significant performance cost and should only be enabled on agents that currently require it."
msgstr "Ha [code]true[/code], az ügynök regisztrálja magát a [NavigationServer2D] RVO-alapú akadályelkerülési visszahívásához. A [member velocity] használata és a feldolgozás befejezése után a [signal velocity_computed] jelzésen keresztül egy [code]safe_velocity[/code] Vector2 sebességvektor érkezik. Sok regisztrált ügynök akadályelkerülési számítása jelentős teljesítményigényű, ezért csak azoknál az ügynököknél engedélyezd, amelyeknek éppen szükségük van rá."

#. NavigationAgent2D.avoidance_layers
#: doc/classes/NavigationAgent2D.xml
msgid "A bitfield determining the avoidance layers for this NavigationAgent. Other agents with a matching bit on the [member avoidance_mask] will avoid this agent."
msgstr "Az ügynök akadályelkerülési rétegeit meghatározó bitmező. Azok a másik ügynökök, amelyek [member avoidance_mask] értékében található egyező bit, elkerülik ezt az ügynököt."

#. NavigationAgent2D.avoidance_mask
#: doc/classes/NavigationAgent2D.xml
msgid "A bitfield determining what other avoidance agents and obstacles this NavigationAgent will avoid when a bit matches at least one of their [member avoidance_layers]."
msgstr "Bitmező, amely meghatározza, hogy az ügynök mely más ügynököket és akadályokat kerüli el, ha azok legalább egy [member avoidance_layers] bitje egyezik a maszkkal."

#. NavigationAgent2D.debug_enabled
#: doc/classes/NavigationAgent2D.xml
msgid "If [code]true[/code] shows debug visuals for this agent."
msgstr "Ha [code]true[/code], megjeleníti az ügynök hibakeresési ábráit."

#. NavigationAgent2D.max_neighbors
#: doc/classes/NavigationAgent2D.xml
msgid "The maximum number of neighbors for the agent to consider."
msgstr "Az ügynök által figyelembe vehető szomszédos ügynökök legnagyobb száma."

#. NavigationAgent2D.max_speed
#: doc/classes/NavigationAgent2D.xml
msgid "The maximum speed that an agent can move."
msgstr "Az ügynök legnagyobb mozgási sebessége."

#. NavigationAgent2D.navigation_layers
#: doc/classes/NavigationAgent2D.xml
msgid "A bitfield determining which navigation layers of navigation regions this agent will use to calculate a path. Changing it during runtime will clear the current navigation path and generate a new one, according to the new navigation layers."
msgstr "Bitmező, amely meghatározza, hogy az ügynök a navigációs területek mely navigációs rétegeit használja az útvonal kiszámításához. Ha futás közben módosítod, a jelenlegi útvonal törlődik, és az új rétegek alapján új útvonal készül."

#. NavigationAgent2D.neighbor_distance
#: doc/classes/NavigationAgent2D.xml
msgid "The distance to search for other agents."
msgstr "Az a távolság, amelyen belül a rendszer más ügynököket keres."

#. NavigationAgent2D.path_desired_distance
#: doc/classes/NavigationAgent2D.xml
msgid "The distance threshold before a path point is considered to be reached. This allows agents to not have to hit a path point on the path exactly, but only to reach its general area. If this value is set too high, the NavigationAgent will skip points on the path, which can lead to it leaving the navigation mesh. If this value is set too low, the NavigationAgent will be stuck in a repath loop because it will constantly overshoot the distance to the next point on each physics frame update."
msgstr "Az a távolsági küszöb, amelyen belül az útvonal egy pontját elértnek tekinti a rendszer. Így az ügynöknek nem kell pontosan a pontra érkeznie, elég annak közelébe jutnia. Ha az érték túl nagy, az ügynök átugorhat útvonali pontokat, és letérhet a navigációs hálóról. Ha túl kicsi, az ügynök újratervezési ciklusba ragadhat, mert minden fizikai képkockában túllép a következő ponthoz tartozó távolságon."

#. NavigationAgent2D.path_max_distance
#: doc/classes/NavigationAgent2D.xml
msgid "The maximum distance the agent is allowed away from the ideal path to the final position. This can happen due to trying to avoid collisions. When the maximum distance is exceeded, it recalculates the ideal path."
msgstr "A legnagyobb megengedett távolság az ügynök és a végcélig vezető ideális útvonal között. Az akadályok kerülgetése miatt az ügynök letérhet az útvonalról. Ha a távolság túllépi ezt a korlátot, a rendszer újratervezi az ideális útvonalat."

#. NavigationAgent2D.path_postprocessing
#. NavigationPathQueryParameters2D.path_postprocessing
#: doc/classes/NavigationAgent2D.xml
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The path postprocessing applied to the raw path corridor found by the [member pathfinding_algorithm]."
msgstr "A [member pathfinding_algorithm] által talált nyers útvonal-folyosón végrehajtott utófeldolgozás."

#. NavigationAgent2D.pathfinding_algorithm
#. NavigationPathQueryParameters2D.pathfinding_algorithm
#: doc/classes/NavigationAgent2D.xml
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The pathfinding algorithm used in the path query."
msgstr "Az útvonal lekérdezéséhez használt útkereső algoritmus."

#. NavigationAgent2D.target_position
#: doc/classes/NavigationAgent2D.xml
msgid "If set, a new navigation path from the current agent position to the [member target_position] is requested from the NavigationServer."
msgstr "Ha beállítod, a NavigationServer új navigációs útvonalat kér az ügynök jelenlegi pozíciójától a [member target_position] pontig."

#. NavigationAgent2D.velocity
#: doc/classes/NavigationAgent2D.xml
msgid "Sets the new wanted velocity for the agent. The avoidance simulation will try to fulfill this velocity if possible but will modify it to avoid collision with other agents and obstacles. When an agent is teleported to a new position, use [method set_velocity_forced] as well to reset the internal simulation velocity."
msgstr "Beállítja az ügynök kívánt új sebességét. Az akadályelkerülési szimuláció lehetőség szerint ezt próbálja megvalósítani, de a többi ügynökkel és akadállyal történő ütközés elkerüléséhez módosíthatja. Ha az ügynököt új pozícióra teleportálod, a [method set_velocity_forced] metódussal a belső szimuláció sebességét is állítsd vissza."

#. NavigationAgent2D.distance_to_target
#: doc/classes/NavigationAgent2D.xml
msgid "Returns the distance to the target position, using the agent's global position. The user must set [member target_position] in order for this to be accurate."
msgstr "Visszaadja a célpozíció távolságát az ügynök globális pozíciójától mérve. A pontos eredményhez a [member target_position] tulajdonságot be kell állítani."

#. NavigationAgent2D.get_current_navigation_path
#: doc/classes/NavigationAgent2D.xml
msgid "Returns this agent's current path from start to finish in global coordinates. The path only updates when the target position is changed or the agent requires a repath. The path array is not intended to be used in direct path movement as the agent has its own internal path logic that would get corrupted by changing the path array manually. Use the intended [method get_next_path_position] once every physics frame to receive the next path point for the agents movement as this function also updates the internal path logic."
msgstr "Visszaadja az ügynök aktuális útvonalát a kezdőponttól a végpontig, globális koordinátákban. Az útvonal csak a célpozíció változásakor vagy újratervezési igény esetén frissül. A visszaadott tömböt nem szabad közvetlenül a mozgás vezérlésére használni, mert az ügynök saját belső útvonalkövetését megzavarná a kézi módosítás. A következő mozgási pont lekérésére minden fizikai képkockában egyszer használd a [method get_next_path_position] metódust, amely a belső útvonalkövetést is frissíti."

#. NavigationAgent2D.get_current_navigation_path_index
#: doc/classes/NavigationAgent2D.xml
msgid "Returns which index the agent is currently on in the navigation path's [PackedVector2Array]."
msgstr "Visszaadja, hogy az ügynök jelenleg az útvonal [PackedVector2Array] tömbjének melyik indexénél tart."

#. NavigationAgent2D.get_next_path_position
#: doc/classes/NavigationAgent2D.xml
msgid "Returns the next position in global coordinates that can be moved to, making sure that there are no static objects in the way. If the agent does not have a navigation path, it will return the position of the agent's parent. The use of this function once every physics frame is required to update the internal path logic of the NavigationAgent."
msgstr "Visszaadja a következő elérhető pozíciót globális koordinátákban, figyelembe véve, hogy ne legyen útban statikus akadály. Ha az ügynöknek nincs útvonala, a szülőcsomópont pozícióját adja vissza. A belső útvonalkövetés frissítéséhez ezt a függvényt minden fizikai képkockában egyszer meg kell hívni."

#. NavigationAgent2D.is_navigation_finished
#: doc/classes/NavigationAgent2D.xml
msgid "Returns [code]true[/code] if the agent's navigation has finished. If the target is reachable, navigation ends when the target is reached. If the target is unreachable, navigation ends when the last waypoint of the path is reached.\n[b]Note:[/b] While [code]true[/code] prefer to stop calling update functions like [method get_next_path_position]. This avoids jittering the standing agent due to calling repeated path updates."
msgstr "[code]true[/code] értéket ad vissza, ha az ügynök navigációja befejeződött. Elérhető célpont esetén a navigáció akkor ér véget, amikor az ügynök eléri a célt. Ha a cél elérhetetlen, az útvonal utolsó pontjának elérésekor ér véget.\n[b]Megjegyzés:[/b] Amíg az érték [code]true[/code], ajánlott elkerülni a frissítő metódusok, például a [method get_next_path_position] ismételt meghívását, mert ez a helyben álló ügynök remegését okozhatja."

#. NavigationAgent2D.is_target_reachable
#: doc/classes/NavigationAgent2D.xml
msgid "Returns [code]true[/code] if [method get_final_position] is within [member target_desired_distance] of the [member target_position]."
msgstr "[code]true[/code] értéket ad vissza, ha a [method get_final_position] által visszaadott pont a [member target_position] célpont [member target_desired_distance] távolságán belül van."

#. NavigationAgent2D.is_target_reached
#: doc/classes/NavigationAgent2D.xml
msgid "Returns [code]true[/code] if the agent reached the target, i.e. the agent moved within [member target_desired_distance] of the [member target_position]. It may not always be possible to reach the target but it should always be possible to reach the final position. See [method get_final_position]."
msgstr "[code]true[/code] értéket ad vissza, ha az ügynök elérte a célpontot, azaz a [member target_position] ponttól [member target_desired_distance] távolságon belülre jutott. A célpont nem mindig érhető el, de az útvonal végső pozíciójának elérhetőnek kell lennie. Lásd: [method get_final_position]."

#. NavigationAgent2D.get_final_position
#: doc/classes/NavigationAgent2D.xml
msgid "Returns the reachable final position of the current navigation path in global coordinates. This position can change if the agent needs to update the navigation path which makes the agent emit the [signal path_changed] signal."
msgstr "Visszaadja az aktuális navigációs útvonal elérhető végpontját globális koordinátákban. A pont megváltozhat, ha az ügynöknek frissítenie kell az útvonalát; ilyenkor kibocsátja a [signal path_changed] jelzést."

#. RayCast2D.brief
#: doc/classes/RayCast2D.xml
msgid "A ray in 2D space, used to find the first collision object it intersects."
msgstr "2D-s sugárvizsgálat, amely megkeresi a sugár útjába eső első ütköző objektumot."

#. RayCast2D.description
#: doc/classes/RayCast2D.xml
msgid "A raycast represents a ray from its origin to its [member target_position] that finds the closest object along its path, if it intersects any.\n[RayCast2D] can ignore some objects by adding them to an exception list, by making its detection reporting ignore [Area2D]s ([member collide_with_areas]) or [PhysicsBody2D]s ([member collide_with_bodies]), or by configuring physics layers.\n[RayCast2D] calculates intersection every physics frame, and it holds the result until the next physics frame. For an immediate raycast, or if you want to configure a [RayCast2D] multiple times within the same physics frame, use [method force_raycast_update].\nTo sweep over a region of 2D space, you can approximate the region with multiple [RayCast2D]s or use [ShapeCast2D]."
msgstr "A sugárvizsgálat egy sugarat jelent a kiindulópontjától a [member target_position] pontig, amely megkeresi az útjába eső legközelebbi objektumot, ha van ilyen.\nA [RayCast2D] figyelmen kívül hagyhat bizonyos objektumokat, ha kivételként felveszed őket, letiltod az [Area2D] területek ([member collide_with_areas]) vagy a [PhysicsBody2D] testek ([member collide_with_bodies]) érzékelését, illetve beállítod a fizikai rétegeket.\nA [RayCast2D] minden fizikai képkockában kiszámítja a metszéseket, és az eredményt a következő fizikai képkockáig megőrzi. Azonnali vizsgálathoz, vagy ha ugyanazon a fizikai képkockán belül többször módosítod a [RayCast2D] beállításait, használd a [method force_raycast_update] metódust.\nEgy teljes 2D-s terület vizsgálatához több [RayCast2D] sugárral közelítheted a területet, vagy használhatsz [ShapeCast2D] csomópontot."

#. RayCast2D.collide_with_areas
#: doc/classes/RayCast2D.xml
msgid "If [code]true[/code], collisions with [Area2D]s will be reported."
msgstr "Ha [code]true[/code], a rendszer jelenti az [Area2D] területekkel történő ütközéseket."

#. RayCast2D.collide_with_bodies
#: doc/classes/RayCast2D.xml
msgid "If [code]true[/code], collisions with [PhysicsBody2D]s will be reported."
msgstr "Ha [code]true[/code], a rendszer jelenti a [PhysicsBody2D] testekkel történő ütközéseket."

#. RayCast2D.collision_mask
#: doc/classes/RayCast2D.xml
msgid "The ray's collision mask. Only objects in at least one collision layer enabled in the mask will be detected. See [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Collision layers and masks[/url] in the documentation for more information."
msgstr "A sugár ütközési maszkja. Csak azok az objektumok érzékelhetők, amelyek legalább egy, a maszkban engedélyezett ütközési réteghez tartoznak. További részletek: [url=$DOCS_URL/tutorials/physics/physics_introduction.html#collision-layers-and-masks]Ütközési rétegek és maszkok[/url]."

#. RayCast2D.enabled
#: doc/classes/RayCast2D.xml
msgid "If [code]true[/code], collisions will be reported."
msgstr "Ha [code]true[/code], a rendszer jelenti az ütközéseket."

#. RayCast2D.exclude_parent
#: doc/classes/RayCast2D.xml
msgid "If [code]true[/code], this raycast will not report collisions with its parent node. This property only has an effect if the parent node is a [CollisionObject2D]. See also [method Node.get_parent] and [method add_exception]."
msgstr "Ha [code]true[/code], a sugár nem jelenti a saját szülőcsomópontjával történő ütközéseket. Ez a tulajdonság csak akkor működik, ha a szülő [CollisionObject2D]. Lásd még: [method Node.get_parent] és [method add_exception]."

#. RayCast2D.hit_from_inside
#: doc/classes/RayCast2D.xml
msgid "If [code]true[/code], the ray will detect a hit when starting inside shapes. In this case the collision normal will be [code]Vector2(0, 0)[/code]. Does not affect concave polygon shapes."
msgstr "Ha [code]true[/code], a sugár akkor is érzékeli a találatot, ha az alakzat belsejéből indul. Ilyenkor az ütközési normálvektor [code]Vector2(0, 0)[/code]. Homorú sokszög alakzatokra nincs hatással."

#. RayCast2D.target_position
#: doc/classes/RayCast2D.xml
msgid "The ray's destination point, relative to this raycast's [member Node2D.position]."
msgstr "A sugár végpontja a [member Node2D.position] pozícióhoz viszonyítva."

#. RayCast2D.add_exception
#: doc/classes/RayCast2D.xml
msgid "Adds a collision exception so the ray does not report collisions with the specified [param node]."
msgstr "Ütközési kivételt ad hozzá, így a sugár nem jelenti az ütközést a megadott [param node] csomóponttal."

#. RayCast2D.add_exception_rid
#: doc/classes/RayCast2D.xml
msgid "Adds a collision exception so the ray does not report collisions with the specified [RID]."
msgstr "Ütközési kivételt ad hozzá, így a sugár nem jelenti az ütközést a megadott [RID] azonosítójú objektummal."

#. RayCast2D.clear_exceptions
#: doc/classes/RayCast2D.xml
msgid "Removes all collision exceptions for this ray."
msgstr "Eltávolítja a sugár összes ütközési kivételét."

#. RayCast2D.force_raycast_update
#: doc/classes/RayCast2D.xml
msgid "Updates the collision information for the ray immediately, without waiting for the next [code]_physics_process[/code] call. Use this method, for example, when the ray or its parent has changed state.\n[b]Note:[/b] [member enabled] does not need to be [code]true[/code] for this to work."
msgstr "Azonnal frissíti a sugár ütközési adatait, a következő [code]_physics_process[/code] hívás megvárása nélkül. Például akkor hasznos, ha a sugár vagy a szülője állapota megváltozott.\n[b]Megjegyzés:[/b] Ehhez a [member enabled] értékének nem kell [code]true[/code] értéken lennie."

#. RayCast2D.get_collider
#: doc/classes/RayCast2D.xml
msgid "Returns the first object that the ray intersects, or [code]null[/code] if no object is intersecting the ray (i.e. [method is_colliding] returns [code]false[/code]).\n[b]Note:[/b] This object is not guaranteed to be a [CollisionObject2D]. For example, if the ray intersects a [TileMapLayer], the method will return a [TileMapLayer] instance."
msgstr "Visszaadja a sugár által metszett első objektumot, vagy [code]null[/code] értéket, ha nincs találat (vagyis a [method is_colliding] [code]false[/code] értéket ad vissza).\n[b]Megjegyzés:[/b] A visszaadott objektum nem feltétlenül [CollisionObject2D]. Ha például a sugár egy [TileMapLayer] réteget metsz, a metódus [TileMapLayer] példányt ad vissza."

#. RayCast2D.get_collider_rid
#: doc/classes/RayCast2D.xml
msgid "Returns the [RID] of the first object that the ray intersects, or an empty [RID] if no object is intersecting the ray (i.e. [method is_colliding] returns [code]false[/code])."
msgstr "Visszaadja a sugár által metszett első objektum [RID] azonosítóját, vagy üres [RID] értéket, ha nincs találat (vagyis a [method is_colliding] [code]false[/code] értéket ad vissza)."

#. RayCast2D.get_collision_normal
#: doc/classes/RayCast2D.xml
msgid "Returns the normal of the intersecting object's shape at the collision point, or [code]Vector2(0, 0)[/code] if the ray starts inside the shape and [member hit_from_inside] is [code]true[/code].\n[b]Note:[/b] Check that [method is_colliding] returns [code]true[/code] before calling this method to ensure the returned normal is valid and up-to-date."
msgstr "Visszaadja az eltalált objektum alakzatának normálvektorát az ütközési pontban, vagy [code]Vector2(0, 0)[/code] értéket, ha a sugár az alakzat belsejéből indul, és a [member hit_from_inside] értéke [code]true[/code].\n[b]Megjegyzés:[/b] Meghívás előtt ellenőrizd, hogy a [method is_colliding] [code]true[/code] értéket ad-e vissza; hogy a visszaadott normálvektor érvényes és naprakész legyen."

#. RayCast2D.get_collision_point
#: doc/classes/RayCast2D.xml
msgid "Returns the collision point at which the ray intersects the closest object, in the global coordinate system. If [member hit_from_inside] is [code]true[/code] and the ray starts inside of a collision shape, this function will return the origin point of the ray.\n[b]Note:[/b] Check that [method is_colliding] returns [code]true[/code] before calling this method to ensure the returned point is valid and up-to-date."
msgstr "Visszaadja a sugár és a legközelebbi objektum metszéspontját globális koordinátákban. Ha a [member hit_from_inside] értéke [code]true[/code], és a sugár az ütközési alakzat belsejéből indul, a függvény a sugár kiindulópontját adja vissza.\n[b]Megjegyzés:[/b] Meghívás előtt ellenőrizd, hogy a [method is_colliding] [code]true[/code] értéket ad-e vissza; így a metszéspont érvényes és naprakész lesz."

#. RayCast2D.is_colliding
#: doc/classes/RayCast2D.xml
msgid "Returns whether any object is intersecting with the ray's vector (considering the vector length)."
msgstr "Visszaadja, hogy a sugár vektorát (annak hosszát is figyelembe véve) metszi-e bármilyen objektum."

#. RayCast2D.remove_exception
#: doc/classes/RayCast2D.xml
msgid "Removes a collision exception so the ray can report collisions with the specified [param node]."
msgstr "Eltávolítja a megadott [param node] csomópont ütközési kivételét, így a sugár ismét jelentheti a vele való ütközést."

#. RayCast2D.remove_exception_rid
#: doc/classes/RayCast2D.xml
msgid "Removes a collision exception so the ray can report collisions with the specified [RID]."
msgstr "Eltávolítja a megadott [RID] azonosítójú objektum ütközési kivételét, így a sugár ismét jelentheti a vele való ütközést."

#. NavigationRegion2D.brief
#: doc/classes/NavigationRegion2D.xml
msgid "A traversable 2D region that [NavigationAgent2D]s can use for pathfinding."
msgstr "Bejárható 2D-s terület, amelyet a [NavigationAgent2D] ügynökök útkeresésre használhatnak."

#. NavigationRegion2D.description
#: doc/classes/NavigationRegion2D.xml
msgid "A traversable 2D region based on a [NavigationPolygon] that [NavigationAgent2D]s can use for pathfinding.\nTwo regions can be connected to each other if they share a similar edge. You can set the minimum distance between two vertices required to connect two edges by using [method NavigationServer2D.map_set_edge_connection_margin].\n[b]Note:[/b] Overlapping two regions' navigation polygons is not enough for connecting two regions. They must share a similar edge.\nThe pathfinding cost of entering a region from another region can be controlled with the [member enter_cost] value.\n[b]Note:[/b] This value is not added to the path cost when the start position is already inside this region.\nThe pathfinding cost of traveling distances inside this region can be controlled with the [member travel_cost] multiplier.\n[b]Note:[/b] This node caches changes to its properties, so if you make changes to the underlying region [RID] in [NavigationServer2D], they will not be reflected in this node's properties."
msgstr "Egy [NavigationPolygon] alapján meghatározott bejárható 2D-s terület, amelyet a [NavigationAgent2D] ügynökök útkeresésre használhatnak.\nKét terület akkor kapcsolódhat egymáshoz, ha hasonló élük van. A két él összekapcsolásához szükséges legnagyobb csúcstávolságot a [method NavigationServer2D.map_set_edge_connection_margin] metódussal állíthatod be.\n[b]Megjegyzés:[/b] Két terület navigációs sokszögeinek átfedése önmagában nem elegendő az összekapcsolásukhoz. Hasonló élen kell osztozniuk.\nA másik területről való belépés útkeresési költsége a [member enter_cost] értékkel szabályozható.\n[b]Megjegyzés:[/b] Ha a kezdőpont már ezen a területen található, ez a költség nem adódik hozzá az útvonal költségéhez.\nA területen belül megtett távolságok útkeresési költségét a [member travel_cost] szorzó szabályozza.\n[b]Megjegyzés:[/b] A csomópont gyorsítótárazza a tulajdonságainak változásait, ezért a mögöttes terület [RID] azonosítóján a [NavigationServer2D] segítségével végzett módosítások nem jelennek meg automatikusan a csomópont tulajdonságaiban."

#. NavigationRegion2D.enabled
#: doc/classes/NavigationRegion2D.xml
msgid "Determines if the [NavigationRegion2D] is enabled or disabled."
msgstr "Meghatározza, hogy a [NavigationRegion2D] terület engedélyezve van-e."

#. NavigationRegion2D.enter_cost
#: doc/classes/NavigationRegion2D.xml
msgid "When pathfinding enters this region's navigation mesh from another regions navigation mesh the [member enter_cost] value is added to the path distance for determining the shortest path."
msgstr "Amikor az útkeresés egy másik terület navigációs hálójából erre a területre lép, a [member enter_cost] értékét hozzáadja az út hosszához a legrövidebb út meghatározásakor."

#. NavigationRegion2D.navigation_layers
#: doc/classes/NavigationRegion2D.xml
msgid "A bitfield determining all navigation layers the region belongs to. These navigation layers can be checked upon when requesting a path with [method NavigationServer2D.map_get_path]."
msgstr "Bitmező, amely meghatározza, hogy a terület mely navigációs rétegekhez tartozik. Ezek a rétegek a [method NavigationServer2D.map_get_path] metódussal történő útvonalkérésnél figyelembe vehetők."

#. NavigationRegion2D.navigation_polygon
#: doc/classes/NavigationRegion2D.xml
msgid "The [NavigationPolygon] resource to use."
msgstr "A használandó [NavigationPolygon] erőforrás."

#. NavigationRegion2D.travel_cost
#: doc/classes/NavigationRegion2D.xml
msgid "When pathfinding moves inside this region's navigation mesh the traveled distances are multiplied with [member travel_cost] for determining the shortest path."
msgstr "Amikor az útkeresés ezen a területen belül halad, a megtett távolságot a [member travel_cost] értékkel szorozza meg a legrövidebb út kiszámításához."

#. NavigationRegion2D.use_edge_connections
#: doc/classes/NavigationRegion2D.xml
msgid "If enabled the navigation region will use edge connections to connect with other navigation regions within proximity of the navigation map edge connection margin."
msgstr "Ha engedélyezett, a navigációs terület élkapcsolatokkal kapcsolódhat más közeli területekhez, a navigációs térkép élkapcsolati távolságán belül."

#. NavigationRegion2D.bake_navigation_polygon
#: doc/classes/NavigationRegion2D.xml
msgid "Bakes the [NavigationPolygon]. If [param on_thread] is set to [code]true[/code] (default), the baking is done on a separate thread."
msgstr "Kiszámítja és előállítja a [NavigationPolygon] navigációs sokszöget. Ha a [param on_thread] értéke [code]true[/code] (ez az alapértelmezés), a művelet külön szálon fut."

#. NavigationRegion2D.get_bounds
#: doc/classes/NavigationRegion2D.xml
msgid "Returns the axis-aligned rectangle for the region's transformed navigation mesh."
msgstr "Visszaadja a terület átalakított navigációs hálójának tengelyekkel párhuzamos határoló téglalapját."

#. NavigationRegion2D.get_navigation_layer_value
#. NavigationLink2D.get_navigation_layer_value
#: doc/classes/NavigationRegion2D.xml
#: doc/classes/NavigationLink2D.xml
msgid "Returns whether or not the specified layer of the [member navigation_layers] bitmask is enabled, given a [param layer_number] between 1 and 32."
msgstr "Visszaadja, hogy a [member navigation_layers] bitmaszk [param layer_number] sorszámú rétege engedélyezett-e (1 és 32 között)."

#. NavigationRegion2D.get_navigation_map
#: doc/classes/NavigationRegion2D.xml
msgid "Returns the current navigation map [RID] used by this region."
msgstr "Visszaadja a terület által jelenleg használt navigációs térkép [RID] azonosítóját."

#. NavigationRegion2D.get_region_rid
#: doc/classes/NavigationRegion2D.xml
msgid "Returns the [RID] of this region on the [NavigationServer2D]."
msgstr "Visszaadja ennek a területnek a [NavigationServer2D] rendszerbeli [RID] azonosítóját."

#. NavigationRegion2D.get_rid
#: doc/classes/NavigationRegion2D.xml
msgid "Returns the [RID] of this region on the [NavigationServer2D]. Combined with [method NavigationServer2D.map_get_closest_point_owner] can be used to identify the [NavigationRegion2D] closest to a point on the merged navigation map."
msgstr "Visszaadja ennek a területnek a [NavigationServer2D] rendszerbeli [RID] azonosítóját. A [method NavigationServer2D.map_get_closest_point_owner] metódussal együtt használva megállapítható, melyik [NavigationRegion2D] van legközelebb a navigációs térkép egy pontjához."

#. NavigationRegion2D.is_baking
#: doc/classes/NavigationRegion2D.xml
msgid "Returns [code]true[/code] when the [NavigationPolygon] is being baked on a background thread."
msgstr "[code]true[/code] értéket ad vissza, amíg a [NavigationPolygon] előállítása háttérszálon zajlik."

#. NavigationRegion2D.set_navigation_layer_value
#. NavigationLink2D.set_navigation_layer_value
#: doc/classes/NavigationRegion2D.xml
#: doc/classes/NavigationLink2D.xml
msgid "Based on [param value], enables or disables the specified layer in the [member navigation_layers] bitmask, given a [param layer_number] between 1 and 32."
msgstr "A [param value] alapján engedélyezi vagy letiltja a [member navigation_layers] bitmaszk [param layer_number] sorszámú rétegét (1 és 32 között)."

#. NavigationRegion2D.set_navigation_map
#: doc/classes/NavigationRegion2D.xml
msgid "Sets the [RID] of the navigation map this region should use. By default the region will automatically join the [World2D] default navigation map so this function is only required to override the default map."
msgstr "Beállítja a navigációs térkép [RID] azonosítóját, amelyet a terület használjon. Alapértelmezés szerint a terület automatikusan csatlakozik a [World2D] alapértelmezett navigációs térképéhez, ezért ezt a metódust csak az alapértelmezés felülírásakor kell használni."

#. StaticBody2D.brief
#: doc/classes/StaticBody2D.xml
msgid "A 2D physics body that can't be moved by external forces. When moved manually, it doesn't affect other bodies in its path."
msgstr "2D-s fizikai test, amelyet külső erők nem tudnak elmozdítani. Közvetlen áthelyezésekor nem mozgatja magával az útjába eső más testeket."

#. StaticBody2D.description
#: doc/classes/StaticBody2D.xml
msgid "A static 2D physics body. It can't be moved by external forces or contacts, but can be moved manually by other means such as code, [AnimationMixer]s (with [member AnimationMixer.callback_mode_process] set to [constant AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]), and [RemoteTransform2D].\nWhen [StaticBody2D] is moved, it is teleported to its new position without affecting other physics bodies in its path. If this is not desired, use [AnimatableBody2D] instead.\n[StaticBody2D] is useful for completely static objects like floors and walls, as well as moving surfaces like conveyor belts and circular revolving platforms (by using [member constant_linear_velocity] and [member constant_angular_velocity])."
msgstr "Statikus 2D-s fizikai test. Külső erők és érintkezések nem mozdítják el, de kézzel is mozgatható, például kóddal, [AnimationMixer] csomópontokkal (ha a [member AnimationMixer.callback_mode_process] értéke [constant AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]), illetve [RemoteTransform2D] segítségével.\nA [StaticBody2D] mozgatáskor az új pozíciójára teleportálódik, anélkül hogy az útjába eső más fizikai testekre hatna. Ha ez nem kívánatos, használj helyette [AnimatableBody2D] csomópontot.\nA [StaticBody2D] teljesen mozdulatlan tárgyakhoz, például padlókhoz és falakhoz, valamint mozgó felületekhez, például futószalagokhoz és forgó platformokhoz hasznos (a [member constant_linear_velocity] és [member constant_angular_velocity] használatával)."

#. StaticBody2D.constant_angular_velocity
#: doc/classes/StaticBody2D.xml
msgid "The body's constant angular velocity. This does not rotate the body, but affects touching bodies, as if it were rotating."
msgstr "A test állandó szögsebessége. Ez nem forgatja el magát a testet, de úgy hat az érintkező testekre, mintha forogna."

#. StaticBody2D.constant_linear_velocity
#: doc/classes/StaticBody2D.xml
msgid "The body's constant linear velocity. This does not move the body, but affects touching bodies, as if it were moving."
msgstr "A test állandó lineáris sebessége. Ez nem mozgatja el magát a testet, de úgy hat az érintkező testekre, mintha mozogna."

#. StaticBody2D.physics_material_override
#: doc/classes/StaticBody2D.xml
msgid "The physics material override for the body.\nIf a material is assigned to this property, it will be used instead of any other physics material, such as an inherited one."
msgstr "A testhez rendelt fizikai anyag felülbírálása.\nHa ehhez a tulajdonsághoz anyag van rendelve, az örökölt vagy bármely más fizikai anyag helyett ezt használja."

#. AnimationNodeStateMachine.brief
#: doc/classes/AnimationNodeStateMachine.xml
msgid "A state machine with multiple [AnimationRootNode]s, used by [AnimationTree]."
msgstr "Több [AnimationRootNode] csomópontból álló állapotgép, amelyet az [AnimationTree] használ."

#. AnimationNodeStateMachine.description
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Contains multiple [AnimationRootNode]s representing animation states, connected in a graph. State transitions can be configured to happen automatically or via code, using a shortest-path algorithm. Retrieve the [AnimationNodeStateMachinePlayback] object from the [AnimationTree] node to control it programmatically.\n[codeblocks]\n[gdscript]\nvar state_machine = $AnimationTree.get(\"parameters/playback\")\nstate_machine.travel(\"some_state\")\n[/gdscript]\n[csharp]\nvar stateMachine = GetNode&lt;AnimationTree&gt;(\"AnimationTree\").Get(\"parameters/playback\") as AnimationNodeStateMachinePlayback;\nstateMachine.Travel(\"some_state\");\n[/csharp]\n[/codeblocks]"
msgstr "Állapotgépként működő gráf, amely az animációs állapotokat képviselő több [AnimationRootNode] csomópontot tartalmaz. Az állapotok közötti átmenetek történhetnek automatikusan vagy kódból, egy legrövidebb útvonalat kereső algoritmussal. A programból történő vezérléshez kérd le az [AnimationNodeStateMachinePlayback] objektumot az [AnimationTree] csomópontból.\n[codeblocks]\n[gdscript]\nvar state_machine = $AnimationTree.get(\"parameters/playback\")\nstate_machine.travel(\"some_state\")\n[/gdscript]\n[csharp]\nvar stateMachine = GetNode&lt;AnimationTree&gt;(\"AnimationTree\").Get(\"parameters/playback\") as AnimationNodeStateMachinePlayback;\nstateMachine.Travel(\"some_state\");\n[/csharp]\n[/codeblocks]"

#. AnimationNodeStateMachine.allow_transition_to_self
#: doc/classes/AnimationNodeStateMachine.xml
msgid "If [code]true[/code], allows teleport to the self state with [method AnimationNodeStateMachinePlayback.travel]. When the reset option is enabled in [method AnimationNodeStateMachinePlayback.travel], the animation is restarted. If [code]false[/code], nothing happens on the teleportation to the self state."
msgstr "Ha [code]true[/code], a [method AnimationNodeStateMachinePlayback.travel] segítségével engedélyezett az aktuális állapotba történő visszalépés. Ha a [method AnimationNodeStateMachinePlayback.travel] reset opciója be van kapcsolva, az animáció újraindul. Ha [code]false[/code], az aktuális állapotba történő visszalépésnek nincs hatása."

#. AnimationNodeStateMachine.reset_ends
#: doc/classes/AnimationNodeStateMachine.xml
msgid "If [code]true[/code], treat the cross-fade to the start and end nodes as a blend with the RESET animation.\nIn most cases, when additional cross-fades are performed in the parent [AnimationNode] of the state machine, setting this property to [code]false[/code] and matching the cross-fade time of the parent [AnimationNode] and the state machine's start node and end node gives good results."
msgstr "Ha [code]true[/code], a kezdő- és végállapotba történő áttűnést a RESET animációval való keverésként kezeli.\nA legtöbb esetben, ha az állapotgép szülő [AnimationNode] csomópontja további áttűnéseket hajt végre, jó eredményt ad, ha ezt a tulajdonságot [code]false[/code] értékre állítod, és összehangolod a szülő [AnimationNode] áttűnési idejét az állapotgép kezdő- és végcsomópontjának áttűnési idejével."

#. AnimationNodeStateMachine.state_machine_type
#: doc/classes/AnimationNodeStateMachine.xml
msgid "This property can define the process of transitions for different use cases. See also [enum AnimationNodeStateMachine.StateMachineType]."
msgstr "Ez a tulajdonság különböző felhasználási módokhoz határozza meg az állapotátmenetek feldolgozását. Lásd még: [enum AnimationNodeStateMachine.StateMachineType]."

#. AnimationNodeStateMachine.add_node
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Adds a new animation node to the graph. The [param position] is used for display in the editor."
msgstr "Új animációs csomópontot ad a gráfhoz. A [param position] a szerkesztőbeli megjelenítéshez használt pozíció."

#. AnimationNodeStateMachine.add_transition
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Adds a transition between the given animation nodes."
msgstr "Átmenetet ad hozzá a megadott animációs csomópontok között."

#. AnimationNodeStateMachine.get_graph_offset
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns the draw offset of the graph. Used for display in the editor."
msgstr "Visszaadja a gráf kirajzolási eltolását. A szerkesztőbeli megjelenítéshez használatos."

#. AnimationNodeStateMachine.get_node
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns the animation node with the given name."
msgstr "Visszaadja a megadott nevű animációs csomópontot."

#. AnimationNodeStateMachine.get_node_list
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns a list containing the names of all animation nodes in this state machine."
msgstr "Visszaad egy listát az állapotgépben található összes animációs csomópont nevével."

#. AnimationNodeStateMachine.get_node_name
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns the given animation node's name."
msgstr "Visszaadja a megadott animációs csomópont nevét."

#. AnimationNodeStateMachine.get_node_position
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns the given animation node's coordinates. Used for display in the editor."
msgstr "Visszaadja a megadott animációs csomópont koordinátáit. A szerkesztőbeli megjelenítéshez használatos."

#. AnimationNodeStateMachine.get_transition
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns the given transition."
msgstr "Visszaadja a megadott átmenetet."

#. AnimationNodeStateMachine.get_transition_count
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns the number of connections in the graph."
msgstr "Visszaadja a gráfban található kapcsolatok számát."

#. AnimationNodeStateMachine.get_transition_from
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns the given transition's start node."
msgstr "Visszaadja a megadott átmenet kiinduló csomópontját."

#. AnimationNodeStateMachine.get_transition_to
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns the given transition's end node."
msgstr "Visszaadja a megadott átmenet célcsomópontját."

#. AnimationNodeStateMachine.has_node
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns [code]true[/code] if the graph contains the given animation node."
msgstr "[code]true[/code] értéket ad vissza, ha a gráf tartalmazza a megadott animációs csomópontot."

#. AnimationNodeStateMachine.has_transition
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Returns [code]true[/code] if there is a transition between the given animation nodes."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott animációs csomópontok között létezik átmenet."

#. AnimationNodeStateMachine.remove_node
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Deletes the given animation node from the graph."
msgstr "Eltávolítja a megadott animációs csomópontot a gráfból."

#. AnimationNodeStateMachine.remove_transition
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Deletes the transition between the two specified animation nodes."
msgstr "Eltávolítja a megadott két animációs csomópont közötti átmenetet."

#. AnimationNodeStateMachine.remove_transition_by_index
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Deletes the given transition by index."
msgstr "Eltávolítja a megadott indexű átmenetet."

#. AnimationNodeStateMachine.rename_node
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Renames the given animation node."
msgstr "Átnevezi a megadott animációs csomópontot."

#. AnimationNodeStateMachine.replace_node
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Replaces the given animation node with a new animation node."
msgstr "A megadott animációs csomópontot új animációs csomópontra cseréli."

#. AnimationNodeStateMachine.set_graph_offset
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Sets the draw offset of the graph. Used for display in the editor."
msgstr "Beállítja a gráf kirajzolási eltolását. A szerkesztőbeli megjelenítéshez használatos."

#. AnimationNodeStateMachine.set_node_position
#: doc/classes/AnimationNodeStateMachine.xml
msgid "Sets the animation node's coordinates. Used for display in the editor."
msgstr "Beállítja az animációs csomópont koordinátáit. A szerkesztőbeli megjelenítéshez használatos."

#. NavigationPolygon.brief
#: doc/classes/NavigationPolygon.xml
msgid "A 2D navigation mesh that describes a traversable surface for pathfinding."
msgstr "2D-s navigációs háló, amely az útkereséshez használható bejárható felületet írja le."

#. NavigationPolygon.description
#: doc/classes/NavigationPolygon.xml
msgid "A navigation mesh can be created either by baking it with the help of the [NavigationServer2D], or by adding vertices and convex polygon indices arrays manually.\nTo bake a navigation mesh at least one outline needs to be added that defines the outer bounds of the baked area.\n[codeblocks]\n[gdscript]\nvar new_navigation_mesh = NavigationPolygon.new()\nvar bounding_outline = PackedVector2Array([Vector2(0, 0), Vector2(0, 50), Vector2(50, 50), Vector2(50, 0)])\nnew_navigation_mesh.add_outline(bounding_outline)\nNavigationServer2D.bake_from_source_geometry_data(new_navigation_mesh, NavigationMeshSourceGeometryData2D.new());\n$NavigationRegion2D.navigation_polygon = new_navigation_mesh\n[/gdscript]\n[csharp]\nvar newNavigationMesh = new NavigationPolygon();\nVector2[] boundingOutline = [new Vector2(0, 0), new Vector2(0, 50), new Vector2(50, 50), new Vector2(50, 0)];\nnewNavigationMesh.AddOutline(boundingOutline);\nNavigationServer2D.BakeFromSourceGeometryData(newNavigationMesh, new NavigationMeshSourceGeometryData2D());\nGetNode&lt;NavigationRegion2D&gt;(\"NavigationRegion2D\").NavigationPolygon = newNavigationMesh;\n[/csharp]\n[/codeblocks]\nAdding vertices and polygon indices manually.\n[codeblocks]\n[gdscript]\nvar new_navigation_mesh = NavigationPolygon.new()\nvar new_vertices = PackedVector2Array([Vector2(0, 0), Vector2(0, 50), Vector2(50, 50), Vector2(50, 0)])\nnew_navigation_mesh.vertices = new_vertices\nvar new_polygon_indices = PackedInt32Array([0, 1, 2, 3])\nnew_navigation_mesh.add_polygon(new_polygon_indices)\n$NavigationRegion2D.navigation_polygon = new_navigation_mesh\n[/gdscript]\n[csharp]\nvar newNavigationMesh = new NavigationPolygon();\nVector2[] newVertices = [new Vector2(0, 0), new Vector2(0, 50), new Vector2(50, 50), new Vector2(50, 0)];\nnewNavigationMesh.Vertices = newVertices;\nint[] newPolygonIndices = [0, 1, 2, 3];\nnewNavigationMesh.AddPolygon(newPolygonIndices);\nGetNode&lt;NavigationRegion2D&gt;(\"NavigationRegion2D\").NavigationPolygon = newNavigationMesh;\n[/csharp]\n[/codeblocks]"
msgstr "A navigációs háló létrehozható a [NavigationServer2D] segítségével végzett előállítással, vagy csúcsok és konvex sokszögek indexeit tartalmazó tömbök kézi megadásával.\nA navigációs háló előállításához legalább egy körvonalat hozzá kell adni, amely meghatározza az előállított terület külső határait.\n[codeblocks]\n[gdscript]\nvar new_navigation_mesh = NavigationPolygon.new()\nvar bounding_outline = PackedVector2Array([Vector2(0, 0), Vector2(0, 50), Vector2(50, 50), Vector2(50, 0)])\nnew_navigation_mesh.add_outline(bounding_outline)\nNavigationServer2D.bake_from_source_geometry_data(new_navigation_mesh, NavigationMeshSourceGeometryData2D.new());\n$NavigationRegion2D.navigation_polygon = new_navigation_mesh\n[/gdscript]\n[csharp]\nvar newNavigationMesh = new NavigationPolygon();\nVector2[] boundingOutline = [new Vector2(0, 0), new Vector2(0, 50), new Vector2(50, 50), new Vector2(50, 0)];\nnewNavigationMesh.AddOutline(boundingOutline);\nNavigationServer2D.BakeFromSourceGeometryData(newNavigationMesh, new NavigationMeshSourceGeometryData2D());\nGetNode&lt;NavigationRegion2D&gt;(\"NavigationRegion2D\").NavigationPolygon = newNavigationMesh;\n[/csharp]\n[/codeblocks]\nCsúcsok és sokszögindexek kézi hozzáadása.\n[codeblocks]\n[gdscript]\nvar new_navigation_mesh = NavigationPolygon.new()\nvar new_vertices = PackedVector2Array([Vector2(0, 0), Vector2(0, 50), Vector2(50, 50), Vector2(50, 0)])\nnew_navigation_mesh.vertices = new_vertices\nvar new_polygon_indices = PackedInt32Array([0, 1, 2, 3])\nnew_navigation_mesh.add_polygon(new_polygon_indices)\n$NavigationRegion2D.navigation_polygon = new_navigation_mesh\n[/gdscript]\n[csharp]\nvar newNavigationMesh = new NavigationPolygon();\nVector2[] newVertices = [new Vector2(0, 0), new Vector2(0, 50), new Vector2(50, 50), new Vector2(50, 0)];\nnewNavigationMesh.Vertices = newVertices;\nint[] newPolygonIndices = [0, 1, 2, 3];\nnewNavigationMesh.AddPolygon(newPolygonIndices);\nGetNode&lt;NavigationRegion2D&gt;(\"NavigationRegion2D\").NavigationPolygon = newNavigationMesh;\n[/csharp]\n[/codeblocks]"

#. NavigationPolygon.agent_radius
#: doc/classes/NavigationPolygon.xml
msgid "The distance to erode/shrink the walkable surface when baking the navigation mesh.\n[b]Note:[/b] The radius must be equal or higher than [code]0.0[/code]. If the radius is [code]0.0[/code], it won't be possible to fix invalid outline overlaps and other precision errors during the baking process. As a result, some obstacles may be excluded incorrectly from the final navigation mesh, or may delete the navigation mesh's polygons."
msgstr "Az a távolság, amellyel a navigációs háló előállításakor csökkenteni kell a bejárható felületet.\n[b]Megjegyzés:[/b] A sugárnak legalább [code]0.0[/code] értékűnek kell lennie. Ha [code]0.0[/code], az előállítás során nem javíthatók ki az érvénytelen körvonal-átfedések és más pontossági hibák. Emiatt egyes akadályok hibásan kimaradhatnak a végleges navigációs hálóból, vagy akár annak sokszögeit is eltávolíthatják."

#. NavigationPolygon.baking_rect
#: doc/classes/NavigationPolygon.xml
msgid "If the baking [Rect2] has an area the navigation mesh baking will be restricted to its enclosing area."
msgstr "Ha az előállítási [Rect2] téglalapnak van területe, a navigációs háló előállítása az általa körülhatárolt területre korlátozódik."

#. NavigationPolygon.baking_rect_offset
#: doc/classes/NavigationPolygon.xml
msgid "The position offset applied to the [member baking_rect] [Rect2]."
msgstr "A [member baking_rect] [Rect2] téglalapra alkalmazott pozícióeltolás."

#. NavigationPolygon.border_size
#: doc/classes/NavigationPolygon.xml
msgid "The size of the non-navigable border around the bake bounding area defined by the [member baking_rect] [Rect2].\nIn conjunction with the [member baking_rect] the border size can be used to bake tile aligned navigation meshes without the tile edges being shrunk by [member agent_radius]."
msgstr "A navigációs háló előállításának [member baking_rect] [Rect2] téglalap által meghatározott határa körül elhelyezkedő, nem bejárható szegély mérete.\nA [member baking_rect] tulajdonsággal együtt használva olyan, csempékhez igazodó navigációs hálók is előállíthatók, amelyek csempeszéleit a [member agent_radius] nem csökkenti."

#. NavigationPolygon.cell_size
#: doc/classes/NavigationPolygon.xml
msgid "The cell size used to rasterize the navigation mesh vertices. Must match with the cell size on the navigation map."
msgstr "A navigációs háló csúcsainak raszterezéséhez használt cellaméret. Egyeznie kell a navigációs térkép cellaméretével."

#. NavigationPolygon.parsed_collision_mask
#: doc/classes/NavigationPolygon.xml
msgid "The physics layers to scan for static colliders.\nOnly used when [member parsed_geometry_type] is [constant PARSED_GEOMETRY_STATIC_COLLIDERS] or [constant PARSED_GEOMETRY_BOTH]."
msgstr "A statikus ütközési objektumok keresésekor vizsgált fizikai rétegek.\nCsak akkor használatos, ha a [member parsed_geometry_type] értéke [constant PARSED_GEOMETRY_STATIC_COLLIDERS] vagy [constant PARSED_GEOMETRY_BOTH]."

#. NavigationPolygon.parsed_geometry_type
#: doc/classes/NavigationPolygon.xml
msgid "Determines which type of nodes will be parsed as geometry."
msgstr "Meghatározza, hogy milyen típusú csomópontokat dolgozzon fel a rendszer geometriaként."

#. NavigationPolygon.sample_partition_type
#: doc/classes/NavigationPolygon.xml
msgid "Partitioning algorithm for creating the navigation mesh polys."
msgstr "A navigációs háló sokszögeinek létrehozásához használt felosztási algoritmus."

#. NavigationPolygon.source_geometry_group_name
#: doc/classes/NavigationPolygon.xml
msgid "The group name of nodes that should be parsed for baking source geometry.\nOnly used when [member source_geometry_mode] is [constant SOURCE_GEOMETRY_GROUPS_WITH_CHILDREN] or [constant SOURCE_GEOMETRY_GROUPS_EXPLICIT]."
msgstr "Azon csomópontcsoport neve, amelynek tagjait a rendszer feldolgozza a navigációs geometria előállításakor.\nCsak akkor használatos, ha a [member source_geometry_mode] értéke [constant SOURCE_GEOMETRY_GROUPS_WITH_CHILDREN] vagy [constant SOURCE_GEOMETRY_GROUPS_EXPLICIT]."

#. NavigationPolygon.source_geometry_mode
#: doc/classes/NavigationPolygon.xml
msgid "The source of the geometry used when baking."
msgstr "A navigációs háló előállításakor használt geometria forrása."

#. NavigationPolygon.add_outline
#: doc/classes/NavigationPolygon.xml
msgid "Appends a [PackedVector2Array] that contains the vertices of an outline to the internal array that contains all the outlines."
msgstr "Hozzáfűz egy körvonal csúcsait tartalmazó [PackedVector2Array] tömböt az összes körvonalat tároló belső tömbhöz."

#. NavigationPolygon.add_outline_at_index
#: doc/classes/NavigationPolygon.xml
msgid "Adds a [PackedVector2Array] that contains the vertices of an outline to the internal array that contains all the outlines at a fixed position."
msgstr "A megadott pozícióra beszúr egy körvonal csúcsait tartalmazó [PackedVector2Array] tömböt az összes körvonalat tároló belső tömbbe."

#. NavigationPolygon.add_polygon
#: doc/classes/NavigationPolygon.xml
msgid "Adds a polygon using the indices of the vertices you get when calling [method get_vertices]."
msgstr "Sokszöget ad hozzá a [method get_vertices] hívással lekérhető csúcsok indexeinek felhasználásával."

#. NavigationPolygon.clear
#: doc/classes/NavigationPolygon.xml
msgid "Clears the internal arrays for vertices and polygon indices."
msgstr "Törli a csúcsokat és a sokszögindexeket tároló belső tömböket."

#. NavigationPolygon.clear_outlines
#: doc/classes/NavigationPolygon.xml
msgid "Clears the array of the outlines, but it doesn't clear the vertices and the polygons that were created by them."
msgstr "Törli a körvonalak tömbjét, de nem törli az azok alapján létrehozott csúcsokat és sokszögeket."

#. NavigationPolygon.clear_polygons
#: doc/classes/NavigationPolygon.xml
msgid "Clears the array of polygons, but it doesn't clear the array of outlines and vertices."
msgstr "Törli a sokszögek tömbjét, de a körvonalak és csúcsok tömbjét nem."

#. NavigationPolygon.get_navigation_mesh
#: doc/classes/NavigationPolygon.xml
msgid "Returns the [NavigationMesh] resulting from this navigation polygon. This navigation mesh can be used to update the navigation mesh of a region with the [method NavigationServer3D.region_set_navigation_mesh] API directly."
msgstr "Visszaadja az ebből a navigációs sokszögből létrejövő [NavigationMesh] objektumot. A [method NavigationServer3D.region_set_navigation_mesh] API segítségével ez közvetlenül felhasználható egy terület navigációs hálójának frissítésére."

#. NavigationPolygon.get_outline
#: doc/classes/NavigationPolygon.xml
msgid "Returns a [PackedVector2Array] containing the vertices of an outline that was created in the editor or by script."
msgstr "Visszaadja a szerkesztőben vagy scriptből létrehozott körvonal csúcsait tartalmazó [PackedVector2Array] tömböt."

#. NavigationPolygon.get_outline_count
#: doc/classes/NavigationPolygon.xml
msgid "Returns the number of outlines that were created in the editor or by script."
msgstr "Visszaadja a szerkesztőben vagy scriptből létrehozott körvonalak számát."

#. NavigationPolygon.get_parsed_collision_mask_value
#: doc/classes/NavigationPolygon.xml
msgid "Returns whether or not the specified layer of the [member parsed_collision_mask] is enabled, given a [param layer_number] between 1 and 32."
msgstr "Visszaadja, hogy a [member parsed_collision_mask] maszk [param layer_number] számú rétege engedélyezett-e (1 és 32 között)."

#. NavigationPolygon.get_polygon
#: doc/classes/NavigationPolygon.xml
msgid "Returns a [PackedInt32Array] containing the indices of the vertices of a created polygon."
msgstr "Visszaad egy [PackedInt32Array] tömböt, amely a létrehozott sokszög csúcsainak indexeit tartalmazza."

#. NavigationPolygon.get_polygon_count
#: doc/classes/NavigationPolygon.xml
msgid "Returns the count of all polygons."
msgstr "Visszaadja az összes sokszög számát."

#. NavigationPolygon.get_vertices
#: doc/classes/NavigationPolygon.xml
msgid "Returns a [PackedVector2Array] containing all the vertices being used to create the polygons."
msgstr "Visszaad egy [PackedVector2Array] tömböt, amely a sokszögek létrehozásához használt összes csúcsot tartalmazza."

#. NavigationPolygon.make_polygons_from_outlines
#: doc/classes/NavigationPolygon.xml
msgid "Creates polygons from the outlines added in the editor or by script."
msgstr "Sokszögeket hoz létre a szerkesztőben vagy scriptből hozzáadott körvonalak alapján."

#. NavigationPolygon.remove_outline
#: doc/classes/NavigationPolygon.xml
msgid "Removes an outline created in the editor or by script. You have to call [method make_polygons_from_outlines] for the polygons to update."
msgstr "Eltávolít egy, a szerkesztőben vagy scriptből létrehozott körvonalat. A sokszögek frissítéséhez meg kell hívni a [method make_polygons_from_outlines] metódust."

#. NavigationPolygon.set_outline
#: doc/classes/NavigationPolygon.xml
msgid "Changes an outline created in the editor or by script. You have to call [method make_polygons_from_outlines] for the polygons to update."
msgstr "Módosít egy, a szerkesztőben vagy scriptből létrehozott körvonalat. A sokszögek frissítéséhez meg kell hívni a [method make_polygons_from_outlines] metódust."

#. NavigationPolygon.set_parsed_collision_mask_value
#: doc/classes/NavigationPolygon.xml
msgid "Based on [param value], enables or disables the specified layer in the [member parsed_collision_mask], given a [param layer_number] between 1 and 32."
msgstr "A [param value] értéktől függően engedélyezi vagy letiltja a [member parsed_collision_mask] maszk [param layer_number] számú rétegét (1 és 32 között)."

#. NavigationPolygon.set_vertices
#: doc/classes/NavigationPolygon.xml
msgid "Sets the vertices that can be then indexed to create polygons with the [method add_polygon] method."
msgstr "Beállítja azokat a csúcsokat, amelyek indexei alapján a [method add_polygon] metódussal sokszögek hozhatók létre."

#. TileMapPattern.brief
#: doc/classes/TileMapPattern.xml
msgid "Holds a pattern to be copied from or pasted into [TileMap]s."
msgstr "Olyan csempemintát tárol, amelyet [TileMap] térképekből lehet másolni, vagy azokba beilleszteni."

#. TileMapPattern.description
#: doc/classes/TileMapPattern.xml
msgid "This resource holds a set of cells to help bulk manipulations of [TileMap].\nA pattern always starts at the [code](0, 0)[/code] coordinates and cannot have cells with negative coordinates."
msgstr "Ez az erőforrás cellák csoportját tárolja, hogy megkönnyítse a [TileMap] több celláját érintő műveleteket.\nEgy minta mindig a [code](0, 0)[/code] koordinátáknál kezdődik, és nem tartalmazhat negatív koordinátájú cellát."

#. TileMapPattern.get_cell_alternative_tile
#: doc/classes/TileMapPattern.xml
msgid "Returns the tile alternative ID of the cell at [param coords]."
msgstr "Visszaadja a [param coords] koordinátáknál lévő cella alternatív csempeazonosítóját."

#. TileMapPattern.get_cell_atlas_coords
#: doc/classes/TileMapPattern.xml
msgid "Returns the tile atlas coordinates ID of the cell at [param coords]."
msgstr "Visszaadja a [param coords] koordinátáknál lévő cella atlaszkoordináta-azonosítóját."

#. TileMapPattern.get_cell_source_id
#: doc/classes/TileMapPattern.xml
msgid "Returns the tile source ID of the cell at [param coords]."
msgstr "Visszaadja a [param coords] koordinátáknál lévő cella csempeforrás-azonosítóját."

#. TileMapPattern.get_size
#: doc/classes/TileMapPattern.xml
msgid "Returns the size, in cells, of the pattern."
msgstr "Visszaadja a minta méretét cellákban."

#. TileMapPattern.get_used_cells
#: doc/classes/TileMapPattern.xml
msgid "Returns the list of used cell coordinates in the pattern."
msgstr "Visszaadja a mintában használt cellák koordinátáinak listáját."

#. TileMapPattern.has_cell
#: doc/classes/TileMapPattern.xml
msgid "Returns whether the pattern has a tile at the given coordinates."
msgstr "Megadja, hogy a minta tartalmaz-e csempét a megadott koordinátáknál."

#. TileMapPattern.is_empty
#: doc/classes/TileMapPattern.xml
msgid "Returns whether the pattern is empty or not."
msgstr "Megadja, hogy a minta üres-e."

#. TileMapPattern.remove_cell
#: doc/classes/TileMapPattern.xml
msgid "Remove the cell at the given coordinates."
msgstr "Eltávolítja a megadott koordinátáknál található cellát."

#. TileMapPattern.set_cell
#: doc/classes/TileMapPattern.xml
msgid "Sets the tile identifiers for the cell at coordinates [param coords]. See [method TileMap.set_cell]."
msgstr "Beállítja a [param coords] koordinátáknál lévő cella csempeazonosítóit. Lásd: [method TileMap.set_cell]."

#. TileMapPattern.set_size
#: doc/classes/TileMapPattern.xml
msgid "Sets the size of the pattern."
msgstr "Beállítja a minta méretét."

#. NavigationServer2D.brief
#: doc/classes/NavigationServer2D.xml
msgid "A server interface for low-level 2D navigation access."
msgstr "Alacsony szintű 2D-s navigációs műveletekhez használható kiszolgálófelület."

#. NavigationServer2D.map_create
#: doc/classes/NavigationServer2D.xml
msgid "Create a new map."
msgstr "Új navigációs térképet hoz létre."

#. NavigationServer2D.map_set_active
#: doc/classes/NavigationServer2D.xml
msgid "Sets the map active."
msgstr "Aktívvá teszi a navigációs térképet."

#. NavigationServer2D.map_get_path
#: doc/classes/NavigationServer2D.xml
msgid "Returns the navigation path to reach the destination from the origin. [param navigation_layers] is a bitmask of all region navigation layers that are allowed to be in the path."
msgstr "Visszaadja a kiindulóponttól a célpontig vezető navigációs útvonalat. A [param navigation_layers] bitmaszk adja meg, hogy mely navigációs területi rétegeken haladhat az útvonal."

#. NavigationServer2D.map_get_closest_point
#: doc/classes/NavigationServer2D.xml
msgid "Returns the navigation mesh surface point closest to the provided [param to_point] on the navigation [param map]."
msgstr "Visszaadja a navigációs háló felületének azt a pontját, amely a legközelebb van a megadott [param to_point] ponthoz a [param map] navigációs térképen."

#. NavigationServer2D.map_get_closest_point_owner
#: doc/classes/NavigationServer2D.xml
msgid "Returns the owner region RID for the navigation mesh surface point closest to the provided [param to_point] on the navigation [param map]."
msgstr "Visszaadja annak a navigációs területnek az RID-azonosítóját, amelyhez a [param map] térképen a [param to_point] ponthoz legközelebbi navigációs hálópont tartozik."

#. NavigationServer2D.map_get_regions
#: doc/classes/NavigationServer2D.xml
msgid "Returns all navigation regions [RID]s that are currently assigned to the requested navigation [param map]."
msgstr "Visszaadja a [param map] navigációs térképhez jelenleg hozzárendelt összes navigációs terület [RID] azonosítóját."

#. NavigationServer2D.map_get_agents
#: doc/classes/NavigationServer2D.xml
msgid "Returns all navigation agents [RID]s that are currently assigned to the requested navigation [param map]."
msgstr "Visszaadja a [param map] navigációs térképhez jelenleg hozzárendelt összes navigációs ügynök [RID] azonosítóját."

#. NavigationServer2D.region_create
#: doc/classes/NavigationServer2D.xml
msgid "Creates a new region."
msgstr "Új navigációs területet hoz létre."

#. NavigationServer2D.region_set_map
#: doc/classes/NavigationServer2D.xml
msgid "Sets the map for the region."
msgstr "Beállítja a területhez tartozó navigációs térképet."

#. NavigationServer2D.region_set_navigation_polygon
#: doc/classes/NavigationServer2D.xml
msgid "Sets the [param navigation_polygon] for the region."
msgstr "Beállítja a terület [param navigation_polygon] navigációs sokszögét."

#. NavigationServer2D.region_set_enabled
#: doc/classes/NavigationServer2D.xml
msgid "If [param enabled] is [code]true[/code] the specified [param region] will contribute to its current navigation map."
msgstr "Ha a [param enabled] értéke [code]true[/code], a megadott [param region] részt vesz a jelenlegi navigációs térképe útvonalszámításában."

#. NavigationServer2D.agent_create
#: doc/classes/NavigationServer2D.xml
msgid "Creates the agent."
msgstr "Új navigációs ügynököt hoz létre."

#. NavigationServer2D.agent_set_map
#: doc/classes/NavigationServer2D.xml
msgid "Puts the agent in the map."
msgstr "Hozzárendeli az ügynököt a navigációs térképhez."

#. NavigationServer2D.agent_set_position
#: doc/classes/NavigationServer2D.xml
msgid "Sets the position of the agent in world space."
msgstr "Beállítja az ügynök pozícióját világkoordinátákban."

#. NavigationServer2D.agent_set_velocity
#: doc/classes/NavigationServer2D.xml
msgid "Sets [param velocity] as the new wanted velocity for the specified [param agent]. The avoidance simulation will try to fulfill this velocity if possible but will modify it to avoid collision with other agent's and obstacles. When an agent is teleported to a new position far away use [method agent_set_velocity_forced] instead to reset the internal velocity state."
msgstr "A [param velocity] értéket állítja be a megadott [param agent] kívánt új sebességeként. Az akadályelkerülési szimuláció lehetőség szerint ezt a sebességet használja, de a többi ügynökkel és akadállyal való ütközések elkerüléséhez módosíthatja. Ha az ügynököt messzebbre teleportálod, a belső sebességállapot visszaállításához inkább a [method agent_set_velocity_forced] metódust használd."

#. NavigationServer2D.agent_set_avoidance_enabled
#: doc/classes/NavigationServer2D.xml
msgid "If [param enabled] is [code]true[/code], the specified [param agent] uses avoidance."
msgstr "Ha a [param enabled] értéke [code]true[/code], a megadott [param agent] használja az akadályelkerülést."

#. NavigationServer2D.agent_set_avoidance_callback
#: doc/classes/NavigationServer2D.xml
msgid "Sets the callback [Callable] that gets called after each avoidance processing step for the [param agent]. The calculated [code]safe_velocity[/code] will be dispatched with a signal to the object just before the physics calculations.\n[b]Note:[/b] Created callbacks are always processed independently of the SceneTree state as long as the agent is on a navigation map and not freed. To disable the dispatch of a callback from an agent use [method agent_set_avoidance_callback] again with an empty [Callable]."
msgstr "Beállítja azt a [Callable] visszahívást, amely az ügynök minden akadályelkerülési feldolgozási lépése után fut le a [param agent] számára. A kiszámított [code]safe_velocity[/code] értéket a fizikai számítások előtt jelzésen keresztül kapja meg az objektum.\n[b]Megjegyzés:[/b] A létrehozott visszahívások a SceneTree állapotától függetlenül futnak, amíg az ügynök navigációs térképhez tartozik és nincs felszabadítva. A visszahívás letiltásához hívd meg ismét a [method agent_set_avoidance_callback] metódust üres [Callable] paraméterrel."

#. NavigationServer2D.agent_get_map
#: doc/classes/NavigationServer2D.xml
msgid "Returns the navigation map [RID] the requested [param agent] is currently assigned to."
msgstr "Visszaadja annak a navigációs térképnek az [RID] azonosítóját, amelyhez a megadott [param agent] jelenleg tartozik."

#. NavigationServer2D.obstacle_create
#: doc/classes/NavigationServer2D.xml
msgid "Creates a new navigation obstacle."
msgstr "Új navigációs akadályt hoz létre."

#. NavigationServer2D.obstacle_set_map
#: doc/classes/NavigationServer2D.xml
msgid "Sets the navigation map [RID] for the obstacle."
msgstr "Beállítja az akadály navigációs térképének [RID] azonosítóját."

#. NavigationServer2D.obstacle_set_position
#: doc/classes/NavigationServer2D.xml
msgid "Sets the position of the obstacle in world space."
msgstr "Beállítja az akadály pozícióját világkoordinátákban."

#. NavigationServer2D.obstacle_set_radius
#: doc/classes/NavigationServer2D.xml
msgid "Sets the radius of the dynamic obstacle."
msgstr "Beállítja a mozgó akadály sugarát."

#. NavigationServer2D.bake_from_source_geometry_data
#: doc/classes/NavigationServer2D.xml
msgid "Bakes the provided [param navigation_polygon] with the data from the provided [param source_geometry_data]. After the process is finished the optional [param callback] will be called."
msgstr "A [param navigation_polygon] navigációs sokszöget a megadott [param source_geometry_data] forrásgeometria adataiból állítja elő. A művelet befejezése után meghívja az opcionális [param callback] visszahívást."

#. NavigationServer2D.query_path
#: doc/classes/NavigationServer2D.xml
msgid "Queries a path in a given navigation map. Start and target position and other parameters are defined through [NavigationPathQueryParameters2D]. Updates the provided [NavigationPathQueryResult2D] result object with the path among other results requested by the query. After the process is finished the optional [param callback] will be called."
msgstr "Útvonalat kér le a megadott navigációs térképen. A kiindulópontot, a célpontot és az egyéb paramétereket a [NavigationPathQueryParameters2D] határozza meg. A megadott [NavigationPathQueryResult2D] objektumot frissíti a kiszámított útvonallal és a lekérdezésben kért további eredményekkel. A művelet végén meghívja az opcionális [param callback] visszahívást."

#. NavigationServer2D.free_rid
#: doc/classes/NavigationServer2D.xml
msgid "Destroys the given RID."
msgstr "Megsemmisíti a megadott RID-azonosítójú erőforrást."

#. NavigationServer2D.get_debug_enabled
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] when the NavigationServer has debug enabled."
msgstr "[code]true[/code] értéket ad vissza, ha a NavigationServer hibakeresési módja engedélyezett."

#. NavigationServer2D.get_maps
#: doc/classes/NavigationServer2D.xml
msgid "Returns all created navigation map [RID]s on the NavigationServer. This returns both 2D and 3D created navigation maps as there is technically no distinction between them."
msgstr "Visszaadja a NavigationServer rendszerében létrehozott összes navigációs térkép [RID] azonosítóját. A 2D-s és 3D-s térképeket is visszaadja, mert technikai szempontból nincs köztük különbség."

#. NavigationServer2D.get_process_info
#: doc/classes/NavigationServer2D.xml
msgid "Returns information about the current state of the NavigationServer."
msgstr "Visszaadja a NavigationServer aktuális állapotára vonatkozó információkat."

#. NavigationServer2D.is_baking_navigation_polygon
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] when the provided navigation polygon is being baked on a background thread."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott navigációs sokszög előállítása háttérszálon zajlik."

#. NavigationServer2D.map_get_cell_size
#: doc/classes/NavigationServer2D.xml
msgid "Returns the map cell size used to rasterize the navigation mesh vertices."
msgstr "Visszaadja a navigációs háló csúcsainak raszterezéséhez használt térképcella-méretet."

#. NavigationServer2D.map_get_edge_connection_margin
#: doc/classes/NavigationServer2D.xml
msgid "Returns the edge connection margin of the map. The edge connection margin is a distance used to connect two regions."
msgstr "Visszaadja a térkép élkapcsolati tűréshatárát, amellyel két terület összekapcsolásához szükséges távolság adható meg."

#. NavigationServer2D.map_get_iteration_id
#: doc/classes/NavigationServer2D.xml
msgid "Returns the current iteration id of the navigation map. Every time the navigation map changes and synchronizes the iteration id increases. An iteration id of 0 means the navigation map has never synchronized.\n[b]Note:[/b] The iteration id will wrap back to 1 after reaching its range limit."
msgstr "Visszaadja a navigációs térkép aktuális iterációazonosítóját. Minden módosítást követő szinkronizáláskor az azonosító növekszik. A 0 érték azt jelenti, hogy a térkép még soha nem szinkronizálódott.\n[b]Megjegyzés:[/b] Az azonosító a megengedett tartomány végén ismét 1-re vált."

#. NavigationServer2D.map_get_link_connection_radius
#: doc/classes/NavigationServer2D.xml
msgid "Returns the link connection radius of the map. This distance is the maximum range any link will search for navigation mesh polygons to connect to."
msgstr "Visszaadja a térkép navigációs kapcsolóelemeinek kapcsolódási sugarát. Ezen a legnagyobb távolságon belül keresnek kapcsolható navigációs sokszögeket."

#. NavigationServer2D.map_get_links
#: doc/classes/NavigationServer2D.xml
msgid "Returns all navigation link [RID]s that are currently assigned to the requested navigation [param map]."
msgstr "Visszaadja a [param map] navigációs térképhez rendelt összes navigációs kapcsolat [RID] azonosítóját."

#. NavigationServer2D.map_get_merge_rasterizer_cell_scale
#: doc/classes/NavigationServer2D.xml
msgid "Returns map's internal merge rasterizer cell scale."
msgstr "Visszaadja a térkép belső összevonási raszterezőjének cellaméretarányát."

#. NavigationServer2D.map_get_obstacles
#: doc/classes/NavigationServer2D.xml
msgid "Returns all navigation obstacle [RID]s that are currently assigned to the requested navigation [param map]."
msgstr "Visszaadja a [param map] navigációs térképhez rendelt összes navigációs akadály [RID] azonosítóját."

#. NavigationServer2D.map_get_random_point
#: doc/classes/NavigationServer2D.xml
msgid "Returns a random position picked from all map region polygons with matching [param navigation_layers].\nIf [param uniformly] is [code]true[/code], all map regions, polygons, and faces are weighted by their surface area (slower).\nIf [param uniformly] is [code]false[/code], just a random region and a random polygon are picked (faster)."
msgstr "Véletlenszerű pozíciót ad vissza a térkép azon navigációs sokszögeiből, amelyek megfelelnek a [param navigation_layers] rétegeknek.\nHa [param uniformly] értéke [code]true[/code], a területek, sokszögek és lapok a felületük arányában kapnak súlyt (lassabb).\nHa [param uniformly] értéke [code]false[/code], egyszerűen véletlenszerű régiót és sokszöget választ (gyorsabb)."

#. NavigationServer2D.map_get_use_async_iterations
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the [param map] synchronization uses an async process that runs on a background thread."
msgstr "[code]true[/code] értéket ad vissza, ha a [param map] szinkronizálása aszinkron módon, háttérszálon fut."

#. NavigationServer2D.map_get_use_edge_connections
#: doc/classes/NavigationServer2D.xml
msgid "Returns whether the navigation [param map] allows navigation regions to use edge connections to connect with other navigation regions within proximity of the navigation map edge connection margin."
msgstr "Megadja, hogy a [param map] navigációs térkép engedi-e a közeli területek összekapcsolását az élkapcsolati távolságon belül."

#. NavigationServer2D.map_is_active
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the map is active."
msgstr "[code]true[/code] értéket ad vissza, ha a navigációs térkép aktív."

#. NavigationServer2D.map_set_cell_size
#: doc/classes/NavigationServer2D.xml
msgid "Sets the map cell size used to rasterize the navigation mesh vertices. Must match with the cell size of the used navigation meshes."
msgstr "Beállítja a navigációs háló csúcsainak raszterezéséhez használt cellaméretet. Ennek egyeznie kell a navigációs hálók cellaméretével."

#. NavigationServer2D.map_set_edge_connection_margin
#: doc/classes/NavigationServer2D.xml
msgid "Set the map edge connection margin used to weld the compatible region edges."
msgstr "Beállítja a térkép élkapcsolati távolságát, amely alapján a megfelelő területélek összekapcsolhatók."

#. NavigationServer2D.map_set_link_connection_radius
#: doc/classes/NavigationServer2D.xml
msgid "Set the map's link connection radius used to connect links to navigation polygons."
msgstr "Beállítja a navigációs kapcsolóelemek és sokszögek összekapcsolásához használt sugarat."

#. NavigationServer2D.map_set_merge_rasterizer_cell_scale
#: doc/classes/NavigationServer2D.xml
msgid "Set the map's internal merge rasterizer cell scale used to control merging sensitivity."
msgstr "Beállítja a térkép belső összevonási raszterezőjének cellaméretarányát, amely az összevonási érzékenységet szabályozza."

#. NavigationServer2D.map_set_use_async_iterations
#: doc/classes/NavigationServer2D.xml
msgid "If [param enabled] is [code]true[/code] the [param map] synchronization uses an async process that runs on a background thread."
msgstr "Ha [param enabled] értéke [code]true[/code], a [param map] szinkronizálása háttérszálon futó aszinkron folyamatot használ."

#. NavigationServer2D.map_set_use_edge_connections
#: doc/classes/NavigationServer2D.xml
msgid "Set the navigation [param map] edge connection use. If [param enabled] is [code]true[/code], the navigation map allows navigation regions to use edge connections to connect with other navigation regions within proximity of the navigation map edge connection margin."
msgstr "Beállítja a [param map] élkapcsolatainak használatát. Ha [param enabled] értéke [code]true[/code], a térkép engedi a közeli területek összekapcsolását az élkapcsolati távolságon belül."

#. NavigationServer2D.set_active
#: doc/classes/NavigationServer2D.xml
msgid "Control activation of this server."
msgstr "Szabályozza a navigációs kiszolgáló aktiválását."

#. NavigationServer2D.set_debug_enabled
#: doc/classes/NavigationServer2D.xml
msgid "If [code]true[/code] enables debug mode on the NavigationServer."
msgstr "Ha [code]true[/code], engedélyezi a NavigationServer hibakeresési módját."

#. NavigationServer2D.region_get_enabled
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the specified [param region] is enabled."
msgstr "[code]true[/code] értéket ad vissza, ha a [param region] terület engedélyezett."

#. NavigationServer2D.region_get_map
#: doc/classes/NavigationServer2D.xml
msgid "Returns the navigation map [RID] the requested [param region] is currently assigned to."
msgstr "Visszaadja annak a navigációs térképnek az [RID] azonosítóját, amelyhez a [param region] jelenleg tartozik."

#. NavigationServer2D.region_get_navigation_layers
#: doc/classes/NavigationServer2D.xml
msgid "Returns the region's navigation layers."
msgstr "Visszaadja a terület navigációs rétegeit."

#. NavigationServer2D.region_set_navigation_layers
#: doc/classes/NavigationServer2D.xml
msgid "Set the region's navigation layers. This allows selecting regions from a path request (when using [method NavigationServer2D.map_get_path])."
msgstr "Beállítja a terület navigációs rétegeit. Segítségükkel meghatározhatók az útvonalkérésben részt vevő területek (lásd [method NavigationServer2D.map_get_path])."

#. NavigationServer2D.region_set_enter_cost
#: doc/classes/NavigationServer2D.xml
msgid "Sets the [param enter_cost] for this [param region]."
msgstr "Beállítja a [param region] terület [param enter_cost] belépési költségét."

#. NavigationServer2D.region_set_travel_cost
#: doc/classes/NavigationServer2D.xml
msgid "Sets the [param travel_cost] for this [param region]."
msgstr "Beállítja a [param region] terület [param travel_cost] haladási költségét."

#. NavigationServer2D.region_get_enter_cost
#: doc/classes/NavigationServer2D.xml
msgid "Returns the enter cost of this [param region]."
msgstr "Visszaadja a [param region] terület belépési költségét."

#. NavigationServer2D.region_get_travel_cost
#: doc/classes/NavigationServer2D.xml
msgid "Returns the travel cost of this [param region]."
msgstr "Visszaadja a [param region] terület haladási költségét."

#. NavigationServer2D.region_get_owner_id
#: doc/classes/NavigationServer2D.xml
msgid "Returns the [code]ObjectID[/code] of the object which manages this region."
msgstr "Visszaadja a területet kezelő objektum [code]ObjectID[/code] azonosítóját."

#. NavigationServer2D.region_get_transform
#: doc/classes/NavigationServer2D.xml
msgid "Returns the global transformation of this [param region]."
msgstr "Visszaadja a [param region] terület globális transzformációját."

#. NavigationServer2D.region_set_owner_id
#: doc/classes/NavigationServer2D.xml
msgid "Set the [code]ObjectID[/code] of the object which manages this region."
msgstr "Beállítja a területet kezelő objektum [code]ObjectID[/code] azonosítóját."

#. NavigationServer2D.region_set_transform
#: doc/classes/NavigationServer2D.xml
msgid "Sets the global transformation for the region."
msgstr "Beállítja a terület globális transzformációját."

#. NavigationServer2D.agent_get_avoidance_enabled
#: doc/classes/NavigationServer2D.xml
msgid "Return [code]true[/code] if the specified [param agent] uses avoidance."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param agent] használja az akadályelkerülést."

#. NavigationServer2D.agent_get_avoidance_layers
#: doc/classes/NavigationServer2D.xml
msgid "Returns the [code]avoidance_layers[/code] bitmask of the specified [param agent]."
msgstr "Visszaadja a megadott [param agent] [code]avoidance_layers[/code] bitmaszkját."

#. NavigationServer2D.agent_get_avoidance_mask
#: doc/classes/NavigationServer2D.xml
msgid "Returns the [code]avoidance_mask[/code] bitmask of the specified [param agent]."
msgstr "Visszaadja a megadott [param agent] [code]avoidance_mask[/code] bitmaszkját."

#. NavigationServer2D.agent_get_avoidance_priority
#: doc/classes/NavigationServer2D.xml
msgid "Returns the [code]avoidance_priority[/code] of the specified [param agent]."
msgstr "Visszaadja a megadott [param agent] [code]avoidance_priority[/code] prioritását."

#. NavigationServer2D.agent_get_max_neighbors
#: doc/classes/NavigationServer2D.xml
msgid "Returns the maximum number of other agents the specified [param agent] takes into account in the navigation."
msgstr "Visszaadja, hogy a megadott [param agent] a navigáció során legfeljebb hány másik ügynököt vesz figyelembe."

#. NavigationServer2D.agent_get_max_speed
#: doc/classes/NavigationServer2D.xml
msgid "Returns the maximum speed of the specified [param agent]."
msgstr "Visszaadja a megadott [param agent] legnagyobb sebességét."

#. NavigationServer2D.agent_get_neighbor_distance
#: doc/classes/NavigationServer2D.xml
msgid "Returns the maximum distance to other agents the specified [param agent] takes into account in the navigation."
msgstr "Visszaadja azt a legnagyobb távolságot, amelyen belül a megadott [param agent] más ügynököket vesz figyelembe a navigáció során."

#. NavigationServer2D.agent_get_paused
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the specified [param agent] is paused."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param agent] szüneteltetve van."

#. NavigationServer2D.agent_get_position
#: doc/classes/NavigationServer2D.xml
msgid "Returns the position of the specified [param agent] in world space."
msgstr "Visszaadja a megadott [param agent] pozícióját világkoordinátákban."

#. NavigationServer2D.agent_get_radius
#: doc/classes/NavigationServer2D.xml
msgid "Returns the radius of the specified [param agent]."
msgstr "Visszaadja a megadott [param agent] sugarát."

#. NavigationServer2D.agent_get_time_horizon_agents
#: doc/classes/NavigationServer2D.xml
msgid "Returns the minimal amount of time for which the specified [param agent]'s velocities that are computed by the simulation are safe with respect to other agents."
msgstr "Visszaadja azt a legkisebb időtartamot, amelyre a megadott [param agent] szimulációval kiszámított sebességei biztonságosnak tekinthetők más ügynökökhöz viszonyítva."

#. NavigationServer2D.agent_get_time_horizon_obstacles
#: doc/classes/NavigationServer2D.xml
msgid "Returns the minimal amount of time for which the specified [param agent]'s velocities that are computed by the simulation are safe with respect to static avoidance obstacles."
msgstr "Visszaadja azt a legkisebb időtartamot, amelyre a megadott [param agent] szimulációval kiszámított sebességei biztonságosnak tekinthetők a statikus elkerülendő akadályokhoz viszonyítva."

#. NavigationServer2D.agent_get_velocity
#: doc/classes/NavigationServer2D.xml
msgid "Returns the velocity of the specified [param agent]."
msgstr "Visszaadja a megadott [param agent] sebességét."

#. NavigationServer2D.agent_has_avoidance_callback
#: doc/classes/NavigationServer2D.xml
msgid "Return [code]true[/code] if the specified [param agent] has an avoidance callback."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param agent] rendelkezik akadályelkerülési visszahívással."

#. NavigationServer2D.agent_is_map_changed
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the map got changed the previous frame."
msgstr "[code]true[/code] értéket ad vissza, ha a navigációs térkép az előző képkockában megváltozott."

#. NavigationServer2D.agent_set_avoidance_layers
#: doc/classes/NavigationServer2D.xml
msgid "Set the agent's [code]avoidance_layers[/code] bitmask."
msgstr "Beállítja az ügynök [code]avoidance_layers[/code] bitmaszkját."

#. NavigationServer2D.agent_set_avoidance_mask
#: doc/classes/NavigationServer2D.xml
msgid "Set the agent's [code]avoidance_mask[/code] bitmask."
msgstr "Beállítja az ügynök [code]avoidance_mask[/code] bitmaszkját."

#. NavigationServer2D.agent_set_avoidance_priority
#: doc/classes/NavigationServer2D.xml
msgid "Set the agent's [code]avoidance_priority[/code] with a [param priority] between 0.0 (lowest priority) to 1.0 (highest priority).\nThe specified [param agent] does not adjust the velocity for other agents that would match the [code]avoidance_mask[/code] but have a lower [code]avoidance_priority[/code]. This in turn makes the other agents with lower priority adjust their velocities even more to avoid collision with this agent."
msgstr "Beállítja az ügynök [code]avoidance_priority[/code] prioritását a [param priority] értékével, 0.0 (legalacsonyabb) és 1.0 (legmagasabb) között.\nA megadott [param agent] nem igazítja saját sebességét azokhoz az ügynökökhöz, amelyek a [code]avoidance_mask[/code] maszkja alapján érzékelhetők, de [code]avoidance_priority[/code] értékük alacsonyabb. Emiatt az alacsonyabb prioritású ügynököknek még nagyobb mértékben kell módosítaniuk sebességüket, hogy elkerüljék az ütközést."

#. NavigationServer2D.agent_set_max_neighbors
#: doc/classes/NavigationServer2D.xml
msgid "Sets the maximum number of other agents the agent takes into account in the navigation. The larger this number, the longer the running time of the simulation. If the number is too low, the simulation will not be safe."
msgstr "Beállítja, hogy az ügynök a navigáció során legfeljebb hány másik ügynököt vegyen figyelembe. A nagyobb érték növeli a szimuláció futási idejét. A túl alacsony érték miatt az ütközéselkerülés nem feltétlenül lesz biztonságos."

#. NavigationServer2D.agent_set_max_speed
#: doc/classes/NavigationServer2D.xml
msgid "Sets the maximum speed of the agent. Must be positive."
msgstr "Beállítja az ügynök legnagyobb sebességét. Pozitív értéket kell megadni."

#. NavigationServer2D.agent_set_neighbor_distance
#: doc/classes/NavigationServer2D.xml
msgid "Sets the maximum distance to other agents this agent takes into account in the navigation. The larger this number, the longer the running time of the simulation. If the number is too low, the simulation will not be safe."
msgstr "Beállítja a legnagyobb távolságot, amelyen belül az ügynök más ügynököket vesz figyelembe a navigáció során. A nagyobb érték növeli a szimuláció futási idejét. Ha az érték túl alacsony, az ütközéselkerülés nem feltétlenül lesz biztonságos."

#. NavigationServer2D.agent_set_paused
#: doc/classes/NavigationServer2D.xml
msgid "If [param paused] is [code]true[/code] the specified [param agent] will not be processed. For example, it will not calculate avoidance velocities or receive avoidance callbacks."
msgstr "Ha a [param paused] értéke [code]true[/code], a megadott [param agent] feldolgozása szünetel. Például nem számít akadályelkerülési sebességeket, és nem kap akadályelkerülési visszahívásokat."

#. NavigationServer2D.agent_set_radius
#: doc/classes/NavigationServer2D.xml
msgid "Sets the radius of the agent."
msgstr "Beállítja az ügynök sugarát."

#. NavigationServer2D.agent_set_time_horizon_agents
#: doc/classes/NavigationServer2D.xml
msgid "The minimal amount of time for which the agent's velocities that are computed by the simulation are safe with respect to other agents. The larger this number, the sooner this agent will respond to the presence of other agents, but the less freedom this agent has in choosing its velocities. A too high value will slow down agents movement considerably. Must be positive."
msgstr "Az a legkisebb időtartam, amelyre a szimulációval kiszámított sebességek biztonságosnak tekinthetők más ügynökökhöz képest. Nagyobb értéknél az ügynök hamarabb reagál más ügynökökre, de kevesebb szabadsága marad a sebesség megválasztásában. A túl nagy érték jelentősen lelassíthatja a mozgást. Pozitív értéket kell megadni."

#. NavigationServer2D.agent_set_time_horizon_obstacles
#: doc/classes/NavigationServer2D.xml
msgid "The minimal amount of time for which the agent's velocities that are computed by the simulation are safe with respect to static avoidance obstacles. The larger this number, the sooner this agent will respond to the presence of static avoidance obstacles, but the less freedom this agent has in choosing its velocities. A too high value will slow down agents movement considerably. Must be positive."
msgstr "Az a legkisebb időtartam, amelyre a szimulációval kiszámított sebességek biztonságosnak tekinthetők a statikus elkerülendő akadályokhoz képest. Nagyobb értéknél az ügynök hamarabb reagál ezekre az akadályokra, de kevesebb szabadsága marad a sebesség megválasztásában. A túl nagy érték jelentősen lelassíthatja a mozgást. Pozitív értéket kell megadni."

#. NavigationServer2D.agent_set_velocity_forced
#: doc/classes/NavigationServer2D.xml
msgid "Replaces the internal velocity in the collision avoidance simulation with [param velocity] for the specified [param agent]. When an agent is teleported to a new position far away this function should be used in the same frame. If called frequently this function can get agents stuck."
msgstr "A megadott [param agent] ütközéselkerülési szimulációjának belső sebességét a [param velocity] értékre állítja. Ha az ügynököt nagy távolságra teleportálod, ugyanabban a képkockában ezt a függvényt is használd. A túl gyakori hívás miatt az ügynökök elakadhatnak."

#. NavigationServer2D.bake_from_source_geometry_data_async
#: doc/classes/NavigationServer2D.xml
msgid "Bakes the provided [param navigation_polygon] with the data from the provided [param source_geometry_data] as an async task running on a background thread. After the process is finished the optional [param callback] will be called."
msgstr "A megadott [param navigation_polygon] navigációs sokszöget a [param source_geometry_data] forrásadatokból állítja elő, háttérszálon futó aszinkron feladatként. A művelet végeztével meghívja az opcionális [param callback] visszahívást."

#. NavigationServer2D.link_create
#: doc/classes/NavigationServer2D.xml
msgid "Create a new link between two positions on a map."
msgstr "Új navigációs kapcsolatot hoz létre két térképbeli pozíció között."

#. NavigationServer2D.link_get_enabled
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the specified [param link] is enabled."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param link] engedélyezett."

#. NavigationServer2D.link_get_end_position
#: doc/classes/NavigationServer2D.xml
msgid "Returns the ending position of this [param link]."
msgstr "Visszaadja a [param link] kapcsolat végpontját."

#. NavigationServer2D.link_get_enter_cost
#: doc/classes/NavigationServer2D.xml
msgid "Returns the enter cost of this [param link]."
msgstr "Visszaadja a [param link] kapcsolat belépési költségét."

#. NavigationServer2D.link_get_iteration_id
#: doc/classes/NavigationServer2D.xml
msgid "Returns the current iteration ID of the navigation link. Every time the navigation link changes and synchronizes, the iteration ID increases. An iteration ID of [code]0[/code] means the navigation link has never synchronized.\n[b]Note:[/b] The iteration ID will wrap around to [code]1[/code] after reaching its range limit."
msgstr "Visszaadja a navigációs kapcsolat aktuális iterációazonosítóját. A kapcsolat minden változása és szinkronizálása után az azonosító növekszik. A [code]0[/code] azt jelenti, hogy a kapcsolat még sosem szinkronizálódott.\n[b]Megjegyzés:[/b] A megengedett tartomány végén az iterációazonosító ismét [code]1[/code] értékre vált."

#. NavigationServer2D.link_get_map
#: doc/classes/NavigationServer2D.xml
msgid "Returns the navigation map [RID] the requested [param link] is currently assigned to."
msgstr "Visszaadja annak a navigációs térképnek az [RID] azonosítóját, amelyhez a megadott [param link] jelenleg tartozik."

#. NavigationServer2D.link_get_navigation_layers
#: doc/classes/NavigationServer2D.xml
msgid "Returns the navigation layers for this [param link]."
msgstr "Visszaadja a [param link] kapcsolat navigációs rétegeit."

#. NavigationServer2D.link_get_owner_id
#: doc/classes/NavigationServer2D.xml
msgid "Returns the [code]ObjectID[/code] of the object which manages this link."
msgstr "Visszaadja a kapcsolatot kezelő objektum [code]ObjectID[/code] azonosítóját."

#. NavigationServer2D.link_get_start_position
#: doc/classes/NavigationServer2D.xml
msgid "Returns the starting position of this [param link]."
msgstr "Visszaadja a [param link] kapcsolat kezdőpozícióját."

#. NavigationServer2D.link_get_travel_cost
#: doc/classes/NavigationServer2D.xml
msgid "Returns the travel cost of this [param link]."
msgstr "Visszaadja a [param link] kapcsolat haladási költségét."

#. NavigationServer2D.link_is_bidirectional
#: doc/classes/NavigationServer2D.xml
msgid "Returns whether this [param link] can be travelled in both directions."
msgstr "Megadja, hogy a [param link] kapcsolaton mindkét irányban át lehet-e haladni."

#. NavigationServer2D.link_set_bidirectional
#: doc/classes/NavigationServer2D.xml
msgid "Sets whether this [param link] can be travelled in both directions."
msgstr "Beállítja, hogy a [param link] kapcsolaton mindkét irányban át lehessen-e haladni."

#. NavigationServer2D.link_set_enabled
#: doc/classes/NavigationServer2D.xml
msgid "If [param enabled] is [code]true[/code], the specified [param link] will contribute to its current navigation map."
msgstr "Ha a [param enabled] értéke [code]true[/code], a megadott [param link] részt vesz a hozzá tartozó navigációs térkép működésében."

#. NavigationServer2D.link_set_end_position
#: doc/classes/NavigationServer2D.xml
msgid "Sets the exit position for the [param link]."
msgstr "Beállítja a [param link] kapcsolat kilépési pozícióját."

#. NavigationServer2D.link_set_enter_cost
#: doc/classes/NavigationServer2D.xml
msgid "Sets the [param enter_cost] for this [param link]."
msgstr "Beállítja a [param link] kapcsolat [param enter_cost] belépési költségét."

#. NavigationServer2D.link_set_map
#: doc/classes/NavigationServer2D.xml
msgid "Sets the navigation map [RID] for the link."
msgstr "Beállítja a kapcsolat navigációs térképének [RID] azonosítóját."

#. NavigationServer2D.link_set_navigation_layers
#: doc/classes/NavigationServer2D.xml
msgid "Set the links's navigation layers. This allows selecting links from a path request (when using [method NavigationServer2D.map_get_path])."
msgstr "Beállítja a kapcsolat navigációs rétegeit. Ezekkel lehet kiválasztani, hogy mely kapcsolatok vehetnek részt az útvonalkérésben (lásd [method NavigationServer2D.map_get_path])."

#. NavigationServer2D.link_set_owner_id
#: doc/classes/NavigationServer2D.xml
msgid "Set the [code]ObjectID[/code] of the object which manages this link."
msgstr "Beállítja a kapcsolatot kezelő objektum [code]ObjectID[/code] azonosítóját."

#. NavigationServer2D.link_set_start_position
#: doc/classes/NavigationServer2D.xml
msgid "Sets the entry position for this [param link]."
msgstr "Beállítja a [param link] kapcsolat belépési pozícióját."

#. NavigationServer2D.link_set_travel_cost
#: doc/classes/NavigationServer2D.xml
msgid "Sets the [param travel_cost] for this [param link]."
msgstr "Beállítja a [param link] kapcsolat [param travel_cost] haladási költségét."

#. NavigationServer2D.map_force_update
#: doc/classes/NavigationServer2D.xml
msgid "This function immediately forces synchronization of the specified navigation [param map] [RID]. By default navigation maps are only synchronized at the end of each physics frame. This function can be used to immediately (re)calculate all the navigation meshes and region connections of the navigation map. This makes it possible to query a navigation path for a changed map immediately and in the same frame (multiple times if needed).\nDue to technical restrictions the current NavigationServer command queue will be flushed. This means all already queued update commands for this physics frame will be executed, even those intended for other maps, regions and agents not part of the specified map. The expensive computation of the navigation meshes and region connections of a map will only be done for the specified map. Other maps will receive the normal synchronization at the end of the physics frame. Should the specified map receive changes after the forced update it will update again as well when the other maps receive their update.\nAvoidance processing and dispatch of the [code]safe_velocity[/code] signals is unaffected by this function and continues to happen for all maps and agents at the end of the physics frame.\n[b]Note:[/b] With great power comes great responsibility. This function should only be used by users that really know what they are doing and have a good reason for it. Forcing an immediate update of a navigation map requires locking the NavigationServer and flushing the entire NavigationServer command queue. Not only can this severely impact the performance of a game but it can also introduce bugs if used inappropriately without much foresight."
msgstr "Azonnal kikényszeríti a megadott [param map] navigációs térkép [RID] azonosítójának szinkronizálását. Alapértelmezés szerint a navigációs térképek csak a fizikai képkockák végén szinkronizálódnak. Ezzel a függvénnyel azonnal újraszámíthatod a térkép navigációs hálóit és a területek közötti kapcsolatokat. Így egy módosított térkép útvonala már ugyanabban a képkockában lekérdezhető, szükség esetén többször is.\nTechnikai korlátok miatt a művelet kiüríti a NavigationServer aktuális parancssorát. Ez azt jelenti, hogy a képkockára korábban ütemezett összes frissítési parancs végrehajtódik, azok is, amelyek nem a megadott térképhez tartozó térképeket, területeket vagy ügynököket érintik. A navigációs hálók és területkapcsolatok költséges újraszámítása csak a megadott térképen történik meg. A többi térkép a fizikai képkocka végén a szokásos módon szinkronizálódik. Ha a megadott térkép a kényszerített frissítés után újra megváltozik, akkor a többi térképpel együtt ismét frissül.\nAz akadályelkerülés feldolgozását és a [code]safe_velocity[/code] jelzések továbbítását a függvény nem módosítja; ezek továbbra is az összes térképnél és ügynöknél a fizikai képkocka végén zajlanak.\n[b]Megjegyzés:[/b] Nagy hatalommal nagy felelősség jár. A függvényt csak akkor használd, ha pontosan érted a működését, és valóban szükséges. A navigációs térkép azonnali frissítése zárolja a NavigationServert és kiüríti annak teljes parancssorát. Ez súlyosan ronthatja a játék teljesítményét, és előrelátás nélkül használva hibákat is okozhat."

#. NavigationServer2D.obstacle_get_avoidance_enabled
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the provided [param obstacle] has avoidance enabled."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param obstacle] akadálynál engedélyezett az akadályelkerülés."

#. NavigationServer2D.obstacle_get_avoidance_layers
#: doc/classes/NavigationServer2D.xml
msgid "Returns the [code]avoidance_layers[/code] bitmask of the specified [param obstacle]."
msgstr "Visszaadja a megadott [param obstacle] [code]avoidance_layers[/code] bitmaszkját."

#. NavigationServer2D.obstacle_get_map
#: doc/classes/NavigationServer2D.xml
msgid "Returns the navigation map [RID] the requested [param obstacle] is currently assigned to."
msgstr "Visszaadja annak a navigációs térképnek az [RID] azonosítóját, amelyhez a megadott [param obstacle] jelenleg tartozik."

#. NavigationServer2D.obstacle_get_paused
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the specified [param obstacle] is paused."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param obstacle] feldolgozása szünetel."

#. NavigationServer2D.obstacle_get_position
#: doc/classes/NavigationServer2D.xml
msgid "Returns the position of the specified [param obstacle] in world space."
msgstr "Visszaadja a megadott [param obstacle] pozícióját világkoordinátákban."

#. NavigationServer2D.obstacle_get_radius
#: doc/classes/NavigationServer2D.xml
msgid "Returns the radius of the specified dynamic [param obstacle]."
msgstr "Visszaadja a megadott dinamikus [param obstacle] sugarát."

#. NavigationServer2D.obstacle_get_velocity
#: doc/classes/NavigationServer2D.xml
msgid "Returns the velocity of the specified dynamic [param obstacle]."
msgstr "Visszaadja a megadott dinamikus [param obstacle] sebességét."

#. NavigationServer2D.obstacle_get_vertices
#: doc/classes/NavigationServer2D.xml
msgid "Returns the outline vertices for the specified [param obstacle]."
msgstr "Visszaadja a megadott [param obstacle] körvonalának csúcsait."

#. NavigationServer2D.obstacle_set_avoidance_enabled
#: doc/classes/NavigationServer2D.xml
msgid "If [param enabled] is [code]true[/code], the provided [param obstacle] affects avoidance using agents."
msgstr "Ha a [param enabled] értéke [code]true[/code], a megadott [param obstacle] hatással van az ügynökök akadályelkerülésére."

#. NavigationServer2D.obstacle_set_avoidance_layers
#: doc/classes/NavigationServer2D.xml
msgid "Set the obstacles's [code]avoidance_layers[/code] bitmask."
msgstr "Beállítja az akadály [code]avoidance_layers[/code] bitmaszkját."

#. NavigationServer2D.obstacle_set_paused
#: doc/classes/NavigationServer2D.xml
msgid "If [param paused] is [code]true[/code] the specified [param obstacle] will not be processed. For example, it will no longer affect avoidance velocities."
msgstr "Ha a [param paused] értéke [code]true[/code], a megadott [param obstacle] feldolgozása szünetel. Ilyenkor például nem befolyásolja az akadályelkerülési sebességeket."

#. NavigationServer2D.obstacle_set_velocity
#: doc/classes/NavigationServer2D.xml
msgid "Sets [param velocity] of the dynamic [param obstacle]. Allows other agents to better predict the movement of the dynamic obstacle. Only works in combination with the radius of the obstacle."
msgstr "Beállítja a dinamikus [param obstacle] [param velocity] sebességét. Ezzel a többi ügynök jobban előre jelezheti a mozgó akadály helyváltoztatását. Csak az akadály sugarával együtt működik."

#. NavigationServer2D.obstacle_set_vertices
#: doc/classes/NavigationServer2D.xml
msgid "Sets the outline vertices for the obstacle. If the vertices are winded in clockwise order agents will be pushed in by the obstacle, else they will be pushed out."
msgstr "Beállítja az akadály körvonalának csúcsait. Ha a csúcsok óramutató járásával megegyező sorrendben következnek, az akadály az ügynököket befelé tereli, ellenkező sorrend esetén kifelé."

#. NavigationServer2D.parse_source_geometry_data
#: doc/classes/NavigationServer2D.xml
msgid "Parses the [SceneTree] for source geometry according to the properties of [param navigation_polygon]. Updates the provided [param source_geometry_data] resource with the resulting data. The resource can then be used to bake a navigation mesh with [method bake_from_source_geometry_data]. After the process is finished the optional [param callback] will be called.\n[b]Note:[/b] This function needs to run on the main thread or with a deferred call as the SceneTree is not thread-safe.\n[b]Performance:[/b] While convenient, reading data arrays from [Mesh] resources can affect the frame rate negatively. The data needs to be received from the GPU, stalling the [RenderingServer] in the process. For performance prefer the use of e.g. collision shapes or creating the data arrays entirely in code."
msgstr "A [param navigation_polygon] beállításai alapján feldolgozza a [SceneTree] jelenetfát, hogy kinyerje a navigációs forrásgeometriát. A kapott adatokkal frissíti a megadott [param source_geometry_data] erőforrást. Ezután az erőforrás a [method bake_from_source_geometry_data] segítségével navigációs háló előállítására használható. A feldolgozás befejezésekor meghívja az opcionális [param callback] visszahívást.\n[b]Megjegyzés:[/b] A függvényt a főszálon vagy késleltetett hívással kell futtatni, mert a SceneTree nem szálbiztos.\n[b]Teljesítmény:[/b] Bár kényelmes megoldás, a [Mesh] erőforrások adattömbjeinek beolvasása ronthatja a képkockasebességet. Az adatokat a GPU-ról kell visszaolvasni, ami közben megakaszthatja a [RenderingServer] feldolgozását. A jobb teljesítményhez inkább ütközési alakzatokat használj, vagy hozd létre az adattömböket teljes egészükben kódból."

#. NavigationServer2D.region_get_bounds
#: doc/classes/NavigationServer2D.xml
msgid "Returns the axis-aligned rectangle for the [param region]'s transformed navigation mesh."
msgstr "Visszaadja a [param region] átalakított navigációs hálójának tengelyekkel párhuzamos határoló téglalapját."

#. NavigationServer2D.region_get_closest_point
#: doc/classes/NavigationServer2D.xml
msgid "Returns the navigation mesh surface point closest to the provided [param to_point] on the navigation [param region]."
msgstr "Visszaadja a [param region] navigációs terület hálófelületének a [param to_point] ponthoz legközelebbi pontját."

#. NavigationServer2D.region_get_connection_pathway_end
#: doc/classes/NavigationServer2D.xml
msgid "Returns the ending point of a connection door. [param connection] is an index between 0 and the return value of [method region_get_connections_count]."
msgstr "Visszaadja egy területkapcsolat átjárójának végpontját. A [param connection] indexe 0 és a [method region_get_connections_count] által visszaadott érték közötti lehet."

#. NavigationServer2D.region_get_connection_pathway_start
#: doc/classes/NavigationServer2D.xml
msgid "Returns the starting point of a connection door. [param connection] is an index between 0 and the return value of [method region_get_connections_count]."
msgstr "Visszaadja egy területkapcsolat átjárójának kezdőpontját. A [param connection] indexe 0 és a [method region_get_connections_count] által visszaadott érték közötti lehet."

#. NavigationServer2D.region_get_connections_count
#: doc/classes/NavigationServer2D.xml
msgid "Returns how many connections this [param region] has with other regions in the map."
msgstr "Visszaadja, hogy a [param region] hány kapcsolattal rendelkezik a térkép más területeihez."

#. NavigationServer2D.region_get_iteration_id
#: doc/classes/NavigationServer2D.xml
msgid "Returns the current iteration ID of the navigation region. Every time the navigation region changes and synchronizes, the iteration ID increases. An iteration ID of [code]0[/code] means the navigation region has never synchronized.\n[b]Note:[/b] The iteration ID will wrap around to [code]1[/code] after reaching its range limit."
msgstr "Visszaadja a navigációs terület aktuális iterációazonosítóját. A terület minden változása és szinkronizálása után az azonosító növekszik. A [code]0[/code] azt jelenti, hogy a terület még sosem szinkronizálódott.\n[b]Megjegyzés:[/b] A megengedett tartomány végén az iterációazonosító ismét [code]1[/code] értékre vált."

#. NavigationServer2D.region_get_random_point
#: doc/classes/NavigationServer2D.xml
msgid "Returns a random position picked from all region polygons with matching [param navigation_layers].\nIf [param uniformly] is [code]true[/code], all region polygons and faces are weighted by their surface area (slower).\nIf [param uniformly] is [code]false[/code], just a random polygon and face is picked (faster)."
msgstr "Véletlenszerű pozíciót ad vissza a terület azon navigációs sokszögeiből, amelyek megfelelnek a [param navigation_layers] rétegmaszknak.\nHa [param uniformly] értéke [code]true[/code], a sokszögeket és lapokat a felületük arányában súlyozza a rendszer (lassabb).\nHa [param uniformly] értéke [code]false[/code], egy véletlenszerű sokszöget és azon egy lapot választ (gyorsabb)."

#. NavigationServer2D.region_get_use_async_iterations
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the [param region] uses an async synchronization process that runs on a background thread."
msgstr "[code]true[/code] értéket ad vissza, ha a [param region] aszinkron, háttérszálon futó szinkronizálást használ."

#. NavigationServer2D.region_get_use_edge_connections
#: doc/classes/NavigationServer2D.xml
msgid "Returns whether the navigation [param region] is set to use edge connections to connect with other navigation regions within proximity of the navigation map edge connection margin."
msgstr "Megadja, hogy a [param region] navigációs terület használja-e az élkapcsolatokat más közeli navigációs területekkel, a térkép élkapcsolati távolságán belül."

#. NavigationServer2D.region_owns_point
#: doc/classes/NavigationServer2D.xml
msgid "Returns [code]true[/code] if the provided [param point] in world space is currently owned by the provided navigation [param region]. Owned in this context means that one of the region's navigation mesh polygon faces has a possible position at the closest distance to this point compared to all other navigation meshes from other navigation regions that are also registered on the navigation map of the provided region.\nIf multiple navigation meshes have positions at equal distance the navigation region whose polygons are processed first wins the ownership. Polygons are processed in the same order that navigation regions were registered on the NavigationServer.\n[b]Note:[/b] If navigation meshes from different navigation regions overlap (which should be avoided in general) the result might not be what is expected."
msgstr "[code]true[/code] értéket ad vissza, ha a világkoordinátákban megadott [param point] pont jelenleg a megadott [param region] navigációs területhez tartozik. Itt a hozzátartozás azt jelenti, hogy a terület navigációs hálójának valamelyik sokszöglapja az összes, ugyanazon a térképen regisztrált navigációs terület közül a ponthoz legközelebbi lehetséges pozíciót tartalmazza.\nHa több navigációs háló azonos távolságra lévő pozíciót kínál, annak a területnek a sokszögei élveznek elsőbbséget, amelyet előbb dolgoz fel a rendszer. A területeket a NavigationServer rendszerében történt regisztrációjuk sorrendjében dolgozza fel.\n[b]Megjegyzés:[/b] Ha különböző navigációs területek hálói átfedésben vannak (amit általában kerülni kell), a kapott eredmény eltérhet a várttól."

#. NavigationServer2D.region_set_use_async_iterations
#: doc/classes/NavigationServer2D.xml
msgid "If [param enabled] is [code]true[/code] the [param region] uses an async synchronization process that runs on a background thread."
msgstr "Ha a [param enabled] értéke [code]true[/code], a [param region] háttérszálon futó aszinkron szinkronizálást használ."

#. NavigationServer2D.region_set_use_edge_connections
#: doc/classes/NavigationServer2D.xml
msgid "If [param enabled] is [code]true[/code], the navigation [param region] will use edge connections to connect with other navigation regions within proximity of the navigation map edge connection margin."
msgstr "Ha a [param enabled] értéke [code]true[/code], a [param region] navigációs terület élkapcsolatokkal kapcsolódhat a térkép élkapcsolati távolságán belül található más navigációs területekhez."

#. NavigationServer2D.simplify_path
#: doc/classes/NavigationServer2D.xml
msgid "Returns a simplified version of [param path] with less critical path points removed. The simplification amount is in worlds units and controlled by [param epsilon]. The simplification uses a variant of Ramer-Douglas-Peucker algorithm for curve point decimation.\nPath simplification can be helpful to mitigate various path following issues that can arise with certain agent types and script behaviors. E.g. \"steering\" agents or avoidance in \"open fields\"."
msgstr "Visszaadja a [param path] egyszerűsített változatát, amelyből eltávolítja a kevésbé fontos útvonali pontokat. Az egyszerűsítés mértéke világkoordináta-egységekben értendő, és a [param epsilon] szabályozza. A pontok ritkítására a Ramer–Douglas–Peucker-algoritmus egyik változatát használja.\nAz útvonal egyszerűsítése segíthet csökkenteni az útvonalkövetési problémákat egyes ügynöktípusok és scriptek esetén, például kormányzásalapú mozgásnál vagy nyílt területen történő akadályelkerülésnél."

#. NavigationServer2D.source_geometry_parser_create
#: doc/classes/NavigationServer2D.xml
msgid "Creates a new source geometry parser. If a [Callable] is set for the parser with [method source_geometry_parser_set_callback] the callback will be called for every single node that gets parsed whenever [method parse_source_geometry_data] is used."
msgstr "Új forrásgeometria-feldolgozót hoz létre. Ha a feldolgozóhoz a [method source_geometry_parser_set_callback] segítségével [Callable] visszahívást rendelsz, a [method parse_source_geometry_data] használatakor minden feldolgozott csomópontnál meghívja a visszahívást."

#. NavigationServer2D.source_geometry_parser_set_callback
#: doc/classes/NavigationServer2D.xml
msgid "Sets the [param callback] [Callable] for the specific source geometry [param parser]. The [Callable] will receive a call with the following parameters:\n- [code]navigation_mesh[/code] - The [NavigationPolygon] reference used to define the parse settings. Do NOT edit or add directly to the navigation mesh.\n- [code]source_geometry_data[/code] - The [NavigationMeshSourceGeometryData2D] reference. Add custom source geometry for navigation mesh baking to this object.\n- [code]node[/code] - The [Node] that is parsed."
msgstr "Beállítja a [param parser] forrásgeometria-feldolgozóhoz tartozó [param callback] [Callable] visszahívást. A [Callable] a következő paramétereket kapja:\n- [code]navigation_mesh[/code] – A feldolgozási beállításokhoz használt [NavigationPolygon] erőforrásra mutató hivatkozás. Ne módosítsd, és ne adj közvetlenül elemeket a navigációs hálóhoz.\n- [code]source_geometry_data[/code] – A [NavigationMeshSourceGeometryData2D] hivatkozás. Ehhez az objektumhoz hozzáadhatsz egyéni forrásgeometriát a navigációs háló előállításához.\n- [code]node[/code] – A feldolgozott [Node] csomópont."

#. AnimatableBody2D.brief
#: doc/classes/AnimatableBody2D.xml
msgid "A 2D physics body that can't be moved by external forces. When moved manually, it affects other bodies in its path."
msgstr "Olyan 2D-s fizikai test, amelyet külső erők nem mozdíthatnak el. Kézi mozgatásakor azonban hatással van az útjába kerülő testekre."

#. AnimatableBody2D.description
#: doc/classes/AnimatableBody2D.xml
msgid "An animatable 2D physics body. It can't be moved by external forces or contacts, but can be moved manually by other means such as code, [AnimationMixer]s (with [member AnimationMixer.callback_mode_process] set to [constant AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]), and [RemoteTransform2D].\nWhen [AnimatableBody2D] is moved, its linear and angular velocity are estimated and used to affect other physics bodies in its path. This makes it useful for moving platforms, doors, and other moving objects."
msgstr "Animálható 2D-s fizikai test. Külső erők és ütközések nem mozdítják el, de például kóddal, [AnimationMixer] csomópontokkal (ha a [member AnimationMixer.callback_mode_process] értéke [constant AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]) vagy [RemoteTransform2D] segítségével mozgatható.\nAz [AnimatableBody2D] mozgatásakor a rendszer megbecsüli a lineáris és a szögsebességét, majd ezekkel hat az útjába kerülő többi fizikai testre. Emiatt mozgó platformokhoz, ajtókhoz és más mozgatható objektumokhoz is használható."

#. AnimatableBody2D.sync_to_physics
#: doc/classes/AnimatableBody2D.xml
msgid "If [code]true[/code], the body's movement will be synchronized to the physics frame. This is useful when animating movement via [AnimationPlayer], for example on moving platforms. Do [b]not[/b] use together with [method PhysicsBody2D.move_and_collide]."
msgstr "Ha [code]true[/code], a test mozgása a fizikai képkockákhoz lesz szinkronizálva. Ez például akkor hasznos, amikor a mozgást [AnimationPlayer] vezérli, mint egy mozgó platform esetén. A [method PhysicsBody2D.move_and_collide] metódussal együtt [b]ne[/b] használd."

#. NavigationLink2D.brief
#: doc/classes/NavigationLink2D.xml
msgid "A link between two positions on [NavigationRegion2D]s that agents can be routed through."
msgstr "Két [NavigationRegion2D] területen található pozíció közötti kapcsolat, amelyen a navigációs ügynökök útvonala áthaladhat."

#. NavigationLink2D.description
#: doc/classes/NavigationLink2D.xml
msgid "A link between two positions on [NavigationRegion2D]s that agents can be routed through. These positions can be on the same [NavigationRegion2D] or on two different ones. Links are useful to express navigation methods other than traveling along the surface of the navigation polygon, such as ziplines, teleporters, or gaps that can be jumped across."
msgstr "Két [NavigationRegion2D] területen található pozíció közötti kapcsolat, amelyen a navigációs ügynökök útvonala áthaladhat. A két pozíció ugyanazon a [NavigationRegion2D] területen vagy két különböző területen is lehet. A kapcsolatok olyan közlekedési módok jelölésére használhatók, amelyek nem a navigációs sokszög felületén történő haladást jelentik: például kötélpálya, teleport vagy átugorható szakadék."

#. NavigationLink2D.get_global_end_position
#: doc/classes/NavigationLink2D.xml
msgid "Returns the [member end_position] that is relative to the link as a global position."
msgstr "Visszaadja a kapcsolathoz viszonyított [member end_position] végpozíciót globális koordinátákban."

#. NavigationLink2D.get_global_start_position
#: doc/classes/NavigationLink2D.xml
msgid "Returns the [member start_position] that is relative to the link as a global position."
msgstr "Visszaadja a kapcsolathoz viszonyított [member start_position] kezdőpozíciót globális koordinátákban."

#. NavigationLink2D.get_navigation_map
#: doc/classes/NavigationLink2D.xml
msgid "Returns the current navigation map [RID] used by this link."
msgstr "Visszaadja a kapcsolat által jelenleg használt navigációs térkép [RID] azonosítóját."

#. NavigationLink2D.get_rid
#: doc/classes/NavigationLink2D.xml
msgid "Returns the [RID] of this link on the [NavigationServer2D]."
msgstr "Visszaadja a kapcsolat [NavigationServer2D] rendszerbeli [RID] azonosítóját."

#. NavigationLink2D.set_global_end_position
#: doc/classes/NavigationLink2D.xml
msgid "Sets the [member end_position] that is relative to the link from a global [param position]."
msgstr "A globális [param position] alapján beállítja a kapcsolathoz viszonyított [member end_position] pozíciót."

#. NavigationLink2D.set_global_start_position
#: doc/classes/NavigationLink2D.xml
msgid "Sets the [member start_position] that is relative to the link from a global [param position]."
msgstr "A globális [param position] alapján beállítja a kapcsolathoz viszonyított [member start_position] pozíciót."

#. NavigationLink2D.set_navigation_map
#: doc/classes/NavigationLink2D.xml
msgid "Sets the [RID] of the navigation map this link should use. By default the link will automatically join the [World2D] default navigation map so this function is only required to override the default map."
msgstr "Beállítja annak a navigációs térképnek a [RID] azonosítóját, amelyet a kapcsolat használjon. Alapértelmezés szerint a kapcsolat automatikusan csatlakozik a [World2D] alapértelmezett navigációs térképéhez, ezért a metódusra csak ennek felülírásakor van szükség."

#. NavigationLink2D.bidirectional
#: doc/classes/NavigationLink2D.xml
msgid "Whether this link can be traveled in both directions or only from [member start_position] to [member end_position]."
msgstr "Meghatározza, hogy a kapcsolaton mindkét irányban át lehet-e haladni, vagy csak a [member start_position] ponttól a [member end_position] pontig."

#. NavigationLink2D.enabled
#: doc/classes/NavigationLink2D.xml
msgid "Whether this link is currently active. If [code]false[/code], [method NavigationServer2D.map_get_path] will ignore this link."
msgstr "Megadja, hogy a kapcsolat jelenleg aktív-e. Ha [code]false[/code], a [method NavigationServer2D.map_get_path] figyelmen kívül hagyja ezt a kapcsolatot."

#. NavigationLink2D.end_position
#: doc/classes/NavigationLink2D.xml
msgid "Ending position of the link.\nThis position will search out the nearest polygon in the navigation mesh to attach to.\nThe distance the link will search is controlled by [method NavigationServer2D.map_set_link_connection_radius]."
msgstr "A kapcsolat végpozíciója.\nEz a pozíció a legközelebbi navigációs sokszöget keresi, amelyhez a kapcsolat csatlakozhat.\nA keresés távolságát a [method NavigationServer2D.map_set_link_connection_radius] szabályozza."

#. NavigationLink2D.enter_cost
#: doc/classes/NavigationLink2D.xml
msgid "When pathfinding enters this link from another regions navigation mesh the [member enter_cost] value is added to the path distance for determining the shortest path."
msgstr "Amikor az útkeresés egy másik terület navigációs hálójából erre a kapcsolatra lép, a legrövidebb út megállapításához a [member enter_cost] értékét hozzáadja az út költségéhez."

#. NavigationLink2D.navigation_layers
#: doc/classes/NavigationLink2D.xml
msgid "A bitfield determining all navigation layers the link belongs to. These navigation layers will be checked when requesting a path with [method NavigationServer2D.map_get_path]."
msgstr "Bitmező, amely meghatározza, hogy a kapcsolat mely navigációs rétegekhez tartozik. Az útvonal lekérésekor a [method NavigationServer2D.map_get_path] ezeket a rétegeket is vizsgálja."

#. NavigationLink2D.start_position
#: doc/classes/NavigationLink2D.xml
msgid "Starting position of the link.\nThis position will search out the nearest polygon in the navigation mesh to attach to.\nThe distance the link will search is controlled by [method NavigationServer2D.map_set_link_connection_radius]."
msgstr "A kapcsolat kezdőpozíciója.\nEz a pozíció a legközelebbi navigációs sokszöget keresi, amelyhez a kapcsolat csatlakozhat.\nA keresés távolságát a [method NavigationServer2D.map_set_link_connection_radius] szabályozza."

#. NavigationLink2D.travel_cost
#: doc/classes/NavigationLink2D.xml
msgid "When pathfinding moves along the link the traveled distance is multiplied with [member travel_cost] for determining the shortest path."
msgstr "A kapcsolaton való áthaladáskor a megtett távolságot a [member travel_cost] értékével szorozza meg a rendszer a legrövidebb út kiszámításához."

#. NavigationObstacle2D.brief
#: doc/classes/NavigationObstacle2D.xml
msgid "2D obstacle used to affect navigation mesh baking or constrain velocities of avoidance controlled agents."
msgstr "2D-s akadály, amely befolyásolhatja a navigációs háló előállítását vagy korlátozhatja az akadályelkerülést használó ügynökök sebességét."

#. NavigationObstacle2D.description
#: doc/classes/NavigationObstacle2D.xml
msgid "An obstacle needs a navigation map and outline [member vertices] defined to work correctly. The outlines can not cross or overlap.\nObstacles can be included in the navigation mesh baking process when [member affect_navigation_mesh] is enabled. They do not add walkable geometry, instead their role is to discard other source geometry inside the shape. This can be used to prevent navigation mesh from appearing in unwanted places. If [member carve_navigation_mesh] is enabled the baked shape will not be affected by offsets of the navigation mesh baking, e.g. the agent radius.\nWith [member avoidance_enabled] the obstacle can constrain the avoidance velocities of avoidance using agents. If the obstacle's vertices are wound in clockwise order, avoidance agents will be pushed in by the obstacle, otherwise, avoidance agents will be pushed out. Obstacles using vertices and avoidance can warp to a new position but should not be moved every single frame as each change requires a rebuild of the avoidance map."
msgstr "A helyes működéshez az akadálynak navigációs térképre és a [member vertices] tulajdonságban meghatározott körvonalra van szüksége. A körvonalak nem keresztezhetik egymást és nem fedhetik át egymást.\nAz akadályok a navigációs háló előállításában is részt vehetnek, ha a [member affect_navigation_mesh] engedélyezett. Nem hoznak létre bejárható felületet; ehelyett az alakzatukon belüli forrásgeometriát kizárják. Így megakadályozható, hogy nem kívánt helyeken is létrejöjjön navigációs háló. Ha a [member carve_navigation_mesh] engedélyezett, a kivágott alakzatot nem befolyásolják a háló előállításának eltolásai, például az ügynök sugara.\nA [member avoidance_enabled] engedélyezésével az akadály korlátozhatja az akadályelkerülést használó ügynökök sebességét. Ha az akadály csúcsai az óramutató járásával egyező sorrendben következnek, az ügynököket befelé tereli, ellenkező esetben kifelé. A csúcsokkal meghatározott, akadályelkerülésben részt vevő akadály teleportálható új pozícióba, de nem ajánlott minden képkockában mozgatni, mert minden változás miatt újra kell építeni az akadályelkerülési térképet."

#. NavigationObstacle2D.get_avoidance_layer_value
#: doc/classes/NavigationObstacle2D.xml
msgid "Returns whether or not the specified layer of the [member avoidance_layers] bitmask is enabled, given a [param layer_number] between 1 and 32."
msgstr "Visszaadja, hogy a [member avoidance_layers] bitmaszk megadott rétege engedélyezett-e. A [param layer_number] 1 és 32 közé eshet."

#. NavigationObstacle2D.get_navigation_map
#: doc/classes/NavigationObstacle2D.xml
msgid "Returns the [RID] of the navigation map for this NavigationObstacle node. This function returns always the map set on the NavigationObstacle node and not the map of the abstract obstacle on the NavigationServer. If the obstacle map is changed directly with the NavigationServer API the NavigationObstacle node will not be aware of the map change. Use [method set_navigation_map] to change the navigation map for the NavigationObstacle and also update the obstacle on the NavigationServer."
msgstr "Visszaadja a NavigationObstacle csomópont navigációs térképének [RID] azonosítóját. Ez mindig a csomóponton beállított térképet adja vissza, nem pedig a NavigationServer kiszolgálón lévő absztrakt akadály térképét. Ha a térképet közvetlenül a NavigationServer API-jával módosítod, a NavigationObstacle csomópont nem értesül a változásról. A [method set_navigation_map] használatával a csomópont és a NavigationServer akadályának térképe is frissíthető."

#. NavigationObstacle2D.get_rid
#: doc/classes/NavigationObstacle2D.xml
msgid "Returns the [RID] of this obstacle on the [NavigationServer2D]."
msgstr "Visszaadja az akadály [NavigationServer2D] rendszerbeli [RID] azonosítóját."

#. NavigationObstacle2D.set_avoidance_layer_value
#: doc/classes/NavigationObstacle2D.xml
msgid "Based on [param value], enables or disables the specified layer in the [member avoidance_layers] bitmask, given a [param layer_number] between 1 and 32."
msgstr "A [param value] alapján engedélyezi vagy letiltja a [member avoidance_layers] bitmaszk megadott rétegét. A [param layer_number] 1 és 32 közé eshet."

#. NavigationObstacle2D.set_navigation_map
#: doc/classes/NavigationObstacle2D.xml
msgid "Sets the [RID] of the navigation map this NavigationObstacle node should use and also updates the [code]obstacle[/code] on the NavigationServer."
msgstr "Beállítja a navigációs térkép [RID] azonosítóját, amelyet ez a NavigationObstacle csomópont használjon, és frissíti a NavigationServer kiszolgálón lévő [code]obstacle[/code] objektumot is."

#. NavigationObstacle2D.affect_navigation_mesh
#: doc/classes/NavigationObstacle2D.xml
msgid "If enabled and parsed in a navigation mesh baking process the obstacle will discard source geometry inside its [member vertices] defined shape."
msgstr "Ha engedélyezett, és az akadályt a navigációs háló előállításakor feldolgozza a rendszer, a [member vertices] által meghatározott alakzaton belüli forrásgeometriát kizárja."

#. NavigationObstacle2D.avoidance_enabled
#: doc/classes/NavigationObstacle2D.xml
msgid "If [code]true[/code] the obstacle affects avoidance using agents."
msgstr "Ha [code]true[/code], az akadály befolyásolja az akadályelkerülést használó ügynökök mozgását."

#. NavigationObstacle2D.avoidance_layers
#: doc/classes/NavigationObstacle2D.xml
msgid "A bitfield determining the avoidance layers for this obstacle. Agents with a matching bit on the their avoidance mask will avoid this obstacle."
msgstr "Bitmező, amely meghatározza az akadály akadályelkerülési rétegeit. Azok az ügynökök kerülik el az akadályt, amelyek elkerülési maszkjában legalább egy megfelelő bit van."

#. NavigationObstacle2D.carve_navigation_mesh
#: doc/classes/NavigationObstacle2D.xml
msgid "If enabled the obstacle vertices will carve into the baked navigation mesh with the shape unaffected by additional offsets (e.g. agent radius).\nIt will still be affected by further postprocessing of the baking process, like edge and polygon simplification.\nRequires [member affect_navigation_mesh] to be enabled."
msgstr "Ha engedélyezett, az akadály csúcsai úgy vágnak ki területet az előállított navigációs hálóból, hogy az alakzatot nem módosítják a további eltolások (például az ügynök sugara).\nA későbbi utófeldolgozás, például az élek és sokszögek egyszerűsítése továbbra is hatással lehet rá.\nEhhez a [member affect_navigation_mesh] engedélyezése szükséges."

#. NavigationObstacle2D.radius
#: doc/classes/NavigationObstacle2D.xml
msgid "Sets the avoidance radius for the obstacle."
msgstr "Beállítja az akadályelkerüléshez használt akadálysugarat."

#. NavigationObstacle2D.velocity
#: doc/classes/NavigationObstacle2D.xml
msgid "Sets the wanted velocity for the obstacle so other agent's can better predict the obstacle if it is moved with a velocity regularly (every frame) instead of warped to a new position. Does only affect avoidance for the obstacles [member radius]. Does nothing for the obstacles static vertices."
msgstr "Beállítja az akadály kívánt sebességét, hogy a többi ügynök jobban előre jelezhesse a mozgását, amikor a helyzete minden képkockában sebesség alapján változik, és nem teleportálódik új pozícióba. Csak az akadály [member radius] sugarával történő akadályelkerülésre van hatása, a statikus csúcspontokra nincs."

#. NavigationObstacle2D.vertices
#: doc/classes/NavigationObstacle2D.xml
msgid "The outline vertices of the obstacle. If the vertices are winded in clockwise order agents will be pushed in by the obstacle, else they will be pushed out. Outlines can not be crossed or overlap. Should the vertices using obstacle be warped to a new position agent's can not predict this movement and may get trapped inside the obstacle."
msgstr "Az akadály körvonalának csúcsai. Ha a csúcsok óramutató járásával megegyező sorrendben következnek, az ügynököket befelé tereli, ellenkező esetben kifelé. A körvonalak nem keresztezhetik és nem fedhetik át egymást. Ha a csúcsokkal meghatározott akadály hirtelen új pozícióba kerül, az ügynökök nem tudják megjósolni a mozgását, és az akadály belsejében rekedhetnek."

#. PhysicsBody2D.brief
#: doc/classes/PhysicsBody2D.xml
msgid "Abstract base class for 2D game objects affected by physics."
msgstr "A fizika által befolyásolt 2D-s játékobjektumok absztrakt alaposztálya."

#. PhysicsBody2D.description
#: doc/classes/PhysicsBody2D.xml
msgid "[PhysicsBody2D] is an abstract base class for 2D game objects affected by physics. All 2D physics bodies inherit from it."
msgstr "A [PhysicsBody2D] a fizikai rendszer által befolyásolt 2D-s játékobjektumok absztrakt alaposztálya. Minden 2D-s fizikai test ebből származik."

#. PhysicsBody2D.add_collision_exception_with
#: doc/classes/PhysicsBody2D.xml
msgid "Adds a body to the list of bodies that this body can't collide with."
msgstr "Hozzáad egy testet azoknak a testeknek a listájához, amelyekkel ez a test nem ütközhet."

#. PhysicsBody2D.get_collision_exceptions
#: doc/classes/PhysicsBody2D.xml
msgid "Returns an array of nodes that were added as collision exceptions for this body."
msgstr "Visszaadja azoknak a csomópontoknak a tömbjét, amelyeket a test ütközési kivételei közé felvettek."

#. PhysicsBody2D.get_gravity
#: doc/classes/PhysicsBody2D.xml
msgid "Returns the gravity vector computed from all sources that can affect the body, including all gravity overrides from [Area2D] nodes and the global world gravity."
msgstr "Visszaadja a testre ható összes forrás alapján kiszámított gravitációvektort, beleértve az [Area2D] csomópontok gravitációs felülírásait és a világ általános gravitációját."

#. PhysicsBody2D.move_and_collide
#: doc/classes/PhysicsBody2D.xml
msgid "Moves the body along the vector [param motion]. In order to be frame rate independent in [method Node._physics_process] or [method Node._process], [param motion] should be computed using [code]delta[/code].\nReturns a [KinematicCollision2D], which contains information about the collision when stopped, or when touching another body along the motion.\nIf [param test_only] is [code]true[/code], the body does not move but the would-be collision information is given.\n[param safe_margin] is the extra margin used for collision recovery (see [member CharacterBody2D.safe_margin] for more details).\nIf [param recovery_as_collision] is [code]true[/code], any depenetration from the recovery phase is also reported as a collision; this is used e.g. by [CharacterBody2D] for improving floor detection during floor snapping."
msgstr "A testet a [param motion] vektor mentén mozgatja. A [method Node._physics_process] vagy [method Node._process] függvényben a képkockasebességtől független mozgáshoz a [param motion] értékét a [code]delta[/code] felhasználásával kell kiszámítani.\nVisszaad egy [KinematicCollision2D] objektumot, amely a megálláskor vagy a mozgás során egy másik test érintésekor bekövetkező ütközés adatait tartalmazza.\nHa a [param test_only] értéke [code]true[/code], a test nem mozdul el, de a várható ütközés adatai elérhetők.\nA [param safe_margin] az ütközésből való kiemeléshez használt további biztonsági távolság (részletek: [member CharacterBody2D.safe_margin]).\nHa a [param recovery_as_collision] értéke [code]true[/code], a helyreállítás közbeni átfedés-megszüntetést is ütközésként jelenti. Ezt például a [CharacterBody2D] használja a padló felismerésének javítására, amikor a testet a padlóhoz igazítja."

#. PhysicsBody2D.remove_collision_exception_with
#: doc/classes/PhysicsBody2D.xml
msgid "Removes a body from the list of bodies that this body can't collide with."
msgstr "Eltávolít egy testet azoknak a testeknek a listájáról, amelyekkel ez a test nem ütközhet."

#. PhysicsBody2D.test_move
#: doc/classes/PhysicsBody2D.xml
msgid "Checks for collisions without moving the body. In order to be frame rate independent in [method Node._physics_process] or [method Node._process], [param motion] should be computed using [code]delta[/code].\nVirtually sets the node's position, scale and rotation to that of the given [Transform2D], then tries to move the body along the vector [param motion]. Returns [code]true[/code] if a collision would stop the body from moving along the whole path.\n[param collision] is an optional object of type [KinematicCollision2D], which contains additional information about the collision when stopped, or when touching another body along the motion.\n[param safe_margin] is the extra margin used for collision recovery (see [member CharacterBody2D.safe_margin] for more details).\nIf [param recovery_as_collision] is [code]true[/code], any depenetration from the recovery phase is also reported as a collision; this is useful for checking whether the body would [i]touch[/i] any other bodies."
msgstr "Ütközéseket vizsgál a test tényleges mozgatása nélkül. A [method Node._physics_process] vagy [method Node._process] függvényben a képkockasebességtől független mozgáshoz a [param motion] értékét a [code]delta[/code] használatával kell kiszámítani.\nA csomópont pozícióját, méretarányát és elforgatását ideiglenesen a megadott [Transform2D] értékre állítja, majd megpróbálja a testet a [param motion] vektor mentén elmozdítani. [code]true[/code] értéket ad vissza, ha az ütközés a teljes út bejárását megakadályozná.\nA [param collision] opcionális [KinematicCollision2D] objektum, amely az ütközésről további információkat tartalmaz.\nA [param safe_margin] az ütközésből való kiemeléshez használt további biztonsági távolság (részletek: [member CharacterBody2D.safe_margin]).\nHa a [param recovery_as_collision] értéke [code]true[/code], a helyreállítás közbeni átfedés-megszüntetést is ütközésként jelenti. Ez akkor hasznos, ha ellenőrizni kell, hogy a test [i]érintene-e[/i] más testeket."

#. NavigationPathQueryParameters2D.brief
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "Provides parameters for 2D navigation path queries."
msgstr "A 2D-s navigációs útvonal-lekérdezések paramétereit biztosítja."

#. NavigationPathQueryParameters2D.description
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "By changing various properties of this object, such as the start and target position, you can configure path queries to the [NavigationServer2D]."
msgstr "Az objektum tulajdonságainak, például a kezdő- és célpozíciójának módosításával konfigurálhatod a [NavigationServer2D] számára küldött útvonal-lekérdezéseket."

#. NavigationPathQueryParameters2D.excluded_regions
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The list of region [RID]s that will be excluded from the path query. Use [method NavigationRegion2D.get_rid] to get the [RID] associated with a [NavigationRegion2D] node.\n[b]Note:[/b] The returned array is copied and any changes to it will not update the original property value. To update the value you need to modify the returned array, and then set it to the property again."
msgstr "A lekérdezésből kizárt navigációs területek [RID] azonosítóinak listája. A [NavigationRegion2D] csomóponthoz tartozó [RID] azonosítót a [method NavigationRegion2D.get_rid] segítségével kérdezheted le.\n[b]Megjegyzés:[/b] A visszaadott tömb másolat, így a benne végzett módosítások nem frissítik az eredeti tulajdonságot. Az érték megváltoztatásához módosítsd a visszaadott tömböt, majd rendeld hozzá újra a tulajdonsághoz."

#. NavigationPathQueryParameters2D.included_regions
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The list of region [RID]s that will be included by the path query. Use [method NavigationRegion2D.get_rid] to get the [RID] associated with a [NavigationRegion2D] node. If left empty all regions are included. If a region ends up being both included and excluded at the same time it will be excluded.\n[b]Note:[/b] The returned array is copied and any changes to it will not update the original property value. To update the value you need to modify the returned array, and then set it to the property again."
msgstr "A lekérdezésbe bevont navigációs területek [RID] azonosítóinak listája. A [NavigationRegion2D] csomóponthoz tartozó [RID] azonosítót a [method NavigationRegion2D.get_rid] segítségével kérdezheted le. Üres lista esetén minden terület használható. Ha egy terület egyszerre szerepel a bevont és a kizárt listán, a kizárás élvez elsőbbséget.\n[b]Megjegyzés:[/b] A visszaadott tömb másolat, így a benne végzett módosítások nem frissítik az eredeti tulajdonságot. Az érték megváltoztatásához módosítsd a visszaadott tömböt, majd rendeld hozzá újra a tulajdonsághoz."

#. NavigationPathQueryParameters2D.map
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The navigation map [RID] used in the path query."
msgstr "Az útvonal-lekérdezéshez használt navigációs térkép [RID] azonosítója."

#. NavigationPathQueryParameters2D.metadata_flags
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "Additional information to include with the navigation path."
msgstr "Az útvonal eredményéhez csatolandó további információkat határozza meg."

#. NavigationPathQueryParameters2D.navigation_layers
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The navigation layers the query will use (as a bitmask)."
msgstr "A lekérdezésben használt navigációs rétegek bitmaszkja."

#. NavigationPathQueryParameters2D.path_return_max_length
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The maximum allowed length of the returned path in world units. A path will be clipped when going over this length. A value of [code]0[/code] or below counts as disabled."
msgstr "A visszaadott útvonal legnagyobb megengedett hossza világkoordináta-egységekben. Az útvonalat a rendszer levágja, ha túllépi ezt az értéket. A [code]0[/code] vagy annál kisebb érték kikapcsolja a korlátozást."

#. NavigationPathQueryParameters2D.path_return_max_radius
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The maximum allowed radius in world units that the returned path can be from the path start. The path will be clipped when going over this radius. A value of [code]0[/code] or below counts as disabled.\n[b]Note:[/b] This will perform a circle shaped clip operation on the path with the first path position being the circle's center position."
msgstr "A visszaadott útvonal pontjainak legnagyobb megengedett távolsága az útvonal kezdőpontjától világkoordináta-egységekben. Ha az útvonal túllépi ezt a sugarat, a rendszer levágja. A [code]0[/code] vagy annál kisebb érték kikapcsolja a korlátozást.\n[b]Megjegyzés:[/b] A rendszer kör alakú kivágást alkalmaz az útvonalra, a kör középpontja az útvonal első pozíciója."

#. NavigationPathQueryParameters2D.path_search_max_distance
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The maximum distance a searched polygon can be away from the start polygon before the pathfinding cancels the search for a path to the (possibly unreachable or very far away) target position polygon. In this case the pathfinding resets and builds a path from the start polygon to the polygon that was found closest to the target position so far. A value of [code]0[/code] or below counts as unlimited. In case of unlimited the pathfinding will search all polygons connected with the start polygon until either the target position polygon is found or all available polygon search options are exhausted."
msgstr "Az a legnagyobb távolság, amennyire a vizsgált sokszög a kezdő sokszögtől lehet, mielőtt az útkeresés megszakítja a célpont sokszögéhez vezető út keresését (ha az esetleg nem érhető el vagy nagyon messze van). Ilyenkor az útkeresés újrakezdődik, és a kezdő sokszögtől az addig megtalált, célponthoz legközelebbi sokszögig épít útvonalat. A [code]0[/code] vagy kisebb érték korlátlan keresést jelent. Korlátlan esetben minden, a kezdő sokszöggel összekötött sokszöget megvizsgál, amíg a célpont sokszögét meg nem találja, vagy az összes lehetséges vizsgálatot el nem végzi."

#. NavigationPathQueryParameters2D.path_search_max_polygons
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The maximum number of polygons that are searched before the pathfinding cancels the search for a path to the (possibly unreachable or very far away) target position polygon. In this case the pathfinding resets and builds a path from the start polygon to the polygon that was found closest to the target position so far. A value of [code]0[/code] or below counts as unlimited. In case of unlimited the pathfinding will search all polygons connected with the start polygon until either the target position polygon is found or all available polygon search options are exhausted."
msgstr "A megvizsgálható sokszögek legnagyobb száma, amelynél az útkeresés megszakítja a célpont sokszögéhez vezető út keresését (ha a célpont esetleg elérhetetlen vagy nagyon messze van). Ilyenkor az útkeresés újrakezdődik, és a kezdő sokszögtől az addig megtalált, célponthoz legközelebbi sokszögig épít útvonalat. A [code]0[/code] vagy kisebb érték korlátlan keresést jelent. Korlátlan esetben minden, a kezdő sokszöggel összekötött sokszöget megvizsgál, amíg a célpont sokszögét meg nem találja, vagy az összes lehetséges vizsgálatot el nem végzi."

#. NavigationPathQueryParameters2D.simplify_epsilon
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The path simplification amount in worlds units."
msgstr "Az útvonal egyszerűsítésének mértéke világkoordináta-egységekben."

#. NavigationPathQueryParameters2D.simplify_path
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "If [code]true[/code] a simplified version of the path will be returned with less critical path points removed. The simplification amount is controlled by [member simplify_epsilon]. The simplification uses a variant of Ramer-Douglas-Peucker algorithm for curve point decimation.\nPath simplification can be helpful to mitigate various path following issues that can arise with certain agent types and script behaviors. E.g. \"steering\" agents or avoidance in \"open fields\"."
msgstr "Ha [code]true[/code], az útvonal egyszerűsített változatát adja vissza, amelyből eltávolítja a kevésbé fontos útvonali pontokat. Az egyszerűsítés mértékét a [member simplify_epsilon] szabályozza. A pontok ritkításához a Ramer–Douglas–Peucker-algoritmus egyik változatát használja.\nAz útvonal egyszerűsítése segíthet mérsékelni egyes ügynöktípusok és scriptszerű mozgásvezérlések útvonalkövetési problémáit, például irányítást igénylő ügynököknél vagy nyílt területen történő akadályelkerülésnél."

#. NavigationPathQueryParameters2D.start_position
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The pathfinding start position in global coordinates."
msgstr "Az útkeresés kiindulópontja globális koordinátákban."

#. NavigationPathQueryParameters2D.target_position
#: doc/classes/NavigationPathQueryParameters2D.xml
msgid "The pathfinding target position in global coordinates."
msgstr "Az útkeresés célpontja globális koordinátákban."

#. NavigationPathQueryResult2D.brief
#: doc/classes/NavigationPathQueryResult2D.xml
msgid "Represents the result of a 2D pathfinding query."
msgstr "Egy 2D-s útkeresési lekérdezés eredményét tárolja."

#. NavigationPathQueryResult2D.description
#: doc/classes/NavigationPathQueryResult2D.xml
msgid "This class stores the result of a 2D navigation path query from the [NavigationServer2D]."
msgstr "Ez az osztály a [NavigationServer2D] által végrehajtott 2D-s navigációs útvonal-lekérdezés eredményét tárolja."

#. NavigationPathQueryResult2D.reset
#: doc/classes/NavigationPathQueryResult2D.xml
msgid "Reset the result object to its initial state. This is useful to reuse the object across multiple queries."
msgstr "Visszaállítja az eredményobjektumot a kezdeti állapotába. Ez akkor hasznos, ha az objektumot több lekérdezéshez szeretnéd újra felhasználni."

#. NavigationPathQueryResult2D.path
#: doc/classes/NavigationPathQueryResult2D.xml
msgid "The resulting path array from the navigation query. All path array positions are in global coordinates. Without customized query parameters this is the same path as returned by [method NavigationServer2D.map_get_path]."
msgstr "A navigációs lekérdezés eredményeként kapott útvonaltömb. A tömb minden pozíciója globális koordinátákban értendő. Egyéni lekérdezési paraméterek nélkül ez ugyanaz az útvonal, mint amelyet a [method NavigationServer2D.map_get_path] ad vissza."

#. NavigationPathQueryResult2D.path_length
#: doc/classes/NavigationPathQueryResult2D.xml
msgid "Returns the length of the path."
msgstr "Visszaadja az útvonal hosszát."

#. NavigationPathQueryResult2D.path_owner_ids
#: doc/classes/NavigationPathQueryResult2D.xml
msgid "The [code]ObjectID[/code]s of the [Object]s which manage the regions and links each point of the path goes through."
msgstr "Az útvonal minden pontján áthaladó területeket és kapcsolatokat kezelő [Object] objektumok [code]ObjectID[/code] azonosítói."

#. NavigationPathQueryResult2D.path_rids
#: doc/classes/NavigationPathQueryResult2D.xml
msgid "The [RID]s of the regions and links that each point of the path goes through."
msgstr "Az útvonal egyes pontjaihoz tartozó navigációs területek és kapcsolatok [RID] azonosítói."

#. NavigationPathQueryResult2D.path_types
#: doc/classes/NavigationPathQueryResult2D.xml
msgid "The type of navigation primitive (region or link) that each point of the path goes through."
msgstr "Az útvonal egyes pontjaihoz tartozó navigációs elemek típusa (terület vagy kapcsolat)."

#. KinematicCollision2D.brief
#: doc/classes/KinematicCollision2D.xml
msgid "Holds collision data from the movement of a [PhysicsBody2D]."
msgstr "Egy [PhysicsBody2D] mozgása során bekövetkezett ütközés adatait tárolja."

#. KinematicCollision2D.description
#: doc/classes/KinematicCollision2D.xml
msgid "Holds collision data from the movement of a [PhysicsBody2D], usually from [method PhysicsBody2D.move_and_collide]. When a [PhysicsBody2D] is moved, it stops if it detects a collision with another body. If a collision is detected, a [KinematicCollision2D] object is returned.\nThe collision data includes the colliding object, the remaining motion, and the collision position. This data can be used to determine a custom response to the collision."
msgstr "Egy [PhysicsBody2D] mozgása során bekövetkezett ütközés adatait tárolja, rendszerint a [method PhysicsBody2D.move_and_collide] metódus eredményeként. Amikor egy [PhysicsBody2D] mozog, megáll, ha egy másik testtel ütközést észlel. Ütközés esetén egy [KinematicCollision2D] objektumot ad vissza.\nAz ütközési adatok között megtalálható az ütköző objektum, a hátralévő mozgás és az ütközés pozíciója. Ezekből egyéni ütközési reakció alakítható ki."

#. KinematicCollision2D.get_angle
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the collision angle according to [param up_direction], which is [constant Vector2.UP] by default. This value is always positive."
msgstr "Visszaadja az ütközési szöget a [param up_direction] irányhoz viszonyítva, amely alapértelmezés szerint [constant Vector2.UP]. Az érték mindig pozitív."

#. KinematicCollision2D.get_collider
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the colliding body's attached [Object]."
msgstr "Visszaadja az ütköző testhez kapcsolt [Object] objektumot."

#. KinematicCollision2D.get_collider_id
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the unique instance ID of the colliding body's attached [Object]. See [method Object.get_instance_id]."
msgstr "Visszaadja az ütköző testhez kapcsolt [Object] objektum egyedi példányazonosítóját. Lásd: [method Object.get_instance_id]."

#. KinematicCollision2D.get_collider_rid
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the colliding body's [RID] used by the [PhysicsServer2D]."
msgstr "Visszaadja az ütköző test [PhysicsServer2D] által használt [RID] azonosítóját."

#. KinematicCollision2D.get_collider_shape
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the colliding body's shape."
msgstr "Visszaadja az ütköző test alakzatát."

#. KinematicCollision2D.get_collider_shape_index
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the colliding body's shape index. See [CollisionObject2D]."
msgstr "Visszaadja az ütköző test alakzatának indexét. Lásd: [CollisionObject2D]."

#. KinematicCollision2D.get_collider_velocity
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the colliding body's velocity."
msgstr "Visszaadja az ütköző test sebességét."

#. KinematicCollision2D.get_depth
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the colliding body's length of overlap along the collision normal."
msgstr "Visszaadja az ütköző testek átfedésének hosszát az ütközési normálvektor mentén."

#. KinematicCollision2D.get_local_shape
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the moving object's colliding shape."
msgstr "Visszaadja a mozgó objektum ütközésben részt vevő alakzatát."

#. KinematicCollision2D.get_normal
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the colliding body's shape's normal at the point of collision."
msgstr "Visszaadja az ütköző test alakzatának normálvektorát az ütközési pontban."

#. KinematicCollision2D.get_position
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the point of collision in global coordinates."
msgstr "Visszaadja az ütközési pontot globális koordinátákban."

#. KinematicCollision2D.get_remainder
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the moving object's remaining movement vector."
msgstr "Visszaadja a mozgó objektum ütközés után hátralévő mozgásvektorát."

#. KinematicCollision2D.get_travel
#: doc/classes/KinematicCollision2D.xml
msgid "Returns the moving object's travel before collision."
msgstr "Visszaadja a mozgó objektum ütközés előtti elmozdulását."

#. CollisionPolygon2D.brief
#: doc/classes/CollisionPolygon2D.xml
msgid "A node that provides a polygon shape to a [CollisionObject2D] parent."
msgstr "Sokszög alakú ütközési alakzatot ad a szülő [CollisionObject2D] csomóponthoz."

#. CollisionPolygon2D.description
#: doc/classes/CollisionPolygon2D.xml
msgid "A node that provides a polygon shape to a [CollisionObject2D] parent and allows it to be edited. The polygon can be concave or convex. This can give a detection shape to an [Area2D], turn a [PhysicsBody2D] into a solid object, or give a hollow shape to a [StaticBody2D].\n[b]Warning:[/b] A non-uniformly scaled [CollisionPolygon2D] will likely not behave as expected. Make sure to keep its scale the same on all axes and adjust its polygon instead."
msgstr "Olyan csomópont, amely szerkeszthető sokszög alakú ütközési alakzatot ad egy szülő [CollisionObject2D] csomóponthoz. A sokszög lehet konkáv vagy konvex. Használható [Area2D] érzékelési terület alakzataként, [PhysicsBody2D] szilárd testének alakzataként, vagy [StaticBody2D] üreges alakzatának létrehozására.\n[b]Figyelmeztetés:[/b] A nem egyenletes méretarányú [CollisionPolygon2D] valószínűleg nem a vártnak megfelelően működik. A méretarány minden tengelyen legyen azonos, és inkább a sokszög alakját módosítsd."

#. CollisionPolygon2D.build_mode
#: doc/classes/CollisionPolygon2D.xml
msgid "Collision build mode."
msgstr "Az ütközési alakzat létrehozási módja."

#. CollisionPolygon2D.disabled
#: doc/classes/CollisionPolygon2D.xml
msgid "If [code]true[/code], no collisions will be detected. This property should be changed with [method Object.set_deferred]."
msgstr "Ha [code]true[/code], a rendszer nem észlel ütközéseket. Ezt a tulajdonságot a [method Object.set_deferred] segítségével ajánlott módosítani."

#. CollisionPolygon2D.one_way_collision
#: doc/classes/CollisionPolygon2D.xml
msgid "If [code]true[/code], only edges that face up, relative to [CollisionPolygon2D]'s rotation, will collide with other objects.\n[b]Note:[/b] This property has no effect if this [CollisionPolygon2D] is a child of an [Area2D] node.\n[b]Note:[/b] The one way collision direction can be configured by setting [member one_way_collision_direction]."
msgstr "Ha [code]true[/code], csak a [CollisionPolygon2D] elforgatásához viszonyítva felfelé néző élek ütköznek más objektumokkal.\n[b]Megjegyzés:[/b] A tulajdonságnak nincs hatása, ha a [CollisionPolygon2D] egy [Area2D] csomópont gyermeke.\n[b]Megjegyzés:[/b] Az egyirányú ütközés irányát a [member one_way_collision_direction] beállításával adhatod meg."

#. CollisionPolygon2D.one_way_collision_margin
#: doc/classes/CollisionPolygon2D.xml
msgid "The margin used for one-way collision (in pixels). Higher values will make the shape thicker, and work better for colliders that enter the polygon at a high velocity."
msgstr "Az egyirányú ütközéshez használt ráhagyás (képpontban). A nagyobb érték vastagabbá teszi az alakzatot, és segít a nagy sebességgel érkező ütközők kezelésében."

#. CollisionPolygon2D.polygon
#: doc/classes/CollisionPolygon2D.xml
msgid "The polygon's list of vertices. Each point will be connected to the next, and the final point will be connected to the first.\n[b]Note:[/b] The returned vertices are in the local coordinate space of the given [CollisionPolygon2D]."
msgstr "A sokszög csúcsainak listája. Minden pont a következőhöz kapcsolódik, az utolsó pedig az elsőhöz.\n[b]Megjegyzés:[/b] A visszaadott csúcsok a megadott [CollisionPolygon2D] helyi koordinátarendszerében értendők."

#. RemoteTransform2D.brief
#: doc/classes/RemoteTransform2D.xml
msgid "RemoteTransform2D pushes its own [Transform2D] to another [Node2D] derived node in the scene."
msgstr "A RemoteTransform2D saját [Transform2D] transzformációját átadja a jelenet egy másik [Node2D] leszármazott csomópontjának."

#. RemoteTransform2D.description
#: doc/classes/RemoteTransform2D.xml
msgid "RemoteTransform2D pushes its own [Transform2D] to another [Node2D] derived node (called the remote node) in the scene.\nIt can be set to update another node's position, rotation and/or scale. It can use either global or local coordinates."
msgstr "A RemoteTransform2D saját [Transform2D] transzformációját átadja a jelenet egy másik, [Node2D] osztályból származó csomópontjának (a távoli csomópontnak).\nBeállítható, hogy a másik csomópont pozícióját, elforgatását és/vagy méretarányát frissítse. Globális vagy helyi koordinátákat is használhat."

#. RemoteTransform2D.force_update_cache
#: doc/classes/RemoteTransform2D.xml
msgid "[RemoteTransform2D] caches the remote node. It may not notice if the remote node disappears; [method force_update_cache] forces it to update the cache again."
msgstr "A [RemoteTransform2D] gyorsítótárazza a távoli csomópontot. Előfordulhat, hogy nem érzékeli annak eltűnését; a [method force_update_cache] újból frissíti a gyorsítótárat."

#. RemoteTransform2D.remote_path
#: doc/classes/RemoteTransform2D.xml
msgid "The [NodePath] to the remote node, relative to the RemoteTransform2D's position in the scene."
msgstr "A távoli csomópont [NodePath] elérési útja a RemoteTransform2D jelenetbeli pozíciójához viszonyítva."

#. RemoteTransform2D.update_position
#: doc/classes/RemoteTransform2D.xml
msgid "If [code]true[/code], the remote node's position is updated."
msgstr "Ha [code]true[/code], a távoli csomópont pozíciója frissül."

#. RemoteTransform2D.update_rotation
#: doc/classes/RemoteTransform2D.xml
msgid "If [code]true[/code], the remote node's rotation is updated."
msgstr "Ha [code]true[/code], a távoli csomópont elforgatása frissül."

#. RemoteTransform2D.update_scale
#: doc/classes/RemoteTransform2D.xml
msgid "If [code]true[/code], the remote node's scale is updated."
msgstr "Ha [code]true[/code], a távoli csomópont méretaránya frissül."

#. RemoteTransform2D.use_global_coordinates
#: doc/classes/RemoteTransform2D.xml
msgid "If [code]true[/code], global coordinates are used. If [code]false[/code], local coordinates are used."
msgstr "Ha [code]true[/code], globális koordinátákat használ; ha [code]false[/code], helyi koordinátákat."

#. PointLight2D.brief
#: doc/classes/PointLight2D.xml
msgid "Positional 2D light source."
msgstr "Pontszerű 2D-s fényforrás."

#. PointLight2D.description
#: doc/classes/PointLight2D.xml
msgid "Casts light in a 2D environment. This light's shape is defined by a (usually grayscale) texture."
msgstr "Fényt bocsát ki egy 2D-s környezetben. A fény alakját egy (általában szürkeárnyalatos) textúra határozza meg."

#. PointLight2D.height
#: doc/classes/PointLight2D.xml
msgid "The height of the light. Used with 2D normal mapping. The units are in pixels, e.g. if the height is 100, then it will illuminate an object 100 pixels away at a 45° angle to the plane."
msgstr "A fény magassága. A 2D-s normálleképezésnél használatos. Mértékegysége képpont: például 100-as magasságnál a fény a síkhoz képest 45°-os szögben egy 100 képpont távolságra lévő objektumot világít meg."

#. PointLight2D.offset
#: doc/classes/PointLight2D.xml
msgid "The offset of the light's [member texture]."
msgstr "A fény [member texture] textúrájának eltolása."

#. PointLight2D.texture
#: doc/classes/PointLight2D.xml
msgid "[Texture2D] used for the light's appearance."
msgstr "A fény alakját és megjelenését meghatározó [Texture2D] textúra."

#. PointLight2D.texture_scale
#: doc/classes/PointLight2D.xml
msgid "The [member texture]'s scale factor."
msgstr "A [member texture] méretezési tényezője."

#. LightOccluder2D.brief
#: doc/classes/LightOccluder2D.xml
msgid "Occludes light cast by a Light2D, casting shadows."
msgstr "Kitakarja a Light2D által kibocsátott fényt, így árnyékot hoz létre."

#. LightOccluder2D.description
#: doc/classes/LightOccluder2D.xml
msgid "Occludes light cast by a Light2D, casting shadows. The LightOccluder2D must be provided with an [OccluderPolygon2D] in order for the shadow to be computed."
msgstr "Kitakarja a Light2D által kibocsátott fényt, így árnyékot hoz létre. Az árnyék kiszámításához a LightOccluder2D csomóponthoz [OccluderPolygon2D] erőforrást kell rendelni."

#. LightOccluder2D.occluder
#: doc/classes/LightOccluder2D.xml
msgid "The [OccluderPolygon2D] used to compute the shadow."
msgstr "Az árnyék kiszámításához használt [OccluderPolygon2D]."

#. LightOccluder2D.occluder_light_mask
#: doc/classes/LightOccluder2D.xml
msgid "The LightOccluder2D's occluder light mask. The LightOccluder2D will cast shadows only from Light2D(s) that have the same light mask(s)."
msgstr "A LightOccluder2D fénykitakarási maszkja. Csak azoknak a Light2D fényforrásoknak a fényéből vet árnyékot, amelyek fényrétegmaszkjával legalább egy közös réteget használ."

#. LightOccluder2D.sdf_collision
#: doc/classes/LightOccluder2D.xml
msgid "If enabled, the occluder will be part of a real-time generated signed distance field that can be used in custom shaders."
msgstr "Ha engedélyezett, a fénykitakaró részt vesz a valós időben előállított előjeles távolságmező (SDF) létrehozásában, amely egyéni shaderekben használható."

#. CanvasModulate.brief
#: doc/classes/CanvasModulate.xml
msgid "A node that applies a color tint to a canvas."
msgstr "Olyan csomópont, amely színárnyalatot alkalmaz egy vászonra."

#. CanvasModulate.description
#: doc/classes/CanvasModulate.xml
msgid "[CanvasModulate] applies a color tint to all nodes on a canvas. Only one can be used to tint a canvas, but [CanvasLayer]s can be used to render things independently."
msgstr "A [CanvasModulate] színárnyalatot alkalmaz a vászon összes csomópontjára. Egy vászon színezésére csak egy ilyen csomópont használható, de a [CanvasLayer] csomópontokkal egyes elemek külön is megjeleníthetők."

#. CanvasModulate.color
#: doc/classes/CanvasModulate.xml
msgid "The tint color to apply."
msgstr "A vászonra alkalmazandó színezőszín."

#. Light2D.brief
#: doc/classes/Light2D.xml
msgid "Casts light in a 2D environment."
msgstr "Fényt bocsát ki egy 2D-s környezetben."

#. Light2D.description
#: doc/classes/Light2D.xml
msgid "Casts light in a 2D environment. A light is defined as a color, an energy value, a mode (see constants), and various other parameters (range and shadows-related)."
msgstr "Fényt bocsát ki egy 2D-s környezetben. A fény tulajdonságait a színe, az energiája, a módja (lásd az állandókat), valamint több további paraméter, például a hatótávolság és az árnyékbeállítások határozzák meg."

#. Light2D.get_height
#: doc/classes/Light2D.xml
msgid "Returns the light's height, which is used in 2D normal mapping. See [member PointLight2D.height] and [member DirectionalLight2D.height]."
msgstr "Visszaadja a fény 2D-s normálleképezésnél használt magasságát. Lásd: [member PointLight2D.height] és [member DirectionalLight2D.height]."

#. Light2D.set_height
#: doc/classes/Light2D.xml
msgid "Sets the light's height, which is used in 2D normal mapping. See [member PointLight2D.height] and [member DirectionalLight2D.height]."
msgstr "Beállítja a fény 2D-s normálleképezésnél használt magasságát. Lásd: [member PointLight2D.height] és [member DirectionalLight2D.height]."

#. Light2D.blend_mode
#: doc/classes/Light2D.xml
msgid "The Light2D's blend mode."
msgstr "A Light2D keverési módja."

#. Light2D.color
#: doc/classes/Light2D.xml
msgid "The Light2D's [Color]."
msgstr "A Light2D [Color] színe."

#. Light2D.editor_only
#: doc/classes/Light2D.xml
msgid "If [code]true[/code], Light2D will only appear when editing the scene."
msgstr "Ha [code]true[/code], a Light2D csak a jelenet szerkesztésekor látható."

#. Light2D.enabled
#: doc/classes/Light2D.xml
msgid "If [code]true[/code], Light2D will emit light."
msgstr "Ha [code]true[/code], a Light2D fényt bocsát ki."

#. Light2D.energy
#: doc/classes/Light2D.xml
msgid "The Light2D's energy value. The larger the value, the stronger the light."
msgstr "A Light2D fényenergiája. Minél nagyobb az értéke, annál erősebb a fény."

#. Light2D.range_item_cull_mask
#: doc/classes/Light2D.xml
msgid "The layer mask. Only objects with a matching [member CanvasItem.light_mask] will be affected by the Light2D. See also [member shadow_item_cull_mask], which affects which objects can cast shadows.\n[b]Note:[/b] [member range_item_cull_mask] is ignored by [DirectionalLight2D], which will always light a 2D node regardless of the 2D node's [member CanvasItem.light_mask]."
msgstr "Rétegmaszk. A Light2D csak azokat az objektumokat világítja meg, amelyek [member CanvasItem.light_mask] tulajdonsága illeszkedik a maszkhoz. Lásd még: [member shadow_item_cull_mask], amely az árnyékvetésre képes objektumokat szabályozza.\n[b]Megjegyzés:[/b] A [DirectionalLight2D] figyelmen kívül hagyja a [member range_item_cull_mask] értékét, és a 2D-s csomópontok [member CanvasItem.light_mask] tulajdonságától függetlenül megvilágítja őket."

#. Light2D.range_layer_max
#: doc/classes/Light2D.xml
msgid "Maximum layer value of objects that are affected by the Light2D."
msgstr "A Light2D által megvilágítható objektumok legnagyobb rétegindexe."

#. Light2D.range_layer_min
#: doc/classes/Light2D.xml
msgid "Minimum layer value of objects that are affected by the Light2D."
msgstr "A Light2D által megvilágítható objektumok legkisebb rétegindexe."

#. Light2D.range_z_max
#: doc/classes/Light2D.xml
msgid "Maximum [code]z[/code] value of objects that are affected by the Light2D."
msgstr "A Light2D által megvilágított objektumok legnagyobb [code]z[/code] értéke."

#. Light2D.range_z_min
#: doc/classes/Light2D.xml
msgid "Minimum [code]z[/code] value of objects that are affected by the Light2D."
msgstr "A Light2D által megvilágított objektumok legkisebb [code]z[/code] értéke."

#. Light2D.shadow_color
#: doc/classes/Light2D.xml
msgid "[Color] of shadows cast by the Light2D."
msgstr "A Light2D által vetett árnyékok [Color] színe."

#. Light2D.shadow_enabled
#: doc/classes/Light2D.xml
msgid "If [code]true[/code], the Light2D will cast shadows."
msgstr "Ha [code]true[/code], a Light2D árnyékot vet."

#. Light2D.shadow_filter
#: doc/classes/Light2D.xml
msgid "Shadow filter type."
msgstr "Az árnyékszűrő típusa."

#. Light2D.shadow_filter_smooth
#: doc/classes/Light2D.xml
msgid "Smoothing value for shadows. Higher values will result in softer shadows, at the cost of visible streaks that can appear in shadow rendering. [member shadow_filter_smooth] only has an effect if [member shadow_filter] is [constant SHADOW_FILTER_PCF5] or [constant SHADOW_FILTER_PCF13]."
msgstr "Az árnyékok simításának mértéke. Nagyobb értéknél lágyabbak az árnyékok, de látható csíkozódás jelentkezhet az árnyékmegjelenítésben. A [member shadow_filter_smooth] csak akkor hatásos, ha a [member shadow_filter] értéke [constant SHADOW_FILTER_PCF5] vagy [constant SHADOW_FILTER_PCF13]."

#. Light2D.shadow_item_cull_mask
#: doc/classes/Light2D.xml
msgid "The shadow mask. Used with [LightOccluder2D] to cast shadows. Only occluders with a matching [member CanvasItem.light_mask] will cast shadows. See also [member range_item_cull_mask], which affects which objects can [i]receive[/i] the light."
msgstr "Árnyékmaszk. A [LightOccluder2D] csomópontokkal együtt szabályozza az árnyékvetést. Csak azok a fénykitakarók vetnek árnyékot, amelyek [member CanvasItem.light_mask] értéke illeszkedik a maszkhoz. Lásd még: [member range_item_cull_mask], amely azt szabályozza, mely objektumok [i]kaphatnak[/i] fényt."

#. OccluderPolygon2D.brief
#: doc/classes/OccluderPolygon2D.xml
msgid "Defines a 2D polygon for LightOccluder2D."
msgstr "2D-s sokszöget határoz meg a LightOccluder2D számára."

#. OccluderPolygon2D.description
#: doc/classes/OccluderPolygon2D.xml
msgid "Editor facility that helps you draw a 2D polygon used as resource for [LightOccluder2D]."
msgstr "A szerkesztőben rajzolható 2D-s sokszög, amely erőforrásként szolgál a [LightOccluder2D] számára."

#. OccluderPolygon2D.closed
#: doc/classes/OccluderPolygon2D.xml
msgid "If [code]true[/code], closes the polygon. A closed OccluderPolygon2D occludes the light coming from any direction. An opened OccluderPolygon2D occludes the light only at its outline's direction."
msgstr "Ha [code]true[/code], a sokszög zárt. A zárt OccluderPolygon2D bármely irányból érkező fényt kitakar; a nyitott sokszög csak a körvonala irányának megfelelően takarja ki a fényt."

#. OccluderPolygon2D.cull_mode
#: doc/classes/OccluderPolygon2D.xml
msgid "The culling mode to use."
msgstr "Az alkalmazandó lapeldobási mód."

#. OccluderPolygon2D.polygon
#: doc/classes/OccluderPolygon2D.xml
msgid "A [Vector2] array with the index for polygon's vertices positions."
msgstr "A sokszög csúcsainak pozícióit tartalmazó [Vector2] tömb."

#. DirectionalLight2D.brief
#: doc/classes/DirectionalLight2D.xml
msgid "Directional 2D light from a distance."
msgstr "Távoli fényforrást szimuláló, párhuzamos sugarú 2D-s irányfény."

#. DirectionalLight2D.description
#: doc/classes/DirectionalLight2D.xml
msgid "A directional light is a type of [Light2D] node that models an infinite number of parallel rays covering the entire scene. It is used for lights with strong intensity that are located far away from the scene (for example: to model sunlight or moonlight).\nLight is emitted in the +Y direction of the node's global basis. For an unrotated light, this means that the light is emitted downwards. The position of the node is ignored; only the basis is used to determine light direction.\n[b]Note:[/b] [DirectionalLight2D] does not support light cull masks (but it supports shadow cull masks). It will always light up 2D nodes, regardless of the 2D node's [member CanvasItem.light_mask]."
msgstr "Az irányfény a [Light2D] egyik típusa: végtelen számú párhuzamos fénysugárral modellezi a teljes jelenetet megvilágító fényforrást. Nagy intenzitású, a jelenettől távol lévő fényekhez használható, például napsütés vagy holdfény megjelenítésére.\nA fény a csomópont globális bázisának +Y irányában terjed. Elforgatás nélkül ez lefelé irányuló megvilágítást jelent. A csomópont pozíciója nem befolyásolja a fényt; az irányt a globális bázis határozza meg.\n[b]Megjegyzés:[/b] A [DirectionalLight2D] nem támogatja a megvilágított elemek rétegmaszkját, az árnyékvetőkét azonban igen. A 2D-s csomópontokat azok [member CanvasItem.light_mask] értékétől függetlenül megvilágítja."

#. DirectionalLight2D.height
#: doc/classes/DirectionalLight2D.xml
msgid "The height of the light. Used with 2D normal mapping. Ranges from 0 (parallel to the plane) to 1 (perpendicular to the plane)."
msgstr "A fény magassága, amelyet a 2D-s normálleképezés használ. Értéke 0 (a síkkal párhuzamos fény) és 1 (a síkra merőleges fény) között lehet."

#. DirectionalLight2D.max_distance
#: doc/classes/DirectionalLight2D.xml
msgid "The maximum distance from the camera center objects can be before their shadows are culled (in pixels). Decreasing this value can prevent objects located outside the camera from casting shadows (while also improving performance). [member Camera2D.zoom] is not taken into account by [member max_distance], which means that at higher zoom values, shadows will appear to fade out sooner when zooming onto a given point."
msgstr "A kameraközépponttól mért legnagyobb távolság képpontban, amelyen túl az objektumok árnyékát a rendszer nem rajzolja ki. Az érték csökkentésével megakadályozható, hogy a kamerán kívüli objektumok árnyékot vessenek, és a teljesítmény is javulhat. A [member Camera2D.zoom] értékét a [member max_distance] nem veszi figyelembe, ezért nagyobb nagyítás esetén egy adott pontra közelítve az árnyékok hamarabb tűnhetnek el."

#. Parallax2D.brief
#: doc/classes/Parallax2D.xml
msgid "A node used to create a parallax scrolling background."
msgstr "Parallaxisgörgetésű háttér létrehozására szolgáló csomópont."

#. Parallax2D.description
#: doc/classes/Parallax2D.xml
msgid "A [Parallax2D] is used to create a parallax effect. It can move at a different speed relative to the camera movement using [member scroll_scale]. This creates an illusion of depth in a 2D game. If manual scrolling is desired, the [Camera2D] position can be ignored with [member ignore_camera_scroll].\n[b]Note:[/b] Any changes to this node's position made after it enters the scene tree will be overridden if [member ignore_camera_scroll] is [code]false[/code] or [member screen_offset] is modified."
msgstr "A [Parallax2D] parallaxis hatás létrehozására szolgál. A [member scroll_scale] segítségével a kamera mozgásától eltérő sebességgel mozoghat, így mélységérzetet kelt egy 2D-s játékban. Kézi görgetés esetén a [member ignore_camera_scroll] használatával figyelmen kívül hagyható a [Camera2D] pozíciója.\n[b]Megjegyzés:[/b] Ha a [member ignore_camera_scroll] értéke [code]false[/code], vagy megváltoztatod a [member screen_offset] értékét, a csomópont jelenetfába kerülése után kézzel végrehajtott pozíciómódosítások felülíródnak."

#. Parallax2D.autoscroll
#: doc/classes/Parallax2D.xml
msgid "Velocity at which the offset scrolls automatically, in pixels per second."
msgstr "Az eltolás automatikus görgetési sebessége képpont/másodpercben."

#. Parallax2D.follow_viewport
#: doc/classes/Parallax2D.xml
msgid "If [code]true[/code], this [Parallax2D] is offset by the current camera's position. If the [Parallax2D] is in a [CanvasLayer] separate from the current camera, it may be desired to match the value with [member CanvasLayer.follow_viewport_enabled]."
msgstr "Ha [code]true[/code], a [Parallax2D] eltolását az aktuális kamera pozíciója befolyásolja. Ha a [Parallax2D] az aktuális kamerától különböző [CanvasLayer] rétegen található, célszerű lehet ezt az értéket a [member CanvasLayer.follow_viewport_enabled] beállításhoz igazítani."

#. Parallax2D.ignore_camera_scroll
#: doc/classes/Parallax2D.xml
msgid "If [code]true[/code], [Parallax2D]'s position is not affected by the position of the camera."
msgstr "Ha [code]true[/code], a [Parallax2D] pozícióját nem befolyásolja a kamera helyzete."

#. Parallax2D.limit_begin
#: doc/classes/Parallax2D.xml
msgid "Top-left limits for scrolling to begin. If the camera is outside of this limit, the [Parallax2D] stops scrolling. Must be lower than [member limit_end] minus the viewport size to work."
msgstr "A görgetés kezdetének bal felső határa. Ha a kamera ezen a határon kívül van, a [Parallax2D] leállítja a görgetést. A helyes működéshez az értéknek kisebbnek kell lennie, mint a [member limit_end] és a nézet méretének különbsége."

#. Parallax2D.limit_end
#: doc/classes/Parallax2D.xml
msgid "Bottom-right limits for scrolling to end. If the camera is outside of this limit, the [Parallax2D] will stop scrolling. Must be higher than [member limit_begin] and the viewport size combined to work."
msgstr "A görgetés végének jobb alsó határa. Ha a kamera ezen a határon kívül van, a [Parallax2D] leállítja a görgetést. A helyes működéshez az értéknek nagyobbnak kell lennie, mint a [member limit_begin] és a nézet méretének összege."

#. Parallax2D.repeat_size
#: doc/classes/Parallax2D.xml
msgid "Repeats the [Texture2D] of each of this node's children and offsets them by this value. When scrolling, the node's position loops, giving the illusion of an infinite scrolling background if the values are larger than the screen size. If an axis is set to [code]0[/code], the [Texture2D] will not be repeated."
msgstr "Megismétli a csomópont gyermekeihez tartozó [Texture2D] textúrákat, a megadott értékkel eltolva azokat. Görgetéskor a csomópont pozíciója körbefordul, így a képernyőnél nagyobb értékekkel végtelennek tűnő, görgethető háttér hozható létre. Ha valamelyik tengely értéke [code]0[/code], az adott [Texture2D] nem ismétlődik abban az irányban."

#. Parallax2D.repeat_times
#: doc/classes/Parallax2D.xml
msgid "Overrides the amount of times the texture repeats. Each texture copy spreads evenly from the original by [member repeat_size]. Useful for when zooming out with a camera."
msgstr "Felülírja a textúra ismétlődéseinek számát. A másolatok az eredeti textúrától a [member repeat_size] érték szerint, egyenletes távolságban helyezkednek el. Különösen hasznos, amikor a kamerával távolítasz."

#. Parallax2D.screen_offset
#: doc/classes/Parallax2D.xml
msgid "Offset used to scroll this [Parallax2D]. This value is updated automatically unless [member ignore_camera_scroll] is [code]true[/code]."
msgstr "A [Parallax2D] görgetéséhez használt eltolás. Az érték automatikusan frissül, kivéve, ha a [member ignore_camera_scroll] értéke [code]true[/code]."

#. Parallax2D.scroll_offset
#: doc/classes/Parallax2D.xml
msgid "The [Parallax2D]'s offset. Similar to [member screen_offset] and [member Node2D.position], but will not be overridden.\n[b]Note:[/b] Values will loop if [member repeat_size] is set higher than [code]0[/code]."
msgstr "A [Parallax2D] eltolása. Hasonló a [member screen_offset] és a [member Node2D.position] tulajdonsághoz, de ezt a rendszer nem írja felül.\n[b]Megjegyzés:[/b] Az értékek körbefordulnak, ha a [member repeat_size] nagyobb, mint [code]0[/code]."

#. Parallax2D.scroll_scale
#: doc/classes/Parallax2D.xml
msgid "Multiplier to the final [Parallax2D]'s offset. Can be used to simulate distance from the camera.\nFor example, a value of [code]1[/code] scrolls at the same speed as the camera. A value greater than [code]1[/code] scrolls faster, making objects appear closer. Less than [code]1[/code] scrolls slower, making objects appear further, and a value of [code]0[/code] stops the objects completely."
msgstr "A [Parallax2D] végső eltolásának szorzója, amellyel a kamerától való távolság szimulálható.\nPéldául [code]1[/code] esetén a háttér a kamerával azonos sebességgel görgetődik. Az [code]1[/code]-nél nagyobb érték gyorsabb görgetést ad, amitől az objektumok közelebbinek látszanak. Az [code]1[/code]-nél kisebb érték lassabb görgetést ad, így az objektumok távolabbinak tűnnek; [code]0[/code] esetén pedig teljesen megállnak."

#. VisibleOnScreenNotifier2D.brief
#: doc/classes/VisibleOnScreenNotifier2D.xml
msgid "A rectangular region of 2D space that detects whether it is visible on screen."
msgstr "Téglalap alakú 2D-s terület, amely érzékeli, hogy látható-e a képernyőn."

#. VisibleOnScreenNotifier2D.description
#: doc/classes/VisibleOnScreenNotifier2D.xml
msgid "[VisibleOnScreenNotifier2D] represents a rectangular region of 2D space. When any part of this region becomes visible on screen or in a viewport, it will emit a [signal screen_entered] signal, and likewise it will emit a [signal screen_exited] signal when no part of it remains visible.\nIf you want a node to be enabled automatically when this region is visible on screen, use [VisibleOnScreenEnabler2D].\n[b]Note:[/b] [VisibleOnScreenNotifier2D] uses the render culling code to determine whether it's visible on screen, so it won't function unless [member CanvasItem.visible] is set to [code]true[/code]."
msgstr "A [VisibleOnScreenNotifier2D] egy téglalap alakú 2D-s területet jelöl. Amikor a terület bármely része láthatóvá válik a képernyőn vagy egy nézetablakban, kibocsátja a [signal screen_entered] jelet. Ha a terület egyetlen része sem marad látható, kibocsátja a [signal screen_exited] jelet.\nHa azt szeretnéd, hogy egy csomópont automatikusan bekapcsoljon, amikor a terület látható, használd a [VisibleOnScreenEnabler2D] csomópontot.\n[b]Megjegyzés:[/b] A [VisibleOnScreenNotifier2D] a megjelenítési rendszer láthatósági vizsgálatát használja, ezért csak akkor működik, ha a [member CanvasItem.visible] értéke [code]true[/code]."

#. VisibleOnScreenNotifier2D.is_on_screen
#: doc/classes/VisibleOnScreenNotifier2D.xml
msgid "If [code]true[/code], the bounding rectangle is on the screen.\n[b]Note:[/b] It takes one frame for the [VisibleOnScreenNotifier2D]'s visibility to be determined once added to the scene tree, so this method will always return [code]false[/code] right after it is instantiated, before the draw pass."
msgstr "[code]true[/code] értéket ad vissza, ha a határoló téglalap látható a képernyőn.\n[b]Megjegyzés:[/b] A [VisibleOnScreenNotifier2D] láthatóságának meghatározásához a jelenetfába kerülés után egy képkockára van szükség. Ezért a metódus közvetlenül a példányosítás után, még az első kirajzolás előtt mindig [code]false[/code] értéket ad vissza."

#. VisibleOnScreenNotifier2D.rect
#: doc/classes/VisibleOnScreenNotifier2D.xml
msgid "The VisibleOnScreenNotifier2D's bounding rectangle."
msgstr "A VisibleOnScreenNotifier2D határoló téglalapja."

#. VisibleOnScreenNotifier2D.show_rect
#: doc/classes/VisibleOnScreenNotifier2D.xml
msgid "If [code]true[/code], shows the rectangle area of [member rect] in the editor with a translucent magenta fill. Unlike changing the visibility of the VisibleOnScreenNotifier2D, this does not affect the screen culling detection."
msgstr "Ha [code]true[/code], a [member rect] által megadott téglalap áttetsző bíborszínű kitöltéssel jelenik meg a szerkesztőben. A VisibleOnScreenNotifier2D láthatóságának módosításával ellentétben ez nem befolyásolja a képernyőn való láthatóság érzékelését."

#. VisibleOnScreenEnabler2D.brief
#: doc/classes/VisibleOnScreenEnabler2D.xml
msgid "A rectangular region of 2D space that, when visible on screen, enables a target node."
msgstr "Téglalap alakú 2D-s terület, amely a képernyőn láthatóvá válva engedélyez egy célcsomópontot."

#. VisibleOnScreenEnabler2D.description
#: doc/classes/VisibleOnScreenEnabler2D.xml
msgid "[VisibleOnScreenEnabler2D] contains a rectangular region of 2D space and a target node. The target node will be automatically enabled (via its [member Node.process_mode] property) when any part of this region becomes visible on the screen, and automatically disabled otherwise. This can for example be used to activate enemies only when the player approaches them.\nSee [VisibleOnScreenNotifier2D] if you only want to be notified when the region is visible on screen.\n[b]Note:[/b] [VisibleOnScreenEnabler2D] uses the render culling code to determine whether it's visible on screen, so it won't function unless [member CanvasItem.visible] is set to [code]true[/code]."
msgstr "A [VisibleOnScreenEnabler2D] egy téglalap alakú 2D-s területet és egy célcsomópontot tartalmaz. A célcsomópont automatikusan bekapcsol (a [member Node.process_mode] tulajdonságon keresztül), ha a terület bármely része láthatóvá válik a képernyőn, egyébként pedig kikapcsol. Így például az ellenfelek csak akkor aktiválhatók, amikor a játékos a közelükbe ér.\nHa csupán értesítést szeretnél kapni a terület láthatóvá válásáról, használd a [VisibleOnScreenNotifier2D] csomópontot.\n[b]Megjegyzés:[/b] A [VisibleOnScreenEnabler2D] a megjelenítési rendszer láthatósági vizsgálatát használja, ezért csak akkor működik, ha a [member CanvasItem.visible] értéke [code]true[/code]."

#. VisibleOnScreenEnabler2D.enable_mode
#: doc/classes/VisibleOnScreenEnabler2D.xml
msgid "Determines how the target node is enabled. Corresponds to [enum Node.ProcessMode]. When the node is disabled, it always uses [constant Node.PROCESS_MODE_DISABLED]."
msgstr "Meghatározza, hogyan engedélyezze a rendszer a célcsomópontot. A [enum Node.ProcessMode] felsorolásnak felel meg. Letiltott csomópont esetén mindig a [constant Node.PROCESS_MODE_DISABLED] módot használja."

#. VisibleOnScreenEnabler2D.enable_node_path
#: doc/classes/VisibleOnScreenEnabler2D.xml
msgid "The path to the target node, relative to the [VisibleOnScreenEnabler2D]. The target node is cached; it's only assigned when setting this property (if the [VisibleOnScreenEnabler2D] is inside the scene tree) and every time the [VisibleOnScreenEnabler2D] enters the scene tree. If the path is empty, no node will be affected. If the path is invalid, an error is also generated."
msgstr "A célcsomópont elérési útja a [VisibleOnScreenEnabler2D] csomóponthoz viszonyítva. A rendszer gyorsítótárazza a célcsomópontot: csak a tulajdonság beállításakor (ha a [VisibleOnScreenEnabler2D] már a jelenetfában van), valamint a [VisibleOnScreenEnabler2D] minden jelenetfába kerülésekor rendeli hozzá újra. Üres útvonal esetén nem érint egyetlen csomópontot sem. Érvénytelen útvonal esetén hibát jelez."

#. Path2D.brief
#: doc/classes/Path2D.xml
msgid "Contains a [Curve2D] path for [PathFollow2D] nodes to follow."
msgstr "Egy [Curve2D] útvonalat tartalmaz, amelyet a [PathFollow2D] csomópontok követhetnek."

#. Path2D.description
#: doc/classes/Path2D.xml
msgid "Can have [PathFollow2D] child nodes moving along the [Curve2D]. See [PathFollow2D] for more information on usage.\n[b]Note:[/b] The path is considered as relative to the moved nodes (children of [PathFollow2D]). As such, the curve should usually start with a zero vector ([code](0, 0)[/code])."
msgstr "A csomópont [PathFollow2D] gyermekei a [Curve2D] görbe mentén mozoghatnak. A használatról részletesebben a [PathFollow2D] osztály leírásában olvashatsz.\n[b]Megjegyzés:[/b] Az útvonalat a mozgatott csomópontokhoz (a [PathFollow2D] gyermekeihez) viszonyítva értelmezi a rendszer. Emiatt a görbének általában a nullvektorból ([code](0, 0)[/code]) kell indulnia."

#. Path2D.curve
#: doc/classes/Path2D.xml
msgid "A [Curve2D] describing the path."
msgstr "Az útvonalat leíró [Curve2D]."

#. PathFollow2D.brief
#: doc/classes/PathFollow2D.xml
msgid "Point sampler for a [Path2D]."
msgstr "Pontokat mintavételező csomópont egy [Path2D] útvonalhoz."

#. PathFollow2D.description
#: doc/classes/PathFollow2D.xml
msgid "This node takes its parent [Path2D], and returns the coordinates of a point within it, given a distance from the first vertex.\nIt is useful for making other nodes follow a path, without coding the movement pattern. For that, the nodes must be children of this node. The descendant nodes will then move accordingly when setting the [member progress] in this node."
msgstr "Ez a csomópont a szülő [Path2D] útvonal első csúcsától mért távolság alapján megadja az útvonal egy pontjának koordinátáit.\nSegítségével más csomópontokat is végigmozgathatsz egy útvonalon anélkül, hogy külön meg kellene írnod a mozgásukat. Ehhez a mozgatandó csomópontoknak ennek a csomópontnak a gyermekei kell legyenek. A leszármazott csomópontok a [member progress] változtatásakor az útvonal mentén mozognak."

#. PathFollow2D.cubic_interp
#: doc/classes/PathFollow2D.xml
msgid "If [code]true[/code], the position between two cached points is interpolated cubically, and linearly otherwise.\nThe points along the [Curve2D] of the [Path2D] are precomputed before use, for faster calculations. The point at the requested offset is then calculated interpolating between two adjacent cached points. This may present a problem if the curve makes sharp turns, as the cached points may not follow the curve closely enough.\nThere are two answers to this problem: either increase the number of cached points and increase memory consumption, or make a cubic interpolation between two points at the cost of (slightly) slower calculations."
msgstr "Ha [code]true[/code], a gyorsítótárazott pontok közötti pozíciót köbös interpolációval számítja ki; ellenkező esetben lineáris interpolációt használ.\nA [Path2D] [Curve2D] görbéjén található pontokat a rendszer a gyorsabb számítás érdekében előre kiszámítja és gyorsítótárazza. A kért eltolásnál lévő pontot két szomszédos tárolt pont közötti interpolációval határozza meg. Éles kanyaroknál ez gondot okozhat, mert a tárolt pontok nem feltétlenül követik elég pontosan a görbét.\nKét megoldás lehetséges: növelheted a tárolt pontok számát, ami több memóriát igényel, vagy köbös interpolációt használhatsz két pont között, valamivel lassabb számítás árán."

#. PathFollow2D.h_offset
#: doc/classes/PathFollow2D.xml
msgid "The node's offset along the curve."
msgstr "A csomópont görbe menti eltolása."

#. PathFollow2D.loop
#: doc/classes/PathFollow2D.xml
msgid "If [code]true[/code], any offset outside the path's length will wrap around, instead of stopping at the ends. Use it for cyclic paths."
msgstr "Ha [code]true[/code], az útvonal hosszán túlnyúló eltolás visszafordul az útvonal elejére, ahelyett hogy a csomópont a végpontnál megállna. Ciklikus útvonalakhoz használható."

#. PathFollow2D.progress
#: doc/classes/PathFollow2D.xml
msgid "The distance along the path, in pixels. Changing this value sets this node's position to a point within the path."
msgstr "Az útvonal mentén megtett távolság képpontban. Ennek megváltoztatásakor a csomópont pozíciója az útvonal megfelelő pontjára kerül."

#. PathFollow2D.progress_ratio
#: doc/classes/PathFollow2D.xml
msgid "The distance along the path as a number in the range 0.0 (for the first vertex) to 1.0 (for the last). This is just another way of expressing the progress within the path, as the offset supplied is multiplied internally by the path's length.\nIt can be set or get only if the [PathFollow2D] is the child of a [Path2D] which is part of the scene tree, and that this [Path2D] has a [Curve2D] with a non-zero length. Otherwise, trying to set this field will print an error, and getting this field will return [code]0.0[/code]."
msgstr "Az útvonal mentén megtett távolság aránya, 0.0 (első csúcs) és 1.0 (utolsó csúcs) között. Ez az útvonalon elért haladás másik megadási módja; a rendszer az értéket belül megszorozza az útvonal hosszával.\nA tulajdonság csak akkor állítható be és kérdezhető le, ha a [PathFollow2D] egy, a jelenetfában lévő [Path2D] gyermeke, és ennek a [Path2D] csomópontnak nem nulla hosszúságú [Curve2D] görbéje van. Ellenkező esetben beállításkor hibaüzenet jelenik meg, lekérdezéskor pedig [code]0.0[/code] értéket ad vissza."

#. PathFollow2D.rotates
#: doc/classes/PathFollow2D.xml
msgid "If [code]true[/code], this node rotates to follow the path, with the +X direction facing forward on the path."
msgstr "Ha [code]true[/code], a csomópont az útvonal irányának megfelelően elfordul, és a +X iránya az útvonal mentén előre mutat."

#. PathFollow2D.v_offset
#: doc/classes/PathFollow2D.xml
msgid "The node's offset perpendicular to the curve."
msgstr "A csomópont görbére merőleges eltolása."

#. Line2D.brief
#: doc/classes/Line2D.xml
msgid "A 2D polyline that can optionally be textured."
msgstr "Olyan 2D-s törött vonal, amelyhez opcionálisan textúra is rendelhető."

#. Line2D.description
#: doc/classes/Line2D.xml
msgid "This node draws a 2D polyline, i.e. a shape consisting of several points connected by segments. [Line2D] is not a mathematical polyline, i.e. the segments are not infinitely thin. It is intended for rendering and it can be colored and optionally textured.\n[b]Warning:[/b] Certain configurations may be impossible to draw nicely, such as very sharp angles. In these situations, the node uses fallback drawing logic to look decent.\n[b]Note:[/b] [Line2D] is drawn using a 2D mesh."
msgstr "Ez a csomópont 2D-s törött vonalat rajzol, vagyis több, szakaszokkal összekötött pontból álló alakzatot. A [Line2D] nem matematikai értelemben vett vonallánc: a szakaszok nem végtelenül vékonyak. Kirajzolásra szolgál, és színezhető, illetve tetszés szerint textúrázható.\n[b]Figyelmeztetés:[/b] Egyes alakzatok, például a nagyon hegyes szögek, nem mindig rajzolhatók ki megfelelően. Ilyen esetekben a csomópont tartalék megjelenítési módszert használ az elfogadható eredményhez.\n[b]Megjegyzés:[/b] A [Line2D] kirajzolása 2D-s hálóval történik."

#. Line2D.add_point
#: doc/classes/Line2D.xml
msgid "Adds a point with the specified [param position] relative to the polyline's own position. If no [param index] is provided, the new point will be added to the end of the points array.\nIf [param index] is given, the new point is inserted before the existing point identified by index [param index]. The indices of the points after the new point get increased by 1. The provided [param index] must not exceed the number of existing points in the polyline. See [method get_point_count]."
msgstr "Hozzáad egy pontot a megadott [param position] pozíción, a törött vonal saját helyzetéhez viszonyítva. Ha nincs megadva [param index], az új pont a ponttömb végére kerül.\nHa megadsz [param index] értéket, az új pont az ezen az indexen található meglévő pont elé kerül. Az utána következő pontok indexe eggyel nő. A megadott [param index] nem lehet nagyobb a törött vonal meglévő pontjainak számánál. Az új pont helyét is a [param index] szabályozza. Lásd: [method get_point_count]."

#. Line2D.clear_points
#: doc/classes/Line2D.xml
msgid "Removes all points from the polyline, making it empty."
msgstr "Eltávolítja a törött vonal összes pontját, így az üressé válik."

#. Line2D.get_point_count
#: doc/classes/Line2D.xml
msgid "Returns the number of points in the polyline."
msgstr "Visszaadja a törött vonal pontjainak számát."

#. Line2D.get_point_position
#: doc/classes/Line2D.xml
msgid "Returns the position of the point at index [param index]."
msgstr "Visszaadja a [param index] indexű pont pozícióját."

#. Line2D.remove_point
#: doc/classes/Line2D.xml
msgid "Removes the point at index [param index] from the polyline."
msgstr "Eltávolítja a törött vonal [param index] indexű pontját."

#. Line2D.set_point_position
#: doc/classes/Line2D.xml
msgid "Overwrites the position of the point at the given [param index] with the supplied [param position]."
msgstr "A [param index] indexű pont pozícióját a megadott [param position] értékre állítja."

#. Line2D.antialiased
#: doc/classes/Line2D.xml
msgid "If [code]true[/code], the polyline's border will be anti-aliased.\n[b]Note:[/b] [Line2D] is not accelerated by batching when being anti-aliased."
msgstr "Ha [code]true[/code], a törött vonal szélei élsimítást kapnak.\n[b]Megjegyzés:[/b] Élsimítás használatakor a [Line2D] nem gyorsítható kötegelt kirajzolással."

#. Line2D.begin_cap_mode
#: doc/classes/Line2D.xml
msgid "The style of the beginning of the polyline, if [member closed] is [code]false[/code]."
msgstr "A törött vonal kezdővégének stílusa, ha a [member closed] értéke [code]false[/code]."

#. Line2D.closed
#: doc/classes/Line2D.xml
msgid "If [code]true[/code] and the polyline has more than 2 points, the last point and the first one will be connected by a segment.\n[b]Note:[/b] The shape of the closing segment is not guaranteed to be seamless if a [member width_curve] is provided.\n[b]Note:[/b] The joint between the closing segment and the first segment is drawn first and it samples the [member gradient] and the [member width_curve] at the beginning. This is an implementation detail that might change in a future version."
msgstr "Ha [code]true[/code], és a törött vonal kettőnél több pontból áll, egy további szakasz összeköti az utolsó és az első pontot.\n[b]Megjegyzés:[/b] Ha a [member width_curve] be van állítva, nem garantált, hogy a záró szakasz illeszkedése hézagmentes lesz.\n[b]Megjegyzés:[/b] A záró szakasz és az első szakasz közötti csatlakozást a rendszer rajzolja ki először, a [member gradient] és a [member width_curve] kezdeti értékeit használva. Ez megvalósítási részlet, amely egy későbbi verzióban változhat."

#. Line2D.default_color
#: doc/classes/Line2D.xml
msgid "The color of the polyline. Will not be used if a gradient is set."
msgstr "A törött vonal alapszíne. Ha színátmenet van beállítva, ezt az értéket nem használja."

#. Line2D.end_cap_mode
#: doc/classes/Line2D.xml
msgid "The style of the end of the polyline, if [member closed] is [code]false[/code]."
msgstr "A törött vonal végének stílusa, ha a [member closed] értéke [code]false[/code]."

#. Line2D.gradient
#: doc/classes/Line2D.xml
msgid "The gradient is drawn through the whole line from start to finish. The [member default_color] will not be used if this property is set."
msgstr "A színátmenet a vonal teljes hosszán, a kezdettől a végéig jelenik meg. Ha ezt a tulajdonságot beállítod, a [member default_color] értékét nem használja."

#. Line2D.joint_mode
#: doc/classes/Line2D.xml
msgid "The style of the connections between segments of the polyline."
msgstr "A törött vonal szakaszai közötti csatlakozások stílusa."

#. Line2D.points
#: doc/classes/Line2D.xml
msgid "The points of the polyline, interpreted in local 2D coordinates. Segments are drawn between the adjacent points in this array."
msgstr "A törött vonal pontjai helyi 2D-s koordinátákban. A rendszer a tömb egymást követő pontjai közé szakaszokat rajzol."

#. Line2D.round_precision
#: doc/classes/Line2D.xml
msgid "The smoothness used for rounded joints and caps. Higher values result in smoother corners, but are more demanding to render and update."
msgstr "A lekerekített csatlakozások és vonalvégek simasága. A nagyobb érték szebb, simább sarkokat eredményez, de a kirajzolás és a frissítés több erőforrást igényel."

#. Line2D.sharp_limit
#: doc/classes/Line2D.xml
msgid "Determines the miter limit of the polyline. Normally, when [member joint_mode] is set to [constant LINE_JOINT_SHARP], sharp angles fall back to using the logic of [constant LINE_JOINT_BEVEL] joints to prevent very long miters. Higher values of this property mean that the fallback to a bevel joint will happen at sharper angles."
msgstr "Meghatározza a hegyes csatlakozások gérillesztési korlátját. Normál esetben, ha a [member joint_mode] értéke [constant LINE_JOINT_SHARP], a nagyon hegyes szögeknél a rendszer a [constant LINE_JOINT_BEVEL] szerinti ferde illesztésre vált, hogy elkerülje a túlságosan hosszú gércsúcsokat. Nagyobb értéknél csak még hegyesebb szög esetén történik meg ez a váltás."

#. Line2D.texture
#: doc/classes/Line2D.xml
msgid "The texture used for the polyline. Uses [member texture_mode] for drawing style."
msgstr "A törött vonal megjelenítéséhez használt textúra. A rajzolási módot a [member texture_mode] szabályozza."

#. Line2D.texture_mode
#: doc/classes/Line2D.xml
msgid "The style to render the [member texture] of the polyline."
msgstr "A törött vonal [member texture] textúrájának kirajzolási módja."

#. Line2D.width
#: doc/classes/Line2D.xml
msgid "The polyline's width."
msgstr "A törött vonal vastagsága."

#. Line2D.width_curve
#: doc/classes/Line2D.xml
msgid "The polyline's width curve. The width of the polyline over its length will be equivalent to the value of the width curve over its domain. The width curve should be a unit [Curve]."
msgstr "A törött vonal vastagsággörbéje. A vonal vastagsága a teljes hosszán követi a görbe tartományában megadott értékeket. A vastagsággörbének egységnyi tartományú [Curve] erőforrásnak kell lennie."

#. Polygon2D.brief
#: doc/classes/Polygon2D.xml
msgid "A 2D polygon."
msgstr "2D-s sokszög."

#. Polygon2D.description
#: doc/classes/Polygon2D.xml
msgid "A Polygon2D is defined by a set of points. Each point is connected to the next, with the final point being connected to the first, resulting in a closed polygon. Polygon2Ds can be filled with color (solid or gradient) or filled with a given texture."
msgstr "A Polygon2D alakzatot pontok halmaza határozza meg. Minden pont a következőhöz kapcsolódik, az utolsó pedig az elsőhöz, így zárt sokszög jön létre. A Polygon2D alakzatok egyszínű vagy színátmenetes kitöltéssel, illetve megadott textúrával is megjeleníthetők."

#. Polygon2D.add_bone
#: doc/classes/Polygon2D.xml
msgid "Adds a bone with the specified [param path] and [param weights]."
msgstr "Hozzáad egy csontot a megadott [param path] útvonallal és [param weights] súlyokkal."

#. Polygon2D.clear_bones
#: doc/classes/Polygon2D.xml
msgid "Removes all bones from this [Polygon2D]."
msgstr "Eltávolítja a [Polygon2D] összes csontját."

#. Polygon2D.erase_bone
#: doc/classes/Polygon2D.xml
msgid "Removes the specified bone from this [Polygon2D]."
msgstr "Eltávolítja a megadott csontot a [Polygon2D] objektumból."

#. Polygon2D.get_bone_count
#: doc/classes/Polygon2D.xml
msgid "Returns the number of bones in this [Polygon2D]."
msgstr "Visszaadja a [Polygon2D] csontjainak számát."

#. Polygon2D.get_bone_path
#: doc/classes/Polygon2D.xml
msgid "Returns the path to the node associated with the specified bone."
msgstr "Visszaadja a megadott csonthoz tartozó csomópont elérési útját."

#. Polygon2D.get_bone_weights
#: doc/classes/Polygon2D.xml
msgid "Returns the weight values of the specified bone."
msgstr "Visszaadja a megadott csont súlyértékeit."

#. Polygon2D.set_bone_path
#: doc/classes/Polygon2D.xml
msgid "Sets the path to the node associated with the specified bone."
msgstr "Beállítja a megadott csonthoz tartozó csomópont elérési útját."

#. Polygon2D.set_bone_weights
#: doc/classes/Polygon2D.xml
msgid "Sets the weight values for the specified bone."
msgstr "Beállítja a megadott csont súlyértékeit."

#. Polygon2D.antialiased
#: doc/classes/Polygon2D.xml
msgid "If [code]true[/code], polygon edges will be anti-aliased."
msgstr "Ha [code]true[/code], a sokszög szélei élsimítást kapnak."

#. Polygon2D.color
#: doc/classes/Polygon2D.xml
msgid "The polygon's fill color. If [member texture] is set, it will be multiplied by this color. It will also be the default color for vertices not set in [member vertex_colors]."
msgstr "A sokszög kitöltési színe. Ha a [member texture] be van állítva, a textúra színét ezzel megszorozza a rendszer. A [member vertex_colors] tulajdonságban külön nem megadott csúcsoknak ez lesz az alapértelmezett színe."

#. Polygon2D.internal_vertex_count
#: doc/classes/Polygon2D.xml
msgid "Number of internal vertices, used for UV mapping."
msgstr "A belső csúcsok száma, amelyet az UV-leképezés használ."

#. Polygon2D.invert_border
#: doc/classes/Polygon2D.xml
msgid "Added padding applied to the bounding box when [member invert_enabled] is set to [code]true[/code]. Setting this value too small may result in a \"Bad Polygon\" error."
msgstr "A határoló téglalaphoz hozzáadott ráhagyás, ha a [member invert_enabled] értéke [code]true[/code]. Túl kicsi értéknél „Bad Polygon” hiba jelentkezhet."

#. Polygon2D.invert_enabled
#: doc/classes/Polygon2D.xml
msgid "If [code]true[/code], the polygon will be inverted, containing the area outside the defined points and extending to the [member invert_border]."
msgstr "Ha [code]true[/code], a sokszög kitöltése megfordul: a megadott pontokon kívüli területet foglalja magában, egészen a [member invert_border] határáig."

#. Polygon2D.offset
#: doc/classes/Polygon2D.xml
msgid "The offset applied to each vertex."
msgstr "Az egyes csúcsokra alkalmazott eltolás."

#. Polygon2D.polygon
#: doc/classes/Polygon2D.xml
msgid "The polygon's list of vertices. The final point will be connected to the first."
msgstr "A sokszög csúcsainak listája. Az utolsó pont összekapcsolódik az elsővel."

#. Polygon2D.polygons
#: doc/classes/Polygon2D.xml
msgid "The list of polygons, in case more than one is being represented. Every individual polygon is stored as a [PackedInt32Array] where each [int] is an index to a point in [member polygon]. If empty, this property will be ignored, and the resulting single polygon will be composed of all points in [member polygon], using the order they are stored in."
msgstr "A sokszögek listája, ha egynél több alakzatot ábrázol az objektum. Minden különálló sokszög egy [PackedInt32Array] tömbben tárolódik, amelynek minden [int] eleme egy, a [member polygon] tulajdonságban szereplő pontra mutató index. Ha a lista üres, a rendszer figyelmen kívül hagyja ezt a tulajdonságot, és az egyetlen eredményül kapott sokszöget a [member polygon] összes pontjából, azok tárolási sorrendjében állítja elő."

#. Polygon2D.skeleton
#: doc/classes/Polygon2D.xml
msgid "Path to a [Skeleton2D] node used for skeleton-based deformations of this polygon. If empty or invalid, skeletal deformations will not be used."
msgstr "A sokszög csontvázalapú alakváltoztatásához használt [Skeleton2D] csomópont elérési útja. Ha üres vagy érvénytelen, a rendszer nem használ csontvázalapú alakváltoztatást."

#. Polygon2D.texture
#: doc/classes/Polygon2D.xml
msgid "The polygon's fill texture. Use [member uv] to set texture coordinates."
msgstr "A sokszög kitöltési textúrája. A textúrakoordinátákat a [member uv] segítségével állíthatod be."

#. Polygon2D.texture_offset
#: doc/classes/Polygon2D.xml
msgid "Amount to offset the polygon's [member texture]. If set to [code]Vector2(0, 0)[/code], the texture's origin (its top-left corner) will be placed at the polygon's position."
msgstr "A sokszög [member texture] textúrájának eltolása. Ha az érték [code]Vector2(0, 0)[/code], a textúra origója (bal felső sarka) a sokszög pozíciójához kerül."

#. Polygon2D.texture_rotation
#: doc/classes/Polygon2D.xml
msgid "The texture's rotation in radians."
msgstr "A textúra elforgatása radiánban."

#. Polygon2D.texture_scale
#: doc/classes/Polygon2D.xml
msgid "Amount to multiply the [member uv] coordinates when using [member texture]. Larger values make the texture smaller, and vice versa."
msgstr "Az a szorzó, amellyel a [member uv] koordinátáit módosítja a rendszer a [member texture] használatakor. Nagyobb értéknél a textúra kisebbnek látszik, és fordítva."

#. Polygon2D.uv
#: doc/classes/Polygon2D.xml
msgid "Texture coordinates for each vertex of the polygon. There should be one UV value per polygon vertex. If there are fewer, undefined vertices will use [code]Vector2(0, 0)[/code]."
msgstr "A sokszög egyes csúcsainak textúrakoordinátái. Minden csúcshoz egy UV-értéknek kell tartoznia. Ha ennél kevesebb értéket adsz meg, a meg nem határozott csúcsokhoz a [code]Vector2(0, 0)[/code] értéket használja."

#. Polygon2D.vertex_colors
#: doc/classes/Polygon2D.xml
msgid "Color for each vertex. Colors are interpolated between vertices, resulting in smooth gradients. There should be one per polygon vertex. If there are fewer, undefined vertices will use [member color]."
msgstr "Az egyes csúcsok színe. A rendszer a szomszédos csúcsok színeit interpolálja, így sima színátmenetek jönnek létre. Minden csúcshoz egy színnek kell tartoznia. Ha kevesebb színt adsz meg, a többi csúcs a [member color] értéket kapja."

#. Gradient.brief
#: doc/classes/Gradient.xml
msgid "A color transition."
msgstr "Színátmenet."

#. Gradient.description
#: doc/classes/Gradient.xml
msgid "This resource describes a color transition by defining a set of colored points and how to interpolate between them.\nSee also [Curve] which supports more complex easing methods, but does not support colors."
msgstr "Ez az erőforrás színes pontok meghatározásával és a köztük történő interpoláció beállításával ír le egy színátmenetet.\nLásd még a [Curve] osztályt, amely összetettebb interpolációs módszereket támogat, de színeket nem kezel."

#. Gradient.add_point
#: doc/classes/Gradient.xml
msgid "Adds the specified color to the gradient, with the specified offset."
msgstr "Hozzáadja a megadott színt a színátmenethez a megadott eltolással."

#. Gradient.get_color
#: doc/classes/Gradient.xml
msgid "Returns the color of the gradient color at index [param point]."
msgstr "Visszaadja a színátmenet [param point] indexű pontjának színét."

#. Gradient.get_offset
#: doc/classes/Gradient.xml
msgid "Returns the offset of the gradient color at index [param point]."
msgstr "Visszaadja a színátmenet [param point] indexű színpontjának eltolását."

#. Gradient.get_point_count
#: doc/classes/Gradient.xml
msgid "Returns the number of colors in the gradient."
msgstr "Visszaadja a színátmenet színpontjainak számát."

#. Gradient.remove_point
#: doc/classes/Gradient.xml
msgid "Removes the color at index [param point]."
msgstr "Eltávolítja a [param point] indexű színpontot."

#. Gradient.reverse
#: doc/classes/Gradient.xml
msgid "Reverses/mirrors the gradient.\n[b]Note:[/b] This method mirrors all points around the middle of the gradient, which may produce unexpected results when [member interpolation_mode] is set to [constant GRADIENT_INTERPOLATE_CONSTANT]."
msgstr "Megfordítja, illetve tükrözi a színátmenetet.\n[b]Megjegyzés:[/b] A metódus az összes pontot a színátmenet közepe körül tükrözi, ezért váratlan eredményt adhat, ha a [member interpolation_mode] értéke [constant GRADIENT_INTERPOLATE_CONSTANT]."

#. Gradient.sample
#: doc/classes/Gradient.xml
msgid "Returns the interpolated color specified by [param offset]. [param offset] should be between [code]0.0[/code] and [code]1.0[/code] (inclusive). Using a value lower than [code]0.0[/code] will return the same color as [code]0.0[/code], and using a value higher than [code]1.0[/code] will return the same color as [code]1.0[/code]. If your input value is not within this range, consider using [method @GlobalScope.remap] on the input value with output values set to [code]0.0[/code] and [code]1.0[/code]."
msgstr "Visszaadja a [param offset] alapján interpolált színt. A [param offset] értéke [code]0.0[/code] és [code]1.0[/code] közé eshet (a határokat is beleértve). Ha a megadott érték kisebb, mint [code]0.0[/code], a [code]0.0[/code] értékhez tartozó színt adja vissza; ha nagyobb, mint [code]1.0[/code], akkor az [code]1.0[/code] színét. Ha a bemeneti érték nincs ebben a tartományban, érdemes a [method @GlobalScope.remap] metódussal a [code]0.0[/code] és [code]1.0[/code] közötti kimeneti tartományra átskálázni."

#. Gradient.set_color
#: doc/classes/Gradient.xml
msgid "Sets the color of the gradient color at index [param point]."
msgstr "Beállítja a színátmenet [param point] indexű színpontjának színét."

#. Gradient.set_offset
#: doc/classes/Gradient.xml
msgid "Sets the offset for the gradient color at index [param point]."
msgstr "Beállítja a színátmenet [param point] indexű színpontjának eltolását."

#. Gradient.colors
#: doc/classes/Gradient.xml
msgid "Gradient's colors as a [PackedColorArray].\n[b]Note:[/b] Setting this property updates all colors at once. To update any color individually use [method set_color]."
msgstr "A színátmenet színei [PackedColorArray] tömbként.\n[b]Megjegyzés:[/b] A tulajdonság beállításakor minden szín egyszerre frissül. Az egyes színek módosításához használd a [method set_color] metódust."

#. Gradient.interpolation_color_space
#: doc/classes/Gradient.xml
msgid "The color space used to interpolate between points of the gradient. It does not affect the returned colors, which will always use nonlinear sRGB encoding.\n[b]Note:[/b] This setting has no effect when [member interpolation_mode] is set to [constant GRADIENT_INTERPOLATE_CONSTANT]."
msgstr "A színátmenet pontjai közötti interpolációhoz használt színtér. A visszaadott színekre nincs hatással: azok mindig nemlineáris sRGB-kódolást használnak.\n[b]Megjegyzés:[/b] A beállításnak nincs hatása, ha a [member interpolation_mode] értéke [constant GRADIENT_INTERPOLATE_CONSTANT]."

#. Gradient.interpolation_mode
#: doc/classes/Gradient.xml
msgid "The algorithm used to interpolate between points of the gradient."
msgstr "A színátmenet pontjai közötti interpolációhoz használt algoritmus."

#. Gradient.offsets
#: doc/classes/Gradient.xml
msgid "Gradient's offsets as a [PackedFloat32Array].\n[b]Note:[/b] Setting this property updates all offsets at once. To update any offset individually use [method set_offset]."
msgstr "A színátmenet eltolásai [PackedFloat32Array] tömbként.\n[b]Megjegyzés:[/b] A tulajdonság beállításakor az összes eltolás egyszerre frissül. Az egyes eltolások módosításához használd a [method set_offset] metódust."

#. GradientTexture2D.brief
#: doc/classes/GradientTexture2D.xml
msgid "A 2D texture that creates a pattern with colors obtained from a [Gradient]."
msgstr "Olyan 2D-s textúra, amely [Gradient] színátmenetből származó színekkel mintázatot hoz létre."

#. GradientTexture2D.description
#: doc/classes/GradientTexture2D.xml
msgid "A 2D texture that obtains colors from a [Gradient] to fill the texture data. This texture is able to transform a color transition into different patterns such as a linear or a radial gradient. The texture is filled by interpolating colors starting from [member fill_from] to [member fill_to] offsets by default, but the gradient fill can be repeated to cover the entire texture.\nThe gradient is sampled individually for each pixel so it does not necessarily represent an exact copy of the gradient (see [member width] and [member height]). See also [GradientTexture1D], [CurveTexture] and [CurveXYZTexture]."
msgstr "Olyan 2D-s textúra, amely egy [Gradient] színátmenetből vett színekkel tölti ki a textúra adatait. A színátmenetet többféle mintázattá alakíthatja, például lineáris vagy sugárirányú átmenetté. Alapértelmezés szerint a kitöltés a [member fill_from] és a [member fill_to] eltolások között interpolálja a színeket, de az átmenet ismétlésével akár a teljes textúra is lefedhető.\nA színátmenetet a rendszer minden képpontnál külön mintavételezi, ezért a kapott textúra nem feltétlenül a színátmenet pontos másolata (lásd [member width] és [member height]). Lásd még: [GradientTexture1D], [CurveTexture] és [CurveXYZTexture]."

#. GradientTexture2D.fill
#: doc/classes/GradientTexture2D.xml
msgid "The gradient's fill type."
msgstr "A színátmenet kitöltési típusa."

#. GradientTexture2D.fill_from
#: doc/classes/GradientTexture2D.xml
msgid "The initial offset used to fill the texture specified in UV coordinates."
msgstr "A textúra kitöltésének kezdő eltolása UV-koordinátákban."

#. GradientTexture2D.fill_to
#: doc/classes/GradientTexture2D.xml
msgid "The final offset used to fill the texture specified in UV coordinates."
msgstr "A textúra kitöltésének végső eltolása UV-koordinátákban."

#. GradientTexture2D.gradient
#. GradientTexture1D.gradient
#: doc/classes/GradientTexture2D.xml
#: doc/classes/GradientTexture1D.xml
msgid "The [Gradient] used to fill the texture."
msgstr "A textúra kitöltéséhez használt [Gradient]."

#. GradientTexture2D.height
#: doc/classes/GradientTexture2D.xml
msgid "The number of vertical color samples that will be obtained from the [Gradient], which also represents the texture's height."
msgstr "A [Gradient] erőforrásból vett függőleges színminták száma, amely egyben a textúra magassága is."

#. GradientTexture2D.repeat
#: doc/classes/GradientTexture2D.xml
msgid "The gradient's repeat type."
msgstr "A színátmenet ismétlési típusa."

#. GradientTexture2D.use_hdr
#. GradientTexture1D.use_hdr
#: doc/classes/GradientTexture2D.xml
#: doc/classes/GradientTexture1D.xml
msgid "If [code]true[/code], the generated texture will support high dynamic range ([constant Image.FORMAT_RGBAF] format). This allows for glow effects to work if [member Environment.glow_enabled] is [code]true[/code]. If [code]false[/code], the generated texture will use low dynamic range; overbright colors will be clamped ([constant Image.FORMAT_RGBA8] format)."
msgstr "Ha [code]true[/code], a létrehozott textúra támogatja a nagy dinamikatartományt ([constant Image.FORMAT_RGBAF] formátum). Így a ragyogási hatások is működhetnek, ha a [member Environment.glow_enabled] értéke [code]true[/code]. Ha [code]false[/code], a textúra kis dinamikatartományú lesz; a túl világos színeket a rendszer korlátozza ([constant Image.FORMAT_RGBA8] formátum)."

#. GradientTexture2D.width
#: doc/classes/GradientTexture2D.xml
msgid "The number of horizontal color samples that will be obtained from the [Gradient], which also represents the texture's width."
msgstr "A [Gradient] erőforrásból vett vízszintes színminták száma, amely egyben a textúra szélessége is."

#. CurveTexture.brief
#: doc/classes/CurveTexture.xml
msgid "A 1D texture where pixel brightness corresponds to points on a curve."
msgstr "Egydimenziós textúra, amelynek képpontfényessége egy görbe pontjaihoz igazodik."

#. CurveTexture.description
#: doc/classes/CurveTexture.xml
msgid "A 1D texture where pixel brightness corresponds to points on a unit [Curve] resource, either in grayscale or in red. This visual representation simplifies the task of saving curves as image files.\nIf you need to store up to 3 curves within a single texture, use [CurveXYZTexture] instead. See also [GradientTexture1D] and [GradientTexture2D]."
msgstr "Egydimenziós textúra, amelynek képpontfényessége egy egységnyi tartományú [Curve] erőforrás pontjaihoz igazodik, szürkeárnyalatosan vagy a vörös színcsatornában. Ez a vizuális megjelenítés megkönnyíti a görbék képfájlként történő mentését.\nHa legfeljebb három görbét szeretnél egyetlen textúrában tárolni, használd helyette a [CurveXYZTexture] osztályt. Lásd még: [GradientTexture1D] és [GradientTexture2D]."

#. CurveTexture.curve
#: doc/classes/CurveTexture.xml
msgid "The [Curve] that is rendered onto the texture. Should be a unit [Curve]."
msgstr "A textúrára rajzolt [Curve]. Egységnyi tartományú [Curve] erőforrásnak kell lennie."

#. CurveTexture.texture_mode
#: doc/classes/CurveTexture.xml
msgid "The format the texture should be generated with. When passing a CurveTexture as an input to a [Shader], this may need to be adjusted."
msgstr "A textúra létrehozásához használt formátum. Ha a CurveTexture egy [Shader] bemeneteként szolgál, ezt a beállítást szükség lehet módosítani."

#. CurveTexture.width
#. CurveXYZTexture.width
#: doc/classes/CurveTexture.xml
#: doc/classes/CurveXYZTexture.xml
msgid "The width of the texture (in pixels). Higher values make it possible to represent high-frequency data better (such as sudden direction changes), at the cost of increased generation time and memory usage."
msgstr "A textúra szélessége képpontban. Nagyobb értékkel pontosabban ábrázolhatók a gyorsan változó adatok (például a hirtelen irányváltások), de a létrehozás hosszabb ideig tarthat, és több memóriát igényel."

#. GradientTexture1D.brief
#: doc/classes/GradientTexture1D.xml
msgid "A 1D texture that uses colors obtained from a [Gradient]."
msgstr "Egydimenziós textúra, amely egy [Gradient] színátmenet színeit használja."

#. GradientTexture1D.description
#: doc/classes/GradientTexture1D.xml
msgid "A 1D texture that obtains colors from a [Gradient] to fill the texture data. The texture is filled by sampling the gradient for each pixel. Therefore, the texture does not necessarily represent an exact copy of the gradient, as it may miss some colors if there are not enough pixels. See also [GradientTexture2D], [CurveTexture] and [CurveXYZTexture]."
msgstr "Egydimenziós textúra, amely a [Gradient] színátmenetből vett színekkel tölti ki a textúra adatait. A rendszer minden képponthoz mintát vesz a színátmenetből. Emiatt a textúra nem feltétlenül adja vissza pontosan az eredeti színátmenetet: ha túl kevés képpont áll rendelkezésre, egyes színek kimaradhatnak. Lásd még: [GradientTexture2D], [CurveTexture] és [CurveXYZTexture]."

#. GradientTexture1D.width
#: doc/classes/GradientTexture1D.xml
msgid "The number of color samples that will be obtained from the [Gradient]."
msgstr "A [Gradient] színátmenetből vett színminták száma."

#. CurveXYZTexture.brief
#: doc/classes/CurveXYZTexture.xml
msgid "A 1D texture where the red, green, and blue color channels correspond to points on 3 curves."
msgstr "Egydimenziós textúra, amelynek vörös, zöld és kék színcsatornája három görbe pontjaihoz igazodik."

#. CurveXYZTexture.description
#: doc/classes/CurveXYZTexture.xml
msgid "A 1D texture where the red, green, and blue color channels correspond to points on 3 unit [Curve] resources. Compared to using separate [CurveTexture]s, this further simplifies the task of saving curves as image files.\nIf you only need to store one curve within a single texture, use [CurveTexture] instead. See also [GradientTexture1D] and [GradientTexture2D]."
msgstr "Egydimenziós textúra, amelynek vörös, zöld és kék színcsatornája három egységnyi tartományú [Curve] erőforrás pontjaihoz igazodik. Három különálló [CurveTexture] használatához képest így még egyszerűbben menthetők a görbék képfájlba.\nHa csak egyetlen görbét szeretnél tárolni egy textúrában, használd inkább a [CurveTexture] osztályt. Lásd még: [GradientTexture1D] és [GradientTexture2D]."

#. CurveXYZTexture.curve_x
#: doc/classes/CurveXYZTexture.xml
msgid "The [Curve] that is rendered onto the texture's red channel. Should be a unit [Curve]."
msgstr "A textúra vörös színcsatornájára rajzolt [Curve]. Egységnyi tartományú [Curve] erőforrásnak kell lennie."

#. CurveXYZTexture.curve_y
#: doc/classes/CurveXYZTexture.xml
msgid "The [Curve] that is rendered onto the texture's green channel. Should be a unit [Curve]."
msgstr "A textúra zöld színcsatornájára rajzolt [Curve]. Egységnyi tartományú [Curve] erőforrásnak kell lennie."

#. CurveXYZTexture.curve_z
#: doc/classes/CurveXYZTexture.xml
msgid "The [Curve] that is rendered onto the texture's blue channel. Should be a unit [Curve]."
msgstr "A textúra kék színcsatornájára rajzolt [Curve]. Egységnyi tartományú [Curve] erőforrásnak kell lennie."

#. Curve.brief
#: doc/classes/Curve.xml
msgid "A mathematical curve."
msgstr "Matematikai görbe."

#. Curve.description
#: doc/classes/Curve.xml
msgid "This resource describes a mathematical curve by defining a set of points and tangents at each point. By default, it ranges between [code]0[/code] and [code]1[/code] on the X and Y axes, but these ranges can be changed.\nPlease note that many resources and nodes assume they are given [i]unit curves[/i]. A unit curve is a curve whose domain (the X axis) is between [code]0[/code] and [code]1[/code]. Some examples of unit curve usage are [member CPUParticles2D.angle_curve] and [member Line2D.width_curve]."
msgstr "Ez az erőforrás egy matematikai görbét ír le pontok és az egyes pontokhoz tartozó érintők megadásával. Alapértelmezés szerint az X és az Y tengelyen is [code]0[/code] és [code]1[/code] közé esik a tartománya, de ezek a határok módosíthatók.\nFontos, hogy sok erőforrás és csomópont [i]egységgörbét[/i] vár. Az egységgörbe olyan görbe, amelynek értelmezési tartománya (X tengelye) [code]0[/code] és [code]1[/code] közé esik. Egységgörbét használ például a [member CPUParticles2D.angle_curve] és a [member Line2D.width_curve]."

#. Curve.add_point
#: doc/classes/Curve.xml
msgid "Adds a point to the curve. For each side, if the [code]*_mode[/code] is [constant TANGENT_LINEAR], the [code]*_tangent[/code] angle (in degrees) uses the slope of the curve halfway to the adjacent point. Allows custom assignments to the [code]*_tangent[/code] angle if [code]*_mode[/code] is set to [constant TANGENT_FREE]."
msgstr "Hozzáad egy pontot a görbéhez. Ha valamelyik oldalon a [code]*_mode[/code] értéke [constant TANGENT_LINEAR], a [code]*_tangent[/code] érintő szöge (fokban) a szomszédos pont felé vezető görbeszakasz felénél mért meredekségből adódik. Ha a [code]*_mode[/code] értéke [constant TANGENT_FREE], a [code]*_tangent[/code] érintő szöge egyedileg is megadható."

#. Curve.bake
#: doc/classes/Curve.xml
msgid "Recomputes the baked cache of points for the curve."
msgstr "Újraszámítja a görbe pontjainak előre kiszámított gyorsítótárát."

#. Curve.clean_dupes
#: doc/classes/Curve.xml
msgid "Removes duplicate points, i.e. points that are less than 0.00001 units (engine epsilon value) away from their neighbor on the curve."
msgstr "Eltávolítja az ismétlődő pontokat, vagyis azokat, amelyek a görbe mentén a szomszédjuktól kevesebb mint 0,00001 egységnyire vannak (a motor epsilonértéke)."

#. Curve.clear_points
#. Curve2D.clear_points
#: doc/classes/Curve.xml
#: doc/classes/Curve2D.xml
msgid "Removes all points from the curve."
msgstr "Eltávolítja a görbe összes pontját."

#. Curve.get_domain_range
#: doc/classes/Curve.xml
msgid "Returns the difference between [member min_domain] and [member max_domain]."
msgstr "Visszaadja a [member min_domain] és a [member max_domain] közötti különbséget."

#. Curve.get_point_left_mode
#: doc/classes/Curve.xml
msgid "Returns the left [enum TangentMode] for the point at [param index]."
msgstr "Visszaadja a [param index] indexű pont bal oldali [enum TangentMode] értékét."

#. Curve.get_point_left_tangent
#: doc/classes/Curve.xml
msgid "Returns the left tangent angle (in degrees) for the point at [param index]."
msgstr "Visszaadja a [param index] indexű pont bal oldali érintőjének szögét fokban."

#. Curve.get_point_position
#: doc/classes/Curve.xml
msgid "Returns the curve coordinates for the point at [param index]."
msgstr "Visszaadja a [param index] indexű pont koordinátáit a görbén."

#. Curve.get_point_right_mode
#: doc/classes/Curve.xml
msgid "Returns the right [enum TangentMode] for the point at [param index]."
msgstr "Visszaadja a [param index] indexű pont jobb oldali [enum TangentMode] értékét."

#. Curve.get_point_right_tangent
#: doc/classes/Curve.xml
msgid "Returns the right tangent angle (in degrees) for the point at [param index]."
msgstr "Visszaadja a [param index] indexű pont jobb oldali érintőjének szögét fokban."

#. Curve.get_value_range
#: doc/classes/Curve.xml
msgid "Returns the difference between [member min_value] and [member max_value]."
msgstr "Visszaadja a [member min_value] és a [member max_value] közötti különbséget."

#. Curve.remove_point
#: doc/classes/Curve.xml
msgid "Removes the point at [param index] from the curve."
msgstr "Eltávolítja a görbe [param index] indexű pontját."

#. Curve.sample
#: doc/classes/Curve.xml
msgid "Returns the Y value for the point that would exist at the X position [param offset] along the curve."
msgstr "Visszaadja annak a pontnak az Y értékét, amely a görbén a [param offset] X pozíciónál helyezkedne el."

#. Curve.sample_baked
#: doc/classes/Curve.xml
msgid "Returns the Y value for the point that would exist at the X position [param offset] along the curve using the baked cache. Bakes the curve's points if not already baked."
msgstr "Az előre kiszámított gyorsítótárból visszaadja annak a pontnak az Y értékét, amely a görbén a [param offset] X pozíciónál helyezkedne el. Ha a görbe pontjai még nincsenek előre kiszámítva, előbb elvégzi ezt a műveletet."

#. Curve.set_point_left_mode
#: doc/classes/Curve.xml
msgid "Sets the left [enum TangentMode] for the point at [param index] to [param mode]."
msgstr "A [param index] indexű pont bal oldali [enum TangentMode] értékét [param mode] értékre állítja."

#. Curve.set_point_left_tangent
#: doc/classes/Curve.xml
msgid "Sets the left tangent angle for the point at [param index] to [param tangent]."
msgstr "A [param index] indexű pont bal oldali érintőjének szögét [param tangent] értékre állítja."

#. Curve.set_point_offset
#: doc/classes/Curve.xml
msgid "Assigns the horizontal position [param offset] to the point at [param index]."
msgstr "A [param index] indexű pont vízszintes pozícióját a [param offset] értékre állítja."

#. Curve.set_point_right_mode
#: doc/classes/Curve.xml
msgid "Sets the right [enum TangentMode] for the point at [param index] to [param mode]."
msgstr "A [param index] indexű pont jobb oldali [enum TangentMode] értékét [param mode] értékre állítja."

#. Curve.set_point_right_tangent
#: doc/classes/Curve.xml
msgid "Sets the right tangent angle for the point at [param index] to [param tangent]."
msgstr "A [param index] indexű pont jobb oldali érintőjének szögét [param tangent] értékre állítja."

#. Curve.set_point_value
#: doc/classes/Curve.xml
msgid "Assigns the vertical position [param y] to the point at [param index]."
msgstr "A [param index] indexű pont függőleges pozícióját a [param y] értékre állítja."

#. Curve.bake_resolution
#: doc/classes/Curve.xml
msgid "The number of points to include in the baked (i.e. cached) curve data."
msgstr "Az előre kiszámított (gyorsítótárazott) görbeadatokban tárolt pontok száma."

#. Curve.max_domain
#: doc/classes/Curve.xml
msgid "The maximum domain (x-coordinate) that points can have."
msgstr "A pontok legnagyobb megengedett értelmezésitartomány-értéke (X-koordinátája)."

#. Curve.max_value
#: doc/classes/Curve.xml
msgid "The maximum value (y-coordinate) that points can have. Tangents can cause higher values between points."
msgstr "A pontok legnagyobb megengedett értéke (Y-koordinátája). Az érintők miatt a görbe a pontok között ennél magasabb értéket is felvehet."

#. Curve.min_domain
#: doc/classes/Curve.xml
msgid "The minimum domain (x-coordinate) that points can have."
msgstr "A pontok legkisebb megengedett értelmezésitartomány-értéke (X-koordinátája)."

#. Curve.min_value
#: doc/classes/Curve.xml
msgid "The minimum value (y-coordinate) that points can have. Tangents can cause lower values between points."
msgstr "A pontok legkisebb megengedett értéke (Y-koordinátája). Az érintők miatt a görbe a pontok között ennél alacsonyabb értéket is felvehet."

#. Curve.point_count
#. Curve2D.point_count
#: doc/classes/Curve.xml
#: doc/classes/Curve2D.xml
msgid "The number of points describing the curve."
msgstr "A görbét leíró pontok száma."

#. Curve.point_{index}/left_mode
#: doc/classes/Curve.xml
msgid "The left [enum TangentMode] for the point at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. point_count - 1[/code] range."
msgstr "A [code]index[/code] indexű pont bal oldali [enum TangentMode] értéke.\n[b]Megjegyzés:[/b] A [code]index[/code] értéke [code]0 .. point_count - 1[/code] lehet."

#. Curve.point_{index}/left_tangent
#: doc/classes/Curve.xml
msgid "The left tangent angle (in degrees) for the point at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. point_count - 1[/code] range."
msgstr "A [code]index[/code] indexű pont bal oldali érintőjének szöge fokban.\n[b]Megjegyzés:[/b] A [code]index[/code] értéke [code]0 .. point_count - 1[/code] lehet."

#. Curve.point_{index}/position
#: doc/classes/Curve.xml
msgid "The position of the point at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. point_count - 1[/code] range."
msgstr "A [code]index[/code] indexű pont pozíciója.\n[b]Megjegyzés:[/b] A [code]index[/code] értéke [code]0 .. point_count - 1[/code] lehet."

#. Curve.point_{index}/right_mode
#: doc/classes/Curve.xml
msgid "The right [enum TangentMode] for the point at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. point_count - 1[/code] range."
msgstr "A [code]index[/code] indexű pont jobb oldali [enum TangentMode] értéke.\n[b]Megjegyzés:[/b] A [code]index[/code] értéke [code]0 .. point_count - 1[/code] lehet."

#. Curve.point_{index}/right_tangent
#: doc/classes/Curve.xml
msgid "The right tangent angle (in degrees) for the point at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. point_count - 1[/code] range."
msgstr "A [code]index[/code] indexű pont jobb oldali érintőjének szöge fokban.\n[b]Megjegyzés:[/b] A [code]index[/code] értéke [code]0 .. point_count - 1[/code] lehet."

#. TextureRect.brief
#: doc/classes/TextureRect.xml
msgid "A control that displays a texture."
msgstr "Textúrát megjelenítő vezérlőelem."

#. TextureRect.description
#: doc/classes/TextureRect.xml
msgid "A control that displays a texture, for example an icon inside a GUI. The texture's placement can be controlled with the [member stretch_mode] property. It can scale, tile, or stay centered inside its bounding rectangle."
msgstr "Textúrát megjelenítő vezérlőelem, például egy grafikus felület ikonjához. A textúra elhelyezését a [member stretch_mode] tulajdonsággal szabályozhatod. A textúra átméretezhető, ismételhető vagy a határoló téglalap közepén tartható."

#. TextureRect.expand_mode
#: doc/classes/TextureRect.xml
msgid "Defines how minimum size is determined based on the texture's size."
msgstr "Meghatározza, hogyan számítsa ki a vezérlőelem minimális méretét a textúra mérete alapján."

#. TextureRect.stretch_mode
#: doc/classes/TextureRect.xml
msgid "Controls the texture's behavior when resizing the node's bounding rectangle."
msgstr "A textúra viselkedését szabályozza a csomópont határoló téglalapjának átméretezésekor."

#. TextureRect.texture
#: doc/classes/TextureRect.xml
msgid "The node's [Texture2D] resource."
msgstr "A csomópont [Texture2D] erőforrása."

#. NinePatchRect.brief
#: doc/classes/NinePatchRect.xml
msgid "A control that displays a texture by keeping its corners intact, but tiling its edges and center."
msgstr "Olyan vezérlőelem, amely egy textúra sarkait változatlanul hagyja, a széleit és közepét pedig ismételve jeleníti meg."

#. NinePatchRect.description
#: doc/classes/NinePatchRect.xml
msgid "Also known as 9-slice panels, [NinePatchRect] produces clean panels of any size based on a small texture. To do so, it splits the texture in a 3×3 grid. When you scale the node, it tiles the texture's edges horizontally or vertically, tiles the center on both axes, and leaves the corners unchanged."
msgstr "A kilencrészes panelként is ismert [NinePatchRect] egy kis textúra alapján bármilyen méretben szép megjelenésű paneleket hoz létre. Ehhez a textúrát 3×3-as rácsra osztja. A csomópont átméretezésekor a széleket vízszintesen vagy függőlegesen, a középső részt pedig mindkét irányban ismétli, miközben a sarkok változatlanok maradnak."

#. NinePatchRect.get_patch_margin
#: doc/classes/NinePatchRect.xml
msgid "Returns the size of the margin on the specified [enum Side]."
msgstr "Visszaadja a megadott [enum Side] oldal margójának méretét."

#. NinePatchRect.set_patch_margin
#: doc/classes/NinePatchRect.xml
msgid "Sets the size of the margin on the specified [enum Side] to [param value] pixels."
msgstr "A megadott [enum Side] oldal margóját [param value] képpontra állítja."

#. NinePatchRect.axis_stretch_horizontal
#: doc/classes/NinePatchRect.xml
msgid "The stretch mode to use for horizontal stretching/tiling."
msgstr "A vízszintes nyújtáshoz vagy ismétléshez használt mód."

#. NinePatchRect.axis_stretch_vertical
#: doc/classes/NinePatchRect.xml
msgid "The stretch mode to use for vertical stretching/tiling."
msgstr "A függőleges nyújtáshoz vagy ismétléshez használt mód."

#. NinePatchRect.draw_center
#: doc/classes/NinePatchRect.xml
msgid "If [code]true[/code], draw the panel's center. Else, only draw the 9-slice's borders."
msgstr "Ha [code]true[/code], a panel középső részét is kirajzolja. Ellenkező esetben csak a kilencrészes panel kerete látható."

#. NinePatchRect.patch_margin_bottom
#: doc/classes/NinePatchRect.xml
msgid "The height of the 9-slice's bottom row. A margin of 16 means the 9-slice's bottom corners and side will have a height of 16 pixels. You can set all 4 margin values individually to create panels with non-uniform borders."
msgstr "A kilencrészes panel alsó sorának magassága. A 16-os margó azt jelenti, hogy az alsó sarokrészek és az alsó szél magassága 16 képpont. A négy margó külön-külön állítható, így eltérő szélességű keretek is létrehozhatók."

#. NinePatchRect.patch_margin_left
#: doc/classes/NinePatchRect.xml
msgid "The width of the 9-slice's left column. A margin of 16 means the 9-slice's left corners and side will have a width of 16 pixels. You can set all 4 margin values individually to create panels with non-uniform borders."
msgstr "A kilencrészes panel bal oldali oszlopának szélessége. A 16-os margó azt jelenti, hogy a bal oldali sarokrészek és a bal szél szélessége 16 képpont. A négy margó külön-külön állítható, így eltérő szélességű keretek is létrehozhatók."

#. NinePatchRect.patch_margin_right
#: doc/classes/NinePatchRect.xml
msgid "The width of the 9-slice's right column. A margin of 16 means the 9-slice's right corners and side will have a width of 16 pixels. You can set all 4 margin values individually to create panels with non-uniform borders."
msgstr "A kilencrészes panel jobb oldali oszlopának szélessége. A 16-os margó azt jelenti, hogy a jobb oldali sarokrészek és a jobb szél szélessége 16 képpont. A négy margó külön-külön állítható, így eltérő szélességű keretek is létrehozhatók."

#. NinePatchRect.patch_margin_top
#: doc/classes/NinePatchRect.xml
msgid "The height of the 9-slice's top row. A margin of 16 means the 9-slice's top corners and side will have a height of 16 pixels. You can set all 4 margin values individually to create panels with non-uniform borders."
msgstr "A kilencrészes panel felső sorának magassága. A 16-os margó azt jelenti, hogy a felső sarokrészek és a felső szél magassága 16 képpont. A négy margó külön-külön állítható, így eltérő szélességű keretek is létrehozhatók."

#. NinePatchRect.region_rect
#: doc/classes/NinePatchRect.xml
msgid "Rectangular region of the texture to sample from. If you're working with an atlas, use this property to define the area the 9-slice should use. All other properties are relative to this one. If the rect is empty, NinePatchRect will use the whole texture."
msgstr "A textúra mintavételezésre használt téglalap alakú területe. Ha textúraatlasszal dolgozol, ezzel állíthatod be, melyik részét használja a kilencrészes panel. Minden más tulajdonság ehhez a területhez viszonyított. Ha a téglalap üres, a NinePatchRect a teljes textúrát használja."

#. NinePatchRect.texture
#: doc/classes/NinePatchRect.xml
msgid "The node's texture resource."
msgstr "A csomópont textúraerőforrása."

#. Curve2D.brief
#: doc/classes/Curve2D.xml
msgid "Describes a Bézier curve in 2D space."
msgstr "Bézier-görbét ír le a 2D-s térben."

#. Curve2D.description
#: doc/classes/Curve2D.xml
msgid "This class describes a Bézier curve in 2D space. It is mainly used to give a shape to a [Path2D], but can be manually sampled for other purposes.\nIt keeps a cache of precalculated points along the curve, to speed up further calculations."
msgstr "Ez az osztály 2D-s Bézier-görbét ír le. Elsősorban a [Path2D] útvonal alakjának meghatározására szolgál, de más célokra is használható a görbe pontjainak közvetlen mintavételezésével.\nA további számítások gyorsításához a görbe mentén előre kiszámított pontok gyorsítótárát tárolja."

#. Curve2D.add_point
#: doc/classes/Curve2D.xml
msgid "Adds a point with the specified [param position] relative to the curve's own position, with control points [param in] and [param out]. Appends the new point at the end of the point list.\nIf [param index] is given, the new point is inserted before the existing point identified by index [param index]. Every existing point starting from [param index] is shifted further down the list of points. The index must be greater than or equal to [code]0[/code] and must not exceed the number of existing points in the line. See [member point_count]."
msgstr "A görbe saját pozíciójához viszonyítva hozzáad egy pontot a megadott [param position] helyen, a [param in] és [param out] vezérlőpontokkal. Az új pont alapértelmezés szerint a pontlista végére kerül.\nHa megadsz [param index] értéket, az új pont a [param index] indexű meglévő pont elé kerül. A [param index] helytől kezdve minden meglévő pont eggyel hátrébb tolódik a listában. Az index nem lehet kisebb [code]0[/code]-nál, és nem lehet nagyobb a vonal meglévő pontjainak számánál. Lásd: [member point_count]."

#. Curve2D.get_baked_length
#: doc/classes/Curve2D.xml
msgid "Returns the total length of the curve, based on the cached points. Given enough density (see [member bake_interval]), it should be approximate enough."
msgstr "Visszaadja a görbe teljes hosszát a gyorsítótárazott pontok alapján. Megfelelő pontsűrűség mellett (lásd [member bake_interval]) az eredmény elég pontos közelítés."

#. Curve2D.get_baked_points
#: doc/classes/Curve2D.xml
msgid "Returns the cache of points as a [PackedVector2Array]."
msgstr "[PackedVector2Array] tömbként visszaadja a gyorsítótárazott pontokat."

#. Curve2D.get_closest_offset
#: doc/classes/Curve2D.xml
msgid "Returns the closest offset to [param to_point]. This offset is meant to be used in [method sample_baked].\n[param to_point] must be in this curve's local space."
msgstr "Visszaadja a [param to_point] ponthoz legközelebb eső, görbe menti eltolást. Az eltolást a [method sample_baked] metódussal használhatod.\nA [param to_point] pontot a görbe helyi koordinátarendszerében kell megadni."

#. Curve2D.get_closest_point
#: doc/classes/Curve2D.xml
msgid "Returns the closest point on baked segments (in curve's local space) to [param to_point].\n[param to_point] must be in this curve's local space."
msgstr "Visszaadja az előre kiszámított görbeszakaszokon a [param to_point] ponthoz legközelebb eső pontot (a görbe helyi koordinátarendszerében).\nA [param to_point] pontot a görbe helyi koordinátarendszerében kell megadni."

#. Curve2D.get_point_in
#: doc/classes/Curve2D.xml
msgid "Returns the position of the control point leading to the vertex [param idx]. The returned position is relative to the vertex [param idx]. If the index is out of bounds, the function sends an error to the console, and returns [code](0, 0)[/code]."
msgstr "Visszaadja a [param idx] indexű csúcsba bevezető vezérlőpont helyzetét. A visszaadott pozíció a [param idx] indexű csúcshoz viszonyított. Ha az index érvénytelen, a függvény hibát ír a konzolra, és [code](0, 0)[/code] értéket ad vissza."

#. Curve2D.get_point_out
#: doc/classes/Curve2D.xml
msgid "Returns the position of the control point leading out of the vertex [param idx]. The returned position is relative to the vertex [param idx]. If the index is out of bounds, the function sends an error to the console, and returns [code](0, 0)[/code]."
msgstr "Visszaadja a [param idx] indexű csúcsból kivezető vezérlőpont helyzetét. A visszaadott pozíció a [param idx] indexű csúcshoz viszonyított. Ha az index érvénytelen, a függvény hibát ír a konzolra, és [code](0, 0)[/code] értéket ad vissza."

#. Curve2D.get_point_position
#: doc/classes/Curve2D.xml
msgid "Returns the position of the vertex [param idx]. If the index is out of bounds, the function sends an error to the console, and returns [code](0, 0)[/code]."
msgstr "Visszaadja a [param idx] indexű csúcs pozícióját. Érvénytelen index esetén hibát ír a konzolra, és [code](0, 0)[/code] értéket ad vissza."

#. Curve2D.remove_point
#: doc/classes/Curve2D.xml
msgid "Deletes the point [param idx] from the curve. Sends an error to the console if [param idx] is out of bounds."
msgstr "Eltávolítja a görbe [param idx] indexű pontját. Érvénytelen [param idx] esetén hibát ír a konzolra."

#. Curve2D.sample
#: doc/classes/Curve2D.xml
msgid "Returns the position between the vertex [param idx] and the vertex [code]idx + 1[/code], where [param t] controls if the point is the first vertex ([code]t = 0.0[/code]), the last vertex ([code]t = 1.0[/code]), or in between. Values of [param t] outside the range ([code]0.0 &lt;= t &lt;= 1.0[/code]) give strange, but predictable results.\nIf [param idx] is out of bounds it is truncated to the first or last vertex, and [param t] is ignored. If the curve has no points, the function sends an error to the console, and returns [code](0, 0)[/code]."
msgstr "Visszaadja a [param idx] indexű csúcs és az utána következő, [code]idx + 1[/code] indexű csúcs közötti pozíciót. A [param t] szabályozza, hogy a pont az első csúcsra ([code]t = 0.0[/code]), az utolsóra ([code]t = 1.0[/code]) vagy a kettő közé essen. A megadott tartományon ([code]0.0 &lt;= t &lt;= 1.0[/code]) kívüli [param t] értékek szokatlan, de kiszámítható eredményt adnak.\nHa a [param idx] kilóg az érvényes tartományból, a rendszer az első vagy az utolsó csúcsra korlátozza, és figyelmen kívül hagyja a [param t] értékét. Ha a görbe üres, hibát ír a konzolra, és [code](0, 0)[/code] értéket ad vissza."

#. Curve2D.sample_baked
#: doc/classes/Curve2D.xml
msgid "Returns a point within the curve at position [param offset], where [param offset] is measured as a pixel distance along the curve.\nTo do that, it finds the two cached points where the [param offset] lies between, then interpolates the values. This interpolation is cubic if [param cubic] is set to [code]true[/code], or linear if set to [code]false[/code].\nCubic interpolation tends to follow the curves better, but linear is faster (and often, precise enough)."
msgstr "Visszaadja a görbe [param offset] pozícióján lévő pontot, ahol a [param offset] eltolást a görbe mentén mért képponttávolságként értelmezi.\nEhhez megkeresi azt a két gyorsítótárazott pontot, amelyek között a [param offset] található, majd interpolálja az értékeket. Az interpoláció köbös, ha a [param cubic] értéke [code]true[/code], és lineáris, ha [code]false[/code].\nA köbös interpoláció általában pontosabban követi a görbéket, míg a lineáris gyorsabb, és sokszor kellően pontos."

#. Curve2D.sample_baked_with_rotation
#: doc/classes/Curve2D.xml
msgid "Similar to [method sample_baked], but returns [Transform2D] that includes a rotation along the curve, with [member Transform2D.origin] as the point position and the [member Transform2D.x] vector pointing in the direction of the path at that point. Returns an empty transform if the length of the curve is [code]0[/code].\n[codeblock]\nvar baked = curve.sample_baked_with_rotation(offset)\n# The returned Transform2D can be set directly.\ntransform = baked\n# You can also read the origin and rotation separately from the returned Transform2D.\nposition = baked.get_origin()\nrotation = baked.get_rotation()\n[/codeblock]"
msgstr "A [method sample_baked] metódushoz hasonlóan működik, de egy [Transform2D] transzformációt ad vissza, amely a görbe menti elforgatást is tartalmazza. A pont pozíciója a [member Transform2D.origin] értéke, a [member Transform2D.x] vektor pedig az útvonal adott pontbeli irányába mutat. Ha a görbe hossza [code]0[/code], üres transzformációt ad vissza.\n[codeblock]\nvar baked = curve.sample_baked_with_rotation(offset)\n# The returned Transform2D can be set directly.\ntransform = baked\n# You can also read the origin and rotation separately from the returned Transform2D.\nposition = baked.get_origin()\nrotation = baked.get_rotation()\n[/codeblock]"

#. Curve2D.samplef
#: doc/classes/Curve2D.xml
msgid "Returns the position at the vertex [param fofs]. It calls [method sample] using the integer part of [param fofs] as [code]idx[/code], and its fractional part as [code]t[/code]."
msgstr "Visszaadja a [param fofs] csúcspozíción lévő pontot. A [method sample] metódust hívja meg, a [param fofs] egész részét [code]idx[/code] értékként, törtrészét pedig [code]t[/code] értékként használva."

#. Curve2D.set_point_in
#: doc/classes/Curve2D.xml
msgid "Sets the position of the control point leading to the vertex [param idx]. If the index is out of bounds, the function sends an error to the console. The position is relative to the vertex."
msgstr "Beállítja a [param idx] indexű csúcshoz bevezető vezérlőpont pozícióját. Érvénytelen index esetén hibát ír a konzolra. A pozíció a csúcshoz viszonyított."

#. Curve2D.set_point_out
#: doc/classes/Curve2D.xml
msgid "Sets the position of the control point leading out of the vertex [param idx]. If the index is out of bounds, the function sends an error to the console. The position is relative to the vertex."
msgstr "Beállítja a [param idx] indexű csúcsból kivezető vezérlőpont pozícióját. Érvénytelen index esetén hibát ír a konzolra. A pozíció a csúcshoz viszonyított."

#. Curve2D.set_point_position
#: doc/classes/Curve2D.xml
msgid "Sets the position for the vertex [param idx]. If the index is out of bounds, the function sends an error to the console."
msgstr "Beállítja a [param idx] indexű csúcs pozícióját. Érvénytelen index esetén hibát ír a konzolra."

#. Curve2D.tessellate
#: doc/classes/Curve2D.xml
msgid "Returns a list of points along the curve, with a curvature controlled point density. That is, the curvier parts will have more points than the straighter parts.\nThis approximation makes straight segments between each point, then subdivides those segments until the resulting shape is similar enough.\n[param max_stages] controls how many subdivisions a curve segment may face before it is considered approximate enough. Each subdivision splits the segment in half, so the default 5 stages may mean up to 32 subdivisions per curve segment. Increase with care!\n[param tolerance_degrees] controls how many degrees the midpoint of a segment may deviate from the real curve, before the segment has to be subdivided."
msgstr "A görbe mentén elhelyezkedő pontok listáját adja vissza, ahol a pontsűrűséget a görbület határozza meg. A jobban ívelt szakaszokon több pontot használ, mint az egyenesebb részeken.\nA közelítés először egyenes szakaszokat hoz létre a pontok között, majd ezeket addig osztja tovább, amíg a kapott alakzat eléggé meg nem közelíti a görbét.\nA [param max_stages] szabályozza, hány további felosztást kaphat egy görbeszakasz, mielőtt a rendszer elég pontosnak tekinti. Minden felosztás felezi a szakaszt, így az alapértelmezett 5 lépés görbeszakaszonként akár 32 részre osztást is jelenthet. Óvatosan növeld az értéket!\nA [param tolerance_degrees] azt szabályozza, hány fokkal térhet el egy szakasz középpontja a tényleges görbétől, mielőtt újra fel kell osztani."

#. Curve2D.tessellate_even_length
#: doc/classes/Curve2D.xml
msgid "Returns a list of points along the curve, with almost uniform density. [param max_stages] controls how many subdivisions a curve segment may face before it is considered approximate enough. Each subdivision splits the segment in half, so the default 5 stages may mean up to 32 subdivisions per curve segment. Increase with care!\n[param tolerance_length] controls the maximal distance between two neighboring points, before the segment has to be subdivided."
msgstr "A görbe mentén közel egyenletes sűrűségű pontok listáját adja vissza. A [param max_stages] szabályozza, hány további felosztást kaphat egy görbeszakasz, mielőtt a rendszer elég pontosnak tekinti. Minden felosztás felezi a szakaszt, így az alapértelmezett 5 lépés görbeszakaszonként akár 32 részre osztást is jelenthet. Óvatosan növeld az értéket!\nA [param tolerance_length] a két szomszédos pont közötti legnagyobb megengedett távolságot szabályozza, amely fölött a szakaszt tovább kell osztani."

#. Curve2D.bake_interval
#: doc/classes/Curve2D.xml
msgid "The distance in pixels between two adjacent cached points. Changing it forces the cache to be recomputed the next time the [method get_baked_points] or [method get_baked_length] function is called. The smaller the distance, the more points in the cache and the more memory it will consume, so use with care."
msgstr "A két szomszédos gyorsítótárazott pont közötti távolság képpontban. Megváltoztatásakor a következő [method get_baked_points] vagy [method get_baked_length] hívás újraszámítja a gyorsítótárat. Kisebb távolság esetén több pont kerül a gyorsítótárba, ami több memóriát igényel, ezért óvatosan módosítsd."

#. Curve2D.point_{index}/in
#: doc/classes/Curve2D.xml
msgid "The position of the control point leading to the vertex at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. point_count - 1[/code] range."
msgstr "A [code]index[/code] indexű csúcshoz bevezető vezérlőpont pozíciója.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke [code]0 .. point_count - 1[/code] tartományba eshet."

#. Curve2D.point_{index}/out
#: doc/classes/Curve2D.xml
msgid "The position of the control point leading out of the vertex at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. point_count - 1[/code] range."
msgstr "A [code]index[/code] indexű csúcsból kivezető vezérlőpont pozíciója.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke [code]0 .. point_count - 1[/code] tartományba eshet."

#. Curve2D.point_{index}/position
#: doc/classes/Curve2D.xml
msgid "The position of for the vertex at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. point_count - 1[/code] range."
msgstr "A [code]index[/code] indexű csúcs pozíciója.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke [code]0 .. point_count - 1[/code] tartományba eshet."

#. ColorRect.brief
#: doc/classes/ColorRect.xml
msgid "A control that displays a solid color rectangle."
msgstr "Egyszínű téglalapot megjelenítő vezérlőelem."

#. ColorRect.description
#: doc/classes/ColorRect.xml
msgid "Displays a rectangle filled with a solid [member color]. If you need to display the border alone, consider using a [Panel] instead."
msgstr "A [member color] színnel kitöltött téglalapot jelenít meg. Ha csak a keretet szeretnéd kirajzolni, érdemes inkább [Panel] csomópontot használni."

#. ColorRect.color
#: doc/classes/ColorRect.xml
msgid "The fill color of the rectangle."
msgstr "A téglalap kitöltési színe."

#. Panel.brief
#: doc/classes/Panel.xml
msgid "A GUI control that displays a [StyleBox]."
msgstr "[StyleBox] stíluskeretet megjelenítő grafikus vezérlőelem."

#. Panel.description
#: doc/classes/Panel.xml
msgid "[Panel] is a GUI control that displays a [StyleBox]. See also [PanelContainer]."
msgstr "A [Panel] egy [StyleBox] stíluskeretet megjelenítő grafikus vezérlőelem. Lásd még: [PanelContainer]."

#. Panel.theme.panel
#: doc/classes/Panel.xml
msgid "The [StyleBox] of this control."
msgstr "A vezérlőelem [StyleBox] stíluskerete."

#. PanelContainer.brief
#: doc/classes/PanelContainer.xml
msgid "A container that keeps its child controls within the area of a [StyleBox]."
msgstr "Olyan tároló, amely a gyermek vezérlőelemeit egy [StyleBox] területén belül tartja."

#. PanelContainer.description
#: doc/classes/PanelContainer.xml
msgid "A container that keeps its child controls within the area of a [StyleBox]. Useful for giving controls an outline."
msgstr "A gyermek vezérlőelemeket egy [StyleBox] területén belül tartó tároló. Hasznos a vezérlőelemek körüli keret megjelenítéséhez."

#. PanelContainer.theme.panel
#: doc/classes/PanelContainer.xml
msgid "The style of [PanelContainer]'s background."
msgstr "A [PanelContainer] hátterének stílusa."

#. MarginContainer.brief
#: doc/classes/MarginContainer.xml
msgid "A container that keeps a margin around its child controls."
msgstr "A gyermek vezérlőelemek körül margót fenntartó tároló."

#. MarginContainer.description
#: doc/classes/MarginContainer.xml
msgid "[MarginContainer] adds an adjustable margin on each side of its child controls. The margins are added around all children, not around each individual one. To control the [MarginContainer]'s margins, use the [code]margin_*[/code] theme properties listed below.\n[b]Note:[/b] The margin sizes are theme overrides, not normal properties. This is an example of how to change them in code:\n[codeblocks]\n[gdscript]\n# This code sample assumes the current script is extending MarginContainer.\nvar margin_value = 100\nadd_theme_constant_override(\"margin_top\", margin_value)\nadd_theme_constant_override(\"margin_left\", margin_value)\nadd_theme_constant_override(\"margin_bottom\", margin_value)\nadd_theme_constant_override(\"margin_right\", margin_value)\n[/gdscript]\n[csharp]\n// This code sample assumes the current script is extending MarginContainer.\nint marginValue = 100;\nAddThemeConstantOverride(\"margin_top\", marginValue);\nAddThemeConstantOverride(\"margin_left\", marginValue);\nAddThemeConstantOverride(\"margin_bottom\", marginValue);\nAddThemeConstantOverride(\"margin_right\", marginValue);\n[/csharp]\n[/codeblocks]"
msgstr "A [MarginContainer] állítható margót ad a gyermek vezérlőelemek mindegyik oldalához. A margók az összes gyermek körül közösen jelennek meg, nem az egyes gyermekek körül külön-külön. A [MarginContainer] margóit az alább felsorolt [code]margin_*[/code] tématulajdonságokkal állíthatod be.\n[b]Megjegyzés:[/b] A margóméretek témafelülírások, nem hagyományos tulajdonságok. Így változtathatod meg őket kódból:\n[codeblocks]\n[gdscript]\n# This code sample assumes the current script is extending MarginContainer.\nvar margin_value = 100\nadd_theme_constant_override(\"margin_top\", margin_value)\nadd_theme_constant_override(\"margin_left\", margin_value)\nadd_theme_constant_override(\"margin_bottom\", margin_value)\nadd_theme_constant_override(\"margin_right\", margin_value)\n[/gdscript]\n[csharp]\n// This code sample assumes the current script is extending MarginContainer.\nint marginValue = 100;\nAddThemeConstantOverride(\"margin_top\", marginValue);\nAddThemeConstantOverride(\"margin_left\", marginValue);\nAddThemeConstantOverride(\"margin_bottom\", marginValue);\nAddThemeConstantOverride(\"margin_right\", marginValue);\n[/csharp]\n[/codeblocks]"

#. MarginContainer.theme.margin_bottom
#: doc/classes/MarginContainer.xml
msgid "Offsets towards the inside direct children of the container by this amount of pixels from the bottom."
msgstr "A tároló közvetlen gyermekei számára ennyi képpontnyi belső eltolást alkalmaz alulról."

#. MarginContainer.theme.margin_left
#: doc/classes/MarginContainer.xml
msgid "Offsets towards the inside direct children of the container by this amount of pixels from the left."
msgstr "A tároló közvetlen gyermekei számára ennyi képpontnyi belső eltolást alkalmaz balról."

#. MarginContainer.theme.margin_right
#: doc/classes/MarginContainer.xml
msgid "Offsets towards the inside direct children of the container by this amount of pixels from the right."
msgstr "A tároló közvetlen gyermekei számára ennyi képpontnyi belső eltolást alkalmaz jobbról."

#. MarginContainer.theme.margin_top
#: doc/classes/MarginContainer.xml
msgid "Offsets towards the inside direct children of the container by this amount of pixels from the top."
msgstr "A tároló közvetlen gyermekei számára ennyi képpontnyi belső eltolást alkalmaz felülről."

#. HBoxContainer.brief
#: doc/classes/HBoxContainer.xml
msgid "A container that arranges its child controls horizontally."
msgstr "A gyermek vezérlőelemeket vízszintesen elrendező tároló."

#. HBoxContainer.description
#: doc/classes/HBoxContainer.xml
msgid "A variant of [BoxContainer] that can only arrange its child controls horizontally. Child controls are rearranged automatically when their minimum size changes."
msgstr "A [BoxContainer] olyan változata, amely a gyermek vezérlőelemeket kizárólag vízszintesen rendezi el. Ha a gyermekek minimális mérete megváltozik, az elrendezés automatikusan frissül."

#. VBoxContainer.brief
#: doc/classes/VBoxContainer.xml
msgid "A container that arranges its child controls vertically."
msgstr "A gyermek vezérlőelemeket függőlegesen elrendező tároló."

#. VBoxContainer.description
#: doc/classes/VBoxContainer.xml
msgid "A variant of [BoxContainer] that can only arrange its child controls vertically. Child controls are rearranged automatically when their minimum size changes."
msgstr "A [BoxContainer] olyan változata, amely a gyermek vezérlőelemeket kizárólag függőlegesen rendezi el. Ha a gyermekek minimális mérete megváltozik, az elrendezés automatikusan frissül."

#. CenterContainer.brief
#: doc/classes/CenterContainer.xml
msgid "A container that keeps child controls in its center."
msgstr "A gyermek vezérlőelemeket középen tartó tároló."

#. CenterContainer.description
#: doc/classes/CenterContainer.xml
msgid "[CenterContainer] is a container that keeps all of its child controls in its center at their minimum size."
msgstr "A [CenterContainer] a gyermek vezérlőelemeket a minimális méretük megtartásával középre igazítja."

#. CenterContainer.use_top_left
#: doc/classes/CenterContainer.xml
msgid "If [code]true[/code], centers children relative to the [CenterContainer]'s top left corner."
msgstr "Ha [code]true[/code], a gyermekelemeket a [CenterContainer] bal felső sarkához viszonyítva igazítja középre."

#. BoxContainer.brief
#: doc/classes/BoxContainer.xml
msgid "A container that arranges its child controls horizontally or vertically."
msgstr "A gyermek vezérlőelemeket vízszintesen vagy függőlegesen elrendező tároló."

#. BoxContainer.description
#: doc/classes/BoxContainer.xml
msgid "A container that arranges its child controls horizontally or vertically, rearranging them automatically when their minimum size changes."
msgstr "A gyermek vezérlőelemeket vízszintesen vagy függőlegesen elrendező tároló. Ha a gyermekek minimális mérete megváltozik, automatikusan újrarendezi őket."

#. BoxContainer.add_spacer
#: doc/classes/BoxContainer.xml
msgid "Adds a [Control] node to the box as a spacer. If [param begin] is [code]true[/code], it will insert the [Control] node in front of all other children."
msgstr "Térközként egy [Control] csomópontot ad a dobozhoz. Ha a [param begin] értéke [code]true[/code], a [Control] csomópontot az összes többi gyermek elé helyezi."

#. BoxContainer.alignment
#. FlowContainer.alignment
#: doc/classes/BoxContainer.xml
#: doc/classes/FlowContainer.xml
msgid "The alignment of the container's children (must be one of [constant ALIGNMENT_BEGIN], [constant ALIGNMENT_CENTER], or [constant ALIGNMENT_END])."
msgstr "A gyermekek igazítása; értéke a [constant ALIGNMENT_BEGIN], [constant ALIGNMENT_CENTER] vagy [constant ALIGNMENT_END] valamelyike lehet."

#. BoxContainer.vertical
#: doc/classes/BoxContainer.xml
msgid "If [code]true[/code], the [BoxContainer] will arrange its children vertically, rather than horizontally.\nCan't be changed when using [HBoxContainer] and [VBoxContainer]."
msgstr "Ha [code]true[/code], a [BoxContainer] vízszintes helyett függőlegesen rendezi el a gyermekeket.\nA [HBoxContainer] és [VBoxContainer] használatakor nem módosítható."

#. BoxContainer.theme.separation
#: doc/classes/BoxContainer.xml
msgid "The space between the [BoxContainer]'s elements, in pixels."
msgstr "A [BoxContainer] elemei közötti távolság képpontban."

#. GridContainer.brief
#: doc/classes/GridContainer.xml
msgid "A container that arranges its child controls in a grid layout."
msgstr "A gyermek vezérlőelemeket rácsba rendező tároló."

#. GridContainer.description
#: doc/classes/GridContainer.xml
msgid "[GridContainer] arranges its child controls in a grid layout. The number of columns is specified by the [member columns] property, whereas the number of rows depends on how many are needed for the child controls. The number of rows and columns is preserved for every size of the container.\n[b]Note:[/b] [GridContainer] only works with child nodes inheriting from [Control]. It won't rearrange child nodes inheriting from [Node2D]."
msgstr "A [GridContainer] a gyermek vezérlőelemeket rácsos elrendezésben helyezi el. Az oszlopok számát a [member columns] tulajdonság határozza meg, a sorok száma pedig a gyermekek elhelyezéséhez szükséges mennyiséghez igazodik. A sorok és oszlopok száma a tároló méretének változtatásakor is megmarad.\n[b]Megjegyzés:[/b] A [GridContainer] kizárólag [Control] osztályból származó gyermekcsomópontokkal működik. A [Node2D] alapú gyermekeket nem rendezi át."

#. GridContainer.columns
#: doc/classes/GridContainer.xml
msgid "The number of columns in the [GridContainer]. If modified, [GridContainer] reorders its Control-derived children to accommodate the new layout."
msgstr "A [GridContainer] oszlopainak száma. Módosításakor a [GridContainer] az új elrendezésnek megfelelően átrendezi a Control-alapú gyermekeket."

#. GridContainer.theme.h_separation
#. FlowContainer.theme.h_separation
#: doc/classes/GridContainer.xml
#: doc/classes/FlowContainer.xml
msgid "The horizontal separation of child nodes."
msgstr "A gyermekcsomópontok közötti vízszintes távolság."

#. GridContainer.theme.v_separation
#. FlowContainer.theme.v_separation
#: doc/classes/GridContainer.xml
#: doc/classes/FlowContainer.xml
msgid "The vertical separation of child nodes."
msgstr "A gyermekcsomópontok közötti függőleges távolság."

#. AspectRatioContainer.brief
#: doc/classes/AspectRatioContainer.xml
msgid "A container that preserves the proportions of its child controls."
msgstr "A gyermek vezérlőelemek képarányát megtartó tároló."

#. AspectRatioContainer.description
#: doc/classes/AspectRatioContainer.xml
msgid "A container type that arranges its child controls in a way that preserves their proportions automatically when the container is resized. Useful when a container has a dynamic size and the child nodes must adjust their sizes accordingly without losing their aspect ratios."
msgstr "Olyan tároló, amely átméretezésekor automatikusan úgy rendezi el a gyermek vezérlőelemeket, hogy azok megőrizzék az arányaikat. Akkor hasznos, ha a tároló mérete dinamikusan változik, de a gyermekek méretének a képarány elvesztése nélkül kell alkalmazkodnia."

#. AspectRatioContainer.alignment_horizontal
#: doc/classes/AspectRatioContainer.xml
msgid "Specifies the horizontal relative position of child controls."
msgstr "Meghatározza a gyermek vezérlőelemek relatív vízszintes elhelyezkedését."

#. AspectRatioContainer.alignment_vertical
#: doc/classes/AspectRatioContainer.xml
msgid "Specifies the vertical relative position of child controls."
msgstr "Meghatározza a gyermek vezérlőelemek relatív függőleges elhelyezkedését."

#. AspectRatioContainer.ratio
#: doc/classes/AspectRatioContainer.xml
msgid "The aspect ratio to enforce on child controls. This is the width divided by the height. The ratio depends on the [member stretch_mode]."
msgstr "A gyermek vezérlőelemekre érvényesítendő képarány: szélesség osztva magassággal. Az arány a [member stretch_mode] értékétől is függ."

#. AspectRatioContainer.stretch_mode
#: doc/classes/AspectRatioContainer.xml
msgid "The stretch mode used to align child controls."
msgstr "A gyermek vezérlőelemek igazításához használt nyújtási mód."

#. FlowContainer.brief
#: doc/classes/FlowContainer.xml
msgid "A container that arranges its child controls horizontally or vertically and wraps them around at the borders."
msgstr "A gyermek vezérlőelemeket vízszintesen vagy függőlegesen rendezi, és a tároló szélénél új sorba vagy oszlopba tördeli őket."

#. FlowContainer.description
#: doc/classes/FlowContainer.xml
msgid "A container that arranges its child controls horizontally or vertically and wraps them around at the borders. This is similar to how text in a book wraps around when no more words can fit on a line."
msgstr "A gyermek vezérlőelemeket vízszintesen vagy függőlegesen rendező tároló, amely a széléhez érve új sorba vagy oszlopba tördeli az elemeket. Hasonló ahhoz, ahogy a könyvben a szöveg a sor végén a következő sorban folytatódik."

#. FlowContainer.get_line_count
#: doc/classes/FlowContainer.xml
msgid "Returns the current line count."
msgstr "Visszaadja az elrendezés aktuális sorainak számát."

#. FlowContainer.last_wrap_alignment
#: doc/classes/FlowContainer.xml
msgid "The wrap behavior of the last, partially filled row or column (must be one of [constant LAST_WRAP_ALIGNMENT_INHERIT], [constant LAST_WRAP_ALIGNMENT_BEGIN], [constant LAST_WRAP_ALIGNMENT_CENTER], or [constant LAST_WRAP_ALIGNMENT_END])."
msgstr "Az utolsó, csak részben kitöltött sor vagy oszlop igazítása; értéke a [constant LAST_WRAP_ALIGNMENT_INHERIT], [constant LAST_WRAP_ALIGNMENT_BEGIN], [constant LAST_WRAP_ALIGNMENT_CENTER] vagy [constant LAST_WRAP_ALIGNMENT_END] valamelyike lehet."

#. FlowContainer.reverse_fill
#: doc/classes/FlowContainer.xml
msgid "If [code]true[/code], reverses fill direction. Horizontal [FlowContainer]s will fill rows bottom to top, vertical [FlowContainer]s will fill columns right to left.\nWhen using a vertical [FlowContainer] with a right to left [member Control.layout_direction], columns will fill left to right instead."
msgstr "Ha [code]true[/code], megfordítja a kitöltés irányát. A vízszintes [FlowContainer] sorai alulról felfelé, a függőleges [FlowContainer] oszlopai jobbról balra töltődnek fel.\nHa a függőleges [FlowContainer] a [member Control.layout_direction] alapján jobbról balra haladó elrendezést használ, az oszlopok ehelyett balról jobbra töltődnek fel."

#. FlowContainer.vertical
#: doc/classes/FlowContainer.xml
msgid "If [code]true[/code], the [FlowContainer] will arrange its children vertically, rather than horizontally.\nCan't be changed when using [HFlowContainer] and [VFlowContainer]."
msgstr "Ha [code]true[/code], a [FlowContainer] vízszintes helyett függőlegesen rendezi el a gyermekeket.\nA [HFlowContainer] és [VFlowContainer] használatakor nem módosítható."

#. HFlowContainer.brief
#: doc/classes/HFlowContainer.xml
msgid "A container that arranges its child controls horizontally and wraps them around at the borders."
msgstr "A gyermek vezérlőelemeket vízszintesen rendezi el, a tároló szélénél pedig új sorba tördeli őket."

#. HFlowContainer.description
#: doc/classes/HFlowContainer.xml
msgid "A variant of [FlowContainer] that can only arrange its child controls horizontally, wrapping them around at the borders. This is similar to how text in a book wraps around when no more words can fit on a line."
msgstr "A [FlowContainer] olyan változata, amely a gyermek vezérlőelemeket csak vízszintesen rendezi el, a tároló szélénél pedig új sorba tördeli őket. Hasonló ahhoz, ahogyan a könyvben a szöveg a sor végén a következő sorban folytatódik."

#. VFlowContainer.brief
#: doc/classes/VFlowContainer.xml
msgid "A container that arranges its child controls vertically and wraps them around at the borders."
msgstr "A gyermek vezérlőelemeket függőlegesen rendezi el, a tároló szélénél pedig új oszlopba tördeli őket."

#. VFlowContainer.description
#: doc/classes/VFlowContainer.xml
msgid "A variant of [FlowContainer] that can only arrange its child controls vertically, wrapping them around at the borders. This is similar to how text in a book wraps around when no more words can fit on a line, except vertically."
msgstr "A [FlowContainer] olyan változata, amely a gyermek vezérlőelemeket csak függőlegesen rendezi el, a tároló szélénél pedig új oszlopba tördeli őket. Hasonló ahhoz, ahogy a könyvben a szöveg sort vált, csak függőleges irányban."

#. ScrollContainer.brief
#: doc/classes/ScrollContainer.xml
msgid "A container used to provide scrollbars to a child control when needed."
msgstr "Olyan tároló, amely szükség esetén görgetősávokat ad a gyermek vezérlőelemhez."

#. ScrollContainer.description
#: doc/classes/ScrollContainer.xml
msgid "A container used to provide a child control with scrollbars when needed. Scrollbars will automatically be drawn at the right (for vertical) or bottom (for horizontal) and will enable dragging to move the viewable Control (and its children) within the ScrollContainer. Scrollbars will also automatically resize the grabber based on the [member Control.custom_minimum_size] of the Control relative to the ScrollContainer."
msgstr "Olyan tároló, amely szükség esetén görgetősávokat biztosít a gyermek vezérlőelemhez. A görgetősávok automatikusan a jobb oldalon (függőleges görgetésnél) vagy alul (vízszintes görgetésnél) jelennek meg. Húzásukkal a Control csomópont és annak gyermekei mozgathatók a ScrollContainer látható területén belül. A csúszka mérete a [member Control.custom_minimum_size] által meghatározott tartalomméret és a tároló mérete szerint is automatikusan változik."

#. ScrollContainer.ensure_control_visible
#: doc/classes/ScrollContainer.xml
msgid "Ensures the given [param control] is visible (must be a direct or indirect child of the ScrollContainer). Used by [member follow_focus].\n[b]Note:[/b] This will not work on a node that was just added during the same frame. If you want to scroll to a newly added child, you must wait until the next frame using [signal SceneTree.process_frame]:\n[codeblock]\nadd_child(child_node)\nawait get_tree().process_frame\nensure_control_visible(child_node)\n[/codeblock]"
msgstr "Biztosítja a [param control] vezérlőelem láthatóságát (a ScrollContainer közvetlen vagy közvetett gyermekének kell lennie). A [member follow_focus] tulajdonság használja.\n[b]Megjegyzés:[/b] Az ugyanabban a képkockában hozzáadott csomópontnál ez még nem működik. Új gyermekhez görgetés előtt várd meg a következő képkockát a [signal SceneTree.process_frame] segítségével:\n[codeblock]\nadd_child(child_node)\nawait get_tree().process_frame\nensure_control_visible(child_node)\n[/codeblock]"

#. ScrollContainer.get_h_scroll_bar
#: doc/classes/ScrollContainer.xml
msgid "Returns the horizontal scrollbar [HScrollBar] of this [ScrollContainer].\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash. If you wish to disable or hide a scrollbar, you can use [member horizontal_scroll_mode]."
msgstr "Visszaadja a [ScrollContainer] vízszintes [HScrollBar] görgetősávját.\n[b]Figyelmeztetés:[/b] Kötelező belső csomópont: eltávolítása vagy felszabadítása összeomlást okozhat. Kikapcsolásához vagy elrejtéséhez a [member horizontal_scroll_mode] tulajdonságot használd."

#. ScrollContainer.get_v_scroll_bar
#: doc/classes/ScrollContainer.xml
msgid "Returns the vertical scrollbar [VScrollBar] of this [ScrollContainer].\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash. If you wish to disable or hide a scrollbar, you can use [member vertical_scroll_mode]."
msgstr "Visszaadja a [ScrollContainer] függőleges [VScrollBar] görgetősávját.\n[b]Figyelmeztetés:[/b] Kötelező belső csomópont: eltávolítása vagy felszabadítása összeomlást okozhat. Kikapcsolásához vagy elrejtéséhez a [member vertical_scroll_mode] tulajdonságot használd."

#. ScrollContainer.draw_focus_border
#: doc/classes/ScrollContainer.xml
msgid "If [code]true[/code], [theme_item focus] is drawn when the ScrollContainer or one of its descendant nodes is focused."
msgstr "Ha [code]true[/code], kirajzolja a [theme_item focus] fókuszkeretet, amikor a ScrollContainer vagy valamelyik leszármazottja fókuszba kerül."

#. ScrollContainer.follow_focus
#: doc/classes/ScrollContainer.xml
msgid "If [code]true[/code], the ScrollContainer will automatically scroll to focused children (including indirect children) to make sure they are fully visible."
msgstr "Ha [code]true[/code], a ScrollContainer automatikusan a fókuszba került gyermekelemekhez görget (a közvetett gyermekekhez is), hogy azok teljesen láthatók legyenek."

#. ScrollContainer.horizontal_scroll_mode
#: doc/classes/ScrollContainer.xml
msgid "Controls whether horizontal scrollbar can be used and when it should be visible."
msgstr "Szabályozza, használható-e a vízszintes görgetősáv, és mikor legyen látható."

#. ScrollContainer.scroll_deadzone
#: doc/classes/ScrollContainer.xml
msgid "Deadzone for touch scrolling. Lower deadzone makes the scrolling more sensitive."
msgstr "Az érintéses görgetés holtzónája. Kisebb holtzónával érzékenyebb a görgetés."

#. ScrollContainer.scroll_hint_mode
#: doc/classes/ScrollContainer.xml
msgid "The way which scroll hints (indicators that show that the content can still be scrolled in a certain direction) will be shown.\n[b]Note:[/b] Hints won't be shown if the content can be scrolled both vertically and horizontally."
msgstr "A görgetési jelzések megjelenítési módja. Ezek jelzik, hogy valamelyik irányban még tovább lehet görgetni.\n[b]Megjegyzés:[/b] A jelzések nem jelennek meg, ha a tartalom vízszintesen és függőlegesen is görgethető."

#. ScrollContainer.scroll_horizontal
#: doc/classes/ScrollContainer.xml
msgid "The current horizontal scroll value.\n[b]Note:[/b] If you are setting this value in the [method Node._ready] function or earlier, it needs to be wrapped with [method Object.set_deferred], since scroll bar's [member Range.max_value] is not initialized yet.\n[codeblock]\nfunc _ready():\nset_deferred(\"scroll_horizontal\", 600)\n[/codeblock]"
msgstr "A vízszintes görgetés aktuális értéke.\n[b]Megjegyzés:[/b] Ha ezt a [method Node._ready] függvényben vagy korábban állítod be, a [method Object.set_deferred] használatával késleltesd a módosítást, mert a görgetősáv [member Range.max_value] értéke még nincs inicializálva.\n[codeblock]\nfunc _ready():\nset_deferred(\"scroll_horizontal\", 600)\n[/codeblock]"

#. ScrollContainer.scroll_horizontal_by_default
#: doc/classes/ScrollContainer.xml
msgid "If [code]true[/code], the mouse wheel scrolls the view horizontally, and holding [kbd]Shift[/kbd] scrolls vertically.\nIf [code]false[/code] (default), the mouse wheel scrolls the view vertically, and holding [kbd]Shift[/kbd] scrolls horizontally."
msgstr "Ha [code]true[/code], az egérgörgő vízszintesen görget, a [kbd]Shift[/kbd] lenyomásával pedig függőlegesen.\nHa [code]false[/code] (alapértelmezés), az egérgörgő függőlegesen görget, a [kbd]Shift[/kbd] lenyomásával pedig vízszintesen."

#. ScrollContainer.scroll_horizontal_custom_step
#: doc/classes/ScrollContainer.xml
msgid "Overrides the [member ScrollBar.custom_step] used when clicking the internal scroll bar's horizontal increment and decrement buttons or when using arrow keys when the [ScrollBar] is focused."
msgstr "Felülírja a belső vízszintes görgetősáv [member ScrollBar.custom_step] értékét, amelyet a növelő és csökkentő gombokra kattintva, illetve a fókuszban lévő [ScrollBar] nyílbillentyűs vezérlésénél használ a rendszer."

#. ScrollContainer.scroll_vertical
#: doc/classes/ScrollContainer.xml
msgid "The current vertical scroll value.\n[b]Note:[/b] Setting it early needs to be deferred, just like in [member scroll_horizontal].\n[codeblock]\nfunc _ready():\nset_deferred(\"scroll_vertical\", 600)\n[/codeblock]"
msgstr "A függőleges görgetés aktuális értéke.\n[b]Megjegyzés:[/b] Korai beállítását késleltetni kell, akárcsak a [member scroll_horizontal] esetében.\n[codeblock]\nfunc _ready():\nset_deferred(\"scroll_vertical\", 600)\n[/codeblock]"

#. ScrollContainer.scroll_vertical_custom_step
#: doc/classes/ScrollContainer.xml
msgid "Overrides the [member ScrollBar.custom_step] used when clicking the internal scroll bar's vertical increment and decrement buttons or when using arrow keys when the [ScrollBar] is focused."
msgstr "Felülírja a belső függőleges görgetősáv [member ScrollBar.custom_step] értékét, amelyet a növelő és csökkentő gombokra kattintva, illetve a fókuszban lévő [ScrollBar] nyílbillentyűs vezérlésénél használ a rendszer."

#. ScrollContainer.tile_scroll_hint
#: doc/classes/ScrollContainer.xml
msgid "If [code]true[/code], the scroll hint texture will be tiled instead of stretched. See [member scroll_hint_mode]."
msgstr "Ha [code]true[/code], a görgetési jelzés textúrája nyújtás helyett ismétlődik. Lásd: [member scroll_hint_mode]."

#. ScrollContainer.vertical_scroll_mode
#: doc/classes/ScrollContainer.xml
msgid "Controls whether vertical scrollbar can be used and when it should be visible."
msgstr "Szabályozza, használható-e a függőleges görgetősáv, és mikor legyen látható."

#. ScrollContainer.theme.scroll_hint_horizontal_color
#: doc/classes/ScrollContainer.xml
msgid "[Color] used to modulate the [theme_item scroll_hint_horizontal] texture."
msgstr "A [theme_item scroll_hint_horizontal] textúra színezésére használt [Color]."

#. ScrollContainer.theme.scroll_hint_vertical_color
#: doc/classes/ScrollContainer.xml
msgid "[Color] used to modulate the [theme_item scroll_hint_vertical] texture."
msgstr "A [theme_item scroll_hint_vertical] textúra színezésére használt [Color]."

#. ScrollContainer.theme.scrollbar_h_separation
#: doc/classes/ScrollContainer.xml
msgid "The space between the ScrollContainer's vertical scroll bar and its content, in pixels. No space will be added when the content's minimum size is larger than the ScrollContainer's size."
msgstr "A ScrollContainer függőleges görgetősávja és a tartalom közötti távolság képpontban. Nem ad hozzá térközt, ha a tartalom minimális mérete nagyobb a ScrollContainer méreténél."

#. ScrollContainer.theme.scrollbar_v_separation
#: doc/classes/ScrollContainer.xml
msgid "The space between the ScrollContainer's horizontal scroll bar and its content, in pixels. No space will be added when the content's minimum size is larger than the ScrollContainer's size."
msgstr "A ScrollContainer vízszintes görgetősávja és a tartalom közötti távolság képpontban. Nem ad hozzá térközt, ha a tartalom minimális mérete nagyobb a ScrollContainer méreténél."

#. ScrollContainer.theme.scroll_hint_horizontal
#: doc/classes/ScrollContainer.xml
msgid "The indicator that will be shown when the content can still be scrolled horizontally. See [member scroll_hint_mode]."
msgstr "Jelzés arra, hogy a tartalom vízszintesen még tovább görgethető. Lásd: [member scroll_hint_mode]."

#. ScrollContainer.theme.scroll_hint_vertical
#: doc/classes/ScrollContainer.xml
msgid "The indicator that will be shown when the content can still be scrolled vertically. See [member scroll_hint_mode]."
msgstr "Jelzés arra, hogy a tartalom függőlegesen még tovább görgethető. Lásd: [member scroll_hint_mode]."

#. ScrollContainer.theme.focus
#: doc/classes/ScrollContainer.xml
msgid "The focus border [StyleBox] of the [ScrollContainer]. Only used if [member draw_focus_border] is [code]true[/code]."
msgstr "A [ScrollContainer] fókuszkeretének [StyleBox] erőforrása. Csak akkor használatos, ha a [member draw_focus_border] értéke [code]true[/code]."

#. ScrollContainer.theme.panel
#: doc/classes/ScrollContainer.xml
msgid "The background [StyleBox] of the [ScrollContainer]."
msgstr "A [ScrollContainer] hátterének [StyleBox] erőforrása."

#. SplitContainer.brief
#: doc/classes/SplitContainer.xml
msgid "A container that arranges child controls horizontally or vertically and provides grabbers for adjusting the split ratios between them."
msgstr "A gyermek vezérlőelemeket vízszintesen vagy függőlegesen elrendező tároló, amely húzható fogantyúkkal állítható méretarányt biztosít."

#. SplitContainer.description
#: doc/classes/SplitContainer.xml
msgid "A container that arranges child controls horizontally or vertically and creates grabbers between them. The grabbers can be dragged around to change the size relations between the child controls."
msgstr "A gyermek vezérlőelemeket vízszintesen vagy függőlegesen elrendező tároló, amely húzható elválasztókat hoz létre közöttük. A fogantyúk áthúzásával módosíthatod a gyermek vezérlőelemek egymáshoz viszonyított méretét."

#. SplitContainer.clamp_split_offset
#: doc/classes/SplitContainer.xml
msgid "Clamps the [member split_offsets] values to ensure they are within valid ranges and do not overlap with each other. When overlaps occur, this method prioritizes one split offset (at index [param priority_index]) by clamping any overlapping split offsets to it."
msgstr "A [member split_offsets] értékeit az érvényes tartományra korlátozza, és megakadályozza, hogy az elválasztók átfedjék egymást. Átfedés esetén a [param priority_index] indexű elválasztó élvez elsőbbséget; a többi ütköző elválasztó helyzetét ehhez igazítja."

#. SplitContainer.get_drag_area_control
#: doc/classes/SplitContainer.xml
msgid "Returns the drag area [Control]. For example, you can move a pre-configured button into the drag area [Control] so that it rides along with the split bar. Try setting the [Button] anchors to [code]center[/code] prior to the [code]reparent()[/code] call.\n[codeblock]\n$BarnacleButton.reparent($SplitContainer.get_drag_area_control())\n[/codeblock]\n[b]Note:[/b] The drag area [Control] is drawn over the [SplitContainer]'s children, so [CanvasItem] draw objects called from the [Control] and children added to the [Control] will also appear over the [SplitContainer]'s children. Try setting [member Control.mouse_filter] of custom children to [constant Control.MOUSE_FILTER_IGNORE] to prevent blocking the mouse from dragging if desired.\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash."
msgstr "Visszaadja a húzási terület [Control] csomópontját. Például egy előre beállított gombot áthelyezhetsz erre a [Control] területre, így az együtt mozog az elválasztóval. A [Button] horgonyait a [code]reparent()[/code] meghívása előtt érdemes [code]center[/code] értékre állítani.\n[codeblock]\n$BarnacleButton.reparent($SplitContainer.get_drag_area_control())\n[/codeblock]\n[b]Megjegyzés:[/b] A húzási terület [Control] csomópontja a [SplitContainer] gyermekei fölé rajzolódik. A [CanvasItem] rajzolási műveletei, amelyeket a [Control] végez, valamint a [Control] hozzáadott gyermekei is a [SplitContainer] gyermekei fölé kerülnek. Az egyéni gyermekek [member Control.mouse_filter] tulajdonságát szükség esetén [constant Control.MOUSE_FILTER_IGNORE] értékre állíthatod, hogy ne akadályozzák az egérrel történő húzást.\n[b]Figyelmeztetés:[/b] Ez kötelező belső csomópont: eltávolítása vagy felszabadítása összeomlást okozhat."

#. SplitContainer.get_drag_area_controls
#: doc/classes/SplitContainer.xml
msgid "Returns an [Array] of the drag area [Control]s. These are the interactable [Control] nodes between each child. For example, this can be used to add a pre-configured button to a drag area [Control] so that it rides along with the split bar. Try setting the [Button] anchors to [code]center[/code] prior to the [method Node.reparent] call.\n[codeblock]\n$BarnacleButton.reparent($SplitContainer.get_drag_area_controls()[0])\n[/codeblock]\n[b]Note:[/b] The drag area [Control]s are drawn over the [SplitContainer]'s children, so [CanvasItem] draw objects called from a drag area and children added to it will also appear over the [SplitContainer]'s children. Try setting [member Control.mouse_filter] of custom children to [constant Control.MOUSE_FILTER_IGNORE] to prevent blocking the mouse from dragging if desired.\n[b]Warning:[/b] These are required internal nodes, removing or freeing them may cause a crash."
msgstr "Visszaadja a húzási területek [Control] csomópontjainak [Array] tömbjét. Ezek a gyermekek közötti, egérrel használható [Control] csomópontok. Például egy előre beállított gombot áthelyezhetsz egy húzási terület [Control] csomópontjába, hogy együtt mozogjon az elválasztóval. A [Button] horgonyait a [method Node.reparent] meghívása előtt érdemes [code]center[/code] értékre állítani.\n[codeblock]\n$BarnacleButton.reparent($SplitContainer.get_drag_area_controls()[0])\n[/codeblock]\n[b]Megjegyzés:[/b] A húzási területek [Control] csomópontjai a [SplitContainer] gyermekei fölé rajzolódnak. A területhez tartozó [CanvasItem] rajzolási műveletei és a hozzáadott gyermekek is a [SplitContainer] gyermekei fölött látszanak. Az egyéni gyermekek [member Control.mouse_filter] tulajdonságát szükség esetén [constant Control.MOUSE_FILTER_IGNORE] értékre állíthatod, hogy ne akadályozzák az egérrel történő húzást.\n[b]Figyelmeztetés:[/b] Ezek kötelező belső csomópontok: eltávolításuk vagy felszabadításuk összeomlást okozhat."

#. SplitContainer.collapsed
#: doc/classes/SplitContainer.xml
msgid "If [code]true[/code], the draggers will be disabled and the children will be sized as if all [member split_offsets] were [code]0[/code]."
msgstr "Ha [code]true[/code], letiltja az elválasztó fogantyúkat, és úgy méretezi a gyermekeket, mintha az összes [member split_offsets] értéke [code]0[/code] lenne."

#. SplitContainer.drag_area_highlight_in_editor
#: doc/classes/SplitContainer.xml
msgid "Highlights the drag area [Rect2] so you can see where it is during development. The drag area is gold if [member dragging_enabled] is [code]true[/code], and red if [code]false[/code]."
msgstr "A fejlesztés során kiemeli a húzási területet jelölő [Rect2] téglalapot. A terület aranyszínű, ha a [member dragging_enabled] értéke [code]true[/code], és piros, ha [code]false[/code]."

#. SplitContainer.drag_area_margin_begin
#: doc/classes/SplitContainer.xml
msgid "Reduces the size of the drag area and split bar [theme_item split_bar_background] at the beginning of the container."
msgstr "Csökkenti a húzási terület és az elválasztósáv [theme_item split_bar_background] méretét a tároló kezdőoldalán."

#. SplitContainer.drag_area_margin_end
#: doc/classes/SplitContainer.xml
msgid "Reduces the size of the drag area and split bar [theme_item split_bar_background] at the end of the container."
msgstr "Csökkenti a húzási terület és az elválasztósáv [theme_item split_bar_background] méretét a tároló végoldalán."

#. SplitContainer.drag_area_offset
#: doc/classes/SplitContainer.xml
msgid "Shifts the drag area in the axis of the container to prevent the drag area from overlapping the [ScrollBar] or other selectable [Control] of a child node."
msgstr "A tároló tengelye mentén eltolja a húzási területet, hogy az ne fedje a gyermekcsomópont [ScrollBar] görgetősávját vagy más kijelölhető [Control] elemét."

#. SplitContainer.drag_nested_intersections
#: doc/classes/SplitContainer.xml
msgid "Adds extra draggers at the intersection of the draggers of two SplitContainers to allow dragging both at once. This must be set to [code]true[/code] for both SplitContainers, and one needs to be a descendant of the other. They also must be orthogonal (their [member vertical] are different) and the descendant must be next to at least one of the ancestor's draggers (within [theme_item minimum_grab_thickness])."
msgstr "További húzófogantyúkat helyez el két SplitContainer elválasztóinak kereszteződésében, így a két elválasztó egyszerre mozgatható. Mindkét tárolónál [code]true[/code] értékre kell állítani; egyiknek a másik leszármazottjának kell lennie. Az elválasztók egymásra merőlegesek legyenek (a [member vertical] értékük különbözzön), és a belső tároló legalább az egyik külső fogantyú közelében helyezkedjen el (a [theme_item minimum_grab_thickness] tartományában)."

#. SplitContainer.dragger_visibility
#: doc/classes/SplitContainer.xml
msgid "Determines the dragger's visibility. This property does not determine whether dragging is enabled or not. Use [member dragging_enabled] for that."
msgstr "Meghatározza a húzófogantyú láthatóságát. Ez a tulajdonság nem szabályozza, hogy a húzás engedélyezett-e; ehhez a [member dragging_enabled] használható."

#. SplitContainer.dragging_enabled
#: doc/classes/SplitContainer.xml
msgid "Enables or disables split dragging."
msgstr "Engedélyezi vagy letiltja az elválasztó egérrel történő húzását."

#. SplitContainer.split_offset
#: doc/classes/SplitContainer.xml
msgid "The first element of [member split_offsets]."
msgstr "A [member split_offsets] első eleme."

#. SplitContainer.split_offsets
#: doc/classes/SplitContainer.xml
msgid "Offsets for each dragger in pixels. Each one is the offset of the split between the [Control] nodes before and after the dragger, with [code]0[/code] being the default position. The default position is based on the [Control] nodes expand flags and minimum sizes. See [member Control.size_flags_horizontal], [member Control.size_flags_vertical], and [member Control.size_flags_stretch_ratio].\nIf none of the [Control] nodes before the dragger are expanded, the default position will be at the start of the [SplitContainer]. If none of the [Control] nodes after the dragger are expanded, the default position will be at the end of the [SplitContainer]. If the dragger is in between expanded [Control] nodes, the default position will be in the middle, based on the [member Control.size_flags_stretch_ratio]s and minimum sizes.\n[b]Note:[/b] If the split offsets cause [Control] nodes to overlap, the first split will take priority when resolving the positions."
msgstr "Az elválasztók eltolásai képpontban. Minden érték a fogantyú előtti és utáni [Control] elemek közötti elválasztás helyzetét módosítja; a [code]0[/code] az alaphelyzet. Az alaphelyzetet a [Control] elemek nyújtási jelzői és minimális méretei határozzák meg. Lásd: [member Control.size_flags_horizontal], [member Control.size_flags_vertical] és [member Control.size_flags_stretch_ratio].\nHa a fogantyú előtti [Control] elemek egyike sem nyúlik, az alaphelyzet a [SplitContainer] elején lesz. Ha a fogantyú utáni [Control] elemek egyike sem nyúlik, az alaphelyzet a [SplitContainer] végén lesz. Nyújtható [Control] elemek közötti fogantyúnál az alaphelyzet középen alakul ki a [member Control.size_flags_stretch_ratio] értékek és a minimális méretek alapján.\n[b]Megjegyzés:[/b] Ha az eltolások miatt a [Control] elemek átfedik egymást, a helyzetek rendezésekor az első elválasztó élvez elsőbbséget."

#. SplitContainer.touch_dragger_enabled
#: doc/classes/SplitContainer.xml
msgid "If [code]true[/code], a touch-friendly drag handle will be enabled for better usability on smaller screens. Unlike the standard grabber, this drag handle overlaps the [SplitContainer]'s children and does not affect their minimum separation. The standard grabber will no longer be drawn when this option is enabled."
msgstr "Ha [code]true[/code], érintőképernyőhöz kényelmesebb húzófogantyú jelenik meg. A hagyományos fogantyúval szemben ez ráfed a [SplitContainer] gyermekeire, és nem növeli a minimális távolságukat. Bekapcsolásakor a hagyományos fogantyú nem rajzolódik ki."

#. SplitContainer.vertical
#: doc/classes/SplitContainer.xml
msgid "If [code]true[/code], the [SplitContainer] will arrange its children vertically, rather than horizontally.\nCan't be changed when using [HSplitContainer] and [VSplitContainer]."
msgstr "Ha [code]true[/code], a [SplitContainer] vízszintes helyett függőlegesen rendezi el a gyermekeket.\nA [HSplitContainer] és [VSplitContainer] használatakor nem módosítható."

#. SplitContainer.theme.touch_dragger_color
#: doc/classes/SplitContainer.xml
msgid "The color of the touch dragger."
msgstr "Az érintéses húzófogantyú színe."

#. SplitContainer.theme.touch_dragger_hover_color
#: doc/classes/SplitContainer.xml
msgid "The color of the touch dragger when hovered."
msgstr "Az érintéses húzófogantyú színe, amikor a mutató fölötte van."

#. SplitContainer.theme.touch_dragger_pressed_color
#: doc/classes/SplitContainer.xml
msgid "The color of the touch dragger when pressed."
msgstr "Az érintéses húzófogantyú színe lenyomott állapotban."

#. SplitContainer.theme.autohide
#: doc/classes/SplitContainer.xml
msgid "Boolean value. If [code]1[/code] ([code]true[/code]), the grabbers will hide automatically when they aren't under the cursor. If [code]0[/code] ([code]false[/code]), the grabbers are always visible. The [member dragger_visibility] must be [constant DRAGGER_VISIBLE]."
msgstr "Logikai érték. Ha [code]1[/code] ([code]true[/code]), a fogantyúk automatikusan elrejtőznek, amikor az egérmutató nincs fölöttük. Ha [code]0[/code] ([code]false[/code]), mindig láthatók. A [member dragger_visibility] értékének [constant DRAGGER_VISIBLE] kell lennie."

#. SplitContainer.theme.minimum_grab_thickness
#: doc/classes/SplitContainer.xml
msgid "The minimum thickness of the area users can click on to grab a split bar. This ensures that the split bar can still be dragged if [theme_item separation] or [theme_item h_grabber] / [theme_item v_grabber]'s size is too narrow to easily select."
msgstr "Az a legkisebb vastagság, amelyen az elválasztósáv egérrel megfogható. Így akkor is húzható marad, ha a [theme_item separation], illetve a [theme_item h_grabber] vagy [theme_item v_grabber] ikon mérete túl kicsi a könnyű kijelöléshez."

#. SplitContainer.theme.separation
#: doc/classes/SplitContainer.xml
msgid "The split bar thickness, i.e., the gap between each child of the container. This is overridden by the size of the grabber icon if [member dragger_visibility] is set to [constant DRAGGER_VISIBLE], or [constant DRAGGER_HIDDEN], and [theme_item separation] is smaller than the size of the grabber icon in the same axis.\n[b]Note:[/b] To obtain [theme_item separation] values less than the size of the grabber icon, for example a [code]1 px[/code] hairline, set [theme_item h_grabber] or [theme_item v_grabber] to a new [ImageTexture], which effectively sets the grabber icon size to [code]0 px[/code]."
msgstr "Az elválasztósáv vastagsága, vagyis a tároló egyes gyermekei közötti rés. Ha a [member dragger_visibility] értéke [constant DRAGGER_VISIBLE] vagy [constant DRAGGER_HIDDEN], és a [theme_item separation] kisebb a fogantyú ikonjánál az adott tengely mentén, az ikon mérete felülírja a beállítást.\n[b]Megjegyzés:[/b] Ha az ikon méreténél kisebb [theme_item separation] értéket szeretnél, például [code]1 px[/code] széles vonalat, rendelj a [theme_item h_grabber] vagy [theme_item v_grabber] tématulajdonsághoz új [ImageTexture] erőforrást. Ezzel a fogantyú ikonjának mérete gyakorlatilag [code]0 px[/code] lesz."

#. SplitContainer.theme.grabber
#: doc/classes/SplitContainer.xml
msgid "The icon used for the grabbers drawn in the separations. This is only used in [HSplitContainer] and [VSplitContainer]. For [SplitContainer], see [theme_item h_grabber] and [theme_item v_grabber] instead."
msgstr "Az elválasztók közötti résekbe rajzolt fogantyúk ikonja. Csak [HSplitContainer] és [VSplitContainer] esetén használatos. A [SplitContainer] megfelelő beállításai a [theme_item h_grabber] és [theme_item v_grabber]."

#. SplitContainer.theme.h_grabber
#: doc/classes/SplitContainer.xml
msgid "The icon used for the grabbers drawn in the separations when [member vertical] is [code]false[/code]."
msgstr "A fogantyúk ikonja, amikor a [member vertical] értéke [code]false[/code]."

#. SplitContainer.theme.h_touch_dragger
#: doc/classes/SplitContainer.xml
msgid "The icon used for the drag handle when [member touch_dragger_enabled] is [code]true[/code] and [member vertical] is [code]false[/code]."
msgstr "Az érintéses húzófogantyú ikonja, ha a [member touch_dragger_enabled] értéke [code]true[/code], és a [member vertical] értéke [code]false[/code]."

#. SplitContainer.theme.touch_dragger
#: doc/classes/SplitContainer.xml
msgid "The icon used for the drag handle when [member touch_dragger_enabled] is [code]true[/code]. This is only used in [HSplitContainer] and [VSplitContainer]. For [SplitContainer], see [theme_item h_touch_dragger] and [theme_item v_touch_dragger] instead."
msgstr "Az érintéses húzófogantyú ikonja, ha a [member touch_dragger_enabled] értéke [code]true[/code]. Csak [HSplitContainer] és [VSplitContainer] esetén használatos. A [SplitContainer] megfelelő beállításai a [theme_item h_touch_dragger] és [theme_item v_touch_dragger]."

#. SplitContainer.theme.v_grabber
#: doc/classes/SplitContainer.xml
msgid "The icon used for the grabbers drawn in the separations when [member vertical] is [code]true[/code]."
msgstr "A fogantyúk ikonja, amikor a [member vertical] értéke [code]true[/code]."

#. SplitContainer.theme.v_touch_dragger
#: doc/classes/SplitContainer.xml
msgid "The icon used for the drag handle when [member touch_dragger_enabled] is [code]true[/code] and [member vertical] is [code]true[/code]."
msgstr "Az érintéses húzófogantyú ikonja, ha a [member touch_dragger_enabled] értéke [code]true[/code], és a [member vertical] értéke [code]true[/code]."

#. SplitContainer.theme.split_bar_background
#: doc/classes/SplitContainer.xml
msgid "Determines the background of the split bar if its thickness is greater than zero."
msgstr "Az elválasztósáv hátterét határozza meg, ha a sáv vastagsága nagyobb nullánál."

#. HSplitContainer.brief
#: doc/classes/HSplitContainer.xml
msgid "A container that splits two child controls horizontally and provides a grabber for adjusting the split ratio."
msgstr "Két gyermek vezérlőelemet vízszintesen elrendező tároló, amely húzható elválasztóval állítja a méretarányukat."

#. HSplitContainer.description
#: doc/classes/HSplitContainer.xml
msgid "A container that accepts only two child controls, then arranges them horizontally and creates a divisor between them. The divisor can be dragged around to change the size relation between the child controls."
msgstr "Legfeljebb két gyermek vezérlőelemet fogadó tároló. A gyermekeket vízszintesen rendezi el, és húzható elválasztót helyez közéjük. Az elválasztó mozgatásával a két vezérlőelem egymáshoz viszonyított mérete módosítható."

#. VSplitContainer.brief
#: doc/classes/VSplitContainer.xml
msgid "A container that splits two child controls vertically and provides a grabber for adjusting the split ratio."
msgstr "Két gyermek vezérlőelemet függőlegesen elrendező tároló, amely húzható elválasztóval állítja a méretarányukat."

#. VSplitContainer.description
#: doc/classes/VSplitContainer.xml
msgid "A container that accepts only two child controls, then arranges them vertically and creates a divisor between them. The divisor can be dragged around to change the size relation between the child controls."
msgstr "Legfeljebb két gyermek vezérlőelemet fogadó tároló. A gyermekeket függőlegesen rendezi el, és húzható elválasztót helyez közéjük. Az elválasztó mozgatásával a két vezérlőelem egymáshoz viszonyított mérete módosítható."

#. TabBar.brief
#: doc/classes/TabBar.xml
msgid "A control that provides a horizontal bar with tabs."
msgstr "Fülekkel ellátott vízszintes sávot megjelenítő vezérlőelem."

#. TabBar.description
#: doc/classes/TabBar.xml
msgid "A control that provides a horizontal bar with tabs. Similar to [TabContainer] but is only in charge of drawing tabs, not interacting with children."
msgstr "Fülekkel ellátott vízszintes sávot megjelenítő vezérlőelem. Hasonló a [TabContainer] csomóponthoz, de csak a fülek kirajzolását végzi; a gyermekcsomópontok kezeléséről nem gondoskodik."

#. TabBar.add_tab
#: doc/classes/TabBar.xml
msgid "Adds a new tab."
msgstr "Új fület ad a sávhoz."

#. TabBar.clear_tabs
#: doc/classes/TabBar.xml
msgid "Clears all tabs."
msgstr "Eltávolítja az összes fület."

#. TabBar.get_tab_title
#: doc/classes/TabBar.xml
msgid "Returns the title of the tab at index [param tab_idx]."
msgstr "Visszaadja a [param tab_idx] indexű fül címét."

#. TabBar.set_tab_title
#: doc/classes/TabBar.xml
msgid "Sets a [param title] for the tab at index [param tab_idx]."
msgstr "A [param tab_idx] indexű fül címét a [param title] értékre állítja."

#. TabBar.remove_tab
#: doc/classes/TabBar.xml
msgid "Removes the tab at index [param tab_idx]."
msgstr "Eltávolítja a [param tab_idx] indexű fület."

#. TabBar.move_tab
#: doc/classes/TabBar.xml
msgid "Moves a tab from [param from] to [param to]."
msgstr "A fület a [param from] pozícióról a [param to] pozícióra helyezi."

#. TabBar.current_tab
#: doc/classes/TabBar.xml
msgid "The index of the current selected tab. A value of [code]-1[/code] means that no tab is selected and can only be set when [member deselect_enabled] is [code]true[/code] or if all tabs are hidden or disabled."
msgstr "A jelenleg kiválasztott fül indexe. A [code]-1[/code] érték azt jelenti, hogy nincs kiválasztott fül. Ez csak akkor állítható be, ha a [member deselect_enabled] értéke [code]true[/code], vagy ha az összes fül rejtett vagy letiltott."

#. TabBar.tab_count
#: doc/classes/TabBar.xml
msgid "The number of tabs currently in the bar."
msgstr "A sávban jelenleg található fülek száma."

#. TabBar.drag_to_rearrange_enabled
#. TabContainer.drag_to_rearrange_enabled
#: doc/classes/TabBar.xml
#: doc/classes/TabContainer.xml
msgid "If [code]true[/code], tabs can be rearranged with mouse drag."
msgstr "Ha [code]true[/code], a fülek egérrel húzva átrendezhetők."

#. TabBar.clip_tabs
#: doc/classes/TabBar.xml
msgid "If [code]true[/code], tabs overflowing this node's width will be hidden, displaying two navigation buttons instead. Otherwise, this node's minimum size is updated so that all tabs are visible."
msgstr "Ha [code]true[/code], a csomópont szélességén túlnyúló füleket elrejti, és helyettük két navigációs gombot jelenít meg. Ellenkező esetben a csomópont minimális mérete úgy változik, hogy minden fül látható maradjon."

#. TabContainer.brief
#: doc/classes/TabContainer.xml
msgid "A container that creates a tab for each child control, displaying only the active tab's control."
msgstr "Minden gyermek vezérlőelemhez fület létrehozó tároló, amely csak az aktív fülhöz tartozó vezérlőt jeleníti meg."

#. TabContainer.description
#: doc/classes/TabContainer.xml
msgid "Arranges child controls into a tabbed view, creating a tab for each one. The active tab's corresponding control is made visible, while all other child controls are hidden. Ignores non-control children.\n[b]Note:[/b] The drawing of the clickable tabs is handled by this node; [TabBar] is not needed."
msgstr "A gyermek vezérlőelemeket fülekre rendezi, minden gyermekhez egy fület létrehozva. Az aktív fülhöz tartozó vezérlőelem látható, az összes többi rejtett. A nem vezérlőelem típusú gyermekeket figyelmen kívül hagyja.\n[b]Megjegyzés:[/b] A kattintható füleket ez a csomópont rajzolja ki, nincs szükség külön [TabBar] csomópontra."

#. TabContainer.get_current_tab_control
#: doc/classes/TabContainer.xml
msgid "Returns the child [Control] node located at the active tab index."
msgstr "Visszaadja az aktív fül indexén található gyermek [Control] csomópontot."

#. TabContainer.get_tab_count
#: doc/classes/TabContainer.xml
msgid "Returns the number of tabs."
msgstr "Visszaadja a fülek számát."

#. TabContainer.get_tab_control
#: doc/classes/TabContainer.xml
msgid "Returns the [Control] node from the tab at index [param tab_idx]."
msgstr "Visszaadja a [param tab_idx] indexű fülhöz tartozó [Control] csomópontot."

#. TabContainer.get_tab_title
#: doc/classes/TabContainer.xml
msgid "Returns the title of the tab at index [param tab_idx]. Tab titles default to the name of the indexed child node, but this can be overridden with [method set_tab_title]."
msgstr "Visszaadja a [param tab_idx] indexű fül címét. Alapértelmezés szerint a cím az adott gyermekcsomópont neve, de ezt a [method set_tab_title] segítségével felülírhatod."

#. TabContainer.set_tab_title
#: doc/classes/TabContainer.xml
msgid "Sets a custom title for the tab at index [param tab_idx] (tab titles default to the name of the indexed child node). Set it back to the child's name to make the tab default to it again."
msgstr "Egyéni címet állít be a [param tab_idx] indexű fülhöz (a fül címe alapértelmezés szerint a megfelelő gyermekcsomópont neve). Ha visszaállítod a gyermek nevét, a fül ismét az alapértelmezett címet használja."

#. TabContainer.set_tab_icon
#: doc/classes/TabContainer.xml
msgid "Sets an icon for the tab at index [param tab_idx]."
msgstr "Ikont állít be a [param tab_idx] indexű fülhöz."

#. TabContainer.current_tab
#: doc/classes/TabContainer.xml
msgid "The current tab index. When set, this index's [Control] node's [code]visible[/code] property is set to [code]true[/code] and all others are set to [code]false[/code].\nA value of [code]-1[/code] means that no tab is selected."
msgstr "Az aktuális fül indexe. Beállításakor az adott fül [Control] csomópontjának [code]visible[/code] tulajdonsága [code]true[/code] lesz, az összes többié pedig [code]false[/code].\nA [code]-1[/code] érték azt jelenti, hogy nincs kiválasztott fül."

#. TabContainer.tabs_visible
#: doc/classes/TabContainer.xml
msgid "If [code]true[/code], tabs are visible. If [code]false[/code], tabs' content and titles are hidden."
msgstr "Ha [code]true[/code], a fülek láthatók. Ha [code]false[/code], a fülek tartalma és címei rejtettek."

#. ItemList.brief
#: doc/classes/ItemList.xml
msgid "A vertical list of selectable items with one or multiple columns."
msgstr "Egy vagy több oszlopban megjelenő, kijelölhető elemek függőleges listája."

#. ItemList.description
#: doc/classes/ItemList.xml
msgid "This control provides a vertical list of selectable items that may be in a single or in multiple columns, with each item having options for text and an icon. Tooltips are supported and may be different for every item in the list.\nSelectable items in the list may be selected or deselected and multiple selection may be enabled. Selection with right mouse button may also be enabled to allow use of popup context menus. Items may also be \"activated\" by double-clicking them or by pressing [kbd]Enter[/kbd].\nItem text only supports single-line strings. Newline characters (e.g. [code]\\n[/code]) in the string won't produce a newline. Text wrapping is enabled in [constant ICON_MODE_TOP] mode, but the column's width is adjusted to fully fit its content by default. You need to set [member fixed_column_width] greater than zero to wrap the text.\nAll [code]set_*[/code] methods allow negative item indices, i.e. [code]-1[/code] to access the last item, [code]-2[/code] to select the second-to-last item, and so on.\n[b]Incremental search:[/b] Like [PopupMenu] and [Tree], [ItemList] supports searching within the list while the control is focused. Press a key that matches the first letter of an item's name to select the first item starting with the given letter. After that point, there are two ways to perform incremental search: 1) Press the same key again before the timeout duration to select the next item starting with the same letter. 2) Press letter keys that match the rest of the word before the timeout duration to match to select the item in question directly. Both of these actions will be reset to the beginning of the list if the timeout duration has passed since the last keystroke was registered. You can adjust the timeout duration by changing [member ProjectSettings.gui/timers/incremental_search_max_interval_msec]."
msgstr "Ez a vezérlőelem kijelölhető elemek függőleges listáját jeleníti meg egy vagy több oszlopban. Minden elemhez szöveg és ikon rendelhető. Az egyes listaelemekhez különböző eszköztippek is megadhatók.\nAz elemek kijelölhetők és a kijelölésük megszüntethető; többszörös kijelölés is engedélyezhető. A jobb egérgombos kijelölés bekapcsolásával felugró helyi menük is használhatók. A listaelemek dupla kattintással vagy az [kbd]Enter[/kbd] billentyűvel is „aktiválhatók”.\nA listaelemek szövege csak egysoros karakterlánc lehet. A sortörés karaktere (például [code]\\n[/code]) nem eredményez új sort. A [constant ICON_MODE_TOP] módban lehetséges a szöveg tördelése, de a rendszer alapértelmezés szerint úgy állítja be az oszlop szélességét, hogy a teljes tartalom kiférjen. A tördeléshez a [member fixed_column_width] értékét nullánál nagyobbra kell állítani.\nMinden [code]set_*[/code] metódus elfogad negatív listaelemindexeket: a [code]-1[/code] az utolsó elemet, a [code]-2[/code] az utolsó előtti elemet jelenti, és így tovább.\n[b]Fokozatos keresés:[/b] A [PopupMenu] és [Tree] vezérlőhöz hasonlóan az [ItemList] is támogatja a listában történő keresést, amikor fókuszban van. Ha lenyomsz egy billentyűt, amely valamely listaelem nevének első betűjével egyezik, a rendszer kijelöli az első ilyen elemet. Ezután két módon folytatható a keresés: 1) a megadott időkorláton belül ugyanezt a billentyűt újra lenyomva a következő, azonos betűvel kezdődő elemet választja ki; 2) a szó további betűit a határidő lejárta előtt begépelve közvetlenül a megfelelő elemet keresheted ki. Ha a legutóbbi billentyűleütés óta letelt az időkorlát, a keresés a lista elejéről indul újra. Az időkorlát a [member ProjectSettings.gui/timers/incremental_search_max_interval_msec] beállítással módosítható."

#. ItemList.add_item
#: doc/classes/ItemList.xml
msgid "Adds an item to the item list with specified text. Returns the index of an added item.\nSpecify an [param icon], or use [code]null[/code] as the [param icon] for a list item with no icon.\nIf [param selectable] is [code]true[/code], the list item will be selectable."
msgstr "A megadott szöveggel új elemet ad a listához, és visszaadja az új elem indexét.\nA [param icon] paraméterrel ikont is megadhatsz, vagy a [param icon] értéke [code]null[/code] lehet, ha nem kell ikon.\nHa a [param selectable] értéke [code]true[/code], az elem kijelölhető."

#. ItemList.add_icon_item
#: doc/classes/ItemList.xml
msgid "Adds an item to the item list with no text, only an icon. Returns the index of an added item."
msgstr "Csak ikont tartalmazó, szöveg nélküli elemet ad a listához, és visszaadja az új elem indexét."

#. ItemList.clear
#: doc/classes/ItemList.xml
msgid "Removes all items from the list."
msgstr "Eltávolítja az összes elemet a listából."

#. ItemList.get_selected_items
#: doc/classes/ItemList.xml
msgid "Returns an array with the indexes of the selected items."
msgstr "A kijelölt elemek indexeit tartalmazó tömböt ad vissza."

#. ItemList.select
#: doc/classes/ItemList.xml
msgid "Selects the item at the specified index.\n[b]Note:[/b] This method does not trigger the item selection signal."
msgstr "Kijelöli a megadott indexű elemet.\n[b]Megjegyzés:[/b] Ez a metódus nem váltja ki az elemkijelölési jelet."

#. ItemList.remove_item
#: doc/classes/ItemList.xml
msgid "Removes the item specified by [param idx] index from the list."
msgstr "Eltávolítja a lista [param idx] indexű elemét."

#. ItemList.set_item_text
#: doc/classes/ItemList.xml
msgid "Sets text of the item associated with the specified index."
msgstr "Beállítja a megadott indexű elem szövegét."

#. ItemList.get_item_text
#: doc/classes/ItemList.xml
msgid "Returns the text associated with the specified index."
msgstr "Visszaadja a megadott indexű elem szövegét."

#. ItemList.item_count
#: doc/classes/ItemList.xml
msgid "The number of items currently in the list."
msgstr "A listában jelenleg található elemek száma."

#. ItemList.max_columns
#: doc/classes/ItemList.xml
msgid "Maximum columns the list will have.\nIf greater than zero, the content will be split among the specified columns.\nA value of zero means unlimited columns, i.e. all items will be put in the same row."
msgstr "A lista oszlopainak legnagyobb száma.\nNullánál nagyobb érték esetén a tartalom a megadott számú oszlopra oszlik.\nA nulla korlátlan számú oszlopot jelent, vagyis minden elem ugyanabba a sorba kerül."

#. ItemList.select_mode
#: doc/classes/ItemList.xml
msgid "Allows single or multiple item selection. See the [enum SelectMode] constants."
msgstr "Egy vagy több elem kijelölését engedélyezi. Lásd a [enum SelectMode] állandókat."


#. BaseButton.brief
#: doc/classes/BaseButton.xml
msgid "Abstract base class for GUI buttons."
msgstr "A grafikus felület gombjainak absztrakt alaposztálya."

#. BaseButton.description
#: doc/classes/BaseButton.xml
msgid "[BaseButton] is an abstract base class for GUI buttons. It doesn't display anything by itself."
msgstr "A [BaseButton] a grafikus felület gombjainak absztrakt alaposztálya. Önmagában nem jelenít meg semmit."

#. BaseButton._pressed
#: doc/classes/BaseButton.xml
msgid "Called when the button is pressed. If you need to know the button's pressed state (and [member toggle_mode] is active), use [method _toggled] instead."
msgstr "A gomb megnyomásakor hívódik meg. Ha a gomb lenyomott állapotára is szükséged van (és a [member toggle_mode] aktív), helyette a [method _toggled] metódust használd."

#. BaseButton._toggled
#: doc/classes/BaseButton.xml
msgid "Called when the button is toggled (only if [member toggle_mode] is active)."
msgstr "A gomb átkapcsolásakor hívódik meg (csak akkor, ha a [member toggle_mode] aktív)."

#. BaseButton.get_draw_mode
#: doc/classes/BaseButton.xml
msgid "Returns the visual state used to draw the button. This is useful mainly when implementing your own draw code by either overriding _draw() or connecting to \"draw\" signal. The visual state of the button is defined by the [enum DrawMode] enum."
msgstr "Visszaadja a gomb kirajzolásához használt vizuális állapotot. Ez főként saját rajzolókód készítésekor hasznos, ha felülírod a _draw() metódust, vagy csatlakozol a \"draw\" jelhez. A gomb vizuális állapotát a [enum DrawMode] felsorolás határozza meg."

#. BaseButton.is_hovered
#: doc/classes/BaseButton.xml
msgid "Returns [code]true[/code] if the mouse has entered the button and has not left it yet."
msgstr "[code]true[/code] értéket ad vissza, ha az egérmutató belépett a gomb területére, és még nem hagyta el."

#. BaseButton.set_pressed_no_signal
#: doc/classes/BaseButton.xml
msgid "Changes the [member button_pressed] state of the button, without emitting [signal toggled]. Use when you just want to change the state of the button without sending the pressed event (e.g. when initializing scene). Only works if [member toggle_mode] is [code]true[/code].\n[b]Note:[/b] This method doesn't unpress other buttons in [member button_group]."
msgstr "A [member button_pressed] állapotát a [signal toggled] jel kibocsátása nélkül módosítja. Akkor használd, ha a gomb állapotát meg szeretnéd változtatni anélkül, hogy lenyomási eseményt váltanál ki (például jelenet inicializálásakor). Csak akkor működik, ha a [member toggle_mode] értéke [code]true[/code].\n[b]Megjegyzés:[/b] Ez a metódus nem oldja fel a [member button_group] többi gombjának lenyomott állapotát."

#. BaseButton.action_mode
#: doc/classes/BaseButton.xml
msgid "Determines when the button is considered clicked."
msgstr "Meghatározza, hogy a rendszer mikor tekinti a gombot megnyomottnak."

#. BaseButton.button_group
#: doc/classes/BaseButton.xml
msgid "The [ButtonGroup] associated with the button. Not to be confused with node groups.\n[b]Note:[/b] The button will be configured as a radio button if a [ButtonGroup] is assigned to it."
msgstr "A gombhoz társított [ButtonGroup]. Nem tévesztendő össze a csomópontcsoportokkal.\n[b]Megjegyzés:[/b] Ha [ButtonGroup] tartozik hozzá, a gomb rádiógombként fog viselkedni."

#. BaseButton.button_mask
#: doc/classes/BaseButton.xml
msgid "Binary mask to choose which mouse buttons this button will respond to.\nTo allow both left-click and right-click, use [code]MOUSE_BUTTON_MASK_LEFT | MOUSE_BUTTON_MASK_RIGHT[/code]."
msgstr "Bitmaszk, amellyel megadható, hogy a gomb mely egérgombokra reagáljon.\nA bal és jobb egérgomb együttes engedélyezéséhez használd a [code]MOUSE_BUTTON_MASK_LEFT | MOUSE_BUTTON_MASK_RIGHT[/code] értéket."

#. BaseButton.button_pressed
#: doc/classes/BaseButton.xml
msgid "If [code]true[/code], the button's state is pressed. Means the button is pressed down or toggled (if [member toggle_mode] is active). Only works if [member toggle_mode] is [code]true[/code].\n[b]Note:[/b] Changing the value of [member button_pressed] will result in [signal toggled] to be emitted. If you want to change the pressed state without emitting that signal, use [method set_pressed_no_signal]."
msgstr "Ha [code]true[/code], a gomb lenyomott állapotban van. Ez azt jelenti, hogy a gombot lenyomva tartják, vagy bekapcsolt állapotú (ha a [member toggle_mode] aktív). Csak akkor működik, ha a [member toggle_mode] értéke [code]true[/code].\n[b]Megjegyzés:[/b] A [member button_pressed] értékének megváltoztatása kibocsátja a [signal toggled] jelet. Ha a jelet nem szeretnéd kibocsátani, használd a [method set_pressed_no_signal] metódust."

#. BaseButton.disabled
#: doc/classes/BaseButton.xml
msgid "If [code]true[/code], the button is in disabled state and can't be clicked or toggled.\n[b]Note:[/b] If the button is disabled while held down, [signal button_up] will be emitted."
msgstr "Ha [code]true[/code], a gomb le van tiltva, ezért nem lehet rákattintani vagy átkapcsolni.\n[b]Megjegyzés:[/b] Ha a gombot lenyomva tartás közben tiltod le, a [signal button_up] jel akkor is kibocsátódik."

#. BaseButton.keep_pressed_outside
#: doc/classes/BaseButton.xml
msgid "If [code]true[/code], the button stays pressed when moving the cursor outside the button while pressing it.\n[b]Note:[/b] This property only affects the button's visual appearance. Signals will be emitted at the same moment regardless of this property's value."
msgstr "Ha [code]true[/code], a gomb akkor is lenyomottnak látszik, ha lenyomva tartás közben az egérmutatót a gomb területén kívülre mozgatod.\n[b]Megjegyzés:[/b] Ez a tulajdonság csak a gomb megjelenésére hat. A jelek kibocsátásának időpontját nem változtatja meg."

#. BaseButton.shortcut
#: doc/classes/BaseButton.xml
msgid "[Shortcut] associated to the button."
msgstr "A gombhoz társított [Shortcut] billentyűparancs."

#. BaseButton.shortcut_feedback
#: doc/classes/BaseButton.xml
msgid "If [code]true[/code], the button will highlight for a short amount of time when its shortcut is activated. If [code]false[/code] and [member toggle_mode] is [code]false[/code], the shortcut will activate without any visual feedback."
msgstr "Ha [code]true[/code], a gomb rövid időre kiemelődik, amikor aktiválják a billentyűparancsát. Ha [code]false[/code], és a [member toggle_mode] is [code]false[/code], a parancs vizuális visszajelzés nélkül aktiválódik."

#. BaseButton.shortcut_in_tooltip
#: doc/classes/BaseButton.xml
msgid "If [code]true[/code], the button will add information about its shortcut in the tooltip. This includes the shortcut's events and its [member Resource.resource_name]. If both events and name are empty, the shortcut will not be included.\n[b]Note:[/b] This property does nothing when the tooltip control is customized using [method Control._make_custom_tooltip]."
msgstr "Ha [code]true[/code], a gomb az eszköztippben megjeleníti a hozzá tartozó billentyűparancs adatait: az eseményeket és a [member Resource.resource_name] értékét. Ha mindkettő üres, a billentyűparancs nem jelenik meg.\n[b]Megjegyzés:[/b] Ez a tulajdonság nem hat, ha az eszköztippet a [method Control._make_custom_tooltip] metódussal egyedileg készítetted el."

#. BaseButton.toggle_mode
#: doc/classes/BaseButton.xml
msgid "If [code]true[/code], the button is in toggle mode. Makes the button flip state between pressed and unpressed each time its area is clicked."
msgstr "Ha [code]true[/code], a gomb kapcsolóként működik: minden kattintásra vált a lenyomott és a felengedett állapot között."

#. BaseButton.button_down
#: doc/classes/BaseButton.xml
msgid "Emitted when the button starts being held down."
msgstr "Akkor bocsátódik ki, amikor elkezdik lenyomva tartani a gombot."

#. BaseButton.button_up
#: doc/classes/BaseButton.xml
msgid "Emitted when the button stops being held down."
msgstr "Akkor bocsátódik ki, amikor megszűnik a gomb lenyomva tartása."

#. BaseButton.pressed
#: doc/classes/BaseButton.xml
msgid "Emitted when the button is toggled or pressed. This is on [signal button_down] if [member action_mode] is [constant ACTION_MODE_BUTTON_PRESS] and on [signal button_up] otherwise.\nIf you need to know the button's pressed state (and [member toggle_mode] is active), use [signal toggled] instead."
msgstr "A gomb lenyomásakor vagy átkapcsolásakor bocsátódik ki. Ha a [member action_mode] értéke [constant ACTION_MODE_BUTTON_PRESS], a [signal button_down] jelhez, egyébként a [signal button_up] jelhez kapcsolódik.\nHa a gomb lenyomott állapotára is szükséged van (és a [member toggle_mode] aktív), inkább a [signal toggled] jelet használd."

#. BaseButton.toggled
#: doc/classes/BaseButton.xml
msgid "Emitted when the button was just toggled between pressed and normal states (only if [member toggle_mode] is active). The new state is contained in the [param toggled_on] argument."
msgstr "Akkor bocsátódik ki, amikor a gomb lenyomott és normál állapota között vált (csak akkor, ha a [member toggle_mode] aktív). Az új állapotot a [param toggled_on] paraméter tartalmazza."

#. BaseButton.DRAW_NORMAL
#: doc/classes/BaseButton.xml
msgid "The normal state (i.e. not pressed, not hovered, not toggled and enabled) of buttons."
msgstr "A gombok normál állapota (nincsenek lenyomva, az egérmutató nem áll fölöttük, nincsenek bekapcsolva, és engedélyezettek)."

#. BaseButton.DRAW_PRESSED
#: doc/classes/BaseButton.xml
msgid "The state of buttons are pressed."
msgstr "A gombok lenyomott állapota."

#. BaseButton.DRAW_HOVER
#: doc/classes/BaseButton.xml
msgid "The state of buttons are hovered."
msgstr "A gombok egérmutató alatti állapota."

#. BaseButton.DRAW_DISABLED
#: doc/classes/BaseButton.xml
msgid "The state of buttons are disabled."
msgstr "A gombok letiltott állapota."

#. BaseButton.DRAW_HOVER_PRESSED
#: doc/classes/BaseButton.xml
msgid "The state of buttons are both hovered and pressed."
msgstr "A gombok egyidejűleg egérmutató alatti és lenyomott állapota."

#. BaseButton.ACTION_MODE_BUTTON_PRESS
#: doc/classes/BaseButton.xml
msgid "Require just a press to consider the button clicked."
msgstr "Már a lenyomástól kattintásnak tekinti a műveletet."

#. BaseButton.ACTION_MODE_BUTTON_RELEASE
#: doc/classes/BaseButton.xml
msgid "Require a press and a subsequent release before considering the button clicked."
msgstr "Csak a lenyomást és az azt követő felengedést együtt tekinti kattintásnak."

#. CheckBox.brief
#: doc/classes/CheckBox.xml
msgid "A button that represents a binary choice."
msgstr "Kétféle választási lehetőséget kínáló gomb."

#. CheckBox.description
#: doc/classes/CheckBox.xml
msgid "[CheckBox] allows the user to choose one of only two possible options. It's similar to [CheckButton] in functionality, but it has a different appearance. To follow established UX patterns, it's recommended to use [CheckBox] when toggling it has [b]no[/b] immediate effect on something. For example, it could be used when toggling it will only do something once a confirmation button is pressed.\nSee also [BaseButton] which contains common properties and methods associated with this node.\nWhen [member BaseButton.button_group] specifies a [ButtonGroup], [CheckBox] changes its appearance to that of a radio button and uses the various [code]radio_*[/code] theme properties."
msgstr "A [CheckBox] két lehetőség közötti választást tesz lehetővé. Működésében a [CheckButton] vezérlőelemhez hasonlít, de másként jelenik meg. A bevett felhasználóifelület-tervezési minták szerint akkor érdemes [CheckBox] vezérlőt használni, ha az átkapcsolásnak [b]nincs[/b] azonnali hatása. Például akkor, ha a változtatás csak egy megerősítő gomb megnyomása után lép érvénybe.\nA közös tulajdonságokat és metódusokat lásd a [BaseButton] osztálynál.\nHa a [member BaseButton.button_group] egy [ButtonGroup] csoportot ad meg, a [CheckBox] rádiógombként jelenik meg, és a különféle [code]radio_*[/code] témaelemeket használja."

#. CheckBox.checkbox_checked_color
#: doc/classes/CheckBox.xml
msgid "The color of the checked icon when the checkbox is pressed."
msgstr "A bejelölt jelölőnégyzet ikonjának színe a gomb lenyomásakor."

#. CheckBox.checkbox_unchecked_color
#: doc/classes/CheckBox.xml
msgid "The color of the unchecked icon when the checkbox is not pressed."
msgstr "A nem bejelölt jelölőnégyzet ikonjának színe, amikor a gomb nincs lenyomva."

#. CheckBox.check_v_offset
#: doc/classes/CheckBox.xml
msgid "The vertical offset used when rendering the check icons (in pixels)."
msgstr "A jelölőikonok kirajzolásakor használt függőleges eltolás (képpontban)."

#. CheckBox.checked
#: doc/classes/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is checked."
msgstr "A [CheckBox] bejelölt állapotában megjelenő jelölőikon."

#. CheckBox.checked_disabled
#: doc/classes/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is checked and is disabled."
msgstr "A [CheckBox] bejelölt és letiltott állapotában megjelenő jelölőikon."

#. CheckBox.radio_checked
#: doc/classes/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is configured as a radio button and is checked."
msgstr "A rádiógombként beállított és kijelölt [CheckBox] jelölőikonja."

#. CheckBox.radio_checked_disabled
#: doc/classes/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is configured as a radio button, is disabled, and is unchecked."
msgstr "A rádiógombként beállított, letiltott és nem kijelölt [CheckBox] jelölőikonja."

#. CheckBox.radio_unchecked
#: doc/classes/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is configured as a radio button and is unchecked."
msgstr "A rádiógombként beállított, nem kijelölt [CheckBox] jelölőikonja."

#. CheckBox.unchecked
#: doc/classes/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is unchecked."
msgstr "A [CheckBox] nem bejelölt állapotában megjelenő jelölőikon."

#. CheckBox.unchecked_disabled
#: doc/classes/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is unchecked and is disabled."
msgstr "A [CheckBox] nem bejelölt és letiltott állapotában megjelenő jelölőikon."

#. CheckButton.description
#: doc/classes/CheckButton.xml
msgid "[CheckButton] is a toggle button displayed as a check field. It's similar to [CheckBox] in functionality, but it has a different appearance. To follow established UX patterns, it's recommended to use [CheckButton] when toggling it has an [b]immediate[/b] effect on something. For example, it can be used when pressing it shows or hides advanced settings, without asking the user to confirm this action.\nSee also [BaseButton] which contains common properties and methods associated with this node."
msgstr "A [CheckButton] egy kapcsolóként működő gomb, amely jelölőkapcsolóként jelenik meg. Működésében a [CheckBox] vezérlőelemhez hasonlít, de másként néz ki. A bevett felhasználóifelület-tervezési minták szerint akkor érdemes [CheckButton] vezérlőt használni, ha az átkapcsolásnak [b]azonnali[/b] hatása van. Például megjelenítheti vagy elrejtheti a speciális beállításokat anélkül, hogy külön megerősítésre lenne szükség.\nA közös tulajdonságokat és metódusokat lásd a [BaseButton] osztálynál."

#. CheckButton.check_v_offset
#: doc/classes/CheckButton.xml
msgid "The vertical offset used when rendering the toggle icons (in pixels)."
msgstr "A kapcsolóikonok kirajzolásakor használt függőleges eltolás (képpontban)."

#. CheckButton.checked
#: doc/classes/CheckButton.xml
msgid "The icon to display when the [CheckButton] is checked (for left-to-right layouts)."
msgstr "A bekapcsolt [CheckButton] ikonja (balról jobbra haladó elrendezésnél)."

#. CheckButton.checked_disabled
#: doc/classes/CheckButton.xml
msgid "The icon to display when the [CheckButton] is checked and disabled (for left-to-right layouts)."
msgstr "A bekapcsolt és letiltott [CheckButton] ikonja (balról jobbra haladó elrendezésnél)."

#. CheckButton.checked_disabled_mirrored
#: doc/classes/CheckButton.xml
msgid "The icon to display when the [CheckButton] is checked and disabled (for right-to-left layouts)."
msgstr "A bekapcsolt és letiltott [CheckButton] ikonja (jobbról balra haladó elrendezésnél)."

#. CheckButton.checked_mirrored
#: doc/classes/CheckButton.xml
msgid "The icon to display when the [CheckButton] is checked (for right-to-left layouts)."
msgstr "A bekapcsolt [CheckButton] ikonja (jobbról balra haladó elrendezésnél)."

#. CheckButton.unchecked
#: doc/classes/CheckButton.xml
msgid "The icon to display when the [CheckButton] is unchecked (for left-to-right layouts)."
msgstr "A kikapcsolt [CheckButton] ikonja (balról jobbra haladó elrendezésnél)."

#. CheckButton.unchecked_disabled
#: doc/classes/CheckButton.xml
msgid "The icon to display when the [CheckButton] is unchecked and disabled (for left-to-right layouts)."
msgstr "A kikapcsolt és letiltott [CheckButton] ikonja (balról jobbra haladó elrendezésnél)."

#. CheckButton.unchecked_disabled_mirrored
#: doc/classes/CheckButton.xml
msgid "The icon to display when the [CheckButton] is unchecked and disabled (for right-to-left layouts)."
msgstr "A kikapcsolt és letiltott [CheckButton] ikonja (jobbról balra haladó elrendezésnél)."

#. CheckButton.unchecked_mirrored
#: doc/classes/CheckButton.xml
msgid "The icon to display when the [CheckButton] is unchecked (for right-to-left layouts)."
msgstr "A kikapcsolt [CheckButton] ikonja (jobbról balra haladó elrendezésnél)."

#. ButtonGroup.brief
#: doc/classes/ButtonGroup.xml
msgid "A group of buttons that doesn't allow more than one button to be pressed at a time."
msgstr "Gombcsoport, amelyben egyszerre legfeljebb egy gomb lehet lenyomva."

#. ButtonGroup.description
#: doc/classes/ButtonGroup.xml
msgid "A group of [BaseButton]-derived buttons. The buttons in a [ButtonGroup] are treated like radio buttons: No more than one button can be pressed at a time. Some types of buttons (such as [CheckBox]) may have a special appearance in this state.\nEvery member of a [ButtonGroup] should have [member BaseButton.toggle_mode] set to [code]true[/code]."
msgstr "A [BaseButton] leszármazottaiból álló gombcsoport. A [ButtonGroup] gombjai rádiógombokként működnek: egyszerre legfeljebb egy lehet lenyomva. Egyes gombtípusok (például a [CheckBox]) ebben az állapotban különleges megjelenést kapnak.\nA [ButtonGroup] minden tagjánál a [member BaseButton.toggle_mode] értékének [code]true[/code]-nak kell lennie."

#. ButtonGroup.get_buttons
#: doc/classes/ButtonGroup.xml
msgid "Returns an [Array] of [Button]s who have this as their [ButtonGroup] (see [member BaseButton.button_group])."
msgstr "Visszaad egy [Array] tömböt azokból a [Button] gombokból, amelyek ehhez a [ButtonGroup] csoporthoz tartoznak (lásd: [member BaseButton.button_group])."

#. ButtonGroup.get_pressed_button
#: doc/classes/ButtonGroup.xml
msgid "Returns the current pressed button."
msgstr "Visszaadja a jelenleg lenyomott gombot."

#. ButtonGroup.allow_unpress
#: doc/classes/ButtonGroup.xml
msgid "If [code]true[/code], it is possible to unpress all buttons in this [ButtonGroup]."
msgstr "Ha [code]true[/code], lehetőség van arra, hogy a [ButtonGroup] összes gombja felengedett állapotban legyen."

#. ButtonGroup.pressed
#: doc/classes/ButtonGroup.xml
msgid "Emitted when one of the buttons of the group is pressed."
msgstr "A csoport egyik gombjának lenyomásakor bocsátódik ki."

#. TabBar.ensure_tab_visible
#: doc/classes/TabBar.xml
msgid "Moves the scroll view to make the tab visible."
msgstr "A görgetett nézetet úgy mozgatja, hogy a fül láthatóvá váljon."


#. TabBar.get_offset_buttons_visible
#: doc/classes/TabBar.xml
msgid "Returns [code]true[/code] if the offset buttons (the ones that appear when there's not enough space for all tabs) are visible."
msgstr "[code]true[/code] értéket ad vissza, ha láthatók az eltoló gombok (amelyek akkor jelennek meg, ha nincs elég hely az összes fülnek)."


#. TabBar.get_previous_tab
#: doc/classes/TabBar.xml
msgid "Returns the previously active tab index."
msgstr "Visszaadja a korábban aktív fül indexét."


#. TabBar.get_tab_button_icon
#: doc/classes/TabBar.xml
msgid "Returns the icon for the right button of the tab at index [param tab_idx] or [code]null[/code] if the right button has no icon."
msgstr "Visszaadja a [param tab_idx] indexű fül jobb oldali gombjának ikonját, vagy [code]null[/code] értéket, ha a jobb oldali gombhoz nem tartozik ikon."


#. TabBar.get_tab_icon
#: doc/classes/TabBar.xml
msgid "Returns the icon for the tab at index [param tab_idx] or [code]null[/code] if the tab has no icon."
msgstr "Visszaadja a [param tab_idx] indexű fül ikonját, vagy [code]null[/code] értéket, ha a fülnek nincs ikonja."


#. TabBar.get_tab_icon_max_width
#: doc/classes/TabBar.xml
msgid "Returns the maximum allowed width of the icon for the tab at index [param tab_idx]."
msgstr "Visszaadja a [param tab_idx] indexű fül ikonjának megengedett legnagyobb szélességét."


#. TabBar.get_tab_idx_at_point
#: doc/classes/TabBar.xml
msgid "Returns the index of the tab at local coordinates [param point]. Returns [code]-1[/code] if the point is outside the control boundaries or if there's no tab at the queried position."
msgstr "Visszaadja a [param point] helyi koordinátáknál található fül indexét. [code]-1[/code] értéket ad vissza, ha a pont a vezérlőelem határain kívül esik, vagy ott nincs fül."


#. TabBar.get_tab_language
#: doc/classes/TabBar.xml
msgid "Returns tab title language code."
msgstr "Visszaadja a fül címének nyelvkódját."


#. TabBar.get_tab_metadata
#: doc/classes/TabBar.xml
msgid "Returns the metadata value set to the tab at index [param tab_idx] using [method set_tab_metadata]. If no metadata was previously set, returns [code]null[/code] by default."
msgstr "Visszaadja a [param tab_idx] indexű fülhöz a [method set_tab_metadata] metódussal beállított metaadatot. Ha korábban nem adtak meg metaadatot, alapértelmezés szerint [code]null[/code] értéket ad vissza."


#. TabBar.get_tab_offset
#: doc/classes/TabBar.xml
msgid "Returns the number of hidden tabs offsetted to the left."
msgstr "Visszaadja a balra eltolva elrejtett fülek számát."


#. TabBar.get_tab_rect
#: doc/classes/TabBar.xml
msgid "Returns tab [Rect2] with local position and size."
msgstr "Visszaadja a fül helyi pozícióját és méretét tartalmazó [Rect2] értéket."


#. TabBar.get_tab_text_direction
#: doc/classes/TabBar.xml
msgid "Returns tab title text base writing direction."
msgstr "Visszaadja a fül címének alapvető írásirányát."


#. TabBar.get_tab_tooltip
#: doc/classes/TabBar.xml
msgid "Returns the tooltip text of the tab at index [param tab_idx]."
msgstr "Visszaadja a [param tab_idx] indexű fül eszköztippszövegét."


#. TabBar.is_tab_disabled
#: doc/classes/TabBar.xml
msgid "Returns [code]true[/code] if the tab at index [param tab_idx] is disabled."
msgstr "[code]true[/code] értéket ad vissza, ha a [param tab_idx] indexű fül le van tiltva."


#. TabBar.is_tab_hidden
#: doc/classes/TabBar.xml
msgid "Returns [code]true[/code] if the tab at index [param tab_idx] is hidden."
msgstr "[code]true[/code] értéket ad vissza, ha a [param tab_idx] indexű fül el van rejtve."


#. TabBar.select_next_available
#: doc/classes/TabBar.xml
msgid "Selects the first available tab with greater index than the currently selected. Returns [code]true[/code] if tab selection changed."
msgstr "Kijelöli a jelenleg kijelölt fülnél nagyobb indexű első elérhető fület. [code]true[/code] értéket ad vissza, ha megváltozott a kijelölés."


#. TabBar.select_previous_available
#: doc/classes/TabBar.xml
msgid "Selects the first available tab with lower index than the currently selected. Returns [code]true[/code] if tab selection changed."
msgstr "Kijelöli a jelenleg kijelölt fülnél kisebb indexű első elérhető fület. [code]true[/code] értéket ad vissza, ha megváltozott a kijelölés."


#. TabContainer.get_popup
#: doc/classes/TabContainer.xml
msgid "Returns the [Popup] node instance if one has been set already with [method set_popup].\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash. If you wish to hide it or any of its children, use their [member Window.visible] property."
msgstr "Visszaadja a [Popup] csomópont példányát, ha azt korábban beállították a [method set_popup] metódussal.\n[b]Figyelmeztetés:[/b] Ez egy szükséges belső csomópont; eltávolítása és felszabadítása összeomlást okozhat. Ha el szeretnéd rejteni ezt vagy valamelyik gyermekét, használd a [member Window.visible] tulajdonságot."


#. TabContainer.get_tab_bar
#: doc/classes/TabContainer.xml
msgid "Returns the [TabBar] contained in this container.\n[b]Warning:[/b] This is a required internal node, removing and freeing it or editing its tabs may cause a crash. If you wish to edit the tabs, use the methods provided in [TabContainer]."
msgstr "Visszaadja a tárolóban található [TabBar] csomópontot.\n[b]Figyelmeztetés:[/b] Ez egy szükséges belső csomópont; eltávolítása és felszabadítása, illetve füleinek közvetlen szerkesztése összeomlást okozhat. A fülek módosításához a [TabContainer] által biztosított metódusokat használd."


#. TabContainer.get_tab_button_icon
#: doc/classes/TabContainer.xml
msgid "Returns the button icon from the tab at index [param tab_idx]."
msgstr "Visszaadja a [param tab_idx] indexű fül gombjának ikonját."


#. TabContainer.get_tab_icon
#: doc/classes/TabContainer.xml
msgid "Returns the [Texture2D] for the tab at index [param tab_idx] or [code]null[/code] if the tab has no [Texture2D]."
msgstr "Visszaadja a [param tab_idx] indexű fül [Texture2D] ikonját, vagy [code]null[/code] értéket, ha a fülnek nincs [Texture2D] erőforrása."


#. TabContainer.get_tab_idx_from_control
#: doc/classes/TabContainer.xml
msgid "Returns the index of the tab tied to the given [param control]. The control must be a child of the [TabContainer]."
msgstr "Visszaadja a [param control] vezérlőelemhez társított fül indexét. A vezérlőelemnek a [TabContainer] gyermekének kell lennie."


#. TabContainer.set_popup
#: doc/classes/TabContainer.xml
msgid "If set on a [Popup] node instance, a popup menu icon appears in the top-right corner of the [TabContainer] (setting it to [code]null[/code] will make it go away). Clicking it will expand the [Popup] node."
msgstr "Ha egy [Popup] csomópontot adsz meg, a [TabContainer] jobb felső sarkában felugrómenü-ikon jelenik meg (a [code]null[/code] érték eltünteti). Az ikonra kattintva megnyílik a [Popup] csomópont."


#. TabContainer.set_tab_button_icon
#: doc/classes/TabContainer.xml
msgid "Sets the button icon from the tab at index [param tab_idx]."
msgstr "Beállítja a [param tab_idx] indexű fül gombjának ikonját."


#. TabContainer.set_tab_disabled
#: doc/classes/TabContainer.xml
msgid "If [param disabled] is [code]true[/code], disables the tab at index [param tab_idx], making it non-interactable."
msgstr "Ha a [param disabled] értéke [code]true[/code], letiltja a [param tab_idx] indexű fület, így nem lehet vele műveletet végezni."


#. TabContainer.set_tab_hidden
#: doc/classes/TabContainer.xml
msgid "If [param hidden] is [code]true[/code], hides the tab at index [param tab_idx], making it disappear from the tab area."
msgstr "Ha a [param hidden] értéke [code]true[/code], elrejti a [param tab_idx] indexű fület a fülsávról."


#. ItemList.center_on_current
#: doc/classes/ItemList.xml
msgid "Ensures the currently selected item (the first selected item if multiple selection is enabled) is visible, adjusting the scroll position as necessary to place the item at the center of the list if possible. See also [method ensure_current_is_visible].\nFails and prints an error if both arguments are [code]false[/code]."
msgstr "Biztosítja, hogy a jelenleg kijelölt elem (többszörös kijelölés esetén az első kijelölt elem) látható legyen. Szükség esetén a görgetési pozíciót úgy állítja, hogy az elem lehetőség szerint a lista közepére kerüljön. Lásd még: [method ensure_current_is_visible].\nHibával tér vissza, és hibaüzenetet ír ki, ha mindkét argumentum [code]false[/code]."


#. ItemList.deselect
#: doc/classes/ItemList.xml
msgid "Ensures the item associated with the specified index is not selected."
msgstr "Megszünteti a megadott indexű elem kijelölését."


#. ItemList.deselect_all
#: doc/classes/ItemList.xml
msgid "Ensures there are no items selected."
msgstr "Megszünteti az összes elem kijelölését."


#. ItemList.ensure_current_is_visible
#: doc/classes/ItemList.xml
msgid "Ensures the currently selected item (the first selected item if multiple selection is enabled) is visible, adjusting the scroll position as necessary. See also [method center_on_current]."
msgstr "Biztosítja, hogy a jelenleg kijelölt elem (többszörös kijelölés esetén az első kijelölt elem) látható legyen, és szükség esetén módosítja a görgetési pozíciót. Lásd még: [method center_on_current]."


#. ItemList.force_update_list_size
#: doc/classes/ItemList.xml
msgid "Forces an update to the list size based on its items. This happens automatically whenever size of the items, or other relevant settings like [member auto_height], change. The method can be used to trigger the update ahead of next drawing pass."
msgstr "Kikényszeríti a lista méretének újraszámítását az elemei alapján. Ez automatikusan is megtörténik, ha az elemek mérete vagy egy kapcsolódó beállítás, például a [member auto_height] megváltozik. A metódussal a következő kirajzolás előtt is elindítható a frissítés."


#. ItemList.get_h_scroll_bar
#: doc/classes/ItemList.xml
msgid "Returns the horizontal scrollbar.\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash. If you wish to hide it or any of its children, use their [member CanvasItem.visible] property."
msgstr "Visszaadja a vízszintes görgetősávot.\n[b]Figyelmeztetés:[/b] Ez egy szükséges belső csomópont; eltávolítása és felszabadítása összeomlást okozhat. Ha el szeretnéd rejteni ezt vagy valamelyik gyermekét, használd a [member CanvasItem.visible] tulajdonságot."


#. ItemList.get_item_at_position
#: doc/classes/ItemList.xml
msgid "Returns the item index at the given [param position].\nWhen there is no item at that point, -1 will be returned if [param exact] is [code]true[/code], and the closest item index will be returned otherwise.\n[b]Note:[/b] The returned value is unreliable if called right after modifying the [ItemList], before it redraws in the next frame."
msgstr "Visszaadja a [param position] pozíciónál található elem indexét.\nHa ott nincs elem, a visszatérési érték -1, amennyiben a [param exact] értéke [code]true[/code]; ellenkező esetben a legközelebbi elem indexét adja vissza.\n[b]Megjegyzés:[/b] A visszaadott érték megbízhatatlan lehet közvetlenül a [ItemList] módosítása után, mielőtt a következő képkockában újrarajzolódna."


#. ItemList.get_item_auto_translate_mode
#: doc/classes/ItemList.xml
msgid "Returns item's auto translate mode."
msgstr "Visszaadja az elem automatikus fordítási módját."


#. ItemList.get_item_custom_bg_color
#: doc/classes/ItemList.xml
msgid "Returns the custom background color of the item specified by [param idx] index."
msgstr "Visszaadja a [param idx] indexű elem egyedi háttérszínét."


#. ItemList.get_item_custom_fg_color
#: doc/classes/ItemList.xml
msgid "Returns the custom foreground color of the item specified by [param idx] index."
msgstr "Visszaadja a [param idx] indexű elem egyedi előtérszínét."


#. ItemList.get_item_icon
#: doc/classes/ItemList.xml
msgid "Returns the icon associated with the specified index."
msgstr "Visszaadja a megadott indexű elemhez tartozó ikont."


#. ItemList.get_item_icon_modulate
#: doc/classes/ItemList.xml
msgid "Returns a [Color] modulating item's icon at the specified index."
msgstr "Visszaadja a megadott indexű elem ikonjának színét módosító [Color] értéket."


#. ItemList.get_item_icon_region
#: doc/classes/ItemList.xml
msgid "Returns the region of item's icon used. The whole icon will be used if the region has no area."
msgstr "Visszaadja az elem ikonjának felhasznált területét. Ha a terület mérete nulla, a teljes ikon kerül felhasználásra."


#. ItemList.get_item_language
#: doc/classes/ItemList.xml
msgid "Returns item's text language code."
msgstr "Visszaadja az elem szövegének nyelvkódját."


#. ItemList.get_item_metadata
#: doc/classes/ItemList.xml
msgid "Returns the metadata value of the specified index."
msgstr "Visszaadja a megadott indexű elem metaadatát."


#. ItemList.get_item_rect
#: doc/classes/ItemList.xml
msgid "Returns the position and size of the item with the specified index, in the coordinate system of the [ItemList] node. If [param expand] is [code]true[/code] the last column expands to fill the rest of the row.\n[b]Note:[/b] The returned value is unreliable if called right after modifying the [ItemList], before it redraws in the next frame."
msgstr "Visszaadja a megadott indexű elem pozícióját és méretét az [ItemList] csomópont koordinátarendszerében. Ha a [param expand] értéke [code]true[/code], az utolsó oszlop kitölti a sor fennmaradó részét.\n[b]Megjegyzés:[/b] A visszaadott érték megbízhatatlan lehet közvetlenül a [ItemList] módosítása után, mielőtt a következő képkockában újrarajzolódna."


#. ItemList.get_item_text_direction
#: doc/classes/ItemList.xml
msgid "Returns item's text base writing direction."
msgstr "Visszaadja az elem szövegének alapvető írásirányát."


#. ItemList.get_item_tooltip
#: doc/classes/ItemList.xml
msgid "Returns the tooltip hint associated with the specified index."
msgstr "Visszaadja a megadott indexű elemhez társított eszköztippet."


#. ItemList.get_v_scroll_bar
#: doc/classes/ItemList.xml
msgid "Returns the vertical scrollbar.\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash. If you wish to hide it or any of its children, use their [member CanvasItem.visible] property."
msgstr "Visszaadja a függőleges görgetősávot.\n[b]Figyelmeztetés:[/b] Ez egy szükséges belső csomópont; eltávolítása és felszabadítása összeomlást okozhat. Ha el szeretnéd rejteni ezt vagy valamelyik gyermekét, használd a [member CanvasItem.visible] tulajdonságot."


#. ItemList.is_anything_selected
#: doc/classes/ItemList.xml
msgid "Returns [code]true[/code] if one or more items are selected."
msgstr "[code]true[/code] értéket ad vissza, ha egy vagy több elem ki van jelölve."

#. TabBar.set_tab_button_icon
#: doc/classes/TabBar.xml
msgid "Sets an [param icon] for the button of the tab at index [param tab_idx] (located to the right, before the close button), making it visible and clickable (See [signal tab_button_pressed]). Giving it a [code]null[/code] value will hide the button."
msgstr "Beállítja a [param tab_idx] indexű fül gombjának [param icon] ikonját (a jobb oldalon, a bezárás gombja előtt), és ezzel láthatóvá, kattinthatóvá teszi (lásd: [signal tab_button_pressed]). A [code]null[/code] érték elrejti a gombot."


#. TabBar.set_tab_icon
#: doc/classes/TabBar.xml
msgid "Sets an [param icon] for the tab at index [param tab_idx]."
msgstr "Beállítja a [param tab_idx] indexű fül [param icon] ikonját."


#. TabBar.set_tab_icon_max_width
#: doc/classes/TabBar.xml
msgid "Sets the maximum allowed width of the icon for the tab at index [param tab_idx]. This limit is applied on top of the default size of the icon and on top of [theme_item icon_max_width]. The height is adjusted according to the icon's ratio."
msgstr "Beállítja a [param tab_idx] indexű fül ikonjának legnagyobb megengedett szélességét. Ez a korlát az ikon alapértelmezett méretén és a [theme_item icon_max_width] értékén felül érvényesül. A magasságot az ikon képarányához igazítja."


#. TabBar.set_tab_language
#: doc/classes/TabBar.xml
msgid "Sets the language code of the title for the tab at index [param tab_idx] to [param language]. This is used for line-breaking and text shaping algorithms. If [param language] is empty, the current locale is used."
msgstr "A [param tab_idx] indexű fül címének nyelvkódját a [param language] értékre állítja. Ezt a sortörési és szövegformázási algoritmusok használják. Üres [param language] esetén az aktuális területi beállítás érvényesül."


#. TabBar.set_tab_metadata
#: doc/classes/TabBar.xml
msgid "Sets the metadata value for the tab at index [param tab_idx], which can be retrieved later using [method get_tab_metadata]."
msgstr "Beállítja a [param tab_idx] indexű fül metaadatát. Az érték később a [method get_tab_metadata] metódussal kérhető le."


#. TabBar.set_tab_text_direction
#: doc/classes/TabBar.xml
msgid "Sets tab title base writing direction."
msgstr "Beállítja a fül címének alapvető írásirányát."


#. TabBar.set_tab_tooltip
#: doc/classes/TabBar.xml
msgid "Sets a [param tooltip] for tab at index [param tab_idx].\n[b]Note:[/b] By default, if the [param tooltip] is empty and the tab text is truncated (not all characters fit into the tab), the title will be displayed as a tooltip. To hide the tooltip, assign [code]\" \"[/code] as the [param tooltip] text."
msgstr "Beállítja a [param tab_idx] indexű fül [param tooltip] eszköztippjét.\n[b]Megjegyzés:[/b] Alapértelmezés szerint, ha a [param tooltip] üres, és a fül szövege le van vágva (nem fér ki minden karakter), a teljes cím jelenik meg eszköztippként. Az eszköztipp elrejtéséhez a [param tooltip] szövegének [code]\" \"[/code] értéket adj meg."


#. TabBar.close_with_middle_mouse
#: doc/classes/TabBar.xml
msgid "If [code]true[/code], middle-clicking on a tab will emit the [signal tab_close_pressed] signal."
msgstr "Ha [code]true[/code], a fülön végzett középső egérgombos kattintás kibocsátja a [signal tab_close_pressed] jelet."


#. TabBar.deselect_enabled
#: doc/classes/TabBar.xml
msgid "If [code]true[/code], all tabs can be deselected so that no tab is selected. Click on the current tab to deselect it."
msgstr "Ha [code]true[/code], az összes fül kijelölése megszüntethető, így egyik sem marad kijelölve. Az aktuális fülre kattintva megszüntetheted a kijelölését."


#. TabBar.max_tab_width
#: doc/classes/TabBar.xml
msgid "Sets the maximum width which all tabs should be limited to. Unlimited if set to [code]0[/code]."
msgstr "Beállítja a fülek legnagyobb megengedett szélességét. [code]0[/code] esetén nincs korlátozás."


#. TabBar.scroll_to_selected
#: doc/classes/TabBar.xml
msgid "If [code]true[/code], the tab offset will be changed to keep the currently selected tab visible."
msgstr "Ha [code]true[/code], a fülek eltolása úgy változik, hogy az aktuálisan kijelölt fül látható maradjon."


#. TabBar.scrolling_enabled
#: doc/classes/TabBar.xml
msgid "if [code]true[/code], the mouse's scroll wheel can be used to navigate the scroll view."
msgstr "Ha [code]true[/code], az egér görgőjével is lehet navigálni a görgetett nézetben."


#. TabBar.select_with_rmb
#: doc/classes/TabBar.xml
msgid "If [code]true[/code], enables selecting a tab with the right mouse button."
msgstr "Ha [code]true[/code], a jobb egérgombbal is ki lehet jelölni egy fület."


#. TabBar.switch_on_drag_hover
#: doc/classes/TabBar.xml
msgid "If [code]true[/code], hovering over a tab while dragging something will switch to that tab. Does not have effect when hovering another tab to rearrange. The delay for when this happens is dictated by [theme_item hover_switch_wait_msec]."
msgstr "Ha [code]true[/code], egy elem húzása közben egy másik fül fölé mozgatva az egérmutatót a rendszer arra a fülre vált. Ez nem érvényes, ha a fülek átrendezésekor egy másik fül fölé húzod a fület. A váltás késleltetését a [theme_item hover_switch_wait_msec] határozza meg."


#. TabBar.tab_alignment
#: doc/classes/TabBar.xml
msgid "The horizontal alignment of the tabs."
msgstr "A fülek vízszintes igazítása."


#. TabBar.tab_close_display_policy
#: doc/classes/TabBar.xml
msgid "When the close button will appear on the tabs."
msgstr "Meghatározza, mikor jelenjen meg a fülek bezárógombja."


#. TabBar.tab_{index}/disabled
#: doc/classes/TabBar.xml
msgid "If [code]true[/code], the tab at [code]index[/code] is disabled.\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. tab_count - 1[/code] range."
msgstr "Ha [code]true[/code], a [code]index[/code] indexű fül le van tiltva.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. tab_count - 1[/code] tartományba esik."


#. TabBar.tab_{index}/icon
#: doc/classes/TabBar.xml
msgid "If [code]true[/code], the tab at [code]index[/code] is hidden.\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. tab_count - 1[/code] range."
msgstr "Ha [code]true[/code], a [code]index[/code] indexű fül el van rejtve.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. tab_count - 1[/code] tartományba esik."


#. TabBar.tab_{index}/title
#: doc/classes/TabBar.xml
msgid "The title text of the tab at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. tab_count - 1[/code] range."
msgstr "A [code]index[/code] indexű fül címszövege.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. tab_count - 1[/code] tartományba esik."


#. TabBar.tab_{index}/tooltip
#: doc/classes/TabBar.xml
msgid "The tooltip text of the tab at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. tab_count - 1[/code] range."
msgstr "A [code]index[/code] indexű fül eszköztippszövege.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. tab_count - 1[/code] tartományba esik."


#. TabBar.tabs_rearrange_group
#: doc/classes/TabBar.xml
msgid "[TabBar]s with the same rearrange group ID will allow dragging the tabs between them. Enable drag with [member drag_to_rearrange_enabled].\nSetting this to [code]-1[/code] will disable rearranging between [TabBar]s."
msgstr "Azonos átrendezési csoportazonosítóval rendelkező [TabBar] elemek között a fülek áthúzhatók. A húzást a [member drag_to_rearrange_enabled] tulajdonsággal engedélyezheted.\nHa az érték [code]-1[/code], a különböző [TabBar] elemek közötti átrendezés le van tiltva."


#. TabBar.active_tab_rearranged
#: doc/classes/TabBar.xml
msgid "Emitted when the active tab is rearranged via mouse drag. See [member drag_to_rearrange_enabled]."
msgstr "Akkor bocsátódik ki, amikor az aktív fület egérrel húzva átrendezik. Lásd: [member drag_to_rearrange_enabled]."


#. TabBar.tab_button_pressed
#: doc/classes/TabBar.xml
msgid "Emitted when a tab's right button is pressed. See [method set_tab_button_icon]."
msgstr "Akkor bocsátódik ki, amikor megnyomják egy fül jobb oldali gombját. Lásd: [method set_tab_button_icon]."


#. TabBar.tab_changed
#: doc/classes/TabBar.xml
msgid "Emitted when switching to another tab."
msgstr "Akkor bocsátódik ki, amikor másik fülre váltanak."


#. TabBar.tab_clicked
#: doc/classes/TabBar.xml
msgid "Emitted when a tab is clicked, even if it is the current tab."
msgstr "Akkor bocsátódik ki, amikor rákattintanak egy fülre, akkor is, ha már az az aktuális fül."


#. TabBar.tab_close_pressed
#: doc/classes/TabBar.xml
msgid "Emitted when a tab's close button is pressed or, if [member close_with_middle_mouse] is [code]true[/code], when middle-clicking on a tab.\n[b]Note:[/b] Tabs are not removed automatically; this behavior needs to be coded manually. For example:\n[codeblocks]\n[gdscript]\n$TabBar.tab_close_pressed.connect($TabBar.remove_tab)\n[/gdscript]\n[csharp]\nGetNode&lt;TabBar&gt;(\"TabBar\").TabClosePressed += GetNode&lt;TabBar&gt;(\"TabBar\").RemoveTab;\n[/csharp]\n[/codeblocks]"
msgstr "Akkor bocsátódik ki, amikor megnyomják egy fül bezárógombját, vagy — ha a [member close_with_middle_mouse] értéke [code]true[/code] — középső egérgombbal kattintanak a fülre.\n[b]Megjegyzés:[/b] A fülek nem törlődnek automatikusan; ezt a működést saját kóddal kell megvalósítani. Például:\n[codeblocks]\n[gdscript]\n$TabBar.tab_close_pressed.connect($TabBar.remove_tab)\n[/gdscript]\n[csharp]\nGetNode&lt;TabBar&gt;(\"TabBar\").TabClosePressed += GetNode&lt;TabBar&gt;(\"TabBar\").RemoveTab;\n[/csharp]\n[/codeblocks]"


#. TabBar.tab_hovered
#: doc/classes/TabBar.xml
msgid "Emitted when a tab is hovered by the mouse."
msgstr "Akkor bocsátódik ki, amikor az egérmutató egy fül fölé kerül."


#. TabBar.tab_rmb_clicked
#: doc/classes/TabBar.xml
msgid "Emitted when a tab is right-clicked."
msgstr "Akkor bocsátódik ki, amikor jobb egérgombbal kattintanak egy fülre."


#. TabBar.tab_selected
#: doc/classes/TabBar.xml
msgid "Emitted when a tab is selected via click, directional input, or script, even if it is the current tab."
msgstr "Akkor bocsátódik ki, amikor egy fület kattintással, iránygombos vezérléssel vagy szkriptből kijelölnek, akkor is, ha már az az aktuális fül."


#. TabBar.ALIGNMENT_LEFT
#: doc/classes/TabBar.xml
msgid "Aligns tabs to the left."
msgstr "Balra igazítja a füleket."


#. TabBar.ALIGNMENT_CENTER
#: doc/classes/TabBar.xml
msgid "Aligns tabs in the middle."
msgstr "Középre igazítja a füleket."


#. TabBar.ALIGNMENT_RIGHT
#: doc/classes/TabBar.xml
msgid "Aligns tabs to the right."
msgstr "Jobbra igazítja a füleket."


#. TabBar.ALIGNMENT_MAX
#: doc/classes/TabBar.xml
msgid "Represents the size of the [enum AlignmentMode] enum."
msgstr "Az [enum AlignmentMode] felsorolás méretét jelöli."


#. TabBar.CLOSE_BUTTON_SHOW_NEVER
#: doc/classes/TabBar.xml
msgid "Never show the close buttons."
msgstr "Soha nem jeleníti meg a bezárógombokat."


#. TabBar.CLOSE_BUTTON_SHOW_ACTIVE_ONLY
#: doc/classes/TabBar.xml
msgid "Only show the close button on the currently active tab."
msgstr "Csak az aktuálisan aktív fülön jeleníti meg a bezárógombot."


#. TabBar.CLOSE_BUTTON_SHOW_ALWAYS
#: doc/classes/TabBar.xml
msgid "Show the close button on all tabs."
msgstr "Minden fülön megjeleníti a bezárógombot."


#. TabBar.CLOSE_BUTTON_MAX
#: doc/classes/TabBar.xml
msgid "Represents the size of the [enum CloseButtonDisplayPolicy] enum."
msgstr "Az [enum CloseButtonDisplayPolicy] felsorolás méretét jelöli."

#. TabBar.drop_mark_color
#: doc/classes/TabBar.xml
msgid "Modulation color for the [theme_item drop_mark] icon."
msgstr "A [theme_item drop_mark] ikon színének módosítására használt szín."


#. TabBar.font_disabled_color
#: doc/classes/TabBar.xml
msgid "Font color of disabled tabs."
msgstr "A letiltott fülek betűszíne."


#. TabBar.font_hovered_color
#: doc/classes/TabBar.xml
msgid "Font color of the currently hovered tab. Does not apply to the selected tab."
msgstr "Az egérmutató alatt lévő fül betűszíne. A kijelölt fülre nem vonatkozik."


#. TabBar.font_outline_color
#: doc/classes/TabBar.xml
msgid "The tint of text outline of the tab name."
msgstr "A fül címszövege körvonalának színezése."


#. TabBar.font_selected_color
#: doc/classes/TabBar.xml
msgid "Font color of the currently selected tab."
msgstr "Az aktuálisan kijelölt fül betűszíne."


#. TabBar.font_unselected_color
#: doc/classes/TabBar.xml
msgid "Font color of the other, unselected tabs."
msgstr "A többi, nem kijelölt fül betűszíne."


#. TabBar.icon_disabled_color
#: doc/classes/TabBar.xml
msgid "Icon color of disabled tabs."
msgstr "A letiltott fülek ikonszíne."


#. TabBar.icon_hovered_color
#: doc/classes/TabBar.xml
msgid "Icon color of the currently hovered tab. Does not apply to the selected tab."
msgstr "Az egérmutató alatt lévő fül ikonszíne. A kijelölt fülre nem vonatkozik."


#. TabBar.icon_selected_color
#: doc/classes/TabBar.xml
msgid "Icon color of the currently selected tab."
msgstr "Az aktuálisan kijelölt fül ikonszíne."


#. TabBar.icon_unselected_color
#: doc/classes/TabBar.xml
msgid "Icon color of the other, unselected tabs."
msgstr "A többi, nem kijelölt fül ikonszíne."


#. TabBar.h_separation
#: doc/classes/TabBar.xml
msgid "The horizontal separation between the elements inside tabs."
msgstr "A fülön belüli elemek vízszintes térköze."


#. TabBar.hover_switch_wait_msec
#: doc/classes/TabBar.xml
msgid "During a drag-and-drop, this is how many milliseconds to wait before switching the tab."
msgstr "Ennyi ezredmásodpercet vár a rendszer húzás és ejtés közben, mielőtt másik fülre váltana."


#. TabBar.icon_max_width
#: doc/classes/TabBar.xml
msgid "The maximum allowed width of the tab's icon. This limit is applied on top of the default size of the icon, but before the value set with [method set_tab_icon_max_width]. The height is adjusted according to the icon's ratio."
msgstr "A fül ikonjának legnagyobb megengedett szélessége. Ez az ikon alapértelmezett méretén felül, de a [method set_tab_icon_max_width] metódussal megadott érték előtt érvényesül. A magasság az ikon képarányához igazodik."


#. TabBar.outline_size
#: doc/classes/TabBar.xml
msgid "The size of the tab text outline.\n[b]Note:[/b] If using a font with [member FontFile.multichannel_signed_distance_field] enabled, its [member FontFile.msdf_pixel_range] must be set to at least [i]twice[/i] the value of [theme_item outline_size] for outline rendering to look correct. Otherwise, the outline may appear to be cut off earlier than intended."
msgstr "A fül címszövege körvonalának vastagsága.\n[b]Megjegyzés:[/b] Ha olyan betűkészletet használsz, amelynél a [member FontFile.multichannel_signed_distance_field] engedélyezett, a [member FontFile.msdf_pixel_range] értékének legalább [i]kétszer[/i] akkorának kell lennie, mint a [theme_item outline_size], hogy a körvonal megfelelően jelenjen meg. Ellenkező esetben úgy tűnhet, mintha a körvonal a kelleténél előbb levágódna."


#. TabBar.tab_separation
#: doc/classes/TabBar.xml
msgid "The space between tabs in the tab bar."
msgstr "A fülsáv fülei közötti térköz."


#. TabBar.font
#: doc/classes/TabBar.xml
msgid "The font used to draw tab names."
msgstr "A fülek címeinek megjelenítésére használt betűkészlet."


#. TabBar.font_size
#: doc/classes/TabBar.xml
msgid "Font size of the tab names."
msgstr "A fülek címeinek betűmérete."


#. TabBar.close
#: doc/classes/TabBar.xml
msgid "The icon for the close button (see [member tab_close_display_policy])."
msgstr "A bezárógomb ikonja (lásd: [member tab_close_display_policy])."


#. TabBar.decrement
#: doc/classes/TabBar.xml
msgid "Icon for the left arrow button that appears when there are too many tabs to fit in the container width. When the button is disabled (i.e. the first tab is visible), it appears semi-transparent."
msgstr "A balra mutató nyílgomb ikonja, amely akkor jelenik meg, ha a fülek nem férnek el a tároló szélességén. Ha a gomb le van tiltva (vagyis az első fül már látható), félig átlátszóként jelenik meg."


#. TabBar.decrement_highlight
#: doc/classes/TabBar.xml
msgid "Icon for the left arrow button that appears when there are too many tabs to fit in the container width. Used when the button is being hovered with the cursor."
msgstr "A balra mutató nyílgomb ikonja, amely akkor jelenik meg, ha a fülek nem férnek el a tároló szélességén. Akkor használja a rendszer, amikor az egérmutató a gomb fölött van."


#. TabBar.drop_mark
#: doc/classes/TabBar.xml
msgid "Icon shown to indicate where a dragged tab will be dropped (see [member drag_to_rearrange_enabled])."
msgstr "Azt jelző ikon, hogy a húzott fül hová kerül ejtéskor (lásd: [member drag_to_rearrange_enabled])."


#. TabBar.increment
#: doc/classes/TabBar.xml
msgid "Icon for the right arrow button that appears when there are too many tabs to fit in the container width. When the button is disabled (i.e. the last tab is visible) it appears semi-transparent."
msgstr "A jobbra mutató nyílgomb ikonja, amely akkor jelenik meg, ha a fülek nem férnek el a tároló szélességén. Ha a gomb le van tiltva (vagyis az utolsó fül már látható), félig átlátszóként jelenik meg."


#. TabBar.increment_highlight
#: doc/classes/TabBar.xml
msgid "Icon for the right arrow button that appears when there are too many tabs to fit in the container width. Used when the button is being hovered with the cursor."
msgstr "A jobbra mutató nyílgomb ikonja, amely akkor jelenik meg, ha a fülek nem férnek el a tároló szélességén. Akkor használja a rendszer, amikor az egérmutató a gomb fölött van."


#. TabBar.button_highlight
#: doc/classes/TabBar.xml
msgid "Background of the tab and close buttons when they're being hovered with the cursor."
msgstr "A fülek és a bezárógombok háttere, amikor az egérmutató fölöttük van."


#. TabBar.button_pressed
#: doc/classes/TabBar.xml
msgid "Background of the tab and close buttons when it's being pressed."
msgstr "A fülek és a bezárógombok háttere lenyomott állapotban."


#. TabBar.tab_disabled
#: doc/classes/TabBar.xml
msgid "The style of disabled tabs."
msgstr "A letiltott fülek stílusa."


#. TabBar.tab_focus
#: doc/classes/TabBar.xml
msgid "[StyleBox] used when the [TabBar] is focused. The [theme_item tab_focus] [StyleBox] is displayed [i]over[/i] the base [StyleBox] of the selected tab, so a partially transparent [StyleBox] should be used to ensure the base [StyleBox] remains visible. A [StyleBox] that represents an outline or an underline works well for this purpose. To disable the focus visual effect, assign a [StyleBoxEmpty] resource. Note that disabling the focus visual effect will harm keyboard/controller navigation usability, so this is not recommended for accessibility reasons."
msgstr "A [TabBar] fókuszba kerülésekor használt [StyleBox]. A [theme_item tab_focus] [StyleBox] a kijelölt fül alap [StyleBox] eleme [i]fölött[/i] jelenik meg, ezért részben átlátszó [StyleBox] ajánlott, hogy az alap [StyleBox] is látható maradjon. Erre jól megfelel egy körvonalat vagy aláhúzást ábrázoló [StyleBox]. A fókusz vizuális hatásának kikapcsolásához rendelj hozzá [StyleBoxEmpty] erőforrást. Ez azonban rontja a billentyűzetes és kontrolleres navigáció használhatóságát, ezért akadálymentességi szempontból nem ajánlott."


#. TabBar.tab_hovered
#: doc/classes/TabBar.xml
msgid "The style of the currently hovered tab. Does not apply to the selected tab.\n[b]Note:[/b] This style will be drawn with the same width as [theme_item tab_unselected] at minimum."
msgstr "Az egérmutató alatt lévő fül stílusa. A kijelölt fülre nem vonatkozik.\n[b]Megjegyzés:[/b] Ezt a stílust legalább a [theme_item tab_unselected] szélességével rajzolja ki a rendszer."


#. TabBar.tab_selected
#: doc/classes/TabBar.xml
msgid "The style of the currently selected tab."
msgstr "Az aktuálisan kijelölt fül stílusa."


#. TabBar.tab_unselected
#: doc/classes/TabBar.xml
msgid "The style of the other, unselected tabs."
msgstr "A többi, nem kijelölt fül stílusa."

#. TabContainer.set_tab_tooltip
#: doc/classes/TabContainer.xml
msgid "Sets a custom tooltip text for tab at index [param tab_idx].\n[b]Note:[/b] By default, if the [param tooltip] is empty and the tab text is truncated (not all characters fit into the tab), the title will be displayed as a tooltip. To hide the tooltip, assign [code]\" \"[/code] as the [param tooltip] text."
msgstr "A [param tab_idx] indexű fül egyéni eszköztippszövegét állítja be.\n[b]Megjegyzés:[/b] Alapértelmezés szerint, ha a [param tooltip] üres, és a fül szövege le van vágva (nem fér ki minden karakter), a teljes cím jelenik meg eszköztippként. Az eszköztipp elrejtéséhez a [param tooltip] szövegének [code]\" \"[/code] értéket adj meg."


#. TabContainer.all_tabs_in_front
#: doc/classes/TabContainer.xml
msgid "This doesn't do anything."
msgstr "Ennek nincs semmilyen hatása."


#. TabContainer.deselect_enabled
#: doc/classes/TabContainer.xml
msgid "If [code]true[/code], all tabs can be deselected so that no tab is selected. Click on the [member current_tab] to deselect it.\nOnly the tab header will be shown if no tabs are selected."
msgstr "Ha [code]true[/code], minden fül kijelölése megszüntethető, így egyik fül sem lesz kijelölve. A [member current_tab] fülre kattintva megszüntetheted a kijelölését.\nHa nincs kijelölt fül, csak a fülek fejléce látható."


#. TabContainer.switch_on_drag_hover
#: doc/classes/TabContainer.xml
msgid "If [code]true[/code], hovering over a tab while dragging something will switch to that tab. Does not have effect when hovering another tab to rearrange."
msgstr "Ha [code]true[/code], egy elem húzása közben egy fül fölé mozgatva az egérmutatót a rendszer arra a fülre vált. Ez nem érvényes, ha a füleket átrendezés céljából húzod egymás fölé."


#. TabContainer.tab_alignment
#: doc/classes/TabContainer.xml
msgid "The position at which tabs will be placed."
msgstr "Meghatározza a fülek elhelyezkedését."


#. TabContainer.tab_focus_mode
#: doc/classes/TabContainer.xml
msgid "The focus access mode for the internal [TabBar] node."
msgstr "A belső [TabBar] csomópont fókuszkezelési módja."


#. TabContainer.tab_{index}/disabled
#: doc/classes/TabContainer.xml
msgid "If [code]true[/code], the tab at [code]index[/code] is disabled.\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. get_tab_count() - 1[/code] range."
msgstr "Ha [code]true[/code], a [code]index[/code] indexű fül le van tiltva.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. get_tab_count() - 1[/code] tartományba esik."


#. TabContainer.tab_{index}/hidden
#: doc/classes/TabContainer.xml
msgid "If [code]true[/code], the tab at [code]index[/code] is hidden.\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. get_tab_count() - 1[/code] range."
msgstr "Ha [code]true[/code], a [code]index[/code] indexű fül el van rejtve.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. get_tab_count() - 1[/code] tartományba esik."


#. TabContainer.tab_{index}/icon
#: doc/classes/TabContainer.xml
msgid "The title text of the tab at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. get_tab_count() - 1[/code] range."
msgstr "A [code]index[/code] indexű fül címszövege.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. get_tab_count() - 1[/code] tartományba esik."


#. TabContainer.tab_{index}/title
#: doc/classes/TabContainer.xml
msgid "The tooltip text of the tab at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. get_tab_count() - 1[/code] range."
msgstr "A [code]index[/code] indexű fül eszköztippszövege.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. get_tab_count() - 1[/code] tartományba esik."


#. TabContainer.tabs_rearrange_group
#: doc/classes/TabContainer.xml
msgid "[TabContainer]s with the same rearrange group ID will allow dragging the tabs between them. Enable drag with [member drag_to_rearrange_enabled].\nSetting this to [code]-1[/code] will disable rearranging between [TabContainer]s."
msgstr "Azonos átrendezési csoportazonosítóval rendelkező [TabContainer] elemek között a fülek áthúzhatók. A húzást a [member drag_to_rearrange_enabled] tulajdonsággal engedélyezheted.\nHa az érték [code]-1[/code], a különböző [TabContainer] elemek közötti átrendezés le van tiltva."


#. TabContainer.use_hidden_tabs_for_min_size
#: doc/classes/TabContainer.xml
msgid "If [code]true[/code], child [Control] nodes that are hidden have their minimum size take into account in the total, instead of only the currently visible one."
msgstr "Ha [code]true[/code], az elrejtett gyermek [Control] csomópontok minimális mérete is beleszámít a teljes minimális méretbe, nem csak az éppen látható gyermeké."


#. TabContainer.pre_popup_pressed
#: doc/classes/TabContainer.xml
msgid "Emitted when the [TabContainer]'s [Popup] button is clicked. See [method set_popup] for details."
msgstr "Akkor bocsátódik ki, amikor a [TabContainer] [Popup] gombjára kattintanak. A részleteket lásd a [method set_popup] metódusnál."


#. TabContainer.tab_button_pressed
#: doc/classes/TabContainer.xml
msgid "Emitted when the user clicks on the button icon on this tab."
msgstr "Akkor bocsátódik ki, amikor a felhasználó a fül gombjának ikonjára kattint."


#. TabContainer.POSITION_TOP
#: doc/classes/TabContainer.xml
msgid "Places the tab bar at the top."
msgstr "A fülsávot felül helyezi el."


#. TabContainer.POSITION_BOTTOM
#: doc/classes/TabContainer.xml
msgid "Places the tab bar at the bottom. The tab bar's [StyleBox] will be flipped vertically."
msgstr "A fülsávot alul helyezi el. A fülsáv [StyleBox] eleme függőlegesen tükröződik."


#. TabContainer.POSITION_MAX
#: doc/classes/TabContainer.xml
msgid "Represents the size of the [enum TabPosition] enum."
msgstr "A [enum TabPosition] felsorolás méretét jelöli."


#. TabContainer.icon_max_width
#: doc/classes/TabContainer.xml
msgid "The maximum allowed width of the tab's icon. This limit is applied on top of the default size of the icon, but before the value set with [method TabBar.set_tab_icon_max_width]. The height is adjusted according to the icon's ratio."
msgstr "A fül ikonjának legnagyobb megengedett szélessége. Ez az ikon alapértelmezett méretén felül, de a [method TabBar.set_tab_icon_max_width] metódussal megadott érték előtt érvényesül. A magasság az ikon képarányához igazodik."


#. TabContainer.icon_separation
#: doc/classes/TabContainer.xml
msgid "Space between tab's name and its icon."
msgstr "A fül neve és ikonja közötti térköz."


#. TabContainer.side_margin
#: doc/classes/TabContainer.xml
msgid "The space at the left or right edges of the tab bar, accordingly with the current [member tab_alignment].\nThe margin is ignored with [constant TabBar.ALIGNMENT_RIGHT] if the tabs are clipped (see [member clip_tabs]) or a popup has been set (see [method set_popup]). The margin is always ignored with [constant TabBar.ALIGNMENT_CENTER]."
msgstr "A fülsáv bal vagy jobb szélén lévő térköz a [member tab_alignment] aktuális beállításának megfelelően.\nA térközt figyelmen kívül hagyja a rendszer [constant TabBar.ALIGNMENT_RIGHT] esetén, ha a fülek le vannak vágva (lásd: [member clip_tabs]), vagy ha felugró menü van beállítva (lásd: [method set_popup]). A térközt [constant TabBar.ALIGNMENT_CENTER] esetén mindig figyelmen kívül hagyja."


#. TabContainer.menu
#: doc/classes/TabContainer.xml
msgid "The icon for the menu button (see [method set_popup])."
msgstr "A menügomb ikonja (lásd: [method set_popup])."


#. TabContainer.menu_highlight
#: doc/classes/TabContainer.xml
msgid "The icon for the menu button (see [method set_popup]) when it's being hovered with the cursor."
msgstr "A menügomb ikonja (lásd: [method set_popup]), amikor az egérmutató fölötte van."


#. TabContainer.panel
#: doc/classes/TabContainer.xml
msgid "The style for the background fill."
msgstr "A háttér kitöltésének stílusa."


#. TabContainer.tab_hovered
#: doc/classes/TabContainer.xml
msgid "The style of the currently hovered tab.\n[b]Note:[/b] This style will be drawn with the same width as [theme_item tab_unselected] at minimum."
msgstr "Az egérmutató alatt lévő fül stílusa.\n[b]Megjegyzés:[/b] Ezt a stílust legalább a [theme_item tab_unselected] szélességével rajzolja ki a rendszer."


#. TabContainer.tabbar_background
#: doc/classes/TabContainer.xml
msgid "The style for the background fill of the [TabBar] area."
msgstr "A [TabBar] területe háttérkitöltésének stílusa."

#. ItemList.allow_reselect
#: doc/classes/ItemList.xml
msgid "If [code]true[/code], the currently selected item can be selected again."
msgstr "Ha [code]true[/code], a jelenleg kijelölt elem ismét kijelölhető."


#. ItemList.allow_rmb_select
#: doc/classes/ItemList.xml
msgid "If [code]true[/code], right mouse button click can select items."
msgstr "Ha [code]true[/code], az elemek a jobb egérgombbal is kijelölhetők."


#. ItemList.allow_search
#: doc/classes/ItemList.xml
msgid "If [code]true[/code], allows navigating the [ItemList] with letter keys through incremental search."
msgstr "Ha [code]true[/code], a betűbillentyűkkel fokozatos keresést használva is lehet navigálni az [ItemList] elemei között."


#. ItemList.auto_height
#: doc/classes/ItemList.xml
msgid "If [code]true[/code], the control will automatically resize the height to fit its content."
msgstr "Ha [code]true[/code], a vezérlőelem automatikusan a tartalmához igazítja a magasságát."


#. ItemList.auto_width
#: doc/classes/ItemList.xml
msgid "If [code]true[/code], the control will automatically resize the width to fit its content."
msgstr "Ha [code]true[/code], a vezérlőelem automatikusan a tartalmához igazítja a szélességét."


#. ItemList.fixed_column_width
#: doc/classes/ItemList.xml
msgid "The width all columns will be adjusted to.\nA value of zero disables the adjustment, each item will have a width equal to the width of its content and the columns will have an uneven width."
msgstr "Az a szélesség, amelyhez a rendszer az összes oszlopot igazítja.\nA nulla érték kikapcsolja az igazítást: minden elem a saját tartalmának megfelelő szélességet kap, így az oszlopok szélessége eltérhet."


#. ItemList.fixed_icon_size
#: doc/classes/ItemList.xml
msgid "The size all icons will be adjusted to.\nIf either X or Y component is not greater than zero, icon size won't be affected."
msgstr "Az a méret, amelyhez a rendszer az összes ikont igazítja.\nHa az X vagy az Y összetevő nem nagyobb nullánál, az ikonméret nem változik."


#. ItemList.icon_mode
#: doc/classes/ItemList.xml
msgid "The icon position, whether above or to the left of the text. See the [enum IconMode] constants."
msgstr "Az ikon elhelyezése: a szöveg fölött vagy attól balra. Lásd az [enum IconMode] állandóit."


#. ItemList.icon_scale
#: doc/classes/ItemList.xml
msgid "The scale of icon applied after [member fixed_icon_size] and transposing takes effect."
msgstr "Az ikon méretezési aránya, amely a [member fixed_icon_size] alkalmazása és a transzponálás után érvényesül."


#. ItemList.item_{index}/disabled
#: doc/classes/ItemList.xml
msgid "If [code]true[/code], the item at [code]index[/code] is disabled.\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/code] range."
msgstr "Ha [code]true[/code], a [code]index[/code] indexű elem le van tiltva.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. item_count - 1[/code] tartományba esik."


#. ItemList.item_{index}/icon
#: doc/classes/ItemList.xml
msgid "The icon of the item at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/code] range."
msgstr "A [code]index[/code] indexű elem ikonja.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. item_count - 1[/code] tartományba esik."


#. ItemList.item_{index}/selectable
#: doc/classes/ItemList.xml
msgid "If [code]true[/code], the item at [code]index[/code] is selectable.\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/code] range."
msgstr "Ha [code]true[/code], a [code]index[/code] indexű elem kijelölhető.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. item_count - 1[/code] tartományba esik."


#. ItemList.item_{index}/text
#: doc/classes/ItemList.xml
msgid "The text of the item at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/code] range."
msgstr "A [code]index[/code] indexű elem szövege.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. item_count - 1[/code] tartományba esik."


#. ItemList.max_text_lines
#: doc/classes/ItemList.xml
msgid "Maximum lines of text allowed in each item. Space will be reserved even when there is not enough lines of text to display.\n[b]Note:[/b] This property takes effect only when [member icon_mode] is [constant ICON_MODE_TOP]. To make the text wrap, [member fixed_column_width] should be greater than zero."
msgstr "Az egy elemhez megjeleníthető szövegsorok legnagyobb száma. A helyet akkor is fenntartja a rendszer, ha az elem szövege kevesebb sorból áll.\n[b]Megjegyzés:[/b] Ez a tulajdonság csak akkor érvényesül, ha a [member icon_mode] értéke [constant ICON_MODE_TOP]. A szöveg több sorba tördeléséhez a [member fixed_column_width] értékének nullánál nagyobbnak kell lennie."


#. ItemList.same_column_width
#: doc/classes/ItemList.xml
msgid "Whether all columns will have the same width.\nIf [code]true[/code], the width is equal to the largest column width of all columns."
msgstr "Meghatározza, hogy minden oszlop azonos szélességű legyen-e.\nHa [code]true[/code], az összes oszlop a legszélesebb oszlop méretét kapja."


#. ItemList.scroll_hint_mode
#: doc/classes/ItemList.xml
msgid "The way which scroll hints (indicators that show that the content can still be scrolled in a certain direction) will be shown."
msgstr "Meghatározza a görgetési jelzések megjelenítési módját. Ezek a jelzések azt mutatják, hogy a tartalom egy adott irányba még tovább görgethető."


#. ItemList.text_overrun_behavior
#: doc/classes/ItemList.xml
msgid "The clipping behavior when the text exceeds an item's bounding rectangle."
msgstr "Meghatározza a szöveg levágásának módját, amikor a szöveg túlnyúlik az elem határoló téglalapján."


#. ItemList.wraparound_items
#: doc/classes/ItemList.xml
msgid "If [code]true[/code], the control will automatically move items into a new row to fit its content. See also [HFlowContainer] for this behavior.\nIf [code]false[/code], the control will add a horizontal scrollbar to make all items visible."
msgstr "Ha [code]true[/code], a vezérlőelem szükség esetén automatikusan új sorba helyezi az elemeket, hogy azok elférjenek. Hasonló működésért lásd a [HFlowContainer] osztályt.\nHa [code]false[/code], vízszintes görgetősávot ad hozzá, hogy minden elem elérhető legyen."


#. ItemList.ICON_MODE_TOP
#: doc/classes/ItemList.xml
msgid "Icon is drawn above the text."
msgstr "Az ikont a szöveg fölé rajzolja."


#. ItemList.ICON_MODE_LEFT
#: doc/classes/ItemList.xml
msgid "Icon is drawn to the left of the text."
msgstr "Az ikont a szövegtől balra rajzolja."


#. ItemList.SELECT_SINGLE
#: doc/classes/ItemList.xml
msgid "Only allow selecting a single item."
msgstr "Egyszerre csak egy elem kijelölését engedélyezi."


#. ItemList.SELECT_MULTI
#: doc/classes/ItemList.xml
msgid "Allows selecting multiple items by holding [kbd]Ctrl[/kbd] or [kbd]Shift[/kbd]."
msgstr "Több elem kijelölését engedélyezi a [kbd]Ctrl[/kbd] vagy a [kbd]Shift[/kbd] nyomva tartásával."


#. ItemList.SELECT_TOGGLE
#: doc/classes/ItemList.xml
msgid "Allows selecting multiple items by toggling them on and off."
msgstr "Lehetővé teszi több elem kijelölését, illetve kijelölésének megszüntetését egyenként."


#. ItemList.SCROLL_HINT_MODE_DISABLED
#: doc/classes/ItemList.xml
msgid "Scroll hints will never be shown."
msgstr "A görgetési jelzések soha nem jelennek meg."


#. ItemList.SCROLL_HINT_MODE_BOTH
#: doc/classes/ItemList.xml
msgid "Scroll hints will be shown at the top and bottom."
msgstr "A görgetési jelzések a lista tetején és alján is megjelennek."


#. ItemList.SCROLL_HINT_MODE_TOP
#: doc/classes/ItemList.xml
msgid "Only the top scroll hint will be shown."
msgstr "Csak a felső görgetési jelzés jelenik meg."


#. ItemList.SCROLL_HINT_MODE_BOTTOM
#: doc/classes/ItemList.xml
msgid "Only the bottom scroll hint will be shown."
msgstr "Csak az alsó görgetési jelzés jelenik meg."


#. ItemList.font_color
#: doc/classes/ItemList.xml
msgid "Default text [Color] of the item."
msgstr "Az elem szövegének alapértelmezett [Color] színe."


#. ItemList.font_hovered_color
#: doc/classes/ItemList.xml
msgid "Text [Color] used when the item is hovered and not selected yet."
msgstr "A szöveg [Color] színe, amikor az egérmutató az elem fölött van, de az nincs kijelölve."


#. ItemList.font_hovered_selected_color
#: doc/classes/ItemList.xml
msgid "Text [Color] used when the item is hovered and selected."
msgstr "A szöveg [Color] színe, amikor az egérmutató a kijelölt elem fölött van."


#. ItemList.font_outline_color
#: doc/classes/ItemList.xml
msgid "The tint of text outline of the item."
msgstr "Az elem szövegkörvonalának színezése."


#. ItemList.font_selected_color
#: doc/classes/ItemList.xml
msgid "Text [Color] used when the item is selected, but not hovered."
msgstr "A szöveg [Color] színe, amikor az elem ki van jelölve, de az egérmutató nincs fölötte."


#. ItemList.guide_color
#: doc/classes/ItemList.xml
msgid "[Color] of the guideline. The guideline is a line drawn between each row of items."
msgstr "Az elválasztóvonal [Color] színe. Az elválasztóvonalat a rendszer az elemsorok közé rajzolja."


#. ItemList.scroll_hint_color
#: doc/classes/ItemList.xml
msgid "[Color] used to modulate the [theme_item scroll_hint] texture."
msgstr "A [theme_item scroll_hint] textúra színének módosítására használt [Color] érték."


#. ItemList.h_separation
#: doc/classes/ItemList.xml
msgid "The horizontal spacing between items."
msgstr "Az elemek közötti vízszintes térköz."


#. ItemList.icon_margin
#: doc/classes/ItemList.xml
msgid "The spacing between item's icon and text."
msgstr "Az elem ikonja és szövege közötti térköz."


#. ItemList.line_separation
#: doc/classes/ItemList.xml
msgid "The vertical spacing between each line of text."
msgstr "A szövegsorok közötti függőleges térköz."


#. ItemList.outline_size
#: doc/classes/ItemList.xml
msgid "The size of the item text outline.\n[b]Note:[/b] If using a font with [member FontFile.multichannel_signed_distance_field] enabled, its [member FontFile.msdf_pixel_range] must be set to at least [i]twice[/i] the value of [theme_item outline_size] for outline rendering to look correct. Otherwise, the outline may appear to be cut off earlier than intended."
msgstr "Az elem szövegkörvonalának vastagsága.\n[b]Megjegyzés:[/b] Ha olyan betűkészletet használsz, amelynél engedélyezett a [member FontFile.multichannel_signed_distance_field], a [member FontFile.msdf_pixel_range] értékének legalább [i]kétszer[/i] akkorának kell lennie, mint a [theme_item outline_size], hogy a körvonal megfelelően jelenjen meg. Ellenkező esetben a körvonal a kelleténél előbb levágódhat."


#. ItemList.v_separation
#: doc/classes/ItemList.xml
msgid "The vertical spacing between items."
msgstr "Az elemek közötti függőleges térköz."


#. ItemList.font
#: doc/classes/ItemList.xml
msgid "[Font] of the item's text."
msgstr "Az elem szövegéhez használt [Font]."


#. ItemList.font_size
#: doc/classes/ItemList.xml
msgid "Font size of the item's text."
msgstr "Az elem szövegének betűmérete."


#. ItemList.scroll_hint
#: doc/classes/ItemList.xml
msgid "The indicator that will be shown when the content can still be scrolled. See [member scroll_hint_mode]."
msgstr "Azt jelző elem, hogy a tartalom még tovább görgethető. Lásd: [member scroll_hint_mode]."


#. ItemList.cursor
#: doc/classes/ItemList.xml
msgid "[StyleBox] used for the cursor, when the [ItemList] is being focused."
msgstr "A kurzor megjelenítéséhez használt [StyleBox], amikor az [ItemList] fókuszban van."


#. ItemList.cursor_unfocused
#: doc/classes/ItemList.xml
msgid "[StyleBox] used for the cursor, when the [ItemList] is not being focused."
msgstr "A kurzor megjelenítéséhez használt [StyleBox], amikor az [ItemList] nincs fókuszban."


#. ItemList.focus
#: doc/classes/ItemList.xml
msgid "The focused style for the [ItemList], drawn on top of everything."
msgstr "Az [ItemList] fókuszállapotának stílusa, amely minden más elem fölé rajzolódik."


#. ItemList.hovered
#: doc/classes/ItemList.xml
msgid "[StyleBox] for the hovered, but not selected items."
msgstr "Az egérmutató alatt lévő, de nem kijelölt elemek [StyleBox] stílusa."


#. ItemList.hovered_selected
#: doc/classes/ItemList.xml
msgid "[StyleBox] for the hovered and selected items, used when the [ItemList] is not being focused."
msgstr "Az egérmutató alatt lévő, kijelölt elemek [StyleBox] stílusa, amikor az [ItemList] nincs fókuszban."


#. ItemList.hovered_selected_focus
#: doc/classes/ItemList.xml
msgid "[StyleBox] for the hovered and selected items, used when the [ItemList] is being focused."
msgstr "Az egérmutató alatt lévő, kijelölt elemek [StyleBox] stílusa, amikor az [ItemList] fókuszban van."


#. ItemList.panel
#: doc/classes/ItemList.xml
msgid "The background style for the [ItemList]."
msgstr "Az [ItemList] háttérstílusa."


#. ItemList.selected
#: doc/classes/ItemList.xml
msgid "[StyleBox] for the selected items, used when the [ItemList] is not being focused."
msgstr "A kijelölt elemek [StyleBox] stílusa, amikor az [ItemList] nincs fókuszban."


#. ItemList.selected_focus
#: doc/classes/ItemList.xml
msgid "[StyleBox] for the selected items, used when the [ItemList] is being focused."
msgstr "A kijelölt elemek [StyleBox] stílusa, amikor az [ItemList] fókuszban van."

#. ItemList.is_item_disabled
#: doc/classes/ItemList.xml
msgid "Returns [code]true[/code] if the item at the specified index is disabled."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott indexű elem le van tiltva."


#. ItemList.is_item_icon_transposed
#: doc/classes/ItemList.xml
msgid "Returns [code]true[/code] if the item icon will be drawn transposed, i.e. the X and Y axes are swapped."
msgstr "[code]true[/code] értéket ad vissza, ha az elem ikonja transzponálva jelenik meg, vagyis felcserélődik az X és az Y tengely."


#. ItemList.is_item_selectable
#: doc/classes/ItemList.xml
msgid "Returns [code]true[/code] if the item at the specified index is selectable."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott indexű elem kijelölhető."


#. ItemList.is_item_tooltip_enabled
#: doc/classes/ItemList.xml
msgid "Returns [code]true[/code] if the tooltip is enabled for specified item index."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott indexű elem eszköztippje engedélyezett."


#. ItemList.is_selected
#: doc/classes/ItemList.xml
msgid "Returns [code]true[/code] if the item at the specified index is currently selected."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott indexű elem jelenleg ki van jelölve."


#. ItemList.move_item
#: doc/classes/ItemList.xml
msgid "Moves item from index [param from_idx] to [param to_idx]."
msgstr "A [param from_idx] indexű elemet a [param to_idx] indexre helyezi át."


#. ItemList.set_item_auto_translate_mode
#: doc/classes/ItemList.xml
msgid "Sets the auto translate mode of the item associated with the specified index.\nItems use [constant Node.AUTO_TRANSLATE_MODE_INHERIT] by default, which uses the same auto translate mode as the [ItemList] itself."
msgstr "Beállítja a megadott indexű elem automatikus fordítási módját.\nAz elemek alapértelmezés szerint a [constant Node.AUTO_TRANSLATE_MODE_INHERIT] értéket használják, amely az [ItemList] automatikus fordítási módját örökli."


#. ItemList.set_item_custom_bg_color
#: doc/classes/ItemList.xml
msgid "Sets the background color of the item specified by [param idx] index to the specified [Color]."
msgstr "A [param idx] indexű elem háttérszínét a megadott [Color] értékre állítja."


#. ItemList.set_item_custom_fg_color
#: doc/classes/ItemList.xml
msgid "Sets the foreground color of the item specified by [param idx] index to the specified [Color]."
msgstr "A [param idx] indexű elem előtérszínét a megadott [Color] értékre állítja."


#. ItemList.set_item_disabled
#: doc/classes/ItemList.xml
msgid "Disables (or enables) the item at the specified index.\nDisabled items cannot be selected and do not trigger activation signals (when double-clicking or pressing [kbd]Enter[/kbd])."
msgstr "Letiltja vagy engedélyezi a megadott indexű elemet.\nA letiltott elemek nem jelölhetők ki, és nem váltanak ki aktiválási jeleket (dupla kattintás vagy az [kbd]Enter[/kbd] lenyomása esetén sem)."


#. ItemList.set_item_icon
#: doc/classes/ItemList.xml
msgid "Sets (or replaces) the icon's [Texture2D] associated with the specified index."
msgstr "Beállítja vagy lecseréli a megadott indexű elemhez tartozó ikon [Texture2D] erőforrását."


#. ItemList.set_item_icon_modulate
#: doc/classes/ItemList.xml
msgid "Sets a modulating [Color] of the item associated with the specified index."
msgstr "Beállítja a megadott indexű elem ikonjának színét módosító [Color] értéket."


#. ItemList.set_item_icon_region
#: doc/classes/ItemList.xml
msgid "Sets the region of item's icon used. The whole icon will be used if the region has no area."
msgstr "Beállítja, hogy az elem ikonjának melyik területe jelenjen meg. Ha a területnek nincs kiterjedése, a teljes ikon látható."


#. ItemList.set_item_icon_transposed
#: doc/classes/ItemList.xml
msgid "Sets whether the item icon will be drawn transposed."
msgstr "Beállítja, hogy az elem ikonja transzponálva jelenjen-e meg."


#. ItemList.set_item_language
#: doc/classes/ItemList.xml
msgid "Sets the language code of the text for the item at the given index to [param language]. This is used for line-breaking and text shaping algorithms. If [param language] is empty, the current locale is used."
msgstr "A megadott indexű elem szövegének nyelvkódját a [param language] értékre állítja. Ezt a sortörési és szövegformázási algoritmusok használják. Ha a [param language] üres, az aktuális területi beállítás érvényesül."


#. ItemList.set_item_metadata
#: doc/classes/ItemList.xml
msgid "Sets a value (of any type) to be stored with the item associated with the specified index."
msgstr "Tetszőleges típusú értéket tárol a megadott indexű elemhez társítva."


#. ItemList.set_item_selectable
#: doc/classes/ItemList.xml
msgid "Allows or disallows selection of the item associated with the specified index."
msgstr "Engedélyezi vagy letiltja a megadott indexű elem kijelölhetőségét."


#. ItemList.set_item_text_direction
#: doc/classes/ItemList.xml
msgid "Sets item's text base writing direction."
msgstr "Beállítja az elem szövegének alapvető írásirányát."


#. ItemList.set_item_tooltip
#: doc/classes/ItemList.xml
msgid "Sets the tooltip hint for the item associated with the specified index."
msgstr "Beállítja a megadott indexű elemhez tartozó eszköztipp szövegét."


#. ItemList.set_item_tooltip_enabled
#: doc/classes/ItemList.xml
msgid "Sets whether the tooltip hint is enabled for specified item index."
msgstr "Beállítja, hogy a megadott indexű elem eszköztippje engedélyezett legyen-e."


#. ItemList.sort_items_by_text
#: doc/classes/ItemList.xml
msgid "Sorts items in the list by their text."
msgstr "A lista elemeit a szövegük szerint rendezi sorba."


#. ItemList.empty_clicked
#: doc/classes/ItemList.xml
msgid "Emitted when any mouse click is issued within the rect of the list but on empty space.\n[param at_position] is the click position in this control's local coordinate system."
msgstr "Akkor bocsátódik ki, amikor az egérrel a lista téglalapján belül egy üres területre kattintanak.\nA [param at_position] a kattintás helye a vezérlőelem helyi koordinátarendszerében."


#. ItemList.item_activated
#: doc/classes/ItemList.xml
msgid "Emitted when specified list item is activated via double-clicking or by pressing [kbd]Enter[/kbd]."
msgstr "Akkor bocsátódik ki, amikor a megadott listaelemet dupla kattintással vagy az [kbd]Enter[/kbd] billentyűvel aktiválják."


#. ItemList.item_clicked
#: doc/classes/ItemList.xml
msgid "Emitted when specified list item has been clicked with any mouse button.\n[param at_position] is the click position in this control's local coordinate system."
msgstr "Akkor bocsátódik ki, amikor a megadott listaelemre bármelyik egérgombbal kattintanak.\nA [param at_position] a kattintás helye a vezérlőelem helyi koordinátarendszerében."


#. ItemList.item_selected
#: doc/classes/ItemList.xml
msgid "Emitted when specified item has been selected. Only applicable in single selection mode.\n[member allow_reselect] must be enabled to reselect an item."
msgstr "Akkor bocsátódik ki, amikor a megadott elemet kijelölik. Csak egyszeres kijelölési módban használható.\nEgy elem újbóli kijelöléséhez engedélyezni kell a [member allow_reselect] tulajdonságot."


#. ItemList.multi_selected
#: doc/classes/ItemList.xml
msgid "Emitted when a multiple selection is altered on a list allowing multiple selection."
msgstr "Akkor bocsátódik ki, amikor egy többszörös kijelölést engedélyező listában megváltozik a kijelölés."

#. OptionButton.brief
#: doc/classes/OptionButton.xml
msgid "A button that brings up a dropdown with selectable options when pressed."
msgstr "Olyan gomb, amely megnyomásakor választható lehetőségeket tartalmazó legördülő listát nyit meg."


#. OptionButton.description
#: doc/classes/OptionButton.xml
msgid "[OptionButton] is a type of button that brings up a dropdown with selectable items when pressed. The item selected becomes the \"current\" item and is displayed as the button text.\nSee also [BaseButton] which contains common properties and methods associated with this node.\n[b]Note:[/b] The IDs used for items are limited to signed 32-bit integers, not the full 64 bits of [int]. These have a range of [code]-2^31[/code] to [code]2^31 - 1[/code], that is, [code]-2147483648[/code] to [code]2147483647[/code].\n[b]Note:[/b] The [member Button.text] and [member Button.icon] properties are set automatically based on the selected item. They shouldn't be changed manually."
msgstr "Az [OptionButton] olyan gomb, amely megnyomásakor választható elemeket tartalmazó legördülő listát jelenít meg. A kiválasztott elem lesz az „aktuális” elem, és annak szövege jelenik meg a gombon.\nLásd még a [BaseButton] osztályt, amely a csomóponthoz kapcsolódó közös tulajdonságokat és metódusokat tartalmazza.\n[b]Megjegyzés:[/b] Az elemek azonosítói előjeles 32 bites egész számokra korlátozódnak, nem használhatják ki az [int] teljes 64 bites tartományát. Az érvényes tartomány [code]-2^31[/code] és [code]2^31 - 1[/code] között van, vagyis [code]-2147483648[/code] és [code]2147483647[/code] között.\n[b]Megjegyzés:[/b] A [member Button.text] és a [member Button.icon] tulajdonságokat a rendszer automatikusan beállítja a kiválasztott elem alapján. Ezeket ne módosítsd kézzel."


#. OptionButton.add_icon_item
#: doc/classes/OptionButton.xml
msgid "Adds an item, with a [param texture] icon, text [param label] and (optionally) [param id]. If no [param id] is passed, the item index will be used as the item's ID. New items are appended at the end.\n[b]Note:[/b] The item will be selected if there are no other items."
msgstr "Egy új elemet ad hozzá [param texture] ikonnal, [param label] szöveggel és opcionális [param id] azonosítóval. Ha nem adsz meg [param id] értéket, az elem indexe lesz az azonosítója. Az új elem a lista végére kerül.\n[b]Megjegyzés:[/b] Ha még nincs más elem, az új elem automatikusan kijelölődik."


#. OptionButton.add_item
#: doc/classes/OptionButton.xml
msgid "Adds an item, with text [param label] and (optionally) [param id]. If no [param id] is passed, the item index will be used as the item's ID. New items are appended at the end.\n[b]Note:[/b] The item will be selected if there are no other items."
msgstr "Egy új elemet ad hozzá [param label] szöveggel és opcionális [param id] azonosítóval. Ha nem adsz meg [param id] értéket, az elem indexe lesz az azonosítója. Az új elem a lista végére kerül.\n[b]Megjegyzés:[/b] Ha még nincs más elem, az új elem automatikusan kijelölődik."


#. OptionButton.add_separator
#: doc/classes/OptionButton.xml
msgid "Adds a separator to the list of items. Separators help to group items, and can optionally be given a [param text] header. A separator also gets an index assigned, and is appended at the end of the item list."
msgstr "Elválasztót ad az elemek listájához. Az elválasztók az elemek csoportosítását segítik, és opcionálisan [param text] fejlécszöveget is kaphatnak. Az elválasztó is kap egy indexet, és az elemlista végére kerül."


#. OptionButton.clear
#: doc/classes/OptionButton.xml
msgid "Clears all the items in the [OptionButton]."
msgstr "Eltávolítja az [OptionButton] összes elemét."


#. OptionButton.get_item_auto_translate_mode
#: doc/classes/OptionButton.xml
msgid "Returns the auto translate mode of the item at index [param idx]."
msgstr "Visszaadja a [param idx] indexű elem automatikus fordítási módját."


#. OptionButton.get_item_icon
#: doc/classes/OptionButton.xml
msgid "Returns the icon of the item at index [param idx]."
msgstr "Visszaadja a [param idx] indexű elem ikonját."


#. OptionButton.get_item_id
#: doc/classes/OptionButton.xml
msgid "Returns the ID of the item at index [param idx]."
msgstr "Visszaadja a [param idx] indexű elem azonosítóját."


#. OptionButton.get_item_index
#: doc/classes/OptionButton.xml
msgid "Returns the index of the item with the given [param id]."
msgstr "Visszaadja a [param id] azonosítójú elem indexét."


#. OptionButton.get_item_metadata
#: doc/classes/OptionButton.xml
msgid "Retrieves the metadata of an item. Metadata may be any type and can be used to store extra information about an item, such as an external string ID."
msgstr "Lekéri egy elem metaadatát. A metaadat bármilyen típusú lehet, és az elemhez kapcsolódó további információk, például külső szöveges azonosító tárolására használható."


#. OptionButton.get_item_text
#: doc/classes/OptionButton.xml
msgid "Returns the text of the item at index [param idx]."
msgstr "Visszaadja a [param idx] indexű elem szövegét."


#. OptionButton.get_item_tooltip
#: doc/classes/OptionButton.xml
msgid "Returns the tooltip of the item at index [param idx]."
msgstr "Visszaadja a [param idx] indexű elem eszköztippjét."


#. OptionButton.get_popup
#: doc/classes/OptionButton.xml
msgid "Returns the [PopupMenu] contained in this button.\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash. If you wish to hide it or any of its children, use their [member Window.visible] property."
msgstr "Visszaadja a gombban található [PopupMenu] csomópontot.\n[b]Figyelmeztetés:[/b] Ez egy szükséges belső csomópont; eltávolítása és felszabadítása összeomlást okozhat. Ha ezt vagy valamelyik gyermekét el szeretnéd rejteni, használd a [member Window.visible] tulajdonságot."


#. OptionButton.get_selectable_item
#: doc/classes/OptionButton.xml
msgid "Returns the index of the first item which is not disabled, or marked as a separator. If [param from_last] is [code]true[/code], the items will be searched in reverse order.\nReturns [code]-1[/code] if no item is found."
msgstr "Visszaadja az első olyan elem indexét, amely nincs letiltva, és nincs elválasztóként megjelölve. Ha a [param from_last] értéke [code]true[/code], az elemeket fordított sorrendben keresi.\nHa nem talál megfelelő elemet, [code]-1[/code] értéket ad vissza."


#. OptionButton.get_selected_id
#: doc/classes/OptionButton.xml
msgid "Returns the ID of the selected item, or [code]-1[/code] if no item is selected."
msgstr "Visszaadja a kiválasztott elem azonosítóját, vagy [code]-1[/code] értéket, ha nincs kiválasztott elem."


#. OptionButton.get_selected_metadata
#: doc/classes/OptionButton.xml
msgid "Gets the metadata of the selected item. Metadata for items can be set using [method set_item_metadata]."
msgstr "Lekéri a kiválasztott elem metaadatát. Az elemek metaadata a [method set_item_metadata] metódussal állítható be."


#. OptionButton.has_selectable_items
#: doc/classes/OptionButton.xml
msgid "Returns [code]true[/code] if this button contains at least one item which is not disabled, or marked as a separator."
msgstr "[code]true[/code] értéket ad vissza, ha a gomb legalább egy olyan elemet tartalmaz, amely nincs letiltva, és nincs elválasztóként megjelölve."


#. OptionButton.is_item_disabled
#: doc/classes/OptionButton.xml
msgid "Returns [code]true[/code] if the item at index [param idx] is disabled."
msgstr "[code]true[/code] értéket ad vissza, ha a [param idx] indexű elem le van tiltva."


#. OptionButton.is_item_separator
#: doc/classes/OptionButton.xml
msgid "Returns [code]true[/code] if the item at index [param idx] is marked as a separator."
msgstr "[code]true[/code] értéket ad vissza, ha a [param idx] indexű elem elválasztóként van megjelölve."


#. OptionButton.remove_item
#: doc/classes/OptionButton.xml
msgid "Removes the item at index [param idx]."
msgstr "Eltávolítja a [param idx] indexű elemet."


#. OptionButton.select
#: doc/classes/OptionButton.xml
msgid "Selects an item by index and makes it the current item. This will work even if the item is disabled.\nPassing [code]-1[/code] as the index deselects any currently selected item."
msgstr "Index alapján kiválaszt egy elemet, és azt teszi aktuálissá. Ez akkor is működik, ha az elem le van tiltva.\nA [code]-1[/code] index megadásával megszünteti az aktuális kijelölést."


#. OptionButton.set_disable_shortcuts
#: doc/classes/OptionButton.xml
msgid "If [code]true[/code], shortcuts are disabled and cannot be used to trigger the button."
msgstr "Ha [code]true[/code], a gyorsbillentyűk le vannak tiltva, és nem használhatók a gomb aktiválására."


#. OptionButton.set_item_auto_translate_mode
#: doc/classes/OptionButton.xml
msgid "Sets the auto translate mode of the item at index [param idx].\nItems use [constant Node.AUTO_TRANSLATE_MODE_INHERIT] by default, which uses the same auto translate mode as the [OptionButton] itself."
msgstr "Beállítja a [param idx] indexű elem automatikus fordítási módját.\nAz elemek alapértelmezés szerint a [constant Node.AUTO_TRANSLATE_MODE_INHERIT] értéket használják, amely az [OptionButton] automatikus fordítási módját örökli."


#. OptionButton.set_item_disabled
#: doc/classes/OptionButton.xml
msgid "Sets whether the item at index [param idx] is disabled.\nDisabled items are drawn differently in the dropdown and are not selectable by the user. If the current selected item is set as disabled, it will remain selected."
msgstr "Beállítja, hogy a [param idx] indexű elem le legyen-e tiltva.\nA letiltott elemek másként jelennek meg a legördülő listában, és a felhasználó nem választhatja ki őket. Ha a jelenleg kiválasztott elemet tiltod le, az továbbra is kiválasztva marad."


#. OptionButton.set_item_icon
#: doc/classes/OptionButton.xml
msgid "Sets the icon of the item at index [param idx]."
msgstr "Beállítja a [param idx] indexű elem ikonját."


#. OptionButton.set_item_id
#: doc/classes/OptionButton.xml
msgid "Sets the ID of the item at index [param idx]."
msgstr "Beállítja a [param idx] indexű elem azonosítóját."


#. OptionButton.set_item_metadata
#: doc/classes/OptionButton.xml
msgid "Sets the metadata of an item. Metadata may be of any type and can be used to store extra information about an item, such as an external string ID."
msgstr "Beállítja egy elem metaadatát. A metaadat bármilyen típusú lehet, és az elemhez kapcsolódó további információk, például külső szöveges azonosító tárolására használható."


#. OptionButton.set_item_text
#: doc/classes/OptionButton.xml
msgid "Sets the text of the item at index [param idx]."
msgstr "Beállítja a [param idx] indexű elem szövegét."


#. OptionButton.set_item_tooltip
#: doc/classes/OptionButton.xml
msgid "Sets the tooltip of the item at index [param idx]."
msgstr "Beállítja a [param idx] indexű elem eszköztippjét."


#. OptionButton.show_popup
#: doc/classes/OptionButton.xml
msgid "Adjusts popup position and sizing for the [OptionButton], then shows the [PopupMenu]. Prefer this over using [code]get_popup().popup()[/code]."
msgstr "Beállítja a felugró menü pozícióját és méretét az [OptionButton] számára, majd megjeleníti a [PopupMenu] elemet. Ezt célszerű használni a [code]get_popup().popup()[/code] közvetlen meghívása helyett."


#. OptionButton.fit_to_longest_item
#: doc/classes/OptionButton.xml
msgid "If [code]true[/code], minimum size will be determined by the longest item's width, instead of the currently selected one's. It will also take the popup's margins into account, making the button match its total width.\n[b]Note:[/b] For performance reasons, the minimum size doesn't update immediately when adding, removing or modifying items."
msgstr "Ha [code]true[/code], a minimális méretet az aktuálisan kiválasztott elem helyett a leghosszabb elem szélessége határozza meg. A felugró menü margóit is figyelembe veszi, így a gomb a teljes szélességéhez igazodik.\n[b]Megjegyzés:[/b] Teljesítménybeli okokból a minimális méret nem frissül azonnal, amikor elemeket adsz hozzá, távolítasz el vagy módosítasz."


#. OptionButton.item_count
#: doc/classes/OptionButton.xml
msgid "The number of items to select from."
msgstr "A választható elemek száma."


#. OptionButton.popup/item_{index}/id
#: doc/classes/OptionButton.xml
msgid "The ID of the item at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/code] range."
msgstr "A [code]index[/code] indexű elem azonosítója.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. item_count - 1[/code] tartományba esik."


#. OptionButton.popup/item_{index}/separator
#: doc/classes/OptionButton.xml
msgid "If [code]true[/code], the item at [code]index[/code] is a separator.\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/code] range."
msgstr "Ha [code]true[/code], a [code]index[/code] indexű elem elválasztó.\n[b]Megjegyzés:[/b] Az [code]index[/code] értéke a [code]0 .. item_count - 1[/code] tartományba esik."


#. OptionButton.search_bar_enabled
#: doc/classes/OptionButton.xml
msgid "If [code]true[/code], shows a search bar at the top of the [PopupMenu] for filtering items. See [member search_bar_min_item_count] for dynamically controlling its visibility based on the number of items."
msgstr "Ha [code]true[/code], a [PopupMenu] tetején keresősáv jelenik meg az elemek szűréséhez. A keresősáv láthatósága az elemek száma alapján a [member search_bar_min_item_count] beállítással is szabályozható."


#. OptionButton.search_bar_fuzzy_search_enabled
#: doc/classes/OptionButton.xml
msgid "If [code]true[/code], enables fuzzy searching in the [PopupMenu] search bar. This allows the search results to include items that almost match the search query, as well items that match the individual characters of the search query, but not in sequence.\nUse [member search_bar_fuzzy_search_max_misses] to set the maximum number of mismatches allowed in the search results."
msgstr "Ha [code]true[/code], engedélyezi a hozzávetőleges keresést a [PopupMenu] keresősávjában. Így a találatok között olyan elemek is megjelenhetnek, amelyek csak majdnem egyeznek a keresett kifejezéssel, vagy amelyekben a keresés egyes karakterei nem egymás után fordulnak elő.\nA megengedett eltérések legnagyobb számát a [member search_bar_fuzzy_search_max_misses] értékével állíthatod be."


#. OptionButton.search_bar_fuzzy_search_max_misses
#: doc/classes/OptionButton.xml
msgid "Sets the maximum number of mismatches allowed in each search result when fuzzy searching is enabled for the [PopupMenu] search bar. Any item with more mismatches will be hidden from the search results."
msgstr "Beállítja a megengedett eltérések legnagyobb számát a [PopupMenu] keresősávjának hozzávetőleges keresésénél. A nagyobb eltérést tartalmazó elemek nem jelennek meg a találatok között."


#. OptionButton.search_bar_min_item_count
#: doc/classes/OptionButton.xml
msgid "Sets the minimum number of items required for the [PopupMenu] search bar to be visible. [member search_bar_enabled] must be [code]true[/code] for this to have any effect."
msgstr "Beállítja, hogy legalább hány elem szükséges a [PopupMenu] keresősávjának megjelenítéséhez. Ennek csak akkor van hatása, ha a [member search_bar_enabled] értéke [code]true[/code]."


#. OptionButton.selected
#: doc/classes/OptionButton.xml
msgid "The index of the currently selected item, or [code]-1[/code] if no item is selected."
msgstr "Az aktuálisan kiválasztott elem indexe, vagy [code]-1[/code], ha nincs kiválasztott elem."


#. OptionButton.item_focused
#: doc/classes/OptionButton.xml
msgid "Emitted when the user navigates to an item using the [member ProjectSettings.input/ui_up] or [member ProjectSettings.input/ui_down] input actions. The index of the item focused is passed as argument."
msgstr "Akkor bocsátódik ki, amikor a felhasználó a [member ProjectSettings.input/ui_up] vagy a [member ProjectSettings.input/ui_down] bemeneti művelettel egy elemre navigál. Argumentumként átadja a fókuszba került elem indexét."


#. OptionButton.item_selected
#: doc/classes/OptionButton.xml
msgid "Emitted when the current item has been changed by the user. The index of the item selected is passed as argument.\n[member allow_reselect] must be enabled to reselect an item."
msgstr "Akkor bocsátódik ki, amikor a felhasználó megváltoztatja az aktuálisan kiválasztott elemet. Argumentumként átadja a kiválasztott elem indexét.\nUgyanazon elem ismételt kiválasztásához engedélyezni kell a [member allow_reselect] tulajdonságot."


#. OptionButton.arrow_margin
#: doc/classes/OptionButton.xml
msgid "The horizontal space between the arrow icon and the right edge of the button."
msgstr "A nyíl ikonja és a gomb jobb széle közötti vízszintes térköz."


#. OptionButton.modulate_arrow
#: doc/classes/OptionButton.xml
msgid "If different than [code]0[/code], the arrow icon will be modulated to the font color."
msgstr "Ha az érték eltér a [code]0[/code] értéktől, a nyíl ikonja a betűszínnel lesz színezve."


#. OptionButton.arrow
#: doc/classes/OptionButton.xml
msgid "The arrow icon to be drawn on the right end of the button."
msgstr "A gomb jobb szélén megjelenített nyílikon."

#. ProgressBar.brief
#: doc/classes/ProgressBar.xml
msgid "A control used for visual representation of a percentage."
msgstr "Százalékos érték vizuális megjelenítésére szolgáló vezérlőelem."


#. ProgressBar.description
#: doc/classes/ProgressBar.xml
msgid "A control used for visual representation of a percentage. Shows the fill percentage in the center. Can also be used to show indeterminate progress. For more fill modes, use [TextureProgressBar] instead."
msgstr "Százalékos érték vizuális megjelenítésére szolgáló vezérlőelem. A kitöltött rész százalékos arányát középen jeleníti meg. Olyan folyamatot is jelezhet, amelynek előrehaladása nem határozható meg pontosan. További kitöltési módokhoz inkább a [TextureProgressBar] osztályt használd."


#. ProgressBar.editor_preview_indeterminate
#: doc/classes/ProgressBar.xml
msgid "If [code]false[/code], the [member indeterminate] animation will be paused in the editor."
msgstr "Ha [code]false[/code], az [member indeterminate] animációja szünetel a szerkesztőben."


#. ProgressBar.fill_mode
#: doc/classes/ProgressBar.xml
msgid "The fill direction. See [enum FillMode] for possible values."
msgstr "A kitöltés iránya. A választható értékeket lásd a [enum FillMode] felsorolásban."


#. ProgressBar.indeterminate
#: doc/classes/ProgressBar.xml
msgid "When set to [code]true[/code], the progress bar indicates that something is happening with an animation, but does not show the fill percentage or value."
msgstr "Ha [code]true[/code], a folyamatjelző animációval mutatja, hogy egy művelet folyamatban van, de nem jeleníti meg a kitöltési százalékot vagy az értéket."


#. ProgressBar.show_percentage
#: doc/classes/ProgressBar.xml
msgid "If [code]true[/code], the fill percentage is displayed on the bar."
msgstr "Ha [code]true[/code], a sávon megjelenik a kitöltési százalék."


#. ProgressBar.FILL_BEGIN_TO_END
#: doc/classes/ProgressBar.xml
msgid "The progress bar fills from begin to end horizontally, according to the language direction. If [method Control.is_layout_rtl] returns [code]false[/code], it fills from left to right, and if it returns [code]true[/code], it fills from right to left."
msgstr "A folyamatjelző a nyelv írásirányának megfelelően, vízszintesen az elejétől a végéig töltődik. Ha a [method Control.is_layout_rtl] [code]false[/code] értéket ad vissza, balról jobbra, ha [code]true[/code] értéket, jobbról balra töltődik."


#. ProgressBar.FILL_END_TO_BEGIN
#: doc/classes/ProgressBar.xml
msgid "The progress bar fills from end to begin horizontally, according to the language direction. If [method Control.is_layout_rtl] returns [code]false[/code], it fills from right to left, and if it returns [code]true[/code], it fills from left to right."
msgstr "A folyamatjelző a nyelv írásirányának megfelelően, vízszintesen a végétől az eleje felé töltődik. Ha a [method Control.is_layout_rtl] [code]false[/code] értéket ad vissza, jobbról balra, ha [code]true[/code] értéket, balról jobbra töltődik."


#. ProgressBar.FILL_TOP_TO_BOTTOM
#: doc/classes/ProgressBar.xml
msgid "The progress fills from top to bottom."
msgstr "A folyamatjelző felülről lefelé töltődik."


#. ProgressBar.FILL_BOTTOM_TO_TOP
#: doc/classes/ProgressBar.xml
msgid "The progress fills from bottom to top."
msgstr "A folyamatjelző alulról felfelé töltődik."


#. ProgressBar.font_color
#: doc/classes/ProgressBar.xml
msgid "The color of the text."
msgstr "A szöveg színe."


#. ProgressBar.font_outline_color
#: doc/classes/ProgressBar.xml
msgid "The tint of text outline of the [ProgressBar]."
msgstr "A [ProgressBar] szövegkörvonalának színezése."


#. ProgressBar.outline_size
#: doc/classes/ProgressBar.xml
msgid "The size of the text outline.\n[b]Note:[/b] If using a font with [member FontFile.multichannel_signed_distance_field] enabled, its [member FontFile.msdf_pixel_range] must be set to at least [i]twice[/i] the value of [theme_item outline_size] for outline rendering to look correct. Otherwise, the outline may appear to be cut off earlier than intended."
msgstr "A szöveg körvonalának vastagsága.\n[b]Megjegyzés:[/b] Ha olyan betűkészletet használsz, amelynél a [member FontFile.multichannel_signed_distance_field] engedélyezett, akkor a [member FontFile.msdf_pixel_range] értékének legalább [i]kétszer[/i] akkorának kell lennie, mint a [theme_item outline_size], hogy a körvonal helyesen jelenjen meg. Ellenkező esetben a körvonal a kelleténél korábban levágódhat."


#. ProgressBar.font
#: doc/classes/ProgressBar.xml
msgid "Font used to draw the fill percentage if [member show_percentage] is [code]true[/code]."
msgstr "A kitöltési százalék megjelenítéséhez használt betűkészlet, ha a [member show_percentage] értéke [code]true[/code]."


#. ProgressBar.font_size
#: doc/classes/ProgressBar.xml
msgid "Font size used to draw the fill percentage if [member show_percentage] is [code]true[/code]."
msgstr "A kitöltési százalék megjelenítéséhez használt betűméret, ha a [member show_percentage] értéke [code]true[/code]."


#. ProgressBar.background
#: doc/classes/ProgressBar.xml
msgid "The style of the background."
msgstr "A háttér stílusa."


#. ProgressBar.fill
#: doc/classes/ProgressBar.xml
msgid "The style of the progress (i.e. the part that fills the bar)."
msgstr "A folyamatjelző kitöltött részének stílusa."


#. HSlider.brief
#: doc/classes/HSlider.xml
msgid "A horizontal slider that goes from left (min) to right (max)."
msgstr "Vízszintes csúszka, amely balról (minimum) jobbra (maximum) halad."


#. HSlider.description
#: doc/classes/HSlider.xml
msgid "A horizontal slider, used to adjust a value by moving a grabber along a horizontal axis. It is a [Range]-based control and goes from left (min) to right (max)."
msgstr "Vízszintes csúszka, amellyel egy értéket a fogantyú vízszintes tengely mentén történő mozgatásával lehet módosítani. A [Range] osztályon alapuló vezérlőelem; bal oldalon található a minimum, jobb oldalon a maximum."

#. MenuBar.brief
#: doc/classes/MenuBar.xml
msgid "A horizontal menu bar that creates a menu for each [PopupMenu] child."
msgstr "Vízszintes menüsáv, amely minden gyermek [PopupMenu] csomóponthoz külön menüt hoz létre."


#. MenuBar.description
#: doc/classes/MenuBar.xml
msgid "A horizontal menu bar that creates a menu for each [PopupMenu] child. New items are created by adding [PopupMenu]s to this node. Item title is determined by [member Window.title], or node name if [member Window.title] is empty. Item title can be overridden using [method set_menu_title]."
msgstr "Vízszintes menüsáv, amely minden gyermek [PopupMenu] csomóponthoz külön menüt hoz létre. Új menüpontokat úgy adhatsz hozzá, hogy [PopupMenu] csomópontokat helyezel el a menüsáv alatt. A menü címét a [member Window.title] határozza meg, vagy ha a [member Window.title] üres, akkor a csomópont neve. A címet a [method set_menu_title] metódussal felülírhatod."


#. MenuBar.get_menu_count
#: doc/classes/MenuBar.xml
msgid "Returns number of menu items."
msgstr "Visszaadja a menüpontok számát."


#. MenuBar.get_menu_popup
#: doc/classes/MenuBar.xml
msgid "Returns [PopupMenu] associated with menu item."
msgstr "Visszaadja a menüponthoz társított [PopupMenu] csomópontot."


#. MenuBar.get_menu_title
#: doc/classes/MenuBar.xml
msgid "Returns menu item title."
msgstr "Visszaadja a menüpont címét."


#. MenuBar.get_menu_tooltip
#: doc/classes/MenuBar.xml
msgid "Returns menu item tooltip."
msgstr "Visszaadja a menüpont eszköztippjét."


#. MenuBar.is_menu_disabled
#: doc/classes/MenuBar.xml
msgid "Returns [code]true[/code] if the menu item is disabled."
msgstr "[code]true[/code] értéket ad vissza, ha a menüpont le van tiltva."


#. MenuBar.is_menu_hidden
#: doc/classes/MenuBar.xml
msgid "Returns [code]true[/code] if the menu item is hidden."
msgstr "[code]true[/code] értéket ad vissza, ha a menüpont el van rejtve."


#. MenuBar.is_native_menu
#: doc/classes/MenuBar.xml
msgid "Returns [code]true[/code] if the current system's global menu is supported and used by this [MenuBar]."
msgstr "[code]true[/code] értéket ad vissza, ha az aktuális rendszer támogatja a globális rendszermenüt, és ez a [MenuBar] használja is."


#. MenuBar.set_menu_disabled
#: doc/classes/MenuBar.xml
msgid "If [code]true[/code], menu item is disabled."
msgstr "Ha [code]true[/code], a menüpont le van tiltva."


#. MenuBar.set_menu_hidden
#: doc/classes/MenuBar.xml
msgid "If [code]true[/code], menu item is hidden."
msgstr "Ha [code]true[/code], a menüpont el van rejtve."


#. MenuBar.set_menu_title
#: doc/classes/MenuBar.xml
msgid "Sets menu item title."
msgstr "Beállítja a menüpont címét."


#. MenuBar.set_menu_tooltip
#: doc/classes/MenuBar.xml
msgid "Sets menu item tooltip."
msgstr "Beállítja a menüpont eszköztippjét."


#. MenuBar.flat
#: doc/classes/MenuBar.xml
msgid "Flat [MenuBar] don't display item decoration."
msgstr "A lapos megjelenítésű [MenuBar] nem rajzol díszítő hátteret a menüpontokhoz."


#. MenuBar.language
#: doc/classes/MenuBar.xml
msgid "Language code used for line-breaking and text shaping algorithms. If left empty, the current locale is used instead."
msgstr "A sortördelési és szövegalakítási algoritmusok által használt nyelvkód. Ha üresen marad, az aktuális területi beállítást használja."


#. MenuBar.prefer_global_menu
#: doc/classes/MenuBar.xml
msgid "If [code]true[/code], [MenuBar] will use system global menu when supported.\n[b]Note:[/b] If [code]true[/code] and global menu is supported, this node is not displayed, has zero size, and all its child nodes except [PopupMenu]s are inaccessible.\n[b]Note:[/b] This property overrides the value of the [member PopupMenu.prefer_native_menu] property of the child nodes."
msgstr "Ha [code]true[/code], a [MenuBar] a rendszer globális menüjét használja, amennyiben az támogatott.\n[b]Megjegyzés:[/b] Ha [code]true[/code], és a globális menü támogatott, ez a csomópont nem jelenik meg, mérete nulla, és a [PopupMenu] csomópontokon kívül minden gyermekcsomópontja elérhetetlenné válik.\n[b]Megjegyzés:[/b] Ez a tulajdonság felülírja a gyermekcsomópontok [member PopupMenu.prefer_native_menu] tulajdonságának értékét."


#. MenuBar.start_index
#: doc/classes/MenuBar.xml
msgid "Position order in the global menu to insert [MenuBar] items at. All menu items in the [MenuBar] are always inserted as a continuous range. Menus with lower [member start_index] are inserted first. Menus with [member start_index] equal to [code]-1[/code] are inserted last."
msgstr "Megadja, hogy a [MenuBar] elemei a globális menüben milyen sorrendi pozícióban jelenjenek meg. A [MenuBar] összes menüpontja mindig összefüggő tartományba kerül. A kisebb [member start_index] értékű menük kerülnek előre. A [code]-1[/code] értékű [member start_index] menüi kerülnek a végére."


#. MenuBar.switch_on_hover
#: doc/classes/MenuBar.xml
msgid "If [code]true[/code], when the cursor hovers above menu item, it will close the current [PopupMenu] and open the other one."
msgstr "Ha [code]true[/code], az egérmutató másik menüpont fölé kerülésekor bezárja az aktuális [PopupMenu] menüt, és megnyitja a másikat."


#. MenuBar.text_direction
#: doc/classes/MenuBar.xml
msgid "Base text writing direction."
msgstr "A szöveg alapvető írásiránya."


#. MenuBar.font_color
#: doc/classes/MenuBar.xml
msgid "Default text [Color] of the menu item."
msgstr "A menüpont szövegének alapértelmezett [Color] színe."


#. MenuBar.font_disabled_color
#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is disabled."
msgstr "A letiltott menüpont szövegének [Color] színe."


#. MenuBar.font_focus_color
#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is focused. Only replaces the normal text color of the menu item. Disabled, hovered, and pressed states take precedence over this color."
msgstr "A fókuszban lévő menüpont szövegének [Color] színe. Csak a menüpont normál betűszínét írja felül; a letiltott, egérmutató alatti és lenyomott állapot színei elsőbbséget élveznek."


#. MenuBar.font_hover_color
#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is being hovered."
msgstr "A menüpont szövegének [Color] színe, amikor az egérmutató fölötte van."


#. MenuBar.font_hover_pressed_color
#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is being hovered and pressed."
msgstr "A menüpont szövegének [Color] színe, amikor az egérmutató fölötte van, és a menüpont le van nyomva."


#. MenuBar.font_outline_color
#: doc/classes/MenuBar.xml
msgid "The tint of text outline of the menu item."
msgstr "A menüpont szövegkörvonalának színezése."


#. MenuBar.font_pressed_color
#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is being pressed."
msgstr "A menüpont szövegének [Color] színe lenyomott állapotban."


#. MenuBar.h_separation
#: doc/classes/MenuBar.xml
msgid "The horizontal space between menu items."
msgstr "A menüpontok közötti vízszintes térköz."


#. MenuBar.font
#: doc/classes/MenuBar.xml
msgid "[Font] of the menu item's text."
msgstr "A menüpont szövegének [Font] betűkészlete."


#. MenuBar.font_size
#: doc/classes/MenuBar.xml
msgid "Font size of the menu item's text."
msgstr "A menüpont szövegének betűmérete."


#. MenuBar.disabled
#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is disabled."
msgstr "A letiltott menüpontnál használt [StyleBox]."


#. MenuBar.disabled_mirrored
#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is disabled (for right-to-left layouts)."
msgstr "A letiltott menüpontnál használt [StyleBox] (jobbról balra haladó elrendezésnél)."


#. MenuBar.hover
#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is being hovered."
msgstr "Az egérmutató alatt lévő menüpontnál használt [StyleBox]."


#. MenuBar.hover_mirrored
#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is being hovered (for right-to-left layouts)."
msgstr "Az egérmutató alatt lévő menüpontnál használt [StyleBox] (jobbról balra haladó elrendezésnél)."


#. MenuBar.hover_pressed
#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is being pressed and hovered at the same time."
msgstr "A lenyomott és egyidejűleg egérmutató alatt lévő menüpontnál használt [StyleBox]."


#. MenuBar.hover_pressed_mirrored
#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is being pressed and hovered at the same time (for right-to-left layouts)."
msgstr "A lenyomott és egyidejűleg egérmutató alatt lévő menüpontnál használt [StyleBox] (jobbról balra haladó elrendezésnél)."


#. MenuBar.normal
#: doc/classes/MenuBar.xml
msgid "Default [StyleBox] for the menu item."
msgstr "A menüpont alapértelmezett [StyleBox] stílusa."


#. MenuBar.normal_mirrored
#: doc/classes/MenuBar.xml
msgid "Default [StyleBox] for the menu item (for right-to-left layouts)."
msgstr "A menüpont alapértelmezett [StyleBox] stílusa (jobbról balra haladó elrendezésnél)."


#. MenuBar.pressed
#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is being pressed."
msgstr "A lenyomott menüpontnál használt [StyleBox]."


#. MenuBar.pressed_mirrored
#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is being pressed (for right-to-left layouts)."
msgstr "A lenyomott menüpontnál használt [StyleBox] (jobbról balra haladó elrendezésnél)."

#. Label.brief
#: doc/classes/Label.xml
msgid "A control for displaying plain text."
msgstr "Egyszerű szöveg megjelenítésére szolgáló vezérlőelem."


#. Label.description
#: doc/classes/Label.xml
msgid "A control for displaying plain text. It gives you control over the horizontal and vertical alignment and can wrap the text inside the node's bounding rectangle. It doesn't support bold, italics, or other rich text formatting. For that, use [RichTextLabel] instead.\n[b]Note:[/b] A single Label node is not designed to display huge amounts of text. To display large amounts of text in a single node, consider using [RichTextLabel] instead as it supports features like an integrated scroll bar and threading. [RichTextLabel] generally performs better when displaying large amounts of text (several pages or more)."
msgstr "Egyszerű szöveg megjelenítésére szolgáló vezérlőelem. Beállítható a vízszintes és függőleges igazítás, és a szöveg a csomópont határoló téglalapján belül több sorba tördelhető. A félkövér, dőlt és egyéb formázott szövegeket nem támogatja; ezekhez inkább a [RichTextLabel] osztályt használd.\n[b]Megjegyzés:[/b] Egyetlen Label csomópontot nem nagyon nagy szövegmennyiség megjelenítésére terveztek. Hosszú szövegek esetén érdemes inkább a [RichTextLabel] osztályt használni, amely beépített görgetősávot és többszálú feldolgozást is támogat. Többoldalas szövegek megjelenítésekor a [RichTextLabel] általában gyorsabb."


#. Label.get_character_bounds
#: doc/classes/Label.xml
msgid "Returns the bounding rectangle of the character at position [param pos] in the label's local coordinate system. If the character is a non-visual character or [param pos] is outside the valid range, an empty [Rect2] is returned. If the character is a part of a composite grapheme, the bounding rectangle of the whole grapheme is returned."
msgstr "Visszaadja a [param pos] pozíción lévő karakter határoló téglalapját a címke helyi koordinátarendszerében. Ha a karakter nem látható karakter, vagy a [param pos] kívül esik az érvényes tartományon, üres [Rect2] értéket ad vissza. Ha a karakter egy összetett graféma része, az egész graféma határoló téglalapját adja vissza."


#. Label.get_line_count
#: doc/classes/Label.xml
msgid "Returns the number of lines of text the Label has."
msgstr "Visszaadja a Label szövegsorainak számát."


#. Label.get_line_height
#: doc/classes/Label.xml
msgid "Returns the height of the line [param line].\nIf [param line] is set to [code]-1[/code], returns the biggest line height.\nIf there are no lines, returns font size in pixels."
msgstr "Visszaadja a [param line] sor magasságát.\nHa a [param line] értéke [code]-1[/code], a legmagasabb sor magasságát adja vissza.\nHa nincsenek sorok, a betűméretet adja vissza képpontban."


#. Label.get_total_character_count
#: doc/classes/Label.xml
msgid "Returns the total number of printable characters in the text (excluding spaces and newlines)."
msgstr "Visszaadja a szöveg nyomtatható karaktereinek teljes számát (a szóközök és sortörések nélkül)."


#. Label.get_visible_line_count
#: doc/classes/Label.xml
msgid "Returns the number of lines shown. Useful if the [Label]'s height cannot currently display all lines."
msgstr "Visszaadja a megjelenített sorok számát. Akkor hasznos, ha a [Label] magassága jelenleg nem elegendő az összes sor megjelenítéséhez."


#. Label.autowrap_mode
#: doc/classes/Label.xml
msgid "If set to something other than [constant TextServer.AUTOWRAP_OFF], the text gets wrapped inside the node's bounding rectangle. If you resize the node, it will change its height automatically to show all the text.\n[b]Note:[/b] Labels with autowrapping enabled must have a custom maximum width configured to work correctly, either through the Label's own [member Control.custom_maximum_size] or as a result of a propagated maximum size from a parent Control with [member Control.propagate_maximum_size] enabled."
msgstr "Ha az érték nem [constant TextServer.AUTOWRAP_OFF], a szöveg a csomópont határoló téglalapján belül több sorba tördelődik. A csomópont átméretezésekor a magasság automatikusan igazodik, hogy minden szöveg megjelenjen.\n[b]Megjegyzés:[/b] Az automatikus sortörést használó címkék helyes működéséhez egyéni maximális szélességet kell beállítani, vagy a Label saját [member Control.custom_maximum_size] tulajdonságával, vagy a szülő Control által továbbadott maximális mérettel, ha a [member Control.propagate_maximum_size] engedélyezett."


#. Label.autowrap_trim_flags
#: doc/classes/Label.xml
msgid "Autowrap space trimming flags. See [constant TextServer.BREAK_TRIM_START_EDGE_SPACES] and [constant TextServer.BREAK_TRIM_END_EDGE_SPACES] for more info."
msgstr "Az automatikus sortörésnél a szóközök levágását szabályozó jelzők. További részletekért lásd a [constant TextServer.BREAK_TRIM_START_EDGE_SPACES] és [constant TextServer.BREAK_TRIM_END_EDGE_SPACES] állandókat."


#. Label.clip_text
#: doc/classes/Label.xml
msgid "If [code]true[/code], the Label only shows the text that fits inside its bounding rectangle and will clip text horizontally."
msgstr "Ha [code]true[/code], a Label csak a határoló téglalapjába beleférő szöveget jeleníti meg, és vízszintesen levágja a túlnyúló részt."


#. Label.ellipsis_char
#: doc/classes/Label.xml
msgid "Ellipsis character used for text clipping."
msgstr "A szöveg levágásakor használt hárompontjel karaktere."


#. Label.horizontal_alignment
#: doc/classes/Label.xml
msgid "Controls the text's horizontal alignment. Supports left, center, right, and fill (also known as justify)."
msgstr "A szöveg vízszintes igazítását szabályozza. Balra, középre, jobbra igazítás és sorkizárás (kitöltés) támogatott."


#. Label.justification_flags
#: doc/classes/Label.xml
msgid "Line fill alignment rules."
msgstr "A sorok sorkizáró igazításának szabályai."


#. Label.label_settings
#: doc/classes/Label.xml
msgid "A [LabelSettings] resource that can be shared between multiple [Label] nodes. Takes priority over theme properties."
msgstr "Több [Label] csomópont között megosztható [LabelSettings] erőforrás. Elsőbbséget élvez a tématulajdonságokkal szemben."


#. Label.lines_skipped
#: doc/classes/Label.xml
msgid "The number of the lines ignored and not displayed from the start of the [member text] value."
msgstr "A [member text] értékének elejétől kihagyott és meg nem jelenített sorok száma."


#. Label.max_lines_visible
#: doc/classes/Label.xml
msgid "Limits the lines of text the node shows on screen."
msgstr "Korlátozza, hogy a csomópont hány szövegsort jelenítsen meg a képernyőn."


#. Label.paragraph_separator
#: doc/classes/Label.xml
msgid "String used as a paragraph separator. Each paragraph is processed independently, in its own BiDi context."
msgstr "A bekezdések elválasztására használt karakterlánc. Minden bekezdést külön dolgoz fel a rendszer, saját kétirányú szövegkezelési (BiDi) környezetben."


#. Label.structured_text_bidi_override
#: doc/classes/Label.xml
msgid "Set BiDi algorithm override for the structured text."
msgstr "Beállítja a strukturált szöveg kétirányú (BiDi) megjelenítési algoritmusának felülbírálását."


#. Label.structured_text_bidi_override_options
#: doc/classes/Label.xml
msgid "Set additional options for BiDi override."
msgstr "További beállításokat ad meg a BiDi-felülbíráláshoz."


#. Label.tab_stops
#: doc/classes/Label.xml
msgid "Aligns text to the given tab-stops."
msgstr "A szöveget a megadott tabulátorpozíciókhoz igazítja."


#. Label.text
#: doc/classes/Label.xml
msgid "The text to display on screen."
msgstr "A képernyőn megjelenítendő szöveg."


#. Label.text_overrun_behavior
#: doc/classes/Label.xml
msgid "The clipping behavior when the text exceeds the node's bounding rectangle."
msgstr "Meghatározza a szöveg levágásának módját, ha a szöveg túlnyúlik a csomópont határoló téglalapján."


#. Label.uppercase
#: doc/classes/Label.xml
msgid "If [code]true[/code], all the text displays as UPPERCASE."
msgstr "Ha [code]true[/code], minden szöveg NAGYBETŰKKEL jelenik meg."


#. Label.vertical_alignment
#: doc/classes/Label.xml
msgid "Controls the text's vertical alignment. Supports top, center, bottom, and fill."
msgstr "A szöveg függőleges igazítását szabályozza. Felső, középső, alsó és kitöltő igazítást támogat."


#. Label.visible_characters
#: doc/classes/Label.xml
msgid "The number of characters to display. If set to [code]-1[/code], all characters are displayed. This can be useful when animating the text appearing in a dialog box.\n[b]Note:[/b] Setting this property updates [member visible_ratio] accordingly.\n[b]Note:[/b] Characters are counted as Unicode codepoints. A single visible grapheme may contain multiple codepoints (e.g. certain emoji use three codepoints). A single codepoint may contain two UTF-16 characters, which are used in C# strings."
msgstr "A megjelenítendő karakterek száma. Ha az érték [code]-1[/code], minden karakter megjelenik. Ez hasznos lehet például párbeszédpanelben a szöveg fokozatos megjelenítésének animálásához.\n[b]Megjegyzés:[/b] A tulajdonság módosítása ennek megfelelően frissíti a [member visible_ratio] értékét.\n[b]Megjegyzés:[/b] A karakterek számlálása Unicode-kódpontok alapján történik. Egyetlen látható graféma több kódpontból is állhat (például bizonyos emodzsik három kódpontot használnak). Egyetlen kódpont két UTF-16 karaktert is tartalmazhat, amelyeket a C# karakterláncai használnak."


#. Label.visible_characters_behavior
#: doc/classes/Label.xml
msgid "The clipping behavior when [member visible_characters] or [member visible_ratio] is set."
msgstr "A szöveg levágásának módja, amikor a [member visible_characters] vagy a [member visible_ratio] be van állítva."


#. Label.visible_ratio
#: doc/classes/Label.xml
msgid "The fraction of characters to display, relative to the total number of characters (see [method get_total_character_count]). If set to [code]1.0[/code], all characters are displayed. If set to [code]0.5[/code], only half of the characters will be displayed. This can be useful when animating the text appearing in a dialog box.\n[b]Note:[/b] Setting this property updates [member visible_characters] accordingly."
msgstr "A megjelenítendő karakterek aránya a teljes karakterszámhoz képest (lásd: [method get_total_character_count]). Ha az érték [code]1.0[/code], minden karakter megjelenik. Ha [code]0.5[/code], a karaktereknek csak a fele látható. Ez hasznos lehet például párbeszédpanelben a szöveg fokozatos megjelenítésének animálásához.\n[b]Megjegyzés:[/b] A tulajdonság módosítása ennek megfelelően frissíti a [member visible_characters] értékét."


#. Label.font_color
#: doc/classes/Label.xml
msgid "Default text [Color] of the [Label]."
msgstr "A [Label] szövegének alapértelmezett [Color] színe."


#. Label.font_outline_color
#: doc/classes/Label.xml
msgid "The color of text outline."
msgstr "A szövegkörvonal színe."


#. Label.font_shadow_color
#: doc/classes/Label.xml
msgid "[Color] of the text's shadow effect."
msgstr "A szöveg árnyékhatásának [Color] színe."


#. Label.line_spacing
#: doc/classes/Label.xml
msgid "Additional vertical spacing between lines (in pixels), spacing is added to line descent. This value can be negative."
msgstr "További függőleges térköz a sorok között képpontban, a sor alapvonala alatti részhez hozzáadva. Negatív érték is lehet."


#. Label.outline_size
#: doc/classes/Label.xml
msgid "Text outline size.\n[b]Note:[/b] If using a font with [member FontFile.multichannel_signed_distance_field] enabled, its [member FontFile.msdf_pixel_range] must be set to at least [i]twice[/i] the value of [theme_item outline_size] for outline rendering to look correct. Otherwise, the outline may appear to be cut off earlier than intended.\n[b]Note:[/b] Using a value that is larger than half the font size is not recommended, as the font outline may fail to be fully closed in this case."
msgstr "A szövegkörvonal vastagsága.\n[b]Megjegyzés:[/b] Ha olyan betűkészletet használsz, amelynél a [member FontFile.multichannel_signed_distance_field] engedélyezett, a [member FontFile.msdf_pixel_range] értékének legalább [i]kétszer[/i] akkorának kell lennie, mint a [theme_item outline_size], hogy a körvonal megfelelően jelenjen meg. Ellenkező esetben a körvonal a kelleténél korábban levágódhat.\n[b]Megjegyzés:[/b] A betűméret felénél nagyobb érték használata nem ajánlott, mert a betű körvonala ekkor nem feltétlenül záródik teljesen."


#. Label.paragraph_spacing
#: doc/classes/Label.xml
msgid "Vertical space between paragraphs. Added on top of [theme_item line_spacing]."
msgstr "A bekezdések közötti függőleges térköz. Hozzáadódik a [theme_item line_spacing] értékéhez."


#. Label.shadow_offset_x
#: doc/classes/Label.xml
msgid "The horizontal offset of the text's shadow."
msgstr "A szövegárnyék vízszintes eltolása."


#. Label.shadow_offset_y
#: doc/classes/Label.xml
msgid "The vertical offset of the text's shadow."
msgstr "A szövegárnyék függőleges eltolása."


#. Label.shadow_outline_size
#: doc/classes/Label.xml
msgid "The size of the shadow outline."
msgstr "Az árnyék körvonalának mérete."


#. Label.font
#: doc/classes/Label.xml
msgid "[Font] used for the [Label]'s text."
msgstr "A [Label] szövegének megjelenítésére használt [Font]."


#. Label.font_size
#: doc/classes/Label.xml
msgid "Font size of the [Label]'s text."
msgstr "A [Label] szövegének betűmérete."


#. Label.focus
#: doc/classes/Label.xml
msgid "[StyleBox] used when the [Label] is focused (when used with assistive apps)."
msgstr "A [Label] fókuszba kerülésekor használt [StyleBox] (kisegítő alkalmazásokkal együtt használva)."


#. Label.normal
#: doc/classes/Label.xml
msgid "Background [StyleBox] for the [Label]."
msgstr "A [Label] háttérstílusához használt [StyleBox]."

#. PopupMenu.brief
#: doc/classes/PopupMenu.xml
msgid "A modal window used to display a list of options."
msgstr "Választható lehetőségek listáját megjelenítő modális ablak."


#. PopupMenu.description
#: doc/classes/PopupMenu.xml
msgid "[PopupMenu] is a modal window used to display a list of options. Useful for toolbars and context menus.\nThe size of a [PopupMenu] can be limited by using [member Window.max_size]. If the height of the list of items is larger than the maximum height of the [PopupMenu], a [ScrollContainer] within the popup will allow the user to scroll the contents. If no maximum size is set, or if it is set to [code]0[/code], the [PopupMenu] height will be limited by its parent rect.\nAll [code]set_*[/code] methods allow negative item indices, i.e. [code]-1[/code] to access the last item, [code]-2[/code] to select the second-to-last item, and so on.\n[b]Incremental search:[/b] Like [ItemList] and [Tree], [PopupMenu] supports searching within the list while the control is focused. Press a key that matches the first letter of an item's name to select the first item starting with the given letter. After that point, there are two ways to perform incremental search: 1) Press the same key again before the timeout duration to select the next item starting with the same letter. 2) Press letter keys that match the rest of the word before the timeout duration to match to select the item in question directly. Both of these actions will be reset to the beginning of the list if the timeout duration has passed since the last keystroke was registered. You can adjust the timeout duration by changing [member ProjectSettings.gui/timers/incremental_search_max_interval_msec].\n[b]Note:[/b] [PopupMenu] is invisible by default. To make it visible, call one of the [code]popup_*[/code] methods from [Window] on the node, such as [method Window.popup_centered_clamped].\n[b]Note:[/b] The ID values used for items are limited to 32 bits, not full 64 bits of [int]. This has a range of [code]-2^32[/code] to [code]2^32 - 1[/code], i.e. [code]-2147483648[/code] to [code]2147483647[/code]."
msgstr "A [PopupMenu] választási lehetőségek listáját megjelenítő modális ablak. Hasznos eszköztárakhoz és helyi menükhöz.\nA [PopupMenu] mérete a [member Window.max_size] segítségével korlátozható. Ha az elemek listája magasabb a [PopupMenu] maximális magasságánál, a belső [ScrollContainer] lehetővé teszi a görgetést. Ha nincs megadva maximum, vagy az érték [code]0[/code], a [PopupMenu] magasságát a szülő téglalapja korlátozza.\nMinden [code]set_*[/code] metódus elfogad negatív elemindexet: a [code]-1[/code] az utolsó, a [code]-2[/code] az utolsó előtti elemet jelöli, és így tovább.\n[b]Fokozatos keresés:[/b] Az [ItemList] és a [Tree] osztályhoz hasonlóan a [PopupMenu] is támogatja a listán belüli keresést, ha fókuszban van. Egy elem nevének kezdőbetűjét lenyomva az azzal kezdődő első elemre ugrik. Ezután kétféleképpen folytatható a keresés: 1) A várakozási időn belül ugyanazt a billentyűt ismét lenyomva a következő, ugyanezzel a betűvel kezdődő elemre ugrik. 2) A keresett szó további betűit beírva a teljesebb egyezést találja meg. Mindkét módszer újra a lista elejéről indul, ha az utolsó billentyűlenyomás óta letelt a várakozási idő. A késleltetés a [member ProjectSettings.gui/timers/incremental_search_max_interval_msec] beállítással módosítható.\n[b]Megjegyzés:[/b] A [PopupMenu] alapértelmezés szerint láthatatlan. A megjelenítéséhez hívd meg a [Window] egyik [code]popup_*[/code] metódusát, például a [method Window.popup_centered_clamped] metódust.\n[b]Megjegyzés:[/b] Az elemazonosítók 32 bitre korlátozódnak, nem az [int] teljes 64 bites tartományára. A forrásban szereplő tartomány [code]-2^32[/code] és [code]2^32 - 1[/code] között van, azaz [code]-2147483648[/code] és [code]2147483647[/code] között."


#. PopupMenu.activate_item_by_event
#: doc/classes/PopupMenu.xml
msgid "Checks the provided [param event] against the [PopupMenu]'s shortcuts and accelerators, and activates the first item with matching events. If [param for_global_only] is [code]true[/code], only shortcuts and accelerators with [code]global[/code] set to [code]true[/code] will be called.\nReturns [code]true[/code] if an item was successfully activated.\n[b]Note:[/b] Certain [Control]s, such as [MenuButton], will call this method automatically."
msgstr "Az adott [param event] eseményt a [PopupMenu] gyorsbillentyűivel és billentyűparancsaival veti össze, majd aktiválja az első egyező menüpontot. Ha a [param for_global_only] értéke [code]true[/code], csak azok a gyorsbillentyűk és billentyűparancsok működnek, amelyeknél a [code]global[/code] értéke [code]true[/code].\n[code]true[/code] értéket ad vissza, ha sikerült aktiválni egy elemet.\n[b]Megjegyzés:[/b] Egyes [Control] vezérlőelemek, például a [MenuButton], automatikusan meghívják ezt a metódust."


#. PopupMenu.add_check_item
#: doc/classes/PopupMenu.xml
msgid "Adds a new checkable item with text [param label].\nAn [param id] can optionally be provided, as well as an accelerator ([param accel]). If no [param id] is provided, one will be created from the index. If no [param accel] is provided, then the default value of 0 (corresponding to [constant @GlobalScope.KEY_NONE]) will be assigned to the item (which means it won't have any accelerator). See [method get_item_accelerator] for more info on accelerators.\n[b]Note:[/b] Checkable items just display a checkmark, but don't have any built-in checking behavior and must be checked/unchecked manually. See [method set_item_checked] for more info on how to control it."
msgstr "Új bejelölhető menüpontot ad hozzá [param label] szöveggel.\nOpcionálisan [param id] azonosító és [param accel] billentyűparancs adható meg. Ha nincs [param id], az index alapján jön létre az azonosító. Ha nincs [param accel], az elem a [constant @GlobalScope.KEY_NONE] állandónak megfelelő alapértelmezett 0 értéket kapja, ezért nincs billentyűparancsa. Lásd a [method get_item_accelerator] metódust.\n[b]Megjegyzés:[/b] A bejelölhető elemek csupán pipát jelenítenek meg: nincs automatikus bejelölési viselkedésük. A jelölést kézzel kell kapcsolni; lásd a [method set_item_checked] metódust."


#. PopupMenu.add_check_shortcut
#: doc/classes/PopupMenu.xml
msgid "Adds a new checkable item and assigns the specified [Shortcut] to it. Sets the label of the checkbox to the [Shortcut]'s name.\nAn [param id] can optionally be provided. If no [param id] is provided, one will be created from the index.\n[b]Note:[/b] Checkable items just display a checkmark, but don't have any built-in checking behavior and must be checked/unchecked manually. See [method set_item_checked] for more info on how to control it."
msgstr "Új bejelölhető menüpontot ad hozzá a megadott [Shortcut] gyorsbillentyűvel. A jelölőnégyzet felirata a [Shortcut] neve lesz.\nOpcionálisan [param id] is megadható; ha nincs [param id], az azonosító az indexből jön létre.\n[b]Megjegyzés:[/b] A bejelölhető elemek csak pipát jelenítenek meg, bejelölésük és jelölésük megszüntetése nem automatikus. Ehhez lásd a [method set_item_checked] metódust."


#. PopupMenu.add_icon_check_item
#: doc/classes/PopupMenu.xml
msgid "Adds a new checkable item with text [param label] and icon [param texture].\nAn [param id] can optionally be provided, as well as an accelerator ([param accel]). If no [param id] is provided, one will be created from the index. If no [param accel] is provided, then the default value of 0 (corresponding to [constant @GlobalScope.KEY_NONE]) will be assigned to the item (which means it won't have any accelerator). See [method get_item_accelerator] for more info on accelerators.\n[b]Note:[/b] Checkable items just display a checkmark, but don't have any built-in checking behavior and must be checked/unchecked manually. See [method set_item_checked] for more info on how to control it."
msgstr "Új bejelölhető menüpontot hoz létre [param label] szöveggel és [param texture] ikonnal.\nOpcionálisan [param id] azonosító és [param accel] billentyűparancs adható meg. Ha nincs [param id], az index alapján hoz létre egyet. Ha nincs [param accel], a [constant @GlobalScope.KEY_NONE] értéknek megfelelő alapértelmezett 0 értéket kapja, vagyis nem lesz billentyűparancsa. Lásd a [method get_item_accelerator] metódust.\n[b]Megjegyzés:[/b] A bejelölhető elemek csak pipát jelenítenek meg; nem váltják automatikusan a jelölésüket. A viselkedéshez lásd a [method set_item_checked] metódust."


#. PopupMenu.add_icon_check_shortcut
#: doc/classes/PopupMenu.xml
msgid "Adds a new checkable item and assigns the specified [Shortcut] and icon [param texture] to it. Sets the label of the checkbox to the [Shortcut]'s name.\nAn [param id] can optionally be provided. If no [param id] is provided, one will be created from the index.\n[b]Note:[/b] Checkable items just display a checkmark, but don't have any built-in checking behavior and must be checked/unchecked manually. See [method set_item_checked] for more info on how to control it."
msgstr "Új bejelölhető menüpontot hoz létre a megadott [Shortcut] gyorsbillentyűvel és [param texture] ikonnal. A jelölőnégyzet felirata a [Shortcut] neve lesz.\nOpcionálisan [param id] azonosító is megadható. Ha nincs [param id], az index alapján jön létre.\n[b]Megjegyzés:[/b] A bejelölhető elemek csak pipát jelenítenek meg; bejelölésüket és a jelölés megszüntetését kézzel kell megvalósítani. Lásd a [method set_item_checked] metódust."


#. PopupMenu.add_icon_item
#: doc/classes/PopupMenu.xml
msgid "Adds a new item with text [param label] and icon [param texture].\nAn [param id] can optionally be provided, as well as an accelerator ([param accel]). If no [param id] is provided, one will be created from the index. If no [param accel] is provided, then the default value of 0 (corresponding to [constant @GlobalScope.KEY_NONE]) will be assigned to the item (which means it won't have any accelerator). See [method get_item_accelerator] for more info on accelerators."
msgstr "Új menüpontot hoz létre [param label] szöveggel és [param texture] ikonnal.\nOpcionálisan [param id] azonosító és [param accel] billentyűparancs is megadható. Ha nincs [param id], az index alapján jön létre. Ha nincs [param accel], a [constant @GlobalScope.KEY_NONE] értéknek megfelelő alapértelmezett 0 értéket használja, tehát nincs billentyűparancsa. Lásd a [method get_item_accelerator] metódust."


#. PopupMenu.add_icon_radio_check_item
#: doc/classes/PopupMenu.xml
msgid "Same as [method add_icon_check_item], but uses a radio check button."
msgstr "Ugyanaz, mint a [method add_icon_check_item], de választógombot használ."


#. PopupMenu.add_icon_radio_check_shortcut
#: doc/classes/PopupMenu.xml
msgid "Same as [method add_icon_check_shortcut], but uses a radio check button."
msgstr "Ugyanaz, mint a [method add_icon_check_shortcut], de választógombot használ."


#. PopupMenu.add_icon_shortcut
#: doc/classes/PopupMenu.xml
msgid "Adds a new item and assigns the specified [Shortcut] and icon [param texture] to it. Sets the label of the checkbox to the [Shortcut]'s name.\nAn [param id] can optionally be provided. If no [param id] is provided, one will be created from the index.\nIf [param allow_echo] is [code]true[/code], the shortcut can be activated with echo events."
msgstr "Új menüpontot hoz létre a megadott [Shortcut] gyorsbillentyűvel és [param texture] ikonnal. A jelölőnégyzet felirata a [Shortcut] neve lesz.\nOpcionálisan [param id] azonosító adható meg. Ha nincs [param id], az index alapján jön létre.\nHa a [param allow_echo] értéke [code]true[/code], a gyorsbillentyű ismétlődő billentyűeseményekkel is aktiválható."

#. PopupMenu.add_item
#: doc/classes/PopupMenu.xml
msgid "Adds a new item with text [param label].\nAn [param id] can optionally be provided, as well as an accelerator ([param accel]). If no [param id] is provided, one will be created from the index. If no [param accel] is provided, then the default value of 0 (corresponding to [constant @GlobalScope.KEY_NONE]) will be assigned to the item (which means it won't have any accelerator). See [method get_item_accelerator] for more info on accelerators.\n[b]Note:[/b] The provided [param id] is used only in [signal id_pressed] and [signal id_focused] signals. It's not related to the [code]index[/code] arguments in e.g. [method set_item_checked]."
msgstr "Új menüpontot ad hozzá [param label] szöveggel.\nOpcionálisan [param id] azonosító és [param accel] billentyűparancs adható meg. Ha nincs [param id], az index alapján hoz létre egyet. Ha nincs [param accel], a [constant @GlobalScope.KEY_NONE] értéknek megfelelő alapértelmezett 0 értéket használja, így nem lesz billentyűparancsa. Lásd a [method get_item_accelerator] metódust.\n[b]Megjegyzés:[/b] A [param id] értéket kizárólag az [signal id_pressed] és az [signal id_focused] jelek használják. Nem azonos például a [method set_item_checked] [code]index[/code] argumentumával."


#. PopupMenu.add_radio_check_item
#: doc/classes/PopupMenu.xml
msgid "Adds a new radio check button with text [param label].\nAn [param id] can optionally be provided, as well as an accelerator ([param accel]). If no [param id] is provided, one will be created from the index. If no [param accel] is provided, then the default value of 0 (corresponding to [constant @GlobalScope.KEY_NONE]) will be assigned to the item (which means it won't have any accelerator). See [method get_item_accelerator] for more info on accelerators.\n[b]Note:[/b] Checkable items just display a checkmark, but don't have any built-in checking behavior and must be checked/unchecked manually. See [method set_item_checked] for more info on how to control it."
msgstr "Új választógombos menüpontot ad hozzá [param label] szöveggel.\nOpcionálisan [param id] azonosító és [param accel] billentyűparancs adható meg. Ha nincs [param id], az index alapján jön létre. Ha nincs [param accel], a [constant @GlobalScope.KEY_NONE] értéknek megfelelő alapértelmezett 0 értéket kapja, ezért nincs billentyűparancsa. Lásd a [method get_item_accelerator] metódust.\n[b]Megjegyzés:[/b] A jelölhető elemek csak pipát jelenítenek meg, de nem kezelik automatikusan a jelölésüket; ehhez lásd a [method set_item_checked] metódust."


#. PopupMenu.add_radio_check_shortcut
#: doc/classes/PopupMenu.xml
msgid "Adds a new radio check button and assigns a [Shortcut] to it. Sets the label of the checkbox to the [Shortcut]'s name.\nAn [param id] can optionally be provided. If no [param id] is provided, one will be created from the index.\n[b]Note:[/b] Checkable items just display a checkmark, but don't have any built-in checking behavior and must be checked/unchecked manually. See [method set_item_checked] for more info on how to control it."
msgstr "Új választógombos menüpontot ad hozzá, és [Shortcut] gyorsbillentyűt társít hozzá. A jelölőnégyzet felirata a [Shortcut] neve lesz.\nOpcionálisan [param id] adható meg. Ha nincs [param id], az index alapján hoz létre egyet.\n[b]Megjegyzés:[/b] A jelölhető elemek csak pipát jelenítenek meg; jelölésük be- és kikapcsolását kézzel kell kezelni. Lásd a [method set_item_checked] metódust."


#. PopupMenu.add_separator
#: doc/classes/PopupMenu.xml
msgid "Adds a separator between items. Separators also occupy an index, which you can set by using the [param id] parameter.\nA [param label] can optionally be provided, which will appear at the center of the separator."
msgstr "Elválasztót ad a menüpontok közé. Az elválasztó is elfoglal egy indexet, amely a [param id] paraméterrel adható meg.\nOpcionális [param label] felirat is megadható, amely az elválasztó közepén jelenik meg."


#. PopupMenu.add_shortcut
#: doc/classes/PopupMenu.xml
msgid "Adds a [Shortcut].\nAn [param id] can optionally be provided. If no [param id] is provided, one will be created from the index.\nIf [param allow_echo] is [code]true[/code], the shortcut can be activated with echo events."
msgstr "[Shortcut] gyorsbillentyűt ad hozzá.\nOpcionálisan [param id] adható meg. Ha nincs [param id], az index alapján hoz létre egyet.\nHa a [param allow_echo] értéke [code]true[/code], a gyorsbillentyű ismétlődő billentyűeseményekkel is aktiválható."


#. PopupMenu.add_submenu_item
#: doc/classes/PopupMenu.xml
msgid "Adds an item that will act as a submenu of the parent [PopupMenu] node when clicked. The [param submenu] argument must be the name of an existing [PopupMenu] that has been added as a child to this node. This submenu will be shown when the item is clicked, hovered for long enough, or activated using the [code]ui_select[/code] or [code]ui_right[/code] input actions.\nAn [param id] can optionally be provided. If no [param id] is provided, one will be created from the index."
msgstr "Menüpontot hoz létre, amelyre kattintva a szülő [PopupMenu] almenüjeként működő menü nyílik meg. A [param submenu] argumentumnak egy már létező, ehhez a csomóponthoz gyermekként hozzáadott [PopupMenu] nevét kell tartalmaznia. Az almenü kattintáskor, megfelelő ideig tartó rámutatáskor, illetve a [code]ui_select[/code] vagy [code]ui_right[/code] bemeneti művelettel nyílik meg.\nOpcionálisan [param id] is megadható. Ha nincs [param id], az index alapján hoz létre egyet."


#. PopupMenu.add_submenu_node_item
#: doc/classes/PopupMenu.xml
msgid "Adds an item that will act as a submenu of the parent [PopupMenu] node when clicked. This submenu will be shown when the item is clicked, hovered for long enough, or activated using the [code]ui_select[/code] or [code]ui_right[/code] input actions.\n[param submenu] must be either child of this [PopupMenu] or has no parent node (in which case it will be automatically added as a child). If the [param submenu] popup has another parent, this method will fail.\nAn [param id] can optionally be provided. If no [param id] is provided, one will be created from the index."
msgstr "Menüpontot hoz létre, amelyre kattintva a szülő [PopupMenu] almenüjeként működő menü nyílik meg. Az almenü kattintáskor, megfelelő ideig tartó rámutatáskor, illetve a [code]ui_select[/code] vagy [code]ui_right[/code] bemeneti művelettel nyílik meg.\nA [param submenu] menünek az aktuális [PopupMenu] gyermekének kell lennie, vagy nem lehet szülője (ekkor a rendszer gyermekként hozzáadja). Ha a [param submenu] másik szülőhöz tartozik, a metódus sikertelen lesz.\nOpcionálisan [param id] is megadható. Ha nincs [param id], az index alapján jön létre az azonosító."


#. PopupMenu.clear
#: doc/classes/PopupMenu.xml
msgid "Removes all items from the [PopupMenu]. If [param free_submenus] is [code]true[/code], the submenu nodes are automatically freed."
msgstr "Eltávolítja a [PopupMenu] összes menüpontját. Ha a [param free_submenus] értéke [code]true[/code], az almenük csomópontjait is automatikusan felszabadítja."


#. PopupMenu.add_multistate_item
#: doc/classes/PopupMenu.xml
msgid "Adds a new multistate item with text [param label].\nContrarily to normal binary items, multistate items can have more than two states, as defined by [param max_states]. The default value is defined by [param default_state].\nAn [param id] can optionally be provided, as well as an accelerator ([param accel]). If no [param id] is provided, one will be created from the index. If no [param accel] is provided, then the default value of 0 (corresponding to [constant @GlobalScope.KEY_NONE]) will be assigned to the item (which means it won't have any accelerator). See [method get_item_accelerator] for more info on accelerators.\n[codeblock]\nfunc _ready():\n\tadd_multistate_item(\"Item\", 3, 0)\n\n\tindex_pressed.connect(func(index: int):\n\t\t\ttoggle_item_multistate(index)\n\t\t\tmatch get_item_multistate(index):\n\t\t\t\t0:\n\t\t\t\t\tprint(\"First state\")\n\t\t\t\t1:\n\t\t\t\t\tprint(\"Second state\")\n\t\t\t\t2:\n\t\t\t\t\tprint(\"Third state\")\n\t\t)\n[/codeblock]\n[b]Note:[/b] Multistate items don't update their state automatically and must be done manually. See [method toggle_item_multistate], [method set_item_multistate] and [method get_item_multistate] for more info on how to control it."
msgstr "Többállapotú menüpontot hoz létre [param label] szöveggel.\nA hagyományos kétállapotú elemekkel szemben a [param max_states] értéke kettőnél több állapotot is engedélyez. A kezdőállapotot a [param default_state] határozza meg.\nOpcionálisan [param id] és [param accel] is megadható. Ha nincs [param id], az indexből jön létre. Ha nincs [param accel], a [constant @GlobalScope.KEY_NONE] állandónak megfelelő alapértelmezett 0 értéket kapja, tehát nincs billentyűparancsa. Lásd a [method get_item_accelerator] metódust.\n[codeblock]\nfunc _ready():\n\tadd_multistate_item(\"Item\", 3, 0)\n\n\tindex_pressed.connect(func(index: int):\n\t\t\ttoggle_item_multistate(index)\n\t\t\tmatch get_item_multistate(index):\n\t\t\t\t0:\n\t\t\t\t\tprint(\"First state\")\n\t\t\t\t1:\n\t\t\t\t\tprint(\"Second state\")\n\t\t\t\t2:\n\t\t\t\t\tprint(\"Third state\")\n\t\t)\n[/codeblock]\n[b]Megjegyzés:[/b] A többállapotú menüpontok állapota nem változik automatikusan; azt kézzel kell beállítani. Lásd a [method toggle_item_multistate], [method set_item_multistate] és [method get_item_multistate] metódusokat."

#. PopupMenu.get_focused_item
#: doc/classes/PopupMenu.xml
msgid "Returns the index of the currently focused item. Returns [code]-1[/code] if no item is focused."
msgstr "Visszaadja a jelenleg fókuszban lévő elem indexét. Ha nincs ilyen elem, [code]-1[/code] értéket ad vissza."


#. PopupMenu.get_item_accelerator
#: doc/classes/PopupMenu.xml
msgid "Returns the accelerator of the item at the given [param index]. An accelerator is a keyboard shortcut that can be pressed to trigger the menu button even if it's not currently open. The return value is an integer which is generally a combination of [enum KeyModifierMask]s and [enum Key]s using bitwise OR such as [code]KEY_MASK_CTRL | KEY_A[/code] ([kbd]Ctrl + A[/kbd]). If no accelerator is defined for the specified [param index], [method get_item_accelerator] returns [code]0[/code] (corresponding to [constant @GlobalScope.KEY_NONE])."
msgstr "Visszaadja a [param index] indexű elem billentyűparancsát. Ez egy olyan billentyűkombináció, amellyel a menüpont akkor is aktiválható, ha a menü nincs nyitva. A visszatérési érték egész szám, amely rendszerint az [enum KeyModifierMask] és az [enum Key] felsorolás elemeinek bitenkénti VAGY kapcsolatából áll, például [code]KEY_MASK_CTRL | KEY_A[/code] ([kbd]Ctrl + A[/kbd]). Ha a [param index] indexű elemhez nincs billentyűparancs rendelve, a [method get_item_accelerator] [code]0[/code] értéket ad vissza (ennek megfelelő állandó a [constant @GlobalScope.KEY_NONE])."


#. PopupMenu.get_item_auto_translate_mode
#: doc/classes/PopupMenu.xml
msgid "Returns the auto translate mode of the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem automatikus fordítási módját."


#. PopupMenu.get_item_icon
#: doc/classes/PopupMenu.xml
msgid "Returns the icon of the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem ikonját."


#. PopupMenu.get_item_icon_max_width
#: doc/classes/PopupMenu.xml
msgid "Returns the maximum allowed width of the icon for the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem ikonjának maximálisan megengedett szélességét."


#. PopupMenu.get_item_icon_modulate
#: doc/classes/PopupMenu.xml
msgid "Returns a [Color] modulating the item's icon at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem ikonjának színét módosító [Color] értéket."


#. PopupMenu.get_item_id
#: doc/classes/PopupMenu.xml
msgid "Returns the ID of the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem azonosítóját."


#. PopupMenu.get_item_indent
#: doc/classes/PopupMenu.xml
msgid "Returns the horizontal offset of the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem vízszintes eltolását."


#. PopupMenu.get_item_index
#: doc/classes/PopupMenu.xml
msgid "Returns the index of the item containing the specified [param id]. The index is automatically assigned to each item by the engine when added and represents the order items will be displayed."
msgstr "Visszaadja a [param id] azonosítójú elem indexét. Az indexet a motor automatikusan adja az elemekhez hozzáadáskor, és az elemek megjelenítési sorrendjét jelöli."


#. PopupMenu.get_item_metadata
#: doc/classes/PopupMenu.xml
msgid "Returns the metadata of the specified item, which might be of any type. You can set it with [method set_item_metadata], which provides a simple way of assigning context data to items."
msgstr "Visszaadja a megadott elem tetszőleges típusú metaadatát. A metaadat a [method set_item_metadata] metódussal állítható be, így egyszerűen társíthatsz környezeti adatokat egy elemhez."


#. PopupMenu.get_item_multistate
#: doc/classes/PopupMenu.xml
msgid "Returns the state of the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem állapotát."


#. PopupMenu.get_item_multistate_max
#: doc/classes/PopupMenu.xml
msgid "Returns the max states of the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem lehetséges állapotainak legnagyobb számát."


#. PopupMenu.get_item_shortcut
#: doc/classes/PopupMenu.xml
msgid "Returns the [Shortcut] associated with the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elemhez társított [Shortcut] gyorsbillentyűt."


#. PopupMenu.get_item_submenu
#: doc/classes/PopupMenu.xml
msgid "Returns the submenu name of the item at the given [param index]. See [method add_submenu_item] for more info on how to add a submenu."
msgstr "Visszaadja a [param index] indexű elem almenüjének nevét. Almenü létrehozásáról lásd a [method add_submenu_item] metódust."


#. PopupMenu.get_item_submenu_node
#: doc/classes/PopupMenu.xml
msgid "Returns the submenu of the item at the given [param index], or [code]null[/code] if no submenu was added. See [method add_submenu_node_item] for more info on how to add a submenu."
msgstr "Visszaadja a [param index] indexű elem almenüjét, vagy [code]null[/code] értéket, ha nincs almenü hozzáadva. Az almenü létrehozásáról lásd a [method add_submenu_node_item] metódust."


#. PopupMenu.get_item_text
#: doc/classes/PopupMenu.xml
msgid "Returns the text of the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elem szövegét."


#. PopupMenu.get_item_tooltip
#: doc/classes/PopupMenu.xml
msgid "Returns the tooltip associated with the item at the given [param index]."
msgstr "Visszaadja a [param index] indexű elemhez társított eszköztippet."

#. PopupMenu.is_item_checkable
#: doc/classes/PopupMenu.xml
msgid "Returns [code]true[/code] if the item at the given [param index] is checkable in some way, i.e. if it has a checkbox or radio button.\n[b]Note:[/b] Checkable items just display a checkmark or radio button, but don't have any built-in checking behavior and must be checked/unchecked manually."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű elem valamilyen módon bejelölhető, vagyis jelölőnégyzettel vagy választógombbal rendelkezik.\n[b]Megjegyzés:[/b] A bejelölhető elemek csak pipát vagy választógombot jelenítenek meg, de automatikus jelöléskezelésük nincs. Be- és kikapcsolásukról saját kóddal kell gondoskodni."


#. PopupMenu.is_item_checked
#: doc/classes/PopupMenu.xml
msgid "Returns [code]true[/code] if the item at the given [param index] is checked."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű elem be van jelölve."


#. PopupMenu.is_item_disabled
#: doc/classes/PopupMenu.xml
msgid "Returns [code]true[/code] if the item at the given [param index] is disabled. When it is disabled it can't be selected, or its action invoked.\nSee [method set_item_disabled] for more info on how to disable an item."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű elem le van tiltva. A letiltott elem nem jelölhető ki, és a művelete sem hívható meg.\nAz elem letiltásáról lásd a [method set_item_disabled] metódust."


#. PopupMenu.is_item_radio_checkable
#: doc/classes/PopupMenu.xml
msgid "Returns [code]true[/code] if the item at the given [param index] has radio button-style checkability.\n[b]Note:[/b] This is purely cosmetic; you must add the logic for checking/unchecking items in radio groups."
msgstr "[code]true[/code] értéket ad vissza, ha a [param index] indexű elem választógombként jelölhető.\n[b]Megjegyzés:[/b] Ez kizárólag megjelenési beállítás: a választógombok csoportjában történő be- és kikapcsolás logikáját külön kell megírni."


#. PopupMenu.is_item_separator
#: doc/classes/PopupMenu.xml
msgid "Returns [code]true[/code] if the item is a separator. If it is, it will be displayed as a line. See [method add_separator] for more info on how to add a separator."
msgstr "[code]true[/code] értéket ad vissza, ha a menüpont elválasztó. Ilyenkor vonalként jelenik meg. Elválasztó hozzáadásához lásd az [method add_separator] metódust."


#. PopupMenu.is_item_shortcut_disabled
#: doc/classes/PopupMenu.xml
msgid "Returns [code]true[/code] if the specified item's shortcut is disabled."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott menüpont gyorsbillentyűje le van tiltva."


#. PopupMenu.is_native_menu
#: doc/classes/PopupMenu.xml
msgid "Returns [code]true[/code] if the system native menu is supported and currently used by this [PopupMenu]."
msgstr "[code]true[/code] értéket ad vissza, ha a rendszer natív menüje támogatott, és ezt használja jelenleg a [PopupMenu]."


#. PopupMenu.is_system_menu
#: doc/classes/PopupMenu.xml
msgid "Returns [code]true[/code] if the menu is bound to the special system menu."
msgstr "[code]true[/code] értéket ad vissza, ha a menü egy speciális rendszermenühöz van kötve."


#. PopupMenu.remove_item
#: doc/classes/PopupMenu.xml
msgid "Removes the item at the given [param index] from the menu.\n[b]Note:[/b] The indices of items after the removed item will be shifted by one."
msgstr "Eltávolítja a [param index] indexű elemet a menüből.\n[b]Megjegyzés:[/b] Az eltávolított elem utáni elemek indexei eggyel eltolódnak."


#. PopupMenu.scroll_to_item
#: doc/classes/PopupMenu.xml
msgid "Moves the scroll view to make the item at the given [param index] visible."
msgstr "A görgetett nézetet úgy mozgatja, hogy a [param index] indexű elem láthatóvá váljon."


#. PopupMenu.set_focused_item
#: doc/classes/PopupMenu.xml
msgid "Sets the currently focused item as the given [param index].\nPassing [code]-1[/code] as the index makes so that no item is focused."
msgstr "A [param index] indexű elemet helyezi fókuszba.\nA [code]-1[/code] index megadásával megszünteti az összes elem fókuszát."


#. PopupMenu.set_item_accelerator
#: doc/classes/PopupMenu.xml
msgid "Sets the accelerator of the item at the given [param index]. An accelerator is a keyboard shortcut that can be pressed to trigger the menu button even if it's not currently open. [param accel] is generally a combination of [enum KeyModifierMask]s and [enum Key]s using bitwise OR such as [code]KEY_MASK_CTRL | KEY_A[/code] ([kbd]Ctrl + A[/kbd])."
msgstr "Beállítja a [param index] indexű elem billentyűparancsát. Ez a menü megnyitása nélkül is aktiválhatja az adott menüpontot. A [param accel] általában az [enum KeyModifierMask] és [enum Key] értékeinek bitenkénti VAGY kombinációja, például [code]KEY_MASK_CTRL | KEY_A[/code] ([kbd]Ctrl + A[/kbd])."


#. PopupMenu.set_item_as_checkable
#: doc/classes/PopupMenu.xml
msgid "Sets whether the item at the given [param index] has a checkbox. If [code]false[/code], sets the type of the item to plain text.\n[b]Note:[/b] Checkable items just display a checkmark, but don't have any built-in checking behavior and must be checked/unchecked manually."
msgstr "Beállítja, hogy a [param index] indexű elemnek legyen-e jelölőnégyzete. Ha az érték [code]false[/code], a menüpont típusa egyszerű szöveggé változik.\n[b]Megjegyzés:[/b] A bejelölhető elemek csak pipát jelenítenek meg, de automatikus be- és kikapcsolási viselkedésük nincs."


#. PopupMenu.set_item_as_radio_checkable
#: doc/classes/PopupMenu.xml
msgid "Sets the type of the item at the given [param index] to radio button. If [code]false[/code], sets the type of the item to plain text."
msgstr "A [param index] indexű elemet választógomb típusúra állítja. Ha az érték [code]false[/code], a menüpont egyszerű szöveges elemmé válik."


#. PopupMenu.set_item_as_separator
#: doc/classes/PopupMenu.xml
msgid "Mark the item at the given [param index] as a separator, which means that it would be displayed as a line. If [code]false[/code], sets the type of the item to plain text."
msgstr "A [param index] indexű elemet elválasztónak jelöli, így vonalként jelenik meg. Ha az érték [code]false[/code], a menüpont egyszerű szöveges elemmé válik."


#. PopupMenu.set_item_auto_translate_mode
#: doc/classes/PopupMenu.xml
msgid "Sets the auto translate mode of the item at the given [param index].\nItems use [constant Node.AUTO_TRANSLATE_MODE_INHERIT] by default, which uses the same auto translate mode as the [PopupMenu] itself."
msgstr "Beállítja a [param index] indexű elem automatikus fordítási módját.\nAz elemek alapértelmezés szerint a [constant Node.AUTO_TRANSLATE_MODE_INHERIT] értéket használják, így a [PopupMenu] automatikus fordítási módját öröklik."


#. PopupMenu.set_item_checked
#: doc/classes/PopupMenu.xml
msgid "Sets the checkstate status of the item at the given [param index]."
msgstr "Beállítja a [param index] indexű elem bejelölt állapotát."

#. PopupMenu.set_item_disabled
#: doc/classes/PopupMenu.xml
msgid "Enables/disables the item at the given [param index]. When it is disabled, it can't be selected and its action can't be invoked."
msgstr "Engedélyezi vagy letiltja a [param index] indexű elemet. A letiltott elem nem választható ki, és a hozzá tartozó művelet sem hívható meg."


#. PopupMenu.set_item_icon
#: doc/classes/PopupMenu.xml
msgid "Replaces the [Texture2D] icon of the item at the given [param index]."
msgstr "Lecseréli a [param index] indexű elem [Texture2D] ikonját."


#. PopupMenu.set_item_icon_max_width
#: doc/classes/PopupMenu.xml
msgid "Sets the maximum allowed width of the icon for the item at the given [param index]. This limit is applied on top of the default size of the icon and on top of [theme_item icon_max_width]. The height is adjusted according to the icon's ratio."
msgstr "Beállítja a [param index] indexű elem ikonjának maximálisan megengedett szélességét. A korlát az ikon alapértelmezett méretén és a [theme_item icon_max_width] beállításon felül érvényesül. A magasság az ikon képarányához igazodik."


#. PopupMenu.set_item_icon_modulate
#: doc/classes/PopupMenu.xml
msgid "Sets a modulating [Color] of the item's icon at the given [param index]."
msgstr "Beállítja a [param index] indexű elem ikonjának színét módosító [Color] értéket."


#. PopupMenu.set_item_id
#: doc/classes/PopupMenu.xml
msgid "Sets the [param id] of the item at the given [param index].\nThe [param id] is used in [signal id_pressed] and [signal id_focused] signals."
msgstr "A [param index] indexű elem [param id] azonosítóját állítja be.\nA [param id] az [signal id_pressed] és [signal id_focused] jelekben használatos."


#. PopupMenu.set_item_indent
#: doc/classes/PopupMenu.xml
msgid "Sets the horizontal offset of the item at the given [param index]."
msgstr "Beállítja a [param index] indexű elem vízszintes eltolását."


#. PopupMenu.set_item_index
#: doc/classes/PopupMenu.xml
msgid "Changes the index of the item at index [param index] to be at index [param target_index]. This can be used to move an item above other items. The moved item will keep the same ID, even if it was generated from the original index.\n[b]Note:[/b] The indices of any items between index [param index] and index [param target_index] will be shifted by one."
msgstr "A [param index] indexű elemet a [param target_index] indexű helyre mozgatja. Így egy elem más menüpontok fölé is helyezhető. Az áthelyezett elem megőrzi azonosítóját akkor is, ha az az eredeti indexéből jött létre.\n[b]Megjegyzés:[/b] A [param index] és [param target_index] közötti elemek indexe eggyel eltolódik."


#. PopupMenu.set_item_metadata
#: doc/classes/PopupMenu.xml
msgid "Sets the metadata of an item, which may be of any type. You can later get it with [method get_item_metadata], which provides a simple way of assigning context data to items."
msgstr "Beállítja egy elem tetszőleges típusú metaadatát. A [method get_item_metadata] metódussal később lekérhető, így egyszerűen társíthatsz környezeti adatokat az elemekhez."


#. PopupMenu.set_item_multistate
#: doc/classes/PopupMenu.xml
msgid "Sets the state of a multistate item. See [method add_multistate_item] for details."
msgstr "Beállítja egy többállapotú elem aktuális állapotát. A részleteket lásd az [method add_multistate_item] metódusnál."


#. PopupMenu.set_item_multistate_max
#: doc/classes/PopupMenu.xml
msgid "Sets the max states of a multistate item. See [method add_multistate_item] for details."
msgstr "Beállítja egy többállapotú elem lehetséges állapotainak maximális számát. Lásd az [method add_multistate_item] metódust."


#. PopupMenu.set_item_shortcut
#: doc/classes/PopupMenu.xml
msgid "Sets a [Shortcut] for the item at the given [param index]."
msgstr "Beállítja a [param index] indexű elem [Shortcut] gyorsbillentyűjét."


#. PopupMenu.set_item_shortcut_disabled
#: doc/classes/PopupMenu.xml
msgid "Disables the [Shortcut] of the item at the given [param index]."
msgstr "Letiltja a [param index] indexű elem [Shortcut] gyorsbillentyűjét."


#. PopupMenu.set_item_submenu
#: doc/classes/PopupMenu.xml
msgid "Sets the submenu of the item at the given [param index]. The submenu is the name of a child [PopupMenu] node that would be shown when the item is clicked."
msgstr "Beállítja a [param index] indexű elem almenüjét. Az almenü egy gyermek [PopupMenu] csomópont neve, amely akkor jelenik meg, amikor a menüpontra kattintanak."


#. PopupMenu.set_item_submenu_node
#: doc/classes/PopupMenu.xml
msgid "Sets the submenu of the item at the given [param index]. The submenu is a [PopupMenu] node that would be shown when the item is clicked. It must either be a child of this [PopupMenu] or has no parent (in which case it will be automatically added as a child). If the [param submenu] popup has another parent, this method will fail."
msgstr "Beállítja a [param index] indexű elem almenüjét. Ez egy [PopupMenu] csomópont, amely a menüpontra kattintva jelenik meg. Az almenünek az aktuális [PopupMenu] gyermekének kell lennie, vagy nem lehet szülője (ekkor a rendszer gyermekként hozzáadja). Ha a [param submenu] menünek másik szülője van, a metódus sikertelen lesz."


#. PopupMenu.set_item_text
#: doc/classes/PopupMenu.xml
msgid "Sets the text of the item at the given [param index]."
msgstr "Beállítja a [param index] indexű elem szövegét."


#. PopupMenu.set_item_tooltip
#: doc/classes/PopupMenu.xml
msgid "Sets the [String] tooltip of the item at the given [param index]."
msgstr "Beállítja a [param index] indexű elem [String] típusú eszköztippjét."


#. PopupMenu.toggle_item_checked
#: doc/classes/PopupMenu.xml
msgid "Toggles the check state of the item at the given [param index]."
msgstr "Átváltja a [param index] indexű elem bejelölt állapotát."


#. PopupMenu.toggle_item_multistate
#: doc/classes/PopupMenu.xml
msgid "Cycle to the next state of a multistate item. See [method add_multistate_item] for details."
msgstr "A többállapotú elem következő állapotára lép. A részleteket lásd az [method add_multistate_item] metódusnál."

#. PopupMenu.allow_search
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], allows navigating [PopupMenu] with letter keys."
msgstr "Ha [code]true[/code], a [PopupMenu] elemei között betűbillentyűkkel is lehet navigálni."


#. PopupMenu.hide_on_checkable_item_selection
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], hides the [PopupMenu] when a checkbox or radio button is selected."
msgstr "Ha [code]true[/code], a [PopupMenu] elrejtőzik, amikor jelölőnégyzetes vagy választógombos menüpontot választanak ki."


#. PopupMenu.hide_on_item_selection
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], hides the [PopupMenu] when an item is selected."
msgstr "Ha [code]true[/code], a [PopupMenu] elrejtőzik egy menüpont kiválasztásakor."


#. PopupMenu.hide_on_state_item_selection
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], hides the [PopupMenu] when a state item is selected."
msgstr "Ha [code]true[/code], a [PopupMenu] elrejtőzik egy állapotos menüpont kiválasztásakor."


#. PopupMenu.item_{index}/checkable
#: doc/classes/PopupMenu.xml
msgid "The checkable item type of the item at [code]index[/code].\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/code] range."
msgstr "A [code]index[/code] indexű elem bejelölhetőségi típusa.\n[b]Megjegyzés:[/b] Az [code]index[/code] a [code]0 .. item_count - 1[/code] tartományba esik."


#. PopupMenu.item_{index}/checked
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], the item at [code]index[/code] is checked.\n[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/code] range."
msgstr "Ha [code]true[/code], a [code]index[/code] indexű elem be van jelölve.\n[b]Megjegyzés:[/b] Az [code]index[/code] a [code]0 .. item_count - 1[/code] tartományba esik."


#. PopupMenu.prefer_native_menu
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], [MenuBar] will use native menu when supported.\n[b]Note:[/b] If [PopupMenu] is linked to [StatusIndicator], [MenuBar], or another [PopupMenu] item it can use native menu regardless of this property, use [method is_native_menu] to check it."
msgstr "Ha [code]true[/code], a [MenuBar] a rendszer natív menüjét használja, ha az támogatott.\n[b]Megjegyzés:[/b] Ha a [PopupMenu] egy [StatusIndicator], [MenuBar] vagy másik [PopupMenu] menüpontjához kapcsolódik, ettől a tulajdonságtól függetlenül is használhat natív menüt. Ezt a [method is_native_menu] metódussal ellenőrizheted."


#. PopupMenu.search_bar_enabled
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], shows a search bar at the top of the [PopupMenu] for filtering items. See [member search_bar_min_item_count] for dynamically controlling its visibility based on the number of items.\n[b]Note:[/b] When enabled, [member allow_search] is ignored."
msgstr "Ha [code]true[/code], a [PopupMenu] tetején keresősáv jelenik meg az elemek szűréséhez. A megjelenést az elemszám alapján a [member search_bar_min_item_count] tulajdonsággal szabályozhatod.\n[b]Megjegyzés:[/b] Ha ez engedélyezett, a rendszer figyelmen kívül hagyja a [member allow_search] tulajdonságot."


#. PopupMenu.search_bar_min_item_count
#: doc/classes/PopupMenu.xml
msgid "Sets the minimum number of items required for the search bar to be visible. [member search_bar_enabled] must be [code]true[/code] for this to have any effect. Separator items are not counted."
msgstr "A keresősáv megjelenítéséhez szükséges menüpontok legkisebb száma. Ennek csak akkor van hatása, ha a [member search_bar_enabled] értéke [code]true[/code]. Az elválasztó elemek nem számítanak bele."


#. PopupMenu.shrink_height
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], shrinks [PopupMenu] to minimum height when it's shown."
msgstr "Ha [code]true[/code], a [PopupMenu] megjelenésekor a minimális magasságára zsugorodik."


#. PopupMenu.shrink_width
#: doc/classes/PopupMenu.xml
msgid "If [code]true[/code], shrinks [PopupMenu] to minimum width when it's shown."
msgstr "Ha [code]true[/code], a [PopupMenu] megjelenésekor a minimális szélességére zsugorodik."


#. PopupMenu.submenu_popup_delay
#: doc/classes/PopupMenu.xml
msgid "Sets the delay time in seconds for the submenu item to popup on mouse hovering. If the popup menu is added as a child of another (acting as a submenu), it will inherit the delay time of the parent menu item.\n[b]Note:[/b] If the mouse is exiting a submenu item with an open submenu and enters a different submenu item, the submenu popup delay time is affected by the direction of the mouse movement toward the open submenu. If the mouse is moving toward the submenu, the open submenu will wait approximately [code]0.5[/code] seconds before closing, which then allows the hovered submenu item to open. This additional delay allows the mouse time to move to the open submenu across other menu items without prematurely closing. If the mouse is not moving toward the open submenu, for example in a downward direction, the open submenu will close immediately."
msgstr "Megadja másodpercben, mennyi idő után nyíljon meg az almenü, amikor az egérmutató egy almenüs menüpont fölé kerül. Ha a felugró menü egy másik menü gyermeke, vagyis almenü, örökli a szülő menüpont késleltetését.\n[b]Megjegyzés:[/b] Ha az egérmutató egy nyitott almenüvel rendelkező menüpontról egy másik almenüs menüpontra lép, a megnyitás késleltetését befolyásolja az egér mozgásának iránya. Ha az egér a nyitott almenü felé halad, az körülbelül [code]0.5[/code] másodpercet vár a bezárás előtt, így a másik almenü megnyílhat. A többletidő megakadályozza, hogy a más menüpontok fölött áthaladó egérmutató idő előtt bezárja az almenüt. Ha az egér nem a nyitott almenü felé halad, például lefelé mozog, az almenü azonnal bezárul."


#. PopupMenu.system_menu_id
#: doc/classes/PopupMenu.xml
msgid "If set to one of the values of [enum NativeMenu.SystemMenus], this [PopupMenu] is bound to the special system menu. Only one [PopupMenu] can be bound to each special menu at a time."
msgstr "Ha az értéke a [enum NativeMenu.SystemMenus] egyik eleme, ez a [PopupMenu] egy speciális rendszermenühöz kapcsolódik. Egy adott speciális menühöz egyszerre csak egy [PopupMenu] rendelhető."


#. PopupMenu.id_focused
#: doc/classes/PopupMenu.xml
