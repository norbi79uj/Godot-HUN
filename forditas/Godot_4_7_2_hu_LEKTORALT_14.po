#. SpinBox.updown
#: doc/classes/SpinBox.xml
msgid "Single texture representing both the up and down buttons icons. It is displayed in the middle of the buttons and does not change upon interaction. If a valid icon is assigned, it will replace [theme_item up] and [theme_item down]."
msgstr "A fel- és lefelé mutató gombok ikonjait egyetlen textúrával ábrázolja. A gombok közepén jelenik meg, és használat közben nem változik. Ha érvényes ikont rendelsz hozzá, az felülírja a [theme_item up] és a [theme_item down] ikonokat."


#. SpinBox.down_background
#: doc/classes/SpinBox.xml
msgid "Background style of the down button."
msgstr "A lefelé mutató gomb háttérstílusa."


#. SpinBox.down_background_disabled
#: doc/classes/SpinBox.xml
msgid "Background style of the down button when disabled."
msgstr "A lefelé mutató gomb háttérstílusa letiltott állapotban."


#. SpinBox.down_background_hovered
#: doc/classes/SpinBox.xml
msgid "Background style of the down button when hovered."
msgstr "A lefelé mutató gomb háttérstílusa, amikor az egérmutató fölötte van."


#. SpinBox.down_background_pressed
#: doc/classes/SpinBox.xml
msgid "Background style of the down button when being pressed."
msgstr "A lefelé mutató gomb háttérstílusa lenyomott állapotban."


#. SpinBox.field_and_buttons_separator
#: doc/classes/SpinBox.xml
msgid "[StyleBox] drawn in the space occupied by the separation between the input field and the buttons."
msgstr "A beviteli mező és a gombok közötti elválasztó helyén kirajzolt [StyleBox]."


#. SpinBox.up_background
#: doc/classes/SpinBox.xml
msgid "Background style of the up button."
msgstr "A felfelé mutató gomb háttérstílusa."


#. SpinBox.up_background_disabled
#: doc/classes/SpinBox.xml
msgid "Background style of the up button when disabled."
msgstr "A felfelé mutató gomb háttérstílusa letiltott állapotban."


#. SpinBox.up_background_hovered
#: doc/classes/SpinBox.xml
msgid "Background style of the up button when hovered."
msgstr "A felfelé mutató gomb háttérstílusa, amikor az egérmutató fölötte van."


#. SpinBox.up_background_pressed
#: doc/classes/SpinBox.xml
msgid "Background style of the up button when being pressed."
msgstr "A felfelé mutató gomb háttérstílusa lenyomott állapotban."


#. SpinBox.up_down_buttons_separator
#: doc/classes/SpinBox.xml
msgid "[StyleBox] drawn in the space occupied by the separation between the up and down buttons."
msgstr "A fel- és lefelé mutató gombok közötti elválasztó helyén kirajzolt [StyleBox]."

#. MenuButton.brief
#: doc/classes/MenuButton.xml
msgid "A button that brings up a [PopupMenu] when clicked."
msgstr "Kattintásra [PopupMenu] menüt megnyitó gomb."


#. MenuButton.description
#: doc/classes/MenuButton.xml
msgid "A button that brings up a [PopupMenu] when clicked. To create new items inside this [PopupMenu], use [code]get_popup().add_item(\"My Item Name\")[/code]. You can also create them directly from Godot editor's inspector.\nSee also [BaseButton] which contains common properties and methods associated with this node."
msgstr "Kattintásra [PopupMenu] menüt megnyitó gomb. Az ehhez a [PopupMenu] menühöz új menüpontokat például a [code]get_popup().add_item(\"My Item Name\")[/code] hívással adhatsz hozzá. A menüpontokat közvetlenül a Godot szerkesztő felügyelőjében is létrehozhatod.\nLásd még a [BaseButton] osztályt, amely a csomópont közös tulajdonságait és metódusait tartalmazza."


#. MenuButton.show_popup
#: doc/classes/MenuButton.xml
msgid "Adjusts popup position and sizing for the [MenuButton], then shows the [PopupMenu]. Prefer this over using [code]get_popup().popup()[/code]."
msgstr "Az előugró menü helyzetét és méretét a [MenuButton] gombhoz igazítja, majd megjeleníti a [PopupMenu] menüt. Ezt érdemes használni a [code]get_popup().popup()[/code] közvetlen meghívása helyett."


#. MenuButton.switch_on_hover
#: doc/classes/MenuButton.xml
msgid "If [code]true[/code], when the cursor hovers above another [MenuButton] within the same parent which also has [member switch_on_hover] enabled, it will close the current [MenuButton] and open the other one."
msgstr "Ha [code]true[/code], amikor az egérmutató egy ugyanahhoz a szülőhöz tartozó másik [MenuButton] fölé kerül, amelynél a [member switch_on_hover] szintén engedélyezett, az aktuális [MenuButton] menü bezárul, és a másik nyílik meg."


#. MenuButton.about_to_popup
#: doc/classes/MenuButton.xml
msgid "Emitted when the [PopupMenu] of this MenuButton is about to show."
msgstr "Akkor bocsátódik ki, amikor a MenuButton [PopupMenu] menüje éppen megjelenni készül."

#. VSlider.brief
#: doc/classes/VSlider.xml
msgid "A vertical slider that goes from bottom (min) to top (max)."
msgstr "Függőleges csúszka, amely alulról (minimum) felfelé (maximum) halad."


#. VSlider.description
#: doc/classes/VSlider.xml
msgid "A vertical slider, used to adjust a value by moving a grabber along a vertical axis. It is a [Range]-based control and goes from bottom (min) to top (max). Note that this direction is the opposite of [VScrollBar]'s."
msgstr "Függőleges csúszka, amellyel a fogantyú függőleges tengely mentén mozgatásával állítható be egy érték. A [Range] osztályon alapul, és alulról (minimum) felfelé (maximum) halad. Fontos, hogy ez az irány ellentétes a [VScrollBar] működésével."


#. HScrollBar.brief
#: doc/classes/HScrollBar.xml
msgid "A horizontal scrollbar that goes from left (min) to right (max)."
msgstr "Vízszintes görgetősáv, amely balról (minimum) jobbra (maximum) halad."


#. HScrollBar.description
#: doc/classes/HScrollBar.xml
msgid "A horizontal scrollbar, typically used to navigate through content that extends beyond the visible width of a control. It is a [Range]-based control and goes from left (min) to right (max)."
msgstr "Vízszintes görgetősáv, amelyet általában a vezérlőelem látható szélességén túlnyúló tartalom böngészésére használnak. A [Range] osztályon alapul, és balról (minimum) jobbra (maximum) halad."


#. HScrollBar.padding_bottom
#: doc/classes/HScrollBar.xml
msgid "Padding between the bottom of the [theme_item ScrollBar.scroll] element and the [theme_item ScrollBar.grabber].\n[b]Note:[/b] To apply horizontal padding, modify the left/right content margins of [theme_item ScrollBar.scroll] instead."
msgstr "A [theme_item ScrollBar.scroll] elem alja és a [theme_item ScrollBar.grabber] közötti belső térköz.\n[b]Megjegyzés:[/b] A vízszintes belső térköz beállításához inkább a [theme_item ScrollBar.scroll] tartalmának bal/jobb margóját módosítsd."


#. HScrollBar.padding_top
#: doc/classes/HScrollBar.xml
msgid "Padding between the top of the [theme_item ScrollBar.scroll] element and the [theme_item ScrollBar.grabber].\n[b]Note:[/b] To apply horizontal padding, modify the left/right content margins of [theme_item ScrollBar.scroll] instead."
msgstr "A [theme_item ScrollBar.scroll] elem teteje és a [theme_item ScrollBar.grabber] közötti belső térköz.\n[b]Megjegyzés:[/b] A vízszintes belső térköz beállításához inkább a [theme_item ScrollBar.scroll] tartalmának bal/jobb margóját módosítsd."


#. VScrollBar.brief
#: doc/classes/VScrollBar.xml
msgid "A vertical scrollbar that goes from top (min) to bottom (max)."
msgstr "Függőleges görgetősáv, amely felülről (minimum) lefelé (maximum) halad."


#. VScrollBar.description
#: doc/classes/VScrollBar.xml
msgid "A vertical scrollbar, typically used to navigate through content that extends beyond the visible height of a control. It is a [Range]-based control and goes from top (min) to bottom (max). Note that this direction is the opposite of [VSlider]'s."
msgstr "Függőleges görgetősáv, amellyel általában a vezérlőelem látható magasságán túlnyúló tartalmat lehet böngészni. A [Range] osztályon alapul, és felülről (minimum) lefelé (maximum) halad. Az irány a [VSlider] működésével ellentétes."


#. VScrollBar.padding_left
#: doc/classes/VScrollBar.xml
msgid "Padding between the left of the [theme_item ScrollBar.scroll] element and the [theme_item ScrollBar.grabber].\n[b]Note:[/b] To apply vertical padding, modify the top/bottom content margins of [theme_item ScrollBar.scroll] instead."
msgstr "A [theme_item ScrollBar.scroll] elem bal széle és a [theme_item ScrollBar.grabber] közötti belső térköz.\n[b]Megjegyzés:[/b] A függőleges belső térköz beállításához inkább a [theme_item ScrollBar.scroll] tartalmának felső/alsó margóját módosítsd."


#. VScrollBar.padding_right
#: doc/classes/VScrollBar.xml
msgid "Padding between the right of the [theme_item ScrollBar.scroll] element and the [theme_item ScrollBar.grabber].\n[b]Note:[/b] To apply vertical padding, modify the top/bottom content margins of [theme_item ScrollBar.scroll] instead."
msgstr "A [theme_item ScrollBar.scroll] elem jobb széle és a [theme_item ScrollBar.grabber] közötti belső térköz.\n[b]Megjegyzés:[/b] A függőleges belső térköz beállításához inkább a [theme_item ScrollBar.scroll] tartalmának felső/alsó margóját módosítsd."


#. ScrollBar.brief
#: doc/classes/ScrollBar.xml
msgid "Abstract base class for scrollbars."
msgstr "A görgetősávok absztrakt alaposztálya."


#. ScrollBar.description
#: doc/classes/ScrollBar.xml
msgid "Abstract base class for scrollbars, typically used to navigate through content that extends beyond the visible area of a control. Scrollbars are [Range]-based controls."
msgstr "A görgetősávok absztrakt alaposztálya. A görgetősávok általában a vezérlőelem látható területén túlnyúló tartalomban való navigálásra szolgálnak, és a [Range] osztályon alapulnak."


#. ScrollBar.custom_step
#: doc/classes/ScrollBar.xml
msgid "Overrides the step used when clicking increment and decrement buttons or when using arrow keys when the [ScrollBar] is focused."
msgstr "Felülírja a lépésközt, amelyet a növelő és csökkentő gombokra kattintáskor vagy a fókuszban lévő [ScrollBar] nyílbillentyűkkel történő vezérlésekor használ a rendszer."


#. ScrollBar.scrolling
#: doc/classes/ScrollBar.xml
msgid "Emitted when the scrollbar is being scrolled."
msgstr "Akkor bocsátódik ki, amikor a görgetősávot görgetik."


#. ScrollBar.decrement
#: doc/classes/ScrollBar.xml
msgid "Icon used as a button to scroll the [ScrollBar] left/up. Supports custom step using the [member ScrollBar.custom_step] property."
msgstr "A [ScrollBar] balra/felfelé görgetésére szolgáló gomb ikonja. Egyéni lépésköz a [member ScrollBar.custom_step] tulajdonsággal állítható be."


#. ScrollBar.decrement_highlight
#: doc/classes/ScrollBar.xml
msgid "Displayed when the mouse cursor hovers over the decrement button."
msgstr "Akkor jelenik meg, amikor az egérmutató a csökkentő gomb fölött van."


#. ScrollBar.decrement_pressed
#: doc/classes/ScrollBar.xml
msgid "Displayed when the decrement button is being pressed."
msgstr "A csökkentő gomb lenyomásakor jelenik meg."


#. ScrollBar.increment
#: doc/classes/ScrollBar.xml
msgid "Icon used as a button to scroll the [ScrollBar] right/down. Supports custom step using the [member ScrollBar.custom_step] property."
msgstr "A [ScrollBar] jobbra/lefelé görgetésére szolgáló gomb ikonja. Egyéni lépésköz a [member ScrollBar.custom_step] tulajdonsággal állítható be."


#. ScrollBar.increment_highlight
#: doc/classes/ScrollBar.xml
msgid "Displayed when the mouse cursor hovers over the increment button."
msgstr "Akkor jelenik meg, amikor az egérmutató a növelő gomb fölött van."


#. ScrollBar.increment_pressed
#: doc/classes/ScrollBar.xml
msgid "Displayed when the increment button is being pressed."
msgstr "A növelő gomb lenyomásakor jelenik meg."


#. ScrollBar.grabber
#: doc/classes/ScrollBar.xml
msgid "Used as texture for the grabber, the draggable element representing current scroll."
msgstr "A görgetés aktuális pozícióját jelző, húzható fogantyú textúrája."


#. ScrollBar.grabber_highlight
#: doc/classes/ScrollBar.xml
msgid "Used when the mouse hovers over the grabber."
msgstr "Akkor használatos, amikor az egérmutató a fogantyú fölött van."


#. ScrollBar.grabber_pressed
#: doc/classes/ScrollBar.xml
msgid "Used when the grabber is being dragged."
msgstr "A fogantyú húzása közben használatos."


#. ScrollBar.scroll
#: doc/classes/ScrollBar.xml
msgid "Used as background of this [ScrollBar]."
msgstr "A [ScrollBar] háttérképeként használatos."


#. ScrollBar.scroll_focus
#: doc/classes/ScrollBar.xml
msgid "Used as background when the [ScrollBar] has the GUI focus."
msgstr "Háttérként használatos, amikor a [ScrollBar] vezérlőelem GUI-fókuszban van."

#. LinkButton.brief
#: doc/classes/LinkButton.xml
msgid "A button that represents a link."
msgstr "Hivatkozást megjelenítő gomb."


#. LinkButton.description
#: doc/classes/LinkButton.xml
msgid "A button that represents a link. This type of button is primarily used for interactions that cause a context change (like linking to a web page).\nSee also [BaseButton] which contains common properties and methods associated with this node."
msgstr "Hivatkozást megjelenítő gomb. Ez a gombtípus elsősorban olyan műveletekhez használatos, amelyek környezetváltást okoznak (például egy weboldal megnyitásához).\nLásd még a [BaseButton] osztályt, amely a csomópont közös tulajdonságait és metódusait tartalmazza."


#. LinkButton.text
#: doc/classes/LinkButton.xml
msgid "The button's text that will be displayed inside the button's area."
msgstr "A gomb területén megjelenő felirat."


#. LinkButton.text_overrun_behavior
#: doc/classes/LinkButton.xml
msgid "Sets the clipping behavior when the text exceeds the node's bounding rectangle."
msgstr "Beállítja a szöveg levágásának módját, ha a szöveg túlnyúlik a csomópont határoló téglalapján."


#. LinkButton.underline
#: doc/classes/LinkButton.xml
msgid "The underline mode to use for the text."
msgstr "A szöveg aláhúzásának módja."


#. LinkButton.uri
#: doc/classes/LinkButton.xml
msgid "The [url=https://en.wikipedia.org/wiki/Uniform_Resource_Identifier]URI[/url] for this [LinkButton]. If set to a valid URI, pressing the button opens the URI using the operating system's default program for the protocol (via [method OS.shell_open]). HTTP and HTTPS URLs open the default web browser.\n[codeblocks]\n[gdscript]\nuri = \"https://godotengine.org\"  # Opens the URL in the default web browser.\nuri = \"C:\\SomeFolder\"  # Opens the file explorer at the given path.\nuri = \"C:\\SomeImage.png\"  # Opens the given image in the default viewing app.\n[/gdscript]\n[csharp]\nUri = \"https://godotengine.org\"; // Opens the URL in the default web browser.\nUri = \"C:\\SomeFolder\"; // Opens the file explorer at the given path.\nUri = \"C:\\SomeImage.png\"; // Opens the given image in the default viewing app.\n[/csharp]\n[/codeblocks]"
msgstr "Ehhez a [LinkButton] gombhoz tartozó [url=https://en.wikipedia.org/wiki/Uniform_Resource_Identifier]URI[/url]. Ha érvényes URI-t adsz meg, a gomb megnyomásakor az operációs rendszer az adott protokollhoz társított alapértelmezett programmal nyitja meg a címet (a [method OS.shell_open] segítségével). A HTTP- és HTTPS-címek az alapértelmezett webböngészőben nyílnak meg.\n[codeblocks]\n[gdscript]\nuri = \"https://godotengine.org\"  # Opens the URL in the default web browser.\nuri = \"C:\\SomeFolder\"  # Opens the file explorer at the given path.\nuri = \"C:\\SomeImage.png\"  # Opens the given image in the default viewing app.\n[/gdscript]\n[csharp]\nUri = \"https://godotengine.org\"; // Opens the URL in the default web browser.\nUri = \"C:\\SomeFolder\"; // Opens the file explorer at the given path.\nUri = \"C:\\SomeImage.png\"; // Opens the given image in the default viewing app.\n[/csharp]\n[/codeblocks]"


#. LinkButton.UNDERLINE_MODE_ALWAYS
#: doc/classes/LinkButton.xml
msgid "The LinkButton will always show an underline at the bottom of its text."
msgstr "A LinkButton szövege mindig aláhúzva jelenik meg."


#. LinkButton.UNDERLINE_MODE_ON_HOVER
#: doc/classes/LinkButton.xml
msgid "The LinkButton will show an underline at the bottom of its text when the mouse cursor is over it."
msgstr "A LinkButton szövege akkor jelenik meg aláhúzva, amikor az egérmutató fölötte van."


#. LinkButton.UNDERLINE_MODE_NEVER
#: doc/classes/LinkButton.xml
msgid "The LinkButton will never show an underline at the bottom of its text."
msgstr "A LinkButton szövege soha nem jelenik meg aláhúzva."


#. LinkButton.font_color
#: doc/classes/LinkButton.xml
msgid "Default text [Color] of the [LinkButton]."
msgstr "A [LinkButton] szövegének alapértelmezett [Color] színe."


#. LinkButton.font_disabled_color
#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is disabled."
msgstr "A letiltott [LinkButton] szövegének [Color] színe."


#. LinkButton.font_focus_color
#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is focused. Only replaces the normal text color of the button. Disabled, hovered, and pressed states take precedence over this color."
msgstr "A fókuszban lévő [LinkButton] szövegének [Color] színe. Csak a gomb normál betűszínét írja felül; a letiltott, egérmutató alatti és lenyomott állapot színei elsőbbséget élveznek."


#. LinkButton.font_hover_color
#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is being hovered."
msgstr "A [LinkButton] szövegének [Color] színe, amikor az egérmutató fölötte van."


#. LinkButton.font_hover_pressed_color
#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is being hovered and pressed."
msgstr "A [LinkButton] szövegének [Color] színe, amikor az egérmutató fölötte van, és a gomb le van nyomva."


#. LinkButton.font_outline_color
#: doc/classes/LinkButton.xml
msgid "The tint of text outline of the [LinkButton]."
msgstr "A [LinkButton] szövegkörvonalának színezése."


#. LinkButton.font_pressed_color
#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is being pressed."
msgstr "A [LinkButton] szövegének [Color] színe lenyomott állapotban."


#. LinkButton.underline_spacing
#: doc/classes/LinkButton.xml
msgid "The vertical space between the baseline of text and the underline."
msgstr "A szöveg alapvonala és az aláhúzás közötti függőleges térköz."


#. LinkButton.font
#: doc/classes/LinkButton.xml
msgid "[Font] of the [LinkButton]'s text."
msgstr "A [LinkButton] szövegéhez használt [Font] betűkészlet."


#. LinkButton.font_size
#: doc/classes/LinkButton.xml
msgid "Font size of the [LinkButton]'s text."
msgstr "A [LinkButton] szövegének betűmérete."


#. LinkButton.focus
#: doc/classes/LinkButton.xml
msgid "[StyleBox] used when the [LinkButton] is focused. The [theme_item focus] [StyleBox] is displayed [i]over[/i] the base [StyleBox], so a partially transparent [StyleBox] should be used to ensure the base [StyleBox] remains visible. A [StyleBox] that represents an outline or an underline works well for this purpose. To disable the focus visual effect, assign a [StyleBoxEmpty] resource. Note that disabling the focus visual effect will harm keyboard/controller navigation usability, so this is not recommended for accessibility reasons."
msgstr "A fókuszban lévő [LinkButton] megjelenítéséhez használt [StyleBox]. A [theme_item focus] [StyleBox] az alapul szolgáló [StyleBox] [i]fölött[/i] jelenik meg, ezért részben átlátszó [StyleBox] használata javasolt, hogy az alatta lévő [StyleBox] is látható maradjon. Erre például egy körvonalat vagy aláhúzást ábrázoló [StyleBox] megfelelő. A fókusz vizuális jelzésének kikapcsolásához rendelj hozzá [StyleBoxEmpty] erőforrást. Ez azonban megnehezíti a billentyűzettel és kontrollerrel történő navigációt, ezért akadálymentességi szempontból nem ajánlott."

#. LineEdit.MENU_CUT
#: doc/classes/LineEdit.xml
msgid "Cuts (copies and clears) the selected text."
msgstr "Kivágja a kijelölt szöveget (a vágólapra másolja, majd törli)."


#. LineEdit.MENU_COPY
#: doc/classes/LineEdit.xml
msgid "Copies the selected text."
msgstr "A vágólapra másolja a kijelölt szöveget."


#. LineEdit.MENU_PASTE
#: doc/classes/LineEdit.xml
msgid "Pastes the clipboard text over the selected text (or at the caret's position).\nNon-printable escape characters are automatically stripped from the OS clipboard via [method String.strip_escapes]."
msgstr "A vágólap szövegét beilleszti a kijelölt szöveg helyére (vagy a szövegkurzor pozíciójára).\nAz operációs rendszer vágólapjáról származó nem nyomtatható vezérlőkaraktereket automatikusan eltávolítja a [method String.strip_escapes] metódussal."


#. LineEdit.MENU_CLEAR
#: doc/classes/LineEdit.xml
msgid "Erases the whole [LineEdit] text."
msgstr "Törli a [LineEdit] teljes szövegét."


#. LineEdit.MENU_SELECT_ALL
#: doc/classes/LineEdit.xml
msgid "Selects the whole [LineEdit] text."
msgstr "Kijelöli a [LineEdit] teljes szövegét."


#. LineEdit.MENU_UNDO
#: doc/classes/LineEdit.xml
msgid "Undoes the previous action."
msgstr "Visszavonja az előző műveletet."


#. LineEdit.MENU_REDO
#: doc/classes/LineEdit.xml
msgid "Reverse the last undo action."
msgstr "Újra végrehajtja a legutóbb visszavont műveletet."


#. LineEdit.MENU_SUBMENU_TEXT_DIR
#: doc/classes/LineEdit.xml
msgid "ID of \"Text Writing Direction\" submenu."
msgstr "A „Szöveg írásiránya” almenü azonosítója."


#. LineEdit.MENU_DIR_INHERITED
#: doc/classes/LineEdit.xml
msgid "Sets text direction to inherited."
msgstr "Az írásirányt az örökölt beállításra állítja."


#. LineEdit.MENU_DIR_AUTO
#: doc/classes/LineEdit.xml
msgid "Sets text direction to automatic."
msgstr "Automatikusra állítja a szöveg írásirányát."


#. LineEdit.MENU_DIR_LTR
#: doc/classes/LineEdit.xml
msgid "Sets text direction to left-to-right."
msgstr "Balról jobbra haladó szövegirányt állít be."


#. LineEdit.MENU_DIR_RTL
#: doc/classes/LineEdit.xml
msgid "Sets text direction to right-to-left."
msgstr "Jobbról balra haladó szövegirányt állít be."


#. LineEdit.MENU_DISPLAY_UCC
#: doc/classes/LineEdit.xml
msgid "Toggles control character display."
msgstr "Be- vagy kikapcsolja a vezérlőkarakterek megjelenítését."


#. LineEdit.MENU_SUBMENU_INSERT_UCC
#: doc/classes/LineEdit.xml
msgid "ID of \"Insert Control Character\" submenu."
msgstr "A „Vezérlőkarakter beszúrása” almenü azonosítója."


#. LineEdit.MENU_INSERT_LRM
#: doc/classes/LineEdit.xml
msgid "Inserts left-to-right mark (LRM) character."
msgstr "Balról jobbra haladó szövegirányt jelölő (LRM) karaktert szúr be."


#. LineEdit.MENU_INSERT_RLM
#: doc/classes/LineEdit.xml
msgid "Inserts right-to-left mark (RLM) character."
msgstr "Jobbról balra haladó szövegirányt jelölő (RLM) karaktert szúr be."


#. LineEdit.MENU_INSERT_LRE
#: doc/classes/LineEdit.xml
msgid "Inserts start of left-to-right embedding (LRE) character."
msgstr "Balról jobbra irányú beágyazást kezdő (LRE) karaktert szúr be."


#. LineEdit.MENU_INSERT_RLE
#: doc/classes/LineEdit.xml
msgid "Inserts start of right-to-left embedding (RLE) character."
msgstr "Jobbról balra irányú beágyazást kezdő (RLE) karaktert szúr be."


#. LineEdit.MENU_INSERT_LRO
#: doc/classes/LineEdit.xml
msgid "Inserts start of left-to-right override (LRO) character."
msgstr "Balról jobbra írásirány-felülbíráló (LRO) karaktert szúr be."


#. LineEdit.MENU_INSERT_RLO
#: doc/classes/LineEdit.xml
msgid "Inserts start of right-to-left override (RLO) character."
msgstr "Jobbról balra írásirány-felülbíráló (RLO) karaktert szúr be."


#. LineEdit.MENU_INSERT_PDF
#: doc/classes/LineEdit.xml
msgid "Inserts pop direction formatting (PDF) character."
msgstr "Az irányformázást lezáró (PDF) karaktert szúr be."


#. LineEdit.MENU_INSERT_ALM
#: doc/classes/LineEdit.xml
msgid "Inserts Arabic letter mark (ALM) character."
msgstr "Arab betűjelölő (ALM) karaktert szúr be."


#. LineEdit.MENU_INSERT_LRI
#: doc/classes/LineEdit.xml
msgid "Inserts left-to-right isolate (LRI) character."
msgstr "Balról jobbra irányú elkülönítést kezdő (LRI) karaktert szúr be."


#. LineEdit.MENU_INSERT_RLI
#: doc/classes/LineEdit.xml
msgid "Inserts right-to-left isolate (RLI) character."
msgstr "Jobbról balra irányú elkülönítést kezdő (RLI) karaktert szúr be."


#. LineEdit.MENU_INSERT_FSI
#: doc/classes/LineEdit.xml
msgid "Inserts first strong isolate (FSI) character."
msgstr "Az első erős karakter iránya szerinti elkülönítőt (FSI) szúr be."


#. LineEdit.MENU_INSERT_PDI
#: doc/classes/LineEdit.xml
msgid "Inserts pop direction isolate (PDI) character."
msgstr "Az irány szerinti elkülönítést lezáró (PDI) karaktert szúr be."


#. LineEdit.MENU_INSERT_ZWJ
#: doc/classes/LineEdit.xml
msgid "Inserts zero width joiner (ZWJ) character."
msgstr "Nulla szélességű összekötő (ZWJ) karaktert szúr be."


#. LineEdit.MENU_INSERT_ZWNJ
#: doc/classes/LineEdit.xml
msgid "Inserts zero width non-joiner (ZWNJ) character."
msgstr "Nulla szélességű, nem összekötő (ZWNJ) karaktert szúr be."


#. LineEdit.MENU_INSERT_WJ
#: doc/classes/LineEdit.xml
msgid "Inserts word joiner (WJ) character."
msgstr "Szóösszekötő (WJ) karaktert szúr be."


#. LineEdit.MENU_INSERT_SHY
#: doc/classes/LineEdit.xml
msgid "Inserts soft hyphen (SHY) character."
msgstr "Feltételes elválasztójelet (SHY) szúr be."


#. LineEdit.MENU_EMOJI_AND_SYMBOL
#: doc/classes/LineEdit.xml
msgid "Opens system emoji and symbol picker."
msgstr "Megnyitja a rendszer emodzsi- és szimbólumválasztóját."


#. LineEdit.MENU_MAX
#: doc/classes/LineEdit.xml
msgid "Represents the size of the [enum MenuItems] enum."
msgstr "A [enum MenuItems] felsorolás méretét jelöli."


#. LineEdit.KEYBOARD_TYPE_DEFAULT
#: doc/classes/LineEdit.xml
msgid "Default text virtual keyboard."
msgstr "Alapértelmezett szövegbeviteli virtuális billentyűzet."


#. LineEdit.KEYBOARD_TYPE_MULTILINE
#: doc/classes/LineEdit.xml
msgid "Multiline virtual keyboard."
msgstr "Többsoros virtuális billentyűzet."


#. LineEdit.KEYBOARD_TYPE_NUMBER
#: doc/classes/LineEdit.xml
msgid "Virtual number keypad, useful for PIN entry."
msgstr "Virtuális számbillentyűzet, például PIN-kód beviteléhez."


#. LineEdit.KEYBOARD_TYPE_NUMBER_DECIMAL
#: doc/classes/LineEdit.xml
msgid "Virtual number keypad, useful for entering fractional numbers."
msgstr "Virtuális számbillentyűzet törtszámok beviteléhez."


#. LineEdit.KEYBOARD_TYPE_PHONE
#: doc/classes/LineEdit.xml
msgid "Virtual phone number keypad."
msgstr "Virtuális billentyűzet telefonszámok beviteléhez."


#. LineEdit.KEYBOARD_TYPE_EMAIL_ADDRESS
#: doc/classes/LineEdit.xml
msgid "Virtual keyboard with additional keys to assist with typing email addresses."
msgstr "Virtuális billentyűzet további billentyűkkel az e-mail-címek beírásához."


#. LineEdit.KEYBOARD_TYPE_PASSWORD
#: doc/classes/LineEdit.xml
msgid "Virtual keyboard for entering a password. On most platforms, this should disable autocomplete and autocapitalization.\n[b]Note:[/b] This is not supported on Web. Instead, this behaves identically to [constant KEYBOARD_TYPE_DEFAULT]."
msgstr "Jelszóbevitelre szolgáló virtuális billentyűzet. A legtöbb platformon letiltja az automatikus kiegészítést és a nagybetűsítést.\n[b]Megjegyzés:[/b] Webes környezetben ez nem támogatott. Ilyenkor a [constant KEYBOARD_TYPE_DEFAULT] értékkel azonosan viselkedik."


#. LineEdit.KEYBOARD_TYPE_URL
#: doc/classes/LineEdit.xml
msgid "Virtual keyboard with additional keys to assist with typing URLs."
msgstr "Virtuális billentyűzet további billentyűkkel az URL-címek beírásához."


#. LineEdit.EXPAND_MODE_ORIGINAL_SIZE
#: doc/classes/LineEdit.xml
msgid "Use the original size for the right icon."
msgstr "A jobb oldali ikon eredeti méretét használja."


#. LineEdit.EXPAND_MODE_FIT_TO_TEXT
#: doc/classes/LineEdit.xml
msgid "Scale the right icon's size to match the size of the text."
msgstr "A jobb oldali ikon méretét a szöveg méretéhez igazítja."


#. LineEdit.EXPAND_MODE_FIT_TO_LINE_EDIT
#: doc/classes/LineEdit.xml
msgid "Scale the right icon to fit the LineEdit."
msgstr "A jobb oldali ikont a LineEdit méretéhez igazítja."


#. LineEdit.caret_color
#: doc/classes/LineEdit.xml
msgid "Color of the [LineEdit]'s caret (text cursor). This can be set to a fully transparent color to hide the caret entirely."
msgstr "A [LineEdit] szövegkurzorának színe. Teljesen átlátszó szín megadásával a kurzor teljesen elrejthető."


#. LineEdit.clear_button_color
#: doc/classes/LineEdit.xml
msgid "Color used as default tint for the clear button."
msgstr "A törlőgomb alapértelmezett színezésének színe."


#. LineEdit.clear_button_color_pressed
#: doc/classes/LineEdit.xml
msgid "Color used for the clear button when it's pressed."
msgstr "A törlőgomb színe lenyomott állapotban."


#. LineEdit.font_color
#: doc/classes/LineEdit.xml
msgid "Default font color."
msgstr "A betűkészlet alapértelmezett színe."


#. LineEdit.font_outline_color
#: doc/classes/LineEdit.xml
msgid "The tint of text outline of the [LineEdit]."
msgstr "A [LineEdit] szövegkörvonalának színezése."


#. LineEdit.font_placeholder_color
#: doc/classes/LineEdit.xml
msgid "Font color for [member placeholder_text]."
msgstr "A [member placeholder_text] helyőrző szöveg betűszíne."


#. LineEdit.font_selected_color
#: doc/classes/LineEdit.xml
msgid "Font color for selected text (inside the selection rectangle)."
msgstr "A kijelölt szöveg betűszíne (a kijelölési téglalapon belül)."


#. LineEdit.font_uneditable_color
#: doc/classes/LineEdit.xml
msgid "Font color when editing is disabled."
msgstr "A szöveg betűszíne, amikor a szerkesztés le van tiltva."


#. LineEdit.selection_color
#: doc/classes/LineEdit.xml
msgid "Color of the selection rectangle."
msgstr "A kijelölési téglalap színe."


#. LineEdit.caret_width
#: doc/classes/LineEdit.xml
msgid "The caret's width in pixels. Greater values can be used to improve accessibility by ensuring the caret is easily visible, or to ensure consistency with a large font size."
msgstr "A szövegkurzor szélessége képpontban. Nagyobb értékkel javítható az akadálymentesség és a kurzor láthatósága, illetve igazítható a nagyobb betűmérethez."


#. LineEdit.minimum_character_width
#: doc/classes/LineEdit.xml
msgid "Minimum horizontal space for the text (not counting the clear button and content margins). This value is measured in count of 'M' characters (i.e. this number of 'M' characters can be displayed without scrolling)."
msgstr "A szöveg minimális vízszintes helyigénye (a törlőgomb és a belső margók nélkül). Az értéket „M” betűk számában méri (ennyi „M” betű látható görgetés nélkül)."


#. LineEdit.font
#: doc/classes/LineEdit.xml
msgid "Font used for the text."
msgstr "A szöveghez használt betűkészlet."


#. LineEdit.font_size
#: doc/classes/LineEdit.xml
msgid "Font size of the [LineEdit]'s text."
msgstr "A [LineEdit] szövegének betűmérete."


#. LineEdit.clear
#: doc/classes/LineEdit.xml
msgid "Texture for the clear button. See [member clear_button_enabled]."
msgstr "A törlőgomb textúrája. Lásd a [member clear_button_enabled] tulajdonságot."


#. LineEdit.focus
#: doc/classes/LineEdit.xml
msgid "Background used when [LineEdit] has GUI focus. The [theme_item focus] [StyleBox] is displayed [i]over[/i] the base [StyleBox], so a partially transparent [StyleBox] should be used to ensure the base [StyleBox] remains visible. A [StyleBox] that represents an outline or an underline works well for this purpose. To disable the focus visual effect, assign a [StyleBoxEmpty] resource. Note that disabling the focus visual effect will harm keyboard/controller navigation usability, so this is not recommended for accessibility reasons."
msgstr "A fókuszban lévő [LineEdit] háttere. A [theme_item focus] [StyleBox] az alap [StyleBox] [i]fölött[/i] jelenik meg, ezért részben átlátszó [StyleBox] használata ajánlott, hogy az alap [StyleBox] is látható maradjon. Ehhez például körvonalat vagy aláhúzást megjelenítő [StyleBox] megfelelő. A fókusz vizuális jelzésének kikapcsolásához rendelj hozzá [StyleBoxEmpty] erőforrást. Ez azonban rontja a billentyűzettel vagy kontrollerrel történő navigálás használhatóságát, ezért akadálymentességi szempontból nem ajánlott."


#. LineEdit.normal
#: doc/classes/LineEdit.xml
msgid "Default background for the [LineEdit]."
msgstr "A [LineEdit] alapértelmezett háttere."


#. LineEdit.read_only
#: doc/classes/LineEdit.xml
msgid "Background used when [LineEdit] is in read-only mode ([member editable] is set to [code]false[/code])."
msgstr "A [LineEdit] háttere csak olvasható módban (amikor a [member editable] értéke [code]false[/code])."

#. LineEdit.alignment
#: doc/classes/LineEdit.xml
msgid "The text's horizontal alignment."
msgstr "A szöveg vízszintes igazítása."


#. LineEdit.backspace_deletes_composite_character_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code] and [member caret_mid_grapheme] is [code]false[/code], backspace deletes an entire composite character such as ❤️‍🩹, instead of deleting part of the composite character."
msgstr "Ha az érték [code]true[/code], és a [member caret_mid_grapheme] értéke [code]false[/code], a Backspace egy teljes összetett karaktert – például ❤️‍🩹 – töröl, nem csupán annak egy részét."


#. LineEdit.caret_blink
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], makes the caret blink."
msgstr "Ha az érték [code]true[/code], a szövegkurzor villog."


#. LineEdit.caret_blink_interval
#: doc/classes/LineEdit.xml
msgid "The interval at which the caret blinks (in seconds)."
msgstr "A szövegkurzor villogásának időköze másodpercben."


#. LineEdit.caret_column
#: doc/classes/LineEdit.xml
msgid "The caret's column position inside the [LineEdit]. When set, the text may scroll to accommodate it."
msgstr "A szövegkurzor oszloppozíciója a [LineEdit] mezőben. Módosításakor a szöveg elgördülhet, hogy a kurzor látható maradjon."


#. LineEdit.caret_force_displayed
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the [LineEdit] will always show the caret, even if not editing or focus is lost."
msgstr "Ha [code]true[/code], a [LineEdit] mindig megjeleníti a szövegkurzort, akkor is, ha nincs szerkesztés alatt, vagy elveszíti a fókuszt."


#. LineEdit.caret_mid_grapheme
#: doc/classes/LineEdit.xml
msgid "Allow moving caret, selecting and removing the individual composite character components.\n[b]Note:[/b] [kbd]Backspace[/kbd] is always removing individual composite character components."
msgstr "Lehetővé teszi, hogy a kurzor az összetett karakterek egyes összetevői közé mozogjon, és azokat külön kijelölhesd vagy törölhesd.\n[b]Megjegyzés:[/b] A [kbd]Backspace[/kbd] mindig az összetett karakterek egyes összetevőit törli."


#. LineEdit.clear_button_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the [LineEdit] will show a clear button if [member text] is not empty, which can be used to clear the text quickly."
msgstr "Ha [code]true[/code], a [LineEdit] törlőgombot jelenít meg, ha a [member text] nem üres. Ezzel gyorsan törölhető a teljes szöveg."


#. LineEdit.context_menu_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the context menu will appear when right-clicked."
msgstr "Ha [code]true[/code], jobb egérgombbal kattintva megjelenik a helyi menü."


#. LineEdit.deselect_on_focus_loss_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the selected text will be deselected when focus is lost."
msgstr "Ha az érték [code]true[/code], a fókusz elvesztésekor megszűnik a szöveg kijelölése."


#. LineEdit.drag_and_drop_selection_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], allow drag and drop of selected text."
msgstr "Ha [code]true[/code], lehetővé teszi a kijelölt szöveg fogd és vidd módszerrel történő áthelyezését."


#. LineEdit.draw_control_chars
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], control characters are displayed."
msgstr "Ha az érték [code]true[/code], a vezérlőkarakterek megjelennek."


#. LineEdit.editable
#: doc/classes/LineEdit.xml
msgid "If [code]false[/code], existing text cannot be modified and new text cannot be added."
msgstr "Ha az érték [code]false[/code], a meglévő szöveg nem módosítható, és új szöveg sem adható hozzá."


#. LineEdit.emoji_menu_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], \"Emoji and Symbols\" menu is enabled."
msgstr "Ha az érték [code]true[/code], engedélyezett az „Emojik és szimbólumok” menü."


#. LineEdit.expand_to_text_length
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the [LineEdit] width will increase to stay longer than the [member text]. It will [b]not[/b] compress if the [member text] is shortened."
msgstr "Ha [code]true[/code], a [LineEdit] szélessége növekszik, hogy meghaladja a [member text] hosszát. A [member text] rövidülésekor azonban [b]nem[/b] csökken a szélessége."


#. LineEdit.flat
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the [LineEdit] doesn't display decoration."
msgstr "Ha [code]true[/code], a [LineEdit] nem jelenít meg díszítő keretet."


#. LineEdit.icon_expand_mode
#: doc/classes/LineEdit.xml
msgid "Define the scaling behavior of the [member right_icon]."
msgstr "Meghatározza a [member right_icon] méretezésének módját."


#. LineEdit.keep_editing_on_text_submit
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the [LineEdit] will not exit edit mode when text is submitted by pressing [code]ui_text_submit[/code] action (by default: [kbd]Enter[/kbd] or [kbd]Kp Enter[/kbd])."
msgstr "Ha [code]true[/code], a [LineEdit] a [code]ui_text_submit[/code] művelettel (alapértelmezés szerint [kbd]Enter[/kbd] vagy [kbd]Kp Enter[/kbd]) beküldött szöveg után is szerkesztési módban marad."


#. LineEdit.max_length
#: doc/classes/LineEdit.xml
msgid "Maximum number of characters that can be entered inside the [LineEdit]. If [code]0[/code], there is no limit.\nWhen a limit is defined, characters that would exceed [member max_length] are truncated. This happens both for existing [member text] contents when setting the max length, or for new text inserted in the [LineEdit], including pasting.\nIf any input text is truncated, the [signal text_change_rejected] signal is emitted with the truncated substring as a parameter:\n[codeblocks]\n[gdscript]\ntext = \"Hello world\"\nmax_length = 5\n# `text` becomes \"Hello\".\nmax_length = 10\ntext += \" goodbye\"\n# `text` becomes \"Hello good\".\n# `text_change_rejected` is emitted with \"bye\" as a parameter.\n[/gdscript]\n[csharp]\nText = \"Hello world\";\nMaxLength = 5;\n// `Text` becomes \"Hello\".\nMaxLength = 10;\nText += \" goodbye\";\n// `Text` becomes \"Hello good\".\n// `text_change_rejected` is emitted with \"bye\" as a parameter.\n[/csharp]\n[/codeblocks]"
msgstr "A [LineEdit] mezőbe beírható karakterek maximális száma. Ha [code]0[/code], nincs korlátozás.\nHa van korlát, a [member max_length] értékét meghaladó karaktereket a rendszer levágja. Ez a már meglévő [member text] tartalomra is érvényes a korlát beállításakor, valamint a [LineEdit] mezőbe újonnan beillesztett szövegre is.\nHa bármely bevitt szöveg levágásra kerül, a [signal text_change_rejected] jel kibocsátódik, és paraméterként megkapja az elutasított szövegrészt:\n[codeblocks]\n[gdscript]\ntext = \"Hello world\"\nmax_length = 5\n# `text` becomes \"Hello\".\nmax_length = 10\ntext += \" goodbye\"\n# `text` becomes \"Hello good\".\n# `text_change_rejected` is emitted with \"bye\" as a parameter.\n[/gdscript]\n[csharp]\nText = \"Hello world\";\nMaxLength = 5;\n// `Text` becomes \"Hello\".\nMaxLength = 10;\nText += \" goodbye\";\n// `Text` becomes \"Hello good\".\n// `text_change_rejected` is emitted with \"bye\" as a parameter.\n[/csharp]\n[/codeblocks]"


#. LineEdit.middle_mouse_paste_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]false[/code], using middle mouse button to paste clipboard will be disabled.\n[b]Note:[/b] This method is only implemented on Linux."
msgstr "Ha az érték [code]false[/code], a középső egérgombbal történő beillesztés le van tiltva.\n[b]Megjegyzés:[/b] Ez a funkció csak Linuxon van megvalósítva."


#. LineEdit.placeholder_text
#: doc/classes/LineEdit.xml
msgid "Text shown when the [LineEdit] is empty. It is [b]not[/b] the [LineEdit]'s default value (see [member text])."
msgstr "Akkor megjelenő szöveg, amikor a [LineEdit] üres. Ez [b]nem[/b] a [LineEdit] alapértelmezett értéke (lásd: [member text])."


#. LineEdit.right_icon
#: doc/classes/LineEdit.xml
msgid "Sets the icon that will appear in the right end of the [LineEdit] if there's no [member text], or always, if [member clear_button_enabled] is set to [code]false[/code]."
msgstr "Beállítja a [LineEdit] jobb szélén megjelenő ikont, amikor nincs [member text] szöveg, vagy mindig megjeleníti, ha a [member clear_button_enabled] értéke [code]false[/code]."


#. LineEdit.right_icon_scale
#: doc/classes/LineEdit.xml
msgid "Scale ratio of the icon when [member icon_expand_mode] is set to [constant EXPAND_MODE_FIT_TO_LINE_EDIT]."
msgstr "Az ikon méretaránya, ha a [member icon_expand_mode] értéke [constant EXPAND_MODE_FIT_TO_LINE_EDIT]."


#. LineEdit.secret
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], every character is replaced with the secret character (see [member secret_character])."
msgstr "Ha [code]true[/code], minden karaktert a titkos karakterrel helyettesít (lásd: [member secret_character])."


#. LineEdit.secret_character
#: doc/classes/LineEdit.xml
msgid "The character to use to mask secret input. Only a single character can be used as the secret character. If it is longer than one character, only the first one will be used. If it is empty, a space will be used instead."
msgstr "A bizalmasan kezelt bevitel eltakarására használt karakter. Csak egyetlen karakter használható. Ha hosszabb szöveget adsz meg, annak csak az első karakterét veszi figyelembe. Ha üres, szóközt használ helyette."


#. LineEdit.select_all_on_focus
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the [LineEdit] will select the whole text when it gains focus."
msgstr "Ha [code]true[/code], a [LineEdit] fókuszba kerülésekor az egész szöveget kijelöli."


#. LineEdit.selecting_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]false[/code], it's impossible to select the text using mouse nor keyboard."
msgstr "Ha [code]false[/code], a szöveg sem egérrel, sem billentyűzettel nem jelölhető ki."


#. LineEdit.shortcut_keys_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], shortcut keys for context menu items are enabled, even if the context menu is disabled."
msgstr "Ha az érték [code]true[/code], a helyi menü parancsainak gyorsbillentyűi akkor is használhatók, ha maga a helyi menü le van tiltva."


#. LineEdit.text
#: doc/classes/LineEdit.xml
msgid "String value of the [LineEdit].\n[b]Note:[/b] Changing text using this property won't emit the [signal text_changed] signal."
msgstr "A [LineEdit] szöveges értéke.\n[b]Megjegyzés:[/b] A szöveg ezzel a tulajdonsággal történő módosítása nem bocsátja ki a [signal text_changed] jelet."


#. LineEdit.virtual_keyboard_enabled
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the native virtual keyboard is enabled on platforms that support it."
msgstr "Ha az érték [code]true[/code], az ezt támogató platformokon engedélyezi a rendszer virtuális billentyűzetét."


#. LineEdit.virtual_keyboard_show_on_focus
#: doc/classes/LineEdit.xml
msgid "If [code]true[/code], the native virtual keyboard is shown on focus events on platforms that support it."
msgstr "Ha az érték [code]true[/code], az ezt támogató platformokon a vezérlő fókuszba kerülésekor megjelenik a rendszer virtuális billentyűzete."


#. LineEdit.virtual_keyboard_type
#: doc/classes/LineEdit.xml
msgid "Specifies the type of virtual keyboard to show."
msgstr "Meghatározza a megjelenítendő virtuális billentyűzet típusát."


#. LineEdit.editing_toggled
#: doc/classes/LineEdit.xml
msgid "Emitted when the [LineEdit] switches in or out of edit mode."
msgstr "Akkor bocsátódik ki, amikor a [LineEdit] belép a szerkesztési módba, vagy kilép abból."


#. LineEdit.text_change_rejected
#: doc/classes/LineEdit.xml
msgid "Emitted when appending text that overflows the [member max_length]. The appended text is truncated to fit [member max_length], and the part that couldn't fit is passed as the [param rejected_substring] argument."
msgstr "Akkor bocsátódik ki, amikor a hozzáfűzött szöveg túllépné a [member max_length] korlátot. A hozzáadott szöveget a rendszer a [member max_length] korláthoz igazodva levágja, a kimaradó részt pedig a [param rejected_substring] argumentumban adja át."


#. LineEdit.text_changed
#: doc/classes/LineEdit.xml
msgid "Emitted when the text changes."
msgstr "Akkor bocsátódik ki, amikor a szöveg megváltozik."


#. LineEdit.text_submitted
#: doc/classes/LineEdit.xml
msgid "Emitted when the user presses the [code]ui_text_submit[/code] action (by default: [kbd]Enter[/kbd] or [kbd]Kp Enter[/kbd]) while the [LineEdit] has focus."
msgstr "Akkor bocsátódik ki, amikor a felhasználó a [code]ui_text_submit[/code] műveletet (alapértelmezés szerint [kbd]Enter[/kbd] vagy [kbd]Kp Enter[/kbd]) aktiválja, miközben a [LineEdit] fókuszban van."

#. LineEdit.brief
#: doc/classes/LineEdit.xml
msgid "An input field for single-line text."
msgstr "Egysoros szöveg beírására szolgáló mező."


#. LineEdit.description
#: doc/classes/LineEdit.xml
msgid "[LineEdit] provides an input field for editing a single line of text.\n- When the [LineEdit] control is focused using the keyboard arrow keys, it will only gain focus and not enter edit mode.\n- To enter edit mode, click on the control with the mouse, see also [member keep_editing_on_text_submit].\n- To exit edit mode, press [code]ui_text_submit[/code] or [code]ui_cancel[/code] (by default [kbd]Escape[/kbd]) actions.\n- Check [method edit], [method unedit], [method is_editing], and [signal editing_toggled] for more information.\nWhile entering text, it is possible to insert special characters using Unicode, OEM or Windows alt codes:\n- To enter Unicode codepoints, hold [kbd]Alt[/kbd] and type the codepoint on the numpad. For example, to enter the character [code]á[/code] (U+00E1), hold [kbd]Alt[/kbd] and type [kbd]+E1[/kbd] on the numpad (the leading zeroes can be omitted).\n- To enter OEM codepoints, hold [kbd]Alt[/kbd] and type the code on the numpad. For example, to enter the character [code]á[/code] (OEM 160), hold [kbd]Alt[/kbd] and type [code]160[/code] on the numpad.\n- To enter Windows codepoints, hold [kbd]Alt[/kbd] and type the code on the numpad. For example, to enter the character [code]á[/code] (Windows 0225), hold [kbd]Alt[/kbd] and type [kbd]0[/kbd], [kbd]2[/kbd], [kbd]2[/kbd], [kbd]5[/kbd] on the numpad. The leading zero here must [b]not[/b] be omitted, as this is how Windows codepoints are distinguished from OEM codepoints.\n[b]Important:[/b]\n- Focusing the [LineEdit] with [code]ui_focus_next[/code] (by default [kbd]Tab[/kbd]) or [code]ui_focus_prev[/code] (by default [kbd]Shift + Tab[/kbd]) or [method Control.grab_focus] still enters edit mode (for compatibility).\n[LineEdit] features many built-in shortcuts that are always available ([kbd]Ctrl[/kbd] here maps to [kbd]Cmd[/kbd] on macOS):\n- [kbd]Ctrl + C[/kbd]: Copy\n- [kbd]Ctrl + X[/kbd]: Cut\n- [kbd]Ctrl + V[/kbd] or [kbd]Ctrl + Y[/kbd]: Paste/\"yank\"\n- [kbd]Ctrl + Z[/kbd]: Undo\n- [kbd]Ctrl + ~[/kbd]: Swap input direction.\n- [kbd]Ctrl + Shift + Z[/kbd]: Redo\n- [kbd]Ctrl + U[/kbd]: Delete text from the caret position to the beginning of the line\n- [kbd]Ctrl + K[/kbd]: Delete text from the caret position to the end of the line\n- [kbd]Ctrl + A[/kbd]: Select all text\n- [kbd]Up Arrow[/kbd]/[kbd]Down Arrow[/kbd]: Move the caret to the beginning/end of the line\nOn macOS, some extra keyboard shortcuts are available:\n- [kbd]Cmd + F[/kbd]: Same as [kbd]Right Arrow[/kbd], move the caret one character right\n- [kbd]Cmd + B[/kbd]: Same as [kbd]Left Arrow[/kbd], move the caret one character left\n- [kbd]Cmd + P[/kbd]: Same as [kbd]Up Arrow[/kbd], move the caret to the previous line\n- [kbd]Cmd + N[/kbd]: Same as [kbd]Down Arrow[/kbd], move the caret to the next line\n- [kbd]Cmd + D[/kbd]: Same as [kbd]Delete[/kbd], delete the character on the right side of caret\n- [kbd]Cmd + H[/kbd]: Same as [kbd]Backspace[/kbd], delete the character on the left side of the caret\n- [kbd]Cmd + A[/kbd]: Same as [kbd]Home[/kbd], move the caret to the beginning of the line\n- [kbd]Cmd + E[/kbd]: Same as [kbd]End[/kbd], move the caret to the end of the line\n- [kbd]Cmd + Left Arrow[/kbd]: Same as [kbd]Home[/kbd], move the caret to the beginning of the line\n- [kbd]Cmd + Right Arrow[/kbd]: Same as [kbd]End[/kbd], move the caret to the end of the line\n[b]Note:[/b] Caret movement shortcuts listed above are not affected by [member shortcut_keys_enabled]."
msgstr "A [LineEdit] egyetlen szövegsor szerkesztésére szolgáló beviteli mező.\n- Ha a [LineEdit] a billentyűzet nyílbillentyűivel kerül fókuszba, csak fókuszt kap, de nem lép szerkesztési módba.\n- Szerkesztési módba lépéshez kattints a mezőre az egérrel; lásd még a [member keep_editing_on_text_submit] tulajdonságot.\n- A szerkesztési módból a [code]ui_text_submit[/code] vagy a [code]ui_cancel[/code] művelettel (alapértelmezés szerint [kbd]Escape[/kbd]) léphetsz ki.\n- További tudnivalókért lásd a [method edit], [method unedit], [method is_editing] metódusokat és az [signal editing_toggled] jelet.\nSzövegbevitel közben különleges karaktereket is beírhatsz Unicode-, OEM- vagy Windows Alt-kódokkal:\n- Unicode-kódpont megadásához tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a kódpontot a numerikus billentyűzeten. Például az [code]á[/code] (U+00E1) karakterhez tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a [kbd]+E1[/kbd] kódot a numerikus billentyűzeten (a kezdő nullák elhagyhatók).\n- OEM-kódpont megadásához tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a kódot a numerikus billentyűzeten. Például az [code]á[/code] (OEM 160) karakterhez tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a [code]160[/code] értéket a numerikus billentyűzeten.\n- Windows-kódpont megadásához tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a kódot a numerikus billentyűzeten. Például az [code]á[/code] (Windows 0225) karakterhez az [kbd]Alt[/kbd] nyomva tartása közben sorban nyomd le a [kbd]0[/kbd], [kbd]2[/kbd], [kbd]2[/kbd], [kbd]5[/kbd] billentyűket. A kezdő nullát itt [b]nem[/b] szabad elhagyni, mert így különböztethetők meg a Windows-kódpontok az OEM-kódpontoktól.\n[b]Fontos:[/b]\n- Ha a [LineEdit] a [code]ui_focus_next[/code] (alapértelmezés szerint [kbd]Tab[/kbd]), a [code]ui_focus_prev[/code] (alapértelmezés szerint [kbd]Shift + Tab[/kbd]) vagy a [method Control.grab_focus] segítségével kerül fókuszba, a kompatibilitás megőrzése érdekében továbbra is szerkesztési módba lép.\nA [LineEdit] számos beépített gyorsbillentyűt kínál, amelyek mindig elérhetők (macOS rendszeren az itt látható [kbd]Ctrl[/kbd] a [kbd]Cmd[/kbd] billentyűnek felel meg):\n- [kbd]Ctrl + C[/kbd]: Másolás\n- [kbd]Ctrl + X[/kbd]: Kivágás\n- [kbd]Ctrl + V[/kbd] vagy [kbd]Ctrl + Y[/kbd]: Beillesztés\n- [kbd]Ctrl + Z[/kbd]: Visszavonás\n- [kbd]Ctrl + ~[/kbd]: A beviteli irány megfordítása.\n- [kbd]Ctrl + Shift + Z[/kbd]: Újra végrehajtás\n- [kbd]Ctrl + U[/kbd]: Szöveg törlése a kurzortól a sor elejéig\n- [kbd]Ctrl + K[/kbd]: Szöveg törlése a kurzortól a sor végéig\n- [kbd]Ctrl + A[/kbd]: Minden szöveg kijelölése\n- [kbd]Up Arrow[/kbd]/[kbd]Down Arrow[/kbd]: A szövegkurzor mozgatása a sor elejére/végére\nmacOS rendszeren további gyorsbillentyűk is elérhetők:\n- [kbd]Cmd + F[/kbd]: Ugyanaz, mint a [kbd]Right Arrow[/kbd]; a szövegkurzor egy karakterrel jobbra lép\n- [kbd]Cmd + B[/kbd]: Ugyanaz, mint a [kbd]Left Arrow[/kbd]; a szövegkurzor egy karakterrel balra lép\n- [kbd]Cmd + P[/kbd]: Ugyanaz, mint a [kbd]Up Arrow[/kbd]; a szövegkurzor az előző sorba lép\n- [kbd]Cmd + N[/kbd]: Ugyanaz, mint a [kbd]Down Arrow[/kbd]; a szövegkurzor a következő sorba lép\n- [kbd]Cmd + D[/kbd]: Ugyanaz, mint a [kbd]Delete[/kbd]; a szövegkurzortól jobbra lévő karakter törlése\n- [kbd]Cmd + H[/kbd]: Ugyanaz, mint a [kbd]Backspace[/kbd]; a szövegkurzortól balra lévő karakter törlése\n- [kbd]Cmd + A[/kbd]: Ugyanaz, mint a [kbd]Home[/kbd]; a szövegkurzor a sor elejére lép\n- [kbd]Cmd + E[/kbd]: Ugyanaz, mint az [kbd]End[/kbd]; a szövegkurzor a sor végére lép\n- [kbd]Cmd + Left Arrow[/kbd]: Ugyanaz, mint a [kbd]Home[/kbd]; a szövegkurzor a sor elejére lép\n- [kbd]Cmd + Right Arrow[/kbd]: Ugyanaz, mint az [kbd]End[/kbd]; a szövegkurzor a sor végére lép\n[b]Megjegyzés:[/b] A fent felsorolt kurzormozgató gyorsbillentyűket a [member shortcut_keys_enabled] nem befolyásolja."


#. LineEdit.apply_ime
#: doc/classes/LineEdit.xml
msgid "Applies text from the [url=https://en.wikipedia.org/wiki/Input_method]Input Method Editor[/url] (IME) and closes the IME if it is open."
msgstr "Alkalmazza az [url=https://en.wikipedia.org/wiki/Input_method]Input Method Editor[/url] (IME) által bevitt szöveget, és bezárja az IME-t, ha nyitva van."


#. LineEdit.cancel_ime
#: doc/classes/LineEdit.xml
msgid "Closes the [url=https://en.wikipedia.org/wiki/Input_method]Input Method Editor[/url] (IME) if it is open. Any text in the IME will be lost."
msgstr "Bezárja az [url=https://en.wikipedia.org/wiki/Input_method]Input Method Editor[/url] (IME) ablakát, ha nyitva van. Az IME-ben lévő, még be nem vitt szöveg elveszik."


#. LineEdit.clear
#: doc/classes/LineEdit.xml
msgid "Erases the [LineEdit]'s [member text]."
msgstr "Törli a [LineEdit] [member text] szövegét."


#. LineEdit.delete_char_at_caret
#: doc/classes/LineEdit.xml
msgid "Deletes one character at the caret's current position (equivalent to pressing [kbd]Delete[/kbd])."
msgstr "Töröl egy karaktert a szövegkurzor aktuális pozícióján (ugyanaz, mint a [kbd]Delete[/kbd] lenyomása)."


#. LineEdit.delete_text
#: doc/classes/LineEdit.xml
msgid "Deletes a section of the [member text] going from position [param from_column] to [param to_column]. Both parameters should be within the text's length."
msgstr "Törli a [member text] egy részét a [param from_column] pozíciótól a [param to_column] pozícióig. Mindkét paraméternek a szöveg hosszán belül kell lennie."


#. LineEdit.deselect
#: doc/classes/LineEdit.xml
msgid "Clears the current selection."
msgstr "Megszünteti az aktuális szövegkijelölést."


#. LineEdit.edit
#: doc/classes/LineEdit.xml
msgid "Allows entering edit mode whether the [LineEdit] is focused or not. If [param hide_focus] is [code]true[/code], the focused state will not be shown (see [method Control.grab_focus]).\nSee also [member keep_editing_on_text_submit]."
msgstr "Szerkesztési módba lép, függetlenül attól, hogy a [LineEdit] fókuszban van-e. Ha a [param hide_focus] értéke [code]true[/code], a fókuszált állapot nem jelenik meg (lásd: [method Control.grab_focus]).\nLásd még a [member keep_editing_on_text_submit] tulajdonságot."


#. LineEdit.get_menu
#: doc/classes/LineEdit.xml
msgid "Returns the [PopupMenu] of this [LineEdit]. By default, this menu is displayed when right-clicking on the [LineEdit].\nYou can add custom menu items or remove standard ones. Make sure your IDs don't conflict with the standard ones (see [enum MenuItems]). For example:\n[codeblocks]\n[gdscript]\nfunc _ready():\n\tvar menu = get_menu()\n\t# Remove all items after \"Redo\".\n\tmenu.item_count = menu.get_item_index(MENU_REDO) + 1\n\t# Add custom items.\n\tmenu.add_separator()\n\tmenu.add_item(\"Insert Date\", MENU_MAX + 1)\n\t# Connect callback.\n\tmenu.id_pressed.connect(_on_item_pressed)\n\nfunc _on_item_pressed(id):\n\tif id == MENU_MAX + 1:\n\t\tinsert_text_at_caret(Time.get_date_string_from_system())\n[/gdscript]\n[csharp]\npublic override void _Ready()\n{\n\tvar menu = GetMenu();\n\t// Remove all items after \"Redo\".\n\tmenu.ItemCount = menu.GetItemIndex(LineEdit.MenuItems.Redo) + 1;\n\t// Add custom items.\n\tmenu.AddSeparator();\n\tmenu.AddItem(\"Insert Date\", LineEdit.MenuItems.Max + 1);\n\t// Add event handler.\n\tmenu.IdPressed += OnItemPressed;\n}\n\npublic void OnItemPressed(int id)\n{\n\tif (id == LineEdit.MenuItems.Max + 1)\n\t{\n\t\tInsertTextAtCaret(Time.GetDateStringFromSystem());\n\t}\n}\n[/csharp]\n[/codeblocks]\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash. If you wish to hide it or any of its children, use their [member Window.visible] property."
msgstr "Visszaadja a [LineEdit] [PopupMenu] helyi menüjét. Alapértelmezés szerint ez a menü akkor jelenik meg, amikor jobb gombbal kattintasz a [LineEdit] mezőre.\nEgyéni menüpontokat adhatsz hozzá, vagy eltávolíthatod a szokásosakat. Ügyelj arra, hogy az azonosítóid ne ütközzenek a szabványos azonosítókkal (lásd: [enum MenuItems]). Például:\n[codeblocks]\n[gdscript]\nfunc _ready():\n\tvar menu = get_menu()\n\t# Remove all items after \"Redo\".\n\tmenu.item_count = menu.get_item_index(MENU_REDO) + 1\n\t# Add custom items.\n\tmenu.add_separator()\n\tmenu.add_item(\"Insert Date\", MENU_MAX + 1)\n\t# Connect callback.\n\tmenu.id_pressed.connect(_on_item_pressed)\n\nfunc _on_item_pressed(id):\n\tif id == MENU_MAX + 1:\n\t\tinsert_text_at_caret(Time.get_date_string_from_system())\n[/gdscript]\n[csharp]\npublic override void _Ready()\n{\n\tvar menu = GetMenu();\n\t// Remove all items after \"Redo\".\n\tmenu.ItemCount = menu.GetItemIndex(LineEdit.MenuItems.Redo) + 1;\n\t// Add custom items.\n\tmenu.AddSeparator();\n\tmenu.AddItem(\"Insert Date\", LineEdit.MenuItems.Max + 1);\n\t// Add event handler.\n\tmenu.IdPressed += OnItemPressed;\n}\n\npublic void OnItemPressed(int id)\n{\n\tif (id == LineEdit.MenuItems.Max + 1)\n\t{\n\t\tInsertTextAtCaret(Time.GetDateStringFromSystem());\n\t}\n}\n[/csharp]\n[/codeblocks]\n[b]Figyelmeztetés:[/b] Ez egy kötelező belső csomópont; eltávolítása és felszabadítása összeomlást okozhat. Ha ezt vagy valamelyik gyermekét el szeretnéd rejteni, használd a [member Window.visible] tulajdonságot."


#. LineEdit.get_next_composite_character_column
#: doc/classes/LineEdit.xml
msgid "Returns the correct column at the end of a composite character like ❤️‍🩹 (mending heart; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) which is comprised of more than one Unicode code point, if the caret is at the start of the composite character. Also returns the correct column with the caret at mid grapheme and for non-composite characters.\n[b]Note:[/b] To check at caret location use [code]get_next_composite_character_column(get_caret_column())[/code]"
msgstr "Visszaadja a helyes oszloppozíciót egy több Unicode-kódpontból álló összetett karakter végén, például ❤️‍🩹 (gyógyuló szív, Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) esetén, ha a szövegkurzor az összetett karakter elején áll. A helyes oszloppozíciót akkor is visszaadja, ha a kurzor egy graféma közepén vagy nem összetett karakteren áll.\n[b]Megjegyzés:[/b] Az aktuális kurzorpozíciónál a [code]get_next_composite_character_column(get_caret_column())[/code] hívással ellenőrizhető."


#. LineEdit.get_previous_composite_character_column
#: doc/classes/LineEdit.xml
msgid "Returns the correct column at the start of a composite character like ❤️‍🩹 (mending heart; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) which is comprised of more than one Unicode code point, if the caret is at the end of the composite character. Also returns the correct column with the caret at mid grapheme and for non-composite characters.\n[b]Note:[/b] To check at caret location use [code]get_previous_composite_character_column(get_caret_column())[/code]"
msgstr "Visszaadja a helyes oszloppozíciót egy több Unicode-kódpontból álló összetett karakter elején, például ❤️‍🩹 (gyógyuló szív, Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) esetén, ha a szövegkurzor az összetett karakter végén áll. A helyes oszloppozíciót akkor is visszaadja, ha a kurzor egy graféma közepén vagy nem összetett karakteren áll.\n[b]Megjegyzés:[/b] Az aktuális kurzorpozíciónál a [code]get_previous_composite_character_column(get_caret_column())[/code] hívással ellenőrizhető."


#. LineEdit.get_scroll_offset
#: doc/classes/LineEdit.xml
msgid "Returns the scroll offset due to [member caret_column], as a number of characters."
msgstr "Visszaadja a [member caret_column] miatt bekövetkezett görgetés eltolását karakterszámban."


#. LineEdit.get_selected_text
#: doc/classes/LineEdit.xml
msgid "Returns the text inside the selection."
msgstr "Visszaadja a kijelölt szöveget."


#. LineEdit.get_selection_from_column
#: doc/classes/LineEdit.xml
msgid "Returns the selection begin column."
msgstr "Visszaadja a kijelölés kezdőoszlopát."


#. LineEdit.get_selection_to_column
#: doc/classes/LineEdit.xml
msgid "Returns the selection end column."
msgstr "Visszaadja a kijelölés záróoszlopát."


#. LineEdit.has_ime_text
#: doc/classes/LineEdit.xml
msgid "Returns [code]true[/code] if the user has text in the [url=https://en.wikipedia.org/wiki/Input_method]Input Method Editor[/url] (IME)."
msgstr "[code]true[/code] értéket ad vissza, ha a felhasználó az [url=https://en.wikipedia.org/wiki/Input_method]Input Method Editor[/url] (IME) beviteli rendszerben szöveget állított össze."


#. LineEdit.has_redo
#: doc/classes/LineEdit.xml
msgid "Returns [code]true[/code] if a \"redo\" action is available."
msgstr "[code]true[/code] értéket ad vissza, ha elérhető az újravégrehajtás."


#. LineEdit.has_selection
#: doc/classes/LineEdit.xml
msgid "Returns [code]true[/code] if the user has selected text."
msgstr "[code]true[/code] értéket ad vissza, ha a felhasználó kijelölt szöveget."


#. LineEdit.has_undo
#: doc/classes/LineEdit.xml
msgid "Returns [code]true[/code] if an \"undo\" action is available."
msgstr "[code]true[/code] értéket ad vissza, ha elérhető a visszavonás."


#. LineEdit.insert_text_at_caret
#: doc/classes/LineEdit.xml
msgid "Inserts [param text] at the caret. If the resulting value is longer than [member max_length], nothing happens."
msgstr "A szövegkurzor pozíciójára beszúrja a [param text] szöveget. Ha az eredmény hosszabb lenne, mint a [member max_length], nem történik semmi."


#. LineEdit.is_editing
#: doc/classes/LineEdit.xml
msgid "Returns whether the [LineEdit] is being edited."
msgstr "Visszaadja, hogy a [LineEdit] éppen szerkesztés alatt áll-e."


#. LineEdit.is_menu_visible
#: doc/classes/LineEdit.xml
msgid "Returns whether the menu is visible. Use this instead of [code]get_menu().visible[/code] to improve performance (so the creation of the menu is avoided)."
msgstr "Visszaadja, hogy a menü látható-e. A jobb teljesítmény érdekében ezt használd a [code]get_menu().visible[/code] helyett, így elkerülhető a menü létrehozása."


#. LineEdit.menu_option
#: doc/classes/LineEdit.xml
msgid "Executes a given action as defined in the [enum MenuItems] enum."
msgstr "Végrehajtja a [enum MenuItems] felsorolásban meghatározott műveletet."


#. LineEdit.select
#: doc/classes/LineEdit.xml
msgid "Selects characters inside [LineEdit] between [param from] and [param to]. By default, [param from] is at the beginning and [param to] at the end.\n[codeblocks]\n[gdscript]\ntext = \"Welcome\"\nselect() # Will select \"Welcome\".\nselect(4) # Will select \"ome\".\nselect(2, 5) # Will select \"lco\".\n[/gdscript]\n[csharp]\nText = \"Welcome\";\nSelect(); // Will select \"Welcome\".\nSelect(4); // Will select \"ome\".\nSelect(2, 5); // Will select \"lco\".\n[/csharp]\n[/codeblocks]"
msgstr "Kijelöli a [LineEdit] szövegének a [param from] és [param to] közötti karaktereit. Alapértelmezés szerint a [param from] a szöveg eleje, a [param to] pedig a szöveg vége.\n[codeblocks]\n[gdscript]\ntext = \"Welcome\"\nselect() # Will select \"Welcome\".\nselect(4) # Will select \"ome\".\nselect(2, 5) # Will select \"lco\".\n[/gdscript]\n[csharp]\nText = \"Welcome\";\nSelect(); // Will select \"Welcome\".\nSelect(4); // Will select \"ome\".\nSelect(2, 5); // Will select \"lco\".\n[/csharp]\n[/codeblocks]"


#. LineEdit.select_all
#: doc/classes/LineEdit.xml
msgid "Selects the whole [String]."
msgstr "Kijelöli a teljes [String] szöveget."


#. LineEdit.unedit
#: doc/classes/LineEdit.xml
msgid "Allows exiting edit mode while preserving focus."
msgstr "Lehetővé teszi a szerkesztési módból való kilépést a fókusz megtartásával."

#. TextEdit._backspace
#: doc/classes/TextEdit.xml
msgid "Override this method to define what happens when the user presses the backspace key."
msgstr "Ezt a metódust felülírva megadhatod, mi történjen, amikor a felhasználó megnyomja a Backspace billentyűt."

#. TextEdit._copy
#: doc/classes/TextEdit.xml
msgid "Override this method to define what happens when the user performs a copy operation."
msgstr "Ezt a metódust felülírva megadhatod, mi történjen, amikor a felhasználó másolást végez."

#. TextEdit._cut
#: doc/classes/TextEdit.xml
msgid "Override this method to define what happens when the user performs a cut operation."
msgstr "Ezt a metódust felülírva megadhatod, mi történjen, amikor a felhasználó kivágást végez."

#. TextEdit._handle_unicode_input
#: doc/classes/TextEdit.xml
msgid "Override this method to define what happens when the user types in the provided key [param unicode_char]."
msgstr "Ezt a metódust felülírva megadhatod, mi történjen, amikor a felhasználó beírja a [param unicode_char] paraméterben megadott karaktert."

#. TextEdit._paste
#: doc/classes/TextEdit.xml
msgid "Override this method to define what happens when the user performs a paste operation."
msgstr "Ezt a metódust felülírva megadhatod, mi történjen, amikor a felhasználó beillesztést végez."

#. TextEdit._paste_primary_clipboard
#: doc/classes/TextEdit.xml
msgid "Override this method to define what happens when the user performs a paste operation with middle mouse button.\n[b]Note:[/b] This method is only implemented on Linux."
msgstr "Ezt a metódust felülírva megadhatod, mi történjen, amikor a felhasználó a középső egérgombbal illeszt be szöveget.\n[b]Megjegyzés:[/b] Ez a metódus csak Linuxon van megvalósítva."

#. TextEdit.add_caret
#: doc/classes/TextEdit.xml
msgid "Adds a new caret at the given location. Returns the index of the new caret, or [code]-1[/code] if the location is invalid."
msgstr "Új szövegkurzort ad hozzá a megadott helyen. Visszaadja az új kurzor indexét, vagy [code]-1[/code] értéket, ha a hely érvénytelen."

#. TextEdit.add_caret_at_carets
#: doc/classes/TextEdit.xml
msgid "Adds an additional caret above or below every caret. If [param below] is [code]true[/code] the new caret will be added below and above otherwise."
msgstr "Minden meglévő szövegkurzor fölé vagy alá újabb kurzort helyez. Ha a [param below] értéke [code]true[/code], az új kurzor alulra, egyébként felülre kerül."

#. TextEdit.add_gutter
#: doc/classes/TextEdit.xml
msgid "Register a new gutter to this [TextEdit]. Use [param at] to have a specific gutter order. A value of [code]-1[/code] appends the gutter to the right."
msgstr "Új oldalsávot regisztrál ehhez a [TextEdit] vezérlőhöz. Az oldalsáv sorrendjét a [param at] paraméterrel adhatod meg. A [code]-1[/code] érték az oldalsávot a jobb szélre fűzi hozzá."

#. TextEdit.add_selection_for_next_occurrence
#: doc/classes/TextEdit.xml
msgid "Adds a selection and a caret for the next occurrence of the current selection. If there is no active selection, selects word under caret."
msgstr "Kijelölést és szövegkurzort ad hozzá a jelenlegi kijelölés következő előfordulásához. Ha nincs aktív kijelölés, a kurzor alatti szót jelöli ki."

#. TextEdit.adjust_carets_after_edit
#: doc/classes/TextEdit.xml
msgid "This method does nothing."
msgstr "Ez a metódus nem végez semmilyen műveletet."

#. TextEdit.adjust_viewport_to_caret
#: doc/classes/TextEdit.xml
msgid "Adjust the viewport so the caret is visible."
msgstr "Úgy állítja be a nézetet, hogy a szövegkurzor látható legyen."

#. TextEdit.apply_ime
#: doc/classes/TextEdit.xml
msgid "Applies text from the [url=https://en.wikipedia.org/wiki/Input_method]Input Method Editor[/url] (IME) to each caret and closes the IME if it is open."
msgstr "Az [url=https://en.wikipedia.org/wiki/Input_method]Input Method Editor[/url] (IME) szövegét minden szövegkurzornál alkalmazza, majd bezárja az IME-t, ha az nyitva van."

#. TextEdit.backspace
#: doc/classes/TextEdit.xml
msgid "Called when the user presses the backspace key. Can be overridden with [method _backspace]."
msgstr "Akkor hívódik meg, amikor a felhasználó megnyomja a Backspace billentyűt. A [method _backspace] metódussal felülírható."

#. TextEdit.begin_complex_operation
#: doc/classes/TextEdit.xml
msgid "Starts a multipart edit. All edits will be treated as one action until [method end_complex_operation] is called."
msgstr "Többrészes szerkesztési műveletet indít. A [method end_complex_operation] meghívásáig minden módosítás egyetlen műveletnek számít."

#. TextEdit.begin_multicaret_edit
#: doc/classes/TextEdit.xml
msgid "Starts an edit for multiple carets. The edit must be ended with [method end_multicaret_edit]. Multicaret edits can be used to edit text at multiple carets and delay merging the carets until the end, so the caret indexes aren't affected immediately. [method begin_multicaret_edit] and [method end_multicaret_edit] can be nested, and the merge will happen at the last [method end_multicaret_edit].\n[codeblock]\nbegin_complex_operation()\nbegin_multicaret_edit()\nfor i in range(get_caret_count()):\n\tif multicaret_edit_ignore_caret(i):\n\t\tcontinue\n\t# Logic here.\nend_multicaret_edit()\nend_complex_operation()\n[/codeblock]"
msgstr "Több szövegkurzort érintő szerkesztést indít. A szerkesztést a [method end_multicaret_edit] metódussal kell lezárni. Ezzel egyszerre több kurzor helyén módosítható a szöveg, miközben a kurzorok összevonását a művelet végéig elhalasztjuk, így az indexeik nem változnak meg azonnal. A [method begin_multicaret_edit] és a [method end_multicaret_edit] egymásba ágyazható; az összevonás az utolsó [method end_multicaret_edit] hívásakor történik meg.\n[codeblock]\nbegin_complex_operation()\nbegin_multicaret_edit()\nfor i in range(get_caret_count()):\n\tif multicaret_edit_ignore_caret(i):\n\t\tcontinue\n\t# Logic here.\nend_multicaret_edit()\nend_complex_operation()\n[/codeblock]"

#. TextEdit.center_viewport_to_caret
#: doc/classes/TextEdit.xml
msgid "Centers the viewport on the line the editing caret is at. This also resets the [member scroll_horizontal] value to [code]0[/code]."
msgstr "A nézetet a szerkesztőkurzor sorára központosítja. A [member scroll_horizontal] értékét is visszaállítja [code]0[/code]-ra."

#. TextEdit.clear
#: doc/classes/TextEdit.xml
msgid "Performs a full reset of [TextEdit], including undo history."
msgstr "Teljesen alaphelyzetbe állítja a [TextEdit] vezérlőt, beleértve a visszavonási előzményeket is."

#. TextEdit.clear_undo_history
#: doc/classes/TextEdit.xml
msgid "Clears the undo history."
msgstr "Törli a visszavonási előzményeket."

#. TextEdit.collapse_carets
#: doc/classes/TextEdit.xml
msgid "Collapse all carets in the given range to the [param from_line] and [param from_column] position.\n[param inclusive] applies to both ends.\nIf [method is_in_mulitcaret_edit] is [code]true[/code], carets that are collapsed will be [code]true[/code] for [method multicaret_edit_ignore_caret].\n[method merge_overlapping_carets] will be called if any carets were collapsed."
msgstr "A megadott tartományban lévő összes szövegkurzort a [param from_line] és [param from_column] által meghatározott helyre vonja össze.\nA [param inclusive] mindkét végpontra vonatkozik.\nHa az [method is_in_mulitcaret_edit] értéke [code]true[/code], az összevont kurzoroknál a [method multicaret_edit_ignore_caret] [code]true[/code] értéket ad vissza.\nHa bármelyik kurzor összevonásra került, meghívódik a [method merge_overlapping_carets] metódus."

#. TextEdit.copy
#: doc/classes/TextEdit.xml
msgid "Copies the current text selection. Can be overridden with [method _copy]."
msgstr "A vágólapra másolja az aktuálisan kijelölt szöveget. A [method _copy] metódussal felülírható."

#. TextEdit.cut
#: doc/classes/TextEdit.xml
msgid "Cut's the current selection. Can be overridden with [method _cut]."
msgstr "Kivágja az aktuálisan kijelölt szöveget. A [method _cut] metódussal felülírható."

#. TextEdit.delete_selection
#: doc/classes/TextEdit.xml
msgid "Deletes the selected text."
msgstr "Törli a kijelölt szöveget."

#. TextEdit.deselect
#: doc/classes/TextEdit.xml
msgid "Deselects the current selection."
msgstr "Megszünteti az aktuális kijelölést."

#. TextEdit.end_action
#: doc/classes/TextEdit.xml
msgid "Marks the end of steps in the current action started with [method start_action]."
msgstr "Megjelöli a [method start_action] metódussal indított aktuális művelet lépéseinek végét."

#. TextEdit.end_complex_operation
#: doc/classes/TextEdit.xml
msgid "Ends a multipart edit, started with [method begin_complex_operation]. If called outside a complex operation, the current operation is pushed onto the undo/redo stack."
msgstr "Lezárja a [method begin_complex_operation] metódussal indított többrészes szerkesztést. Ha nem egy ilyen műveleten belül hívják meg, az aktuális műveletet a visszavonási/újravégrehajtási előzmények közé helyezi."

#. TextEdit.end_multicaret_edit
#: doc/classes/TextEdit.xml
msgid "Ends an edit for multiple carets, that was started with [method begin_multicaret_edit]. If this was the last [method end_multicaret_edit] and [method merge_overlapping_carets] was called, carets will be merged."
msgstr "Lezárja a [method begin_multicaret_edit] metódussal indított, több szövegkurzort érintő szerkesztést. Ha ez volt az utolsó [method end_multicaret_edit] hívás, és meghívták a [method merge_overlapping_carets] metódust, a kurzorok összevonásra kerülnek."

#. TextEdit.get_caret_column
#: doc/classes/TextEdit.xml
msgid "Returns the column the editing caret is at."
msgstr "Visszaadja azt az oszlopot, amelyben a szerkesztőkurzor található."

#. TextEdit.get_caret_count
#: doc/classes/TextEdit.xml
msgid "Returns the number of carets in this [TextEdit]."
msgstr "Visszaadja a [TextEdit] vezérlőben lévő szövegkurzorok számát."

#. TextEdit.get_caret_draw_pos
#: doc/classes/TextEdit.xml
msgid "Returns the caret pixel draw position."
msgstr "Visszaadja a szövegkurzor kirajzolási helyét képpontokban."

#. TextEdit.get_caret_index_edit_order
#: doc/classes/TextEdit.xml
msgid "Returns a list of caret indexes in their edit order, this done from bottom to top. Edit order refers to the way actions such as [method insert_text_at_caret] are applied."
msgstr "Visszaadja a szövegkurzorok indexeit a szerkesztési sorrendjükben, alulról felfelé haladva. A szerkesztési sorrend azt határozza meg, milyen sorrendben hajtódnak végre az olyan műveletek, mint a [method insert_text_at_caret]."

#. TextEdit.get_caret_line
#: doc/classes/TextEdit.xml
msgid "Returns the line the editing caret is on."
msgstr "Visszaadja annak a sornak a számát, amelyben a szerkesztőkurzor található."

#. TextEdit.get_caret_wrap_index
#: doc/classes/TextEdit.xml
msgid "Returns the wrap index the editing caret is on."
msgstr "Visszaadja annak a tördelési szakasznak az indexét, amelyben a szerkesztőkurzor található."

#. TextEdit.get_first_non_whitespace_column
#: doc/classes/TextEdit.xml
msgid "Returns the first column containing a non-whitespace character on the given line. If there is only whitespace, returns the number of characters."
msgstr "Visszaadja a megadott sor első olyan oszlopát, amelyben nem térközjellegű karakter található. Ha a sor csak térközjellegű karaktereket tartalmaz, a karakterek számát adja vissza."

#. TextEdit.get_first_visible_line
#: doc/classes/TextEdit.xml
msgid "Returns the first visible line."
msgstr "Visszaadja az első látható sor számát."

#. TextEdit.get_gutter_count
#: doc/classes/TextEdit.xml
msgid "Returns the number of gutters registered."
msgstr "Visszaadja a regisztrált oldalsávok számát."

#. TextEdit.get_gutter_name
#: doc/classes/TextEdit.xml
msgid "Returns the name of the gutter at the given index."
msgstr "Visszaadja a megadott indexű oldalsáv nevét."

#. TextEdit.get_gutter_type
#: doc/classes/TextEdit.xml
msgid "Returns the type of the gutter at the given index. Gutters can contain icons, text, or custom visuals."
msgstr "Visszaadja a megadott indexű oldalsáv típusát. Az oldalsávok ikonokat, szöveget vagy egyéni megjelenítési elemeket tartalmazhatnak."

#. TextEdit.get_gutter_width
#: doc/classes/TextEdit.xml
msgid "Returns the width of the gutter at the given index."
msgstr "Visszaadja a megadott indexű oldalsáv szélességét."

#. TextEdit.get_h_scroll_bar
#: doc/classes/TextEdit.xml
msgid "Returns the [HScrollBar] used by [TextEdit]."
msgstr "Visszaadja a [TextEdit] által használt [HScrollBar] vezérlőt."

#. TextEdit.get_indent_level
#: doc/classes/TextEdit.xml
msgid "Returns the indent level of the given line. This is the number of spaces and tabs at the beginning of the line, with the tabs taking the tab size into account (see [method get_tab_size])."
msgstr "Visszaadja a megadott sor behúzásának mértékét. Ez a sor elején lévő szóközök és tabulátorok összesített szélessége, a tabulátorok méretét is figyelembe véve (lásd: [method get_tab_size])."

#. TextEdit.get_last_full_visible_line
#: doc/classes/TextEdit.xml
msgid "Returns the last visible line. Use [method get_last_full_visible_line_wrap_index] for the wrap index."
msgstr "Visszaadja az utolsó látható sor számát. A tördelési szakasz indexéhez használd a [method get_last_full_visible_line_wrap_index] metódust."

#. TextEdit.get_last_full_visible_line_wrap_index
#: doc/classes/TextEdit.xml
msgid "Returns the last visible wrap index of the last visible line."
msgstr "Visszaadja az utolsó látható sor utolsó látható tördelési szakaszának indexét."

#. TextEdit.get_last_unhidden_line
#: doc/classes/TextEdit.xml
msgid "Returns the last unhidden line in the entire [TextEdit]."
msgstr "Visszaadja a teljes [TextEdit] utolsó, nem elrejtett sorának számát."

#. TextEdit.get_line
#: doc/classes/TextEdit.xml
msgid "Returns the text of a specific line."
msgstr "Visszaadja egy adott sor szövegét."

#. TextEdit.get_line_background_color
#: doc/classes/TextEdit.xml
msgid "Returns the custom background color of the given line. If no color is set, returns [code]Color(0, 0, 0, 0)[/code]."
msgstr "Visszaadja a megadott sor egyéni háttérszínét. Ha nincs beállítva szín, a [code]Color(0, 0, 0, 0)[/code] értéket adja vissza."

#. TextEdit.get_line_column_at_pos
#: doc/classes/TextEdit.xml
msgid "Returns the line and column at the given position. In the returned vector, [code]x[/code] is the column and [code]y[/code] is the line.\nIf [param clamp_line] is [code]false[/code] and [param position] is below the last line, [code]Vector2i(-1, -1)[/code] is returned.\nIf [param clamp_column] is [code]false[/code] and [param position] is outside the column range of the line, [code]Vector2i(-1, -1)[/code] is returned."
msgstr "Visszaadja a megadott pozícióhoz tartozó sort és oszlopot. A visszaadott vektorban az [code]x[/code] az oszlopot, az [code]y[/code] pedig a sort jelöli.\nHa a [param clamp_line] értéke [code]false[/code], és a [param position] az utolsó sor alatt található, az eredmény [code]Vector2i(-1, -1)[/code].\nHa a [param clamp_column] értéke [code]false[/code], és a [param position] a sor oszloptartományán kívül esik, az eredmény [code]Vector2i(-1, -1)[/code]."

#. TextEdit.get_line_count
#: doc/classes/TextEdit.xml
msgid "Returns the number of lines in the text."
msgstr "Visszaadja a szöveg sorainak számát."

#. TextEdit.get_line_gutter_icon
#: doc/classes/TextEdit.xml
msgid "Returns the icon currently in [param gutter] at [param line]. This only works when the gutter type is [constant GUTTER_TYPE_ICON] (see [method set_gutter_type])."
msgstr "Visszaadja a [param line] sor [param gutter] oldalsávjában jelenleg található ikont. Csak [constant GUTTER_TYPE_ICON] típusú oldalsávnál működik (lásd: [method set_gutter_type])."

#. TextEdit.get_line_gutter_item_color
#: doc/classes/TextEdit.xml
msgid "Returns the color currently in [param gutter] at [param line]."
msgstr "Visszaadja a [param line] sor [param gutter] oldalsávjában jelenleg beállított színt."

#. TextEdit.get_line_gutter_metadata
#: doc/classes/TextEdit.xml
msgid "Returns the metadata currently in [param gutter] at [param line]."
msgstr "Visszaadja a [param line] sor [param gutter] oldalsávjában jelenleg tárolt metaadatot."

#. TextEdit.get_line_gutter_text
#: doc/classes/TextEdit.xml
msgid "Returns the text currently in [param gutter] at [param line]. This only works when the gutter type is [constant GUTTER_TYPE_STRING] (see [method set_gutter_type])."
msgstr "Visszaadja a [param line] sor [param gutter] oldalsávjában jelenleg megjelenített szöveget. Csak [constant GUTTER_TYPE_STRING] típusú oldalsávnál működik (lásd: [method set_gutter_type])."

#. TextEdit.get_line_height
#: doc/classes/TextEdit.xml
msgid "Returns the maximum value of the line height among all lines.\n[b]Note:[/b] The return value is influenced by [theme_item line_spacing] and [theme_item font_size]. And it will not be less than [code]1[/code]."
msgstr "Visszaadja az összes sor közül a legnagyobb sormagasságot.\n[b]Megjegyzés:[/b] A visszaadott értéket befolyásolja a [theme_item line_spacing] és a [theme_item font_size], és soha nem kisebb [code]1[/code]-nél."

#. TextEdit.get_line_ranges_from_carets
#: doc/classes/TextEdit.xml
msgid "Returns an [Array] of line ranges where [code]x[/code] is the first line and [code]y[/code] is the last line. All lines within these ranges will have a caret on them or be part of a selection. Each line will only be part of one line range, even if it has multiple carets on it.\nIf a selection's end column ([method get_selection_to_column]) is at column [code]0[/code], that line will not be included. If a selection begins on the line after another selection ends and [param merge_adjacent] is [code]true[/code], or they begin and end on the same line, one line range will include both selections."
msgstr "A sorok tartományait tartalmazó [Array] tömböt ad vissza. Az [code]x[/code] az első, az [code]y[/code] az utolsó sort jelöli. E tartományok minden sora tartalmaz szövegkurzort, vagy egy kijelölés részét képezi. Egy sor akkor is csak egyetlen tartományhoz tartozik, ha több szövegkurzor van rajta.\nHa egy kijelölés utolsó oszlopa ([method get_selection_to_column]) [code]0[/code], az adott sor nem kerül bele a tartományba. Ha egy kijelölés közvetlenül az előző kijelölés végét követő sorban kezdődik, és a [param merge_adjacent] értéke [code]true[/code], vagy mindkettő ugyanabban a sorban kezdődik és végződik, a két kijelölés egyetlen sortartományba kerül."

#. TextEdit.get_line_width
#: doc/classes/TextEdit.xml
msgid "Returns the width in pixels of the [param wrap_index] on [param line]."
msgstr "Visszaadja a [param line] sor [param wrap_index] tördelési szakaszának szélességét képpontban."

#. TextEdit.get_line_with_ime
#: doc/classes/TextEdit.xml
msgid "Returns line text as it is currently displayed, including IME composition string."
msgstr "Visszaadja a sor jelenleg megjelenített szövegét, beleértve az IME-ben éppen összeállított karaktereket is."

#. TextEdit.get_line_wrap_count
#: doc/classes/TextEdit.xml
msgid "Returns the number of times the given line is wrapped."
msgstr "Visszaadja, hányszor tördelődik a megadott sor."

#. TextEdit.get_line_wrap_index_at_column
#: doc/classes/TextEdit.xml
msgid "Returns the wrap index of the given column on the given line. This ranges from [code]0[/code] to [method get_line_wrap_count]."
msgstr "Visszaadja a megadott sor megadott oszlopához tartozó tördelési szakasz indexét. Az érték [code]0[/code] és a [method get_line_wrap_count] eredménye közé esik."

#. TextEdit.get_line_wrapped_text
#: doc/classes/TextEdit.xml
msgid "Returns an array of [String]s representing each wrapped index."
msgstr "[String] értékeket tartalmazó tömböt ad vissza, amelynek elemei az egyes tördelési szakaszok szövegei."

#. TextEdit.get_local_mouse_pos
#: doc/classes/TextEdit.xml
msgid "Returns the local mouse position adjusted for the text direction."
msgstr "Visszaadja az egér helyi pozícióját a szövegirány figyelembevételével."

#. TextEdit.get_menu
#: doc/classes/TextEdit.xml
msgid "Returns the [PopupMenu] of this [TextEdit]. By default, this menu is displayed when right-clicking on the [TextEdit].\nYou can add custom menu items or remove standard ones. Make sure your IDs don't conflict with the standard ones (see [enum MenuItems]). For example:\n[codeblocks]\n[gdscript]\nfunc _ready():\n\tvar menu = get_menu()\n\t# Remove all items after \"Redo\".\n\tmenu.item_count = menu.get_item_index(MENU_REDO) + 1\n\t# Add custom items.\n\tmenu.add_separator()\n\tmenu.add_item(\"Insert Date\", MENU_MAX + 1)\n\t# Connect callback.\n\tmenu.id_pressed.connect(_on_item_pressed)\n\nfunc _on_item_pressed(id):\n\tif id == MENU_MAX + 1:\n\t\tinsert_text_at_caret(Time.get_date_string_from_system())\n[/gdscript]\n[csharp]\npublic override void _Ready()\n{\n\tvar menu = GetMenu();\n\t// Remove all items after \"Redo\".\n\tmenu.ItemCount = menu.GetItemIndex(TextEdit.MenuItems.Redo) + 1;\n\t// Add custom items.\n\tmenu.AddSeparator();\n\tmenu.AddItem(\"Insert Date\", TextEdit.MenuItems.Max + 1);\n\t// Add event handler.\n\tmenu.IdPressed += OnItemPressed;\n}\n\npublic void OnItemPressed(int id)\n{\n\tif (id == TextEdit.MenuItems.Max + 1)\n\t{\n\t\tInsertTextAtCaret(Time.GetDateStringFromSystem());\n\t}\n}\n[/csharp]\n[/codeblocks]\n[b]Warning:[/b] This is a required internal node, removing and freeing it may cause a crash. If you wish to hide it or any of its children, use their [member Window.visible] property."
msgstr "Visszaadja a [TextEdit] vezérlő [PopupMenu] helyi menüjét. Alapértelmezés szerint ez a menü a [TextEdit] vezérlőn végzett jobb kattintáskor jelenik meg.\nEgyéni menüpontokat adhatsz hozzá, illetve eltávolíthatod az alapértelmezett menüpontokat. Ügyelj rá, hogy az azonosítóik ne ütközzenek a beépített azonosítókkal (lásd: [enum MenuItems]). Például:\n[codeblocks]\n[gdscript]\nfunc _ready():\n\tvar menu = get_menu()\n\t# Remove all items after \"Redo\".\n\tmenu.item_count = menu.get_item_index(MENU_REDO) + 1\n\t# Add custom items.\n\tmenu.add_separator()\n\tmenu.add_item(\"Insert Date\", MENU_MAX + 1)\n\t# Connect callback.\n\tmenu.id_pressed.connect(_on_item_pressed)\n\nfunc _on_item_pressed(id):\n\tif id == MENU_MAX + 1:\n\t\tinsert_text_at_caret(Time.get_date_string_from_system())\n[/gdscript]\n[csharp]\npublic override void _Ready()\n{\n\tvar menu = GetMenu();\n\t// Remove all items after \"Redo\".\n\tmenu.ItemCount = menu.GetItemIndex(TextEdit.MenuItems.Redo) + 1;\n\t// Add custom items.\n\tmenu.AddSeparator();\n\tmenu.AddItem(\"Insert Date\", TextEdit.MenuItems.Max + 1);\n\t// Add event handler.\n\tmenu.IdPressed += OnItemPressed;\n}\n\npublic void OnItemPressed(int id)\n{\n\tif (id == TextEdit.MenuItems.Max + 1)\n\t{\n\t\tInsertTextAtCaret(Time.GetDateStringFromSystem());\n\t}\n}\n[/csharp]\n[/codeblocks]\n[b]Figyelmeztetés:[/b] Ez egy kötelező belső csomópont. Az eltávolítása és felszabadítása összeomlást okozhat. Ha el szeretnéd rejteni ezt a csomópontot vagy bármely gyermekét, használd a [member Window.visible] tulajdonságukat."

#. TextEdit.get_minimap_line_at_pos
#: doc/classes/TextEdit.xml
msgid "Returns the equivalent minimap line at [param position]."
msgstr "Visszaadja a [param position] pozíciónak megfelelő sort a minitérképen."

#. TextEdit.get_minimap_visible_lines
#: doc/classes/TextEdit.xml
msgid "Returns the number of lines that may be drawn on the minimap."
msgstr "Visszaadja a minitérképen kirajzolható sorok számát."

#. TextEdit.get_next_composite_character_column
#: doc/classes/TextEdit.xml
msgid "Returns the correct column at the end of a composite character like ❤️‍🩹 (mending heart; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) which is comprised of more than one Unicode code point, if the caret is at the start of the composite character. Also returns the correct column with the caret at mid grapheme and for non-composite characters.\n[b]Note:[/b] To check at caret location use [code]get_next_composite_character_column(get_caret_line(), get_caret_column())[/code]"
msgstr "Visszaadja az összetett karakter – például a ❤️‍🩹 (gyógyuló szív; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) – vége utáni helyes oszlopot, ha a kurzor a karakter elején áll. Az ilyen karakterek több Unicode-kódpontból állnak. A metódus akkor is a helyes oszlopot adja vissza, ha a kurzor egy graféma belsejében áll, illetve ha a karakter nem összetett.\n[b]Megjegyzés:[/b] A kurzor aktuális helyén így ellenőrizheted: [code]get_next_composite_character_column(get_caret_line(), get_caret_column())[/code]"

#. TextEdit.get_next_visible_line_index_offset_from
#: doc/classes/TextEdit.xml
msgid "Similar to [method get_next_visible_line_offset_from], but takes into account the line wrap indexes. In the returned vector, [code]x[/code] is the line, [code]y[/code] is the wrap index."
msgstr "A [method get_next_visible_line_offset_from] metódushoz hasonlóan működik, de a sortördelési szakaszokat is figyelembe veszi. A visszaadott vektorban az [code]x[/code] a sort, az [code]y[/code] a tördelési szakasz indexét jelöli."

#. TextEdit.get_next_visible_line_offset_from
#: doc/classes/TextEdit.xml
msgid "Returns the count to the next visible line from [param line] to [code]line + visible_amount[/code]. Can also count backwards. For example if a [TextEdit] has 5 lines with lines 2 and 3 hidden, calling this with [code]line = 1, visible_amount = 1[/code] would return 3."
msgstr "Visszaadja, hány sort kell lépni a [param line] sortól a következő megadott számú látható sorig, azaz a [code]line + visible_amount[/code] szerinti látható pozícióig. Visszafelé is képes számolni. Ha például egy [TextEdit] öt sorból áll, amelyek közül a 2. és a 3. rejtett, akkor [code]line = 1, visible_amount = 1[/code] esetén 3 értéket ad vissza."

#. TextEdit.get_pos_at_line_column
#: doc/classes/TextEdit.xml
msgid "Returns the local position for the given [param line] and [param column]. If [code]x[/code] or [code]y[/code] of the returned vector equal [code]-1[/code], the position is outside of the viewable area of the control.\n[b]Note:[/b] The Y position corresponds to the bottom side of the line. Use [method get_rect_at_line_column] to get the top side position."
msgstr "Visszaadja a megadott [param line] sor és [param column] oszlop helyi pozícióját. Ha a visszaadott vektor [code]x[/code] vagy [code]y[/code] koordinátája [code]-1[/code], a pozíció a vezérlő látható területén kívül van.\n[b]Megjegyzés:[/b] Az Y pozíció a sor alsó széléhez tartozik. A felső szél pozíciójához használd a [method get_rect_at_line_column] metódust."

#. TextEdit.get_previous_composite_character_column
#: doc/classes/TextEdit.xml
msgid "Returns the correct column at the start of a composite character like ❤️‍🩹 (mending heart; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) which is comprised of more than one Unicode code point, if the caret is at the end of the composite character. Also returns the correct column with the caret at mid grapheme and for non-composite characters.\n[b]Note:[/b] To check at caret location use [code]get_previous_composite_character_column(get_caret_line(), get_caret_column())[/code]"
msgstr "Visszaadja a helyes oszlopot egy több Unicode-kódpontból álló összetett karakter – például ❤️‍🩹 (gyógyuló szív; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) – elején, ha a szövegkurzor a karakter végén áll. Akkor is a megfelelő oszlopot adja vissza, ha a kurzor egy graféma belsejében áll, illetve nem összetett karakterek esetén is.\n[b]Megjegyzés:[/b] A kurzor aktuális helyének ellenőrzéséhez használd: [code]get_previous_composite_character_column(get_caret_line(), get_caret_column())[/code]"

#. TextEdit.get_rect_at_line_column
#: doc/classes/TextEdit.xml
msgid "Returns the local position and size for the grapheme at the given [param line] and [param column]. If [code]x[/code] or [code]y[/code] position of the returned rect equal [code]-1[/code], the position is outside of the viewable area of the control.\n[b]Note:[/b] The Y position of the returned rect corresponds to the top side of the line, unlike [method get_pos_at_line_column] which returns the bottom side."
msgstr "Visszaadja a megadott [param line] sor és [param column] oszlop grafémájának helyi pozícióját és méretét. Ha a visszaadott téglalap [code]x[/code] vagy [code]y[/code] koordinátája [code]-1[/code], a pozíció a vezérlő látható területén kívül esik.\n[b]Megjegyzés:[/b] A téglalap Y koordinátája a sor felső széléhez tartozik, szemben a [method get_pos_at_line_column] eredményével, amely az alsó szélet adja meg."

#. TextEdit.get_saved_version
#: doc/classes/TextEdit.xml
msgid "Returns the last tagged saved version from [method tag_saved_version]."
msgstr "Visszaadja a [method tag_saved_version] metódussal utoljára megjelölt mentett verziót."

#. TextEdit.get_scroll_pos_for_line
#: doc/classes/TextEdit.xml
msgid "Returns the scroll position for [param wrap_index] of [param line]."
msgstr "Visszaadja a [param line] sor [param wrap_index] tördelési szakaszához tartozó görgetési pozíciót."

#. TextEdit.get_selected_text
#: doc/classes/TextEdit.xml
msgid "Returns the text inside the selection of a caret, or all the carets if [param caret_index] is its default value [code]-1[/code]."
msgstr "Visszaadja egy szövegkurzor kijelölésének szövegét, vagy az összes kurzor kijelölését, ha a [param caret_index] az alapértelmezett [code]-1[/code] értéken marad."

#. TextEdit.get_selection_at_line_column
#: doc/classes/TextEdit.xml
msgid "Returns the caret index of the selection at the given [param line] and [param column], or [code]-1[/code] if there is none.\nIf [param include_edges] is [code]false[/code], the position must be inside the selection and not at either end. If [param only_selections] is [code]false[/code], carets without a selection will also be considered."
msgstr "Visszaadja a megadott [param line] sor és [param column] oszlop helyén lévő kijelölés kurzorindexét, vagy [code]-1[/code] értéket, ha nincs ilyen.\nHa a [param include_edges] értéke [code]false[/code], a pozíciónak a kijelölés belsejében kell lennie, nem a végpontjain. Ha a [param only_selections] értéke [code]false[/code], a kijelölés nélküli kurzorokat is figyelembe veszi."

#. TextEdit.get_selection_column
#: doc/classes/TextEdit.xml
msgid "Returns the original start column of the selection."
msgstr "Visszaadja a kijelölés eredeti kezdőoszlopát."

#. TextEdit.get_selection_from_column
#: doc/classes/TextEdit.xml
msgid "Returns the selection begin column. Returns the caret column if there is no selection."
msgstr "Visszaadja a kijelölés kezdőoszlopát. Ha nincs kijelölés, a szövegkurzor oszlopát adja vissza."

#. TextEdit.get_selection_from_line
#: doc/classes/TextEdit.xml
msgid "Returns the selection begin line. Returns the caret line if there is no selection."
msgstr "Visszaadja a kijelölés kezdősorát. Ha nincs kijelölés, a szövegkurzor sorát adja vissza."

#. TextEdit.get_selection_line
#: doc/classes/TextEdit.xml
msgid "Returns the original start line of the selection."
msgstr "Visszaadja a kijelölés eredeti kezdősorát."

#. TextEdit.get_selection_mode
#: doc/classes/TextEdit.xml
msgid "Returns the current selection mode."
msgstr "Visszaadja az aktuális kijelölési módot."

#. TextEdit.get_selection_origin_column
#: doc/classes/TextEdit.xml
msgid "Returns the origin column of the selection. This is the opposite end from the caret."
msgstr "Visszaadja a kijelölés kiindulóoszlopát. Ez a kijelölésnek a szövegkurzorral ellentétes végpontja."

#. TextEdit.get_selection_origin_line
#: doc/classes/TextEdit.xml
msgid "Returns the origin line of the selection. This is the opposite end from the caret."
msgstr "Visszaadja a kijelölés kiindulósorát. Ez a kijelölésnek a szövegkurzorral ellentétes végpontja."

#. TextEdit.get_selection_to_column
#: doc/classes/TextEdit.xml
msgid "Returns the selection end column. Returns the caret column if there is no selection."
msgstr "Visszaadja a kijelölés záróoszlopát. Ha nincs kijelölés, a szövegkurzor oszlopát adja vissza."

#. TextEdit.get_selection_to_line
#: doc/classes/TextEdit.xml
msgid "Returns the selection end line. Returns the caret line if there is no selection."
msgstr "Visszaadja a kijelölés zárósorát. Ha nincs kijelölés, a szövegkurzor sorát adja vissza."

#. TextEdit.get_sorted_carets
#: doc/classes/TextEdit.xml
msgid "Returns the carets sorted by selection beginning from lowest line and column to highest (from top to bottom of text).\nIf [param include_ignored_carets] is [code]false[/code], carets from [method multicaret_edit_ignore_caret] will be ignored."
msgstr "Visszaadja a szövegkurzorokat a kijelölésük kezdete szerint, sor és oszlop alapján növekvő sorrendbe rendezve (a szöveg tetejétől az aljáig).\nHa a [param include_ignored_carets] értéke [code]false[/code], kihagyja a [method multicaret_edit_ignore_caret] által mellőzött kurzorokat."

#. TextEdit.get_tab_size
#: doc/classes/TextEdit.xml
msgid "Returns the [TextEdit]'s' tab size."
msgstr "Visszaadja a [TextEdit] tabulátorméretét."

#. TextEdit.get_total_gutter_width
#: doc/classes/TextEdit.xml
msgid "Returns the total width of all gutters and internal padding."
msgstr "Visszaadja az összes oldalsáv és a belső térközök együttes szélességét."

#. TextEdit.get_total_visible_line_count
#: doc/classes/TextEdit.xml
msgid "Returns the total number of lines in the text. This includes wrapped lines and excludes folded lines. If [member wrap_mode] is set to [constant LINE_WRAPPING_NONE] and no lines are folded (see [method CodeEdit.is_line_folded]) then this is equivalent to [method get_line_count]. See [method get_visible_line_count_in_range] for a limited range of lines."
msgstr "Visszaadja a szöveg összes látható sorának számát. A tördelésből létrejövő sorokat beleszámítja, az összecsukott sorokat azonban nem. Ha a [member wrap_mode] értéke [constant LINE_WRAPPING_NONE], és nincs összecsukott sor (lásd: [method CodeEdit.is_line_folded]), az eredmény megegyezik a [method get_line_count] értékével. Meghatározott sortartományhoz lásd: [method get_visible_line_count_in_range]."

#. TextEdit.get_v_scroll_bar
#: doc/classes/TextEdit.xml
msgid "Returns the [VScrollBar] of the [TextEdit]."
msgstr "Visszaadja a [TextEdit] vezérlő [VScrollBar] görgetősávját."

#. TextEdit.get_version
#: doc/classes/TextEdit.xml
msgid "Returns the current version of the [TextEdit]. The version is a count of recorded operations by the undo/redo history."
msgstr "Visszaadja a [TextEdit] aktuális verzióját. A verzió a visszavonási és újravégrehajtási előzményekben rögzített műveletek számát jelenti."

#. TextEdit.get_visible_line_count
#: doc/classes/TextEdit.xml
msgid "Returns the number of lines that can visually fit, rounded down, based on this control's height."
msgstr "Visszaadja a vezérlő magassága alapján láthatóan elférő sorok számát, lefelé kerekítve."

#. TextEdit.get_visible_line_count_in_range
#: doc/classes/TextEdit.xml
msgid "Returns the total number of lines between [param from_line] and [param to_line] (inclusive) in the text. This includes wrapped lines and excludes folded lines. If the range covers all lines it is equivalent to [method get_total_visible_line_count]."
msgstr "Visszaadja a [param from_line] és a [param to_line] közötti sorok számát, a két végpontot is beleértve. A tördelésből létrejött sorokat beszámítja, az összecsukott sorokat nem. Ha a tartomány minden sort lefed, az eredmény megegyezik a [method get_total_visible_line_count] értékével."

#. TextEdit.get_word_at_pos
#: doc/classes/TextEdit.xml
msgid "Returns the word at [param position]."
msgstr "Visszaadja a [param position] pozíciónál található szót."

#. TextEdit.get_word_under_caret
#: doc/classes/TextEdit.xml
msgid "Returns a [String] text with the word under the caret's location."
msgstr "A szövegkurzor alatti szót tartalmazó [String] értéket adja vissza."

#. TextEdit.insert_line_at
#: doc/classes/TextEdit.xml
msgid "Inserts a new line with [param text] at [param line]."
msgstr "Új sort szúr be a [param text] szöveggel a [param line] helyére."

#. TextEdit.insert_text
#: doc/classes/TextEdit.xml
msgid "Inserts the [param text] at [param line] and [param column].\nIf [param before_selection_begin] is [code]true[/code], carets and selections that begin at [param line] and [param column] will moved to the end of the inserted text, along with all carets after it.\nIf [param before_selection_end] is [code]true[/code], selections that end at [param line] and [param column] will be extended to the end of the inserted text. These parameters can be used to insert text inside of or outside of selections."
msgstr "Beszúrja a [param text] szöveget a [param line] sor [param column] oszlopába.\nHa a [param before_selection_begin] értéke [code]true[/code], a [param line] és [param column] helyen kezdődő kurzorok és kijelölések a beszúrt szöveg végére kerülnek, az utánuk lévő összes kurzorral együtt.\nHa a [param before_selection_end] értéke [code]true[/code], a [param line] és [param column] helyen végződő kijelölések a beszúrt szöveg végéig bővülnek. Ezekkel a paraméterekkel a kijelölésen belülre vagy azon kívülre is beszúrhatsz szöveget."

#. TextEdit.insert_text_at_caret
#: doc/classes/TextEdit.xml
msgid "Insert the specified text at the caret position."
msgstr "Beszúrja a megadott szöveget a szövegkurzor helyére."

#. TextEdit.is_caret_after_selection_origin
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the caret of the selection is after the selection origin. This can be used to determine the direction of the selection."
msgstr "[code]true[/code] értéket ad vissza, ha a kijelölés kurzora a kijelölés kiindulópontja után áll. Ezzel meghatározható a kijelölés iránya."

#. TextEdit.is_caret_visible
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the caret is visible, [code]false[/code] otherwise. A caret will be considered hidden if it is outside the scrollable area when scrolling is enabled.\n[b]Note:[/b] [method is_caret_visible] does not account for a caret being off-screen if it is still within the scrollable area. It will return [code]true[/code] even if the caret is off-screen as long as it meets [TextEdit]'s own conditions for being visible. This includes uses of [member scroll_fit_content_width] and [member scroll_fit_content_height] that cause the [TextEdit] to expand beyond the viewport's bounds.\n[b]Note:[/b] This method does [i]not[/i] guarantee an accurate visibility check immediately after setting the caret position. The correct value may only be available in the next frame after the [TextEdit] has finished drawing. This also applies to any operation that causes the [TextEdit] to change in size."
msgstr "[code]true[/code] értéket ad vissza, ha a kurzor látható, egyébként [code]false[/code] értéket. Görgetés engedélyezésekor a kurzor rejtettnek számít, ha a görgethető területen kívül van.\n[b]Megjegyzés:[/b] A [method is_caret_visible] nem veszi figyelembe, ha a kurzor a képernyőn kívül van, de a görgethető területen belül marad. Ilyenkor [code]true[/code] értéket is adhat, ha teljesülnek a [TextEdit] saját láthatósági feltételei. Ez a [member scroll_fit_content_width] és a [member scroll_fit_content_height] használatakor is előfordulhat, ha a [TextEdit] túlnyúlik a nézet határain.\n[b]Megjegyzés:[/b] Ez a metódus [i]nem[/i] garantál pontos eredményt közvetlenül a kurzor helyének beállítása után. A helyes érték esetleg csak a következő képkockában érhető el, miután a [TextEdit] befejezte a kirajzolást. Ugyanez érvényes a [TextEdit] méretét módosító műveletekre."

#. TextEdit.is_dragging_cursor
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the user is dragging their mouse for scrolling, selecting, or text dragging."
msgstr "[code]true[/code] értéket ad vissza, ha a felhasználó egérhúzással görget, kijelöl vagy szöveget húz át."

#. TextEdit.is_gutter_clickable
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the gutter at the given index is clickable. See [method set_gutter_clickable]."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott indexű oldalsáv kattintható. Lásd: [method set_gutter_clickable]."

#. TextEdit.is_gutter_drawn
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the gutter at the given index is currently drawn. See [method set_gutter_draw]."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott indexű oldalsáv jelenleg ki van rajzolva. Lásd: [method set_gutter_draw]."

#. TextEdit.is_gutter_overwritable
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the gutter at the given index is overwritable. See [method set_gutter_overwritable]."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott indexű oldalsáv felülírható. Lásd: [method set_gutter_overwritable]."

#. TextEdit.is_in_mulitcaret_edit
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if a [method begin_multicaret_edit] has been called and [method end_multicaret_edit] has not yet been called."
msgstr "[code]true[/code] értéket ad vissza, ha a [method begin_multicaret_edit] már meghívódott, de a [method end_multicaret_edit] még nem."

#. TextEdit.is_line_gutter_clickable
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the gutter at the given index on the given line is clickable. See [method set_line_gutter_clickable]."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott sor megadott indexű oldalsávja kattintható. Lásd: [method set_line_gutter_clickable]."

#. TextEdit.is_line_in_viewport
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the given line is within the scope of the scrollable area of the viewport."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott sor a nézet görgethető területén belül található."

#. TextEdit.is_line_wrapped
#: doc/classes/TextEdit.xml
msgid "Returns if the given line is wrapped."
msgstr "Jelzi, hogy a megadott sor tördelve van-e."

#. TextEdit.is_menu_visible
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the menu is visible. Use this instead of [code]get_menu().visible[/code] to improve performance (so the creation of the menu is avoided). See [method get_menu]."
msgstr "[code]true[/code] értéket ad vissza, ha a menü látható. A teljesítmény javítása érdekében ezt használd a [code]get_menu().visible[/code] helyett, mert így elkerülhető a menü létrehozása. Lásd: [method get_menu]."

#. TextEdit.is_mouse_over_selection
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the mouse is over a selection. If [param edges] is [code]true[/code], the edges are considered part of the selection."
msgstr "[code]true[/code] értéket ad vissza, ha az egérmutató kijelölés fölött van. Ha az [param edges] értéke [code]true[/code], a kijelölés szélei is beleszámítanak."

#. TextEdit.is_overtype_mode_enabled
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if overtype mode is enabled. See [method set_overtype_mode_enabled]."
msgstr "[code]true[/code] értéket ad vissza, ha a felülírási mód engedélyezve van. Lásd: [method set_overtype_mode_enabled]."

#. TextEdit.merge_gutters
#: doc/classes/TextEdit.xml
msgid "Merge the gutters from [param from_line] into [param to_line]. Only overwritable gutters will be copied. See [method set_gutter_overwritable]."
msgstr "A [param from_line] sor oldalsávjainak tartalmát összevonja a [param to_line] sor oldalsávjaival. Csak a felülírható oldalsávok kerülnek átmásolásra. Lásd: [method set_gutter_overwritable]."

#. TextEdit.merge_overlapping_carets
#: doc/classes/TextEdit.xml
msgid "Merges any overlapping carets. Will favor the newest caret, or the caret with a selection.\nIf [method is_in_mulitcaret_edit] is [code]true[/code], the merge will be queued to happen at the end of the multicaret edit. See [method begin_multicaret_edit] and [method end_multicaret_edit].\n[b]Note:[/b] This is not called when a caret changes position but after certain actions, so it is possible to get into a state where carets overlap."
msgstr "Összevonja az egymást átfedő szövegkurzorokat. Az újabb kurzort, illetve a kijelöléssel rendelkező kurzort részesíti előnyben.\nHa az [method is_in_mulitcaret_edit] értéke [code]true[/code], az összevonás a többkurzoros szerkesztés végére halasztódik. Lásd: [method begin_multicaret_edit] és [method end_multicaret_edit].\n[b]Megjegyzés:[/b] A metódus nem minden kurzormozgatáskor, hanem bizonyos műveletek után hívódik meg, ezért előfordulhat, hogy a kurzorok átfedik egymást."

#. TextEdit.multicaret_edit_ignore_caret
#: doc/classes/TextEdit.xml
msgid "Returns [code]true[/code] if the given [param caret_index] should be ignored as part of a multicaret edit. See [method begin_multicaret_edit] and [method end_multicaret_edit]. Carets that should be ignored are ones that were part of removed text and will likely be merged at the end of the edit, or carets that were added during the edit.\nIt is recommended to [code]continue[/code] within a loop iterating on multiple carets if a caret should be ignored."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param caret_index] indexű szövegkurzort figyelmen kívül kell hagyni a többkurzoros szerkesztés során. Lásd: [method begin_multicaret_edit] és [method end_multicaret_edit]. Ilyen kurzor lehet az, amely törölt szöveghez tartozott, és várhatóan a szerkesztés végén összevonódik, vagy amelyet szerkesztés közben adtak hozzá.\nTöbb kurzoron végighaladó ciklusban ajánlott a [code]continue[/code] utasítással kihagyni az ilyen kurzort."

#. TextEdit.paste
#: doc/classes/TextEdit.xml
msgid "Paste at the current location. Can be overridden with [method _paste]."
msgstr "Beilleszti a szöveget az aktuális helyre. A [method _paste] metódussal felülírható."

#. TextEdit.paste_primary_clipboard
#: doc/classes/TextEdit.xml
msgid "Pastes the primary clipboard."
msgstr "Beilleszti az elsődleges vágólap tartalmát."

#. TextEdit.redo
#: doc/classes/TextEdit.xml
msgid "Perform redo operation."
msgstr "Újravégrehajtja a korábban visszavont műveletet."

#. TextEdit.remove_caret
#: doc/classes/TextEdit.xml
msgid "Removes the given caret index.\n[b]Note:[/b] This can result in adjustment of all other caret indices."
msgstr "Eltávolítja a megadott indexű szövegkurzort.\n[b]Megjegyzés:[/b] Emiatt a többi kurzor indexe is megváltozhat."

#. TextEdit.remove_gutter
#: doc/classes/TextEdit.xml
msgid "Removes the gutter at the given index."
msgstr "Eltávolítja a megadott indexű oldalsávot."

#. TextEdit.remove_line_at
#: doc/classes/TextEdit.xml
msgid "Removes the line of text at [param line]. Carets on this line will attempt to match their previous visual x position.\nIf [param move_carets_down] is [code]true[/code] carets will move to the next line down, otherwise carets will move up."
msgstr "Eltávolítja a [param line] sorban lévő szöveget. Az ott található kurzorok megpróbálják megtartani korábbi vízszintes megjelenítési pozíciójukat.\nHa a [param move_carets_down] értéke [code]true[/code], a kurzorok a következő sorba kerülnek, egyébként felfelé mozognak."

#. TextEdit.remove_secondary_carets
#: doc/classes/TextEdit.xml
msgid "Removes all additional carets."
msgstr "Eltávolítja az összes további szövegkurzort."

#. TextEdit.remove_text
#: doc/classes/TextEdit.xml
msgid "Removes text between the given positions."
msgstr "Eltávolítja a megadott pozíciók közötti szöveget."

#. TextEdit.search
#: doc/classes/TextEdit.xml
msgid "Perform a search inside the text. Search flags can be specified in the [enum SearchFlags] enum.\nIn the returned vector, [code]x[/code] is the column, [code]y[/code] is the line. If no results are found, both are equal to [code]-1[/code].\n[codeblocks]\n[gdscript]\nvar result = search(\"print\", SEARCH_WHOLE_WORDS, 0, 0)\nif result.x != -1:\n\t# Result found.\n\tvar line_number = result.y\n\tvar column_number = result.x\n[/gdscript]\n[csharp]\nVector2I result = Search(\"print\", (uint)TextEdit.SearchFlags.WholeWords, 0, 0);\nif (result.X != -1)\n{\n\t// Result found.\n\tint lineNumber = result.Y;\n\tint columnNumber = result.X;\n}\n[/csharp]\n[/codeblocks]"
msgstr "Keresést végez a szövegben. A keresési jelzőket a [enum SearchFlags] felsorolásban adhatod meg.\nA visszaadott vektorban az [code]x[/code] az oszlopot, az [code]y[/code] a sort jelenti. Ha nincs találat, mindkettő értéke [code]-1[/code].\n[codeblocks]\n[gdscript]\nvar result = search(\"print\", SEARCH_WHOLE_WORDS, 0, 0)\nif result.x != -1:\n\t# Result found.\n\tvar line_number = result.y\n\tvar column_number = result.x\n[/gdscript]\n[csharp]\nVector2I result = Search(\"print\", (uint)TextEdit.SearchFlags.WholeWords, 0, 0);\nif (result.X != -1)\n{\n\t// Result found.\n\tint lineNumber = result.Y;\n\tint columnNumber = result.X;\n}\n[/csharp]\n[/codeblocks]"

#. TextEdit.select
#: doc/classes/TextEdit.xml
msgid "Selects text from [param origin_line] and [param origin_column] to [param caret_line] and [param caret_column] for the given [param caret_index]. This moves the selection origin and the caret. If the positions are the same, the selection will be deselected.\nIf [member selecting_enabled] is [code]false[/code], no selection will occur.\n[b]Note:[/b] If supporting multiple carets this will not check for any overlap. See [method merge_overlapping_carets]."
msgstr "Kijelöli a szöveget a [param origin_line] sor és [param origin_column] oszlop helyétől a [param caret_line] sor és [param caret_column] oszlop helyéig, a [param caret_index] indexű kurzorhoz. Ezzel a kijelölés kezdőpontja és a kurzor helye is megváltozik. Ha a két pozíció azonos, a kijelölés megszűnik.\nHa a [member selecting_enabled] értéke [code]false[/code], nem történik kijelölés.\n[b]Megjegyzés:[/b] Több kurzor használatakor ez nem ellenőrzi az átfedéseket. Lásd: [method merge_overlapping_carets]."

#. TextEdit.select_all
#: doc/classes/TextEdit.xml
msgid "Select all the text.\nIf [member selecting_enabled] is [code]false[/code], no selection will occur."
msgstr "Kijelöli az egész szöveget.\nHa a [member selecting_enabled] értéke [code]false[/code], nem történik kijelölés."

#. TextEdit.select_word_under_caret
#: doc/classes/TextEdit.xml
msgid "Selects the word under the caret."
msgstr "Kijelöli a szövegkurzor alatti szót."

#. TextEdit.set_caret_column
#: doc/classes/TextEdit.xml
msgid "Moves the caret to the specified [param column] index.\nIf [param adjust_viewport] is [code]true[/code], the viewport will center at the caret position after the move occurs.\n[b]Note:[/b] If supporting multiple carets this will not check for any overlap. See [method merge_overlapping_carets]."
msgstr "A szövegkurzort a megadott [param column] oszlopindexre helyezi.\nHa az [param adjust_viewport] értéke [code]true[/code], a mozgatás után a nézet a kurzor helyére központosul.\n[b]Megjegyzés:[/b] Több kurzor használatakor ez a művelet nem ellenőrzi az átfedéseket. Lásd: [method merge_overlapping_carets]."

#. TextEdit.set_caret_line
#: doc/classes/TextEdit.xml
msgid "Moves the caret to the specified [param line] index. The caret column will be moved to the same visual position it was at the last time [method set_caret_column] was called, or clamped to the end of the line.\nIf [param adjust_viewport] is [code]true[/code], the viewport will center at the caret position after the move occurs.\nIf [param can_be_hidden] is [code]true[/code], the specified [param line] can be hidden.\nIf [param wrap_index] is [code]-1[/code], the caret column will be clamped to the [param line]'s length. If [param wrap_index] is greater than [code]-1[/code], the column will be moved to attempt to match the visual x position on the line's [param wrap_index] to the position from the last time [method set_caret_column] was called.\n[b]Note:[/b] If supporting multiple carets this will not check for any overlap. See [method merge_overlapping_carets]."
msgstr "A szövegkurzort a megadott [param line] sorindexre helyezi. A kurzor oszlopa megpróbálja megtartani azt a látható vízszintes pozíciót, amelyen a [method set_caret_column] utolsó meghívásakor állt; szükség esetén a sor végére korlátozódik.\nHa az [param adjust_viewport] értéke [code]true[/code], a mozgatás után a nézet a kurzor helyére központosul.\nHa a [param can_be_hidden] értéke [code]true[/code], a megadott [param line] lehet rejtett sor is.\nHa a [param wrap_index] értéke [code]-1[/code], a kurzor oszlopát a [param line] hosszához igazítja. Ha a [param wrap_index] nagyobb [code]-1[/code]-nél, a kurzor oszlopa megpróbálja megtartani a [param wrap_index] tördelési szakaszban a [method set_caret_column] utolsó meghívásakor érvényes látható x pozíciót.\n[b]Megjegyzés:[/b] Több kurzor használatakor ez a művelet nem ellenőrzi az átfedéseket. Lásd: [method merge_overlapping_carets]."

#. TextEdit.set_gutter_clickable
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], the mouse cursor will change to a pointing hand ([constant Control.CURSOR_POINTING_HAND]) when hovering over the gutter at the given index. See [method is_gutter_clickable] and [method set_line_gutter_clickable]."
msgstr "Ha az érték [code]true[/code], az egérmutató mutató kézzé ([constant Control.CURSOR_POINTING_HAND]) változik, amikor a megadott indexű oldalsáv fölé kerül. Lásd: [method is_gutter_clickable] és [method set_line_gutter_clickable]."

#. TextEdit.set_gutter_custom_draw
#: doc/classes/TextEdit.xml
msgid "Set a custom draw callback for the gutter at the given index. [param draw_callback] must take the following arguments: A line index [int], a gutter index [int], and an area [Rect2]. This callback only works when the gutter type is [constant GUTTER_TYPE_CUSTOM] (see [method set_gutter_type])."
msgstr "Egyéni kirajzolási visszahívást állít be a megadott indexű oldalsávhoz. A [param draw_callback] a következő argumentumokat fogadja: sorindex [int], oldalsávindex [int] és terület [Rect2]. Ez a visszahívás csak [constant GUTTER_TYPE_CUSTOM] oldalsávtípusnál működik (lásd: [method set_gutter_type])."

#. TextEdit.set_gutter_draw
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], the gutter at the given index is drawn. The gutter type ([method set_gutter_type]) determines how it is drawn. See [method is_gutter_drawn]."
msgstr "Ha az érték [code]true[/code], a megadott indexű oldalsáv kirajzolódik. A megjelenés módját az oldalsáv típusa ([method set_gutter_type]) határozza meg. Lásd: [method is_gutter_drawn]."

#. TextEdit.set_gutter_name
#: doc/classes/TextEdit.xml
msgid "Sets the name of the gutter at the given index."
msgstr "Beállítja a megadott indexű oldalsáv nevét."

#. TextEdit.set_gutter_overwritable
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], the line data of the gutter at the given index can be overridden when using [method merge_gutters]. See [method is_gutter_overwritable]."
msgstr "Ha az érték [code]true[/code], az adott indexű oldalsáv soradatai felülírhatók a [method merge_gutters] használatakor. Lásd: [method is_gutter_overwritable]."

#. TextEdit.set_gutter_type
#: doc/classes/TextEdit.xml
msgid "Sets the type of gutter at the given index. Gutters can contain icons, text, or custom visuals."
msgstr "Beállítja a megadott indexű oldalsáv típusát. Az oldalsávok ikonokat, szöveget vagy egyéni grafikus elemeket tartalmazhatnak."

#. TextEdit.set_gutter_width
#: doc/classes/TextEdit.xml
msgid "Set the width of the gutter at the given index."
msgstr "Beállítja a megadott indexű oldalsáv szélességét."

#. TextEdit.set_line
#: doc/classes/TextEdit.xml
msgid "Sets the text for a specific [param line].\nCarets on the line will attempt to keep their visual x position."
msgstr "Beállítja a [param line] sor szövegét.\nA sorban lévő szövegkurzorok megpróbálják megőrizni látható vízszintes pozíciójukat."

#. TextEdit.set_line_as_center_visible
#: doc/classes/TextEdit.xml
msgid "Positions the [param wrap_index] of [param line] at the center of the viewport."
msgstr "A [param line] sor [param wrap_index] tördelési szakaszát a nézet közepére helyezi."

#. TextEdit.set_line_as_first_visible
#: doc/classes/TextEdit.xml
msgid "Positions the [param wrap_index] of [param line] at the top of the viewport."
msgstr "A [param line] sor [param wrap_index] tördelési szakaszát a nézet tetejére helyezi."

#. TextEdit.set_line_as_last_visible
#: doc/classes/TextEdit.xml
msgid "Positions the [param wrap_index] of [param line] at the bottom of the viewport."
msgstr "A [param line] sor [param wrap_index] tördelési szakaszát a nézet aljára helyezi."

#. TextEdit.set_line_background_color
#: doc/classes/TextEdit.xml
msgid "Sets the custom background color of the given line. If transparent, this color is applied on top of the default background color (See [theme_item background_color]). If set to [code]Color(0, 0, 0, 0)[/code], no additional color is applied."
msgstr "Beállítja a megadott sor egyéni háttérszínét. Ha a szín áttetsző, az alapértelmezett háttérszínre kerül rá (lásd: [theme_item background_color]). Ha az érték [code]Color(0, 0, 0, 0)[/code], nem alkalmaz további színt."

#. TextEdit.set_line_gutter_clickable
#: doc/classes/TextEdit.xml
msgid "If [param clickable] is [code]true[/code], makes the [param gutter] on the given [param line] clickable. This is like [method set_gutter_clickable], but for a single line. If [method is_gutter_clickable] is [code]true[/code], this will not have any effect. See [method is_line_gutter_clickable] and [signal gutter_clicked]."
msgstr "Ha a [param clickable] értéke [code]true[/code], a megadott [param line] sor [param gutter] oldalsávja kattintható lesz. A [method set_gutter_clickable] metódushoz hasonlóan működik, de csak egyetlen sorra vonatkozik. Ha az [method is_gutter_clickable] értéke [code]true[/code], ez a beállítás nem hat. Lásd: [method is_line_gutter_clickable] és [signal gutter_clicked]."

#. TextEdit.set_line_gutter_icon
#: doc/classes/TextEdit.xml
msgid "Sets the icon for [param gutter] on [param line] to [param icon]. This only works when the gutter type is [constant GUTTER_TYPE_ICON] (see [method set_gutter_type])."
msgstr "A [param line] sor [param gutter] oldalsávjának ikonját a [param icon] értékre állítja. Csak [constant GUTTER_TYPE_ICON] típusú oldalsávnál működik (lásd: [method set_gutter_type])."

#. TextEdit.set_line_gutter_item_color
#: doc/classes/TextEdit.xml
msgid "Sets the color for [param gutter] on [param line] to [param color]."
msgstr "A [param line] sor [param gutter] oldalsávjának színét a [param color] értékre állítja."

#. TextEdit.set_line_gutter_metadata
#: doc/classes/TextEdit.xml
msgid "Sets the metadata for [param gutter] on [param line] to [param metadata]."
msgstr "A [param line] sor [param gutter] oldalsávjának metaadatát a [param metadata] értékre állítja."

#. TextEdit.set_line_gutter_text
#: doc/classes/TextEdit.xml
msgid "Sets the text for [param gutter] on [param line] to [param text]. This only works when the gutter type is [constant GUTTER_TYPE_STRING] (see [method set_gutter_type])."
msgstr "A [param line] sor [param gutter] oldalsávjának szövegét a [param text] értékre állítja. Csak [constant GUTTER_TYPE_STRING] típusú oldalsávnál működik (lásd: [method set_gutter_type])."

#. TextEdit.set_overtype_mode_enabled
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], enables overtype mode. In this mode, typing overrides existing text instead of inserting text. The [member ProjectSettings.input/ui_text_toggle_insert_mode] action toggles overtype mode. See [method is_overtype_mode_enabled]."
msgstr "Ha az érték [code]true[/code], engedélyezi a felülírási módot. Ebben a módban a gépelés a meglévő szöveget írja felül, nem új szöveget szúr be. A [member ProjectSettings.input/ui_text_toggle_insert_mode] művelettel válthatsz a felülírási mód és a beszúrási mód között. Lásd: [method is_overtype_mode_enabled]."

#. TextEdit.set_search_flags
#: doc/classes/TextEdit.xml
msgid "Sets the search [param flags]. This is used with [method set_search_text] to highlight occurrences of the searched text. Search flags can be specified from the [enum SearchFlags] enum."
msgstr "Beállítja a keresési [param flags] jelzőket. A [method set_search_text] metódussal együtt használva kiemeli a keresett szöveg előfordulásait. A keresési jelzők a [enum SearchFlags] felsorolásból választhatók."

#. TextEdit.set_search_text
#: doc/classes/TextEdit.xml
msgid "Sets the search text. See [method set_search_flags]."
msgstr "Beállítja a keresett szöveget. Lásd: [method set_search_flags]."

#. TextEdit.set_selection_mode
#: doc/classes/TextEdit.xml
msgid "Sets the current selection mode."
msgstr "Beállítja az aktuális kijelölési módot."

#. TextEdit.set_selection_origin_column
#: doc/classes/TextEdit.xml
msgid "Sets the selection origin column to the [param column] for the given [param caret_index]. If the selection origin is moved to the caret position, the selection will deselect."
msgstr "A megadott [param caret_index] indexű kurzor kijelölésének kiindulóoszlopát a [param column] értékre állítja. Ha a kijelölés kiindulópontja a kurzor helyére kerül, a kijelölés megszűnik."

#. TextEdit.set_selection_origin_line
#: doc/classes/TextEdit.xml
msgid "Sets the selection origin line to the [param line] for the given [param caret_index]. If the selection origin is moved to the caret position, the selection will deselect.\nIf [param can_be_hidden] is [code]false[/code], The line will be set to the nearest unhidden line below or above.\nIf [param wrap_index] is [code]-1[/code], the selection origin column will be clamped to the [param line]'s length. If [param wrap_index] is greater than [code]-1[/code], the column will be moved to attempt to match the visual x position on the line's [param wrap_index] to the position from the last time [method set_selection_origin_column] or [method select] was called."
msgstr "A megadott [param caret_index] indexű kurzor kijelölésének kiindulósorát a [param line] értékre állítja. Ha a kijelölés kiindulópontja a kurzor helyére kerül, a kijelölés megszűnik.\nHa a [param can_be_hidden] értéke [code]false[/code], a sor a legközelebbi, alatta vagy fölötte található nem rejtett sorra módosul.\nHa a [param wrap_index] értéke [code]-1[/code], a kijelölés kiindulóoszlopa nem lépheti túl a [param line] sor hosszát. Ha a [param wrap_index] nagyobb [code]-1[/code]-nél, az oszlopot úgy próbálja elhelyezni a sor [param wrap_index] tördelési szakaszán, hogy megőrizze a [method set_selection_origin_column] vagy a [method select] legutóbbi meghívásakor használt látható vízszintes pozíciót."

#. TextEdit.set_tab_size
#: doc/classes/TextEdit.xml
msgid "Sets the tab size for the [TextEdit] to use."
msgstr "Beállítja a [TextEdit] vezérlő által használt tabulátorméretet."

#. TextEdit.set_tooltip_request_func
#: doc/classes/TextEdit.xml
msgid "Provide custom tooltip text. The callback method must take the following args: [code]hovered_word: String[/code]."
msgstr "Egyéni eszköztipp-szöveg megadását teszi lehetővé. A visszahívási metódusnak a következő argumentumot kell fogadnia: [code]hovered_word: String[/code]."

#. TextEdit.skip_selection_for_next_occurrence
#: doc/classes/TextEdit.xml
msgid "Moves a selection and a caret for the next occurrence of the current selection. If there is no active selection, moves to the next occurrence of the word under caret."
msgstr "A kijelölést és a kurzort az aktuálisan kijelölt szöveg következő előfordulásához mozgatja. Ha nincs aktív kijelölés, a kurzor alatti szó következő előfordulására lép."

#. TextEdit.start_action
#: doc/classes/TextEdit.xml
msgid "Starts an action, will end the current action if [param action] is different.\nAn action will also end after a call to [method end_action], after [member ProjectSettings.gui/timers/text_edit_idle_detect_sec] is triggered or a new undoable step outside the [method start_action] and [method end_action] calls."
msgstr "Műveletet indít; ha a [param action] eltér az aktuális művelettől, előbb lezárja azt.\nA művelet akkor is véget ér, ha meghívják a [method end_action] metódust, ha aktiválódik a [member ProjectSettings.gui/timers/text_edit_idle_detect_sec] beállítás szerinti időzítő, vagy ha a [method start_action] és [method end_action] hívásokon kívül új, visszavonható lépés történik."

#. TextEdit.swap_lines
#: doc/classes/TextEdit.xml
msgid "Swaps the two lines. Carets will be swapped with the lines."
msgstr "Felcseréli a két sort. A sorokkal együtt a bennük lévő szövegkurzorok is helyet cserélnek."

#. TextEdit.tag_saved_version
#: doc/classes/TextEdit.xml
msgid "Tag the current version as saved."
msgstr "A jelenlegi verziót mentettként jelöli meg."

#. TextEdit.undo
#: doc/classes/TextEdit.xml
msgid "Perform undo operation."
msgstr "Visszavonja az előző műveletet."

#. TextEdit.autowrap_mode
#: doc/classes/TextEdit.xml
msgid "If [member wrap_mode] is set to [constant LINE_WRAPPING_BOUNDARY], sets text wrapping mode."
msgstr "Beállítja a szöveg tördelési módját, ha a [member wrap_mode] értéke [constant LINE_WRAPPING_BOUNDARY]."

#. TextEdit.caret_draw_when_editable_disabled
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], caret will be visible when [member editable] is disabled."
msgstr "Ha az érték [code]true[/code], a szövegkurzor akkor is látható, ha a [member editable] ki van kapcsolva."

#. TextEdit.caret_move_on_right_click
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], a right-click moves the caret at the mouse position before displaying the context menu.\nIf [code]false[/code], the context menu ignores mouse location."
msgstr "Ha az érték [code]true[/code], jobb kattintáskor a helyi menü megjelenése előtt a szövegkurzor az egérmutató helyére kerül.\nHa az érték [code]false[/code], a helyi menü figyelmen kívül hagyja az egér helyzetét."

#. TextEdit.caret_multiple
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], multiple carets are allowed. Left-clicking with [kbd]Alt[/kbd] adds a new caret. See [method add_caret] and [method get_caret_count]."
msgstr "Ha az érték [code]true[/code], több szövegkurzor használható. Az [kbd]Alt[/kbd] nyomva tartásával végzett bal kattintás új kurzort ad hozzá. Lásd: [method add_caret] és [method get_caret_count]."

#. TextEdit.caret_type
#: doc/classes/TextEdit.xml
msgid "Set the type of caret to draw."
msgstr "Beállítja a kirajzolandó szövegkurzor típusát."

#. TextEdit.context_menu_enabled
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], a right-click displays the context menu."
msgstr "Ha az érték [code]true[/code], a jobb kattintás megjeleníti a helyi menüt."

#. TextEdit.custom_word_separators
#: doc/classes/TextEdit.xml
msgid "The characters to consider as word delimiters if [member use_custom_word_separators] is [code]true[/code]. The characters should be defined without separation, for example [code]#_![/code]."
msgstr "Azokat a karaktereket adja meg, amelyek szóelválasztóként működnek, ha a [member use_custom_word_separators] értéke [code]true[/code]. A karaktereket elválasztás nélkül kell felsorolni, például [code]#_![/code]."

#. TextEdit.drag_and_drop_selection_enabled
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], allow drag and drop of selected text. Text can still be dropped from other sources."
msgstr "Ha az érték [code]true[/code], a kijelölt szöveg húzással áthelyezhető. Más forrásból továbbra is lehet szöveget behúzni."

#. TextEdit.draw_spaces
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], the \"space\" character will have a visible representation."
msgstr "Ha az érték [code]true[/code], a szóközkarakter látható jelölést kap."

#. TextEdit.draw_tabs
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], the \"tab\" character will have a visible representation."
msgstr "Ha az érték [code]true[/code], a tabulátorkarakter látható jelölést kap."

#. TextEdit.empty_selection_clipboard_enabled
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], copying or cutting without a selection is performed on all lines with a caret. Otherwise, copy and cut require a selection."
msgstr "Ha az érték [code]true[/code], kijelölés nélkül a másolás vagy kivágás minden olyan sorra vonatkozik, amelyben szövegkurzor található. Egyébként a másoláshoz és kivágáshoz kijelölés szükséges."

#. TextEdit.highlight_all_occurrences
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], all occurrences of the selected text will be highlighted."
msgstr "Ha az érték [code]true[/code], a kijelölt szöveg összes előfordulása kiemelést kap."

#. TextEdit.highlight_current_line
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], the line containing the cursor is highlighted."
msgstr "Ha az érték [code]true[/code], a kurzort tartalmazó sor kiemelést kap."

#. TextEdit.indent_wrapped_lines
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], all wrapped lines are indented to the same amount as the unwrapped line."
msgstr "Ha az érték [code]true[/code], a tördeléssel létrejött sorok behúzása megegyezik az eredeti sor behúzásával."

#. TextEdit.minimap_draw
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], a minimap is shown, providing an outline of your source code. The minimap uses a fixed-width text size."
msgstr "Ha az érték [code]true[/code], megjelenik a forráskód áttekintését segítő minitérkép. A minitérkép rögzített szélességű betűméretet használ."

#. TextEdit.minimap_width
#: doc/classes/TextEdit.xml
msgid "The width, in pixels, of the minimap."
msgstr "A minitérkép szélessége képpontban."

#. TextEdit.placeholder_text
#: doc/classes/TextEdit.xml
msgid "Text shown when the [TextEdit] is empty. It is [b]not[/b] the [TextEdit]'s default value (see [member text])."
msgstr "A [TextEdit] üres állapotában megjelenő helyőrző szöveg. Ez [b]nem[/b] a [TextEdit] alapértelmezett értéke (lásd: [member text])."

#. TextEdit.scroll_fit_content_height
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], [TextEdit] fits its minimum height to the number of visible lines instead of scrolling vertically. If a maximum height is set (for example via [member Control.custom_maximum_size]) and content exceeds it, a vertical scrollbar is shown."
msgstr "Ha az érték [code]true[/code], a [TextEdit] függőleges görgetés helyett a látható sorok számához igazítja minimális magasságát. Ha maximális magasság van beállítva (például a [member Control.custom_maximum_size] segítségével), és a tartalom ezt meghaladja, függőleges görgetősáv jelenik meg."

#. TextEdit.scroll_fit_content_width
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], [TextEdit] fits its minimum width to the widest line instead of scrolling horizontally. If a maximum width is set (for example via [member Control.custom_maximum_size]) and content exceeds it, a horizontal scrollbar is shown."
msgstr "Ha az érték [code]true[/code], a [TextEdit] vízszintes görgetés helyett a leghosszabb sorhoz igazítja minimális szélességét. Ha maximális szélesség van beállítva (például a [member Control.custom_maximum_size] segítségével), és a tartalom ezt meghaladja, vízszintes görgetősáv jelenik meg."

#. TextEdit.scroll_horizontal
#: doc/classes/TextEdit.xml
msgid "If there is a horizontal scrollbar, this determines the current horizontal scroll value in pixels."
msgstr "Ha van vízszintes görgetősáv, ez határozza meg a vízszintes görgetés aktuális értékét képpontban."

#. TextEdit.scroll_past_end_of_file
#: doc/classes/TextEdit.xml
msgid "Allow scrolling past the last line into \"virtual\" space."
msgstr "Lehetővé teszi a görgetést az utolsó soron túl, a „virtuális” területre."

#. TextEdit.scroll_smooth
#: doc/classes/TextEdit.xml
msgid "Scroll smoothly over the text rather than jumping to the next location."
msgstr "A szövegben a következő pozícióra ugrás helyett folyamatos görgetést használ."

#. TextEdit.scroll_v_scroll_speed
#: doc/classes/TextEdit.xml
msgid "Sets the scroll speed with the minimap or when [member scroll_smooth] is enabled."
msgstr "Beállítja a görgetési sebességet a minitérkép használatakor vagy akkor, amikor a [member scroll_smooth] engedélyezve van."

#. TextEdit.scroll_vertical
#: doc/classes/TextEdit.xml
msgid "If there is a vertical scrollbar, this determines the current vertical scroll value in line numbers, starting at 0 for the top line."
msgstr "Ha van függőleges görgetősáv, ez határozza meg a függőleges görgetés aktuális értékét sorszámokban, ahol a legfelső sor értéke 0."

#. TextEdit.selecting_enabled
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], text can be selected.\nIf [code]false[/code], text can not be selected by the user or by the [method select] or [method select_all] methods."
msgstr "Ha az érték [code]true[/code], a szöveg kijelölhető.\nHa az érték [code]false[/code], a felhasználó nem jelölhet ki szöveget, és a [method select] vagy [method select_all] metódussal sem lehet kijelölést létrehozni."

#. TextEdit.syntax_highlighter
#: doc/classes/TextEdit.xml
msgid "The syntax highlighter to use.\n[b]Note:[/b] A [SyntaxHighlighter] instance should not be used across multiple [TextEdit] nodes."
msgstr "A használni kívánt szintaxiskiemelő.\n[b]Megjegyzés:[/b] Ugyanazt a [SyntaxHighlighter] példányt nem ajánlott több [TextEdit] csomópontban használni."

#. TextEdit.tab_input_mode
#: doc/classes/TextEdit.xml
msgid "If [code]true[/code], [member ProjectSettings.input/ui_text_indent] input [code]Tab[/code] character, otherwise it moves keyboard focus to the next [Control] in the scene."
msgstr "Ha az érték [code]true[/code], a [member ProjectSettings.input/ui_text_indent] bemeneti művelet [code]Tab[/code] karaktert szúr be; ellenkező esetben a billentyűzet fókusza a jelenet következő [Control] vezérlőjére kerül."

#. TextEdit.text
#: doc/classes/TextEdit.xml
msgid "String value of the [TextEdit]."
msgstr "A [TextEdit] szöveges értéke."

#. TextEdit.use_custom_word_separators
#: doc/classes/TextEdit.xml
msgid "If [code]false[/code], using [kbd]Ctrl + Left[/kbd] or [kbd]Ctrl + Right[/kbd] ([kbd]Cmd + Left[/kbd] or [kbd]Cmd + Right[/kbd] on macOS) bindings will use the behavior of [member use_default_word_separators]. If [code]true[/code], it will also stop the caret if a character within [member custom_word_separators] is detected. Useful for subword moving. This behavior also will be applied to the behavior of text selection."
msgstr "Ha az érték [code]false[/code], a [kbd]Ctrl + Left[/kbd] és [kbd]Ctrl + Right[/kbd] (macOS-en [kbd]Cmd + Left[/kbd] és [kbd]Cmd + Right[/kbd]) billentyűkombinációk a [member use_default_word_separators] szerinti módon működnek. Ha az érték [code]true[/code], a kurzor akkor is megáll, ha a [member custom_word_separators] beállításban megadott karakterrel találkozik. Ez a szavakon belüli léptetéshez hasznos. Ugyanez a viselkedés a szöveg kijelölésére is érvényes."

#. TextEdit.use_default_word_separators
#: doc/classes/TextEdit.xml
msgid "If [code]false[/code], using [kbd]Ctrl + Left[/kbd] or [kbd]Ctrl + Right[/kbd] ([kbd]Cmd + Left[/kbd] or [kbd]Cmd + Right[/kbd] on macOS) bindings will stop moving caret only if a space or punctuation is detected. If [code]true[/code], it will also stop the caret if a character is part of [code]!\"#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^`{|}~[/code], the Unicode General Punctuation table, or the Unicode CJK Punctuation table. Useful for subword moving. This behavior also will be applied to the behavior of text selection."
msgstr "Ha az érték [code]false[/code], a [kbd]Ctrl + Left[/kbd] és [kbd]Ctrl + Right[/kbd] (macOS-en [kbd]Cmd + Left[/kbd] és [kbd]Cmd + Right[/kbd]) billentyűkombinációkkal a kurzor csak szóköznél vagy írásjelnél áll meg. Ha az érték [code]true[/code], a kurzor akkor is megáll, ha a karakter a [code]!\"#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^`{|}~[/code] készletbe, a Unicode általános írásjelei közé vagy a Unicode CJK írásjelei közé tartozik. Ez a szavakon belüli léptetéshez hasznos. Ugyanez a viselkedés a szöveg kijelölésére is érvényes."

#. TextEdit.wrap_mode
#: doc/classes/TextEdit.xml
msgid "Sets the line wrapping mode to use."
msgstr "Beállítja a használandó sortördelési módot."

#. TextEdit.caret_changed
#: doc/classes/TextEdit.xml
msgid "Emitted when any caret changes position."
msgstr "Akkor bocsátódik ki, amikor bármelyik szövegkurzor pozíciója megváltozik."

#. TextEdit.gutter_added
#: doc/classes/TextEdit.xml
msgid "Emitted when a gutter is added."
msgstr "Akkor bocsátódik ki, amikor új oldalsávot adnak hozzá."

#. TextEdit.gutter_clicked
#: doc/classes/TextEdit.xml
msgid "Emitted when a gutter is clicked."
msgstr "Akkor bocsátódik ki, amikor egy oldalsávra kattintanak."

#. TextEdit.gutter_removed
#: doc/classes/TextEdit.xml
msgid "Emitted when a gutter is removed."
msgstr "Akkor bocsátódik ki, amikor eltávolítanak egy oldalsávot."

#. TextEdit.lines_edited_from
#: doc/classes/TextEdit.xml
msgid "Emitted immediately when the text changes.\nWhen text is added [param from_line] will be less than [param to_line]. On a remove [param to_line] will be less than [param from_line]."
msgstr "Azonnal kibocsátódik, amikor a szöveg megváltozik.\nSzöveg hozzáadásakor a [param from_line] kisebb, mint a [param to_line]. Törléskor a [param to_line] kisebb, mint a [param from_line]."

#. TextEdit.text_set
#: doc/classes/TextEdit.xml
msgid "Emitted when [method clear] is called or [member text] is set."
msgstr "Akkor bocsátódik ki, amikor meghívják a [method clear] metódust, vagy beállítják a [member text] tulajdonságot."

#. TextEdit.MENU_PASTE
#: doc/classes/TextEdit.xml
msgid "Pastes the clipboard text over the selected text (or at the cursor's position)."
msgstr "A vágólapon lévő szöveget a kijelölt szöveg helyére (vagy a kurzor pozíciójába) illeszti be."

#. TextEdit.MENU_CLEAR
#: doc/classes/TextEdit.xml
msgid "Erases the whole [TextEdit] text."
msgstr "Törli a [TextEdit] teljes szövegét."

#. TextEdit.MENU_SELECT_ALL
#: doc/classes/TextEdit.xml
msgid "Selects the whole [TextEdit] text."
msgstr "Kijelöli a [TextEdit] teljes szövegét."

#. TextEdit.MENU_REDO
#: doc/classes/TextEdit.xml
msgid "Redoes the previous action."
msgstr "Újra végrehajtja az előzőleg visszavont műveletet."

#. TextEdit.ACTION_NONE
#: doc/classes/TextEdit.xml
msgid "No current action."
msgstr "Jelenleg nincs folyamatban művelet."

#. TextEdit.ACTION_TYPING
#: doc/classes/TextEdit.xml
msgid "A typing action."
msgstr "Szövegbeviteli művelet."

#. TextEdit.ACTION_BACKSPACE
#: doc/classes/TextEdit.xml
msgid "A backwards delete action."
msgstr "Visszafelé törlő művelet."

#. TextEdit.ACTION_DELETE
#: doc/classes/TextEdit.xml
msgid "A forward delete action."
msgstr "Előrefelé törlő művelet."

#. TextEdit.SEARCH_MATCH_CASE
#: doc/classes/TextEdit.xml
msgid "Match case when searching."
msgstr "A keresés megkülönbözteti a kis- és nagybetűket."

#. TextEdit.SEARCH_WHOLE_WORDS
#: doc/classes/TextEdit.xml
msgid "Match whole words when searching."
msgstr "A keresés csak teljes szavakra illeszkedik."

#. TextEdit.SEARCH_BACKWARDS
#: doc/classes/TextEdit.xml
msgid "Search from end to beginning."
msgstr "A keresés a szöveg végétől az eleje felé halad."

#. TextEdit.CARET_TYPE_LINE
#: doc/classes/TextEdit.xml
msgid "Vertical line caret."
msgstr "Függőleges vonal alakú szövegkurzor."

#. TextEdit.CARET_TYPE_BLOCK
#: doc/classes/TextEdit.xml
msgid "Block caret."
msgstr "Téglalap alakú szövegkurzor."

#. TextEdit.SELECTION_MODE_NONE
#: doc/classes/TextEdit.xml
msgid "Not selecting."
msgstr "Nincs kijelölés."

#. TextEdit.SELECTION_MODE_SHIFT
#: doc/classes/TextEdit.xml
msgid "Select as if [code]shift[/code] is pressed."
msgstr "Úgy jelöl ki, mintha a [code]shift[/code] billentyű nyomva lenne."

#. TextEdit.SELECTION_MODE_POINTER
#: doc/classes/TextEdit.xml
msgid "Select single characters as if the user single clicked."
msgstr "Egyes karaktereket jelöl ki, mintha a felhasználó egyszer kattintott volna."

#. TextEdit.SELECTION_MODE_WORD
#: doc/classes/TextEdit.xml
msgid "Select whole words as if the user double clicked."
msgstr "Teljes szavakat jelöl ki, mintha a felhasználó kétszer kattintott volna."

#. TextEdit.SELECTION_MODE_LINE
#: doc/classes/TextEdit.xml
msgid "Select whole lines as if the user triple clicked."
msgstr "Teljes sorokat jelöl ki, mintha a felhasználó háromszor kattintott volna."

#. TextEdit.LINE_WRAPPING_NONE
#: doc/classes/TextEdit.xml
msgid "Line wrapping is disabled."
msgstr "A sortördelés ki van kapcsolva."

#. TextEdit.LINE_WRAPPING_BOUNDARY
#: doc/classes/TextEdit.xml
msgid "Line wrapping occurs at the control boundary, beyond what would normally be visible."
msgstr "A sorok a vezérlő határán tördelődnek, ahol a szöveg egyébként már nem lenne látható."

#. TextEdit.GUTTER_TYPE_STRING
#: doc/classes/TextEdit.xml
msgid "When a gutter is set to string using [method set_gutter_type], it is used to contain text set via the [method set_line_gutter_text] method."
msgstr "Ha a [method set_gutter_type] metódussal szöveges típusúra állítod az oldalsávot, a [method set_line_gutter_text] metódussal beállított szöveget tartalmazza."

#. TextEdit.GUTTER_TYPE_ICON
#: doc/classes/TextEdit.xml
msgid "When a gutter is set to icon using [method set_gutter_type], it is used to contain an icon set via the [method set_line_gutter_icon] method."
msgstr "Ha a [method set_gutter_type] metódussal ikon típusúra állítod az oldalsávot, a [method set_line_gutter_icon] metódussal beállított ikont tartalmazza."

#. TextEdit.GUTTER_TYPE_CUSTOM
#: doc/classes/TextEdit.xml
msgid "When a gutter is set to custom using [method set_gutter_type], it is used to contain custom visuals controlled by a callback method set via the [method set_gutter_custom_draw] method."
msgstr "Ha a [method set_gutter_type] metódussal egyéni típusúra állítod az oldalsávot, a [method set_gutter_custom_draw] metódussal beállított visszahívás által vezérelt egyéni grafikus elemeket tartalmazza."

#. TextEdit.theme_item.background_color
#: doc/classes/TextEdit.xml
msgid "Sets the background [Color] of this [TextEdit]."
msgstr "Beállítja a [TextEdit] háttérszínét ([Color])."

#. TextEdit.theme_item.caret_background_color
#: doc/classes/TextEdit.xml
msgid "[Color] of the text behind the caret when using a block caret."
msgstr "Blokk alakú kurzornál a kurzor mögötti szöveg [Color] színe."

#. TextEdit.theme_item.caret_color
#: doc/classes/TextEdit.xml
msgid "[Color] of the caret. This can be set to a fully transparent color to hide the caret entirely."
msgstr "A kurzor [Color] színe. Teljesen átlátszó színnel a kurzor elrejthető."

#. TextEdit.theme_item.current_line_color
#: doc/classes/TextEdit.xml
msgid "Background [Color] of the line containing the caret."
msgstr "A kurzort tartalmazó sor háttérszíne ([Color])."

#. TextEdit.theme_item.font_color
#: doc/classes/TextEdit.xml
msgid "Sets the font [Color]."
msgstr "Beállítja a betűk [Color] színét."

#. TextEdit.theme_item.font_outline_color
#: doc/classes/TextEdit.xml
msgid "The tint of text outline of the [TextEdit]."
msgstr "A [TextEdit] szövegkörvonalának árnyalatszíne."

#. TextEdit.theme_item.font_readonly_color
#: doc/classes/TextEdit.xml
msgid "Sets the font [Color] when [member editable] is disabled."
msgstr "Beállítja a betűk [Color] színét, amikor a [member editable] ki van kapcsolva."

#. TextEdit.theme_item.font_selected_color
#: doc/classes/TextEdit.xml
msgid "Sets the [Color] of the selected text. If equal to [code]Color(0, 0, 0, 0)[/code], it will be ignored."
msgstr "Beállítja a kijelölt szöveg [Color] színét. A [code]Color(0, 0, 0, 0)[/code] értéket figyelmen kívül hagyja."

#. TextEdit.theme_item.search_result_border_color
#: doc/classes/TextEdit.xml
msgid "[Color] of the border around text that matches the search query."
msgstr "A keresésnek megfelelő szöveg körüli keret [Color] színe."

#. TextEdit.theme_item.search_result_color
#: doc/classes/TextEdit.xml
msgid "[Color] behind the text that matches the search query."
msgstr "A keresésnek megfelelő szöveg mögötti [Color] szín."

#. TextEdit.theme_item.selection_color
#: doc/classes/TextEdit.xml
msgid "Sets the highlight [Color] of text selections."
msgstr "Beállítja a kijelölés kiemelő [Color] színét."

#. TextEdit.theme_item.word_highlighted_color
#: doc/classes/TextEdit.xml
msgid "Sets the highlight [Color] of multiple occurrences. [member highlight_all_occurrences] has to be enabled."
msgstr "Beállítja az ismétlődő szövegrészek kiemelő [Color] színét. Ehhez a [member highlight_all_occurrences] engedélyezése szükséges."

#. TextEdit.theme_item.caret_width
#: doc/classes/TextEdit.xml
msgid "The caret's width in pixels. Greater values can be used to improve accessibility by ensuring the caret is easily visible, or to ensure consistency with a large font size. If set to [code]0[/code] or lower, the caret width is automatically set to 1 pixel and multiplied by the display scaling factor."
msgstr "A kurzor szélessége képpontban. Nagyobb értékkel a kurzor könnyebben látható, ami javíthatja a hozzáférhetőséget, illetve nagyobb betűméretnél megőrizheti az arányokat. Ha az érték [code]0[/code] vagy kisebb, a szélesség automatikusan 1 képpont lesz, megszorozva a kijelző skálázási tényezőjével."

#. TextEdit.theme_item.wrap_offset
#: doc/classes/TextEdit.xml
msgid "Sets an additional margin for line wrapping width."
msgstr "További margót állít be a sortördelés szélességéhez."

#. TextEdit.theme_item.font
#: doc/classes/TextEdit.xml
msgid "Sets the default [Font]."
msgstr "Beállítja az alapértelmezett [Font] betűtípust."

#. TextEdit.theme_item.font_size
#: doc/classes/TextEdit.xml
msgid "Sets default font size."
msgstr "Beállítja az alapértelmezett betűméretet."

#. TextEdit.theme_item.space
#: doc/classes/TextEdit.xml
msgid "Sets a custom [Texture2D] for space text characters."
msgstr "Egyéni [Texture2D] textúrát állít be a szóközkarakterekhez."

#. TextEdit.theme_item.tab
#: doc/classes/TextEdit.xml
msgid "Sets a custom [Texture2D] for tab text characters."
msgstr "Egyéni [Texture2D] textúrát állít be a tabulátorkarakterekhez."

#. TextEdit.theme_item.focus
#: doc/classes/TextEdit.xml
msgid "Sets the [StyleBox] when in focus. The [theme_item focus] [StyleBox] is displayed [i]over[/i] the base [StyleBox], so a partially transparent [StyleBox] should be used to ensure the base [StyleBox] remains visible. A [StyleBox] that represents an outline or an underline works well for this purpose. To disable the focus visual effect, assign a [StyleBoxEmpty] resource. Note that disabling the focus visual effect will harm keyboard/controller navigation usability, so this is not recommended for accessibility reasons."
msgstr "Beállítja a fókuszban használt [StyleBox] erőforrást. A [theme_item focus] [StyleBox] az alap [StyleBox] [i]fölött[/i] jelenik meg, ezért célszerű részben átlátszó [StyleBox] erőforrást használni, hogy az alap [StyleBox] is látható legyen. Erre egy körvonalat vagy aláhúzást megjelenítő [StyleBox] megfelelő. A fókuszjelzés kikapcsolásához rendelj hozzá [StyleBoxEmpty] erőforrást. Ez azonban rontja a billentyűzettel és kontrollerrel történő navigáció használhatóságát, ezért akadálymentességi szempontból nem ajánlott."

#. TextEdit.theme_item.normal
#: doc/classes/TextEdit.xml
msgid "Sets the [StyleBox] of this [TextEdit]."
msgstr "Beállítja a [TextEdit] [StyleBox] erőforrását."

#. TextEdit.theme_item.read_only
#: doc/classes/TextEdit.xml
msgid "Sets the [StyleBox] of this [TextEdit] when [member editable] is disabled."
msgstr "Beállítja a [TextEdit] [StyleBox] erőforrását, amikor a [member editable] ki van kapcsolva."

#. TextEdit.brief_description
#: doc/classes/TextEdit.xml
msgid "A multiline text editor."
msgstr "Többsoros szövegszerkesztő."

#. TextEdit.description
#: doc/classes/TextEdit.xml
msgid "A multiline text editor. It also has limited facilities for editing code, such as syntax highlighting support. For more advanced facilities for editing code, see [CodeEdit].\nWhile entering text, it is possible to insert special characters using Unicode, OEM or Windows alt codes:\n- To enter Unicode codepoints, hold [kbd]Alt[/kbd] and type the codepoint on the numpad. For example, to enter the character [code]á[/code] (U+00E1), hold [kbd]Alt[/kbd] and type [kbd]+E1[/kbd] on the numpad (the leading zeroes can be omitted).\n- To enter OEM codepoints, hold [kbd]Alt[/kbd] and type the code on the numpad. For example, to enter the character [code]á[/code] (OEM 160), hold [kbd]Alt[/kbd] and type [code]160[/code] on the numpad.\n- To enter Windows codepoints, hold [kbd]Alt[/kbd] and type the code on the numpad. For example, to enter the character [code]á[/code] (Windows 0225), hold [kbd]Alt[/kbd] and type [kbd]0[/kbd], [kbd]2[/kbd], [kbd]2[/kbd], [kbd]5[/kbd] on the numpad. The leading zero here must [b]not[/b] be omitted, as this is how Windows codepoints are distinguished from OEM codepoints.\n[b]Note:[/b] Most viewport, caret, and edit methods contain a [code]caret_index[/code] argument for [member caret_multiple] support. The argument should be one of the following: [code]-1[/code] for all carets, [code]0[/code] for the main caret, or greater than [code]0[/code] for secondary carets in the order they were created.\n[b]Note:[/b] When holding down [kbd]Alt[/kbd], the vertical scroll wheel will scroll 5 times as fast as it would normally do. This also works in the Godot script editor."
msgstr "Többsoros szövegszerkesztő, amely korlátozott kódszerkesztési funkciókat, például szintaxiskiemelést is támogat. Fejlettebb kódszerkesztéshez lásd: [CodeEdit].\nSzövegbevitelkor Unicode-, OEM- vagy Windows-féle Alt-kódokkal is beszúrhatók speciális karakterek:\n- Unicode-kódpont beviteléhez tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a kódpontot a numerikus billentyűzeten. Például az [code]á[/code] karakter (U+00E1) beviteléhez tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a [kbd]+E1[/kbd] értéket; a kezdő nullák elhagyhatók.\n- OEM-kódpont beviteléhez tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a kódot a numerikus billentyűzeten. Például az [code]á[/code] karakterhez (OEM 160) az [kbd]Alt[/kbd] lenyomva tartása mellett írd be a [code]160[/code] értéket.\n- Windows-kódpont beviteléhez tartsd lenyomva az [kbd]Alt[/kbd] billentyűt, és írd be a kódot a numerikus billentyűzeten. Például az [code]á[/code] karakterhez (Windows 0225) az [kbd]Alt[/kbd] lenyomva tartása mellett üsd le sorban a [kbd]0[/kbd], [kbd]2[/kbd], [kbd]2[/kbd], [kbd]5[/kbd] billentyűket. A kezdő nullát itt [b]nem[/b] szabad elhagyni, mert ez különbözteti meg a Windows-kódpontokat az OEM-kódpontoktól.\n[b]Megjegyzés:[/b] A legtöbb nézet-, kurzor- és szerkesztési metódus [code]caret_index[/code] argumentummal támogatja a [member caret_multiple] funkciót. Az érték [code]-1[/code] lehet az összes kurzorhoz, [code]0[/code] a főkurzorhoz, vagy [code]0[/code]-nál nagyobb a további kurzorokhoz a létrehozásuk sorrendjében.\n[b]Megjegyzés:[/b] Az [kbd]Alt[/kbd] nyomva tartásakor a függőleges egérgörgő a szokásosnál ötször gyorsabban görget. Ez a Godot szkriptszerkesztőjében is működik."

#. Sprite2D.frame_changed
#: doc/classes/Sprite2D.xml
msgid "Emitted when the [member frame] changes."
msgstr "A [member frame] tulajdonság megváltozásakor bocsátódik ki a jelzés."

#. Sprite2D.texture_changed
#: doc/classes/Sprite2D.xml
msgid "Emitted when the [member texture] changes."
msgstr "A [member texture] tulajdonság megváltozásakor bocsátódik ki a jelzés."

#. TileMapLayer.changed
#: doc/classes/TileMapLayer.xml
msgid "Emitted when this [TileMapLayer]'s properties changes. This includes modified cells, properties, or changes made to its assigned [TileSet].\n[b]Note:[/b] This signal may be emitted very often when batch-modifying a [TileMapLayer]. Avoid executing complex processing in a connected function, and consider delaying it to the end of the frame instead (i.e. calling [method Object.call_deferred])."
msgstr "A [TileMapLayer] tulajdonságainak megváltozásakor kerül kibocsátásra. Ilyen változás lehet a cellák módosítása, a tulajdonságok megváltoztatása vagy a hozzárendelt [TileSet] módosulása.\n[b]Megjegyzés:[/b] A [TileMapLayer] több cellájának együttes módosításakor ez a jelzés nagyon gyakran kibocsátásra kerülhet. A hozzá kapcsolt függvényben kerüld a számításigényes műveleteket, és fontold meg a feldolgozás elhalasztását a képkocka végéig (például a [method Object.call_deferred] meghívásával)."

# --- Lektorált 11: új F1-osztálysúgó bejegyzések ---

#. Camera2D.align
#: doc/classes/Camera2D.xml
msgid "Aligns the camera to the tracked node.\n[b]Note:[/b] Calling [method force_update_scroll] after this method is not required."
msgstr "A kamerát a követett csomóponthoz igazítja.\n[b]Megjegyzés:[/b] Ezután nem szükséges meghívni a [method force_update_scroll] metódust."

#. Camera2D.force_update_scroll
#: doc/classes/Camera2D.xml
msgid "Forces the camera to update scroll immediately."
msgstr "Azonnal frissíti a kamera görgetési pozícióját."

#. Camera2D.get_drag_margin
#: doc/classes/Camera2D.xml
msgid "Returns the specified [enum Side]'s margin. See also [member drag_bottom_margin], [member drag_top_margin], [member drag_left_margin], and [member drag_right_margin]."
msgstr "Visszaadja a megadott [enum Side] oldal húzási margóját. Lásd még: [member drag_bottom_margin], [member drag_top_margin], [member drag_left_margin] és [member drag_right_margin]."

#. Camera2D.get_limit
#: doc/classes/Camera2D.xml
msgid "Returns the camera limit for the specified [enum Side]. See also [member limit_bottom], [member limit_top], [member limit_left], and [member limit_right]."
msgstr "Visszaadja a kamera megadott [enum Side] oldalhoz tartozó határértékét. Lásd még: [member limit_bottom], [member limit_top], [member limit_left] és [member limit_right]."

#. Camera2D.get_screen_rotation
#: doc/classes/Camera2D.xml
msgid "Returns the current screen rotation from this camera's point of view.\n[b]Note:[/b] The screen rotation can be different from [member Node2D.global_rotation] if the camera is rotating smoothly due to [member rotation_smoothing_enabled]."
msgstr "Visszaadja a képernyő aktuális elforgatását a kamera nézőpontjából.\n[b]Megjegyzés:[/b] A képernyő elforgatása eltérhet a [member Node2D.global_rotation] értékétől, ha a kamera a [member rotation_smoothing_enabled] miatt simított forgást végez."

#. Camera2D.get_target_position
#: doc/classes/Camera2D.xml
msgid "Returns this camera's target position, in global coordinates.\n[b]Note:[/b] The returned value is not the same as [member Node2D.global_position], as it is affected by the drag properties. It is also not the same as the current position if [member position_smoothing_enabled] is [code]true[/code] (see [method get_screen_center_position])."
msgstr "Visszaadja a kamera célpozícióját globális koordinátákban.\n[b]Megjegyzés:[/b] A visszaadott érték a húzási tulajdonságok miatt eltérhet a [member Node2D.global_position] értékétől. Akkor sem feltétlenül egyezik meg a kamera aktuális pozíciójával, ha a [member position_smoothing_enabled] értéke [code]true[/code] (lásd [method get_screen_center_position])."

#. Camera2D.is_current
#: doc/classes/Camera2D.xml
msgid "Returns [code]true[/code] if this [Camera2D] is the active camera (see [method Viewport.get_camera_2d])."
msgstr "[code]true[/code] értéket ad vissza, ha ez a [Camera2D] az aktív kamera (lásd [method Viewport.get_camera_2d])."

#. Camera2D.set_drag_margin
#: doc/classes/Camera2D.xml
msgid "Sets the specified [enum Side]'s margin. See also [member drag_bottom_margin], [member drag_top_margin], [member drag_left_margin], and [member drag_right_margin]."
msgstr "Beállítja a megadott [enum Side] oldal húzási margóját. Lásd még: [member drag_bottom_margin], [member drag_top_margin], [member drag_left_margin] és [member drag_right_margin]."

#. Camera2D.set_limit
#: doc/classes/Camera2D.xml
msgid "Sets the camera limit for the specified [enum Side]. See also [member limit_bottom], [member limit_top], [member limit_left], and [member limit_right]."
msgstr "Beállítja a kamera megadott [enum Side] oldalhoz tartozó határértékét. Lásd még: [member limit_bottom], [member limit_top], [member limit_left] és [member limit_right]."

#. Camera2D.custom_viewport
#: doc/classes/Camera2D.xml
msgid "The custom [Viewport] node attached to the [Camera2D]. If [code]null[/code] or not a [Viewport], uses the default viewport instead."
msgstr "A [Camera2D] csomóponthoz rendelt egyéni [Viewport] csomópont. Ha az értéke [code]null[/code], vagy nem [Viewport] típusú, akkor az alapértelmezett nézetablakot használja."

#. Camera2D.editor_draw_drag_margin
#: doc/classes/Camera2D.xml
msgid "If [code]true[/code], draws the camera's drag margin rectangle in the editor."
msgstr "Ha [code]true[/code], megjeleníti a kamera húzási margóit jelölő téglalapot a szerkesztőben."

#. Camera2D.process_callback
#: doc/classes/Camera2D.xml
msgid "The camera's process callback."
msgstr "A kamera feldolgozási visszahívása."

#. AnimatedSprite2D.animation_changed
#: doc/classes/AnimatedSprite2D.xml
msgid "Emitted when [member animation] changes."
msgstr "Akkor bocsátódik ki, amikor megváltozik az [member animation] tulajdonság."

#. AnimatedSprite2D.animation_finished
#: doc/classes/AnimatedSprite2D.xml
msgid "Emitted when the animation reaches the end, or the start if it is played in reverse. When the animation finishes, it pauses the playback.\n[b]Note:[/b] This signal is not emitted if an animation is looping."
msgstr "Akkor bocsátódik ki, amikor az animáció a végére ér, illetve visszafelé lejátszva az elejére. Az animáció befejeződésekor a lejátszás szünetel.\n[b]Megjegyzés:[/b] Ismétlődő animáció esetén ez a jel nem bocsátódik ki."

#. AnimatedSprite2D.animation_looped
#: doc/classes/AnimatedSprite2D.xml
msgid "Emitted when the animation loops."
msgstr "Akkor bocsátódik ki, amikor az animáció újrakezdődik."

#. AnimatedSprite2D.frame_changed
#: doc/classes/AnimatedSprite2D.xml
msgid "Emitted when [member frame] changes."
msgstr "Akkor bocsátódik ki, amikor megváltozik a [member frame] tulajdonság."

#. AnimatedSprite2D.sprite_frames_changed
#: doc/classes/AnimatedSprite2D.xml
msgid "Emitted when [member sprite_frames] changes."
msgstr "Akkor bocsátódik ki, amikor megváltozik a [member sprite_frames] tulajdonság."

#. Area2D.angular_damp_space_override
#: doc/classes/Area2D.xml
msgid "Override mode for angular damping calculations within this area."
msgstr "A szögsebesség-csillapítás számításának felülbírálási módja ezen a területen belül."

#. Area2D.linear_damp_space_override
#: doc/classes/Area2D.xml
msgid "Override mode for linear damping calculations within this area."
msgstr "A lineáris csillapítás számításának felülbírálási módja ezen a területen belül."

#. Area2D.area_entered
#: doc/classes/Area2D.xml
msgid "Emitted when the received [param area] enters this area. Requires [member monitoring] to be set to [code]true[/code]."
msgstr "Akkor bocsátódik ki, amikor a megadott [param area] belép erre a területre. Ehhez a [member monitoring] értékének [code]true[/code]-nak kell lennie."

#. Area2D.area_exited
#: doc/classes/Area2D.xml
msgid "Emitted when the received [param area] exits this area. Requires [member monitoring] to be set to [code]true[/code]."
msgstr "Akkor bocsátódik ki, amikor a megadott [param area] elhagyja ezt a területet. Ehhez a [member monitoring] értékének [code]true[/code]-nak kell lennie."

#. Area2D.area_shape_exited
#: doc/classes/Area2D.xml
msgid "Emitted when a [Shape2D] of the received [param area] exits a shape of this area. Requires [member monitoring] to be set to [code]true[/code].\nSee also [signal area_shape_entered]."
msgstr "Akkor bocsátódik ki, amikor a megadott [param area] egyik [Shape2D] alakzata elhagyja ennek a területnek valamelyik alakzatát. Ehhez a [member monitoring] értékének [code]true[/code]-nak kell lennie.\nLásd még: [signal area_shape_entered]."

#. Area2D.body_entered
#: doc/classes/Area2D.xml
msgid "Emitted when the received [param body] enters this area. [param body] can be a [PhysicsBody2D] or a [TileMap]. [TileMap]s are detected if their [TileSet] has collision shapes configured. Requires [member monitoring] to be set to [code]true[/code]."
msgstr "Akkor bocsátódik ki, amikor a megadott [param body] belép erre a területre. A [param body] lehet [PhysicsBody2D] vagy [TileMap]. A [TileMap] csomópontok akkor észlelhetők, ha a [TileSet] ütközési alakzatokat tartalmaz. Ehhez a [member monitoring] értékének [code]true[/code]-nak kell lennie."

#. Area2D.body_exited
#: doc/classes/Area2D.xml
msgid "Emitted when the received [param body] exits this area. [param body] can be a [PhysicsBody2D] or a [TileMap]. [TileMap]s are detected if their [TileSet] has collision shapes configured. Requires [member monitoring] to be set to [code]true[/code]."
msgstr "Akkor bocsátódik ki, amikor a megadott [param body] elhagyja ezt a területet. A [param body] lehet [PhysicsBody2D] vagy [TileMap]. A [TileMap] csomópontok akkor észlelhetők, ha a [TileSet] ütközési alakzatokat tartalmaz. Ehhez a [member monitoring] értékének [code]true[/code]-nak kell lennie."

#. Area2D.body_shape_exited
#: doc/classes/Area2D.xml
msgid "Emitted when a [Shape2D] of the received [param body] exits a shape of this area. [param body] can be a [PhysicsBody2D] or a [TileMap]. [TileMap]s are detected if their [TileSet] has collision shapes configured. Requires [member monitoring] to be set to [code]true[/code].\nSee also [signal body_shape_entered]."
msgstr "Akkor bocsátódik ki, amikor a megadott [param body] egyik [Shape2D] alakzata elhagyja ennek a területnek valamelyik alakzatát. A [param body] lehet [PhysicsBody2D] vagy [TileMap]. A [TileMap] csomópontok akkor észlelhetők, ha a [TileSet] ütközési alakzatokat tartalmaz. Ehhez a [member monitoring] értékének [code]true[/code]-nak kell lennie.\nLásd még: [signal body_shape_entered]."

#. AnimationPlayer.get_method_call_mode
#: doc/classes/AnimationPlayer.xml
msgid "Returns the call mode used for \"Call Method\" tracks."
msgstr "Visszaadja a „Metódus meghívása” sávokhoz használt hívási módot."

#. AnimationPlayer.get_section_end_time
#: doc/classes/AnimationPlayer.xml
msgid "Returns the end time of the section currently being played."
msgstr "Visszaadja az éppen lejátszott szakasz befejezési idejét."

#. AnimationPlayer.get_section_start_time
#: doc/classes/AnimationPlayer.xml
msgid "Returns the start time of the section currently being played."
msgstr "Visszaadja az éppen lejátszott szakasz kezdési idejét."

#. AnimationPlayer.has_section
#: doc/classes/AnimationPlayer.xml
msgid "Returns [code]true[/code] if an animation is currently playing with a section."
msgstr "[code]true[/code] értéket ad vissza, ha az animáció lejátszása jelenleg egy szakaszra korlátozódik."

#. AnimationPlayer.set_method_call_mode
#: doc/classes/AnimationPlayer.xml
msgid "Sets the call mode used for \"Call Method\" tracks."
msgstr "Beállítja a „Metódus meghívása” sávokhoz használt hívási módot."

#. AnimationPlayer.set_root
#: doc/classes/AnimationPlayer.xml
msgid "Sets the node which node path references will travel from."
msgstr "Beállítja azt a csomópontot, amelytől a csomópontútvonalak hivatkozásait feloldja."

#. AnimationPlayer.playback_auto_capture_ease_type
#: doc/classes/AnimationPlayer.xml
msgid "The ease type of the capture interpolation. See also [enum Tween.EaseType]."
msgstr "A rögzített állapotok közötti interpoláció gyorsítási-lassítási típusa. Lásd még: [enum Tween.EaseType]."

#. AnimationPlayer.playback_auto_capture_transition_type
#: doc/classes/AnimationPlayer.xml
msgid "The transition type of the capture interpolation. See also [enum Tween.TransitionType]."
msgstr "A rögzített állapotok közötti interpoláció átmenettípusa. Lásd még: [enum Tween.TransitionType]."

#. AnimationPlayer.current_animation_changed
#: doc/classes/AnimationPlayer.xml
msgid "Emitted when [member current_animation] changes."
msgstr "Akkor bocsátódik ki, amikor megváltozik a [member current_animation] tulajdonság."

#. CollisionObject2D.get_shape_owner_one_way_collision_direction
#: doc/classes/CollisionObject2D.xml
msgid "Returns the [code]one_way_collision_direction[/code] of the shape owner identified by the given [param owner_id]."
msgstr "Visszaadja a megadott [param owner_id] azonosítójú alakzattulajdonos [code]one_way_collision_direction[/code] értékét."

#. CollisionObject2D.get_shape_owner_one_way_collision_margin
#: doc/classes/CollisionObject2D.xml
msgid "Returns the [code]one_way_collision_margin[/code] of the shape owner identified by given [param owner_id]."
msgstr "Visszaadja a megadott [param owner_id] azonosítójú alakzattulajdonos [code]one_way_collision_margin[/code] értékét."

#. CollisionObject2D.shape_owner_get_shape_index
#: doc/classes/CollisionObject2D.xml
msgid "Returns the child index of the [Shape2D] with the given ID from the given shape owner."
msgstr "Visszaadja a megadott alakzattulajdonoshoz tartozó, megadott azonosítójú [Shape2D] gyermekindexét."

#. CollisionObject2D.shape_owner_get_transform
#: doc/classes/CollisionObject2D.xml
msgid "Returns the shape owner's [Transform2D]."
msgstr "Visszaadja az alakzattulajdonos [Transform2D] transzformációját."

#. CollisionObject2D.shape_owner_set_one_way_collision
#: doc/classes/CollisionObject2D.xml
msgid "If [param enable] is [code]true[/code], collisions for the shape owner originating from this [CollisionObject2D] will not be reported to collided with [CollisionObject2D]s."
msgstr "Ha a [param enable] értéke [code]true[/code], az ebből a [CollisionObject2D] objektumból származó alakzattulajdonos ütközéseit a rendszer nem jelenti az érintett [CollisionObject2D] objektumoknak."

#. CollisionObject2D.shape_owner_set_one_way_collision_direction
#: doc/classes/CollisionObject2D.xml
msgid "Sets the [code]one_way_collision_direction[/code] of the shape owner identified by the given [param owner_id] to [param direction]."
msgstr "Beállítja a megadott [param owner_id] azonosítójú alakzattulajdonos [code]one_way_collision_direction[/code] értékét a [param direction] értékre."

#. CollisionObject2D.shape_owner_set_one_way_collision_margin
#: doc/classes/CollisionObject2D.xml
msgid "Sets the [code]one_way_collision_margin[/code] of the shape owner identified by given [param owner_id] to [param margin] pixels."
msgstr "Beállítja a megadott [param owner_id] azonosítójú alakzattulajdonos [code]one_way_collision_margin[/code] értékét [param margin] képpontra."

#. Sprite2D.get_rect
#: doc/classes/Sprite2D.xml
msgid "Returns a [Rect2] representing the Sprite2D's boundary in local coordinates.\n[b]Example:[/b] Detect if the Sprite2D was clicked:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:\n\t\tif get_rect().has_point(to_local(event.position)):\n\t\t\tprint(\"A click!\")\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventMouseButton inputEventMouse)\n\t{\n\t\tif (inputEventMouse.Pressed && inputEventMouse.ButtonIndex == MouseButton.Left)\n\t\t{\n\t\t\tif (GetRect().HasPoint(ToLocal(inputEventMouse.Position)))\n\t\t\t{\n\t\t\t\tGD.Print(\"A click!\");\n\t\t\t}\n\t\t}\n\t}\n}\n[/csharp]\n[/codeblocks]"
msgstr "Visszaadja a Sprite2D helyi koordinátákban megadott határoló téglalapját [Rect2] formájában.\n[b]Példa:[/b] A Sprite2D-re történő kattintás észlelése:\n[codeblocks]\n[gdscript]\nfunc _input(event):\n\tif event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:\n\t\tif get_rect().has_point(to_local(event.position)):\n\t\t\tprint(\"A click!\")\n[/gdscript]\n[csharp]\npublic override void _Input(InputEvent @event)\n{\n\tif (@event is InputEventMouseButton inputEventMouse)\n\t{\n\t\tif (inputEventMouse.Pressed && inputEventMouse.ButtonIndex == MouseButton.Left)\n\t\t{\n\t\t\tif (GetRect().HasPoint(ToLocal(inputEventMouse.Position)))\n\t\t\t{\n\t\t\t\tGD.Print(\"A click!\");\n\t\t\t}\n\t\t}\n\t}\n}\n[/csharp]\n[/codeblocks]"

# --- Lektorált 12: új Godot 4.7.2 F1-bejegyzések ---

#. Timer.is_stopped
#: doc/classes/Timer.xml
msgid "Returns [code]true[/code] if the timer is stopped or has not started."
msgstr "[code]true[/code] értéket ad vissza, ha az időzítő leállt, vagy még nem indult el."

#. Timer.ignore_time_scale
#: doc/classes/Timer.xml
msgid "If [code]true[/code], the timer will ignore [member Engine.time_scale] and update with the real, elapsed time."
msgstr "Ha [code]true[/code], az időzítő figyelmen kívül hagyja az [member Engine.time_scale] értékét, és a ténylegesen eltelt idő alapján frissül."

#. Timer.one_shot
#: doc/classes/Timer.xml
msgid "If [code]true[/code], the timer will stop after reaching the end. Otherwise, as by default, the timer will automatically restart."
msgstr "Ha [code]true[/code], az időzítő a megadott idő letelte után leáll. Egyébként alapértelmezés szerint automatikusan újraindul."

#. Timer.paused
#: doc/classes/Timer.xml
msgid "If [code]true[/code], the timer is paused. A paused timer does not process until this property is set back to [code]false[/code], even when [method start] is called. See also [method stop]."
msgstr "Ha [code]true[/code], az időzítő szünetel. Ilyenkor akkor sem működik, ha meghívják a [method start] metódust; csak a tulajdonság [code]false[/code] értékre állítása után folytatja a működést. Lásd még: [method stop]."

#. Timer.process_callback
#: doc/classes/Timer.xml
msgid "Specifies when the timer is updated during the main loop."
msgstr "Megadja, hogy a főciklus melyik szakaszában frissüljön az időzítő."

#. Timer.time_left
#: doc/classes/Timer.xml
msgid "The timer's remaining time in seconds. This is always [code]0[/code] if the timer is stopped.\n[b]Note:[/b] This property is read-only and cannot be modified. It is based on [member wait_time]."
msgstr "Az időzítőből hátralévő idő másodpercben. Leállított időzítő esetén mindig [code]0[/code].\n[b]Megjegyzés:[/b] Ez a tulajdonság csak olvasható, nem módosítható. A [member wait_time] értékén alapul."

#. Timer.timeout
#: doc/classes/Timer.xml
msgid "Emitted when the timer reaches the end."
msgstr "Akkor bocsátódik ki, amikor az időzítő lejár."

#. CanvasLayer.get_canvas
#: doc/classes/CanvasLayer.xml
msgid "Returns the RID of the canvas used by this layer."
msgstr "Visszaadja a réteg által használt vászon RID-azonosítóját."

#. CanvasLayer.get_final_transform
#: doc/classes/CanvasLayer.xml
msgid "Returns the transform from the [CanvasLayer]s coordinate system to the [Viewport]s coordinate system."
msgstr "Visszaadja a [CanvasLayer] koordinátarendszeréből a [Viewport] koordinátarendszerébe történő transzformációt."

#. CanvasLayer.hide
#: doc/classes/CanvasLayer.xml
msgid "Hides any [CanvasItem] under this [CanvasLayer]. This is equivalent to setting [member visible] to [code]false[/code]."
msgstr "Elrejti a [CanvasLayer] alatti összes [CanvasItem] elemet. Ez egyenértékű a [member visible] tulajdonság [code]false[/code] értékre állításával."

#. CanvasLayer.show
#: doc/classes/CanvasLayer.xml
msgid "Shows any [CanvasItem] under this [CanvasLayer]. This is equivalent to setting [member visible] to [code]true[/code]."
msgstr "Megjeleníti a [CanvasLayer] alatti összes [CanvasItem] elemet. Ez egyenértékű a [member visible] tulajdonság [code]true[/code] értékre állításával."

#. CanvasLayer.custom_viewport
#: doc/classes/CanvasLayer.xml
msgid "The custom [Viewport] node assigned to the [CanvasLayer]. If [code]null[/code], uses the default viewport instead."
msgstr "A [CanvasLayer] réteghez rendelt egyéni [Viewport] csomópont. Ha [code]null[/code], az alapértelmezett nézetablakot használja."

#. CanvasLayer.follow_viewport_enabled
#: doc/classes/CanvasLayer.xml
msgid "If enabled, the [CanvasLayer] maintains its position in world space. If disabled, the [CanvasLayer] stays in a fixed position on the screen.\nTogether with [member follow_viewport_scale], this can be used for a pseudo-3D effect."
msgstr "Ha engedélyezett, a [CanvasLayer] megtartja a helyzetét a világ koordinátarendszerében. Ha le van tiltva, a [CanvasLayer] a képernyőn rögzített pozícióban marad.\nA [member follow_viewport_scale] tulajdonsággal együtt ál-3D hatás létrehozására használható."

#. CanvasLayer.follow_viewport_scale
#: doc/classes/CanvasLayer.xml
msgid "Scales the layer when using [member follow_viewport_enabled]. Layers moving into the foreground should have increasing scales, while layers moving into the background should have decreasing scales."
msgstr "Átméretezi a réteget, amikor a [member follow_viewport_enabled] engedélyezve van. Az előtér felé mozgó rétegek méretezése növekedjen, a háttér felé mozgóké pedig csökkenjen."

#. CanvasLayer.offset
#: doc/classes/CanvasLayer.xml
msgid "The layer's base offset."
msgstr "A réteg alapeltolása."

#. CanvasLayer.rotation
#: doc/classes/CanvasLayer.xml
msgid "The layer's rotation in radians."
msgstr "A réteg elforgatása radiánban."

#. CanvasLayer.scale
#: doc/classes/CanvasLayer.xml
msgid "The layer's scale."
msgstr "A réteg méretezése."

#. CanvasLayer.transform
#: doc/classes/CanvasLayer.xml
msgid "The layer's transform."
msgstr "A réteg transzformációja."

#. CanvasLayer.visible
#: doc/classes/CanvasLayer.xml
msgid "If [code]false[/code], any [CanvasItem] under this [CanvasLayer] will be hidden.\nUnlike [member CanvasItem.visible], visibility of a [CanvasLayer] isn't propagated to underlying layers."
msgstr "Ha [code]false[/code], a [CanvasLayer] alatti összes [CanvasItem] elem rejtve marad.\nA [member CanvasItem.visible] tulajdonsággal ellentétben a [CanvasLayer] láthatósága nem terjed át az alatta lévő rétegekre."

#. CanvasLayer.visibility_changed
#: doc/classes/CanvasLayer.xml
msgid "Emitted when visibility of the layer is changed. See [member visible]."
msgstr "Akkor bocsátódik ki, amikor megváltozik a réteg láthatósága. Lásd: [member visible]."

#. RandomNumberGenerator.randf
#: doc/classes/RandomNumberGenerator.xml
msgid "Returns a pseudo-random float between [code]0.0[/code] and [code]1.0[/code] (inclusive)."
msgstr "[code]0.0[/code] és [code]1.0[/code] közötti, a végpontokat is beleértve, pszeudovéletlen lebegőpontos számot ad vissza."

#. RandomNumberGenerator.randf_range
#: doc/classes/RandomNumberGenerator.xml
msgid "Returns a pseudo-random float between [param from] and [param to] (inclusive)."
msgstr "A [param from] és [param to] közötti, a végpontokat is beleértve, pszeudovéletlen lebegőpontos számot ad vissza."

#. RandomNumberGenerator.randi
#: doc/classes/RandomNumberGenerator.xml
msgid "Returns a pseudo-random 32-bit unsigned integer between [code]0[/code] and [code]4294967295[/code] (inclusive)."
msgstr "[code]0[/code] és [code]4294967295[/code] közötti, a végpontokat is beleértve, pszeudovéletlen előjel nélküli 32 bites egész számot ad vissza."

#. RandomNumberGenerator.randi_range
#: doc/classes/RandomNumberGenerator.xml
msgid "Returns a pseudo-random 32-bit signed integer between [param from] and [param to] (inclusive)."
msgstr "A [param from] és [param to] közötti, a végpontokat is beleértve, pszeudovéletlen előjeles 32 bites egész számot ad vissza."

#. RandomNumberGenerator.randomize
#: doc/classes/RandomNumberGenerator.xml
msgid "Sets up a time-based seed for this [RandomNumberGenerator] instance. Unlike the [@GlobalScope] random number generation functions, different [RandomNumberGenerator] instances can use different seeds."
msgstr "Időalapú kezdőértéket állít be ehhez a [RandomNumberGenerator] példányhoz. A [@GlobalScope] véletlenszám-előállító függvényeivel ellentétben a különböző [RandomNumberGenerator] példányok eltérő kezdőértéket használhatnak."

#. Tween.is_running
#: doc/classes/Tween.xml
msgid "Returns whether the [Tween] is currently running, i.e. it wasn't paused and it's not finished."
msgstr "Megadja, hogy a [Tween] jelenleg fut-e, vagyis nincs-e szüneteltetve, és nem fejeződött-e még be."

#. Tween.kill
#: doc/classes/Tween.xml
msgid "Aborts all tweening operations and invalidates the [Tween]."
msgstr "Megszakítja az összes interpolációs műveletet, és érvényteleníti a [Tween] objektumot."

#. Tween.play
#: doc/classes/Tween.xml
msgid "Resumes a paused or stopped [Tween]."
msgstr "Folytatja a szüneteltetett vagy leállított [Tween] működését."

#. Tween.set_ignore_time_scale
#: doc/classes/Tween.xml
msgid "If [param ignore] is [code]true[/code], the tween will ignore [member Engine.time_scale] and update with the real, elapsed time. This affects all [Tweener]s and their delays. Default value is [code]false[/code]."
msgstr "Ha a [param ignore] értéke [code]true[/code], az interpoláció figyelmen kívül hagyja az [member Engine.time_scale] értékét, és a ténylegesen eltelt idő alapján frissül. Ez az összes [Tweener] objektumot és azok késleltetését érinti. Az alapértelmezett érték [code]false[/code]."

#. Tween.set_pause_mode
#: doc/classes/Tween.xml
msgid "Determines the behavior of the [Tween] when the [SceneTree] is paused.\nDefault value is [constant TWEEN_PAUSE_BOUND]."
msgstr "Meghatározza a [Tween] működését, amikor a [SceneTree] szünetel.\nAz alapértelmezett érték [constant TWEEN_PAUSE_BOUND]."

#. Tween.set_process_mode
#: doc/classes/Tween.xml
msgid "Determines whether the [Tween] should run after process frames (see [method Node._process]) or physics frames (see [method Node._physics_process]).\nDefault value is [constant TWEEN_PROCESS_IDLE]."
msgstr "Meghatározza, hogy a [Tween] a feldolgozási képkockák (lásd [method Node._process]) vagy a fizikai képkockák (lásd [method Node._physics_process]) után fusson.\nAz alapértelmezett érték [constant TWEEN_PROCESS_IDLE]."

#. Tween.set_speed_scale
#: doc/classes/Tween.xml
msgid "Scales the speed of tweening. This affects all [Tweener]s and their delays."
msgstr "Módosítja az interpoláció sebességét. Ez az összes [Tweener] objektumra és azok késleltetésére hatással van."

#. Tween.finished
#: doc/classes/Tween.xml
msgid "Emitted when the [Tween] has finished all tweening. Never emitted when the [Tween] is set to infinite looping (see [method set_loops])."
msgstr "Akkor bocsátódik ki, amikor a [Tween] minden interpolációja befejeződött. Ha a [Tween] végtelenül ismétlődik, a jel soha nem bocsátódik ki (lásd [method set_loops])."

#. Tween.loop_finished
#: doc/classes/Tween.xml
msgid "Emitted when a full loop is complete (see [method set_loops]), providing the loop index. This signal is not emitted after the final loop, use [signal finished] instead for this case."
msgstr "Akkor bocsátódik ki, amikor egy teljes ismétlés befejeződik (lásd [method set_loops]); átadja az ismétlés indexét. Az utolsó ismétlés után nem bocsátódik ki, arra a [signal finished] jel használható."

#. Tween.step_finished
#: doc/classes/Tween.xml
msgid "Emitted when one step of the [Tween] is complete, providing the step index. One step is either a single [Tweener] or a group of [Tweener]s running in parallel."
msgstr "Akkor bocsátódik ki, amikor a [Tween] egy lépése befejeződik; átadja a lépés indexét. Egy lépés egyetlen [Tweener] objektum vagy több párhuzamosan futó [Tweener] csoportja lehet."

#. Node.get_child_count
#: doc/classes/Node.xml
msgid "Returns the number of children of this node.\nIf [param include_internal] is [code]false[/code], internal children are not counted (see [method add_child]'s [code]internal[/code] parameter)."
msgstr "Visszaadja a csomópont gyermekeinek számát.\nHa a [param include_internal] értéke [code]false[/code], a belső gyermekeket nem számolja bele (lásd a [method add_child] metódus [code]internal[/code] paraméterét)."

#. Node.get_children
#: doc/classes/Node.xml
msgid "Returns all children of this node inside an [Array].\nIf [param include_internal] is [code]false[/code], excludes internal children from the returned array (see [method add_child]'s [code]internal[/code] parameter)."
msgstr "A csomópont összes gyermekét visszaadja egy [Array] tömbben.\nHa a [param include_internal] értéke [code]false[/code], a belső gyermekeket kihagyja (lásd a [method add_child] metódus [code]internal[/code] paraméterét)."

#. Node.get_node_or_null
#: doc/classes/Node.xml
msgid "Fetches a node by [NodePath]. Similar to [method get_node], but does not generate an error if [param path] does not point to a valid node."
msgstr "[NodePath] alapján megkeres egy csomópontot. A [method get_node] metódushoz hasonlóan működik, de nem jelez hibát, ha a [param path] nem érvényes csomópontra mutat."

#. Node.get_parent
#: doc/classes/Node.xml
msgid "Returns this node's parent node, or [code]null[/code] if the node doesn't have a parent."
msgstr "Visszaadja a csomópont szülőcsomópontját, illetve [code]null[/code] értéket, ha nincs szülője."

#. Node.get_path
#: doc/classes/Node.xml
msgid "Returns the node's absolute path, relative to the [member SceneTree.root]. If the node is not inside the scene tree, this method fails and returns an empty [NodePath]."
msgstr "Visszaadja a csomópont abszolút útvonalát a [member SceneTree.root] gyökérhez viszonyítva. Ha a csomópont nincs a jelenetfában, a metódus sikertelen, és üres [NodePath] értéket ad vissza."

#. Node.get_tree
#: doc/classes/Node.xml
msgid "Returns the [SceneTree] that contains this node. If this node is not inside the tree, generates an error and returns [code]null[/code]. See also [method is_inside_tree]."
msgstr "Visszaadja a csomópontot tartalmazó [SceneTree] objektumot. Ha a csomópont nincs a jelenetfában, hibát jelez, és [code]null[/code] értéket ad vissza. Lásd még: [method is_inside_tree]."

#. Node.get_viewport
#: doc/classes/Node.xml
msgid "Returns the node's closest [Viewport] ancestor, if the node is inside the tree. Otherwise, returns [code]null[/code]."
msgstr "Visszaadja a csomóponthoz legközelebbi [Viewport] őscsomópontot, ha a csomópont a jelenetfában található. Egyébként [code]null[/code] értéket ad vissza."

#. Node.has_node
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the [param path] points to a valid node. See also [method get_node]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param path] érvényes csomópontra mutat. Lásd még: [method get_node]."

#. Node.is_ancestor_of
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the given [param node] is a direct or indirect child of this node."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param node] közvetlen vagy közvetett gyermeke ennek a csomópontnak."

#. Node.is_inside_tree
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if this node is currently inside a [SceneTree]. See also [method get_tree]."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont jelenleg egy [SceneTree] része. Lásd még: [method get_tree]."

#. Node.is_node_ready
#: doc/classes/Node.xml
msgid "Returns [code]true[/code] if the node is ready, i.e. it's inside scene tree and all its children are initialized.\n[method request_ready] resets it back to [code]false[/code]."
msgstr "[code]true[/code] értéket ad vissza, ha a csomópont készen áll, vagyis a jelenetfában található, és minden gyermeke inicializálódott.\nA [method request_ready] ismét [code]false[/code] értékre állítja."

#. CanvasItem.get_canvas_item
#: doc/classes/CanvasItem.xml
msgid "Returns the internal canvas item [RID] used by the [RenderingServer] for this node."
msgstr "Visszaadja a csomópont belső vászonelemének [RID] azonosítóját, amelyet a [RenderingServer] használ."

#. CanvasItem.get_canvas_layer_node
#: doc/classes/CanvasItem.xml
msgid "Returns the [CanvasLayer] that contains this node, or [code]null[/code] if the node is not in any [CanvasLayer]."
msgstr "Visszaadja a csomópontot tartalmazó [CanvasLayer] réteget, illetve [code]null[/code] értéket, ha a csomópont egyetlen [CanvasLayer] réteghez sem tartozik."

#. CanvasItem.get_canvas_transform
#: doc/classes/CanvasItem.xml
msgid "Returns the transform of this node, converted from its registered canvas's coordinate system to its viewport's coordinate system. See also [method Node.get_viewport]."
msgstr "Visszaadja a csomópont regisztrált vásznának koordinátarendszeréből a nézetablak koordinátarendszerébe átalakított transzformációját. Lásd még: [method Node.get_viewport]."

#. CanvasItem.get_local_mouse_position
#: doc/classes/CanvasItem.xml
msgid "Returns the mouse's position in this [CanvasItem] using the local coordinate system of this [CanvasItem]."
msgstr "Visszaadja az egérmutató pozícióját ennek a [CanvasItem] elemnek a [CanvasItem] helyi koordinátarendszerében."

#. CanvasItem.get_transform
#: doc/classes/CanvasItem.xml
msgid "Returns the transform matrix of this [CanvasItem]."
msgstr "Visszaadja a [CanvasItem] transzformációs mátrixát."

#. CanvasItem.get_viewport_rect
#: doc/classes/CanvasItem.xml
msgid "Returns this node's viewport boundaries as a [Rect2]. See also [method Node.get_viewport]."
msgstr "Visszaadja a csomópont nézetablakának határait [Rect2] formájában. Lásd még: [method Node.get_viewport]."

#. CanvasItem.get_visibility_layer_bit
#: doc/classes/CanvasItem.xml
msgid "Returns [code]true[/code] if the layer at the given index is set in [member visibility_layer]."
msgstr "[code]true[/code] értéket ad vissza, ha a [member visibility_layer] tulajdonságban be van kapcsolva a megadott indexű réteg."

#. CanvasItem.hide
#: doc/classes/CanvasItem.xml
msgid "Hide the [CanvasItem] if it's currently visible. This is equivalent to setting [member visible] to [code]false[/code]."
msgstr "Elrejti a [CanvasItem] elemet, ha jelenleg látható. Ez egyenértékű a [member visible] tulajdonság [code]false[/code] értékre állításával."

#. CanvasItem.make_input_local
#: doc/classes/CanvasItem.xml
msgid "Returns a copy of the given [param event] with its coordinates converted from global space to this [CanvasItem]'s local space. If not possible, returns the same [InputEvent] unchanged."
msgstr "Visszaadja a megadott [param event] esemény másolatát, amelynek koordinátáit a globális térből ennek a [CanvasItem] elemnek a helyi koordinátarendszerébe alakítja át. Ha ez nem lehetséges, az eredeti [InputEvent] eseményt adja vissza változatlanul."

#. CanvasItem.move_to_front
#: doc/classes/CanvasItem.xml
msgid "Moves this node below its siblings, usually causing the node to draw on top of its siblings. Does nothing if this node does not have a parent. See also [method Node.move_child]."
msgstr "A csomópontot a testvérei után helyezi, így általában azok fölött jelenik meg. Ha a csomópontnak nincs szülője, nem történik semmi. Lásd még: [method Node.move_child]."

#. CanvasItem.set_visibility_layer_bit
#: doc/classes/CanvasItem.xml
msgid "Set/clear individual bits on the rendering visibility layer. This simplifies editing this [CanvasItem]'s visibility layer."
msgstr "Beállítja vagy törli a megjelenítési láthatósági réteg egyes bitjeit. Ez egyszerűbbé teszi a [CanvasItem] láthatósági rétegének szerkesztését."

#. CanvasItem.light_mask
#: doc/classes/CanvasItem.xml
msgid "The rendering layers in which this [CanvasItem] responds to [Light2D] nodes."
msgstr "Azok a megjelenítési rétegek, amelyekben a [CanvasItem] reagál a [Light2D] csomópontokra."

#. CanvasItem.material
#: doc/classes/CanvasItem.xml
msgid "The material applied to this [CanvasItem]."
msgstr "A [CanvasItem] elemre alkalmazott anyag."

#. CanvasItem.modulate
#: doc/classes/CanvasItem.xml
msgid "The color applied to this [CanvasItem]. This property does affect child [CanvasItem]s, unlike [member self_modulate] which only affects the node itself."
msgstr "A [CanvasItem] elemre alkalmazott szín. A [member self_modulate] tulajdonsággal ellentétben ez a gyermek [CanvasItem] elemekre is hatással van."

#. EditorInterface.add_root_node
#: doc/classes/EditorInterface.xml
msgid "Makes [param node] root of the currently opened scene. Only works if the scene is empty. If the [param node] is a scene instance, an inheriting scene will be created."
msgstr "A [param node] csomópontot az aktuálisan megnyitott jelenet gyökerévé teszi. Csak akkor működik, ha a jelenet üres. Ha a [param node] egy jelenet példánya, egy öröklődő jelenet jön létre."

#. EditorInterface.close_scene
#: doc/classes/EditorInterface.xml
msgid "Closes the currently active scene, discarding any pending changes in the process. Returns [constant OK] on success or [constant ERR_DOES_NOT_EXIST] if there is no scene to close."
msgstr "Bezárja az aktuális jelenetet, és elveti a még nem mentett módosításokat. Siker esetén [constant OK], bezárható jelenet hiányában [constant ERR_DOES_NOT_EXIST] értéket ad vissza."

#. EditorInterface.edit_node
#: doc/classes/EditorInterface.xml
msgid "Edits the given [Node]. The node will be also selected if it's inside the scene tree."
msgstr "Megnyitja a megadott [Node] csomópontot szerkesztésre. Ha a csomópont a jelenetfában található, ki is jelöli."

#. EditorInterface.edit_resource
#: doc/classes/EditorInterface.xml
msgid "Edits the given [Resource]. If the resource is a [Script] you can also edit it with [method edit_script] to specify the line and column position."
msgstr "Megnyitja a megadott [Resource] erőforrást szerkesztésre. Ha az erőforrás egy [Script], a [method edit_script] metódussal is szerkeszthető, megadva a sor és az oszlop helyét."

#. EditorInterface.get_current_directory
#: doc/classes/EditorInterface.xml
msgid "Returns the current directory being viewed in the [FileSystemDock]. If a file is selected, its base directory will be returned using [method String.get_base_dir] instead."
msgstr "Visszaadja a [FileSystemDock] panelen éppen megjelenített könyvtárat. Ha fájl van kijelölve, akkor a [method String.get_base_dir] által meghatározott szülőkönyvtárat adja vissza."

#. EditorInterface.get_current_path
#: doc/classes/EditorInterface.xml
msgid "Returns the current path being viewed in the [FileSystemDock]."
msgstr "Visszaadja a [FileSystemDock] panelen éppen megjelenített elérési utat."

#. EditorInterface.get_edited_scene_root
#: doc/classes/EditorInterface.xml
msgid "Returns the edited (current) scene's root [Node]."
msgstr "Visszaadja az éppen szerkesztett jelenet gyökér-[Node] csomópontját."

#. EditorInterface.get_editor_language
#: doc/classes/EditorInterface.xml
msgid "Returns the language currently used for the editor interface."
msgstr "Visszaadja a szerkesztő felületének aktuális nyelvét."

#. EditorInterface.get_editor_paths
#: doc/classes/EditorInterface.xml
msgid "Returns the [EditorPaths] singleton."
msgstr "Visszaadja az [EditorPaths] egyetlen közös példányát."

#. EditorInterface.get_editor_settings
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [EditorSettings] instance."
msgstr "Visszaadja a szerkesztő [EditorSettings] példányát."

#. EditorInterface.get_open_scenes
#: doc/classes/EditorInterface.xml
msgid "Returns an array with the file paths of the currently opened scenes."
msgstr "Visszaadja a jelenleg megnyitott jelenetek fájlútvonalainak tömbjét."

#. EditorInterface.get_selection
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [EditorSelection] instance."
msgstr "Visszaadja a szerkesztő [EditorSelection] példányát."

#. AStarGrid2D.is_in_boundsv
#: doc/classes/AStarGrid2D.xml
msgid "Returns [code]true[/code] if the [param id] vector is a valid grid coordinate, i.e. if it is inside [member region]. Equivalent to [code]region.has_point(id)[/code]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param id] vektor érvényes rácskoordináta, vagyis a [member region] területen belül található. Ez egyenértékű a [code]region.has_point(id)[/code] kifejezéssel."

#. AStarGrid2D.is_point_solid
#: doc/classes/AStarGrid2D.xml
msgid "Returns [code]true[/code] if a point is disabled for pathfinding. By default, all points are enabled."
msgstr "[code]true[/code] értéket ad vissza, ha a pont az útkeresés számára le van tiltva. Alapértelmezés szerint minden pont engedélyezett."

#. AStarGrid2D.set_point_solid
#: doc/classes/AStarGrid2D.xml
msgid "Disables or enables the specified point for pathfinding. Useful for making an obstacle. By default, all points are enabled.\n[b]Note:[/b] Calling [method update] is not needed after the call of this function."
msgstr "Engedélyezi vagy letiltja a megadott pontot az útkereséshez. Akadály létrehozására használható. Alapértelmezés szerint minden pont engedélyezett.\n[b]Megjegyzés:[/b] A függvény meghívása után nem szükséges meghívni a [method update] metódust."

#. AStarGrid2D.cell_size
#: doc/classes/AStarGrid2D.xml
msgid "The size of the point cell which will be applied to calculate the resulting point position returned by [method get_point_path]. If changed, [method update] needs to be called before finding the next path."
msgstr "A rácscella mérete, amelyet a [method get_point_path] által visszaadott pontpozíció kiszámításához használ. Módosítása után az új útvonal keresése előtt meg kell hívni a [method update] metódust."

#. AStarGrid2D.region
#: doc/classes/AStarGrid2D.xml
msgid "The region of grid cells available for pathfinding. If changed, [method update] needs to be called before finding the next path."
msgstr "Az útkereséshez rendelkezésre álló rácscellák területe. Módosítása után az új útvonal keresése előtt meg kell hívni a [method update] metódust."

#. AStarGrid2D.size
#: doc/classes/AStarGrid2D.xml
msgid "The size of the grid (number of cells of size [member cell_size] on each axis). If changed, [method update] needs to be called before finding the next path."
msgstr "A rács mérete (a [member cell_size] méretű cellák száma az egyes tengelyeken). Módosítása után az új útvonal keresése előtt meg kell hívni a [method update] metódust."

# --- Lektorált 13: további Godot 4.7.2 F1-súgóbejegyzések ---

#. FileAccess.get_8
#: doc/classes/FileAccess.xml
msgid "Returns the next 8 bits from the file as an integer. This advances the file cursor by 1 byte. See [method store_8] for details on what values can be stored and retrieved this way."
msgstr "A fájlból a következő 8 bitet egész számként adja vissza. A fájlmutató 1 bájttal előrelép. A tárolható és visszaolvasható értékekről lásd: [method store_8]."

#. FileAccess.get_16
#: doc/classes/FileAccess.xml
msgid "Returns the next 16 bits from the file as an integer. This advances the file cursor by 2 bytes. See [method store_16] for details on what values can be stored and retrieved this way."
msgstr "A fájlból a következő 16 bitet egész számként adja vissza. A fájlmutató 2 bájttal előrelép. A tárolható és visszaolvasható értékekről lásd: [method store_16]."

#. FileAccess.get_32
#: doc/classes/FileAccess.xml
msgid "Returns the next 32 bits from the file as an integer. This advances the file cursor by 4 bytes. See [method store_32] for details on what values can be stored and retrieved this way."
msgstr "A fájlból a következő 32 bitet egész számként adja vissza. A fájlmutató 4 bájttal előrelép. A tárolható és visszaolvasható értékekről lásd: [method store_32]."

#. FileAccess.get_64
#: doc/classes/FileAccess.xml
msgid "Returns the next 64 bits from the file as an integer. This advances the file cursor by 8 bytes. See [method store_64] for details on what values can be stored and retrieved this way."
msgstr "A fájlból a következő 64 bitet egész számként adja vissza. A fájlmutató 8 bájttal előrelép. A tárolható és visszaolvasható értékekről lásd: [method store_64]."

#. FileAccess.get_access_time
#: doc/classes/FileAccess.xml
msgid "Returns the last time the [param file] was accessed in Unix timestamp format, or [code]0[/code] on error. This Unix timestamp can be converted to another format using the [Time] singleton."
msgstr "Visszaadja a [param file] fájl legutóbbi hozzáférésének idejét Unix-időbélyegként, hiba esetén pedig [code]0[/code] értéket. Az időbélyeg a [Time] osztállyal más formátumra alakítható."

#. FileAccess.get_as_text
#: doc/classes/FileAccess.xml
msgid "Returns the whole file as a [String]. Text is interpreted as being UTF-8 encoded. This ignores the file cursor and does not affect it."
msgstr "A teljes fájl tartalmát [String] formájában adja vissza. A szöveget UTF-8 kódolásúnak tekinti. A fájlmutatót figyelmen kívül hagyja, és nem módosítja."

#. FileAccess.get_buffer
#: doc/classes/FileAccess.xml
msgid "Returns next [param length] bytes of the file as a [PackedByteArray]. This advances the file cursor by [param length] bytes."
msgstr "A fájl következő [param length] bájtját [PackedByteArray] formájában adja vissza. A fájlmutató [param length] bájttal előrelép."

#. FileAccess.get_double
#: doc/classes/FileAccess.xml
msgid "Returns the next 64 bits from the file as a floating-point number. This advances the file cursor by 8 bytes."
msgstr "A fájl következő 64 bitjét lebegőpontos számként adja vissza. A fájlmutató 8 bájttal előrelép."

#. FileAccess.get_error
#: doc/classes/FileAccess.xml
msgid "Returns the last error that happened when trying to perform operations. Compare with the [code]ERR_FILE_*[/code] constants from [enum Error]."
msgstr "Visszaadja a műveletek végrehajtásakor fellépett legutóbbi hibát. Vesd össze az [enum Error] felsorolás [code]ERR_FILE_*[/code] állandóival."

#. FileAccess.get_file_as_bytes
#: doc/classes/FileAccess.xml
msgid "Returns the whole [param path] file contents as a [PackedByteArray] without any decoding.\nReturns an empty [PackedByteArray] if an error occurred while opening the file. You can use [method get_open_error] to check the error that occurred."
msgstr "A [param path] fájl teljes tartalmát dekódolás nélkül, [PackedByteArray] formájában adja vissza.\nHa a fájl megnyitásakor hiba történt, üres [PackedByteArray] értéket ad vissza. A hiba a [method get_open_error] metódussal ellenőrizhető."

#. FileAccess.get_file_as_string
#: doc/classes/FileAccess.xml
msgid "Returns the whole [param path] file contents as a [String]. Text is interpreted as being UTF-8 encoded.\nReturns an empty [String] if an error occurred while opening the file. You can use [method get_open_error] to check the error that occurred."
msgstr "A [param path] fájl teljes tartalmát [String] formájában adja vissza. A szöveget UTF-8 kódolásúnak tekinti.\nHa a fájl megnyitásakor hiba történt, üres [String] értéket ad vissza. A hiba a [method get_open_error] metódussal ellenőrizhető."

#. FileAccess.get_float
#: doc/classes/FileAccess.xml
msgid "Returns the next 32 bits from the file as a floating-point number. This advances the file cursor by 4 bytes."
msgstr "A fájl következő 32 bitjét lebegőpontos számként adja vissza. A fájlmutató 4 bájttal előrelép."

#. FileAccess.get_half
#: doc/classes/FileAccess.xml
msgid "Returns the next 16 bits from the file as a half-precision floating-point number. This advances the file cursor by 2 bytes."
msgstr "A fájl következő 16 bitjét félpontosságú lebegőpontos számként adja vissza. A fájlmutató 2 bájttal előrelép."

#. FileAccess.get_hidden_attribute
#: doc/classes/FileAccess.xml
msgid "Returns [code]true[/code] if the [b]hidden[/b] attribute is set on the file at the given path.\n[b]Note:[/b] This method is implemented on iOS, BSD, macOS, and Windows."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott útvonalon található fájlon be van állítva a [b]rejtett[/b] attribútum.\n[b]Megjegyzés:[/b] A metódus iOS, BSD, macOS és Windows rendszereken érhető el."

#. FileAccess.get_length
#: doc/classes/FileAccess.xml
msgid "Returns the size of the file in bytes. For a pipe, returns the number of bytes available for reading from the pipe."
msgstr "Visszaadja a fájl méretét bájtokban. Csővezeték esetén az olvasásra rendelkezésre álló bájtok számát adja vissza."

#. FileAccess.get_md5
#: doc/classes/FileAccess.xml
msgid "Returns an MD5 String representing the file at the given path or an empty [String] on failure."
msgstr "A megadott útvonalon lévő fájl MD5-ellenőrzőösszegét adja vissza [String] formájában, hiba esetén pedig üres karakterláncot."

#. FileAccess.get_modified_time
#: doc/classes/FileAccess.xml
msgid "Returns the last time the [param file] was modified in Unix timestamp format, or [code]0[/code] on error. This Unix timestamp can be converted to another format using the [Time] singleton."
msgstr "Visszaadja a [param file] fájl legutóbbi módosításának idejét Unix-időbélyegként, hiba esetén pedig [code]0[/code] értéket. Az időbélyeg a [Time] osztállyal más formátumra alakítható."

#. FileAccess.get_open_error
#: doc/classes/FileAccess.xml
msgid "Returns the result of the last [method open] call in the current thread."
msgstr "Visszaadja az aktuális szálban utoljára meghívott [method open] metódus eredményét."

#. FileAccess.get_path
#: doc/classes/FileAccess.xml
msgid "Returns the path as a [String] for the current open file."
msgstr "A jelenleg megnyitott fájl útvonalát [String] formájában adja vissza."

#. FileAccess.get_path_absolute
#: doc/classes/FileAccess.xml
msgid "Returns the absolute path as a [String] for the current open file."
msgstr "A jelenleg megnyitott fájl abszolút útvonalát [String] formájában adja vissza."

#. FileAccess.get_position
#: doc/classes/FileAccess.xml
msgid "Returns the file cursor's position in bytes from the beginning of the file. This is the file reading/writing cursor set by [method seek] or [method seek_end] and advanced by read/write operations."
msgstr "Visszaadja a fájlmutató pozícióját bájtokban, a fájl elejétől számítva. Ez a [method seek] vagy [method seek_end] metódussal beállított, valamint az olvasási és írási műveletek során előrehaladó mutató."

#. FileAccess.get_read_only_attribute
#: doc/classes/FileAccess.xml
msgid "Returns [code]true[/code] if the [b]read only[/b] attribute is set on the file at the given path.\n[b]Note:[/b] This method is implemented on iOS, BSD, macOS, and Windows."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott útvonalon található fájlon be van állítva a [b]csak olvasható[/b] attribútum.\n[b]Megjegyzés:[/b] A metódus iOS, BSD, macOS és Windows rendszereken érhető el."

#. FileAccess.get_sha256
#: doc/classes/FileAccess.xml
msgid "Returns an SHA-256 [String] representing the file at the given path or an empty [String] on failure."
msgstr "Visszaadja a megadott útvonalon lévő fájl SHA-256-ellenőrzőösszegét [String] formájában, hiba esetén pedig üres [String] értéket."

#. FileAccess.get_size
#: doc/classes/FileAccess.xml
msgid "Returns the size of the file at the given path, in bytes, or [code]-1[/code] on error."
msgstr "Visszaadja a megadott útvonalon lévő fájl méretét bájtokban, hiba esetén pedig [code]-1[/code] értéket."

#. FileAccess.get_unix_permissions
#: doc/classes/FileAccess.xml
msgid "Returns the UNIX permissions of the file at the given path.\n[b]Note:[/b] This method is implemented on iOS, Linux/BSD, and macOS."
msgstr "Visszaadja a fájl UNIX-jogosultságait.\n[b]Megjegyzés:[/b] A metódus iOS, Linux/BSD és macOS rendszereken érhető el."

#. FileAccess.is_open
#: doc/classes/FileAccess.xml
msgid "Returns [code]true[/code] if the file is currently opened."
msgstr "[code]true[/code] értéket ad vissza, ha a fájl jelenleg nyitva van."

#. FileAccess.open
#: doc/classes/FileAccess.xml
msgid "Creates a new [FileAccess] object and opens the file for writing or reading, depending on the flags.\nReturns [code]null[/code] if opening the file failed. You can use [method get_open_error] to check the error that occurred."
msgstr "Létrehoz egy új [FileAccess] objektumot, és a jelzőknek megfelelően megnyitja a fájlt írásra vagy olvasásra.\nSikertelen megnyitás esetén [code]null[/code] értéket ad vissza. A hiba a [method get_open_error] metódussal ellenőrizhető."

#. FileAccess.seek
#: doc/classes/FileAccess.xml
msgid "Sets the file cursor to the specified position in bytes, from the beginning of the file. This changes the value returned by [method get_position]."
msgstr "A fájlmutatót a fájl elejétől bájtokban megadott pozícióra állítja. Ez módosítja a [method get_position] által visszaadott értéket."

#. FileAccess.set_hidden_attribute
#: doc/classes/FileAccess.xml
msgid "Sets file [b]hidden[/b] attribute.\n[b]Note:[/b] This method is implemented on iOS, BSD, macOS, and Windows."
msgstr "Beállítja a fájl [b]rejtett[/b] attribútumát.\n[b]Megjegyzés:[/b] A metódus iOS, BSD, macOS és Windows rendszereken érhető el."

#. FileAccess.set_read_only_attribute
#: doc/classes/FileAccess.xml
msgid "Sets file [b]read only[/b] attribute.\n[b]Note:[/b] This method is implemented on iOS, BSD, macOS, and Windows."
msgstr "Beállítja a fájl [b]csak olvasható[/b] attribútumát.\n[b]Megjegyzés:[/b] A metódus iOS, BSD, macOS és Windows rendszereken érhető el."

#. FileAccess.set_unix_permissions
#: doc/classes/FileAccess.xml
msgid "Sets file UNIX permissions.\n[b]Note:[/b] This method is implemented on iOS, Linux/BSD, and macOS."
msgstr "Beállítja a fájl UNIX-jogosultságait.\n[b]Megjegyzés:[/b] A metódus iOS, Linux/BSD és macOS rendszereken érhető el."

#. EditorInterface.edit_script
#: doc/classes/EditorInterface.xml
msgid "Edits the given [Script]. The line and column on which to open the script can also be specified. The script will be open with the user-configured editor for the script's language which may be an external editor."
msgstr "Megnyitja a megadott [Script] szkriptet szerkesztésre. A megnyitás sorát és oszlopát is meg lehet adni. A szkript a felhasználó által az adott szkriptnyelvhez beállított szerkesztőben nyílik meg, amely akár külső szerkesztő is lehet."

#. EditorInterface.get_command_palette
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [EditorCommandPalette] instance.\n[b]Warning:[/b] Removing and freeing this node will render a part of the editor useless and may cause a crash."
msgstr "Visszaadja a szerkesztő [EditorCommandPalette] példányát.\n[b]Figyelmeztetés:[/b] A csomópont eltávolítása és felszabadítása a szerkesztő egyes részeit használhatatlanná teheti, és összeomláshoz vezethet."

#. EditorInterface.get_editor_theme
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [Theme].\n[b]Note:[/b] When creating custom editor UI, prefer accessing theme items directly from your GUI nodes using the [code]get_theme_*[/code] methods."
msgstr "Visszaadja a szerkesztő [Theme] témáját.\n[b]Megjegyzés:[/b] Egyéni szerkesztőfelület készítésekor célszerű a témaelemeket közvetlenül a felületi csomópontokból, a [code]get_theme_*[/code] metódusokkal elérni."

#. EditorInterface.get_editor_toaster
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [EditorToaster]."
msgstr "Visszaadja a szerkesztő [EditorToaster] példányát."

#. EditorInterface.get_editor_undo_redo
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [EditorUndoRedoManager]."
msgstr "Visszaadja a szerkesztő [EditorUndoRedoManager] példányát."

#. EditorInterface.get_editor_viewport_2d
#: doc/classes/EditorInterface.xml
msgid "Returns the 2D editor [SubViewport]. It does not have a camera. Instead, the view transforms are done directly and can be accessed with [member Viewport.global_canvas_transform]."
msgstr "Visszaadja a 2D szerkesztő [SubViewport] nézetablakát. Nem rendelkezik kamerával; a nézet transzformációi közvetlenül történnek, és a [member Viewport.global_canvas_transform] segítségével érhetők el."

#. EditorInterface.get_editor_viewport_3d
#: doc/classes/EditorInterface.xml
msgid "Returns the specified 3D editor [SubViewport], from [code]0[/code] to [code]3[/code]. The viewport can be used to access the active editor cameras with [method Viewport.get_camera_3d]."
msgstr "Visszaadja a 3D szerkesztő megadott [SubViewport] nézetablakát [code]0[/code] és [code]3[/code] között. A nézetablakból a [method Viewport.get_camera_3d] metódussal érhetők el az aktív szerkesztőkamerák."

#. EditorInterface.get_file_system_dock
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [FileSystemDock] instance.\n[b]Warning:[/b] Removing and freeing this node will render a part of the editor useless and may cause a crash."
msgstr "Visszaadja a szerkesztő [FileSystemDock] példányát.\n[b]Figyelmeztetés:[/b] A csomópont eltávolítása és felszabadítása a szerkesztő egyes részeit használhatatlanná teheti, és összeomláshoz vezethet."

#. EditorInterface.get_inspector
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [EditorInspector] instance.\n[b]Warning:[/b] Removing and freeing this node will render a part of the editor useless and may cause a crash."
msgstr "Visszaadja a szerkesztő [EditorInspector] példányát.\n[b]Figyelmeztetés:[/b] A csomópont eltávolítása és felszabadítása a szerkesztő egyes részeit használhatatlanná teheti, és összeomláshoz vezethet."

#. EditorInterface.get_node_3d_rotate_snap
#: doc/classes/EditorInterface.xml
msgid "Returns the amount of degrees the 3D editor's rotational snapping is set to."
msgstr "Visszaadja a 3D szerkesztő forgatási illesztéséhez megadott fokok számát."

#. EditorInterface.get_node_3d_scale_snap
#: doc/classes/EditorInterface.xml
msgid "Returns the amount of units the 3D editor's scale snapping is set to."
msgstr "Visszaadja a 3D szerkesztő méretezési illesztéséhez megadott egységek számát."

#. EditorInterface.get_node_3d_translate_snap
#: doc/classes/EditorInterface.xml
msgid "Returns the amount of units the 3D editor's translation snapping is set to."
msgstr "Visszaadja a 3D szerkesztő eltolási illesztéséhez megadott egységek számát."

#. EditorInterface.get_open_scene_roots
#: doc/classes/EditorInterface.xml
msgid "Returns an array with references to the root nodes of the currently opened scenes."
msgstr "Visszaad egy tömböt, amely a jelenleg megnyitott jelenetek gyökércsomópontjaira mutató hivatkozásokat tartalmaz."

#. EditorInterface.get_playing_scene
#: doc/classes/EditorInterface.xml
msgid "Returns the name of the scene that is being played. If no scene is currently being played, returns an empty string."
msgstr "Visszaadja az éppen futtatott jelenet nevét. Ha nincs futó jelenet, üres karakterláncot ad vissza."

#. EditorInterface.get_resource_filesystem
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [EditorFileSystem] instance."
msgstr "Visszaadja a szerkesztő [EditorFileSystem] példányát."

#. EditorInterface.get_resource_previewer
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [EditorResourcePreview] instance."
msgstr "Visszaadja a szerkesztő [EditorResourcePreview] példányát."

#. EditorInterface.get_script_editor
#: doc/classes/EditorInterface.xml
msgid "Returns the editor's [ScriptEditor] instance.\n[b]Warning:[/b] Removing and freeing this node will render a part of the editor useless and may cause a crash."
msgstr "Visszaadja a szerkesztő [ScriptEditor] példányát.\n[b]Figyelmeztetés:[/b] A csomópont eltávolítása és felszabadítása a szerkesztő egyes részeit használhatatlanná teheti, és összeomláshoz vezethet."

#. EditorInterface.get_selected_paths
#: doc/classes/EditorInterface.xml
msgid "Returns an array containing the paths of the currently selected files (and directories) in the [FileSystemDock]."
msgstr "Visszaad egy tömböt a [FileSystemDock] panelen kijelölt fájlok (és mappák) útvonalaival."

#. EditorInterface.get_unsaved_scenes
#: doc/classes/EditorInterface.xml
msgid "Returns an array of file paths of currently unsaved scenes."
msgstr "Visszaad egy tömböt a jelenleg mentetlen jelenetek fájlútvonalaival."

#. EditorInterface.inspect_object
#: doc/classes/EditorInterface.xml
msgid "Shows the given property on the given [param object] in the editor's Inspector dock. If [param inspector_only] is [code]true[/code], plugins will not attempt to edit [param object]."
msgstr "Megjeleníti a megadott [param object] objektum tulajdonságát a szerkesztő Inspector paneljén. Ha a [param inspector_only] értéke [code]true[/code], a bővítmények nem próbálják meg szerkeszteni a [param object] objektumot."

#. EditorInterface.is_node_3d_snap_enabled
#: doc/classes/EditorInterface.xml
msgid "Returns [code]true[/code] if the 3D editor currently has snapping mode enabled, and [code]false[/code] otherwise."
msgstr "[code]true[/code] értéket ad vissza, ha a 3D szerkesztőben jelenleg engedélyezett az illesztési mód, egyébként [code]false[/code] értéket."

#. EditorInterface.is_object_edited
#: doc/classes/EditorInterface.xml
msgid "Returns [code]true[/code] if the object has been marked as edited through [method set_object_edited]."
msgstr "[code]true[/code] értéket ad vissza, ha az objektumot a [method set_object_edited] metódussal szerkesztettként jelölték meg."

#. EditorInterface.is_playing_scene
#: doc/classes/EditorInterface.xml
msgid "Returns [code]true[/code] if a scene is currently being played, [code]false[/code] otherwise. Paused scenes are considered as being played."
msgstr "[code]true[/code] értéket ad vissza, ha éppen fut egy jelenet, egyébként [code]false[/code] értéket. A szüneteltetett jelenetek is futónak számítanak."

#. EditorInterface.is_plugin_enabled
#: doc/classes/EditorInterface.xml
msgid "Returns [code]true[/code] if the specified [param plugin] is enabled. The plugin name is the same as its directory name."
msgstr "[code]true[/code] értéket ad vissza, ha a megadott [param plugin] bővítmény engedélyezett. A bővítmény neve megegyezik a könyvtárának nevével."

#. EditorInterface.mark_scene_as_unsaved
#: doc/classes/EditorInterface.xml
msgid "Marks the current scene tab as unsaved."
msgstr "Mentetlenként jelöli meg az aktuális jelenetfület."

#. EditorInterface.open_scene_from_path
#: doc/classes/EditorInterface.xml
msgid "Opens the scene at the given path. If [param set_inherited] is [code]true[/code], creates a new inherited scene."
msgstr "Megnyitja a megadott útvonalon található jelenetet. Ha a [param set_inherited] értéke [code]true[/code], új öröklött jelenetet hoz létre."

#. EditorInterface.play_current_scene
#: doc/classes/EditorInterface.xml
msgid "Plays the currently active scene."
msgstr "Elindítja a jelenleg aktív jelenetet."

#. EditorInterface.play_custom_scene
#: doc/classes/EditorInterface.xml
msgid "Plays the scene specified by its filepath."
msgstr "Elindítja a fájlútvonalával megadott jelenetet."

#. EditorInterface.play_main_scene
#: doc/classes/EditorInterface.xml
msgid "Plays the main scene."
msgstr "Elindítja a főjelenetet."

#. EditorInterface.reload_scene_from_path
#: doc/classes/EditorInterface.xml
msgid "Reloads the scene at the given path. Fails if the scene is not open."
msgstr "Újratölti a megadott útvonalon lévő jelenetet. Sikertelen, ha a jelenet nincs megnyitva."

#. EditorInterface.restart_editor
#: doc/classes/EditorInterface.xml
msgid "Restarts the editor. This closes the editor and then opens the same project. If [param save] is [code]true[/code], the project will be saved before restarting."
msgstr "Újraindítja a szerkesztőt: bezárja, majd ugyanazzal a projekttel ismét megnyitja. Ha a [param save] értéke [code]true[/code], az újraindítás előtt menti a projektet."

#. EditorInterface.save_all_scenes
#: doc/classes/EditorInterface.xml
msgid "Saves all opened scenes in the editor."
msgstr "Elmenti a szerkesztőben megnyitott összes jelenetet."

#. EditorInterface.save_scene
#: doc/classes/EditorInterface.xml
msgid "Saves the currently active scene. Returns either [constant OK] or [constant ERR_CANT_CREATE]."
msgstr "Elmenti az aktuális jelenetet. [constant OK] vagy [constant ERR_CANT_CREATE] értéket ad vissza."

#. EditorInterface.save_scene_as
#: doc/classes/EditorInterface.xml
msgid "Saves the currently active scene as a file at [param path]."
msgstr "Elmenti az aktuális jelenetet a [param path] útvonalon lévő fájlba."

#. EditorInterface.select_file
#: doc/classes/EditorInterface.xml
msgid "Selects the file, with the path provided by [param file], in the FileSystem dock."
msgstr "Kijelöli a [param file] útvonallal megadott fájlt a Fájlrendszer panelen."

#. EditorInterface.set_plugin_enabled
#: doc/classes/EditorInterface.xml
msgid "Sets the enabled status of a plugin. The plugin name is the same as its directory name."
msgstr "Beállítja egy bővítmény engedélyezett állapotát. A bővítmény neve megegyezik a könyvtárának nevével."

#. EditorInterface.stop_playing_scene
#: doc/classes/EditorInterface.xml
msgid "Stops the scene that is currently playing."
msgstr "Leállítja az éppen futó jelenetet."

#. EditorInterface.distraction_free_mode
#: doc/classes/EditorInterface.xml
msgid "If [code]true[/code], enables distraction-free mode which hides side docks to increase the space available for the main view."
msgstr "Ha [code]true[/code], bekapcsolja a zavaró elemek nélküli módot, amely elrejti az oldalsó paneleket, így több hely jut a fő nézetnek."

#. EditorInterface.movie_maker_enabled
#: doc/classes/EditorInterface.xml
msgid "If [code]true[/code], the Movie Maker mode is enabled in the editor. See [MovieWriter] for more information."
msgstr "Ha [code]true[/code], a szerkesztőben engedélyezett a filmkészítő mód. További információ: [MovieWriter]."

#. AStarGrid2D._compute_cost
#: doc/classes/AStarGrid2D.xml
msgid "Called when computing the cost between two connected points.\nNote that this function is hidden in the default [AStarGrid2D] class."
msgstr "Két összekapcsolt pont közötti költség kiszámításakor hívódik meg.\nEz a függvény az alapértelmezett [AStarGrid2D] osztályban rejtett."

#. AStarGrid2D._estimate_cost
#: doc/classes/AStarGrid2D.xml
msgid "Called when estimating the cost between a point and the path's ending point.\nNote that this function is hidden in the default [AStarGrid2D] class."
msgstr "Egy pont és az útvonal végpontja közötti becsült költség kiszámításakor hívódik meg.\nEz a függvény az alapértelmezett [AStarGrid2D] osztályban rejtett."

#. AStarGrid2D.clear
#: doc/classes/AStarGrid2D.xml
msgid "Clears the grid and sets the [member region] to [code]Rect2i(0, 0, 0, 0)[/code]."
msgstr "Törli a rácsot, és a [member region] értékét [code]Rect2i(0, 0, 0, 0)[/code] értékre állítja."

#. AStarGrid2D.fill_solid_region
#: doc/classes/AStarGrid2D.xml
msgid "Fills the given [param region] on the grid with the specified value for the solid flag.\n[b]Note:[/b] Calling [method update] is not needed after the call of this function."
msgstr "A rács megadott [param region] területét kitölti a járhatatlanságjelző megadott értékével.\n[b]Megjegyzés:[/b] A művelet után nem szükséges meghívni a [method update] metódust."

#. AStarGrid2D.fill_weight_scale_region
#: doc/classes/AStarGrid2D.xml
msgid "Fills the given [param region] on the grid with the specified value for the weight scale.\n[b]Note:[/b] Calling [method update] is not needed after the call of this function."
msgstr "A rács megadott [param region] területét kitölti a súlyszorzó megadott értékével.\n[b]Megjegyzés:[/b] A művelet után nem szükséges meghívni a [method update] metódust."

#. AStarGrid2D.get_point_data_in_region
#: doc/classes/AStarGrid2D.xml
msgid "Returns an array of dictionaries with point data ([code]id[/code]: [Vector2i], [code]position[/code]: [Vector2], [code]solid[/code]: [bool], [code]weight_scale[/code]: [float]) within a [param region]."
msgstr "Visszaadja a [param region] terület pontadatait tartalmazó szótárak tömbjét ([code]id[/code]: [Vector2i], [code]position[/code]: [Vector2], [code]solid[/code]: [bool], [code]weight_scale[/code]: [float])."

#. AStarGrid2D.get_point_position
#: doc/classes/AStarGrid2D.xml
msgid "Returns the position of the point associated with the given [param id]."
msgstr "Visszaadja a megadott [param id] azonosítójú pont pozícióját."

#. AStarGrid2D.get_point_weight_scale
#: doc/classes/AStarGrid2D.xml
msgid "Returns the weight scale of the point associated with the given [param id]."
msgstr "Visszaadja a megadott [param id] azonosítójú pont súlyszorzóját."

#. AStarGrid2D.is_dirty
#: doc/classes/AStarGrid2D.xml
msgid "Indicates that the grid parameters were changed and [method update] needs to be called."
msgstr "Jelzi, hogy a rács paraméterei megváltoztak, ezért meg kell hívni a [method update] metódust."

#. AStarGrid2D.is_in_bounds
#: doc/classes/AStarGrid2D.xml
msgid "Returns [code]true[/code] if the [param x] and [param y] is a valid grid coordinate (id), i.e. if it is inside [member region]. Equivalent to [code]region.has_point(Vector2i(x, y))[/code]."
msgstr "[code]true[/code] értéket ad vissza, ha a [param x] és [param y] érvényes rácskoordináták, azaz a [member region] területén belül találhatók. Ez megfelel a [code]region.has_point(Vector2i(x, y))[/code] kifejezésnek."

#. AStarGrid2D.cell_shape
#: doc/classes/AStarGrid2D.xml
msgid "The cell shape. Affects how the positions are placed in the grid. If changed, [method update] needs to be called before finding the next path."
msgstr "A cellák alakja. Befolyásolja, hogyan helyezkednek el a pontok a rácson. Módosítása után az új útvonal keresése előtt meg kell hívni a [method update] metódust."

#. AStarGrid2D.default_compute_heuristic
#: doc/classes/AStarGrid2D.xml
msgid "The default [enum Heuristic] which will be used to calculate the cost between two points if [method _compute_cost] was not overridden."
msgstr "Az alapértelmezett [enum Heuristic], amely két pont közötti költség kiszámítására szolgál, ha a [method _compute_cost] metódust nem írták felül."

#. AStarGrid2D.default_estimate_heuristic
#: doc/classes/AStarGrid2D.xml
msgid "The default [enum Heuristic] which will be used to calculate the cost between the point and the end point if [method _estimate_cost] was not overridden."
msgstr "Az alapértelmezett [enum Heuristic], amely egy pont és a végpont közötti becsült költség kiszámítására szolgál, ha a [method _estimate_cost] metódust nem írták felül."

#. AStarGrid2D.diagonal_mode
#: doc/classes/AStarGrid2D.xml
msgid "A specific [enum DiagonalMode] mode which will force the path to avoid or accept the specified diagonals."
msgstr "Az [enum DiagonalMode] azon módja, amely meghatározza, hogy az útvonal elkerülje vagy elfogadja a megadott átlós irányokat."

#. AStarGrid2D.jumping_enabled
#: doc/classes/AStarGrid2D.xml
msgid "Enables or disables jumping to skip up the intermediate points and speeds up the searching algorithm.\n[b]Note:[/b] Currently, toggling it on disables the consideration of weight scaling in pathfinding."
msgstr "Engedélyezi vagy letiltja a köztes pontok átugrását, ezzel gyorsítva az útkeresési algoritmust.\n[b]Megjegyzés:[/b] Jelenleg a bekapcsolása miatt az útkeresés figyelmen kívül hagyja a súlyszorzókat."

#. AStarGrid2D.offset
#: doc/classes/AStarGrid2D.xml
msgid "The offset of the grid which will be applied to calculate the resulting point position returned by [method get_point_path]. If changed, [method update] needs to be called before finding the next path."
msgstr "A rács eltolása, amelyet a [method get_point_path] által visszaadott pontpozíció kiszámításakor használ. Módosítása után az új útvonal keresése előtt meg kell hívni a [method update] metódust."

# --- Lektorált 14: RichTextLabel F1-súgó ---

#. RichTextLabel.add_text
#: doc/classes/RichTextLabel.xml
msgid "Adds raw non-BBCode-parsed text to the tag stack."
msgstr "A címkeveremhez hozzáadja a nyers, BBCode-ként nem értelmezett szöveget."

#. RichTextLabel.clear
#: doc/classes/RichTextLabel.xml
msgid "Clears the tag stack, causing the label to display nothing.\n[b]Note:[/b] This method does not affect [member text], and its contents will show again if the label is redrawn. However, setting [member text] to an empty [String] also clears the stack."
msgstr "Törli a címkevermet, így a címke nem jelenít meg semmit.\n[b]Megjegyzés:[/b] Ez a metódus nem módosítja a [member text] tulajdonságot, ezért a tartalma újrarajzoláskor ismét megjelenik. A [member text] üres [String] értékre állítása viszont a vermet is törli."

#. RichTextLabel.get_line_height
#: doc/classes/RichTextLabel.xml
msgid "Returns the height of the line found at the provided index.\n[b]Note:[/b] If [member threaded] is enabled, this method returns a value for the loaded part of the document. Use [method is_finished] or [signal finished] to determine whether the document is fully loaded."
msgstr "Visszaadja a megadott indexű sor magasságát.\n[b]Megjegyzés:[/b] Ha a [member threaded] engedélyezett, a metódus a dokumentum betöltött részéhez tartozó értéket adja vissza. A [method is_finished] metódussal vagy a [signal finished] jellel állapítható meg, hogy a dokumentum teljesen betöltődött-e."

#. RichTextLabel.get_line_offset
#: doc/classes/RichTextLabel.xml
msgid "Returns the vertical offset of the line found at the provided index.\n[b]Note:[/b] If [member threaded] is enabled, this method returns a value for the loaded part of the document. Use [method is_finished] or [signal finished] to determine whether document is fully loaded."
msgstr "Visszaadja a megadott indexű sor függőleges eltolását.\n[b]Megjegyzés:[/b] Ha a [member threaded] engedélyezett, a metódus a dokumentum betöltött részéhez tartozó értéket adja vissza. A [method is_finished] metódussal vagy a [signal finished] jellel állapítható meg, hogy a dokumentum teljesen betöltődött-e."

#. RichTextLabel.get_line_width
#: doc/classes/RichTextLabel.xml
msgid "Returns the width of the line found at the provided index.\n[b]Note:[/b] If [member threaded] is enabled, this method returns a value for the loaded part of the document. Use [method is_finished] or [signal finished] to determine whether the document is fully loaded."
msgstr "Visszaadja a megadott indexű sor szélességét.\n[b]Megjegyzés:[/b] Ha a [member threaded] engedélyezett, a metódus a dokumentum betöltött részéhez tartozó értéket adja vissza. A [method is_finished] metódussal vagy a [signal finished] jellel állapítható meg, hogy a dokumentum teljesen betöltődött-e."

#. RichTextLabel.get_paragraph_count
#: doc/classes/RichTextLabel.xml
msgid "Returns the total number of paragraphs (newlines or [code]p[/code] tags in the tag stack's text tags). Considers wrapped text as one paragraph."
msgstr "Visszaadja a bekezdések számát (az új sorok vagy a címkeverem szövegcímkéiben található [code]p[/code] címkék alapján). A sortöréssel több sorba tördelt szöveg egyetlen bekezdésnek számít."

#. RichTextLabel.get_paragraph_offset
#: doc/classes/RichTextLabel.xml
msgid "Returns the vertical offset of the paragraph found at the provided index.\n[b]Note:[/b] If [member threaded] is enabled, this method returns a value for the loaded part of the document. Use [method is_finished] or [signal finished] to determine whether document is fully loaded."
msgstr "Visszaadja a megadott indexű bekezdés függőleges eltolását.\n[b]Megjegyzés:[/b] Ha a [member threaded] engedélyezett, a metódus a dokumentum betöltött részéhez tartozó értéket adja vissza. A [method is_finished] metódussal vagy a [signal finished] jellel állapítható meg, hogy a dokumentum teljesen betöltődött-e."

#. RichTextLabel.get_parsed_text
#: doc/classes/RichTextLabel.xml
msgid "Returns the text without BBCode mark-up."
msgstr "Visszaadja a szöveget BBCode-jelölések nélkül."

#. RichTextLabel.get_selected_text
#: doc/classes/RichTextLabel.xml
msgid "Returns the current selection text. Does not include BBCodes."
msgstr "Visszaadja a jelenleg kijelölt szöveget. A BBCode-jelöléseket nem tartalmazza."

#. RichTextLabel.get_selection_from
#: doc/classes/RichTextLabel.xml
msgid "Returns the current selection first character index if a selection is active, [code]-1[/code] otherwise. Does not include BBCodes."
msgstr "Aktív kijelölés esetén visszaadja a kijelölés első karakterének indexét, egyébként [code]-1[/code] értéket. A BBCode-jelöléseket nem számítja bele."

#. RichTextLabel.get_selection_line_offset
#: doc/classes/RichTextLabel.xml
msgid "Returns the current selection vertical line offset if a selection is active, [code]-1.0[/code] otherwise."
msgstr "Aktív kijelölés esetén visszaadja a kijelölés függőleges soreltolását, egyébként [code]-1.0[/code] értéket."

#. RichTextLabel.get_selection_to
#: doc/classes/RichTextLabel.xml
msgid "Returns the current selection last character index if a selection is active, [code]-1[/code] otherwise. Does not include BBCodes."
msgstr "Aktív kijelölés esetén visszaadja a kijelölés utolsó karakterének indexét, egyébként [code]-1[/code] értéket. A BBCode-jelöléseket nem számítja bele."

#. RichTextLabel.get_total_character_count
#: doc/classes/RichTextLabel.xml
msgid "Returns the total number of characters from text tags. Does not include BBCodes."
msgstr "Visszaadja a szövegcímkékben található karakterek teljes számát. A BBCode-jelöléseket nem számítja bele."

#. RichTextLabel.invalidate_paragraph
#: doc/classes/RichTextLabel.xml
msgid "Invalidates [param paragraph] and all subsequent paragraphs cache."
msgstr "Érvényteleníti a [param paragraph] bekezdés és az összes utána következő bekezdés gyorsítótárát."

#. RichTextLabel.is_finished
#: doc/classes/RichTextLabel.xml
msgid "If [member threaded] is enabled, returns [code]true[/code] if the background thread has finished text processing, otherwise always return [code]true[/code]."
msgstr "Ha a [member threaded] engedélyezett, [code]true[/code] értéket ad vissza, ha a háttérszál befejezte a szöveg feldolgozását. Egyébként mindig [code]true[/code] értéket ad vissza."

#. RichTextLabel.newline
#: doc/classes/RichTextLabel.xml
msgid "Adds a newline tag to the tag stack."
msgstr "Újsor-címkét ad a címkeveremhez."

#. RichTextLabel.parse_bbcode
#: doc/classes/RichTextLabel.xml
msgid "The assignment version of [method append_text]. Clears the tag stack and inserts the new content."
msgstr "A [method append_text] értékadó változata. Törli a címkevermet, majd beszúrja az új tartalmat."

#. RichTextLabel.parse_expressions_for_values
#: doc/classes/RichTextLabel.xml
msgid "Parses BBCode parameter [param expressions] into a dictionary."
msgstr "A [param expressions] BBCode-paramétert szótárrá alakítja."

#. RichTextLabel.pop
#: doc/classes/RichTextLabel.xml
msgid "Terminates the current tag. Use after [code]push_*[/code] methods to close BBCodes manually. Does not need to follow [code]add_*[/code] methods."
msgstr "Lezárja az aktuális címkét. A [code]push_*[/code] metódusok után a BBCode-jelölések kézi lezárására használható. A [code]add_*[/code] metódusok után nem szükséges meghívni."

#. RichTextLabel.pop_all
#: doc/classes/RichTextLabel.xml
msgid "Terminates all tags opened by [code]push_*[/code] methods."
msgstr "Lezárja az összes [code]push_*[/code] metódussal megnyitott címkét."

#. RichTextLabel.pop_context
#: doc/classes/RichTextLabel.xml
msgid "Terminates tags opened after the last [method push_context] call (including context marker), or all tags if there's no context marker on the stack."
msgstr "Lezárja a legutóbbi [method push_context] hívás után megnyitott címkéket (a környezetjelölővel együtt), vagy a verem összes címkéjét, ha nincs környezetjelölő."

#. RichTextLabel.push_bold
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][font][/code] tag with a bold font to the tag stack. This is the same as adding a [code skip-lint][b][/code] tag if not currently in a [code skip-lint][i][/code] tag."
msgstr "Félkövér betűtípussal ellátott [code skip-lint][font][/code] címkét ad a címkeveremhez. Ez egyenértékű egy [code skip-lint][b][/code] címke hozzáadásával, ha éppen nem vagyunk [code skip-lint][i][/code] címkében."

#. RichTextLabel.push_bold_italics
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][font][/code] tag with a bold italics font to the tag stack."
msgstr "Félkövér és dőlt betűtípussal ellátott [code skip-lint][font][/code] címkét ad a címkeveremhez."

#. RichTextLabel.push_color
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][color][/code] tag to the tag stack."
msgstr "Egy [code skip-lint][color][/code] címkét ad a címkeveremhez."

#. RichTextLabel.push_context
#: doc/classes/RichTextLabel.xml
msgid "Adds a context marker to the tag stack. See [method pop_context]."
msgstr "Környezetjelölőt ad a címkeveremhez. Lásd: [method pop_context]."

#. RichTextLabel.push_customfx
#: doc/classes/RichTextLabel.xml
msgid "Adds a custom effect tag to the tag stack. The effect does not need to be in [member custom_effects]. The environment is directly passed to the effect."
msgstr "Egyéni effektuscímkét ad a címkeveremhez. Az effektusnak nem szükséges szerepelnie a [member custom_effects] tulajdonságban. A környezet közvetlenül átadásra kerül az effektusnak."

#. RichTextLabel.push_dropcap
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][dropcap][/code] tag to the tag stack. Drop cap (dropped capital) is a decorative element at the beginning of a paragraph that is larger than the rest of the text."
msgstr "Egy [code skip-lint][dropcap][/code] címkét ad a címkeveremhez. A kiemelt kezdőbetű a bekezdés elején található díszítőelem, amely nagyobb a szöveg többi részénél."

#. RichTextLabel.push_font
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][font][/code] tag to the tag stack. Overrides default fonts for its duration.\nPassing [code]0[/code] to [param font_size] will use the existing default font size."
msgstr "Egy [code skip-lint][font][/code] címkét ad a címkeveremhez. A címke hatókörében felülírja az alapértelmezett betűtípust.\nHa a [param font_size] értéke [code]0[/code], a meglévő alapértelmezett betűméretet használja."

#. RichTextLabel.push_font_size
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][font_size][/code] tag to the tag stack. Overrides default font size for its duration."
msgstr "Egy [code skip-lint][font_size][/code] címkét ad a címkeveremhez. A címke hatókörében felülírja az alapértelmezett betűméretet."

#. RichTextLabel.push_hint
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][hint][/code] tag to the tag stack. Same as BBCode [code skip-lint][hint=something]{text}[/hint][/code]."
msgstr "Egy [code skip-lint][hint][/code] címkét ad a címkeveremhez. Ugyanazt jelenti, mint a [code skip-lint][hint=something]{text}[/hint][/code] BBCode-jelölés."

#. RichTextLabel.push_indent
#: doc/classes/RichTextLabel.xml
msgid "Adds an [code skip-lint][indent][/code] tag to the tag stack. Multiplies [param level] by current [member tab_size] to determine new margin length."
msgstr "Egy [code skip-lint][indent][/code] címkét ad a címkeveremhez. A margó új méretét a [param level] és az aktuális [member tab_size] szorzata határozza meg."

#. RichTextLabel.push_italics
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][font][/code] tag with an italics font to the tag stack. This is the same as adding an [code skip-lint][i][/code] tag if not currently in a [code skip-lint][b][/code] tag."
msgstr "Dőlt betűtípussal ellátott [code skip-lint][font][/code] címkét ad a címkeveremhez. Ez egyenértékű egy [code skip-lint][i][/code] címke hozzáadásával, ha éppen nem vagyunk [code skip-lint][b][/code] címkében."

#. RichTextLabel.push_language
#: doc/classes/RichTextLabel.xml
msgid "Adds language code used for text shaping algorithm and Open-Type font features."
msgstr "Nyelvkódot ad hozzá a szövegformázási algoritmus és az OpenType betűtípus-szolgáltatások számára."

#. RichTextLabel.push_list
#: doc/classes/RichTextLabel.xml
msgid "Adds [code skip-lint][ol][/code] or [code skip-lint][ul][/code] tag to the tag stack. Multiplies [param level] by current [member tab_size] to determine new margin length."
msgstr "Egy [code skip-lint][ol][/code] vagy [code skip-lint][ul][/code] címkét ad a címkeveremhez. A margó új méretét a [param level] és az aktuális [member tab_size] szorzata határozza meg."

#. RichTextLabel.push_mono
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][font][/code] tag with a monospace font to the tag stack."
msgstr "Rögzített szélességű betűtípussal ellátott [code skip-lint][font][/code] címkét ad a címkeveremhez."

#. RichTextLabel.push_normal
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][font][/code] tag with a normal font to the tag stack."
msgstr "Normál betűtípussal ellátott [code skip-lint][font][/code] címkét ad a címkeveremhez."

#. RichTextLabel.push_outline_color
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][outline_color][/code] tag to the tag stack. Adds text outline for its duration."
msgstr "Egy [code skip-lint][outline_color][/code] címkét ad a címkeveremhez. A címke hatókörében körvonalat ad a szöveghez."

#. RichTextLabel.push_outline_size
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][outline_size][/code] tag to the tag stack. Overrides default text outline size for its duration."
msgstr "Egy [code skip-lint][outline_size][/code] címkét ad a címkeveremhez. A címke hatókörében felülírja a szöveg alapértelmezett körvonalvastagságát."

#. RichTextLabel.push_paragraph
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][p][/code] tag to the tag stack."
msgstr "Egy [code skip-lint][p][/code] címkét ad a címkeveremhez."

#. RichTextLabel.push_strikethrough
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][s][/code] tag to the tag stack. If [param color]'s alpha value is [code]0.0[/code], the current font's color with its alpha multiplied by [theme_item strikethrough_alpha] is used."
msgstr "Egy [code skip-lint][s][/code] címkét ad a címkeveremhez. Ha a [param color] alfacsatornájának értéke [code]0.0[/code], az aktuális betűszín és a [theme_item strikethrough_alpha] szorzatának megfelelő átlátszóságot használja."

#. RichTextLabel.push_table
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][table=columns,inline_align][/code] tag to the tag stack. Use [method set_table_column_expand] to set column expansion ratio. Use [method push_cell] to add cells. [param name] is used as the table name for assistive apps."
msgstr "Egy [code skip-lint][table=columns,inline_align][/code] címkét ad a címkeveremhez. Az oszlopok szélességi aránya a [method set_table_column_expand] metódussal állítható be. A cellák a [method push_cell] metódussal adhatók hozzá. A [param name] a táblázat neve a kisegítő alkalmazások számára."

#. RichTextLabel.push_underline
#: doc/classes/RichTextLabel.xml
msgid "Adds a [code skip-lint][u][/code] tag to the tag stack. If [param color]'s alpha value is [code]0.0[/code], the current font's color with its alpha multiplied by [theme_item underline_alpha] is used."
msgstr "Egy [code skip-lint][u][/code] címkét ad a címkeveremhez. Ha a [param color] alfacsatornájának értéke [code]0.0[/code], az aktuális betűszín és a [theme_item underline_alpha] szorzatának megfelelő átlátszóságot használja."

#. RichTextLabel.reload_effects
#: doc/classes/RichTextLabel.xml
msgid "Reloads custom effects. Useful when [member custom_effects] is modified manually."
msgstr "Újratölti az egyéni effektusokat. Hasznos, ha a [member custom_effects] tulajdonságot kézzel módosították."

#. RichTextLabel.scroll_to_line
#: doc/classes/RichTextLabel.xml
msgid "Scrolls the window's top line to match [param line]."
msgstr "Ablakot görget úgy, hogy a legfelső sor a [param line] legyen."

#. RichTextLabel.scroll_to_paragraph
#: doc/classes/RichTextLabel.xml
msgid "Scrolls the window's top line to match first line of the [param paragraph]."
msgstr "Az ablakot úgy görgeti, hogy a [param paragraph] bekezdés első sora legyen legfelül."

#. RichTextLabel.scroll_to_selection
#: doc/classes/RichTextLabel.xml
msgid "Scrolls to the beginning of the current selection."
msgstr "Az aktuális kijelölés elejére görget."

#. RichTextLabel.select_all
#: doc/classes/RichTextLabel.xml
msgid "Select all the text.\nIf [member selection_enabled] is [code]false[/code], no selection will occur."
msgstr "Kijelöli a teljes szöveget.\nHa a [member selection_enabled] értéke [code]false[/code], nem történik kijelölés."

#. RichTextLabel.set_cell_border_color
#: doc/classes/RichTextLabel.xml
msgid "Sets color of a table cell border."
msgstr "Beállítja a táblázatcella szegélyének színét."

#. RichTextLabel.set_cell_padding
#: doc/classes/RichTextLabel.xml
msgid "Sets inner padding of a table cell."
msgstr "Beállítja a táblázatcella belső térközét."

#. RichTextLabel.set_cell_row_background_color
#: doc/classes/RichTextLabel.xml
msgid "Sets color of a table cell. Separate colors for alternating rows can be specified."
msgstr "Beállítja a táblázatcella színét. A váltakozó sorokhoz különböző színek adhatók meg."

#. RichTextLabel.set_cell_size_override
#: doc/classes/RichTextLabel.xml
msgid "Sets minimum and maximum size overrides for a table cell."
msgstr "Felülírja a táblázatcella minimális és maximális méretét."

#. RichTextLabel.set_table_column_name
#: doc/classes/RichTextLabel.xml
msgid "Sets table column name for assistive apps."
msgstr "Beállítja a táblázatoszlop nevét a kisegítő alkalmazások számára."

#. RichTextLabel.update_image
#: doc/classes/RichTextLabel.xml
msgid "Updates the existing images with the key [param key]. Only properties specified by [param mask] bits are updated. See [method add_image]."
msgstr "Frissíti a [param key] kulccsal rendelkező meglévő képeket. Csak a [param mask] bitjeivel megjelölt tulajdonságokat frissíti. Lásd: [method add_image]."

#. RichTextLabel.bbcode_enabled
#: doc/classes/RichTextLabel.xml
msgid "If [code]true[/code], the label uses BBCode formatting.\n[b]Note:[/b] This only affects the contents of [member text], not the tag stack."
msgstr "Ha [code]true[/code], a címke BBCode-formázást használ.\n[b]Megjegyzés:[/b] Ez csak a [member text] tartalmát érinti, nem a címkevermet."

#. RichTextLabel.custom_effects
#: doc/classes/RichTextLabel.xml
msgid "The currently installed custom effects. This is an array of [RichTextEffect]s.\nTo add a custom effect, it's more convenient to use [method install_effect]."
msgstr "A jelenleg telepített egyéni effektusok [RichTextEffect] elemekből álló tömbje.\nEgyéni effektus hozzáadására kényelmesebb a [method install_effect] metódust használni."

#. RichTextLabel.meta_underlined
#: doc/classes/RichTextLabel.xml
msgid "If [code]true[/code], the label underlines meta tags such as [code skip-lint][url]{text}[/url][/code]. These tags can call a function when clicked if [signal meta_clicked] is connected to a function."
msgstr "Ha [code]true[/code], a címke aláhúzza a metacímkéket, például a [code skip-lint][url]{text}[/url][/code] jelölést. Ezekre kattintva függvény hívható meg, ha a [signal meta_clicked] jelhez függvény kapcsolódik."

#. RichTextLabel.progress_bar_delay
#: doc/classes/RichTextLabel.xml
msgid "The delay after which the loading progress bar is displayed, in milliseconds. Set to [code]-1[/code] to disable progress bar entirely.\n[b]Note:[/b] Progress bar is displayed only if [member threaded] is enabled."
msgstr "A betöltési folyamatjelző megjelenítéséig eltelt késleltetés ezredmásodpercben. A [code]-1[/code] érték teljesen letiltja a folyamatjelzőt.\n[b]Megjegyzés:[/b] A folyamatjelző csak akkor látható, ha a [member threaded] engedélyezett."

#. RichTextLabel.scroll_active
#: doc/classes/RichTextLabel.xml
msgid "If [code]true[/code], the scrollbar is visible. Setting this to [code]false[/code] does not block scrolling completely. See [method scroll_to_line]."
msgstr "Ha [code]true[/code], látható a görgetősáv. A [code]false[/code] beállítás nem tiltja le teljesen a görgetést. Lásd: [method scroll_to_line]."

#. RichTextLabel.scroll_following
#: doc/classes/RichTextLabel.xml
msgid "If [code]true[/code], the window scrolls down to display new content automatically."
msgstr "Ha [code]true[/code], az ablak automatikusan lefelé görget az új tartalom megjelenítéséhez."

#. RichTextLabel.scroll_following_visible_characters
#: doc/classes/RichTextLabel.xml
msgid "If [code]true[/code], the window scrolls to display the last visible line when [member visible_characters] or [member visible_ratio] is changed."
msgstr "Ha [code]true[/code], az ablak az utolsó látható sorig görget, amikor a [member visible_characters] vagy a [member visible_ratio] értéke megváltozik."

#. RichTextLabel.selection_enabled
#: doc/classes/RichTextLabel.xml
msgid "If [code]true[/code], the label allows text selection."
msgstr "Ha [code]true[/code], a címke lehetővé teszi a szöveg kijelölését."

#. RichTextLabel.tab_size
#: doc/classes/RichTextLabel.xml
msgid "The number of spaces associated with a single tab length. Does not affect [code]\\t[/code] in text tags, only indent tags."
msgstr "Az egyetlen tabulátorszélességhez tartozó szóközök száma. A szövegcímkékben szereplő [code]\\t[/code] karaktert nem érinti, csak a behúzási címkéket."

#. RichTextLabel.threaded
#: doc/classes/RichTextLabel.xml
msgid "If [code]true[/code], text processing is done in a background thread."
msgstr "Ha [code]true[/code], a szöveg feldolgozása háttérszálon történik."

#. RichTextLabel.finished
#: doc/classes/RichTextLabel.xml
msgid "Triggered when the document is fully loaded.\n[b]Note:[/b] This can happen before the text is processed for drawing. Scrolling values may not be valid until the document is drawn for the first time after this signal."
msgstr "Akkor váltódik ki, amikor a dokumentum teljesen betöltődött.\n[b]Megjegyzés:[/b] Ez a szöveg kirajzoláshoz szükséges feldolgozása előtt is bekövetkezhet. A görgetési értékek a jel utáni első kirajzolásig érvénytelenek lehetnek."

#. RichTextLabel.meta_hover_ended
#: doc/classes/RichTextLabel.xml
msgid "Triggers when the mouse exits a meta tag."
msgstr "Akkor váltódik ki, amikor az egérmutató elhagy egy metacímkét."

#. RichTextLabel.meta_hover_started
#: doc/classes/RichTextLabel.xml
msgid "Triggers when the mouse enters a meta tag."
msgstr "Akkor váltódik ki, amikor az egérmutató egy metacímke fölé kerül."
